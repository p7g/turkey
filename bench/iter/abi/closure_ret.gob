import System.Env as Env
-- Which results come back boxed from a call through a closure, against a
-- direct call to a function too large to inline. 10^7 calls each.

fun big(i : Int) -> Option Int = match i % 8 {
	0 -> Some(i)
	1 -> Some(i + 1)
	2 -> Some(i + 2)
	3 -> Some(i + 3)
	4 -> Some(i + 4)
	5 -> Some(i + 5)
	6 -> Some(i + 6)
	_ -> None
}

fun pairs(i : Int) -> (Int, Int) = match i % 8 {
	0 -> (i, 1)
	1 -> (i, 2)
	2 -> (i, 3)
	3 -> (i, 4)
	4 -> (i, 5)
	5 -> (i, 6)
	6 -> (i, 7)
	_ -> (i, 8)
}

fun viaClosure(f : fun(Int) -> Option Int, n : Int) -> Int {
	var t = 0
	var i = 0
	while i < n {
		match f(i) { Some(x) -> { t = t + x }; None -> {} }
		i = i + 1
	}
	t
}

fun pairsViaClosure(f : fun(Int) -> (Int, Int), n : Int) -> Int {
	var t = 0
	var i = 0
	while i < n {
		let (a, b) = f(i)
		t = t + a + b
		i = i + 1
	}
	t
}

fun main() {
	let n = 10000000
	let which = len(Env.args())
	var t = 0
	var i = 0
	if which == 1 {
		while i < n {
			match big(i) { Some(x) -> { t = t + x }; None -> {} }
			i = i + 1
		}
	} else if which == 2 {
		t = viaClosure(if n > 0 { big } else { \Some(_) }, n)
	} else {
		t = pairsViaClosure(if n > 0 { pairs } else { \(_, 0) }, n)
	}
	print(t)
}
