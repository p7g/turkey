import System.Env as Env

-- A closure returning `Option Int`, called through a field, built three ways.

type Gen a = Gen(fun() -> Option a)
type GenI = GenI(fun() -> Option Int)

fun runGen(g : Gen Int, n : Int) -> Int {
	let Gen(f) = g
	var t = 0
	var i = 0
	while i < n {
		match f() { Some(x) -> { t = t + x }; None -> {} }
		i = i + 1
	}
	t
}

fun runGenI(g : GenI, n : Int) -> Int {
	let GenI(f) = g
	var t = 0
	var i = 0
	while i < n {
		match f() { Some(x) -> { t = t + x }; None -> {} }
		i = i + 1
	}
	t
}

fun main() {
	let n = 10000000
	let which = len(Env.args())
	var at = 0
	let f = fun() {
		at = at + 1
		Some(at)
	}
	print(if which == 1 { runGen(Gen(f), n) } else { runGenI(GenI(f), n) })
}
