import System.Env as Env

-- A call through a closure returning `Option Int`: a named function, a lambda
-- capturing nothing, a lambda capturing a value, and a lambda capturing a `var`.

fun viaClosure(f : fun(Int) -> Option Int, n : Int) -> Int {
	var t = 0
	var i = 0
	while i < n {
		match f(i) { Some(x) -> { t = t + x }; None -> {} }
		i = i + 1
	}
	t
}

fun plusOne(i : Int) -> Option Int = Some(i + 1)

fun main() {
	let n = 10000000
	let which = len(Env.args())
	let k = which * 3
	var c = 0
	let t = match which {
		1 -> viaClosure(plusOne, n)
		2 -> viaClosure(fun(i) = Some(i + 1), n)
		3 -> viaClosure(fun(i) = Some(i + k), n)
		_ -> viaClosure(fun(i) {
			c = c + 1
			Some(i + c)
		}, n)
	}
	print(t)
}
