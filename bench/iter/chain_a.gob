import ProtoSeq (..)
import ProtoPull (..)

fun input(n : Int) -> Array Int = Array.init(n, \_ * 7 % 13)

fun main() {
	let xs = input(1000)
	let ys = input(1000)
	var t = 0
	var r = 0
	while r < 100000 {
		for y in Iter.filter(Iter.map(xs, \_ * 3), \_ % 2 == 0) { t = t + y }
		r = r + 1
	}
	print(t)
}
