import ProtoSeq (..)
import ProtoPull (..)

fun input(n : Int) -> Array Int = Array.init(n, \_ * 7 % 13)

fun main() {
	let xs = input(1000)
	let ys = input(1000)
	var t = 0
	var r = 0
	while r < 100000 {
		var i = 0
		while i < len(xs) {
			let y = xs[i] * 3
			if y % 2 == 0 { t = t + y }
			i = i + 1
		}
		r = r + 1
	}
	print(t)
}
