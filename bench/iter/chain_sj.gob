import ProtoSeq (..)
import ProtoPull (..)

fun input(n : Int) -> Array Int = Array.init(n, \_ * 7 % 13)

fun main() {
	let xs = input(1000)
	let ys = input(1000)
	var t = 0
	var r = 0
	while r < 100000 {
		let q = sfilter(smap(xs, \_ * 3), \_ % 2 == 0)
		fun go(s : Int, acc : Int) -> Int = match step(q, s) {
			Done -> acc
			Yield(x, s2) -> go(s2, acc + x)
		}
		t = go(start(q), t)
		r = r + 1
	}
	print(t)
}
