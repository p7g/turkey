import ProtoSeq (..)
import ProtoPull (..)

type E
	= KLit(Int)
	| KNeg(E)
	| KAdd(E, E)
	| KSub(E, E)
	| KMul(E, E)
	| KDiv(E, E)
	| KIf(E, E, E)
	| KLet(Int, E, E)
	| KCall(E, E, E, E)
	| KSeq(E, E)
	| KNot(E)
	| KVar(Int)

-- Returns a tree of exactly `n` nodes, its shapes chosen by `k`.
fun build(n : Int, k : Int) -> E {
	if n <= 1 { return if k % 2 == 0 { KLit(k) } else { KVar(k) } }
	let m = n - 1
	match k % 10 {
		0 -> KNeg(build(m, k + 1))
		1 -> KNot(build(m, k + 3))
		2 | 3 | 4 | 5 | 6 | 7 -> if m < 2 { KNeg(build(m, k + 1)) } else {
			let a = build(m / 2, k + 1)
			let b = build(m - m / 2, k + 5)
			match k % 10 {
				2 -> KAdd(a, b)
				3 -> KSub(a, b)
				4 -> KMul(a, b)
				5 -> KDiv(a, b)
				6 -> KLet(k, a, b)
				_ -> KSeq(a, b)
			}
		}
		8 -> if m < 3 { KNeg(build(m, k + 1)) } else {
			KIf(build(m / 3, k + 1), build(m / 3, k + 2), build(m - 2 * (m / 3), k + 7))
		}
		_ -> if m < 4 { KNot(build(m, k + 1)) } else {
			KCall(build(m / 4, k + 1), build(m / 4, k + 2), build(m / 4, k + 3), build(m - 3 * (m / 4), k + 9))
		}
	}
}

-- Too large to inline: one arm per constructor and child.
fun kid(e : E, i : Int) -> Option E = match e {
	KLit(_) -> None
	KVar(_) -> None
	KNeg(a) -> if i == 0 { Some(a) } else { None }
	KNot(a) -> if i == 0 { Some(a) } else { None }
	KAdd(a, b) | KSub(a, b) | KMul(a, b) | KDiv(a, b) | KSeq(a, b) | KLet(_, a, b) -> match i {
		0 -> Some(a)
		1 -> Some(b)
		_ -> None
	}
	KIf(a, b, c) -> match i {
		0 -> Some(a)
		1 -> Some(b)
		2 -> Some(c)
		_ -> None
	}
	KCall(a, b, c, d) -> match i {
		0 -> Some(a)
		1 -> Some(b)
		2 -> Some(c)
		3 -> Some(d)
		_ -> None
	}
}

type Kids = Kids(E)

instance Steps Kids {
	type SItem = E
	type State = Int
	fun start(_) = 0
	fun step(Kids(e), i) = match kid(e, i) {
		None    -> Done
		Some(k) -> Yield(k, i + 1)
	}
}

fun size(e : E) -> Int {
	var n = 1
	let ks = Kids(e)
	var s = start(ks)
	loop {
		match step(ks, s) {
			Done -> break
			Yield(c, s2) -> {
				n = n + size(c)
				s = s2
			}
		}
	}
	n
}

fun main() {
	let e = build(2001, 0)
	var t = 0
	var r = 0
	while r < 20000 {
		t = t + size(e)
		r = r + 1
	}
	print(t)
}
