import ProtoSeq (..)
import ProtoPull (..)

fun table(n : Int) -> Map Int Int {
	let m = Map.new()
	var i = 0
	while i < n {
		Map.put(m, i, i * 7 % 13)
		i = i + 1
	}
	m
}

fun main() {
	let m = table(1000)
	var t = 0
	var r = 0
	while r < 100000 {
		var s = start(m)
		loop {
			match step(m, s) {
				Done -> break
				Yield((_, v), s2) -> {
					t = t + v
					s = s2
				}
			}
		}
		r = r + 1
	}
	print(t)
}
