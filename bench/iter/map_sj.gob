import ProtoSeq (..)
import ProtoPull (..)

fun table(n : Int) -> Map Int Int {
	let m = Map.new()
	var i = 0
	while i < n {
		Map.put(m, i, i * 7 % 13)
		i = i + 1
	}
	m
}

fun main() {
	let m = table(1000)
	var t = 0
	var r = 0
	while r < 100000 {
		fun go(s, acc : Int) -> Int = match step(m, s) {
			Done -> acc
			Yield((_, v), s2) -> go(s2, acc + v)
		}
		t = go(start(m), t)
		r = r + 1
	}
	print(t)
}
