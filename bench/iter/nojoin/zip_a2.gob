-- Today's class with `zip` written as nested matches, no `?`.

type Zip2 a b = Zip2 { left : a, right : b }
type Zip2Cursor j k = Zip2Cursor { left : j, right : k }

instance Iterator (Zip2 a b) : Iterator a, Iterator b {
	type Item = (Item a, Item b)
	type Cursor = Zip2Cursor (Cursor a) (Cursor b)
	fun iter(z) = Zip2Cursor { left = iter(z.left), right = iter(z.right) }
	fun next(z, cur) = match next(z.left, cur.left) {
		None -> None
		Some(x) -> match next(z.right, cur.right) {
			None    -> None
			Some(y) -> Some((x, y))
		}
	}
}

fun input(n : Int) -> Array Int = Array.init(n, \_ * 7 % 13)

fun main() {
	let xs = input(1000)
	let ys = input(1000)
	var t = 0
	var r = 0
	while r < 100000 {
		for (x, y) in (Zip2 { left = xs, right = ys }) { t = t + x * y }
		r = r + 1
	}
	print(t)
}
