import ProtoSeq (..)

-- `zip_s` with the loop state held one `var` per slot, as a loop join whose
-- parameters are the state's slots would hold it.

fun input(n : Int) -> Array Int = Array.init(n, \_ * 7 % 13)

fun main() {
	let xs = input(1000)
	let ys = input(1000)
	var t = 0
	var r = 0
	while r < 100000 {
		let q = szip(xs, ys)
		let ProtoSeq.ZipState(l0, r0) = start(q)
		var sl = l0
		var sr = r0
		loop {
			match step(q, ProtoSeq.ZipState(sl, sr)) {
				Done -> break
				Yield((x, y), ProtoSeq.ZipState(l2, r2)) -> {
					t = t + x * y
					sl = l2
					sr = r2
				}
			}
		}
		r = r + 1
	}
	print(t)
}
