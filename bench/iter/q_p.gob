import ProtoSeq (..)
import ProtoPull (..)

fun input(n : Int) -> Array (Option Int) = Array.init(n, fun(i) = Some(i * 7 % 13))

fun total(xs : Array (Option Int)) -> Option Int {
	var t = 0
	let it = iterate(xs)
	fun go() -> Option Unit = match pnext(it) {
		None -> Some(())
		Some(o) -> {
			let v = o?
			t = t + v
			go()
		}
	}
	go()?
	Some(t)
}

fun main() {
	let xs = input(1000)
	var t = 0
	var r = 0
	while r < 100000 {
		t = t + Option.unwrapOr(total(xs), 0)
		r = r + 1
	}
	print(t)
}
