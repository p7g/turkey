import ProtoSeq (..)
import ProtoPull (..)

-- A multi-shot `?` (the Array monad) inside a loop over [1, 2, 3].

-- Today's class through the real `for` desugaring.
fun pairsA() {
	var out = []
	for x in [1, 2, 3] {
		let y = [10, 20]?
		Vec.push(out, (x, y))
	}
	[len(out)]
}

-- The value-cursor class, desugared as its `for` would be: the state is a
-- parameter of the loop function.
fun pairsS() {
	let xs = [1, 2, 3]
	var out = []
	fun go(s : Int) -> Array Unit = match step(xs, s) {
		Done -> [()]
		Yield(x, s2) -> {
			let y = [10, 20]?
			Vec.push(out, (x, y))
			go(s2)
		}
	}
	let ends = go(start(xs))
	(len(ends), len(out))
}

-- The closure iterator: one pull closure, captured by every branch.
fun pairsP() {
	let it = iterate([1, 2, 3])
	var out = []
	fun go() -> Array Unit = match pnext(it) {
		None -> [()]
		Some(x) -> {
			let y = [10, 20]?
			Vec.push(out, (x, y))
			go()
		}
	}
	let ends = go()
	(len(ends), len(out))
}

fun main() {
	print("class, mutable cursor (real for): branches ending = " + show(len(pairsA())))
	let (a, b) = pairsS()
	print("value cursor:   branches ending = " + show(a) + ", pushes = " + show(b))
	let (c, d) = pairsP()
	print("pull closure:   branches ending = " + show(c) + ", pushes = " + show(d))
}
