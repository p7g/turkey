import ProtoSeq (..)
import ProtoPull (..)

-- Iterating one adapter value twice, and keeping a position to go back to.

fun sumS[Steps c, SItem c ~ Int](q : c) -> Int = ssum(q)

fun main() {
	let xs = [1, 2, 3, 4]

	let a = Iter.map(xs, \_ * 10)
	print("class: adapter summed twice = " + show(Iter.sum(a)) + ", " + show(Iter.sum(a)))

	let s = smap(xs, \_ * 10)
	print("value cursor: adapter summed twice = " + show(ssum(s)) + ", " + show(ssum(s)))

	let p = pmap(iterate(xs), \_ * 10)
	print("pull closure: adapter summed twice = " + show(psum(p)) + ", " + show(psum(p)))

	-- A saved state is a position: step from it twice and get the same element.
	match step(xs, start(xs)) {
		Done -> {}
		Yield(_, s1) -> {
			let first = match step(xs, s1) { Yield(x, _) -> x; Done -> 0 }
			let again = match step(xs, s1) { Yield(x, _) -> x; Done -> 0 }
			print("value cursor: stepping a saved state twice = " + show(first) + ", " + show(again))
		}
	}

	-- Resuming: a pull closure resumes by itself; two loops share it.
	let it = iterate(xs)
	var head = []
	loop {
		match pnext(it) {
			None -> break
			Some(x) -> {
				Vec.push(head, x)
				if x == 2 { break }
			}
		}
	}
	print("pull closure: first loop " + show(Vec.toArray(head)) + ", rest sums to " + show(psum(it)))
}
