import ProtoSeq (..)
import ProtoPull (..)

fun input(n : Int) -> Array Int = Array.init(n, \_ * 7 % 13)

fun main() {
	let xs = input(1000)
	let ys = input(1000)
	var t = 0
	var r = 0
	while r < 100000 {
		let c = iter(xs)
		loop {
			match next(xs, c) {
				None -> break
				Some(x) -> { t = t + x }
			}
		}
		r = r + 1
	}
	print(t)
}
