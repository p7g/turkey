import ProtoSeq (..)
import ProtoPull (..)

fun input(n : Int) -> Array Int = Array.init(n, \_ * 7 % 13)

fun main() {
	let xs = input(1000)
	let ys = input(1000)
	var t = 0
	var r = 0
	while r < 100000 {
		var s = start(xs)
		loop {
			match step(xs, s) {
				Done -> break
				Yield(x, s2) -> {
					t = t + x
					s = s2
				}
			}
		}
		r = r + 1
	}
	print(t)
}
