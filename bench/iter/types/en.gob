import ProtoSeq (..)
import ProtoPull (..)

-- `enumerate` written as an adapter under each design.

type SEnum c = SEnum { source : c }

instance Steps (SEnum c) : Steps c {
	type SItem = (Int, SItem c)
	type State = (Int, State c)
	fun start(e) = (0, start(e.source))
	fun step(e, (i, s)) = match step(e.source, s) {
		Done         -> Done
		Yield(x, s2) -> Yield((i, x), (i + 1, s2))
	}
}

fun penumerate[Iterable c](xs : c) -> Pull (Int, Elem c) {
	let it = iterate(xs)
	var i = 0
	pull(fun() {
		let x = pnext(it)?
		i = i + 1
		Some((i - 1, x))
	})
}

-- An erased iterator over any value-cursor source: Swift's AnyIterator.
fun erase[Steps c](xs : c) -> Pull (SItem c) {
	var s = start(xs)
	pull(fun() = match step(xs, s) {
		Done -> None
		Yield(x, s2) -> {
			s = s2
			Some(x)
		}
	})
}

fun main() {
	print(ssum(smap(SEnum { source = [5, 6, 7] }, fun((i, x)) = i * x)))
	print(psum(pmap(penumerate([5, 6, 7]), fun((i, x)) = i * x)))
	let both = [erase([1, 2]), erase(smap([1, 2], \_ * 10))]
	print(psum(both[0]) + psum(both[1]))
}
