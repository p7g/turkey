import ProtoSeq (..)
import ProtoPull (..)

-- Generic consumers and adapters, unannotated, to see the inferred signatures.

fun countA(xs) {
	var n = 0
	for _ in xs { n = n + 1 }
	n
}

fun firstTwoA(xs) {
	let c = iter(xs)
	let a = next(xs, c)?
	let b = next(xs, c)?
	Some((a, b))
}

fun firstTwoS(xs) {
	let Yield(a, s1) = step(xs, start(xs)) else { return None }
	let Yield(b, _) = step(xs, s1) else { return None }
	Some((a, b))
}

fun firstTwoP(xs) {
	let it = iterate(xs)
	let a = pnext(it)?
	let b = pnext(it)?
	Some((a, b))
}

fun doubledA(xs) = Iter.map(xs, \_ * 2)
fun doubledS(xs) = smap(xs, \_ * 2)
fun doubledP(xs) = pmap(iterate(xs), \_ * 2)

fun main() {
	print(countA([1, 2]))
	print(firstTwoA([1, 2]))
	print(firstTwoS([1, 2]))
	print(firstTwoP([1, 2]))
	print(Iter.sum(doubledA([1, 2])))
	print(ssum(doubledS([1, 2])))
	print(psum(doubledP([1, 2])))
}
