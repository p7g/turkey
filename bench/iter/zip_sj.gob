import ProtoSeq (..)
import ProtoPull (..)

fun input(n : Int) -> Array Int = Array.init(n, \_ * 7 % 13)

fun main() {
	let xs = input(1000)
	let ys = input(1000)
	var t = 0
	var r = 0
	while r < 100000 {
		let q = szip(xs, ys)
		fun go(s, acc : Int) -> Int = match step(q, s) {
			Done -> acc
			Yield((x, y), s2) -> go(s2, acc + x * y)
		}
		t = go(start(q), t)
		r = r + 1
	}
	print(t)
}
