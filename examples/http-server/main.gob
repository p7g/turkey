-- A small HTTP API: routing by `match` on the method and the path, the
-- request body taken out of `POST`'s payload, an error type that says what
-- each error answers, and every path ending in `respond`.
--
--     curl -i localhost:8080/health
--     curl -i -X POST --data 'two eggs' localhost:8080/orders
--     curl -i localhost:8080/orders/1

import Net as Net
import Net.HTTP (..)
import Net.HTTP.Server as Server
import Net.HTTP.Server (Respond, Done, respond)
import Net.TCP as TCP
import System.IO as IO
import System.Sync as Sync
import System.Sync (Mutex)

-- What can go wrong with a request. Each answers with its own status.
type APIError = Missing | WrongMethod | BadBody(HTTPError) | NotText

-- `receive` lifts the body's errors into this type, so `?` needs no
-- conversion.
instance FromHTTP APIError { fun fromHTTP(e) = BadBody(e) }

instance Reply APIError {
    fun reply(e) = match e {
        Missing -> reply(NotFound)
        WrongMethod -> reply(MethodNotAllowed)
        BadBody(TooLarge) -> text(ContentTooLarge, "an order is at most 1 KiB\n")
        BadBody(other) -> text(BadRequest, show(other) + "\n")
        NotText -> text(BadRequest, "an order is UTF-8 text\n")
    }
}

type Orders = Orders { items : Mutex (Vec String) }

fun handle(orders : Orders, req : Request Incoming, r : Respond) -> Done = respond(r, answer(orders, req))

fun answer(orders : Orders, req : Request Incoming) -> Either APIError ServerResponse =
    match (req.method, req.target.path) {
        (GET, "/health") | (HEAD, "/health") -> Right(text(OK, "ok\n"))
        (POST(body), "/orders") -> {
            let order = match String.fromBytes(IO.bytes(receive(body, 1024)?)) {
                Some(t) -> t
                None -> return Left(NotText)
            }
            let id = Sync.withLock(orders.items, fun(v : Vec String) {
                Vec.push(v, order)
                len(v)
            })
            Right(text(Created, show(id) + "\n"))
        }
        (GET, path) -> match orderNumber(path) {
            Some(n) -> match Sync.withLock(orders.items, fun(v : Vec String) = Vec.at(v, n - 1)) {
                Some(order) -> Right(text(OK, order + "\n"))
                None -> Left(Missing)
            }
            None -> Left(Missing)
        }
        (_, "/health") | (_, "/orders") -> Left(WrongMethod)
        _ -> Left(Missing)
    }

-- Returns the order number in a path `/orders/N`.
fun orderNumber(path : String) -> Option Int = Int.parse(String.stripPrefix(path, "/orders/")?)

fun main() {
    let address = Option.expect(Net.parse("127.0.0.1"), "an address")
    match TCP.listen(address, 8080) {
        Right(l) -> {
            let orders = Orders { items = Sync.mutex([]) }
            print("listening on 127.0.0.1:8080")
            Server.serve(l, Server.empty, fun(req, r) = handle(orders, req, r))
        }
        Left(e) -> print("listen: " + show(e))
    }
}
