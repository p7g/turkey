export (
    BitAnd(..), BitOr(..), BitXor(..), Shift(..),
    (&), (|), (^), (<<), (>>),
)

import Prelude ()
import Data.Int as Int (Int)
import Data.Byte as Byte (Byte)

-- The bitwise operators, a class each like the arithmetic ones, so that a type
-- can have some of them without the rest: a set has union, intersection and
-- symmetric difference, and nothing to shift.
class BitAnd a { fun and(a, a) -> a }
class BitOr a { fun or(a, a) -> a }
class BitXor a { fun xor(a, a) -> a }

-- One class for both directions, since whatever shifts one way shifts the
-- other. The amount is an `Int` whatever is shifted.
class Shift a {
    fun shl(a, Int) -> a
    fun shr(a, Int) -> a
}

infix BitShift (<<) = shl
infix BitShift (>>) = shr
infix BitAnd (&) = and
infix BitOr (|) = or
infix BitXor (^) = xor

-- The shifts panic outside 0..63, as `Int.shl` and `Int.shr` do.
instance BitAnd Int { fun and(a, b) = Int.and(a, b) }
instance BitOr Int { fun or(a, b) = Int.or(a, b) }
instance BitXor Int { fun xor(a, b) = Int.xor(a, b) }
instance Shift Int {
    fun shl(a, by) = Int.shl(a, by)
    fun shr(a, by) = Int.shr(a, by)
}

instance BitAnd Byte { fun and(a, b) = Byte.and(a, b) }
instance BitOr Byte { fun or(a, b) = Byte.or(a, b) }
instance BitXor Byte { fun xor(a, b) = Byte.xor(a, b) }
instance Shift Byte {
    fun shl(a, by) = Byte.shl(a, by)
    fun shr(a, by) = Byte.shr(a, by)
}
