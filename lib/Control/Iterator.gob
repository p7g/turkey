module Control.Iterator (Iterator(..), any, all, count, find)

import Prelude ()
import Data.Bool (Bool(..))
import Data.Int (Int)
import Data.Num (Add(..))
import Data.Option (Option(..))

class Iterator c {
    type Item c
    type Cursor c

    fun iter(c) -> Cursor c
    fun next(c, Cursor c) -> Option (Item c)
}

-- The questions asked of every element in turn. `any`, `all` and `find` stop
-- at the element that decides the answer and pull nothing after it, so they
-- end on an iterator that does not; none of them allocates.

fun any[Iterator c, Item c ~ a](xs : c, p : fun(a) -> Bool) -> Bool {
    for x in xs {
        if p(x) { return True }
    }
    False
}

fun all[Iterator c, Item c ~ a](xs : c, p : fun(a) -> Bool) -> Bool {
    for x in xs {
        if !p(x) { return False }
    }
    True
}

-- How many elements `p` holds for. It takes a predicate: how many elements
-- there are is `len`, which a container answers without walking itself.
fun count[Iterator c, Item c ~ a](xs : c, p : fun(a) -> Bool) -> Int {
    var n = 0
    for x in xs {
        if p(x) { n = n + 1 }
    }
    n
}

-- The first element `p` holds for.
fun find[Iterator c, Item c ~ a](xs : c, p : fun(a) -> Bool) -> Option a {
    for x in xs {
        if p(x) { return Some(x) }
    }
    None
}
