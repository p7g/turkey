export (Monad(..), (|>>))

import Prelude ()
import Control.Applicative (Applicative(..))

class Monad m : Applicative m {
    fun bind(m a, fun(a) -> m b) -> m b
}

--- `|>` for a monadic value: `m |>> f` is `bind(m, f)`. Not `>>=`, which no
--- program may declare, because an operator ending in `=` reads as an
--- assignment.
infix Sequence (|>>) = bind
