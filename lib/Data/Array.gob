import Data.Semigroup (Semigroup(..))
import Data.Monoid (Monoid(..))
import Data.Foldable (Foldable(..))
import Control.Panic (error)
import Data.Bool (Bool(..))
import Data.Int ()
import Data.Option (Option(..))
import Data.Ordering (Ordering(..))
import Data.String as Str
import Turkey.Array (outOfBounds, checkRun, sliceOutOfBounds, endedEarly, threeWay)
import Turkey.Array as Storage
import Data.Byte (Byte)
import Turkey.Bytes (ByteView(..))

-- A fixed-length array: its length is set when it is made and never changes,
-- and its elements can be assigned. Its one field cannot be assigned, so at run
-- time an `Array` is the primitive array itself, with its length in the
-- header. That header is the only length there is, so the test `get` and `set`
-- make for the program's error message is also the one that keeps the access
-- inside the storage, and in a loop bounded by `len(xs)` the compiler proves
-- both away.
--
-- An array literal the program uses as an `Array` is built as this constructor
-- applied to the primitive array, by name; renaming it means changing how the
-- compiler lowers a literal in the same commit.
type Array a = Array(Prim.Array a)

fun raw(Array(storage)) = storage

-- An `Array` of storage the caller made and hands over, for the rest of the
-- library.
fun ofStorage(storage : Prim.Array a) -> Array a = Array(storage)

-- The storage an `Array` is, for the rest of the library to hand to a bulk
-- primitive: `ofStorage` the other way.
fun storage(xs : Array a) -> Prim.Array a = raw(xs)

-- Returns a read-only view of `xs`, without copying it. The view cannot write
-- to `xs`, but whoever holds `xs` still can, and the view shows each write as
-- it happens.
fun view(xs : Array Byte) -> ByteView {
    let b = raw(xs)
    ByteView { storage = b, from = 0, length = len(b) }
}

fun filled(length : Int, value : a) -> Array a = Array(Storage.filled(length, value))

-- Element `i` is `f(i)`, computed in order from 0.
fun init(length : Int, f : fun(Int) -> a) -> Array a {
    let out = Storage.uninitialized(length)
    for var i = 0; i < length; i = i + 1 { out[i] = f(i) }
    Array(out)
}

-- `f` of each element of `xs`, in order. `xs` is anything with a length that
-- can be iterated, so a `Vec` maps straight to an `Array`.
--
-- The loop counts to the length rather than running to the end of the
-- iteration, so every slot of the result is written: an iterator that ends
-- early -- a `Vec` that `f` pops from -- panics instead of leaving a hole.
fun map[Iterator c, Length c, Item c ~ a](xs : c, f : fun(a) -> b) -> Array b {
    let n = len(xs)
    let out = Storage.uninitialized(n)
    let cursor = iter(xs)
    for var i = 0; i < n; i = i + 1 {
        match next(xs, cursor) {
            Some(x) -> { out[i] = f(x) }
            None -> endedEarly("Array.map", i, n)
        }
    }
    Array(out)
}

-- How many elements are kept is known only at the end, and `keep` is called
-- once per element, in order. So the kept ones go into scratch storage as long
-- as `xs`, which is copied once into an array of their number unless they are
-- all of it.
fun filter(xs : Array a, keep : fun(a) -> Bool) -> Array a {
    let kept = Storage.uninitialized(len(xs))
    var count = 0
    for x in xs {
        if keep(x) {
            kept[count] = x
            count = count + 1
        }
    }
    if count == len(kept) { return Array(kept) }
    Array(Storage.copy(kept, count))
}

-- Returns the result of calling `step` on the accumulator and each element in
-- turn. `Iter.fold` takes the same arguments and works on anything iterable.
fun fold(xs : Array a, initial : b, step : fun(b, a) -> b) -> b {
    var acc = initial
    for x in xs { acc = step(acc, x) }
    acc
}

fun reverse(xs : Array a) -> Array a {
    let n = len(xs)
    init(n, fun(i) = xs[n - 1 - i])
}

fun append(xs : Array a, ys : Array a) -> Array a {
    let n = len(xs)
    let m = len(ys)
    let out = Storage.uninitialized(n + m)
    Storage.move(out, 0, raw(xs), 0, n)
    Storage.move(out, n, raw(ys), 0, m)
    Array(out)
}

-- Copy `count` elements of `source`, from index `from` on, over those of
-- `target` from index `at` on. The two may be one array, and the runs may
-- overlap: every element arrives as it was before the copy began. Panics
-- unless both runs are inside their arrays.
fun copy(target : Array a, at : Int, source : Array a, from : Int, count : Int)
        -> Unit {
    checkRun("Array.copy", "target", at, count, len(target))
    checkRun("Array.copy", "source", from, count, len(source))
    Storage.move(raw(target), at, raw(source), from, count)
}

-- Set the `count` elements of `target` from index `at` on to `value`.
-- Panics unless they are all elements of `target`.
fun fill(target : Array a, at : Int, count : Int, value : a) -> Unit {
    checkRun("Array.fill", "target", at, count, len(target))
    Storage.fill(raw(target), at, count, value)
}

-- -- reading without panicking -------------------------------------------------
--
-- `xs[i]` is the `Index` method and panics, which is right for a program that
-- knows the index is good. `at` is for the one that is asking.
--
-- Not called `get`: that name belongs to the `Index` class, and this is not an
-- instance of it -- an `Index` method must answer `Index.Value`, which is the
-- element, not an `Option` of it.

fun at(xs : Array a, i : Int) -> Option a =
    if i < 0 || i >= len(xs) { None } else { Some(xs[i]) }

fun last(xs : Array a) -> Option a = at(xs, len(xs) - 1)

fun swap(xs : Array a, i : Int, j : Int) -> Unit {
    let x = xs[i]
    xs[i] = xs[j]
    xs[j] = x
}

-- A copy, not a view: writing to one leaves the other as it was.
fun slice(xs : Array a, from : Int, to : Int) -> Array a {
    if from < 0 || to > len(xs) || from > to {
        sliceOutOfBounds("Array.slice", from, to, len(xs))
    }
    let out = Storage.uninitialized(to - from)
    Storage.move(out, 0, raw(xs), from, to - from)
    Array(out)
}

fun indexOf[Eq a](xs : Array a, wanted : a) -> Option Int {
    for var i = 0; i < len(xs); i = i + 1 {
        if xs[i] == wanted { return Some(i) }
    }
    None
}

fun contains[Eq a](xs : Array a, wanted : a) -> Bool = match indexOf(xs, wanted) {
    Some(_) -> True
    None -> False
}

-- A stable sort, answering a new `Array`; `Turkey.Array` says how.
fun sortBy(xs : Array a, compare : fun(a, a) -> Ordering) -> Array a {
    let storage = raw(xs)
    Array(Storage.sorted(storage, len(storage), compare))
}

fun sort[Ord a](xs : Array a) -> Array a = sortBy(xs, threeWay)

-- Sorted by `key`, stably, calling `key` once per element. Each element is
-- paired with its key and the pairs sorted, which costs two arrays of pairs
-- where comparing `key(a)` with `key(b)` would cost none, and is worth it:
-- that would call `key` twice per comparison, and a key is often a lookup or
-- a system call.
fun sortByKey[Ord k](xs : Array a, key : fun(a) -> k) -> Array a {
    let keyed = map(xs, \(key(_), _))
    map(sortBy(keyed, fun((j, _), (k, _)) = threeWay(j, k)), _.1)
}

instance Index (Array a) {
    type Key = Int
    type Value = a
    fun get(xs, i) {
        let storage = raw(xs)
        if i < 0 || i >= len(storage) {
            outOfBounds("read at", i, len(storage))
        }
        storage[i]
    }
}

instance SetIndex (Array a) {
    fun set(xs, i, x) {
        let storage = raw(xs)
        if i < 0 || i >= len(storage) {
            outOfBounds("write at", i, len(storage))
        }
        storage[i] = x
    }
}

instance Length (Array a) { fun len(xs) = len(raw(xs)) }

type ArrayCursor = ArrayCursor { var at : Int }

instance Iterator (Array a) {
    type Item = a
    type Cursor = ArrayCursor
    fun iter(xs) = ArrayCursor { at = 0 }
    -- Reads the storage directly rather than through `get`, whose test is the
    -- one made here against the same length.
    fun next(xs, cur) {
        let storage = raw(xs)
        if cur.at >= len(storage) { return None }
        let x = storage[cur.at]
        cur.at = cur.at + 1
        Some(x)
    }
}

instance Add (Array a) { fun add(xs, ys) = append(xs, ys) }
instance Semigroup (Array a) { fun combine(xs, ys) = append(xs, ys) }
instance Monoid (Array a) { fun empty() = [] }

instance Foldable Array {
    fun foldMap[Monoid m](xs, f) {
        var acc : m = empty()
        for x in xs { acc = combine(acc, f(x)) }
        acc
    }
}

instance Functor Array { fun map(xs, f) = map(xs, f) }

instance Applicative Array { fun pure(x) = [x] }

-- Every `f(x)` is made first, so the result is allocated once, at their total
-- length.
instance Monad Array {
    fun bind(xs, f) {
        let parts = map(xs, f)
        var total = 0
        for part in parts { total = total + len(part) }
        let out = Storage.uninitialized(total)
        var at = 0
        for part in parts {
            Storage.move(out, at, raw(part), 0, len(part))
            at = at + len(part)
        }
        Array(out)
    }
}

-- Equal when they have the same length and equal elements at each index.
instance Eq (Array a) : Eq a {
    fun eq(xs, ys) {
        let left = raw(xs)
        let right = raw(ys)
        if len(left) != len(right) { return False }
        for var i = 0; i < len(left); i = i + 1 {
            if left[i] != right[i] { return False }
        }
        True
    }
}

-- Compares element by element from the front: the first index where the two
-- differ decides, and an array that is a proper prefix of the other is less.
instance Ord (Array a) : Ord a {
    fun lt(xs, ys) {
        let left = raw(xs)
        let right = raw(ys)
        for var i = 0; i < len(left) && i < len(right); i = i + 1 {
            if left[i] < right[i] { return True }
            if right[i] < left[i] { return False }
        }
        len(left) < len(right)
    }
}

-- Its elements, as the array literal that builds it.
instance Debug (Array a) : Debug a { fun debug(xs) = debug(raw(xs)) }

-- What its `Debug` prints: a container's text shows its elements' `Debug`,
-- so that a string in it is quoted.
instance Show (Array a) : Debug a { fun show(xs) = debug(xs) }
