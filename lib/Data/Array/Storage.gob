module Data.Array.Storage (outOfBounds, checkRun, sorted, copy, threeWay)

-- What `Data.Array` and `Data.Vec` share. Both keep their elements in the
-- first `length` slots of a `Prim.Array` -- all of them, for an `Array` -- so
-- what is written here takes that storage and its length rather than either
-- container.

import Prelude ()
import Std.Classes
import Data.Bool.Type (Bool(..))
import Data.Int ()
import Data.Int as Int
import Data.Ordering.Type (Ordering(..))
import Data.String.Type as Str

-- The message is built in its own function, and that is the whole point of
-- it being one. Every string in it is allocated, so building it inline made
-- the *failure* path decide what the success path costs: the pointers live
-- across those allocations all need to be visible to the collector, so
-- `bounds` paid a thirteen-slot root frame, a root registration and a 288-byte
-- stack frame on every in-range access, and was too large to inline besides.
-- Rust outlines the same path into a cold `panic_bounds_check` for the same
-- reason.
fun outOfBounds(operation : String, i : Int, length : Int) -> a {
    Prim.error(Str.concat(
        Str.concat(
            Str.concat(
                Str.concat("array index out of bounds: ", operation),
                " index "),
            Int.toString(i)),
        Str.concat(", length ", Int.toString(length))))
}

-- Panic unless the `count` elements from `at` on are all among the first
-- `length`, for the operations on a run of elements. Outlined for the same
-- reason as `outOfBounds`.
fun checkRun(operation : String, at : Int, count : Int, length : Int) -> Unit {
    if count < 0 || at < 0 || at > length - count {
        runOutOfBounds(operation, at, count, length)
    }
}

fun runOutOfBounds(operation : String, at : Int, count : Int, length : Int) -> a {
    Prim.error(Str.concat(
        Str.concat(
            Str.concat(
                Str.concat(
                    Str.concat(Str.concat("array ", operation), " out of bounds: "),
                    Int.toString(at)),
                Str.concat("..", Int.toString(at + count))),
            ", length "),
        Int.toString(length)))
}

-- -- sorting -------------------------------------------------------------------
--
-- A stable merge sort of the first `length` elements, into new storage of
-- exactly that length. Stable because the alternative is a sort whose result
-- depends on how the input happened to be arranged, which makes any recorded
-- output a coin toss.
--
-- Merge, not quicksort: n log n is a bound rather than an average, there is no
-- pivot choice to get wrong on already-sorted input, and stability is free. The
-- scratch array is allocated once for the whole sort rather than per merge.
--
-- On `Ord Float`, the language's one lawless instance: this terminates and
-- panics nowhere, and on an array containing NaN the result is unspecified
-- rather than sorted. Passing `Float.totalCompare` to
-- `sortBy` is how to have an opinion about NaN.

fun sorted(storage : Prim.Array a, length : Int,
           compare : fun(a, a) -> Ordering) -> Prim.Array a {
    let out = copy(storage, length)
    if length < 2 { return out }
    mergeRange(out, copy(storage, length), 0, length, compare)
    out
}

-- The first `length` elements of `storage`, in storage of their own.
fun copy(storage : Prim.Array a, length : Int) -> Prim.Array a {
    let out = Prim.arrayNewUninit(length)
    Prim.arrayCopy(out, 0, storage, 0, length)
    out
}

fun mergeRange(xs : Prim.Array a, scratch : Prim.Array a, lo : Int, hi : Int,
               compare : fun(a, a) -> Ordering) -> Unit {
    if hi - lo < 2 { return }
    let mid = lo + (hi - lo) / 2
    mergeRange(xs, scratch, lo, mid, compare)
    mergeRange(xs, scratch, mid, hi, compare)
    var left = lo
    var right = mid
    var out = lo
    while out < hi {
        if left >= mid {
            Prim.arraySet(scratch, out, Prim.arrayGet(xs, right))
            right = right + 1
        } else if right >= hi {
            Prim.arraySet(scratch, out, Prim.arrayGet(xs, left))
            left = left + 1
        } else {
            let r = Prim.arrayGet(xs, right)
            let l = Prim.arrayGet(xs, left)
            -- The left run wins ties, which is what makes this stable.
            match compare(r, l) {
                LT -> {
                    Prim.arraySet(scratch, out, r)
                    right = right + 1
                }
                _ -> {
                    Prim.arraySet(scratch, out, l)
                    left = left + 1
                }
            }
        }
        out = out + 1
    }
    Prim.arrayCopy(xs, lo, scratch, lo, hi - lo)
}

-- `Ord` answers in `Bool`, so a three-way comparison costs two questions.
-- `Ordering` is the shape a sort wants, and this is the adapter.
fun threeWay[Ord a](x : a, y : a) -> Ordering {
    if x < y { return LT }
    if y < x { return GT }
    EQ
}
