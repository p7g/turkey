module Data.Bifunctor (first, second)

import Prelude ()
import Std.Classes

-- `Data.Bifunctor.first` in Haskell, and the operation `Control.Arrow.left`
-- also denotes -- `left` reaches it through `ArrowChoice` at `(->)`, which is
-- an accident of the arrow hierarchy rather than the thing meant.
fun first[Bifunctor f](x : f a b, g : fun(a) -> c) -> f c b =
    bimap(x, g, fun(y) = y)

fun second[Bifunctor f](x : f a b, h : fun(b) -> d) -> f a d =
    bimap(x, fun(y) = y, h)
