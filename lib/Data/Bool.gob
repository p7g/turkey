export (Bool(..), toString, not)

import Prelude ()
import Data.String (String)
import Data.Eq (Eq(..), (==), (!=))
import Data.Ord (Ord(..), (<), (<=), (>), (>=))
import Text.Show (Show(..))
import Data.Hashable (Hash(..), Hasher(..))

type Bool = False | True

fun toString(b : Bool) -> String = match b {
    True -> "True"
    False -> "False"
}

fun not(b : Bool) -> Bool = match b {
    True -> False
    False -> True
}

instance Eq Bool { fun eq(x, y) = Prim.boolEq(x, y) }
instance Ord Bool { fun lt(x, y) = Prim.boolLt(x, y) }
instance Show Bool { fun show(x) = toString(x) }

instance Hash Bool {
    fun hashInto(b, h) = hashInt(h, match b {
        False -> 0
        True -> 1
    })
}
