module (
    Byte,
    toInt,
    fromInt,
    truncate,
    minValue,
    maxValue,
    and,
    or,
    xor,
    not,
    shl,
    shr,
    getLE,
    getBE,
    putLE,
    putBE,
)

import Prelude ()
import Data.Int (Int)
import Data.Eq (Eq(..))
import Data.Ord (Ord(..))
import Text.Show (Show(..))
import Data.Hashable (Hash(..), Hasher(..))
import Data.Bool (Bool(..))
import Data.Int ()
import Data.Int as Int
import Data.Option (Option(..))
import Data.Tuple (Unit)
import Data.Num (Add(..), Sub(..))
import Data.Index (Index(..), SetIndex(..))
import Control.Panic (error)

-- An integer from 0 to 255, which the compiler provides.
type Byte = Prim.Byte

-- `Byte` is an unsigned 8-bit integer, and it exists for exactly one reason:
-- to be the element of `Array Byte`, which is how bytes enter and leave a
-- `String` (`String.toBytes` / `String.fromBytes`) and how any future I/O
-- layer will speak.
--
-- It is therefore a *storage* type, and it has no arithmetic instances at
-- all -- no `Add`, `Sub`, `Mul`, `Div`, `Neg`. Byte arithmetic goes through
-- `Int`, which dodges the whole "does `u8 + u8` wrap, trap, or promote"
-- question. Adding instances later is backward-compatible; removing them
-- would not be.

fun toInt(b : Byte) -> Int = Prim.byteToInt(b)

fun fromInt(n : Int) -> Option Byte =
    if n >= 0 && n <= 255 { Some(Prim.byteFromInt(n)) } else { None }

-- The low eight bits, total and explicitly lossy. The name is the warning.
fun truncate(n : Int) -> Byte = Prim.byteFromInt(Int.and(n, 255))

fun minValue() -> Byte = Prim.byteFromInt(0)
fun maxValue() -> Byte = Prim.byteFromInt(255)

fun and(a : Byte, b : Byte) -> Byte =
    Prim.byteFromInt(Int.and(toInt(a), toInt(b)))

fun or(a : Byte, b : Byte) -> Byte =
    Prim.byteFromInt(Int.or(toInt(a), toInt(b)))

fun xor(a : Byte, b : Byte) -> Byte =
    Prim.byteFromInt(Int.xor(toInt(a), toInt(b)))

fun not(a : Byte) -> Byte = Prim.byteFromInt(Int.xor(toInt(a), 255))

-- Shifting happens in `Int` and the result is narrowed, so bits shifted off
-- the top are discarded. The shift amount is `Int.shl`'s, so it panics outside
-- 0..63 rather than masking.
fun shl(a : Byte, by : Int) -> Byte = truncate(Int.shl(toInt(a), by))
fun shr(a : Byte, by : Int) -> Byte = Prim.byteFromInt(Int.shr(toInt(a), by))

-- -- integers as bytes ---------------------------------------------------------------

-- The `width`-byte integer at `at` in `bytes`, for a `width` from 1 to 8:
-- least significant byte first for `getLE`, most significant first for
-- `getBE`. Narrower than 8 bytes it is unsigned; at 8 it fills an `Int`, so a
-- top bit set reads as a negative number. These work on anything indexed by
-- `Int` with `Byte` elements, `Array Byte` and `Vec Byte` among them, and
-- panic as indexing does if the bytes run past the end.
fun getLE[Index c, Key c ~ Int, Value c ~ Byte](bytes : c, at : Int, width : Int) -> Int {
    checkWidth(width)
    var value = 0
    for var k = width - 1; k >= 0; k = k - 1 {
        value = Int.or(Int.shl(value, 8), toInt(bytes[at + k]))
    }
    value
}

fun getBE[Index c, Key c ~ Int, Value c ~ Byte](bytes : c, at : Int, width : Int) -> Int {
    checkWidth(width)
    var value = 0
    for var k = 0; k < width; k = k + 1 {
        value = Int.or(Int.shl(value, 8), toInt(bytes[at + k]))
    }
    value
}

-- Write the low `width` bytes of `n` at `at`, in the order `getLE` and
-- `getBE` read them. The bits above them are dropped, as `truncate` drops
-- them, so a negative `n` writes its two's complement.
fun putLE[SetIndex c, Key c ~ Int, Value c ~ Byte](into : c, at : Int, width : Int,
                                                    n : Int) -> Unit {
    checkWidth(width)
    var rest = n
    for var k = 0; k < width; k = k + 1 {
        into[at + k] = truncate(rest)
        rest = Int.shr(rest, 8)
    }
}

fun putBE[SetIndex c, Key c ~ Int, Value c ~ Byte](into : c, at : Int, width : Int,
                                                    n : Int) -> Unit {
    checkWidth(width)
    var rest = n
    for var k = width - 1; k >= 0; k = k - 1 {
        into[at + k] = truncate(rest)
        rest = Int.shr(rest, 8)
    }
}

fun checkWidth(width : Int) -> Unit {
    if width < 1 || width > 8 { error("an integer is 1 to 8 bytes wide") }
}

instance Eq Byte { fun eq(x, y) = Prim.byteEq(x, y) }
instance Ord Byte { fun lt(x, y) = Prim.byteLt(x, y) }
instance Show Byte { fun show(b) = Int.toString(toInt(b)) }

instance Hash Byte {
    fun hashInto(b, h) = update(h, b)
}
