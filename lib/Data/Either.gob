export (Either(..), isRight, left, right, unwrapOr, map, mapLeft, fold)

import Prelude ()
import Data.String (String)
import Text.Show (Show(..))
import Debug (Debug(..))
import Data.Functor (Functor(..))
import Control.Applicative (Applicative(..))
import Control.Monad (Monad(..))
import Data.Foldable (Foldable(..))
import Data.Bifunctor (Bifunctor(..))
import Data.Bool (Bool(..))
import Data.Option (Option(..))
import Data.String as Str

type Either l r = Left(l) | Right(r)

fun isRight(e : Either l r) -> Bool = match e {
    Right(_) -> True
    Left(_) -> False
}

--- The one side, with the other forgotten.
fun left(e : Either l r) -> Option l = if let Left(x) = e { Some(x) } else { None }

fun right(e : Either l r) -> Option r = if let Right(x) = e { Some(x) } else { None }

fun unwrapOr(e : Either l r, fallback : r) -> r = match e {
    Right(x) -> x
    Left(_) -> fallback
}

fun map(e : Either l a, f : fun(a) -> b) -> Either l b = match e {
    Right(x) -> Right(f(x))
    Left(x) -> Left(x)
}

--- The left half of `bimap`, named for what it maps rather than for what a
--- `Left` is assumed to mean. `Either` is not `Result`: a `Left` is the other
--- case, not a failure, so this is `mapLeft` and not `mapError`. Promoting an
--- error into the shared channel is `Data.Error.promote`, which is this
--- function applied to `fail`.
fun mapLeft(e : Either l r, f : fun(l) -> m) -> Either m r = match e {
    Left(x) -> Left(f(x))
    Right(x) -> Right(x)
}

fun fold(e : Either l r, onLeft : fun(l) -> a, onRight : fun(r) -> a) -> a = match e {
    Left(x) -> onLeft(x)
    Right(x) -> onRight(x)
}

instance Functor (Either l) {
    fun map(e, f) = map(e, f)
}

-- `Either` is the one instance the library can write today. A pair should be
-- one too, and cannot be: `(a, b)` has kind `*` with no partially applicable
-- head, and an alias cannot supply one either.
instance Bifunctor Either {
    fun bimap(e, g, h) = match e {
        Left(x) -> Left(g(x))
        Right(x) -> Right(h(x))
    }
}

instance Applicative (Either l) { fun pure(x) = Right(x) }

instance Monad (Either l) {
    fun bind(e, g) = match e {
        Right(x) -> g(x)
        Left(y) -> Left(y)
    }
}

--- What its `Debug` prints: a container's text shows its elements' `Debug`,
--- so that a string in it is quoted.
instance Show (Either l r) : Debug l, Debug r { fun show(e) = debug(e) }
