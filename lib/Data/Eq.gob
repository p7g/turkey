export (Eq(..), (==), (!=))

import Prelude ()
import Data.Bool (Bool(..))

class Eq a {
    fun eq(a, a) -> Bool
    fun ne(x : a, y : a) -> Bool = !eq(x, y)
}

infix Equality (==) = eq
infix Equality (!=) = ne

-- Addresses, equal when they are the same address. Here because `Prim.Ptr`
-- is built in, and an instance for a built-in type goes with its class.
instance Eq Prim.Ptr { fun eq(x, y) = Prim.ptrEq(x, y) }

-- `()` is its only value. Here for the same reason as `Prim.Ptr`'s.
instance Eq () { fun eq(_, _) = True }
