export (
	Error(..),
	SomeError(..),
	fail,
	throw,
	promote,
	context,
	causeOf,
	messageOf,
	describe,
	cast,
	find,
)

import Prelude ()
import Data.String (String)
import Data.Eq ((==))
import Data.Num ((+))
import Text.Show (Show(..))
import Data.Typed (Typed(..))
import Data.Either (Either(..), mapLeft)
import Data.Option (Option(..))
import Data.Typed (Proxy(..))

--- What every payload in the shared error channel can do.
--- `Typed` is a superclass so that a packed payload can be asked what it is:
--- the `Error` dictionary an existential carries has the `Typed` one inside
--- it, which is how `cast` reaches a rep it never saw packed.
class Error e : Typed e { fun message(e) -> String }

--- The shared recoverable-error channel. A source packs
--- its own concrete payload once, with `fail`; every caller in between
--- propagates the result with `?` and never converts anything. What makes that
--- possible is the constructor's `[Error e]` bracket: the payload's type is
--- hidden, and its `Error` dictionary travels with the value, so a caller that
--- knows nothing about the source can still ask for its message.
---
--- `cause` is how context is added without losing an origin. `context` builds a
--- new error *around* the one it is given rather than repacking it, so the inner
--- payload and everything below it stay reachable through `causeOf`. GHC's
--- annotations went the other way -- a rethrow cleared the context and silently
--- dropped it (Well-Typed, 2026) -- and a field that is only ever written by
--- `context` cannot lose anything that way.
type SomeError = SomeError[Error e] { payload : e, cause : Option SomeError }

-- The rule for the library's public functions that can fail: return
-- `Either SomeError a`, and pack the module's own error type once, where it
-- is made. A caller outside the module needs nothing of that type beyond
-- `cast` and `find`, and one error type at every boundary is what lets `?`
-- mix calls into several modules without `promote`.
--
-- Keep an error typed where the code that made it decides on it, and convert
-- at the edge: the HTTP layers refuse a message or retry a stale connection
-- on theirs, and `Time.Zone` tells an unknown zone from an unreadable one.
-- For the same reason `Read` and `Write` keep their associated error types,
-- and so do the functions generic over them. A parser whose failure callers
-- routinely act on, such as `Int.parse` or `URL.parse`, returns `Option` or
-- an error type of its own.
--
-- Two public functions break the rule and return `Either IOError a`:
-- `Signal.listen` and `Net.Memory.connect`.

--- Packs `value` into the channel, with no cause. `throw` packs it and
--- returns it as a failed result in one step.
fun fail[Error e](value : e) -> SomeError =
	SomeError { payload = value, cause = None }

--- Returns `Left(fail(value))`: a failed result whose error is `value`, packed
--- with no cause.
fun throw[Error e](value : e) -> Either SomeError a = Left(fail(value))

--- Move a whole result into the shared channel: `mapLeft` through `fail`.
---
--- It lives here rather than on `Either` because `Either` knows nothing about
--- errors, and it is written in terms of `fail` rather than packing directly so
--- that entering the channel has exactly one implementation -- whatever `fail`
--- comes to do about already-packed payloads and captured call sites, promotion
--- does too, without a second place to keep in step.
fun promote[Error e](x : Either e a) -> Either SomeError a = mapLeft(x, fail)

--- Add context, keeping `inner` as the cause. The new payload is what a reader
--- sees first; the original is one `causeOf` away and still carries its own.
fun context[Error e](inner : SomeError, value : e) -> SomeError =
	SomeError { payload = value, cause = Some(inner) }

-- A packed payload is read by opening it, never by `.field`: the field's type
-- is the hidden one, so `.payload` has no type to have. These three are the
-- whole accessible surface, and each opens the value in a `match` arm.
fun causeOf(s : SomeError) -> Option SomeError = match s {
	SomeError { payload = _, cause = c } -> c
}

fun messageOf(s : SomeError) -> String = match s {
	SomeError { payload = p, cause = _ } -> message(p)
}

--- The whole chain, outermost first.
fun describe(s : SomeError) -> String = match s {
	SomeError { payload = p, cause = c } -> match c {
		None        -> message(p)
		Some(inner) -> message(p) + ": " + describe(inner)
	}
}

instance Show SomeError { fun show(s) = describe(s) }

--- One of two errors, as a layer that wraps another describes its failures:
--- its own on the `Left`, the one it wraps on the `Right`. The message is the
--- side's own, with nothing added, so a layer's error reads as what went wrong.
instance Error (Either l r) : Error l, Error r {
	fun message(x) = match x {
		Left(e)  -> message(e)
		Right(e) -> message(e)
	}
}

-- A type named without a value of it, for a payload whose type is hidden.
fun proxyOf[Typed a](x : a) -> Proxy a = Proxy

--- Recover the concrete payload, if it is the type asked for.
---
--- This is the whole reason `Typed` is a superclass of `Error`: opening the
--- error gives a payload whose type nothing here knows, and the dictionary
--- packed beside it answers what that type was. Comparing that rep with the
--- caller's is the check -- there is nothing downstream that would catch a
--- wrong answer, which is why a program may not write a `Typed` instance.
---
--- The conversion runs only once the type reps compare equal: `Prim.castAs` is
--- total and unchecked, and is spellable only from a library module, so no
--- unchecked coercion reaches ordinary Turkey.
fun cast[Typed a](err : SomeError) -> Option a {
	let want : Proxy a = Proxy
	match err {
		SomeError { payload = p, cause = _ } ->
			if typeRep(want) == typeRep(proxyOf(p)) {
				Some(Prim.castAs(p))
			} else {
				None
			}
	}
}

--- Returns the payload of the first error along `err`'s cause chain,
--- outermost first, that has type `a`, or `None` when no error in the chain
--- has. `err` itself is the first one looked at.
fun find[Typed a](err : SomeError) -> Option a = match cast(err) {
	Some(found) -> Some(found)
	None -> match causeOf(err) {
		Some(inner) -> find(inner)
		None        -> None
	}
}
