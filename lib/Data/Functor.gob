export (Functor(..), fmap, (<&>), (<$>))

import Prelude ()

class Functor f {
    fun map(f a, fun(a) -> b) -> f b
}

-- Returns `map(xs, g)`: the same function, with the function first.
fun fmap[Functor f](g : fun(a) -> b, xs : f a) -> f b = map(xs, g)

-- Both are in `Sequence`, which is left-associative, so a chain of maps is
-- written container first: `xs <&> f <&> g`. The same chain with `<$>`,
-- `g <$> f <$> xs`, groups as `(g <$> f) <$> xs` and is a type error.
infix Sequence (<&>) = map
infix Sequence (<$>) = fmap
