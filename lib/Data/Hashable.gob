module Data.Hashable (Hasher(..), Hash(..))

import Prelude ()
import Data.Int (Int)
import Data.Byte (Byte)
import Data.Tuple (Unit)
import Data.Eq (Eq(..))

class Hasher h {
    fun digest(h) -> Int
    fun update(h, Byte) -> Unit
}

class Hash a : Eq a {
    fun hashInto[Hasher h](a, h) -> Unit
}
