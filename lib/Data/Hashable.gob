export (Hasher(..), Hash(..))

import Prelude ()
import Data.Int (Int)
import Data.Byte (Byte)
import Data.Tuple (Unit)
import Data.Eq (Eq(..), (==), (!=))

-- A hash function's running state, fed a key's parts in order.
--
-- A hasher takes a whole word or a whole run of bytes per call, never a byte
-- at a time: every hash worth having mixes 64 bits per step, and one call per
-- byte costs a call and a state update per byte whatever the function is.
class Hasher h {
    -- Returns a fresh state for a table whose seed is `seed`. Two states made
    -- from one seed digest equal inputs to equal values.
    fun seeded(Int) -> h

    -- Absorbs one word. Every scalar a key holds -- an `Int`, a `Char`, a
    -- `Byte`, a constructor's tag, a length -- goes in through here.
    fun writeInt(h, Int) -> Unit

    -- Absorbs `bytes[from]` up to but not including `bytes[to]`, as one run.
    fun writeBytes(h, Prim.Array Byte, Int, Int) -> Unit

    -- Returns the hash of everything absorbed so far.
    fun digest(h) -> Int
}

class Hash a : Eq a {
    fun hashInto[Hasher h](a, h) -> Unit
}
