module Data.Index (Index(..), SetIndex(..), Length(..))

import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)
import Data.Bool (Bool(..))
import Data.Ord (Ord(..))
import Data.Array.Storage (outOfBounds)

class Index c {
    type Key c
    type Value c

    fun get(c, Key c) -> Value c
}

-- Separate from `Index` so that a type can be read by key without being
-- writable: `xs[i]` asks only for `Index`, and `xs[i] = v` for this.
class SetIndex c : Index c { fun set(c, Key c, Value c) -> Unit }

class Length c { fun len(c) -> Int }

-- The instances for `Prim.Array` are here because the language owns the type,
-- so the class's module is the only one the orphan rule admits. They check
-- bounds against the whole array; storage with a length of its own, like a
-- `Vec`'s, checks against that and reads with `Prim.arrayGet`.

instance Index (Prim.Array a) {
    type Key = Int
    type Value = a
    fun get(xs, i) {
        if i < 0 || i >= Prim.arrayLength(xs) {
            outOfBounds("read at", i, Prim.arrayLength(xs))
        }
        Prim.arrayGet(xs, i)
    }
}

instance SetIndex (Prim.Array a) {
    fun set(xs, i, x) {
        if i < 0 || i >= Prim.arrayLength(xs) {
            outOfBounds("write at", i, Prim.arrayLength(xs))
        }
        Prim.arraySet(xs, i, x)
    }
}

instance Length (Prim.Array a) { fun len(xs) = Prim.arrayLength(xs) }
