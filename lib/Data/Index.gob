module Data.Index (Index(..), SetIndex(..), Length(..))

import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)

class Index c {
    type Key c
    type Value c

    fun get(c, Key c) -> Value c
}

-- Separate from `Index` so that a type can be read by key without being
-- writable: `xs[i]` asks only for `Index`, and `xs[i] = v` for this.
class SetIndex c : Index c { fun set(c, Key c, Value c) -> Unit }

class Length c { fun len(c) -> Int }

-- The instances for `Prim.Array` are here because the language owns the type,
-- so the class's module is the only one the orphan rule admits. They are the
-- primitives and nothing more: a primitive access is already checked against
-- the array's length. A type a program can name tests the index itself first,
-- for a panic that says which index and what length.

instance Index (Prim.Array a) {
    type Key = Int
    type Value = a
    fun get(xs, i) = Prim.arrayGet(xs, i)
}

instance SetIndex (Prim.Array a) { fun set(xs, i, x) = Prim.arraySet(xs, i, x) }

instance Length (Prim.Array a) { fun len(xs) = Prim.arrayLength(xs) }
