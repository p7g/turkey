import Turkey.Process as Process
import Turkey.Array as Storage

-- The 64-bit signed integer, which the compiler provides.
type Int = Prim.Int

-- Decimal, with a leading `-` for a negative number. The digits are peeled off
-- a non-positive copy, because `minValue` has no positive counterpart to peel
-- them from; `%` takes the dividend's sign, so each remainder is in -9..0.
fun toString(n : Int) -> String {
    let digits = Storage.uninitialized(19)
    var count = 0
    var rest = if n < 0 { n } else { -n }
    loop {
        digits[count] = Byte.truncate(48 - rest % 10)
        count = count + 1
        rest = rest / 10
        if rest == 0 { break }
    }
    let sign = if n < 0 { 1 } else { 0 }
    let out = Storage.uninitialized(sign + count)
    if n < 0 { out[0] = Byte.truncate(45) }
    for var i = 0; i < count; i = i + 1 {
        out[sign + i] = digits[count - 1 - i]
    }
    String(out)
}

-- `Int` is two's-complement 64-bit, so these are constants -- but the low one
-- cannot be *written*. `-9223372036854775808` lexes as a unary minus applied
-- to `9223372036854775808`, which is not an `Int`, so the literal is rejected
-- before the negation can rescue it. Subtracting from the representable
-- maximum is the way round it.
fun minValue() -> Int = -0x7FFF_FFFF_FFFF_FFFF - 1
fun maxValue() -> Int = 0x7FFF_FFFF_FFFF_FFFF

fun compare(a : Int, b : Int) -> Ordering {
    if a < b { return LT }
    if a > b { return GT }
    EQ
}

-- Floored, so the result takes the sign of the *divisor* and is therefore a
-- valid index for every positive `b`. `%` is remainder and takes the sign of
-- the dividend; the difference bites exactly where people reach for it, which
-- is bucket selection.
fun mod(a : Int, b : Int) -> Int {
    let r = a % b
    if r != 0 && (r < 0) != (b < 0) { r + b } else { r }
}

-- Panics on `minValue()`, which has no positive counterpart. That is the
-- trapping behaviour of `neg`, not an extra rule.
fun abs(n : Int) -> Int = if n < 0 { -n } else { n }

fun addWrapping(a : Int, b : Int) -> Int = Prim.intAddWrapping(a, b)
fun subWrapping(a : Int, b : Int) -> Int = Prim.intSubWrapping(a, b)
fun mulWrapping(a : Int, b : Int) -> Int = Prim.intMulWrapping(a, b)
fun negWrapping(a : Int) -> Int = Prim.intNegWrapping(a)

-- Returns the high 64 bits of the 128-bit product of `a` and `b`, both read as
-- unsigned. With `mulWrapping`, which is the low 64 bits, it is the whole
-- product.
fun mulHighUnsigned(a : Int, b : Int) -> Int = Prim.intMulHighUnsigned(a, b)

-- The checked forms are written in terms of the wrapping ones and a proof
-- read back off the result, because the language has no way to catch the
-- panic that `+` would raise. `a + b` overflowed exactly when the wrapped sum
-- disagrees with the true sign rule: operands of the same sign must produce
-- that sign.
fun addChecked(a : Int, b : Int) -> Option Int {
    let sum = addWrapping(a, b)
    if (a < 0) == (b < 0) && (sum < 0) != (a < 0) { None } else { Some(sum) }
}

fun subChecked(a : Int, b : Int) -> Option Int {
    let diff = subWrapping(a, b)
    if (a < 0) != (b < 0) && (diff < 0) != (a < 0) { None } else { Some(diff) }
}

fun mulChecked(a : Int, b : Int) -> Option Int {
    -- `a == 0` is the one case the divide-back check cannot be run for, and
    -- `minValue() * -1` is the one case where running it would *itself* trap:
    -- the wrapped product is `minValue()` again, so `product / a` would be
    -- `minValue() / -1`. Both are answered before the division happens.
    if a == 0 || b == 0 { return Some(0) }
    if a == -1 && b == minValue() { return None }
    if b == -1 && a == minValue() { return None }
    let product = mulWrapping(a, b)
    -- Dividing back is the cheap check that does not need a wider type: it is
    -- exact whenever the multiplication did not overflow.
    if product / a == b { Some(product) } else { None }
}

fun negChecked(a : Int) -> Option Int =
    if a == minValue() { None } else { Some(-a) }

-- -- parsing ----------------------------------------------------------------

-- Returns `s` read as a decimal `Int`, or `None`; see `parseRadix`.
fun parse(s : String) -> Option Int = parseRadix(s, 10)

-- Returns the value of the digit byte `b` (`0`-`9`, then `a`-`z` or `A`-`Z`
-- for 10-35), or -1 when `b` is not an alphanumeric ASCII byte.
fun digitOf(b : Int) -> Int {
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 97 && b <= 122 { return b - 87 }
    if b >= 65 && b <= 90 { return b - 55 }
    -1
}

-- Parses `s` in base `radix`, which must be in 2..36 (a panic otherwise).
-- Accepts what `parse` accepts, with digits `0-9` and then letters of either
-- case: an optional sign, then one or more digits, and nothing else -- no
-- `0x` prefix, no `_`, no surrounding space. Returns `None` for a digit
-- outside the radix or a value outside `Int`.
fun parseRadix(s : String, radix : Int) -> Option Int {
    checkRadix("Int.parseRadix", radix)
    -- Read the bytes rather than `Data.Char`, which costs nothing here: every
    -- digit accepted is ASCII, so each is a single byte, and asking for a
    -- byte cannot land mid-character.
    let n = len(bytesOf(s))
    var i = 0
    var negative = False
    if n > 0 {
        let first = Byte.toInt(bytesOf(s)[0])
        if first == 45 {
            negative = True
            i = 1
        } else {
            if first == 43 { i = 1 }
        }
    }
    -- A sign on its own is not a number, and neither is the empty string.
    if i >= n { return None }
    -- The accumulator runs *negative*. Parsing into a positive number and
    -- negating at the end cannot represent `minValue()`, whose magnitude is
    -- one past `maxValue()` -- so the sign that has the extra value is the one
    -- accumulated in, and it is the positive result that is checked on the
    -- way out.
    var acc = 0
    while i < n {
        let digit = digitOf(Byte.toInt(bytesOf(s)[i]))
        if digit < 0 || digit >= radix { return None }
        var scaled = 0
        match mulChecked(acc, radix) {
            None -> { return None }
            Some(v) -> { scaled = v }
        }
        match subChecked(scaled, digit) {
            None -> { return None }
            Some(v) -> { acc = v }
        }
        i = i + 1
    }
    if negative { Some(acc) } else { negChecked(acc) }
}

fun checkRadix(caller : String, radix : Int) -> Unit {
    if radix < 2 || radix > 36 { error(caller + ": radix must be in 2..36") }
}

-- Formats `n` in base `radix` (2..36, a panic otherwise) with lowercase
-- letters for the digits above 9 and a leading `-` for a negative number.
fun toStringRadix(n : Int, radix : Int) -> String {
    checkRadix("Int.toStringRadix", radix)
    -- As in `toString`, the digits come off a non-positive copy.
    -- 64 digits is the most any radix needs, which is base 2 for `minValue()`.
    let digits = Storage.uninitialized(64)
    var count = 0
    var rest = if n < 0 { n } else { -n }
    loop {
        let d = -(rest % radix)
        digits[count] = Byte.truncate(if d < 10 { 48 + d } else { 87 + d })
        count = count + 1
        rest = rest / radix
        if rest == 0 { break }
    }
    let signLength = if n < 0 { 1 } else { 0 }
    let out = Storage.uninitialized(signLength + count)
    if n < 0 { out[0] = Byte.truncate(45) }
    for var i = 0; i < count; i = i + 1 {
        out[signLength + i] = digits[count - 1 - i]
    }
    String(out)
}

-- -- number theory --------------------------------------------------------------

-- Returns -1, 0 or 1 as `n` is negative, zero or positive.
fun sign(n : Int) -> Int = if n < 0 { -1 } else if n > 0 { 1 } else { 0 }

-- Returns the quotient of `a` and `b` rounded toward negative infinity, which
-- pairs with `mod`: `floorDiv(a, b) * b + mod(a, b) == a`. Panics when `b` is
-- zero, and on `floorDiv(minValue(), -1)`, as `/` does.
fun floorDiv(a : Int, b : Int) -> Int {
    let q = a / b
    if a % b != 0 && (a < 0) != (b < 0) { q - 1 } else { q }
}

-- Returns `(floorDiv(a, b), mod(a, b))`.
fun divMod(a : Int, b : Int) -> (Int, Int) = (floorDiv(a, b), mod(a, b))

-- Returns the greatest common divisor, never negative; `gcd(0, 0)` is 0.
-- Panics only when the answer is 2^63, that is, when one argument is
-- `minValue()` and the other is 0 or `minValue()`.
fun gcd(a : Int, b : Int) -> Int {
    -- Run Euclid on non-positive values, which can all be represented, so
    -- that `minValue()` is an ordinary argument. `x % y` takes the sign of
    -- `x`, so every remainder stays non-positive. `x % -1` is skipped:
    -- it is 0, and `minValue() % -1` would trap.
    var x = if a > 0 { -a } else { a }
    var y = if b > 0 { -b } else { b }
    while y != 0 {
        let t = if y == -1 { 0 } else { x % y }
        x = y
        y = t
    }
    -x
}

-- Returns the least common multiple, never negative; zero when either argument
-- is zero. Panics on overflow, as `*` does.
fun lcm(a : Int, b : Int) -> Int {
    if a == 0 || b == 0 { return 0 }
    abs(a / gcd(a, b) * b)
}

-- Returns `base` raised to `exp`. Panics when `exp` is negative, because the
-- answer is not an `Int`, and on overflow, as `*` does; `pow(0, 0)` is 1.
fun pow(base : Int, exp : Int) -> Int {
    if exp < 0 { error("Int.pow: negative exponent") }
    var result = 1
    var b = base
    var e = exp
    while e > 0 {
        if and(e, 1) == 1 { result = result * b }
        e = shr(e, 1)
        -- Square only when another bit remains: the last squaring would
        -- overflow for a result that fits.
        if e > 0 { b = b * b }
    }
    result
}

-- Returns `(a * b) mod m` for `0 <= a, b < m`, without overflow.
fun mulMod(a : Int, b : Int, m : Int) -> Int {
    if let Some(p) = mulChecked(a, b) { return p % m }
    -- The product does not fit, so add `a` into the sum once per set bit of
    -- `b`, doubling `a` each step. That runs up to 64 iterations, each with up
    -- to two `addMod` calls, where the product cost one multiplication, and is
    -- only paid for large moduli.
    var result = 0
    var x = a
    var y = b
    while y > 0 {
        if and(y, 1) == 1 { result = addMod(result, x, m) }
        x = addMod(x, x, m)
        y = shr(y, 1)
    }
    result
}

-- Returns `(a + b) mod m` for `0 <= a, b < m`; `m - b` cannot overflow.
fun addMod(a : Int, b : Int, m : Int) -> Int = if a >= m - b { a - (m - b) } else { a + b }

-- Returns `base` raised to `exp`, modulo `modulus`, in `0..modulus - 1`.
-- Panics when `exp` is negative or `modulus` is not positive. No intermediate
-- value overflows, whatever the modulus.
fun powMod(base : Int, exp : Int, modulus : Int) -> Int {
    if exp < 0 { error("Int.powMod: negative exponent") }
    if modulus <= 0 { error("Int.powMod: modulus must be positive") }
    var result = 1 % modulus
    var b = mod(base, modulus)
    var e = exp
    while e > 0 {
        if and(e, 1) == 1 { result = mulMod(result, b, modulus) }
        e = shr(e, 1)
        if e > 0 { b = mulMod(b, b, modulus) }
    }
    result
}

-- Returns the floor of the square root of `n`. Panics when `n` is negative.
fun isqrt(n : Int) -> Int {
    if n < 0 { error("Int.isqrt: negative argument") }
    -- Binary search for the largest `r` with `r * r <= n`. 3037000499 is the
    -- largest `r` whose square is an `Int`, so `mid * mid` never overflows.
    var lo = 0
    var hi = 3037000499
    while lo < hi {
        let mid = lo + (hi - lo + 1) / 2
        if mid * mid <= n { lo = mid } else { hi = mid - 1 }
    }
    lo
}

-- -- bit counts ---------------------------------------------------------------
--
-- All three read `n` as its 64 two's-complement bits, so a negative number has
-- its sign bit set.

-- Returns the number of set bits.
fun countOnes(n : Int) -> Int {
    var count = 0
    var rest = n
    while rest != 0 {
        -- Clear the lowest set bit. The subtraction wraps because `rest` may be
        -- `minValue()`. (`Bits` imports this module, so the bit operators are
        -- spelled out.)
        rest = and(rest, subWrapping(rest, 1))
        count = count + 1
    }
    count
}

-- Returns the number of zero bits above the highest set bit: 64 for zero.
fun leadingZeros(n : Int) -> Int {
    if n < 0 { return 0 }
    var count = 0
    var rest = n
    while rest != 0 {
        rest = shr(rest, 1)
        count = count + 1
    }
    64 - count
}

-- Returns the number of zero bits below the lowest set bit: 64 for zero.
fun trailingZeros(n : Int) -> Int {
    if n == 0 { return 64 }
    var count = 0
    var rest = n
    while and(rest, 1) == 0 {
        rest = shrUnsigned(rest, 1)
        count = count + 1
    }
    count
}

fun and(a : Int, b : Int) -> Int = Prim.intAnd(a, b)
fun or(a : Int, b : Int) -> Int = Prim.intOr(a, b)
fun xor(a : Int, b : Int) -> Int = Prim.intXor(a, b)
fun not(a : Int) -> Int = Prim.intNot(a)

-- All three panic outside 0..63 rather than masking the shift amount, so that
-- `x << 64` is a reported bug and not a silent identity. `shr` is arithmetic:
-- the sign bit replicates. `shrUnsigned` is logical: zeros come in at the top.
--
-- The range is checked here rather than trusted to the primitive, which
-- compiles to a single instruction: arm64 masks the shift amount to six bits,
-- so shifting by 64 would quietly be a shift by zero.
fun shl(a : Int, by : Int) -> Int {
    shiftAmount(Shl, by)
    Prim.intShl(a, by)
}

fun shr(a : Int, by : Int) -> Int {
    shiftAmount(Shr, by)
    Prim.intShr(a, by)
}

fun shrUnsigned(a : Int, by : Int) -> Int {
    shiftAmount(ShrUnsigned, by)
    Prim.intShrUnsigned(a, by)
}

-- Which operator's amount `badShift` reports. A constructor rather than the C
-- string itself, so that the passing path, which every shift takes, never
-- computes the string's address.
type ShiftOp = Shl | Shr | ShrUnsigned

fun shiftAmount(operation : ShiftOp, by : Int) -> Unit {
    if by < 0 || by > 63 { badShift(operation, by) }
}

-- The panic allocates nothing, so a giblet can shift by a variable amount.
--
-- `panicInt` raises the panic and returns. The `error` after it never
-- reports its message, because the first panic raised is the one reported. It
-- is there for its type: it makes `badShift` a call that always panics, which
-- the optimizer keeps out of line instead of copying into every shift.
fun badShift(operation : ShiftOp, by : Int) -> a {
    let before = match operation {
        Shl -> Prim.cString("Int.shl: shift amount ")
        Shr -> Prim.cString("Int.shr: shift amount ")
        ShrUnsigned -> Prim.cString("Int.shrUnsigned: shift amount ")
    }
    Process.panicInt(before, by, Prim.cString(" is outside 0..63"))
    error("")
}

-- -- ranges -------------------------------------------------------------------

-- The integers from `from` up to but not including `to`, as an iterator: empty
-- when `from >= to`. Exported without its constructor, and its cursor not at
-- all, so a range is only ever made by `range`.
type Range = Range { from : Int, to : Int }

type RangeCursor = RangeCursor { var at : Int }

fun range(from : Int, to : Int) -> Range = Range { from = from, to = to }

instance Iterator Range {
    type Item = Int
    type Cursor = RangeCursor
    fun iter(r) = RangeCursor { at = r.from }
    fun next(r, cur) {
        if cur.at >= r.to { return None }
        let x = cur.at
        cur.at = x + 1
        Some(x)
    }
}

instance Eq Int { fun eq(x, y) = Prim.intEq(x, y) }
instance Ord Int { fun lt(x, y) = Prim.intLt(x, y) }
instance Add Int { fun add(x, y) = Prim.intAdd(x, y) }
instance Sub Int { fun sub(x, y) = Prim.intSub(x, y) }
instance Mul Int { fun mul(x, y) = Prim.intMul(x, y) }
instance Div Int { fun div(x, y) = Prim.intDiv(x, y) }
instance Rem Int { fun rem(x, y) = Prim.intRem(x, y) }
instance Neg Int { fun neg(x) = Prim.intNeg(x) }
instance Zero Int { fun zero() = 0 }
instance One Int { fun one() = 1 }
instance Show Int { fun show(x) = toString(x) }

instance Hash Int { fun hashInto(i, h) = hashInt(h, i) }
