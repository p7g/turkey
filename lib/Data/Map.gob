export (
    Map,
    new,
    get,
    put,
    delete,
    contains,
    getOr,
    update,
    keys,
    values,
    entries,
    MapCursor,
)

import Prelude ()
import Data.Tuple (Unit)
import Data.Bool (Bool(..))
import Data.Array (Array)
import Data.Option (Option(..))
import Text.Show (Show(..))
import Data.Hashable (Hash(..), Hasher(..))
import Control.Iterator (Iterator(..))
import Data.Index (Index(..), SetIndex(..), Length(..))
import Algorithm.Hash (FNV1a)
import Data.MapWith (MapWith, MapCursor)
import Data.MapWith as With

-- A hash map with the default hasher: `Data.MapWith` with the hasher fixed.
-- Everything here forwards to it, and the wrapper costs nothing at run time,
-- since a type with one constructor and one field that cannot be assigned is
-- represented as that field.
--
-- A wrapper rather than the alias `type Map k v = MapWith FNV1a k v`, because
-- a parameterized alias cannot appear in a constructor's payload or a record
-- field, and `Map` appears in hundreds of them.
type Map k v = Map(MapWith FNV1a k v)

fun new() -> Map k v = Map(With.new())

fun get[Hash k](Map(m) : Map k v, key : k) -> Option v = With.get(m, key)

fun put[Hash k](Map(m) : Map k v, key : k, value : v) -> Unit = With.put(m, key, value)

-- Returns True if the key was present.
fun delete[Hash k](Map(m) : Map k v, key : k) -> Bool = With.delete(m, key)

fun contains[Hash k](Map(m) : Map k v, key : k) -> Bool = With.contains(m, key)

-- The default is evaluated whether or not it is used: arguments are strict and
-- left to right. A default that is expensive to build belongs behind a `match`
-- on `get`.
fun getOr[Hash k](Map(m) : Map k v, key : k, fallback : v) -> v = With.getOr(m, key, fallback)

-- Read, modify, write, in one place. `update(counts, word, 0, _ + 1)` is the
-- frequency count that is otherwise four lines and two lookups.
fun update[Hash k](Map(m) : Map k v, key : k, initial : v, f : fun(v) -> v) -> Unit =
    With.update(m, key, initial, f)

-- In insertion order, as iteration is.
fun keys(Map(m) : Map k v) -> Array k = With.keys(m)

fun values(Map(m) : Map k v) -> Array v = With.values(m)

fun entries(Map(m) : Map k v) -> Array (k, v) = With.entries(m)

instance Index (Map k v) : Hash k {
    type Key = k
    type Value = v
    fun get(Map(m), k) = m[k]
}

instance SetIndex (Map k v) : Hash k {
    fun set(Map(m), k, v) {
        m[k] = v
    }
}

instance Length (Map k v) { fun len(Map(m)) = len(m) }

instance Iterator (Map k v) {
    type Item = (k, v)
    type Cursor = MapCursor k v
    fun iter(Map(m)) = iter(m)
    fun next(Map(m), c) = next(m, c)
}

instance Show (Map k v) : Show k, Show v { fun show(Map(m)) = show(m) }
