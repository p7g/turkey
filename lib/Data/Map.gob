import Data.Index (Index(..), SetIndex(..), Length(..))
import Control.Panic (error)
import Data.Float as Float
import Turkey.Array as Storage

let loadFactor = 0.6
let defaultSize = 16

--- A hash map with the default hasher.
type Map k v = BaseMap FoldHash k v

--- A map whose keys are hashed by `h`. `h` is the first parameter because it is
--- the one fixed longest: a program picks a hasher once, and keys and values
--- per map.
type BaseMap h k v = BaseMap {
    var table          : Prim.Array (Entry k v),
    var cap            : Int,
    var size           : Int,
    var tombstoneCount : Int,
    var head           : Option (Bucket k v),
    var tail           : Option (Bucket k v),
    seed               : Int,
}

type Bucket k v = Bucket {
    key       : k,
    var value : v,
    hash      : Int,
    var next  : Option (Bucket k v),
    var prev  : Option (Bucket k v),
}

type Entry k v
    = Empty
    | Tombstone
    | Active (Bucket k v)

fun hashKey[Hash k, Hasher h](m : BaseMap h k v, key : k) -> Int = finishHash(hashInto(key, stateFor(m)))

-- A fresh hasher of the type `m` names, seeded with `m`'s seed.
fun stateFor[Hasher h](m : BaseMap h k v) -> h = startHash(m.seed)

-- The slot for hash `h` in a table of `cap` slots: `h` mod `cap`, floored, so
-- never negative for a negative `h`. `cap` must be a power of two, which every
-- capacity is: it starts at `defaultSize` and only doubles. That is what lets
-- a mask stand in for the division, which is a `sdiv` on every probe step.
fun slotOf(h : Int, cap : Int) -> Int = h & (cap - 1)

--- Returns an empty map with the default hasher.
fun new() -> Map k v = withHasher()

--- Returns an empty map whose keys `h` hashes, for the `h` the call site's
--- type names.
fun withHasher() -> BaseMap h k v {
    let table = Storage.filled(defaultSize, Empty)
    BaseMap {
        table,
        cap = defaultSize,
        size = 0,
        tombstoneCount = 0,
        head = None,
        tail = None,
        seed = 0,
    }
}

-- Annotated rather than inferred, and deliberately. Left to inference `m` is a
-- bare type variable and this is record-polymorphic, which compiles correctly
-- -- `HasField` is a class and the body is handed accessors -- and is checked
-- as sharply, since a wanted equality now rewrites what depends on it. It is
-- still worth saying: the receiver is a `Map` at every call site, so the
-- annotation costs nothing and saves specialization the work of taking a
-- dictionary back out of every field access.
fun findSlot[Eq k](m : BaseMap h k v, h : Int, key : k, isSearching : Bool) -> Int {
    var index = slotOf(h, m.cap)
    var firstTombstone = None

    loop {
        let entry = m.table[index]

        match entry {
            Empty -> {
                if isSearching {
                    break index
                }
                break match firstTombstone {
                    Some(x) -> x
                    None    -> index
                }
            }
            -- An insert takes the first tombstone on the probe path, but only
            -- once it reaches `Empty`: the key may still be further along, and
            -- reusing the slot before looking would store it twice.
            Tombstone -> {
                if !isSearching && firstTombstone == None {
                    firstTombstone = Some(index)
                }
            }
            Active(bucket) -> {
                if bucket.key == key {
                    break index
                }
            }
        }

        index = slotOf(index + 1, m.cap)
    }
}

fun put[Hash k, Hasher h](m : BaseMap h k v, key : k, value : v) -> Unit {
    let h = hashKey(m, key)
    let i = findSlot(m, h, key, False)

    match m.table[i] {
        Active(bucket) -> {
            bucket.value = value
            return
        }
        Tombstone -> {
            m.tombstoneCount = m.tombstoneCount - 1
        }
        Empty -> ()
    }

    let bucket = Bucket {
        key = key,
        value = value,
        hash = h,
        next = None,
        prev = m.tail,
    }
    m.table[i] = Active(bucket)

    match m.tail {
        Some(tl) -> {
            tl.next = Some(bucket)
        }
        None -> {
            m.head = Some(bucket)
        }
    }

    m.tail = Some(bucket)
    m.size = m.size + 1

    if Float.fromInt(m.size + m.tombstoneCount) > Float.fromInt(m.cap) * loadFactor {
        resize(m)
    }
}

fun get[Hash k, Hasher h](m : BaseMap h k v, key : k) -> Option v {
    let h = hashKey(m, key)
    let i = findSlot(m, h, key, True)
    match m.table[i] {
        Active(bucket) -> Some(bucket.value)
        _              -> None
    }
}

fun delete[Hash k, Hasher h](m : BaseMap h k v, key : k) -> Bool {
    let h = hashKey(m, key)
    let i = findSlot(m, h, key, True)

    let bucket = match m.table[i] {
        Empty          -> return False
        Tombstone      -> error("found tombstone in delete()")
        Active(bucket) -> bucket
    }

    m.table[i] = Tombstone
    m.tombstoneCount = m.tombstoneCount + 1
    m.size = m.size - 1

    match bucket.prev {
        Some(prev) -> {
            prev.next = bucket.next
        }
        None -> {
            m.head = bucket.next
        }
    }

    match bucket.next {
        Some(next) -> {
            next.prev = bucket.prev
        }
        None -> {
            m.tail = bucket.prev
        }
    }

    True
}

-- Called when live entries and tombstones together pass the load factor, and
-- rehashing drops every tombstone. The table doubles only when live entries
-- alone fill more than half the load factor; otherwise it is rebuilt at the
-- same size. That keeps a map whose size is steady under delete/put churn at a
-- constant capacity, and the half is the hysteresis: a same-size rehash leaves
-- at least `cap * loadFactor / 2` puts before the next one, so rehashing stays
-- amortized constant per operation instead of firing on every put when `size`
-- sits just under the threshold.
fun resize(m : BaseMap h k v) -> Unit {
    let newCap = if Float.fromInt(m.size) > Float.fromInt(m.cap) * loadFactor / 2.0 {
        m.cap * 2
    } else {
        m.cap
    }
    m.table = Storage.filled(newCap, Empty)
    m.cap = newCap
    m.tombstoneCount = 0

    var current = m.head
    loop {
        match current {
            None -> break
            Some(bucket) -> {
                var i = slotOf(bucket.hash, newCap)
                loop {
                    match m.table[i] {
                        Empty -> break
                        _ -> {
                            i = slotOf(i + 1, newCap)
                        }
                    }
                }
                m.table[i] = Active(bucket)
                current = bucket.next
            }
        }
    }
}

-- -- asking, without committing to an answer -----------------------------------
--
-- `m[key]` is the `Index` method and panics on a missing key; `get` answers an
-- `Option`. These are the three shapes built on `get` that every caller was
-- otherwise writing out by hand.

fun contains[Hash k, Hasher h](m : BaseMap h k v, key : k) -> Bool = match get(m, key) {
    Some(_) -> True
    None -> False
}

--- The default is evaluated whether or not it is used: arguments are strict and
--- left to right. A default
--- that is expensive to build belongs behind a `match` on `get`.
fun getOr[Hash k, Hasher h](m : BaseMap h k v, key : k, fallback : v) -> v = match get(m, key) {
    Some(found) -> found
    None -> fallback
}

--- Read, modify, write, in one place. `update(counts, word, 0, _ + 1)`
--- is the frequency count that is otherwise four lines and two lookups.
fun update[Hash k, Hasher h](m : BaseMap h k v, key : k, initial : v, f : fun(v) -> v) -> Unit =
    put(m, key, f(getOr(m, key, initial)))

-- -- reading the whole thing out ------------------------------------------------
--
-- In insertion order, which is what iteration already promises: the buckets are
-- on a doubly-linked list threaded in insertion order, and nothing here sorts
-- or rehashes. That the order is a property of the structure rather than of the
-- hash is what makes a program's output reproducible: iterating a map cannot
-- reorder between runs, or between two builds of the same program.

fun keys(m : BaseMap h k v) -> Array k = inOrder(m, fun((key, _value)) = key)

fun values(m : BaseMap h k v) -> Array v = inOrder(m, fun((_key, value)) = value)

fun entries(m : BaseMap h k v) -> Array (k, v) = inOrder(m, fun(pair) = pair)

-- `f` of each entry, in iteration order, allocated once at the map's size.
fun inOrder(m : BaseMap h k v, f : fun((k, v)) -> a) -> Array a {
    let cursor = iter(m)
    Array.init(len(m), fun(_) = match next(m, cursor) {
        Some(pair) -> f(pair)
        None -> error("Data.Map: fewer entries than its length")
    })
}

instance Index (BaseMap h k v) : Hash k, Hasher h {
    type Key = k
    type Value = v

    fun get(m, k) {
        match get(m, k) {
            Some(v) -> v
            None -> error("map has no entry for this key; use Map.get to handle a missing key")
        }
    }
}

instance SetIndex (BaseMap h k v) : Hash k, Hasher h { fun set(m, k, v) = put(m, k, v) }

--- Equal when they hold the same keys with equal values, whatever order the
--- keys went in and whatever either table's capacity or seed. Looks each of
--- `a`'s keys up in `b`, so it costs one lookup per entry.
instance Eq (BaseMap h k v) : Hash k, Hasher h, Eq v {
    fun eq(a, b) {
        if len(a) != len(b) { return False }
        for (key, value) in a {
            match get(b, key) {
                Some(other) -> if value != other { return False }
                None -> return False
            }
        }
        True
    }
}

instance Length (BaseMap h k v) {
    fun len(m) = m.size
}

-- Exported, and not by choice. A wrapper type such as `Data.Set` has to name
-- this in its own `Iterator` instance: an instance's associated family may be
-- defined as a family applied to a *variable* of the instance head, but not to
-- a concrete type, so `type Cursor = Cursor (Map a Unit)` is rejected and the
-- underlying cursor type has to be nameable instead. The restriction is what
-- makes family reduction terminate, so the export is the cheaper side.
type MapCursor k v = MapCursor { var bucket : Option (Bucket k v) }

instance Iterator (BaseMap h k v) {
    type Item = (k, v)
    type Cursor = MapCursor k v

    fun iter(m) = MapCursor(m.head)
    fun next(_, c) {
        match c.bucket {
            None -> None
            Some(b) -> {
                c.bucket = b.next
                Some((b.key, b.value))
            }
        }
    }
}

--- Its entries in the order they were first put, `{k: v, ...}`. The table
--- and the bucket chain are how it is stored, not what it holds.
instance Debug (BaseMap h k v) : Debug k, Debug v {
    fun debug(m) {
        var s = "{"
        var first = True
        for (k, v) in m {
            if first {
                first = False
            } else {
                s = s + ", "
            }
            s = s + debug(k) + ": " + debug(v)
        }
        s + "}"
    }
}

--- What its `Debug` prints: a container's text shows its elements' `Debug`,
--- so that a string in it is quoted.
instance Show (BaseMap h k v) : Debug k, Debug v { fun show(m) = debug(m) }
