export (
    Add(..), Sub(..), Zero(..), One(..), Mul(..), Div(..), Rem(..), Neg(..),
    (+), (-), (*), (/), (%),
)

import Prelude ()

-- The arithmetic operators, a class each, so that a type can have `+` without
-- having `/`.
class Add a { fun add(a, a) -> a }
class Sub a { fun sub(a, a) -> a }
class Mul a { fun mul(a, a) -> a }
class Div a { fun div(a, a) -> a }
class Rem a { fun rem(a, a) -> a }
class Neg a { fun neg(a) -> a }

-- The identity of `+` and of `*`: `add(zero(), x) == x == add(x, zero())`, and
-- likewise `mul(one(), x) == x == mul(x, one())`. `Iter.sum` and
-- `Iter.product` start from them.
class Zero a { fun zero() -> a }
class One a { fun one() -> a }

infix Addition (+) = add
infix Addition (-) = sub
infix Multiplication (*) = mul
infix Multiplication (/) = div
infix Multiplication (%) = rem
