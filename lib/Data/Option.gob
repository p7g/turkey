module Data.Option (Option(..), expect, isSome, isNone, unwrapOr, map, fold)

import Prelude ()
import Data.Byte (Byte)
import Data.String (String)
import Data.Eq (Eq(..))
import Text.Show (Show(..))
import Data.Hashable (Hash(..), Hasher(..))
import Data.Functor (Functor(..))
import Control.Applicative (Applicative(..))
import Control.Monad (Monad(..))
import Data.Foldable (Foldable(..))
import Control.Panic (error)
import Data.Bool (Bool(..))
import Data.Byte as Byte
import Data.String as Str

type Option a = None | Some(a)

fun isSome(o : Option a) -> Bool = match o {
    Some(_) -> True
    None -> False
}

fun isNone(o : Option a) -> Bool = match o {
    None -> True
    Some(_) -> False
}

fun unwrapOr(o : Option a, fallback : a) -> a = match o {
    Some(x) -> x
    None -> fallback
}

fun map(o : Option a, f : fun(a) -> b) -> Option b = match o {
    Some(x) -> Some(f(x))
    None -> None
}

fun fold(o : Option a, onNone : b, onSome : fun(a) -> b) -> b = match o {
    Some(x) -> onSome(x)
    None -> onNone
}

fun expect(o : Option a, msg : String) -> a {
    if let Some(a) = o {
        a
    } else {
        error(msg)
    }
}

instance Functor Option {
    fun map(o, f) = map(o, f)
}

instance Applicative Option { fun pure(x) = Some(x) }

instance Monad Option {
    fun bind(o, g) = match o {
        Some(x) -> g(x)
        None -> None
    }
}

instance Show (Option a) : Show a {
    fun show(o) = match o {
        None -> "None"
        Some(x) -> Str.concat(Str.concat("Some(", show(x)), ")")
    }
}

instance Eq (Option a) : Eq a {
    fun eq(a, b) = match (a, b) {
        (None, None) -> True
        (Some(aa), Some(bb)) -> aa == bb
        _ -> False
    }
}

instance Hash (Option a) : Hash a {
    fun hashInto(o, h) = match o {
        None -> update(h, Byte.minValue())
        Some(x) -> {
            update(h, Byte.truncate(1))
            hashInto(x, h)
        }
    }
}
