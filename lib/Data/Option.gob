export (Option(..), expect, isSome, isNone, unwrapOr, or, map, fold)

import Prelude ()
import Control.Applicative (Applicative(..))
import Control.Monad (Monad(..))
import Control.Panic (error)
import Data.Bool (Bool(..))
import Data.Foldable (Foldable(..))
import Data.Functor (Functor(..))
import Data.String (String)
import Data.String as Str
import Debug (Debug(..))
import Iter (Iterator)
import Text.Show (Show(..))

type Option a = None | Some(a)

fun isSome(o : Option a) -> Bool = match o {
	Some(_) -> True
	None    -> False
}

fun isNone(o : Option a) -> Bool = match o {
	None    -> True
	Some(_) -> False
}

fun unwrapOr(o : Option a, fallback : a) -> a = match o {
	Some(x) -> x
	None    -> fallback
}

--- `o` if it is a `Some`, and otherwise `fallback`. Both are evaluated before
--- the call, as every argument is.
fun or(o : Option a, fallback : Option a) -> Option a = match o {
	Some(_) -> o
	None    -> fallback
}

fun map(o : Option a, f : fun(a) -> b) -> Option b = match o {
	Some(x) -> Some(f(x))
	None    -> None
}

fun fold(o : Option a, onNone : b, onSome : fun(a) -> b) -> b = match o {
	Some(x) -> onSome(x)
	None    -> onNone
}

fun expect(o : Option a, msg : String) -> a {
	if let Some(a) = o {
		a
	} else {
		error(msg)
	}
}

instance Functor Option {
	fun map(o, f) = map(o, f)
}

instance Applicative Option { fun pure(x) = Some(x) }

instance Monad Option {
	fun bind(o, g) = match o {
		Some(x) -> g(x)
		None    -> None
	}
}

--- What its `Debug` prints: a container's text shows its elements' `Debug`,
--- so that a string in it is quoted.
instance Show (Option a) : Debug a { fun show(o) = debug(o) }

type OptionCursor a = OptionCursor { var opt : Option a }

instance Iterator (Option a) {
	type Item = a
	type Cursor = OptionCursor a

	fun iter(x) = OptionCursor(x)
	fun next(x, c) {
		let r = c.opt
		c.opt = None
		r
	}
}
