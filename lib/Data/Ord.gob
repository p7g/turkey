module (Ord(..), min, max)

import Prelude ()
import Data.Bool (Bool(..))
import Data.Eq (Eq(..))

class Ord a : Eq a {
    fun lt(a, a) -> Bool
    fun lte(x : a, y : a) -> Bool = lt(x, y) || eq(x, y)
    fun gt(x : a, y : a) -> Bool = lt(y, x)
    fun gte(x : a, y : a) -> Bool = !lt(x, y)
}

-- The lesser and the greater of two values. When neither is less than the
-- other, `min` answers `x` and `max` answers `y`, so `(min(x, y), max(x, y))`
-- is `(x, y)` sorted stably: the two never answer the same one of two values
-- that are equal but distinguishable.
fun min[Ord a](x : a, y : a) -> a = if y < x { y } else { x }

fun max[Ord a](x : a, y : a) -> a = if y < x { x } else { y }
