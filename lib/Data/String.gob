import Prelude ()
import Std.Classes
import Data.Array (Array)
import Data.Array as Array
import Data.Bool.Type (Bool(..))
import Data.Byte ()
import Data.Byte as Byte
import Data.Char as Char
import Data.Int ()
import Data.Int as Int
import Data.Option.Type (Option(..))
import Data.String.Type (String(..))
import Data.String.Type as Type
import Data.Tuple ()

-- A `String` is an immutable sequence of bytes that is guaranteed to be
-- well-formed UTF-8. That is the whole model, and every operation here is
-- judged by whether it preserves the invariant. It is not "a sequence of
-- characters" and not "a sequence of code points" -- the code points are a
-- *view*, and so are the bytes.
--
-- Note what is absent. There is no `length`, because "how long is this
-- string" has three defensible answers and the old one silently gave the
-- code-point count; there is no `Index String` and no `Length String`, for
-- the same reason; and no byte offset ever reaches the surface language, so
-- there is no way to construct a slice that cuts a character in half.

-- O(1). The only cheap count a string has.
fun byteLength(s : String) -> Int = Type.byteLength(s)

fun isEmpty(s : String) -> Bool = byteLength(s) == 0

-- Deliberately O(n) and deliberately spelled out, so that it can never be
-- mistaken for the cheap one.
fun codePointCount(s : String) -> Int {
    var n = 0
    for _c in codePoints(s) { n = n + 1 }
    n
}

-- -- views -------------------------------------------------------------------
--
-- Lazy, not materialized. The old `chars` built a whole `Array Char` per call;
-- these walk the encoding in place. Making them views is also what leaves room
-- for `graphemes`, which cannot be an array of a primitive at all, since a
-- grapheme cluster is a substring rather than a scalar value.

type Bytes = Bytes { source : String }
type CodePoints = CodePoints { source : String }

-- Both views walk byte offsets, so they share one cursor. The offset is
-- private to this module; nothing exported ever returns one.
type ByteCursor = ByteCursor { at : Int }

fun bytes(s : String) -> Bytes = Bytes { source = s }
fun codePoints(s : String) -> CodePoints = CodePoints { source = s }

instance Iterator Bytes {
    type Item = Byte
    type Cursor = ByteCursor
    fun iter(b) = ByteCursor { at = 0 }
    fun next(b, cur) {
        if cur.at >= byteLength(b.source) { return None }
        let x = byteAt(b.source, cur.at)
        cur.at = cur.at + 1
        Some(x)
    }
}

instance Iterator CodePoints {
    type Item = Char
    type Cursor = ByteCursor
    fun iter(cp) = ByteCursor { at = 0 }
    fun next(cp, cur) {
        if cur.at >= byteLength(cp.source) { return None }
        let c = decodeAt(cp.source, cur.at)
        cur.at = nextIndex(cp.source, cur.at)
        Some(c)
    }
}

-- -- indices -----------------------------------------------------------------
--
-- An opaque position in a string, for a reader that needs to look ahead and
-- to remember where a token started. The two alternatives are both wrong at
-- scale: materialize an `Array Char`,
-- which costs four bytes per code point and an allocation per file, or drive
-- the `CodePoints` view, which cannot look ahead and cannot say where a token
-- started.
--
-- The invariant holds by *construction*, which is the whole design. An `Index`
-- is only ever obtained from `start`, `end`, `step` or `find`, so it always
-- names a character boundary, and there is no arithmetic on one -- no
-- addition, no `toInt`, nothing that could compute an offset that is not a
-- boundary. `slice` therefore neither validates nor admits an ill-formed
-- result; the question cannot be asked. Exposing a raw `Int` offset instead
-- would be the decision that cannot be taken back, since `slice` would then
-- have to validate every call or admit ill-formed strings.
--
-- An `Index` belongs to the string it came from. Using one with a different
-- string is not caught -- it would cost a tag per index to catch -- and lands
-- on a boundary of the wrong string or panics. That is the same discipline
-- `Iterator`'s `Cursor` already runs on.

type Index = Index(Int)

fun start(s : String) -> Index = Index(0)

fun end(s : String) -> Index = Index(byteLength(s))

fun atEnd(s : String, Index(at)) -> Bool = at >= byteLength(s)

-- Decode one scalar value and answer where the next one begins. This is the
-- whole of forward motion: `None` at the end, and otherwise a character and
-- an index strictly greater than the one handed in, so a loop written on it
-- terminates.
fun step(s : String, Index(at)) -> Option (Char, Index) {
    if at >= byteLength(s) { return None }
    Some((decodeAt(s, at), Index(nextIndex(s, at))))
}

-- The character at an index, without moving. What a lexer's `peek` is.
fun decode(s : String, Index(at)) -> Option Char {
    if at >= byteLength(s) { return None }
    Some(decodeAt(s, at))
}

fun slice(s : String, Index(from), Index(to)) -> String =
    sliceBytes(s, from, to)

fun find(s : String, needle : String, Index(from)) -> Option Index {
    let found = byteFind(s, needle, from)
    if found < 0 { None } else { Some(Index(found)) }
}

-- Ordering is by position in the string, which is what a slice's two ends
-- have to be compared for. It is not a comparison between strings.
instance Eq Index { fun eq(Index(a), Index(b)) = a == b }
instance Ord Index { fun lt(Index(a), Index(b)) = a < b }

-- -- interchange --------------------------------------------------------------
--
-- The only door in and out, and the entire reason `Byte` exists. Going out is
-- total; coming in is checked, because arbitrary bytes are not a string.

-- Both copy. A `String` is never written after it is made and an `Array` can
-- be, so the two must not share storage in either direction.
fun toBytes(s : String) -> Array Byte {
    let n = byteLength(s)
    let out = Array.new(n)
    for var i = 0; i < n; i = i + 1 { Array.push(out, byteAt(s, i)) }
    out
}

fun fromBytes(bs : Array Byte) -> Option String {
    let n = len(bs)
    let raw = Prim.arrayNewUninit(n)
    for var i = 0; i < n; i = i + 1 { Prim.arraySet(raw, i, bs[i]) }
    if wellFormed(raw) { Some(String(raw)) } else { None }
}

-- Whether `bytes` is well-formed UTF-8: the shortest encoding of a scalar
-- value, each time, to the end. Overlong forms, surrogates, code points past
-- 10FFFF and truncated sequences all fail. The one validator every door into
-- `String` goes through -- `fromBytes`, and through it the arguments, the
-- environment and every file read.
fun wellFormed(bytes : Prim.Array Byte) -> Bool {
    let n = Prim.arrayLength(bytes)
    var i = 0
    while i < n {
        let lead = Byte.toInt(Prim.arrayGet(bytes, i))
        var width = 0
        var scalar = 0
        if lead < 128 {
            width = 1
            scalar = lead
        } else if lead >= 194 && lead <= 223 {
            width = 2
            scalar = Int.and(lead, 31)
        } else if lead >= 224 && lead <= 239 {
            width = 3
            scalar = Int.and(lead, 15)
        } else if lead >= 240 && lead <= 244 {
            width = 4
            scalar = Int.and(lead, 7)
        } else {
            return False
        }
        if i > n - width { return False }
        for var k = 1; k < width; k = k + 1 {
            let b = Byte.toInt(Prim.arrayGet(bytes, i + k))
            if Int.and(b, 192) != 128 { return False }
            scalar = Int.or(Int.shl(scalar, 6), Int.and(b, 63))
        }
        if width == 2 && scalar < 128 { return False }
        if width == 3 && scalar < 2048 { return False }
        if width == 4 && scalar < 65536 { return False }
        if scalar >= 55296 && scalar <= 57343 { return False }
        if scalar > 1114111 { return False }
        i = i + width
    }
    True
}

-- -- building ----------------------------------------------------------------
--
-- `+` in a loop is quadratic. A builder collects the pieces and joins once,
-- which is what `fromCodePoints` and `join` are both written on.

type Builder = Builder { parts : Array String }

fun builder() -> Builder = Builder { parts = Array.new(8) }

fun push(b : Builder, part : String) -> Unit = Array.push(b.parts, part)

-- One allocation, however many parts: the lengths first, then the copy.
fun build(b : Builder) -> String {
    var total = 0
    for part in b.parts { total = total + byteLength(part) }
    let out = Prim.arrayNewUninit(total)
    var at = 0
    for part in b.parts {
        let from = Type.bytesOf(part)
        let n = Prim.arrayLength(from)
        for var i = 0; i < n; i = i + 1 {
            Prim.arraySet(out, at + i, Prim.arrayGet(from, i))
        }
        at = at + n
    }
    String(out)
}

fun fromCodePoints(cs : Array Char) -> String {
    let b = builder()
    for c in cs { push(b, Char.toString(c)) }
    build(b)
}

fun join(parts : Array String, separator : String) -> String {
    let b = builder()
    var rest = False
    for part in parts {
        if rest { push(b, separator) }
        push(b, part)
        rest = True
    }
    build(b)
}

fun repeat(s : String, times : Int) -> String {
    let b = builder()
    for var i = 0; i < times; i = i + 1 { push(b, s) }
    build(b)
}

-- -- searching and cutting ----------------------------------------------------
--
-- `byteFind` answers in byte offsets and `sliceBytes` consumes them, and
-- neither escapes this module: a byte offset a program could compute is one it
-- could compute wrongly, and `slice` would then have to validate every call.
-- What a program gets instead is `String.Index`, which names a boundary by
-- construction.
--
-- UTF-8 is self-synchronizing, so a well-formed needle only ever matches at a
-- character boundary. That is why searching bytes for bytes is safe here.

-- Both ask the byte search, rather than slicing off a prefix of the right
-- length and comparing. Slicing would be wrong: `startsWith("é", "a")` would
-- cut the two-byte `é` in half, and `sliceBytes` panics on a non-boundary
-- offset rather than inventing a replacement character. The
-- search cannot make that mistake, because a well-formed needle only ever
-- matches at a boundary.
fun startsWith(s : String, prefix : String) -> Bool =
    byteFind(s, prefix, 0) == 0

fun endsWith(s : String, suffix : String) -> Bool =
    byteRfind(s, suffix) == byteLength(s) - byteLength(suffix)

fun contains(s : String, needle : String) -> Bool =
    byteFind(s, needle, 0) >= 0

fun stripPrefix(s : String, prefix : String) -> Option String =
    if startsWith(s, prefix) {
        Some(sliceBytes(s, byteLength(prefix), byteLength(s)))
    } else {
        None
    }

fun stripSuffix(s : String, suffix : String) -> Option String =
    if endsWith(s, suffix) {
        Some(sliceBytes(s, 0, byteLength(s) - byteLength(suffix)))
    } else {
        None
    }

fun split(s : String, separator : String) -> Array String {
    let out = Array.new(4)
    -- Splitting on the empty string means "between every pair of characters",
    -- and the characters here are code points.
    if isEmpty(separator) {
        for c in codePoints(s) { Array.push(out, Char.toString(c)) }
        return out
    }
    let width = byteLength(separator)
    var start = 0
    loop {
        let at = byteFind(s, separator, start)
        if at < 0 { break }
        Array.push(out, sliceBytes(s, start, at))
        start = at + width
    }
    Array.push(out, sliceBytes(s, start, byteLength(s)))
    out
}

fun splitOnce(s : String, separator : String) -> Option (String, String) {
    if isEmpty(separator) { return None }
    let at = byteFind(s, separator, 0)
    if at < 0 { return None }
    Some((
        sliceBytes(s, 0, at),
        sliceBytes(s, at + byteLength(separator), byteLength(s)),
    ))
}

-- The same, splitting at the *last* occurrence. `"M#C.eq"` split on `"#"` is
-- how an internal name is taken apart, and the qualification is the part after
-- the last separator whatever the name before it contains.
fun rsplitOnce(s : String, separator : String) -> Option (String, String) {
    if isEmpty(separator) { return None }
    let at = byteRfind(s, separator)
    if at < 0 { return None }
    Some((
        sliceBytes(s, 0, at),
        sliceBytes(s, at + byteLength(separator), byteLength(s)),
    ))
}

fun replace(s : String, from : String, to : String) -> String =
    if isEmpty(from) { s } else { join(split(s, from), to) }

-- -- lines and words -----------------------------------------------------------
--
-- The two splits a file gets read with.

-- Split on newlines, and neither invent a last line nor lose one. A file that
-- ends with a newline has no empty line after it -- the newline terminates the
-- last line rather than separating it from another -- while a file that does
-- not end with one still has its final line. `split` cannot tell those apart,
-- which is why this is not written on it.
--
-- A carriage return immediately before the newline goes with it, so a file
-- written on Windows reads the same as one written anywhere else. A lone
-- carriage return is not a line break: treating it as one is a Classic MacOS
-- convention that now only ever misreads data.
fun lines(s : String) -> Array String {
    let out = Array.new(8)
    let n = byteLength(s)
    var start = 0
    while start < n {
        var stop = byteFind(s, "\n", start)
        if stop < 0 { stop = n }
        var cut = stop
        if cut > start {
            if byteAt(s, cut - 1) == carriageReturn() { cut = cut - 1 }
        }
        Array.push(out, sliceBytes(s, start, cut))
        start = stop + 1
    }
    out
}

fun carriageReturn() -> Byte = Prim.byteFromInt(13)

-- Split on runs of whitespace, discarding them. Unlike `split(s, " ")` this
-- yields no empty strings: two spaces separate two words rather than fencing
-- an empty one between them, and leading or trailing space produces nothing at
-- all.
fun words(s : String) -> Array String {
    let out = Array.new(8)
    let n = byteLength(s)
    var i = 0
    while i < n {
        while i < n {
            if !Char.isSpace(decodeAt(s, i)) { break }
            i = nextIndex(s, i)
        }
        if i >= n { break }
        let start = i
        while i < n {
            if Char.isSpace(decodeAt(s, i)) { break }
            i = nextIndex(s, i)
        }
        Array.push(out, sliceBytes(s, start, i))
    }
    out
}

fun trimStart(s : String) -> String {
    let n = byteLength(s)
    var i = 0
    while i < n {
        if !Char.isSpace(decodeAt(s, i)) { break }
        i = nextIndex(s, i)
    }
    sliceBytes(s, i, n)
}

fun trimEnd(s : String) -> String {
    let n = byteLength(s)
    var i = 0
    var end = 0
    while i < n {
        let next = nextIndex(s, i)
        if !Char.isSpace(decodeAt(s, i)) { end = next }
        i = next
    }
    sliceBytes(s, 0, end)
}

fun trim(s : String) -> String = trimEnd(trimStart(s))

-- -- instances ----------------------------------------------------------------
--
-- Equality is byte equality, which for well-formed UTF-8 is exactly
-- code-point equality. It performs *no* Unicode normalization:
--
--     "\u{00E9}" == "\u{0065}\u{0301}"   -- False. Both render as e-acute.
--
-- Normalization is a library operation and will never be something `==` does
-- implicitly. Ordering is byte-lexicographic, which for well-formed UTF-8
-- coincides with code-point-lexicographic -- and which is not a collation:
-- it sorts `Z` before `a` and has no opinion about locale.

instance Eq String {
    fun eq(x, y) {
        let n = byteLength(x)
        if n != byteLength(y) { return False }
        for var i = 0; i < n; i = i + 1 {
            if byteAt(x, i) != byteAt(y, i) { return False }
        }
        True
    }
}

instance Ord String {
    fun lt(x, y) {
        let n = byteLength(x)
        let m = byteLength(y)
        for var i = 0; i < n && i < m; i = i + 1 {
            let a = byteAt(x, i)
            let b = byteAt(y, i)
            if a != b { return a < b }
        }
        n < m
    }
}

instance Add String { fun add(x, y) = Type.concat(x, y) }
instance Show String { fun show(x) = x }
instance Semigroup String { fun combine(x, y) = add(x, y) }
instance Monoid String { fun empty() = "" }

-- No `Length String`. `len` means an O(1) count of elements, and a string has
-- no single answer to give: `byteLength` is the cheap one, `codePointCount`
-- the one people usually mean, and graphemes the one they usually want.

instance Hash String {
    fun hashInto(s, d) {
        -- Over the bytes, not the code points. The old version built an
        -- `Array Char` on every hash.
        let n = byteLength(s)
        for var i = 0; i < n; i = i + 1 {
            update(d, Byte.toInt(byteAt(s, i)))
        }
    }
}

-- -- the bytes, privately ------------------------------------------------------
--
-- Byte offsets never leave this module, and these are what every operation
-- above is written on. Each panics rather than answering nonsense for an
-- offset that is not a boundary, since the callers above are what keep the
-- invariant.

-- The byte at an offset the caller has already checked.
fun byteAt(s : String, i : Int) -> Byte = Prim.arrayGet(Type.bytesOf(s), i)

fun checkIndex(s : String, i : Int) -> Unit {
    if i < 0 || i >= byteLength(s) {
        error("string byte index out of bounds: " + Int.toString(i)
              + ", length " + Int.toString(byteLength(s)))
    }
}

fun isContinuation(b : Byte) -> Bool = Int.and(Byte.toInt(b), 192) == 128

fun checkBoundary(s : String, i : Int) -> Unit {
    if isContinuation(byteAt(s, i)) {
        error("byte offset " + Int.toString(i) + " is not a character boundary")
    }
}

-- How many bytes long the sequence a lead byte begins is.
fun sequenceWidth(lead : Byte) -> Int {
    let b = Byte.toInt(lead)
    if b < 128 { 1 } else if b >= 240 { 4 } else if b >= 224 { 3 } else { 2 }
}

-- The scalar value beginning at a boundary.
fun decodeAt(s : String, i : Int) -> Char {
    checkIndex(s, i)
    checkBoundary(s, i)
    let lead = Byte.toInt(byteAt(s, i))
    let w = sequenceWidth(byteAt(s, i))
    var scalar = if w == 1 { lead } else { Int.and(lead, Int.shr(127, w)) }
    for var k = 1; k < w; k = k + 1 {
        let b = Byte.toInt(byteAt(s, i + k))
        scalar = Int.or(Int.shl(scalar, 6), Int.and(b, 63))
    }
    Prim.charFromInt(scalar)
}

-- Where the scalar value after the one at `i` begins.
fun nextIndex(s : String, i : Int) -> Int {
    checkIndex(s, i)
    checkBoundary(s, i)
    i + sequenceWidth(byteAt(s, i))
}

fun isBoundary(s : String, i : Int) -> Bool {
    let n = byteLength(s)
    if i == 0 || i == n { return True }
    i > 0 && i < n && !isContinuation(byteAt(s, i))
}

-- The bytes from `start` to `stop`, which must both be boundaries: a cut
-- anywhere else would make a string that is not UTF-8.
fun sliceBytes(s : String, start : Int, stop : Int) -> String {
    let span = Int.toString(start) + ".." + Int.toString(stop)
    if start < 0 || start > stop || stop > byteLength(s) {
        error("string slice " + span + " is out of bounds")
    }
    if !isBoundary(s, start) || !isBoundary(s, stop) {
        error("string slice " + span + " does not fall on character boundaries")
    }
    let from = Type.bytesOf(s)
    let out = Prim.arrayNewUninit(stop - start)
    for var i = start; i < stop; i = i + 1 {
        Prim.arraySet(out, i - start, Prim.arrayGet(from, i))
    }
    String(out)
}

-- Whether `needle` occurs in `haystack` at byte offset `at`.
fun matchesAt(haystack : String, needle : String, at : Int) -> Bool {
    let m = byteLength(needle)
    for var k = 0; k < m; k = k + 1 {
        if byteAt(haystack, at + k) != byteAt(needle, k) { return False }
    }
    True
}

-- The first offset at or after `start` where `needle` occurs, or -1. An empty
-- needle occurs everywhere, the end included.
fun byteFind(haystack : String, needle : String, start : Int) -> Int {
    let n = byteLength(haystack)
    let m = byteLength(needle)
    let from = if start < 0 { 0 } else { start }
    if m == 0 { return if from > n { -1 } else { from } }
    for var at = from; at <= n - m; at = at + 1 {
        if matchesAt(haystack, needle, at) { return at }
    }
    -1
}

-- The last offset where `needle` occurs, or -1.
fun byteRfind(haystack : String, needle : String) -> Int {
    let n = byteLength(haystack)
    let m = byteLength(needle)
    if m == 0 { return n }
    for var at = n - m; at >= 0; at = at - 1 {
        if matchesAt(haystack, needle, at) { return at }
    }
    -1
}
