module Data.String.Type (String(..), bytesOf, byteLength, concat)

-- What a `String` is, and nothing else (TIX-66).
--
-- A `String` is its bytes: an exact-sized `Prim.Array Byte`, never written
-- after the string is made, and always well-formed UTF-8. Both backends erase
-- a single-field newtype, so at run time a `String` *is* the byte array -- no
-- wrapper object, no header of its own. Slicing copies rather than sharing,
-- because a shared backing store is how a small substring keeps a large
-- parent alive, which is the leak Java removed sharing over in 7u6
-- (`RUNTIME-IN-TURKEY.md`, "Step 2").
--
-- The invariants are this module's and `Data.String`'s to keep, and the
-- constructor is exported for them: it takes a `Prim.Array`, which only a
-- library module can name, so nothing outside `lib/` can build a `String` that
-- skips the checks.
--
-- A leaf, importing nothing that mentions `String`, because `Std.Classes` and
-- `Data.Typed.Type` sit below everything else and both do. That is also why the
-- little written here is written against `Prim.` directly: the instances that
-- would let it say `<` and `+` are declared above it.

import Prelude ()
import Data.Bool.Type (Bool(..))

type String = String(Prim.Array Byte)

fun bytesOf(s : String) -> Prim.Array Byte = match s { String(b) -> b }

fun byteLength(s : String) -> Int = Prim.arrayLength(bytesOf(s))

-- Here rather than in `Data.String` because the `Show` instances of arrays,
-- options and tuples need it, and `Data.String` imports `Data.Array`.
fun concat(a : String, b : String) -> String {
    let x = bytesOf(a)
    let y = bytesOf(b)
    let n = Prim.arrayLength(x)
    let out = Prim.arrayNewUninit(Prim.intAdd(n, Prim.arrayLength(y)))
    var i = 0
    while Prim.intLt(i, n) {
        Prim.arraySet(out, i, Prim.arrayGet(x, i))
        i = Prim.intAdd(i, 1)
    }
    var j = 0
    while Prim.intLt(j, Prim.arrayLength(y)) {
        Prim.arraySet(out, Prim.intAdd(n, j), Prim.arrayGet(y, j))
        j = Prim.intAdd(j, 1)
    }
    String(out)
}
