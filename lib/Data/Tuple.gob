export (Unit)

import Prelude ()
import Data.String (String)
import Data.Eq (Eq(..), (==), (!=))
import Data.Ord (Ord(..), (<), (<=), (>), (>=))
import Text.Show (Show(..))
import Debug (Debug(..))
import Data.Hashable (Hash(..), Hasher(..))
import Data.String as Str

-- The tuple of nothing: `()` is its only value, and `()` names it too.
type Unit = ()

instance Eq (a, b) : Eq a, Eq b {
    fun eq((a, b), (c, d)) = eq(a, c) && eq(b, d)
}

instance Ord (a, b) : Ord a, Ord b {
    fun lt((a, b), (c, d)) = if eq(a, c) { lt(b, d) } else { lt(a, c) }
}

-- What its `Debug` prints: a container's text shows its elements' `Debug`,
-- so that a string in it is quoted.
instance Show (a, b) : Debug a, Debug b { fun show(t) = debug(t) }

instance Hash (a, b) : Hash a, Hash b {
    fun hashInto((a, b), h) = hashInto(b, hashInto(a, h))
}

instance Eq (a, b, c) : Eq a, Eq b, Eq c {
    fun eq((a, b, c), (d, e, f)) = eq(a, d) && eq(b, e) && eq(c, f)
}

instance Ord (a, b, c) : Ord a, Ord b, Ord c {
    fun lt((a, b, c), (d, e, f)) = if eq(a, d) {
        if eq(b, e) { lt(c, f) } else { lt(b, e) }
    } else { lt(a, d) }
}

instance Show (a, b, c) : Debug a, Debug b, Debug c { fun show(t) = debug(t) }

instance Hash (a, b, c) : Hash a, Hash b, Hash c {
    fun hashInto((a, b, c), h) = hashInto(c, hashInto(b, hashInto(a, h)))
}

instance Eq (a, b, c, d) : Eq a, Eq b, Eq c, Eq d {
    fun eq((a, b, c, d), (e, f, g, h)) =
        eq(a, e) && eq(b, f) && eq(c, g) && eq(d, h)
}

instance Ord (a, b, c, d) : Ord a, Ord b, Ord c, Ord d {
    fun lt((a, b, c, d), (e, f, g, h)) = if eq(a, e) {
        if eq(b, f) {
            if eq(c, g) { lt(d, h) } else { lt(c, g) }
        } else { lt(b, f) }
    } else { lt(a, e) }
}

instance Show (a, b, c, d) : Debug a, Debug b, Debug c, Debug d {
    fun show(t) = debug(t)
}

instance Hash (a, b, c, d) : Hash a, Hash b, Hash c, Hash d {
    fun hashInto((a, b, c, d), h) = hashInto(d, hashInto(c, hashInto(b, hashInto(a, h))))
}
