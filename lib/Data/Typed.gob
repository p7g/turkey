module Data.Typed (Typed(..), TypeRep(..), Proxy(..), name, arity, argument, describe)

import Prelude ()
import Data.Int (Int)
import Data.Array (Array)
import Data.String (String)
import Data.Eq (Eq(..))
import Data.Ord (Ord(..))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..))
import Text.Show (Show(..))
import Data.Bool (Bool(..))
import Data.Int ()
import Data.String ()

-- A type, as a value: the constructor's qualified name and its arguments.
--
-- The name is `TCon.name`, which is module-qualified and which `type_key`,
-- `match` and unification already compare. So equality of two reps is equality
-- of two types, and `cast` needs no notion of identity the compiler does not
-- already use for everything else.
--
-- The arguments are a `Prim.Array` rather than a `Data.Array.Array` because
-- that is what the compiler builds most cheaply: a synthesized instance writes
-- one directly as Core.
type TypeRep = TypeRep(String, Prim.Array TypeRep)

-- A type named without a value of it. `typeRep` has to mention `a` somewhere
-- in its signature or no call could say which instance it wanted; `Proxy` is
-- the argument that does that and carries nothing.
type Proxy a = Proxy

-- A type as a value, so that a packed payload can be asked what it is.
--
-- Instances are derived by the solver and a program may not write one: a
-- hand-written instance could claim any type for any value, which is exactly
-- what makes an unchecked cast unsound. GHC has rejected user `Typeable`
-- instances since 7.10 for the same reason.
class Typed a { fun typeRep(Proxy a) -> TypeRep }

-- What a type is called: the module-qualified constructor name, so two
-- reps are equal exactly when the types they describe are.
fun name(r : TypeRep) -> String = match r {
    TypeRep(n, _) -> n
}

fun arity(r : TypeRep) -> Int = match r {
    TypeRep(_, args) -> Prim.arrayLength(args)
}

-- The rep of one type argument. Out of range panics, as indexing does.
fun argument(r : TypeRep, i : Int) -> TypeRep = match r {
    TypeRep(_, args) -> Prim.arrayGet(args, i)
}

-- An argument that takes arguments of its own is parenthesized, because
-- `Pair Box Int String` and `Pair (Box Int) String` are different types and a
-- rendering that cannot tell them apart is worse than no rendering.
fun describe(r : TypeRep) -> String {
    var out = name(r)
    for var i = 0; i < arity(r); i = i + 1 {
        let a = argument(r, i)
        if arity(a) == 0 {
            out = out + " " + describe(a)
        } else {
            out = out + " (" + describe(a) + ")"
        }
    }
    out
}

instance Show TypeRep { fun show(r) = describe(r) }

-- Structural, because that is what type identity is: the same constructor
-- applied to the same arguments. A cast compares these and converts nothing
-- unless they agree.
instance Eq TypeRep {
    fun eq(a, b) {
        if name(a) != name(b) { return False }
        if arity(a) != arity(b) { return False }
        for var i = 0; i < arity(a); i = i + 1 {
            if argument(a, i) != argument(b, i) { return False }
        }
        True
    }
}
