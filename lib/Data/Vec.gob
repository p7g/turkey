module Data.Vec (
    Vec,
    new,
    filled,
    fromArray,
    toArray,
    push,
    pop,
    clear,
    map,
    filter,
    fold,
    reverse,
    append,
    copy,
    fill,
    at,
    last,
    swap,
    slice,
    indexOf,
    contains,
    sortBy,
    sort,
    threeWay,
    extendFromRaw,
)

-- The growable array: `push` and `pop` change its length.
--
-- An array literal builds one directly when inference decides it is a `Vec`,
-- out of the two records below by name: `Vec` over a `VecStorage` with the
-- fields `storage` and `length`. Renaming any of them means changing how the
-- compiler lowers a literal in the same commit.

import Prelude ()
import Std.Classes
import Data.Bool.Type (Bool(..))
import Data.Int ()
import Data.Int as Int
import Data.Option.Type (Option(..))
import Data.Ordering.Type (Ordering(..))
import Data.String.Type as Str
import Data.Array (Array)
import Data.Array as Array
import Data.Array.Storage (outOfBounds, checkRun, threeWay)
import Data.Array.Storage as Storage

-- The first `length` slots of `storage` are the elements; the rest is room to
-- grow into, and is never read.
type VecStorage a = VecStorage {
    var storage : Prim.Array a,
    var length  : Int,
}

type Vec a = Vec(VecStorage a)

fun state(Vec(value)) = value

-- An empty `Vec` with room for `capacity` elements before it must grow.
fun new(capacity : Int) -> Vec a = Vec(VecStorage {
    storage = Prim.arrayNewUninit(capacity),
    length = 0,
})

fun filled(length : Int, value : a) -> Vec a = Vec(VecStorage {
    storage = Prim.arrayNew(length, value),
    length,
})

-- Both copy: a `Vec` and an `Array` never share their elements.
fun fromArray(xs : Array a) -> Vec a {
    let out = new(len(xs))
    for x in xs { push(out, x) }
    out
}

fun toArray(xs : Vec a) -> Array a {
    let data = state(xs)
    Array.ofStorage(Storage.copy(data.storage, data.length))
}

fun grow(xs : Vec a) { reserve(xs, 1) }

-- Room for `more` elements past the length, at least doubling the capacity
-- when there is not.
fun reserve(xs : Vec a, more : Int) -> Unit {
    let data = state(xs)
    let capacity = Prim.arrayLength(data.storage)
    if more <= capacity - data.length { return }
    var nextCapacity = if capacity == 0 { 1 } else { capacity * 2 }
    if nextCapacity - data.length < more { nextCapacity = data.length + more }
    let storage = Prim.arrayNewUninit(nextCapacity)
    Prim.arrayCopy(storage, 0, data.storage, 0, data.length)
    data.storage = storage
}

-- Push `count` elements from raw memory at `source`, laid out as the storage
-- lays them out, for the rest of the library: a program cannot hold a
-- `Prim.Ptr`. Untraced elements only, which the compiler checks.
fun extendFromRaw(xs : Vec a, source : Prim.Ptr, count : Int) -> Unit {
    reserve(xs, count)
    let data = state(xs)
    Prim.arrayCopyIn(data.storage, data.length, source, count)
    data.length = data.length + count
}

fun push(xs : Vec a, x : a) -> Unit {
    grow(xs)
    let data = state(xs)
    Prim.arraySet(data.storage, data.length, x)
    data.length = data.length + 1
}

fun pop(xs : Vec a) -> Option a {
    let data = state(xs)
    if data.length == 0 { return None }
    data.length = data.length - 1
    Some(Prim.arrayGet(data.storage, data.length))
}

-- Drop every element, keeping the capacity. The elements themselves are still
-- reachable from the storage until they are overwritten, which costs nothing a
-- compiler notices and saves the reallocation a fresh `Vec` would need.
fun clear(xs : Vec a) -> Unit {
    state(xs).length = 0
}

fun bounds(xs : Vec a, i : Int, operation : String) {
    let length = state(xs).length
    if i < 0 || i >= length { outOfBounds(operation, i, length) }
}

-- `f` of each element of `xs`, in order. `xs` is anything with a length that
-- can be iterated, so an `Array` maps straight to a `Vec`.
fun map[Iterator c, Length c, Item c ~ a](xs : c, f : fun(a) -> b) -> Vec b {
    let out = new(len(xs))
    for x in xs { push(out, f(x)) }
    out
}

fun filter(xs : Vec a, keep : fun(a) -> Bool) -> Vec a {
    let out = new(len(xs))
    for x in xs {
        if keep(x) { push(out, x) }
    }
    out
}

fun fold(xs : Vec a, initial : b, step : fun(b, a) -> b) -> b {
    var acc = initial
    for x in xs { acc = step(acc, x) }
    acc
}

fun reverse(xs : Vec a) -> Vec a {
    let out = new(len(xs))
    var i = len(xs) - 1
    while i >= 0 {
        push(out, xs[i])
        i = i - 1
    }
    out
}

fun append(xs : Vec a, ys : Vec a) -> Vec a {
    let n = len(xs)
    let m = len(ys)
    let storage = Prim.arrayNewUninit(n + m)
    Prim.arrayCopy(storage, 0, state(xs).storage, 0, n)
    Prim.arrayCopy(storage, n, state(ys).storage, 0, m)
    Vec(VecStorage { storage, length = n + m })
}

-- Copy `count` elements of `source`, from index `from` on, over those of
-- `target` from index `at` on, as `Array.copy` does. Only over elements
-- `target` has: this never changes its length, and panics unless both runs
-- are inside their `Vec`s.
fun copy(target : Vec a, at : Int, source : Vec a, from : Int, count : Int)
        -> Unit {
    checkRun("copy into", at, count, len(target))
    checkRun("copy from", from, count, len(source))
    Prim.arrayCopy(state(target).storage, at, state(source).storage, from, count)
}

-- Set the `count` elements of `target` from index `at` on to `value`.
-- Panics unless they are all elements of `target`.
fun fill(target : Vec a, at : Int, count : Int, value : a) -> Unit {
    checkRun("fill", at, count, len(target))
    Prim.arrayFill(state(target).storage, at, count, value)
}

-- -- reading without panicking -------------------------------------------------
--
-- `xs[i]` is the `Index` method and panics, which is right for a program that
-- knows the index is good. `at` is for the one that is asking.

fun at(xs : Vec a, i : Int) -> Option a =
    if i < 0 || i >= len(xs) { None } else { Some(xs[i]) }

fun last(xs : Vec a) -> Option a = at(xs, len(xs) - 1)

fun swap(xs : Vec a, i : Int, j : Int) -> Unit {
    let x = xs[i]
    xs[i] = xs[j]
    xs[j] = x
}

-- A copy, not a view. A view would alias storage that `push` is free to
-- reallocate out from under it, and the growth policy is deliberately not part
-- of this type's contract.
fun slice(xs : Vec a, from : Int, to : Int) -> Vec a {
    if from < 0 || to > len(xs) || from > to {
        error(Str.concat(
            Str.concat("array slice out of bounds: ", Int.toString(from)),
            Str.concat("..", Int.toString(to))))
    }
    let storage = Prim.arrayNewUninit(to - from)
    Prim.arrayCopy(storage, 0, state(xs).storage, from, to - from)
    Vec(VecStorage { storage, length = to - from })
}

fun indexOf[Eq a](xs : Vec a, wanted : a) -> Option Int {
    for var i = 0; i < len(xs); i = i + 1 {
        if xs[i] == wanted { return Some(i) }
    }
    None
}

fun contains[Eq a](xs : Vec a, wanted : a) -> Bool = match indexOf(xs, wanted) {
    Some(_) -> True
    None -> False
}

-- A stable sort, answering a new `Vec`; `Data.Array.Storage` says how.
fun sortBy(xs : Vec a, compare : fun(a, a) -> Ordering) -> Vec a {
    let data = state(xs)
    Vec(VecStorage {
        storage = Storage.sorted(data.storage, data.length, compare),
        length = data.length,
    })
}

fun sort[Ord a](xs : Vec a) -> Vec a = sortBy(xs, threeWay)

instance Index (Vec a) {
    type Key = Int
    type Value = a
    fun get(xs, i) {
        bounds(xs, i, "read at")
        Prim.arrayGet(state(xs).storage, i)
    }
}

instance SetIndex (Vec a) {
    fun set(xs, i, x) {
        bounds(xs, i, "write at")
        Prim.arraySet(state(xs).storage, i, x)
    }
}

instance Length (Vec a) { fun len(xs) = state(xs).length }

type VecCursor = VecCursor { var at : Int }

instance Iterator (Vec a) {
    type Item = a
    type Cursor = VecCursor
    fun iter(xs) = VecCursor { at = 0 }
    -- Reads the storage directly rather than through `get`: the test against
    -- `length` above is the one `get` would make, so making it twice costs a
    -- compare per element and can never fail the second time with one task.
    -- With several, the compiler's check against the storage's own length is
    -- still what keeps the read inside the array.
    fun next(xs, cur) {
        let data = state(xs)
        if cur.at >= data.length { return None }
        let x = Prim.arrayGet(data.storage, cur.at)
        cur.at = cur.at + 1
        Some(x)
    }
}

instance Add (Vec a) { fun add(xs, ys) = append(xs, ys) }
instance Semigroup (Vec a) { fun combine(xs, ys) = append(xs, ys) }
instance Monoid (Vec a) { fun empty() = [] }

instance Foldable Vec {
    fun foldMap[Monoid m](xs, f) {
        var acc : m = empty()
        for x in xs { acc = combine(acc, f(x)) }
        acc
    }
}

instance Functor Vec {
    fun map(xs, f) {
        let out = new(len(xs))
        for x in xs { push(out, f(x)) }
        out
    }
}

instance Applicative Vec { fun pure(x) = [x] }

instance Monad Vec {
    fun bind(xs, f) {
        let out = new(len(xs))
        for x in xs {
            for y in f(x) { push(out, y) }
        }
        out
    }
}

instance Show (Vec a) : Show a {
    fun show(xs) {
        var out = "["
        var rest = False
        for x in xs {
            if rest { out = Str.concat(out, ", ") }
            out = Str.concat(out, show(x))
            rest = True
        }
        Str.concat(out, "]")
    }
}
