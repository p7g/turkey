export (FoldHash)

import Prelude ()
import Data.Int (Int)
import Turkey.Bytes (ByteView)
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..), (+), (-), (*), (/), (%))
import Data.Eq (Eq(..), (==), (!=))
import Data.Ord (Ord(..), (<), (<=), (>), (>=))
import Bits (BitOr(..), BitXor(..), Shift(..), (|), (^), (<<))
import Data.Index (Index(..), Length(..))
import Data.Int as Int
import Data.Hashable (Hasher(..))
import Hash.Words (fold, rotr, Words64(..), Words32(..), byteAt)

--- foldhash's fast variant (foldhash-f), the default hasher of Rust's
--- hashbrown: every step is one folded multiply of the input xored with the
--- state and a secret.
---
--- Words are buffered two at a time in a 128-bit "sponge" and folded in one
--- multiply, so a key of one or two words costs one multiply in all, at
--- `finishHash`. A byte run is folded into the state at once, rotated first by its
--- length so that runs of different lengths start apart.

type FoldHash = FoldHash {
    acc : Int,
    lo  : Int,
    hi  : Int,
    -- How many of `lo` and `hi` hold a word: 0, 1 or 2.
    held : Int,
}

-- foldhash's fixed shared seeds (`ARBITRARY6` to `ARBITRARY11`), and the
-- constant its fixed per-hasher seed starts from (`ARBITRARY3`).
let s0 = -4563226453097033507
let s1 = 4577018097722394903
let s2 = -7919907764393346277
let s3 = -3372901835766516308
let s4 = 3458046377305235383
let s5 = -5124621466747896170
let perHasher = 589684135938649225

instance Hasher FoldHash {
    fun startHash(seed) = FoldHash { acc = seed ^ perHasher, lo = 0, hi = 0, held = 0 }

    fun hashInt(FoldHash { acc, lo, hi, held }, x) =
        if held == 2 {
            FoldHash { acc = fold(lo ^ acc, hi ^ s0), lo = x, hi = 0, held = 1 }
        } else if held == 1 {
            FoldHash { acc, lo, hi = x, held = 2 }
        } else {
            FoldHash { acc, lo = x, hi, held = 1 }
        }

    fun hashBytes(FoldHash { acc, lo, hi, held }, bytes) {
        let n = len(bytes)
        let rotated = rotr(acc, n)
        let next = if n <= 16 { short(bytes, rotated) } else { long(bytes, rotated) }
        FoldHash { acc = next, lo, hi, held }
    }

    fun finishHash(FoldHash { acc, lo, hi, held }) =
        if held > 0 { fold(lo ^ acc, hi ^ s0) } else { acc }
}

-- `hash_bytes_short`: at most 16 bytes, as two possibly overlapping reads.
fun short(bytes : ByteView, acc : Int) -> Int {
    let words = Words64(bytes)
    let halves = Words32(bytes)
    let n = len(bytes)
    var a = acc
    var b = s1
    if n >= 8 {
        a = a ^ words[0]
        b = b ^ words[n - 8]
    } else if n >= 4 {
        a = a ^ halves[0]
        b = b ^ halves[n - 4]
    } else if n > 0 {
        a = a ^ byteAt(bytes, 0)
        b = b ^ (byteAt(bytes, n - 1) << 8 | byteAt(bytes, n / 2))
    }
    fold(a, b)
}

-- `hash_bytes_long`: more than 16 bytes. Two lanes over the run, four over a
-- run longer than 128 bytes and six over one longer than 256, then up to eight
-- reads from each end of what is left.
fun long(bytes : ByteView, acc : Int) -> Int {
    let words = Words64(bytes)
    let to = len(bytes)
    var at = 0
    var a = acc
    var b = Int.addWrapping(acc, s1)
    if to - at > 128 {
        var c = Int.addWrapping(acc, s2)
        var e = Int.addWrapping(acc, s3)
        if to - at > 256 {
            var f = Int.addWrapping(acc, s4)
            var g = Int.addWrapping(acc, s5)
            loop {
                a = fold(words[at] ^ a, words[at + 48] ^ s0)
                b = fold(words[at + 8] ^ b, words[at + 56] ^ s0)
                c = fold(words[at + 16] ^ c, words[at + 64] ^ s0)
                e = fold(words[at + 24] ^ e, words[at + 72] ^ s0)
                f = fold(words[at + 32] ^ f, words[at + 80] ^ s0)
                g = fold(words[at + 40] ^ g, words[at + 88] ^ s0)
                at = at + 96
                if to - at <= 256 { break }
            }
            a = a ^ f
            b = b ^ g
        }
        loop {
            a = fold(words[at] ^ a, words[at + 32] ^ s0)
            b = fold(words[at + 8] ^ b, words[at + 40] ^ s0)
            c = fold(words[at + 16] ^ c, words[at + 48] ^ s0)
            e = fold(words[at + 24] ^ e, words[at + 56] ^ s0)
            at = at + 64
            if to - at <= 128 { break }
        }
        a = a ^ c
        b = b ^ e
    }
    let n = to - at
    a = fold(words[at] ^ a, words[to - 16] ^ s0)
    b = fold(words[at + 8] ^ b, words[to - 8] ^ s0)
    if n >= 32 {
        a = fold(words[at + 16] ^ a, words[to - 32] ^ s0)
        b = fold(words[at + 24] ^ b, words[to - 24] ^ s0)
        if n >= 64 {
            a = fold(words[at + 32] ^ a, words[to - 48] ^ s0)
            b = fold(words[at + 40] ^ b, words[to - 40] ^ s0)
            if n >= 96 {
                a = fold(words[at + 48] ^ a, words[to - 64] ^ s0)
                b = fold(words[at + 56] ^ b, words[to - 56] ^ s0)
            }
        }
    }
    a ^ b
}

