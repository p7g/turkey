export (FoldHash)

import Data.Hashable (Hasher(..))
import Hash.Words (fold, rotr, word64, word32, byteAt)

-- foldhash's fast variant (foldhash-f), the default hasher of Rust's
-- hashbrown: every step is one folded multiply of the input xored with the
-- state and a secret.
--
-- Words are buffered two at a time in a 128-bit "sponge" and folded in one
-- multiply, so a key of one or two words costs one multiply in all, at
-- `digest`. A byte run is folded into the state at once, rotated first by its
-- length so that runs of different lengths start apart.

type FoldHash = FoldHash {
    var acc : Int,
    var lo  : Int,
    var hi  : Int,
    -- How many of `lo` and `hi` hold a word: 0, 1 or 2.
    var held : Int,
}

-- foldhash's fixed shared seeds (`ARBITRARY6` to `ARBITRARY11`), and the
-- constant its fixed per-hasher seed starts from (`ARBITRARY3`).
let s0 = -4563226453097033507
let s1 = 4577018097722394903
let s2 = -7919907764393346277
let s3 = -3372901835766516308
let s4 = 3458046377305235383
let s5 = -5124621466747896170
let perHasher = 589684135938649225

instance Hasher FoldHash {
    fun seeded(seed) = FoldHash { acc = Int.xor(seed, perHasher), lo = 0, hi = 0, held = 0 }

    fun writeInt(d, x) {
        if d.held == 2 {
            d.acc = fold(Int.xor(d.lo, d.acc), Int.xor(d.hi, s0))
            d.lo = x
            d.hi = 0
            d.held = 1
        } else if d.held == 1 {
            d.hi = x
            d.held = 2
        } else {
            d.lo = x
            d.held = 1
        }
    }

    fun writeBytes(d, bytes, from, to) {
        let n = to - from
        let acc = rotr(d.acc, n)
        d.acc = if n <= 16 { short(bytes, from, to, acc) } else { long(bytes, from, to, acc) }
    }

    fun digest(d) =
        if d.held > 0 { fold(Int.xor(d.lo, d.acc), Int.xor(d.hi, s0)) } else { d.acc }
}

-- `hash_bytes_short`: at most 16 bytes, as two possibly overlapping reads.
fun short(bytes : Prim.Array Byte, from : Int, to : Int, acc : Int) -> Int {
    let n = to - from
    var a = acc
    var b = s1
    if n >= 8 {
        a = Int.xor(a, word64(bytes, from))
        b = Int.xor(b, word64(bytes, to - 8))
    } else if n >= 4 {
        a = Int.xor(a, word32(bytes, from))
        b = Int.xor(b, word32(bytes, to - 4))
    } else if n > 0 {
        a = Int.xor(a, byteAt(bytes, from))
        b = Int.xor(b, Int.or(Prim.intShl(byteAt(bytes, to - 1), 8), byteAt(bytes, from + n / 2)))
    }
    fold(a, b)
}

-- `hash_bytes_long`: more than 16 bytes. Two lanes over the run, four over a
-- run longer than 128 bytes and six over one longer than 256, then up to eight
-- reads from each end of what is left.
fun long(bytes : Prim.Array Byte, from : Int, to : Int, acc : Int) -> Int {
    var at = from
    var a = acc
    var b = Int.addWrapping(acc, s1)
    if to - at > 128 {
        var c = Int.addWrapping(acc, s2)
        var e = Int.addWrapping(acc, s3)
        if to - at > 256 {
            var f = Int.addWrapping(acc, s4)
            var g = Int.addWrapping(acc, s5)
            loop {
                a = fold(Int.xor(word64(bytes, at), a), Int.xor(word64(bytes, at + 48), s0))
                b = fold(Int.xor(word64(bytes, at + 8), b), Int.xor(word64(bytes, at + 56), s0))
                c = fold(Int.xor(word64(bytes, at + 16), c), Int.xor(word64(bytes, at + 64), s0))
                e = fold(Int.xor(word64(bytes, at + 24), e), Int.xor(word64(bytes, at + 72), s0))
                f = fold(Int.xor(word64(bytes, at + 32), f), Int.xor(word64(bytes, at + 80), s0))
                g = fold(Int.xor(word64(bytes, at + 40), g), Int.xor(word64(bytes, at + 88), s0))
                at = at + 96
                if to - at <= 256 { break }
            }
            a = Int.xor(a, f)
            b = Int.xor(b, g)
        }
        loop {
            a = fold(Int.xor(word64(bytes, at), a), Int.xor(word64(bytes, at + 32), s0))
            b = fold(Int.xor(word64(bytes, at + 8), b), Int.xor(word64(bytes, at + 40), s0))
            c = fold(Int.xor(word64(bytes, at + 16), c), Int.xor(word64(bytes, at + 48), s0))
            e = fold(Int.xor(word64(bytes, at + 24), e), Int.xor(word64(bytes, at + 56), s0))
            at = at + 64
            if to - at <= 128 { break }
        }
        a = Int.xor(a, c)
        b = Int.xor(b, e)
    }
    let n = to - at
    a = fold(Int.xor(word64(bytes, at), a), Int.xor(word64(bytes, to - 16), s0))
    b = fold(Int.xor(word64(bytes, at + 8), b), Int.xor(word64(bytes, to - 8), s0))
    if n >= 32 {
        a = fold(Int.xor(word64(bytes, at + 16), a), Int.xor(word64(bytes, to - 32), s0))
        b = fold(Int.xor(word64(bytes, at + 24), b), Int.xor(word64(bytes, to - 24), s0))
        if n >= 64 {
            a = fold(Int.xor(word64(bytes, at + 32), a), Int.xor(word64(bytes, to - 48), s0))
            b = fold(Int.xor(word64(bytes, at + 40), b), Int.xor(word64(bytes, to - 40), s0))
            if n >= 96 {
                a = fold(Int.xor(word64(bytes, at + 48), a), Int.xor(word64(bytes, to - 64), s0))
                b = fold(Int.xor(word64(bytes, at + 56), b), Int.xor(word64(bytes, to - 56), s0))
            }
        }
    }
    Int.xor(a, b)
}
