export (SipHash)

import Data.Hashable (Hasher(..))
import Hash.Words (rotl, word64, byteAt)

-- SipHash-1-3 (Aumasson and Bernstein): one compression round per 8-byte
-- block and three at the end, the variant Rust's `HashMap`, Python and Swift
-- use. Unlike the others in `Hash` it is a keyed pseudorandom function, so an
-- attacker who sees no hash values cannot build keys that collide.
--
-- A word is one block. A run of bytes is its whole words as blocks and then
-- one block holding the remaining 0 to 7 bytes with the run's length in its
-- top byte, so that every run ends on a block boundary and two runs cannot
-- run together. The final block is SipHash's: the total length in the top
-- byte.
--
-- The state holds the last part written -- a word or a run -- uncompressed,
-- and `digest` compresses it and finishes in one function that returns an
-- `Int`. A record returned from a function the optimizer does not inline is
-- allocated, and four-word compression is too large to inline, so deferring
-- it is what lets a key of one part, the common case, allocate nothing. A key
-- of several parts compresses each earlier part when the next arrives, and
-- allocates once for each.

type SipHash = SipHash {
    v0 : Int,
    v1 : Int,
    v2 : Int,
    v3 : Int,
    -- Bytes compressed so far.
    length : Int,
    -- What is held: 0 nothing, 1 the word `word`, 2 the run `run[from..to]`.
    held : Int,
    word : Int,
    run : Prim.Array Byte,
    from : Int,
    to : Int,
}

-- "somepseudorandomlygeneratedbytes", as four little-endian words.
let c0 = 8317987319222330741
let c1 = 7237128888997146477
let c2 = 7816392313619706465
let c3 = 8387220255154660723

-- The second key word, which a seed of one word leaves fixed.
let k1 = -6148914691236517206

let noBytes : Prim.Array Byte = Prim.arrayNew(0, Prim.byteFromInt(0))

-- How many blocks the held part is: a word is one, a run its whole words and
-- one more.
fun heldBlocks(held : Int, from : Int, to : Int) -> Int =
    if held == 1 { 1 } else if held == 2 { (to - from) / 8 + 1 } else { 0 }

-- Block `k` of the held part.
fun heldBlock(held : Int, word : Int, run : Prim.Array Byte, from : Int, to : Int, k : Int) -> Int {
    if held == 1 { return word }
    let at = from + 8 * k
    if to - at >= 8 { return word64(run, at) }
    var last = Prim.intShl(Int.and(to - from, 255), 56)
    var shift = 0
    for var i = at; i < to; i = i + 1 {
        last = Int.or(last, Prim.intShl(byteAt(run, i), shift))
        shift = shift + 8
    }
    last
}

-- Compresses the held part and SipHash's last block, runs the three finishing
-- rounds, and returns the digest. Its twin, `compressHeld`, stops before the
-- last block and returns the state; they are two functions so that this one,
-- which every key reaches, returns an `Int`.
--
-- It takes the state's fields rather than the state, since a record passed to
-- a function that is not inlined is allocated too.
fun finish(start0 : Int, start1 : Int, start2 : Int, start3 : Int, compressed : Int, held : Int,
           word : Int, run : Prim.Array Byte, from : Int, to : Int) -> Int {
    var v0 = start0
    var v1 = start1
    var v2 = start2
    var v3 = start3
    let blocks = heldBlocks(held, from, to)
    let length = compressed + 8 * blocks
    for var k = 0; k <= blocks; k = k + 1 {
        let last = k == blocks
        let m = if last { Prim.intShl(Int.and(length, 255), 56) }
                else { heldBlock(held, word, run, from, to, k) }
        v3 = Int.xor(v3, m)
        let rounds = if last { 4 } else { 1 }
        for var r = 0; r < rounds; r = r + 1 {
            v0 = Int.addWrapping(v0, v1)
            v1 = Int.xor(rotl(v1, 13), v0)
            v0 = rotl(v0, 32)
            v2 = Int.addWrapping(v2, v3)
            v3 = Int.xor(rotl(v3, 16), v2)
            v0 = Int.addWrapping(v0, v3)
            v3 = Int.xor(rotl(v3, 21), v0)
            v2 = Int.addWrapping(v2, v1)
            v1 = Int.xor(rotl(v1, 17), v2)
            v2 = rotl(v2, 32)
            if r == 0 {
                v0 = Int.xor(v0, m)
                if last { v2 = Int.xor(v2, 255) }
            }
        }
    }
    Int.xor(Int.xor(v0, v1), Int.xor(v2, v3))
}

-- Compresses the held part, and holds nothing after.
fun compressHeld(s : SipHash) -> SipHash {
    var v0 = s.v0
    var v1 = s.v1
    var v2 = s.v2
    var v3 = s.v3
    let blocks = heldBlocks(s.held, s.from, s.to)
    for var k = 0; k < blocks; k = k + 1 {
        let m = heldBlock(s.held, s.word, s.run, s.from, s.to, k)
        v3 = Int.xor(v3, m)
        v0 = Int.addWrapping(v0, v1)
        v1 = Int.xor(rotl(v1, 13), v0)
        v0 = rotl(v0, 32)
        v2 = Int.addWrapping(v2, v3)
        v3 = Int.xor(rotl(v3, 16), v2)
        v0 = Int.addWrapping(v0, v3)
        v3 = Int.xor(rotl(v3, 21), v0)
        v2 = Int.addWrapping(v2, v1)
        v1 = Int.xor(rotl(v1, 17), v2)
        v2 = rotl(v2, 32)
        v0 = Int.xor(v0, m)
    }
    SipHash { v0, v1, v2, v3, length = s.length + 8 * blocks,
              held = 0, word = 0, run = noBytes, from = 0, to = 0 }
}

fun holding(s : SipHash, held : Int, word : Int, run : Prim.Array Byte, from : Int, to : Int) -> SipHash {
    let t = if s.held == 0 { s } else { compressHeld(s) }
    SipHash { v0 = t.v0, v1 = t.v1, v2 = t.v2, v3 = t.v3, length = t.length, held, word, run, from, to }
}

instance Hasher SipHash {
    fun seeded(seed) = SipHash {
        v0 = Int.xor(seed, c0),
        v1 = Int.xor(k1, c1),
        v2 = Int.xor(seed, c2),
        v3 = Int.xor(k1, c3),
        length = 0,
        held = 0,
        word = 0,
        run = noBytes,
        from = 0,
        to = 0,
    }

    fun writeInt(s, x) = holding(s, 1, x, noBytes, 0, 0)

    fun writeBytes(s, bytes, from, to) = holding(s, 2, 0, bytes, from, to)

    fun digest(s) = finish(s.v0, s.v1, s.v2, s.v3, s.length, s.held, s.word, s.run, s.from, s.to)
}
