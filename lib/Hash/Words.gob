export (fold, rotl, rotr, Words64(..), Words32(..), byteAt)

import Prelude ()
import Data.Int (Int)
import Data.Byte (Byte)
import Turkey.Bytes (ByteView(..))
import Data.String (String)
import Data.Num (Add(..), Sub(..), (+), (-))
import Data.Ord (Ord(..), (<), (>))
import Bits (BitAnd(..), BitOr(..), BitXor(..), Shift(..), (&), (|), (^), (<<))
import Data.Index (Index(..), Length(..))
import Control.Panic (error)
import Data.Int as Int
import Data.Byte as Byte
import Turkey.Ptr as Ptr

-- The word operations the hash functions in `Hash` share. All of them wrap: a
-- hash is supposed to overflow.

-- The xor of the two halves of the unsigned 128-bit product `x * y`: the
-- "folded multiply" that the multiply-based hashes mix with. The high half is
-- what carries the upper input bits down into the low bits a table indexes by.
fun fold(x : Int, y : Int) -> Int = Int.mulWrapping(x, y) ^ Int.mulHighUnsigned(x, y)

-- `x` rotated by `n` bits, taken modulo 64. Both shift amounts are masked, so
-- that a rotation by a multiple of 64 shifts by 0 both ways and is `x`.
fun rotl(x : Int, n : Int) -> Int = x << (n & 63) | Int.shrUnsigned(x, (64 - n) & 63)

fun rotr(x : Int, n : Int) -> Int = Int.shrUnsigned(x, n & 63) | x << ((64 - n) & 63)

-- `bytes` read as overlapping little-endian words: `Words64(bytes)[at]` is the
-- 8 bytes from `bytes[at]` to `bytes[at + 7]`, and `Words32(bytes)[at]` the 4
-- from `bytes[at]`, zero-extended. Indexing panics if the word runs past the
-- end of the view, as indexing `bytes` would. A view lies inside its storage,
-- so a word inside the view is a load inside the storage.
--
-- Each read is one load instruction. Assembling the word a byte at a time
-- with `Byte.getLE` is simpler, but made string keys about twice as slow in a
-- `Map` under every hasher here, and 80-byte keys five times as slow.
type Words64 = Words64(ByteView)
type Words32 = Words32(ByteView)

instance Index Words64 {
    type Key = Int
    type Value = Int
    fun get(Words64(ByteView { storage, from, length }), at) {
        if at < 0 || at + 8 > length { badWord("Words64", at, length) }
        let w : Int = Ptr.load(Ptr.elementAddress(storage, from), at)
        Ptr.keepAlive(storage)
        w
    }
}

instance Index Words32 {
    type Key = Int
    type Value = Int
    fun get(Words32(ByteView { storage, from, length }), at) {
        if at < 0 || at + 4 > length { badWord("Words32", at, length) }
        let w = Ptr.load32(Ptr.elementAddress(storage, from), at)
        Ptr.keepAlive(storage)
        w
    }
}

fun byteAt(bytes : ByteView, at : Int) -> Int = Byte.toInt(bytes[at])

fun badWord(what : String, at : Int, length : Int) -> a =
    error(what + ": a word at " + Int.toString(at) + " runs past " + Int.toString(length) + " bytes")
