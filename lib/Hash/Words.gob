export (fold, rotl, rotr, word64, word32, byteAt)

import Prelude ()
import Data.Int (Int)
import Data.Byte (Byte)
import Data.Num (Sub(..), (-))
import Data.Int as Int
import Data.Byte as Byte
import Data.Char as Char

-- The word operations the hash functions in `Hash` share. Every one is a
-- primitive or two, and all of them wrap: a hash is supposed to overflow.

-- The xor of the two halves of the unsigned 128-bit product `x * y`: the
-- "folded multiply" that the multiply-based hashes mix with. The high half is
-- what carries the upper input bits down into the low bits a table indexes by.
fun fold(x : Int, y : Int) -> Int =
    Int.xor(Int.mulWrapping(x, y), Prim.intMulHighUnsigned(x, y))

-- `x` rotated by `n` bits, taken modulo 64. A rotation by 0 is correct too:
-- the machine takes the complementary shift of 64 as a shift by 0, and the
-- two halves are then both `x`.
fun rotl(x : Int, n : Int) -> Int = Int.or(Prim.intShl(x, n), Prim.intShrUnsigned(x, 64 - n))

fun rotr(x : Int, n : Int) -> Int = Int.or(Prim.intShrUnsigned(x, n), Prim.intShl(x, 64 - n))

-- The 8 bytes `bytes[at]` to `bytes[at + 7]` as one little-endian word. The
-- caller has checked `at + 8 <= len(bytes)`; nothing here does.
fun word64(bytes : Prim.Array Byte, at : Int) -> Int {
    let w = Prim.loadI64(Prim.elementAddress(bytes, at), 0)
    Prim.keepAlive(bytes)
    w
}

-- The 4 bytes `bytes[at]` to `bytes[at + 3]`, little-endian and zero-extended.
fun word32(bytes : Prim.Array Byte, at : Int) -> Int {
    let w = Char.toInt(Prim.loadI32(Prim.elementAddress(bytes, at), 0))
    Prim.keepAlive(bytes)
    w
}

fun byteAt(bytes : Prim.Array Byte, at : Int) -> Int = Byte.toInt(Prim.arrayGet(bytes, at))
