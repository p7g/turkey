export (Iterator(..), any, all, count, find, fold, sum, product, minimum, maximum, minBy, maxBy)

import Prelude ()
import Data.Bool (Bool(..))
import Data.Int (Int)
import Data.Num (Add(..), Mul(..), Zero(..), One(..), (+), (*))
import Data.Ord (Ord(..), (<))
import Data.Option (Option(..))

class Iterator c {
    type Item c
    type Cursor c

    fun iter(c) -> Cursor c
    fun next(c, Cursor c) -> Option (Item c)
}

-- The questions asked of every element in turn. `any`, `all` and `find` stop
-- at the element that decides the answer and pull nothing after it, so they
-- end on an iterator that does not; none of them allocates.

fun any[Iterator c](xs : c, p : fun(Item c) -> Bool) -> Bool {
    for x in xs {
        if p(x) { return True }
    }
    False
}

fun all[Iterator c](xs : c, p : fun(Item c) -> Bool) -> Bool {
    for x in xs {
        if !p(x) { return False }
    }
    True
}

-- How many elements `p` holds for. It takes a predicate: how many elements
-- there are is `len`, which a container answers without walking itself.
fun count[Iterator c](xs : c, p : fun(Item c) -> Bool) -> Int {
    var n = 0
    for x in xs {
        if p(x) { n = n + 1 }
    }
    n
}

-- The first element `p` holds for.
fun find[Iterator c](xs : c, p : fun(Item c) -> Bool) -> Option (Item c) {
    for x in xs {
        if p(x) { return Some(x) }
    }
    None
}

-- Returns the result of calling `step` on the accumulator and each element in
-- turn, starting from `initial`. It takes its arguments in the order of
-- `Array.fold` and `Vec.fold`, and works on anything iterable.
fun fold[Iterator c](xs : c, initial : b, step : fun(b, Item c) -> b) -> b {
    var acc = initial
    for x in xs { acc = step(acc, x) }
    acc
}

-- Returns the elements added together from `zero()`, which is the result for
-- no elements.
fun sum[Iterator c, Add (Item c), Zero (Item c)](xs : c) -> Item c {
    var acc = zero()
    for x in xs { acc = acc + x }
    acc
}

-- Returns the elements multiplied together from `one()`, which is the result
-- for no elements.
fun product[Iterator c, Mul (Item c), One (Item c)](xs : c) -> Item c {
    var acc = one()
    for x in xs { acc = acc * x }
    acc
}

-- Returns the least element, or `None` for no elements. Of several elements
-- that are equal under `<`, it returns the first. A NaN is neither less than
-- nor greater than anything, so a `Float` result depends on where a NaN sits:
-- `[nan, 1.0]` gives NaN and `[1.0, nan, 0.5]` gives 0.5.
fun minimum[Iterator c, Ord (Item c)](xs : c) -> Option (Item c) {
    var best = None
    for x in xs {
        if let Some(b) = best {
            if x < b { best = Some(x) }
        } else {
            best = Some(x)
        }
    }
    best
}

-- Returns the greatest element, or `None` for no elements. Of several elements
-- that are equal under `<`, it returns the first. A NaN is neither less than
-- nor greater than anything, so a `Float` result depends on where a NaN sits.
fun maximum[Iterator c, Ord (Item c)](xs : c) -> Option (Item c) {
    var best = None
    for x in xs {
        if let Some(b) = best {
            if b < x { best = Some(x) }
        } else {
            best = Some(x)
        }
    }
    best
}

-- Returns the element whose `key` is least, or `None` for no elements. It
-- calls `key` once per element, and the first element wins a tie.
fun minBy[Iterator c, Ord k](xs : c, key : fun(Item c) -> k) -> Option (Item c) {
    var best = None
    var bestKey = None
    for x in xs {
        let k = key(x)
        if let Some(bk) = bestKey {
            if k < bk {
                best = Some(x)
                bestKey = Some(k)
            }
        } else {
            best = Some(x)
            bestKey = Some(k)
        }
    }
    best
}

-- Returns the element whose `key` is greatest, or `None` for no elements. It
-- calls `key` once per element, and the first element wins a tie.
fun maxBy[Iterator c, Ord k](xs : c, key : fun(Item c) -> k) -> Option (Item c) {
    var best = None
    var bestKey = None
    for x in xs {
        let k = key(x)
        if let Some(bk) = bestKey {
            if bk < k {
                best = Some(x)
                bestKey = Some(k)
            }
        } else {
            best = Some(x)
            bestKey = Some(k)
        }
    }
    best
}
