)

-- HTTP's protocol values: methods, statuses, header fields, URLs, requests,
-- and the bodies and responses that go with them, shared by the HTTP/1
-- codec, the client and the server. Nothing here opens a connection.
--
--     import Net.HTTP (..)
--     import Net.HTTP.MediaType as MediaType
--
--     let r = withHeaders(request(GET, "https://api.example.com/users/1"),
--                         field(Accept, MediaType.json))
--
-- This module gathers the types, their constructors and the classes, so that
-- one import brings what a program names and matches on. The functions of
-- each type are in that type's own module, imported under its name:
-- `Net.HTTP.HeaderName` for `HeaderName.parse`, `Net.HTTP.Headers` for
-- `Headers.get`, `Net.HTTP.Status` for `Status.fromCode`, and likewise
-- `HeaderValue`, `MediaType`, `Method`, `Credentials`, `Cookie`, `Token`,
-- `HTTPURL`, `Limits` and `URL`. Their names (`parse`, `get`, `add`) would
-- collide with each other's here, and with the Prelude's. The exceptions are
-- `request`, `field` and `withHeaders`, which build a request; `newPOST`,
-- `newPUT`, `newPATCH` and `newExtension`, which make a method that carries
-- a body; `receive`, `limited`, `unbounded` and `trailers`, which read an
-- `Incoming` body; `contentLength`, `host`, `upgradeRequested` and
-- `acceptsTrailers`, which read the reserved fields of a received request;
-- and `body`, `stream`, `statusOnly`, `noContent`, `notModified` and
-- `switch`, which build a server's response: a program names them as often
-- as it names a method. The server itself is `Net.HTTP.Server`.
--
-- The client is `Net.HTTP.Client`, imported on its own: it links OpenSSL,
-- which a program that only handles HTTP values has no need of.
--
-- **The rules come from HTTP's CVEs.** Values are validated strictly when
-- they are made, whether a program writes them or they arrive: no CR, LF or
-- NUL in any of them, and nothing repaired. The fields that frame and route
-- a message -- Content-Length, Transfer-Encoding, Host and the rest -- have
-- no name a program can write, because the library writes them.

import Net.HTTP.Body (Body(..), Replay, newPOST, newPUT, newPATCH, newExtension)
import Net.HTTP.Cookie (NewCookie)
import Net.HTTP.Credentials (Credentials)
import Net.HTTP.Duplex (Duplex)
import Net.HTTP.Error (HTTPError(..), HeaderError(..), Refusal(..), ClientError(..), RedirectRefused(..), FromHTTP(..))
import Net.HTTP.Incoming (Incoming, BodyRead, receive, limited, unbounded, trailers)
import Net.HTTP.Limits (Limits)
import Net.HTTP.HeaderName (HeaderName)
import Net.HTTP.HeaderValue (HeaderValue)
import Net.HTTP.Payload (Payload)
import Net.HTTP.Headers (
    Headers, Header(..), Multiplicity(..), HasHeaders(..),
    Accept(..), ContentType(..), Authorization(..), IdempotencyKey(..), Location(..),
    RetryAfter(..), Retry(..), SetCookie(..), field, withHeaders,
)
import Net.HTTP.HTTPURL (HTTPURL)
import Net.HTTP.MediaType (MediaType)
import Net.HTTP.Method (Method(..), MethodName)
import Net.HTTP.Request (
    Request(..), ClientRequest(..), RequestTarget(..), Target(..), Control(..), request,
    contentLength, host, upgradeRequested, acceptsTrailers,
)
import Net.HTTP.Response (Response(..), Timings(..))
import Net.HTTP.ServerResponse (
    ServerResponse, ToResponse(..), Content(..), body, stream, statusOnly, noContent, notModified, switch,
)
import Net.HTTP.Status (
    Status(
        Continue, SwitchingProtocols, Processing, EarlyHints, OK, Created,
        Accepted, NonAuthoritativeInformation, NoContent, ResetContent, PartialContent, MultiStatus,
        AlreadyReported, IMUsed, MultipleChoices, MovedPermanently, Found, SeeOther,
        NotModified, UseProxy, TemporaryRedirect, PermanentRedirect, BadRequest, Unauthorized,
        PaymentRequired, Forbidden, NotFound, MethodNotAllowed, NotAcceptable, ProxyAuthenticationRequired,
        RequestTimeout, Conflict, Gone, LengthRequired, PreconditionFailed, ContentTooLarge,
        URITooLong, UnsupportedMediaType, RangeNotSatisfiable, ExpectationFailed, MisdirectedRequest, UnprocessableContent,
        Locked, FailedDependency, TooEarly, UpgradeRequired, PreconditionRequired, TooManyRequests,
        RequestHeaderFieldsTooLarge, UnavailableForLegalReasons, InternalServerError, NotImplemented, BadGateway, ServiceUnavailable,
        GatewayTimeout, HTTPVersionNotSupported, VariantAlsoNegotiates, InsufficientStorage, LoopDetected, NetworkAuthenticationRequired
    )
)
import Net.HTTP.Stream (Stream(..), BodyLength(..), Sink)
import Net.HTTP.Token (Token)
import URL (URL, URLError(..))
