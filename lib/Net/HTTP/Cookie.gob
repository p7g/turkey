export (
	NewCookie,
	newSetCookie,
	withAttribute,
	parse,
	toString,
	name,
	value,
	attributes,
	CookiePair,
	pair,
	parsePairs,
	pairsToString,
	pairName,
	pairValue,
)

--- A cookie as a `Set-Cookie` header sets it (RFC 6265 §4.1): a name, a value,
--- and attributes such as `Path=/`, `Secure` and `HttpOnly`.
---
---     let session = Cookie.newSetCookie("session", id)?
---     let session = Cookie.withAttribute(session, "HttpOnly")?
---
--- Each `Set-Cookie` header sets one cookie, and the headers are never joined
--- into one: an `Expires` date holds a comma, so a joined list could not be
--- split again.
---
--- The syntax is the strict one RFC 6265 gives servers. The name is a token;
--- the value is the bytes the RFC allows, perhaps in double quotes, which are
--- kept; an attribute is any text without a control byte or `;`.
---
--- **Two sides.** A server sets a cookie with a `Set-Cookie` header, whose
--- value is a `NewCookie`, made by `newSetCookie`. A client sends the cookies
--- it holds back with one `Cookie` header, whose value is an array of
--- `CookiePair`s, made by `pair`. A pair has a name and a value and no
--- attributes:
---
---     let session = Cookie.pair("session", token)?
---     withHeaders(request(GET, url), field(Cookie, [session]))

import Net.HTTP.Syntax as Syntax

type NewCookie = NewCookie { name : String, value : String, attributes : Array String }

instance Eq NewCookie { fun eq(a, b) = toString(a) == toString(b) }
instance Show NewCookie { fun show(c) = toString(c) }

--- Returns the cookie a `Set-Cookie` header sets, with no attributes, or
--- `None` if `name` is not a token or `value` is not a cookie value. It is for
--- the side that sends `Set-Cookie`, a server's; a client sends a `pair`.
fun newSetCookie(name : String, value : String) -> Option NewCookie =
	if Syntax.isToken(name) && isCookieValue(value) {
		Some(NewCookie { name, value, attributes = [] })
	} else {
		None
	}

--- Returns `c` with the attribute `text` after those it has.
fun withAttribute(c : NewCookie, text : String) -> Option NewCookie =
	if isAttribute(text) {
		Some(NewCookie { name = c.name, value = c.value, attributes = c.attributes + [text] })
	} else {
		None
	}

--- set-cookie-string = cookie-pair *( ";" SP cookie-av )
fun parse(text : String) -> Option NewCookie {
	let parts = String.split(text, "; ")
	let (name, value) = String.splitOnce(parts[0], "=")?
	var cookie = newSetCookie(name, value)?
	for var i = 1; i < len(parts); i = i + 1 {
		cookie = withAttribute(cookie, parts[i])?
	}
	Some(cookie)
}

fun toString(c : NewCookie) -> String {
	let out = String.builder()
	String.push(out, c.name)
	String.push(out, "=")
	String.push(out, c.value)
	for a in c.attributes {
		String.push(out, "; ")
		String.push(out, a)
	}
	String.build(out)
}

--- A name and a value, as a client sends them back in a `Cookie` header
--- (RFC 6265 §4.2.1): `cookie-pair = cookie-name "=" cookie-value`. Neither
--- `show` nor `debug` prints the value, since a cookie is often a session's
--- secret; `pairValue` returns it.
type CookiePair : !Debug = CookiePair { name : String, value : String }

instance Eq CookiePair {
	fun eq(a, b) = a.name == b.name && a.value == b.value
}

instance Show CookiePair {
	fun show(p) = "<cookie " + p.name + ">"
}

--- Returns the pair `name=value` for a request's `Cookie` header, or `None`
--- if `name` is not a token or `value` is not a cookie value. It is for the
--- side that sends `Cookie`, a client's; a server's `Set-Cookie` takes
--- `newSetCookie`.
fun pair(name : String, value : String) -> Option CookiePair =
	if Syntax.isToken(name) && isCookieValue(value) {
		Some(CookiePair { name, value })
	} else {
		None
	}

--- Returns the pairs in `text`, a `Cookie` header's value, for the side that
--- receives it, a server's. It is lenient, as servers are in practice:
--- pairs are split at `;`, whitespace around each is dropped, and any text
--- that is not a pair is skipped, so one bad cookie does not lose the rest.
--- The empty text is no pairs. A client writes the header with
--- `pairsToString`.
---
--- cookie-string = cookie-pair *( ";" SP cookie-pair )
fun parsePairs(text : String) -> Array CookiePair {
	var pairs = []
	for part in String.split(text, ";") {
		let kept = String.trim(part)
		if let Some((name, value)) = String.splitOnce(kept, "=") {
			if let Some(p) = pair(name, value) {
				pairs = pairs + [p]
			}
		}
	}
	pairs
}

--- Returns `pairs` as the text of one `Cookie` header, joined with `"; "`, for
--- the side that sends it, a client's. A server reads the text back with
--- `parsePairs`.
fun pairsToString(pairs : Array CookiePair) -> String =
	String.join(Array.map(pairs, fun(p) = p.name + "=" + p.value), "; ")

--- Returns the name of `p`.
fun pairName(p : CookiePair) -> String = p.name
--- Returns the value of `p`.
fun pairValue(p : CookiePair) -> String = p.value

fun name(c : NewCookie) -> String = c.name
fun value(c : NewCookie) -> String = c.value
fun attributes(c : NewCookie) -> Array String = c.attributes

-- cookie-value = *cookie-octet / ( DQUOTE *cookie-octet DQUOTE )
fun isCookieValue(s : String) -> Bool {
	let inner = match String.stripPrefix(s, "\"") {
		Some(rest) -> match String.stripSuffix(rest, "\"") {
			Some(inside) -> inside
			None         -> return False
		}
		None -> s
	}
	for b in String.toBytes(inner) {
		if !isCookieOctet(Byte.toInt(b)) { return False }
	}
	True
}

-- cookie-octet = %x21 / %x23-2B / %x2D-3A / %x3C-5B / %x5D-7E: visible ASCII
-- without `"`, `,`, `;` and `\`.
fun isCookieOctet(b : Int) -> Bool =
	b >= 0x21 && b <= 0x7E && b != 0x22 && b != 0x2C && b != 0x3B && b != 0x5C

-- cookie-av: any CHAR except CTLs or ";". Not empty, and not starting or
-- ending with a space, which would not survive being read again.
fun isAttribute(s : String) -> Bool {
	let n = String.byteLength(s)
	if n == 0 || Syntax.byteAt(s, 0) == 0x20 || Syntax.byteAt(s, n - 1) == 0x20 { return False }
	for b in String.toBytes(s) {
		let x = Byte.toInt(b)
		if x < 0x20 || x >= 0x7F || x == 0x3B { return False }
	}
	True
}
