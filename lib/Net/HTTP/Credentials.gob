export (Credentials, bearer, basic, parse, toString, scheme, bearerToken, basicPair)

-- What an `Authorization` header carries (RFC 9110 §11.4): a scheme, and the
-- scheme's own data.
--
--     header(Authorization, Option.expect(Credentials.bearer(token), "a token68"))
--
-- Credentials never show: `show` gives `<credentials>`, so a request that is
-- printed or logged does not leak them, and the header value they are
-- written as is marked sensitive.

import Net.HTTP.Syntax as Syntax

-- `scheme` is lowercase, since schemes are case-insensitive. `data` is the
-- rest of the field after the space that ends the scheme: a token68 or a list
-- of parameters, as the scheme defines.
type Credentials = Credentials { scheme : String, data : String }

instance Eq Credentials { fun eq(a, b) = a.scheme == b.scheme && a.data == b.data }
instance Show Credentials { fun show(c) = "<credentials>" }

-- Returns bearer credentials (RFC 6750) for `token`, which must be a
-- token68: letters, digits and `-._~+/`, then perhaps some `=`.
fun bearer(token : String) -> Option Credentials =
    if isToken68(token) { Some(Credentials { scheme = "bearer", data = token }) } else { None }

-- Returns basic credentials (RFC 7617) for a user and password, encoded as
-- UTF-8 and then base64. Returns `None` if `user` holds a colon, which would
-- end it early, or either holds a control byte.
fun basic(user : String, password : String) -> Option Credentials {
    if String.contains(user, ":") || hasControl(user) || hasControl(password) { return None }
    Some(Credentials { scheme = "basic", data = base64(user + ":" + password) })
}

-- credentials = auth-scheme [ 1*SP ( token68 / #auth-param ) ]
--
-- The data after the scheme is checked to be a field value, and is kept as
-- it is; reading it is the scheme's business, as `bearerToken` and
-- `basicPair` do.
fun parse(text : String) -> Option Credentials {
    let c = Syntax.cursor(text)
    let scheme = Syntax.asciiLower(Syntax.token(c)?)
    if Syntax.atEnd(c) { return Some(Credentials { scheme, data = "" }) }
    Syntax.expect(c, 0x20)?
    while Syntax.peek(c) == 0x20 { Syntax.advance(c) }
    let data = Syntax.rest(c)
    if data == "" || !Syntax.isFieldValue(data) { return None }
    Some(Credentials { scheme, data })
}

-- Returns the credentials as they are written in the header.
fun toString(c : Credentials) -> String = if c.data == "" { schemeName(c.scheme) } else { schemeName(c.scheme) + " " + c.data }

-- The two schemes this module builds are written with their registered
-- capitalization; any other as it was read, lowercased.
fun schemeName(s : String) -> String = match s {
    "bearer" -> "Bearer"
    "basic" -> "Basic"
    _ -> s
}

fun scheme(c : Credentials) -> String = c.scheme

fun bearerToken(c : Credentials) -> Option String =
    if c.scheme == "bearer" && isToken68(c.data) { Some(c.data) } else { None }

-- Returns the user and password of basic credentials.
fun basicPair(c : Credentials) -> Option (String, String) {
    if c.scheme != "basic" { return None }
    let decoded = unbase64(c.data)?
    String.splitOnce(decoded, ":")
}

-- token68 = 1*( ALPHA / DIGIT / "-" / "." / "_" / "~" / "+" / "/" ) *"="
fun isToken68(s : String) -> Bool {
    let n = String.byteLength(s)
    var i = 0
    while i < n && isToken68Byte(Syntax.byteAt(s, i)) { i = i + 1 }
    if i == 0 { return False }
    while i < n && Syntax.byteAt(s, i) == 0x3D { i = i + 1 }
    i == n
}

fun isToken68Byte(b : Int) -> Bool =
    (b >= 0x30 && b <= 0x39) || (b >= 0x41 && b <= 0x5A) || (b >= 0x61 && b <= 0x7A)
        || b == 0x2D || b == 0x2E || b == 0x5F || b == 0x7E || b == 0x2B || b == 0x2F

fun hasControl(s : String) -> Bool {
    for b in String.toBytes(s) {
        let n = Byte.toInt(b)
        if n < 0x20 || n == 0x7F { return True }
    }
    False
}

let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

-- RFC 4648 §4, with padding.
fun base64(s : String) -> String {
    let bytes = String.bytesOf(s)
    let n = len(bytes)
    let out = String.builder()
    var i = 0
    while i < n {
        let b0 = Byte.toInt(bytes[i])
        let b1 = if i + 1 < n { Byte.toInt(bytes[i + 1]) } else { 0 }
        let b2 = if i + 2 < n { Byte.toInt(bytes[i + 2]) } else { 0 }
        let group = (b0 << 16) | (b1 << 8) | b2
        String.push(out, sextet(group >> 18))
        String.push(out, sextet(group >> 12))
        String.push(out, if i + 1 < n { sextet(group >> 6) } else { "=" })
        String.push(out, if i + 2 < n { sextet(group) } else { "=" })
        i = i + 3
    }
    String.build(out)
}

fun sextet(n : Int) -> String = Syntax.sliceBytes(alphabet, n & 63, (n & 63) + 1)

-- Returns the text `s` encodes in padded base64, or `None` if `s` is not
-- that or the bytes are not UTF-8.
fun unbase64(s : String) -> Option String {
    let n = String.byteLength(s)
    if n % 4 != 0 { return None }
    let out = []
    for var i = 0; i < n; i = i + 4 {
        var group = 0
        var padding = 0
        for var k = 0; k < 4; k = k + 1 {
            let b = Syntax.byteAt(s, i + k)
            if b == 0x3D && i + 4 == n && k >= 2 {
                padding = padding + 1
                group = group << 6
            } else if padding > 0 {
                return None
            } else {
                group = (group << 6) | sextetValue(b)?
            }
        }
        Vec.push(out, Byte.truncate(group >> 16))
        if padding < 2 { Vec.push(out, Byte.truncate(group >> 8)) }
        if padding < 1 { Vec.push(out, Byte.truncate(group)) }
    }
    String.fromBytes(out)
}

fun sextetValue(b : Int) -> Option Int =
    if b >= 0x41 && b <= 0x5A { Some(b - 0x41) }
    else if b >= 0x61 && b <= 0x7A { Some(b - 0x61 + 26) }
    else if b >= 0x30 && b <= 0x39 { Some(b - 0x30 + 52) }
    else if b == 0x2B { Some(62) }
    else if b == 0x2F { Some(63) }
    else { None }
