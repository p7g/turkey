export (HeaderValue, parse, literal, toString, sensitive, isSensitive)

-- The value of a header field, as it is sent: visible bytes, with spaces and
-- tabs between them but not around them (RFC 9110 §5.5).
--
-- **Invalid values are refused, never repaired.** CR and LF would end the
-- field and start another, and NUL ends a string in C code down the line, so
-- a value holding one is an injection, not a typo; turning it into a space
-- (as the RFC lets a recipient do) would hide that. Every other control byte
-- and DEL are refused too. This holds for values a program writes as well as
-- those that arrive: an outgoing value is checked as strictly as an incoming
-- one.
--
-- **Sensitive values.** A value marked `sensitive`, as credentials are, shows
-- as `<sensitive>`, so printing a request or its headers does not print a
-- password. The mark is also what tells an HTTP/2 encoder never to index the
-- value.

import Net.HTTP.Error (HeaderError(..))
import Net.HTTP.Syntax as Syntax

type HeaderValue = HeaderValue { text : String, isSensitive : Bool }

-- Values compare by their text; whether either is marked does not matter.
instance Eq HeaderValue { fun eq(a, b) = a.text == b.text }

instance Show HeaderValue {
    fun show(v) = if v.isSensitive { "<sensitive>" } else { v.text }
}

fun parse(s : String) -> Either HeaderError HeaderValue =
    if Syntax.isFieldValue(s) { Right(HeaderValue { text = s, isSensitive = False }) }
    else { Left(InvalidValue) }

-- Returns `s` as a header value, and panics if it is not one: a value written
-- in the program's source that is invalid is a mistake in the program.
fun literal(s : String) -> HeaderValue = match parse(s) {
    Right(v) -> v
    Left(_) -> error("invalid header value literal '" + Syntax.escaped(s) + "'")
}

-- Returns the value's text, as it is sent. A sensitive value's text too: this
-- is how it is written to the wire.
fun toString(v : HeaderValue) -> String = v.text

-- Returns `v` marked sensitive.
fun sensitive(v : HeaderValue) -> HeaderValue = HeaderValue { text = v.text, isSensitive = True }

fun isSensitive(v : HeaderValue) -> Bool = v.isSensitive
