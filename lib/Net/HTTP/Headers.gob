export (
    Header(..), Multiplicity(..), HasHeaders(..), Headers,
    empty, fromFields, fields, size, has, add, set, remove, get, getAll, one, header,
    Accept(..), ContentType(..), Authorization(..), IdempotencyKey(..), Location(..),
    RetryAfter(..), Retry(..), SetCookie(..),
)

-- Header fields, typed.
--
--     let hs = Headers.add(Headers.empty, ContentType, MediaType.json)
--     Headers.get(hs, ContentType)            -- Some(application/json)
--     Headers.get(hs, HeaderName.literal("content-type"))
--                                             -- Some(application/json), as text
--
-- **A header is a type.** Each field the library knows is a type with an
-- instance of `Header`, which says the field's name, the type of its value,
-- and how that value is read from and written as text: `ContentType` holds a
-- `MediaType` and `Authorization` holds `Credentials`. A `HeaderName` is a
-- header too, whose value is the `HeaderValue` text, for any field the
-- library has no type for.
--
-- **The reserved fields have no type and no name.** Content-Length,
-- Transfer-Encoding, Host and the rest frame and route a message, and the
-- library writes them from the request or response itself. There is no
-- instance of `Header` for them, and `HeaderName.parse` refuses their names,
-- so `Headers` cannot hold one.
--
-- **Order and multiplicity are kept.** `Headers` is the fields in the order
-- they were added or arrived, each once per line, and nothing is ever joined:
-- two `Set-Cookie` fields stay two, as RFC 6265 requires, since an `Expires`
-- date has a comma in it. A field written as a comma-separated list is split
-- into its elements when it is read, where its header says it is one.
--
-- **Values are stored as text.** Each field is held as its name and the
-- `HeaderValue` its value is written as, and a typed value is read from that
-- text when it is asked for. So a field that arrived off the wire and one a
-- program added are the same thing, and `get` with a `HeaderName` sees typed
-- fields as the text they are sent as. A typed value is written when it is
-- added, so the text it would be sent as is checked then.
--
-- `Headers` is immutable: `add`, `set` and `remove` return new headers. A
-- message's headers are a few dozen fields, so each copy is small, and a
-- request built with `|>` cannot change a request shared with anyone else.

import Net.HTTP.Credentials as Credentials (Credentials)
import Net.HTTP.Date as Date
import Net.HTTP.Error (FromHTTP(..), HTTPError(..), HeaderError(..))
import Net.HTTP.HeaderName as HeaderName (HeaderName)
import Net.HTTP.HeaderValue as HeaderValue (HeaderValue)
import Net.HTTP.MediaType as MediaType (MediaType)
import Net.HTTP.Cookie as Cookie (NewCookie)
import Net.HTTP.Syntax as Syntax
import Net.HTTP.Token as Token (Token)
import Time.Duration as Duration (Duration)
import Time.Instant (Instant)
import URL as URL (Reference)

-- A header field the library knows the meaning of.
--
-- `readValue` returns `None` for text that is not a value of the field. An
-- instance's `writeValue` must return text that `readValue` reads back as
-- the same value, which the library relies on: a field is stored as the text
-- it is written as.
class Header h {
    type Value h
    fun headerName(h) -> HeaderName
    fun readValue(h, HeaderValue) -> Option (Value h)
    fun writeValue(h, Value h) -> HeaderValue
    fun multiplicity(h) -> Multiplicity
}

-- How many values a field has, and how they are spread across lines.
--
-- * `Single`: one value, on one line. A second line is a duplicate.
-- * `CommaSeparated`: a list (RFC 9110 §5.6.1). Each line holds one or more
--   elements separated by commas, and any number of lines are one list.
--   `writeValue` writes one element.
-- * `OnePerLine`: each line is one value, never split at commas. That is
--   Set-Cookie, and any field read by its `HeaderName`, whose grammar the
--   library does not know.
type Multiplicity = Single | CommaSeparated | OnePerLine

-- A message with headers, which `header` adds to.
class HasHeaders m {
    fun headers(m) -> Headers
    fun withHeaders(m, Headers) -> m
}

-- Returns a function that adds the field `h: v` to a message, for building
-- one in a pipeline:
--
--     request(GET, url) |> header(Accept, MediaType.json) |> header(h, v)
--
-- It adds, never replaces, as `add` does.
fun header[HasHeaders m, Header h](h : h, v : Value h) -> fun(m) -> m =
    fun(message) = withHeaders(message, add(headers(message), h, v))

type Field = Field(HeaderName, HeaderValue)

type Headers = Headers(Array Field)

-- One field per line, `name: value`, a sensitive value hidden.
instance Show Headers {
    fun show(Headers(fs)) = String.join(Array.map(fs, fun(Field(n, v)) = show(n) + ": " + show(v)), "\n")
}

let empty = Headers([])

-- Returns headers holding `fields` in order. A codec that has read a
-- message's fields builds its headers with this.
fun fromFields(fields : Array (HeaderName, HeaderValue)) -> Headers =
    Headers(Array.map(fields, fun((n, v)) = Field(n, v)))

-- Returns every field, in order, as it is sent.
fun fields(Headers(fs)) -> Array (HeaderName, HeaderValue) = Array.map(fs, fun(Field(n, v)) = (n, v))

-- Returns the number of lines.
fun size(Headers(fs)) -> Int = len(fs)

fun has[Header h](hs : Headers, h : h) -> Bool = len(lines(hs, headerName(h))) > 0

-- Returns `hs` with the field `h: v` after its other fields.
fun add[Header h](Headers(fs) : Headers, h : h, v : Value h) -> Headers =
    Headers(fs + [Field(headerName(h), writeValue(h, v))])

-- Returns `hs` with every `h` field replaced by the one field `h: v`, where
-- the first of them was, or after the other fields if there was none.
fun set[Header h](Headers(fs) : Headers, h : h, v : Value h) -> Headers {
    let name = headerName(h)
    let out = []
    var placed = False
    for Field(n, old) in fs {
        if n != name {
            Vec.push(out, Field(n, old))
        } else if !placed {
            Vec.push(out, Field(name, writeValue(h, v)))
            placed = True
        }
    }
    if !placed { Vec.push(out, Field(name, writeValue(h, v))) }
    Headers(Vec.toArray(out))
}

-- Returns `hs` without its `h` fields.
fun remove[Header h](Headers(fs) : Headers, h : h) -> Headers {
    let name = headerName(h)
    Headers(Array.filter(fs, fun(Field(n, _)) = n != name))
}

-- Returns the first value of `h`, or `None` if there is none or it does not
-- read. Where a second value would be an error, `one` says so.
fun get[Header h](hs : Headers, h : h) -> Option (Value h) {
    let found = elements(hs, h)
    if len(found) == 0 { None } else { readValue(h, found[0]) }
}

-- Returns every value of `h` that reads, in order: each line's, or for a
-- comma-separated field each element of each line. One that does not read
-- is left out.
fun getAll[Header h](hs : Headers, h : h) -> Array (Value h) {
    let out = []
    for v in elements(hs, h) {
        if let Some(x) = readValue(h, v) { Vec.push(out, x) }
    }
    Vec.toArray(out)
}

-- Returns the value of `h`, or `None` if there is none. More than one value
-- is an error, `DuplicateField`, as is one that does not read,
-- `UnreadableValue`: where a field must be single, two readers that each
-- took a different one of two values would disagree about the message.
fun one[Header h, FromHTTP e](hs : Headers, h : h) -> Either e (Option (Value h)) {
    let found = elements(hs, h)
    let name = HeaderName.toString(headerName(h))
    if len(found) > 1 { return Left(fromHTTP(BadHeader(DuplicateField(name)))) }
    if len(found) == 0 { return Right(None) }
    match readValue(h, found[0]) {
        Some(x) -> Right(Some(x))
        None -> Left(fromHTTP(BadHeader(UnreadableValue(name))))
    }
}

-- Returns the text of each line named `name`, in order.
fun lines(Headers(fs) : Headers, name : HeaderName) -> Array HeaderValue {
    let out = []
    for Field(n, v) in fs {
        if n == name { Vec.push(out, v) }
    }
    Vec.toArray(out)
}

-- Returns the values of `h` as text: its lines, or, for a comma-separated
-- field, the elements of its lines. An element keeps its line's sensitive
-- mark. A line whose list does not split (a quoted string left open) gives
-- itself whole, which then does not read.
fun elements[Header h](hs : Headers, h : h) -> Array HeaderValue {
    let found = lines(hs, headerName(h))
    match multiplicity(h) {
        Single | OnePerLine -> found
        CommaSeparated -> {
            let out = []
            for v in found {
                match Syntax.listItems(HeaderValue.toString(v)) {
                    Some(items) -> for item in items { Vec.push(out, sameMark(v, item)) }
                    None -> Vec.push(out, v)
                }
            }
            Vec.toArray(out)
        }
    }
}

-- Returns `text`, an element of the valid value `line`, as a value marked as
-- `line` is. An element of a field value, trimmed, is a field value itself.
fun sameMark(line : HeaderValue, text : String) -> HeaderValue {
    let v = HeaderValue.literal(text)
    if HeaderValue.isSensitive(line) { HeaderValue.sensitive(v) } else { v }
}

-- Returns `text` as a value. Every caller writes text from a value whose type
-- guarantees it is a valid field value, so a refusal here is a bug in that
-- type, not bad input.
fun written(text : String) -> HeaderValue = HeaderValue.literal(text)

-- -- Any field, by its name ----------------------------------------------------

instance Header HeaderName {
    type Value = HeaderValue
    fun headerName(n) = n
    fun readValue(n, v) = Some(v)
    fun writeValue(n, v) = v
    fun multiplicity(n) = OnePerLine
}

-- -- Typed headers -------------------------------------------------------------

-- `Accept` (RFC 9110 §12.5.1): the media types a response may have, each a
-- range such as `text/*` with perhaps a `q` weight.
type Accept = Accept

instance Header Accept {
    type Value = MediaType
    fun headerName(h) = HeaderName.literal("accept")
    fun readValue(h, v) = MediaType.parse(HeaderValue.toString(v))
    fun writeValue(h, m) = written(MediaType.toString(m))
    fun multiplicity(h) = CommaSeparated
}

-- `Content-Type` (RFC 9110 §8.3): what the body is.
type ContentType = ContentType

instance Header ContentType {
    type Value = MediaType
    fun headerName(h) = HeaderName.literal("content-type")
    fun readValue(h, v) = MediaType.parse(HeaderValue.toString(v))
    fun writeValue(h, m) = written(MediaType.toString(m))
    fun multiplicity(h) = Single
}

-- `Authorization` (RFC 9110 §11.6.2). Its value is written marked sensitive,
-- so it does not show.
type Authorization = Authorization

instance Header Authorization {
    type Value = Credentials
    fun headerName(h) = HeaderName.literal("authorization")
    fun readValue(h, v) = Credentials.parse(HeaderValue.toString(v))
    fun writeValue(h, c) = HeaderValue.sensitive(written(Credentials.toString(c)))
    fun multiplicity(h) = Single
}

-- `Idempotency-Key`: a key that makes a request safe to send again, since a
-- server that has seen the key once does not act on it twice. Its value is a
-- token, written as a structured-field string, `"8e03978e"`.
type IdempotencyKey = IdempotencyKey

instance Header IdempotencyKey {
    type Value = Token
    fun headerName(h) = HeaderName.literal("idempotency-key")
    fun readValue(h, v) {
        let c = Syntax.cursor(HeaderValue.toString(v))
        let key = Syntax.quotedString(c)?
        if Syntax.atEnd(c) { Token.parse(key) } else { None }
    }
    fun writeValue(h, t) = written("\"" + Token.toString(t) + "\"")
    fun multiplicity(h) = Single
}

-- `Location` (RFC 9110 §10.2.2): where a redirect points, or what a request
-- created. It may be relative, and is then read against the request's URL.
type Location = Location

instance Header Location {
    type Value = Reference
    fun headerName(h) = HeaderName.literal("location")
    fun readValue(h, v) = Either.right(URL.parseReference(HeaderValue.toString(v)))
    fun writeValue(h, r) = written(show(r))
    fun multiplicity(h) = Single
}

-- `Retry-After` (RFC 9110 §10.2.3): how long to wait before trying again.
type RetryAfter = RetryAfter

-- A wait, as a length or as the time it ends. A negative or fractional length
-- is written as whole seconds rounded towards zero and at least 0: the field
-- has no other spelling, and a wait already over is a wait of 0.
type Retry = RetryIn(Duration) | RetryAt(Instant)

instance Eq Retry {
    fun eq(a, b) = match (a, b) {
        (RetryIn(x), RetryIn(y)) -> Duration.toNanos(x) == Duration.toNanos(y)
        (RetryAt(x), RetryAt(y)) -> x == y
        _ -> False
    }
}

instance Show Retry {
    fun show(r) = match r {
        RetryIn(d) -> "RetryIn(" + show(d) + ")"
        RetryAt(t) -> "RetryAt(" + show(t) + ")"
    }
}

instance Header RetryAfter {
    type Value = Retry
    fun headerName(h) = HeaderName.literal("retry-after")
    fun readValue(h, v) {
        let text = HeaderValue.toString(v)
        if let Some(seconds) = delaySeconds(text) { return Some(RetryIn(Duration.seconds(seconds))) }
        Option.map(Date.parse(text), RetryAt)
    }
    fun writeValue(h, r) = match r {
        RetryIn(d) -> {
            let seconds = Duration.toSeconds(d)
            written(Int.toString(if seconds < 0 { 0 } else { seconds }))
        }
        RetryAt(t) -> written(Date.toString(t))
    }
    fun multiplicity(h) = Single
}

-- delay-seconds = 1*DIGIT, at most 18 digits so that it cannot overflow.
fun delaySeconds(text : String) -> Option Int {
    let n = String.byteLength(text)
    if n == 0 || n > 18 { return None }
    var value = 0
    for var i = 0; i < n; i = i + 1 {
        let d = Syntax.byteAt(text, i) - 0x30
        if d < 0 || d > 9 { return None }
        value = value * 10 + d
    }
    Some(value)
}

-- `Set-Cookie` (RFC 6265 §4.1): one cookie per field, the fields never
-- joined.
type SetCookie = SetCookie

instance Header SetCookie {
    type Value = NewCookie
    fun headerName(h) = HeaderName.literal("set-cookie")
    fun readValue(h, v) = Cookie.parse(HeaderValue.toString(v))
    fun writeValue(h, c) = written(Cookie.toString(c))
    fun multiplicity(h) = OnePerLine
}
