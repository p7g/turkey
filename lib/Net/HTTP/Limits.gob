export (
    Limits, defaults,
    headBytes, fields, lineBytes, chunkLineBytes, trailerBytes, drainBytes,
    withHeadBytes, withFields, withLineBytes, withChunkLineBytes, withTrailerBytes, withDrainBytes,
)

-- How much of a peer's message HTTP reads before it refuses or gives up.
--
--     let l = Limits.withHeadBytes(Limits.defaults, 32768)
--
-- `Limits` is abstract and built from `defaults` with the `with...`
-- functions, so that a limit can be added without breaking a program that
-- sets the others. Each setter panics on a limit below 1: a limit of none
-- would make every message refused, which is a mistake in the program.
--
-- | limit            | default | what is over it                          |
-- |------------------|---------|------------------------------------------|
-- | `headBytes`      | 16 KiB  | a head, refused with 431                 |
-- | `fields`         | 100     | field lines in a head, refused with 431  |
-- | `lineBytes`      | 8 KiB   | a request line, refused with 414         |
-- | `chunkLineBytes` | 1 KiB   | a chunk-size line with its extensions    |
-- | `trailerBytes`   | 4 KiB   | the trailer fields after a chunked body  |
-- | `drainBytes`     | 256 KiB | an unread body, discarded to keep the    |
-- |                  |         | connection open; a longer one closes it  |
--
-- Each byte count includes the CRLFs. The chunk-line limit is what keeps a
-- peer from sending a gigabyte of chunk extensions, which no reader looks at.
-- A chunk size also has at most 16 hex digits whatever the limits, since a
-- longer one cannot be a length.

type Limits = Limits {
    headBytes : Int,
    fields : Int,
    lineBytes : Int,
    chunkLineBytes : Int,
    trailerBytes : Int,
    drainBytes : Int,
}

let defaults = Limits {
    headBytes = 16384,
    fields = 100,
    lineBytes = 8192,
    chunkLineBytes = 1024,
    trailerBytes = 4096,
    drainBytes = 262144,
}

fun headBytes(l : Limits) -> Int = l.headBytes
fun fields(l : Limits) -> Int = l.fields
fun lineBytes(l : Limits) -> Int = l.lineBytes
fun chunkLineBytes(l : Limits) -> Int = l.chunkLineBytes
fun trailerBytes(l : Limits) -> Int = l.trailerBytes
fun drainBytes(l : Limits) -> Int = l.drainBytes

fun withHeadBytes(l : Limits, n : Int) -> Limits {
    let Limits { headBytes = _, fields, lineBytes, chunkLineBytes, trailerBytes, drainBytes } = l
    Limits { headBytes = positive("withHeadBytes", n), fields, lineBytes, chunkLineBytes, trailerBytes,
             drainBytes }
}

fun withFields(l : Limits, n : Int) -> Limits {
    let Limits { headBytes, fields = _, lineBytes, chunkLineBytes, trailerBytes, drainBytes } = l
    Limits { headBytes, fields = positive("withFields", n), lineBytes, chunkLineBytes, trailerBytes,
             drainBytes }
}

fun withLineBytes(l : Limits, n : Int) -> Limits {
    let Limits { headBytes, fields, lineBytes = _, chunkLineBytes, trailerBytes, drainBytes } = l
    Limits { headBytes, fields, lineBytes = positive("withLineBytes", n), chunkLineBytes, trailerBytes,
             drainBytes }
}

fun withChunkLineBytes(l : Limits, n : Int) -> Limits {
    let Limits { headBytes, fields, lineBytes, chunkLineBytes = _, trailerBytes, drainBytes } = l
    Limits { headBytes, fields, lineBytes, chunkLineBytes = positive("withChunkLineBytes", n),
             trailerBytes, drainBytes }
}

fun withTrailerBytes(l : Limits, n : Int) -> Limits {
    let Limits { headBytes, fields, lineBytes, chunkLineBytes, trailerBytes = _, drainBytes } = l
    Limits { headBytes, fields, lineBytes, chunkLineBytes, trailerBytes = positive("withTrailerBytes", n),
             drainBytes }
}

fun withDrainBytes(l : Limits, n : Int) -> Limits {
    let Limits { headBytes, fields, lineBytes, chunkLineBytes, trailerBytes, drainBytes = _ } = l
    Limits { headBytes, fields, lineBytes, chunkLineBytes, trailerBytes,
             drainBytes = positive("withDrainBytes", n) }
}

fun positive(setter : String, n : Int) -> Int {
    if n < 1 { error("Limits." + setter + ": limit " + Int.toString(n) + " is below 1") }
    n
}
