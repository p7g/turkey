export (
    MediaType, parse, literal, read, toString, mainType, subtype, essence, parameter, parameters,
    withParameter, matches,
    json, eventStream, plainText, html, formURLEncoded, octetStream, any,
)

--- A media type (RFC 9110 §8.3.1): `text/html; charset=utf-8`, what a
--- `Content-Type` says a body is, and what an `Accept` asks for.
---
--- The type, the subtype and parameter names are case-insensitive, and are
--- stored lowercase. Parameter values keep their case, since some are
--- case-sensitive, and are held unquoted: `parameter(m, "charset")` of
--- `text/plain; charset="utf-8"` is `utf-8`. `toString` quotes a value only
--- where a token cannot spell it.
---
--- Media ranges, as `Accept` writes them, are media types too: `*` is a
--- token, so `*/*` and `text/*` parse, and `q` is a parameter like any other.

import Net.HTTP.Syntax as Syntax

type MediaType = MediaType { mainType : String, subtype : String, parameters : Array (String, String) }

--- Two media types are equal when their types, subtypes and parameters are,
--- the parameters in order.
instance Eq MediaType {
    fun eq(a, b) = toString(a) == toString(b)
}

instance Show MediaType { fun show(m) = toString(m) }

let json = MediaType { mainType = "application", subtype = "json", parameters = [] }
let eventStream = MediaType { mainType = "text", subtype = "event-stream", parameters = [] }
let plainText = MediaType { mainType = "text", subtype = "plain", parameters = [("charset", "utf-8")] }
let html = MediaType { mainType = "text", subtype = "html", parameters = [("charset", "utf-8")] }
let formURLEncoded = MediaType {
    mainType = "application", subtype = "x-www-form-urlencoded", parameters = []
}
let octetStream = MediaType { mainType = "application", subtype = "octet-stream", parameters = [] }

--- `*/*`, the range that matches every media type.
let any = MediaType { mainType = "*", subtype = "*", parameters = [] }

--- media-type = type "/" subtype parameters
fun parse(s : String) -> Option MediaType {
    let c = Syntax.cursor(s)
    let m = read(c)?
    if Syntax.atEnd(c) { Some(m) } else { None }
}

--- Returns the media type `text` writes, and panics if it writes none.
fun literal(text : String) -> MediaType = match parse(text) {
    Some(m) -> m
    None -> error("invalid media type literal '" + Syntax.escaped(text) + "'")
}

--- Reads a media type at the cursor, and leaves the cursor after it. This is
--- for the fields that hold a media type among other things; `parse` reads
--- one that is all of its text.
---
--- parameters = *( OWS ";" OWS [ parameter ] )
--- parameter = name "=" ( token / quoted-string )
---
--- A parameter named twice is refused: which one counts is not defined, and
--- two readers that choose differently disagree about the body.
fun read(c : Syntax.Cursor) -> Option MediaType {
    let mainType = Syntax.asciiLower(Syntax.token(c)?)
    Syntax.expect(c, 0x2F)?
    let subtype = Syntax.asciiLower(Syntax.token(c)?)
    -- The annotation is needed: left to inference, this literal, the `?`
    -- above it and the tuple pattern in the loop below make the compiler
    -- stop with an internal error.
    let parameters : Vec (String, String) = []
    loop {
        let before = c.at
        Syntax.skipSpace(c)
        if Syntax.peek(c) != 0x3B {
            c.at = before
            break
        }
        Syntax.advance(c)
        Syntax.skipSpace(c)
        if Syntax.isTokenByte(Syntax.peek(c)) {
            let name = Syntax.asciiLower(Syntax.token(c)?)
            Syntax.expect(c, 0x3D)?
            let value = Syntax.tokenOrQuoted(c)?
            for (seen, _) in parameters {
                if seen == name { return None }
            }
            Vec.push(parameters, (name, value))
        }
    }
    Some(MediaType { mainType, subtype, parameters = Vec.toArray(parameters) })
}

fun toString(m : MediaType) -> String {
    let out = String.builder()
    String.push(out, m.mainType)
    String.push(out, "/")
    String.push(out, m.subtype)
    for (name, value) in m.parameters {
        String.push(out, "; ")
        String.push(out, name)
        String.push(out, "=")
        String.push(out, if Syntax.isToken(value) { value } else { Syntax.quote(value) })
    }
    String.build(out)
}

fun mainType(m : MediaType) -> String = m.mainType
fun subtype(m : MediaType) -> String = m.subtype

--- Returns the type and subtype without parameters: `text/html`.
fun essence(m : MediaType) -> String = m.mainType + "/" + m.subtype

--- Returns the value of the parameter `name`, which is case-insensitive.
fun parameter(m : MediaType, name : String) -> Option String {
    let wanted = Syntax.asciiLower(name)
    for (n, value) in m.parameters {
        if n == wanted { return Some(value) }
    }
    None
}

fun parameters(m : MediaType) -> Array (String, String) = m.parameters

--- Returns `m` with the parameter `name` set to `value`, replacing one of that
--- name. Returns `None` if `name` is not a token, or `value` holds a byte a
--- quoted string cannot carry.
fun withParameter(m : MediaType, name : String, value : String) -> Option MediaType {
    if !Syntax.isToken(name) || !Syntax.canQuote(value) { return None }
    let lower = Syntax.asciiLower(name)
    let kept = Array.filter(m.parameters, fun((n, _)) = n != lower)
    Some(MediaType { mainType = m.mainType, subtype = m.subtype, parameters = kept + [(lower, value)] })
}

--- Whether the media range `range` matches `m` (RFC 9110 §12.5.1): `*/*`
--- matches everything, `text/*` every text type, and otherwise the essences
--- must be equal. Each of the range's parameters other than `q` must be one
--- `m` has.
fun matches(range : MediaType, m : MediaType) -> Bool {
    let typeMatches = range.mainType == "*" || range.mainType == m.mainType
    let subtypeMatches = range.subtype == "*" || range.subtype == m.subtype
    if !typeMatches || !subtypeMatches { return False }
    for (name, value) in range.parameters {
        if name != "q" && parameter(m, name) != Some(value) { return False }
    }
    True
}
