export (Method(..), MethodName, extension, name, isSafe, isIdempotent, body)

--- A request method, carrying the request's body where the method has one.
---
---     match req.method {
---         GET -> ...
---         POST(body) -> ...
---     }
---
--- The body is the method's payload, so a GET with a body cannot be written,
--- and a server's `match` takes the body out of the pattern that picks the
--- method. An extension method may or may not have one.

import Net.HTTP.Syntax as Syntax

type Method b =
    GET
    | HEAD
    | DELETE
    | OPTIONS
    | TRACE
    | CONNECT
    | POST(b)
    | PUT(b)
    | PATCH(b)
    | Extension(MethodName, Option b)

--- The name of an extension method: a token, case kept, that is not one of
--- the nine above. Refusing those keeps one spelling for each method, so
--- `Extension` cannot write a `GET` that carries a body.
type MethodName = MethodName(String)

instance Show MethodName { fun show(MethodName(s)) = s }

let standard = ["GET", "HEAD", "DELETE", "OPTIONS", "TRACE", "CONNECT", "POST", "PUT", "PATCH"]

--- Returns the extension method `s` names. Method names are case-sensitive,
--- so `get` is an extension method and `GET` is not.
fun extension(s : String) -> Option MethodName =
    if Syntax.isToken(s) && !Array.contains(standard, s) { Some(MethodName(s)) } else { None }

--- Returns the method's name as it is sent: `GET`, `POST`, ...
fun name(m : Method b) -> String = match m {
    GET -> "GET"
    HEAD -> "HEAD"
    DELETE -> "DELETE"
    OPTIONS -> "OPTIONS"
    TRACE -> "TRACE"
    CONNECT -> "CONNECT"
    POST(_) -> "POST"
    PUT(_) -> "PUT"
    PATCH(_) -> "PATCH"
    Extension(MethodName(s), _) -> s
}

--- Shows the name alone, never the body.
instance Show (Method b) { fun show(m) = name(m) }

--- Whether the method is safe (RFC 9110 §9.2.1): it asks only to read, so
--- sending it changes nothing on the server. An extension method is not known
--- to be.
fun isSafe(m : Method b) -> Bool = match m {
    GET | HEAD | OPTIONS | TRACE -> True
    _ -> False
}

--- Whether sending the request twice has the effect of sending it once
--- (RFC 9110 §9.2.2), which is what lets a client send it again after a
--- connection fails part-way.
fun isIdempotent(m : Method b) -> Bool = match m {
    GET | HEAD | OPTIONS | TRACE | PUT(_) | DELETE -> True
    _ -> False
}

fun body(m : Method b) -> Option b = match m {
    POST(b) | PUT(b) | PATCH(b) -> Some(b)
    Extension(_, b) -> b
    _ -> None
}

--- `map(m, f)` replaces the body, if the method has one, by `f` of it, and
--- leaves the method as it is: a codec turns `POST(bytes)` into
--- `POST(decoded)` without a `match` that names every method.
instance Functor Method {
    fun map(m, f) = match m {
        GET -> GET
        HEAD -> HEAD
        DELETE -> DELETE
        OPTIONS -> OPTIONS
        TRACE -> TRACE
        CONNECT -> CONNECT
        POST(b) -> POST(f(b))
        PUT(b) -> PUT(f(b))
        PATCH(b) -> PATCH(f(b))
        Extension(n, b) -> Extension(n, Option.map(b, f))
    }
}
