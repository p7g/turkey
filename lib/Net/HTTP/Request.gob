export (Request(..), ClientRequest(..), RequestTarget(..), Target(..), request, segments)

-- Requests, as a server receives them and as a client sends them: a method,
-- which carries the body, a target, and header fields.
--
-- **Two types.** A server's `Request` says what arrived: the path and query
-- it was sent to. A client's `ClientRequest` says where to send it: a URL.
-- They share `Method` and `Headers`, and `HasHeaders` builds either, but
-- their targets differ, and a received request will carry what only a
-- connection has, which a request being built has no value for.
--
-- **Records.** Both constructors are exported, and their fields are read and
-- built directly, because each field's type holds its own invariant: a
-- `Method` cannot put a body on a GET, and `Headers` cannot hold a field the
-- library writes itself. No combination of valid fields is an invalid
-- request.

import Net.HTTP.Headers as Headers (Headers, HasHeaders(..))
import Net.HTTP.HTTPURL as HTTPURL (HTTPURL)
import Net.HTTP.Method (Method)
import URL as URL (URLError)

-- A request a server received, routed by matching on it:
--
--     match (req.method, req.target.path) {
--         (GET, "/health") -> ...
--         (POST(body), "/orders") -> ...
--         _ -> ...
--     }
type Request b = Request { method : Method b, target : RequestTarget, headers : Headers }

instance HasHeaders (Request b) {
    fun headers(r) = r.headers
    fun withHeaders(r, hs) = Request { method = r.method, target = r.target, headers = hs }
}

-- A request a client is to send, built with `request` and `header`:
--
--     request(GET, "https://api.example.com/users/1")
--         |> header(Accept, MediaType.json)
--
-- `url` is the target already parsed. A `Left` is not sent: `send` reports
-- it as an error, so `request` itself never fails, and a URL written as a
-- literal needs no `?`.
type ClientRequest b = ClientRequest { method : Method b, url : Either URLError HTTPURL, headers : Headers }

instance HasHeaders (ClientRequest b) {
    fun headers(r) = r.headers
    fun withHeaders(r, hs) = ClientRequest { method = r.method, url = r.url, headers = hs }
}

-- What a client can send a request to: an `HTTPURL`, or a `String` that
-- writes one.
class Target t { fun httpURL(t) -> Either URLError HTTPURL }

instance Target HTTPURL { fun httpURL(u) = Right(u) }
instance Target String { fun httpURL(s) = HTTPURL.parse(s) }

-- Returns a request to `t` with no headers.
fun request[Target t](m : Method b, t : t) -> ClientRequest b =
    ClientRequest { method = m, url = httpURL(t), headers = Headers.empty }

-- The target of a request a server received, as the codec read it from the
-- request line and the `Host` field.
--
-- `path` is encoded, exactly as it arrived (`*` for `OPTIONS *`); `segments`
-- decodes it. `authority` is the host and port the request was sent to, from
-- `Host` or from an absolute-form target, which must agree. The strings are
-- the codec's checked input: nothing sends a `RequestTarget`, so a program
-- that builds one, to test a handler, cannot put it on the wire.
type RequestTarget = RequestTarget { authority : Option String, path : String, query : Option String }

-- Returns the path's segments, decoded: `/a%20b/c` is `["a b", "c"]`.
-- Returns `None` if a segment is not UTF-8 once decoded.
fun segments(t : RequestTarget) -> Option (Array String) {
    let body = Option.unwrapOr(String.stripPrefix(t.path, "/"), t.path)
    if body == "" { return Some([""]) }
    let out = []
    for part in String.split(body, "/") {
        Vec.push(out, URL.decode(part)?)
    }
    Some(Vec.toArray(out))
}
