export (Response(..), Timings(..))

-- A response a client received: its status, its header fields, its body,
-- which a client's callback reads as an `Incoming`, the URL it came from,
-- and how long each part of getting it took.
--
--     send(c, request(GET, url), Duration.seconds(10), fun(resp) = match resp.status {
--         OK -> receive(resp.body, 65536)
--         _ -> ...
--     })
--
-- A record whose constructor is exported, as `Request` is, since each
-- field's type holds its own invariant: `headers` holds no field that frames
-- the message, which the client read and took out.

import Net.HTTP.Headers as Headers (Headers, HasHeaders(..))
import Net.HTTP.HTTPURL (HTTPURL)
import Net.HTTP.Status (Status)
import Time.Duration (Duration)

-- `url` is the URL the response came from: the request's, or the last
-- redirect's when the client followed some.
type Response b = Response {
    status  : Status
    headers : Headers
    body    : b
    url     : HTTPURL
    timings : Timings
}

-- How long each part of one request took, on the connection its response
-- came over.
--
-- * `dns`, `connect` and `tls`: resolving the host, connecting to it, and
--   the TLS handshake. `None` for a connection taken from the pool, and
--   `tls` is `None` for `http`.
-- * `firstByte`: from starting to write the request to reading the first
--   byte of its response.
type Timings = Timings {
    dns       : Option Duration
    connect   : Option Duration
    tls       : Option Duration
    firstByte : Duration
}

instance HasHeaders (Response b) {
    fun headers(r) = r.headers
    fun setHeaders(r, hs) = Response {
        status = r.status
        headers = hs
        body = r.body
        url = r.url
        timings = r.timings
    }
}
