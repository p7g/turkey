export (
    ServerResponse, Reply(..), Outgoing(..),
    text, json, bytes, stream, noContent, notModified, switch, status, outgoing, contentType,
)

-- What a server sends in answer to a request: a status, header fields, and a
-- body, which `Net.HTTP.Server`'s `respond` writes.
--
--     (GET, "/health") -> respond(r, text(OK, "ok"))
--     (GET, "/events") -> respond(r, stream(OK, LengthUnknown, feed) |> header(ContentType, MediaType.eventStream))
--
-- **Abstract, where `ClientRequest` is a record.** A rule that fits inside
-- one field's type is kept by that type, so `ClientRequest b` exports its
-- constructor: a `Method` cannot put a body on a GET, and `Headers` cannot
-- hold a field the library writes. A response's rule spans two fields:
-- whether it may have a body depends on its status, since a 1xx, 204 or 304
-- response has none. No field's type can say that, so a response is made
-- only by the functions here, which check it, and a record would let a
-- program build one they refuse.
--
-- * `text`, `json`, `bytes` and `stream` have a body, and panic on a status
--   that cannot: a status written in a program that cannot carry its body is
--   a mistake in the program, as a bad literal is.
-- * `noContent()` is a 204, and `notModified()` a 304, with no body.
-- * `switch` is a 101 that hands the connection to another protocol.
-- * `reply(s)` of a `Status` is that status with an empty body.
-- * A 1xx other than 101 is not a response here. The server's `inform`
--   sends one, before the final response.
--
-- Header fields are added with `|> header(h, v)` or `withHeaders`. The
-- content type each constructor gives is used only if the program adds none
-- of its own, so `text(OK, page) |> header(ContentType, MediaType.html)`
-- sends one.
--
-- **A stream's function runs while `respond` writes,** after the head is on
-- the wire, so a failure in it can no longer change the status: the
-- connection is closed, and the client sees a body cut short. Its function
-- returns the trailers to send after the body, `Headers.empty` for none.

import Net.HTTP.Headers as Headers (Headers, HasHeaders(..), ContentType(..))
import Net.HTTP.Duplex (Duplex)
import Net.HTTP.MediaType as MediaType (MediaType)
import Net.HTTP.Status as Status (Status(NoContent, NotModified, OK, SwitchingProtocols))
import Net.HTTP.Stream (Stream(..), BodyLength, Sink)
import Net.HTTP.Token as Token (Token)
import Turkey.Buffer (Buffer(..))
import Turkey.Buffer as Buf

type ServerResponse = ServerResponse {
    code : Status,
    fields : Headers,
    -- The content type to send if `fields` has none.
    defaultType : Option MediaType,
    body : Outgoing,
}

-- A response's body, as the server writes it.
--
-- * `Empty`: no bytes. A 204 or 304 is framed as having no body at all;
--   anything else declares a length of 0.
-- * `Whole(b)`: the bytes of `b`.
-- * `Streamed(s)`: written by `s`'s function.
-- * `Switched(protocol, f)`: a 101 to `protocol`, then `f` with the
--   connection.
type Outgoing =
    Empty
    | Whole(Buffer)
    | Streamed(Stream)
    | Switched(Token, fun(Duplex) -> Either SomeError Unit)

instance HasHeaders ServerResponse {
    fun headers(r) = r.fields
    fun setHeaders(r, hs) = ServerResponse { code = r.code, fields = hs, defaultType = r.defaultType, body = r.body }
}

-- Returns the response's status.
fun status(r : ServerResponse) -> Status = r.code

-- Returns the response's body, for the server that writes it.
fun outgoing(r : ServerResponse) -> Outgoing = r.body

-- Returns the content type the response is sent with: its own field if it
-- has one, or else the one its constructor gave.
fun contentType(r : ServerResponse) -> Option MediaType = match Headers.get(r.fields, ContentType) {
    Some(t) -> Some(t)
    None -> r.defaultType
}

-- Panics unless a response with `s` may have a body.
fun bodied(s : Status, constructor : String) -> Status {
    let code = Status.code(s)
    if code / 100 == 1 || code == 204 || code == 304 {
        error("ServerResponse." + constructor + ": a " + Int.toString(code) + " response cannot have a body")
    }
    s
}

fun make(s : Status, t : Option MediaType, body : Outgoing) -> ServerResponse =
    ServerResponse { code = s, fields = Headers.empty, defaultType = t, body }

-- Returns a response of `s` with `body` as UTF-8 text, of type
-- `text/plain; charset=utf-8`.
fun text(s : Status, body : String) -> ServerResponse =
    make(bodied(s, "text"), Some(MediaType.plainText), Whole(Buf.bytesOf(body)))

-- Returns a response of `s` with `encoded`, a JSON document, as its body, of
-- type `application/json`.
fun json(s : Status, encoded : String) -> ServerResponse =
    make(bodied(s, "json"), Some(MediaType.json), Whole(Buf.bytesOf(encoded)))

-- Returns a response of `s` with the bytes of `body`'s window, of type
-- `application/octet-stream`. The response keeps `body`, which must not be
-- changed until it is sent.
fun bytes(s : Status, body : Buffer) -> ServerResponse =
    make(bodied(s, "bytes"), Some(MediaType.octetStream), Whole(body))

-- Returns a response of `s` whose body `write` writes, `length` bytes of
-- it, once the head is sent, and whose trailers it returns. For a response
-- to HEAD, `write` is never called. The response has no default content
-- type.
fun stream(s : Status, length : BodyLength, write : fun(Sink) -> Either SomeError Headers) -> ServerResponse =
    make(bodied(s, "stream"), None, Streamed(Stream(length, write)))

-- Returns a 204 response, which has no body.
fun noContent() -> ServerResponse = make(NoContent, None, Empty)

-- Returns a 304 response, which has no body. Add the fields a 200 would have
-- had, `ETag` among them, with `header`.
fun notModified() -> ServerResponse = make(NotModified, None, Empty)

-- Returns a response that switches the connection to `protocol`: a 101 with
-- `headers`, and `Upgrade` and `Connection` written by the server. Once it is
-- sent, `run` has the connection as a `Duplex` until it returns, and then
-- the connection is closed.
--
-- A request whose `Upgrade` field does not offer `protocol`, or that does
-- not let its connection be switched (an HTTP/1.0 request, or one whose body
-- could not be read to its end), gets a 500 instead, and the server reports
-- it to `onError`: a 101 that the client did not ask for is a mistake in the
-- handler.
fun switch(protocol : Token, headers : Headers, run : fun(Duplex) -> Either SomeError Unit) -> ServerResponse =
    ServerResponse {
        code = SwitchingProtocols, fields = headers, defaultType = None, body = Switched(protocol, run),
    }

-- -- replies ----------------------------------------------------------------------------

-- What `respond` takes: anything that becomes a response.
--
-- * `ServerResponse`: itself.
-- * `String`: a 200 with the string as text.
-- * `Status`: that status with an empty body. Panics on a 1xx, which
--   `inform` sends.
-- * `Either l r`, when both sides are a `Reply`: the side it holds. So a
--   handler computes an `Either APIError ServerResponse`, uses `?` on its
--   way, and its error type says, in its own `Reply` instance, what each
--   error answers.
class Reply r { fun reply(r) -> ServerResponse }

instance Reply ServerResponse { fun reply(r) = r }

instance Reply String { fun reply(s) = text(OK, s) }

instance Reply Status {
    fun reply(s) {
        let code = Status.code(s)
        if code / 100 == 1 {
            error("ServerResponse.reply: a " + Int.toString(code) + " response is sent with inform")
        }
        make(s, None, Empty)
    }
}

instance Reply (Either l r) : Reply l, Reply r {
    fun reply(x) = match x {
        Left(l) -> reply(l)
        Right(r) -> reply(r)
    }
}
