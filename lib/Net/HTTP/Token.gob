export (Token, parse, literal, toString)

-- A token (RFC 9110 §5.6.2): one or more of the bytes HTTP allows in a name,
-- the letters, digits and ``!#$%&'*+-.^_`|~``. Method names, media types,
-- authentication schemes and parameter names are tokens.
--
-- A token keeps its case: method names are case-sensitive, so `get` is not
-- `GET`. The places where case does not matter lowercase their own tokens.

import Net.HTTP.Syntax as Syntax

type Token = Token(String)

instance Eq Token { fun eq(Token(a), Token(b)) = a == b }
instance Show Token { fun show(Token(s)) = s }

fun parse(s : String) -> Option Token = if Syntax.isToken(s) { Some(Token(s)) } else { None }

-- Returns `s` as a token, and panics if it is not one: a token written in the
-- program's source that is not one is a mistake in the program.
fun literal(s : String) -> Token = match parse(s) {
    Some(t) -> t
    None -> error("invalid token literal '" + Syntax.escaped(s) + "'")
}

fun toString(Token(s)) -> String = s
