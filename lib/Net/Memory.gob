export (Pipe, Listener, pair, listener, connect, accept, closeListener)

-- Connections that never leave the program: two ends of a `Pipe`, each a
-- `Net.Connection` as a TCP socket is, and a `Listener` that hands out the
-- far end of each `connect`. For testing a server or a protocol without a
-- socket, a port, or a network.
--
--     let l = Memory.listener(65536)
--     let client = Memory.connect(l)?
--     let server = accept(l)?
--
-- **As a TCP connection behaves,** within one program:
--
-- * Each direction holds at most the capacity it was made with. A write
--   that does not fit waits for the peer to read, so a peer that stops
--   reading stalls a writer, as a full socket buffer does.
-- * A read waits for bytes, and returns 0 once the peer has shut down its
--   writing or closed its end and every byte before that has been read.
-- * A write after the peer closed its end, or after this end shut down its
--   writing, fails with `BrokenPipe`.
-- * `close` ends every read and write parked on this end, in any task, with
--   `Closed`, as it does every later one.
-- * A deadline bounds every read and write from when it is set, and
--   `setLimits`' `each` each one from when it begins; one that passes is
--   `TimedOut`.
--
-- Waiting suspends the task, as waiting on a socket does, so the far end
-- may be served by another task of the same program.

import Net as Net
import Net (Connection(..), HasConnectionInfo(..), ConnectionInfo(..), accept, closeListener)
import System.Sync as Sync
import System.Sync (Condition, Mutex)
import Time (Timeout(..))
import Time.Deadline (Deadline)
import Time.Duration (Duration)
import Turkey.Buffer (Buffer(..))
import Turkey.Buffer as Buf
import Turkey.Errors (IOError(..), ErrorKind(..))
import Turkey.ReadWrite (Read(..), Write(..), needsRoom)

-- One direction of a pipe: the bytes written and not yet read, and how its
-- two sides have ended.
type Flow = Flow {
    held          : Buffer
    -- The writing side shut down or closed: once `held` is empty, a read
    -- returns 0.
    var ended     : Bool
    -- The reading side closed: a write fails.
    var abandoned : Bool
}

-- What both directions share: one lock over both flows, and a condition on
-- them for each end, notified by every change that could let a task waiting
-- on that end go on.
type Shared = Shared {
    flows   : Mutex (Array Flow)
    -- Indexed by end.
    changed : Array (Condition (Array Flow))
}

-- One end of an in-memory connection. End 0 reads flow 0 and writes flow 1;
-- end 1 the other way round.
type Pipe = Pipe {
    shared       : Shared
    side         : Int
    var deadline : Option Deadline
    -- How long each read or write may take, from when it begins.
    var each     : Option Duration
    var closed   : Bool
}

-- Returns the two ends of a new connection, each direction holding at most
-- `capacity` bytes. Panics if `capacity` is below 1.
fun pair(capacity : Int) -> (Pipe, Pipe) {
    if capacity < 1 {
        error("Memory.pair: capacity " + Int.toString(capacity) + " must be at least 1")
    }
    let flow = fun() = Flow { held = Buf.buffer(capacity), ended = False, abandoned = False }
    let flows = Sync.mutex([flow(), flow()])
    let shared = Shared {
        flows
        changed = [Sync.condition(flows), Sync.condition(flows)]
    }
    (Pipe { shared, side = 0, deadline = None, each = None, closed = False },
     Pipe { shared, side = 1, deadline = None, each = None, closed = False })
}

fun ioError(kind : ErrorKind, op : String) -> IOError = IOError { kind, op, path = None }

fun peer(p : Pipe) -> Int = 1 - p.side

-- Wakes every task waiting on end `side`.
fun wake(shared : Shared, side : Int) -> Unit = Sync.notifyAll(shared.changed[side])

-- Returns the deadline of a read or write of `p` that begins now.
fun limitOf(p : Pipe) -> Option Deadline = match p.each {
    Some(e) -> Some(Net.operationDeadline(p.deadline, e))
    None -> p.deadline
}

-- Runs `look` on the flows, with the lock held, until it returns `Some`, and
-- returns what that holds: at once, or after a change that wakes end
-- `p.side`. A wait that reaches `by`, the deadline of the read or write it
-- is part of, is `TimedOut`, and a close of this end, `Closed`.
fun waitOnFlows(p : Pipe, op : String, by : Option Deadline,
                look : fun(Array Flow) -> Option (Either IOError a)) -> Either IOError a {
    let ready = fun(flows) = if p.closed { Some(Left(ioError(Closed, op))) } else { look(flows) }
    let changed = p.shared.changed[p.side]
    if let Some(d) = by {
        Option.unwrapOr(Sync.waitFor(changed, d, ready), Left(ioError(TimedOut, op)))
    } else {
        Sync.waitForUnbounded(changed, ready)
    }
}

instance Read Pipe {
    type ReadError = IOError
    fun readInto(p, into) {
        needsRoom(into)
        let side = p.side
        let got = waitOnFlows(p, "read", limitOf(p), fun(flows) {
            let f = flows[side]
            let held = f.held
            let n = held.end - held.start
            if n == 0 {
                return if f.ended { Some(Right(0)) } else { None }
            }
            let moved = min(n, Buf.room(into))
            Buf.append(into, held.storage, held.start, held.start + moved)
            Buf.consume(held, moved)
            Some(Right(moved))
        })?
        if got > 0 {
            wake(p.shared, peer(p))
        }
        Right(got)
    }
}

instance Write Pipe {
    type WriteError = IOError
    fun writeFrom(p, from) = writeAll(p, from)
    fun flush(p) = if p.closed { Left(ioError(Closed, "flush")) } else { Right(()) }
}

-- Moves `from`'s window into the peer's flow, waiting for room as the peer
-- reads.
fun writeAll(p : Pipe, from : Buffer) -> Either IOError Unit {
    let side = peer(p)
    let by = limitOf(p)
    var at = from.start
    while at < from.end {
        let start = at
        let moved = waitOnFlows(p, "write", by, fun(flows) {
            let f = flows[side]
            if f.abandoned || f.ended {
                return Some(Left(ioError(BrokenPipe, "write")))
            }
            let held = f.held
            if held.end == held.limit {
                Buf.compact(held)
            }
            let room = held.limit - held.end
            if room == 0 {
                return None
            }
            let n = min(from.end - start, room)
            Buf.append(held, from.storage, start, start + n)
            Some(Right(n))
        })?
        at = at + moved
        wake(p.shared, side)
    }
    Right(())
}

-- A pipe has no addresses, and no TLS.
instance HasConnectionInfo Pipe {
    fun connectionInfo(_) = ConnectionInfo { local = None, peer = None, tls = None }
}

-- A deadline set on one end bounds that end's waits only.
instance Connection Pipe {
    fun setDeadline(p, timeout) {
        p.deadline = Some(deadline(timeout))
        p.each = None
    }
    fun clearDeadline(p) {
        p.deadline = None
        p.each = None
    }
    fun setLimits(p, deadline, each) {
        p.deadline = deadline
        p.each = Some(each)
    }
    fun shutdownWrite(p) {
        if p.closed {
            return Left(ioError(Closed, "shutdown"))
        }
        let side = peer(p)
        Sync.withLock(p.shared.flows, fun(flows) { flows[side].ended = True })
        wake(p.shared, side)
        Right(())
    }
    fun close(p) {
        if p.closed {
            return Right(())
        }
        p.closed = True
        let mine = p.side
        let theirs = peer(p)
        Sync.withLock(p.shared.flows, fun(flows) {
            flows[mine].abandoned = True
            flows[theirs].ended = True
        })
        wake(p.shared, mine)
        wake(p.shared, theirs)
        Right(())
    }
}

-- -- listening ------------------------------------------------------------------------

-- Where `connect` leaves the far end of each connection for `accept`.
type Listener = Listener {
    capacity : Int
    queue    : Mutex Arrivals
    -- Notified by each `connect`, and by the close.
    arrived  : Condition Arrivals
}

-- The far ends not yet accepted, oldest first: `taking` from its end, then
-- `incoming` from its start. A `connect` pushes onto `incoming`. An `accept`
-- pops from `taking`, and swaps `incoming` out, reversed, into it once it is
-- empty, so that neither holds an end that has been accepted.
type Arrivals = Arrivals {
    var incoming : Vec Pipe
    var taking   : Vec Pipe
    var closed   : Bool
}

-- Returns a listener whose connections hold at most `capacity` bytes in
-- each direction. Panics if `capacity` is below 1.
fun listener(capacity : Int) -> Listener {
    if capacity < 1 {
        error("Memory.listener: capacity " + Int.toString(capacity) + " must be at least 1")
    }
    let queue = Sync.mutex(Arrivals { incoming = [], taking = [], closed = False })
    Listener {
        capacity
        queue
        arrived = Sync.condition(queue)
    }
}

-- Returns the near end of a new connection to `l`, whose far end the next
-- `accept` returns. Fails with `Closed` once `l` is closed. Never waits.
fun connect(l : Listener) -> Either IOError Pipe {
    let (near, far) = pair(l.capacity)
    let open = Sync.withLock(l.queue, fun(a) {
        if a.closed {
            return False
        }
        Vec.push(a.incoming, far)
        True
    })
    if !open {
        return Left(ioError(Closed, "connect"))
    }
    Sync.notifyAll(l.arrived)
    Right(near)
}

-- The far end of the oldest `connect` not yet accepted, waiting for one if
-- there is none. Closing `l` ends the wait with `Closed`.
instance Net.Listener Listener {
    type Accepted = Pipe
    fun accept(l) =
        Sync.waitForUnbounded(l.arrived, fun(a) {
            if a.closed {
                return Some(Left(ioError(Closed, "accept")))
            }
            if len(a.taking) == 0 {
                a.taking = Vec.reverse(a.incoming)
                a.incoming = []
            }
            map(Vec.pop(a.taking), Right)
        })
    fun closeListener(l) {
        Sync.withLock(l.queue, fun(a) { a.closed = True })
        Sync.notifyAll(l.arrived)
        Right(())
    }
}
