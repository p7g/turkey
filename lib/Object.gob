export (Object(..))

import Prelude ()
import Data.Bool (Bool(..))

-- A type whose values are objects: built with a position that can be
-- assigned, so two of them built alike can be told apart by assigning
-- through one. `identical` tells them apart without assigning.
--
-- Instances are derived by the compiler, which writes `identical`, and a
-- program may not write one. They are exactly the types whose every value
-- has stable identity: an array, a type whose every constructor has a `var`
-- field or no field at all, and a one-field wrapper over one of those. A
-- value of any other type may be copied or rebuilt from its fields wherever
-- the compiler likes, so identity on it would answer differently from one
-- build to the next.
class Object a {
    -- Returns whether the two arguments are the same object. Two objects
    -- equal under `==` need not be identical; an object is identical to
    -- itself.
    fun identical(a, a) -> Bool
}
