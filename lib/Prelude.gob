type Flow a b r = Fall(a) | Brk(b) | Cont | Ret(r)

-- Returns a hash of `a`. Equal values hash equal for as long as the process
-- runs; nothing else is promised. The function may differ between runs and
-- between versions, so a hash that must be stable is computed with a hasher
-- named outright, such as `Hash.FoldHash` with a fixed seed.
fun hash[Hash a](a : a) -> Int {
    -- The hasher `Data.Map` uses.
    let start : FoldHash = startHash(0)
    finishHash(hashInto(a, start))
}
