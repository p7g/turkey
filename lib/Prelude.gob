export (module Turkey (..))

--- What every module imports without saying so, unless it imports `Prelude`
--- itself: everything `Turkey` exports.

import Turkey

-- What a `return`, `break` or `continue` becomes when it crosses a `?`. The
-- compiler in `bootstrap/` writes these constructors as the Prelude's, so the
-- type is declared here as well as in `Turkey.Flow`, where the compiler built
-- from `src/` names it.
type Flow a b r = Fall(a) | Brk(b) | Cont | Ret(r)
