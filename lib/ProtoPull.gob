--- Prototype of one concrete, single-use iterator type over a pull closure,
--- with a class for what can be iterated. Measurement only.

export (Pull, pull, pnext, Iterable(..), pmap, pfilter, pzip, psum)

import Prelude ()
import Data.Bool (Bool(..))
import Data.Int (Int)
import Data.Option (Option(..))
import Data.Num (Add(..), Zero(..), (+))
import Control.Monad (Monad(..))

type Pull a = Pull(fun() -> Option a)

--- Returns the iterator whose elements are the results of `f`, until `None`.
fun pull(f : fun() -> Option a) -> Pull a = Pull(f)

--- Returns the next element and advances `p`.
fun pnext(Pull(f) : Pull a) -> Option a = f()

class Iterable c {
	type Elem c

	fun iterate(c) -> Pull (Elem c)
}

instance Iterable (Pull a) {
	type Elem = a
	fun iterate(p) = p
}

fun pmap(p : Pull a, f : fun(a) -> b) -> Pull b =
	Pull(fun() = match pnext(p) {
		None    -> None
		Some(x) -> Some(f(x))
	})

fun pfilter(p : Pull a, keep : fun(a) -> Bool) -> Pull a =
	Pull(fun() {
		loop {
			match pnext(p) {
				None    -> return None
				Some(x) -> if keep(x) { return Some(x) }
			}
		}
	})

fun pzip(p : Pull a, q : Pull b) -> Pull (a, b) =
	Pull(fun() {
		let x = pnext(p)?
		let y = pnext(q)?
		Some((x, y))
	})

--- Returns the sum of the elements.
fun psum[Add a, Zero a](p : Pull a) -> a {
	var total = zero()
	loop {
		match pnext(p) {
			None    -> return total
			Some(x) -> { total = total + x }
		}
	}
}
