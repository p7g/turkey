export (
    Builder, Pattern, Capture, Captures, Resolve(..), Combining(..),
    literal, satisfy, capture, choice, orElse, (<|>), optional, many, some, compile, fullMatch,
    fullMatchWithin, defaultBudget,
)

--- A `Builder` describes a pattern, `compile` assembles one into a `Pattern`,
--- and `fullMatch` runs a `Pattern` against a whole string. Capture values are
--- recipes, evaluated only after a successful match.
--- See examples/regex/README.md for semantics, examples, and current limits.

import Data.BitSet as BitSet

type Instruction
    = Consume(fun(Char) -> Bool)
    | Exactly(Char)
    | Jump(Int)
    | Split(Int, Int)
    | Open(Int)
    | Close(Int)

-- What a builder writes into: the instructions so far, at their final
-- positions, and the next unused tag.
--
-- `quiet` counts the `capture`s around the builder running now. A capture
-- keeps the text it spans and throws away the recipe of what is inside it,
-- so the scopes inside one would never be read, and are not written.
type Assembly = Assembly { code : Vec Instruction, var tags : Int, var quiet : Int }

-- A builder runs once for every place it is used in a pattern, so each use
-- gets its own tags and its own recipes. That is what lets one fragment
-- appear twice in a pattern and resolve each time to its own match.
type Builder a = Builder(fun(Assembly) -> a)

-- The instructions of a compiled pattern. `joins` marks the ones reached by
-- a jump or a split, or first: every other one is reached only by falling
-- through from the one before. `boundaries` and `splits` count the Open and
-- Close instructions and the Split instructions, which a match uses to size
-- its log and its stack of choices; a path through a loop can need more.
type Program = Program { code : Array Instruction, joins : Array Bool, boundaries : Int, splits : Int }

type Pattern a = Pattern { program : Program, value : a }

type Capture a = Capture(fun(Captures) -> a)

-- The capture boundaries the winning path crossed, in order. `marks[i]` is
-- twice the scope's tag at its open and one more at its close, and
-- `places[i]` is where it was crossed. For an open, `partner[i]` is the
-- index of its close. Opens and closes nest, so the scopes directly inside
-- the entries `from` to `to` are found by starting at `from` and jumping
-- from each open to just past its close.
type Log = Log { marks : Vec Int, places : Vec String.Index, partner : Array Int }

--- One scope of a match: the entries of the log strictly inside it. It has
--- no `Eq`: the log holds the whole match, so comparing two would compare
--- far more than the scope.
type Captures : !Eq = Captures { text : String, log : Log, from : Int, to : Int }

fun run(Builder(build) : Builder a, asm : Assembly) -> a = build(asm)

fun here(asm : Assembly) -> Int = len(asm.code)

fun emit(asm : Assembly, inst : Instruction) -> Unit = Vec.push(asm.code, inst)

fun fresh(asm : Assembly) -> Int {
    let tag = asm.tags
    asm.tags = tag + 1
    tag
}

-- `body` inside the scope `tag`, unless a capture around it makes the scope
-- unreadable.
fun scoped(asm : Assembly, tag : Int, body : Builder a) -> a {
    if asm.quiet == 0 { emit(asm, Open(tag)) }
    let value = run(body, asm)
    if asm.quiet == 0 { emit(asm, Close(tag)) }
    value
}

instance Functor Builder {
    fun map(b, f) = Builder(fun(asm) = f(run(b, asm)))
}

instance Applicative Builder {
    fun pure(x) = Builder(fun(asm) = x)
}

instance Monad Builder {
    fun bind(b, f) = Builder(fun(asm) = run(f(run(b, asm)), asm))
}

instance Functor Capture {
    fun map(Capture(read), f) = Capture(\f(read(_)))
}

instance Applicative Capture {
    fun pure(x) = Capture(fun(captures) = x)
}

-- `Applicative` supplies only `pure`, so `map2` is defined here rather than
-- taken from it.
class Combining f : Applicative f {
    fun map2(f a, f b, fun(a, b) -> c) -> f c
}

instance Combining Capture {
    fun map2(Capture(left), Capture(right), f) =
        Capture(fun(captures) = f(left(captures), right(captures)))
}

class Resolve r {
    type Output r
    fun resolve(r, Captures) -> Output r
}

instance Resolve (Capture a) {
    type Output = a
    fun resolve(Capture(read), captures) = read(captures)
}

instance Resolve (a, b) : Resolve a, Resolve b {
    type Output = (Output a, Output b)
    fun resolve((a, b), captures) = (resolve(a, captures), resolve(b, captures))
}

instance Resolve (a, b, c) : Resolve a, Resolve b, Resolve c {
    type Output = (Output a, Output b, Output c)
    fun resolve((a, b, c), captures) =
        (resolve(a, captures), resolve(b, captures), resolve(c, captures))
}

instance Resolve Unit {
    type Output = Unit
    fun resolve(value, captures) = ()
}

-- The open of the scope `tag` directly inside `captures`, if the match
-- went through it.
fun child(captures : Captures, tag : Int) -> Option Int {
    let log = captures.log
    var i = captures.from
    while i < captures.to {
        if log.marks[i] == 2 * tag { return Some(i) }
        i = log.partner[i] + 1
    }
    None
}

fun requiredChild(captures : Captures, tag : Int) -> Int =
    Option.expect(child(captures, tag), "Regex: capture did not participate in this match")

fun nested(captures : Captures, open : Int) -> Captures =
    Captures { text = captures.text, log = captures.log, from = open + 1, to = captures.log.partner[open] }

--- Capture the complete text of a fragment, ignoring its extraction recipe.
fun capture(body : Builder a) -> Builder (Capture String) = Builder(fun(asm) {
    let tag = fresh(asm)
    if asm.quiet == 0 { emit(asm, Open(tag)) }
    asm.quiet = asm.quiet + 1
    let _ = run(body, asm)
    asm.quiet = asm.quiet - 1
    if asm.quiet == 0 { emit(asm, Close(tag)) }
    Capture(fun(captures) {
        let open = requiredChild(captures, tag)
        let log = captures.log
        String.slice(captures.text, log.places[open], log.places[log.partner[open]])
    })
})

-- A literal's text is known without a scope: when the match succeeds, it is
-- the text that matched.
fun literal(text : String) -> Builder (Capture String) = Builder(fun(asm) {
    for c in String.codePoints(text) {
        emit(asm, Exactly(c))
    }
    pure(text)
})

fun satisfy(predicate : fun(Char) -> Bool) -> Builder (Capture Char) = Builder(fun(asm) {
    let tag = fresh(asm)
    scoped(asm, tag, Builder(fun(asm) = emit(asm, Consume(predicate))))
    Capture(fun(captures) {
        let open = requiredChild(captures, tag)
        if let Some(c) = String.decode(captures.text, captures.log.places[open]) {
            c
        } else {
            error("Regex: missing character in successful capture")
        }
    })
})

fun choice[Resolve a, Resolve b](left : Builder a, right : Builder b)
        -> Builder (Capture (Either (Output a) (Output b))) = Builder(fun(asm) {
    let leftTag = fresh(asm)
    let rightTag = fresh(asm)
    let split = here(asm)
    emit(asm, Split(0, 0))
    let l = scoped(asm, leftTag, left)
    let jump = here(asm)
    emit(asm, Jump(0))
    let rightStart = here(asm)
    let r = scoped(asm, rightTag, right)
    asm.code[split] = Split(split + 1, rightStart)
    asm.code[jump] = Jump(here(asm))
    Capture(fun(captures) = match child(captures, leftTag) {
        Some(open) -> Left(resolve(l, nested(captures, open)))
        None -> Right(resolve(r, nested(captures, requiredChild(captures, rightTag))))
    })
})

--- `a <|> b` is `orElse(a, b)`. Both operands are evaluated, which is harmless
--- here: evaluating a `Builder` only describes a pattern, and nothing runs
--- until it is compiled and matched.
infix Choice (<|>) = orElse

fun orElse[Resolve a](left : Builder a, right : Builder a) -> Builder (Capture (Output a)) {
    let result = choice(left, right)
    map(result, fun(recipe) = map(recipe, fun(value) = match value {
        Left(x) -> x
        Right(x) -> x
    }))
}

fun optional[Resolve a](body : Builder a) -> Builder (Capture (Option (Output a))) =
    Builder(fun(asm) {
        let tag = fresh(asm)
        let split = here(asm)
        emit(asm, Split(0, 0))
        let value = scoped(asm, tag, body)
        asm.code[split] = Split(split + 1, here(asm))
        Capture(fun(captures) =
            map(child(captures, tag), \resolve(value, nested(captures, _))))
    })

fun repeated[Resolve a](body : Builder a, atLeastOne : Bool)
        -> Builder (Capture (Vec (Output a))) = Builder(fun(asm) {
    let tag = fresh(asm)
    let start = here(asm)
    if !atLeastOne { emit(asm, Split(0, 0)) }
    let value = scoped(asm, tag, body)
    if atLeastOne {
        emit(asm, Split(start, here(asm) + 1))
    } else {
        emit(asm, Jump(start))
        asm.code[start] = Split(start + 1, here(asm))
    }
    Capture(fun(captures) {
        let values = []
        let log = captures.log
        var i = captures.from
        while i < captures.to {
            if log.marks[i] == 2 * tag {
                Vec.push(values, resolve(value, nested(captures, i)))
            }
            i = log.partner[i] + 1
        }
        values
    })
})

fun many[Resolve a](body : Builder a) -> Builder (Capture (Vec (Output a))) =
    repeated(body, False)

fun some[Resolve a](body : Builder a) -> Builder (Capture (Vec (Output a))) =
    repeated(body, True)

--- Assemble `b` once. Jumps and splits are pointed past any chain of jumps
--- they lead to, so that matching never follows one jump to reach another.
fun compile[Resolve r](b : Builder r) -> Pattern r {
    let asm = Assembly { code = [], tags = 0, quiet = 0 }
    let value = run(b, asm)
    let code = asm.code
    let past = fun(target : Int) {
        var t = target
        var steps = 0
        while steps < len(code) && t < len(code) {
            match code[t] {
                Jump(next) -> { t = next }
                _ -> break
            }
            steps = steps + 1
        }
        t
    }
    let out = Array.init(len(code), fun(pc) = match code[pc] {
        Jump(t) -> Jump(past(t))
        Split(a, b) -> Split(past(a), past(b))
        inst -> inst
    })
    let joins = Array.filled(len(out) + 1, False)
    joins[0] = True
    var boundaries = 0
    var splits = 0
    for inst in out {
        match inst {
            Jump(t) -> { joins[t] = True }
            Split(a, b) -> {
                joins[a] = True
                joins[b] = True
                splits = splits + 1
            }
            Open(_) | Close(_) -> { boundaries = boundaries + 1 }
            _ -> {}
        }
    }
    Pattern { program = Program { code = out, joins, boundaries, splits }, value = value }
}

-- The boundaries a path crossed, as `Log` holds them, before `partner` is
-- worked out.
type Trail = Trail { marks : Vec Int, places : Vec String.Index }

fun logOf(trail : Trail) -> Log {
    let partner = Array.filled(len(trail.marks), -1)
    let opens = Vec.new(len(trail.marks) / 2)
    for var i = 0; i < len(trail.marks); i = i + 1 {
        if trail.marks[i] % 2 == 0 {
            Vec.push(opens, i)
        } else {
            partner[Option.expect(Vec.pop(opens), "Regex: unbalanced capture log")] = i
        }
    }
    if len(opens) != 0 { error("Regex: unclosed capture log") }
    Log { marks = trail.marks, places = trail.places, partner }
}

--- How many (instruction, position) pairs the backtracker may keep a bit for
--- by default: 256 KiB of visited set. The set grows with the text, so its
--- cost per character does not; past the budget the Pike VM is about half as
--- fast but needs memory for the pattern alone.
let defaultBudget : Int = 2 * 1024 * 1024

fun fullMatch[Resolve r](pattern : Pattern r, text : String) -> Option (Output r) =
    fullMatchWithin(pattern, text, defaultBudget)

--- `fullMatch`, backtracking only if the visited set fits in `budget` pairs
--- of instruction and position, and otherwise running the Pike VM, whose
--- space is linear in the pattern alone. The two give the same results; the
--- budget trades memory for speed and nothing else.
fun fullMatchWithin[Resolve r](pattern : Pattern r, text : String, budget : Int)
        -> Option (Output r) {
    let program = pattern.program
    let pairs = (len(program.code) + 1) * (String.byteLength(text) + 1)
    let events = if pairs <= budget { backtrack(program, text) } else { pike(program, text) }
    let log = logOf(events?)
    Some(resolve(pattern.value, Captures { text, log, from = 0, to = len(log.marks) }))
}

-- -- backtracking ---------------------------------------------------------------------

-- Where the second branch of a split resumes: its instruction, its place in
-- the text (and how many characters precede it), and how much of the event
-- log is still true there.
type Resume = Resume { pc : Int, at : String.Index, count : Int, logged : Int }

-- Depth first, the first branch of every split before the second, so the
-- first path to reach the end of the pattern at the end of the text is the
-- one the Pike VM would choose. A pair of instruction and position is
-- explored at most once: whether the rest of the pattern can match from it
-- does not depend on how it was reached, so a second arrival can only fail
-- again, and the work is bounded by the pairs, as the Pike VM's is.
--
-- Only joins need a visited bit. Any other instruction has one predecessor,
-- the instruction before it, at one position, the same one or the one before;
-- arriving twice there means arriving twice at the nearest join behind it,
-- which the bit there has already stopped.
--
-- Positions are counted in characters for the visited set; there are at
-- most as many as bytes, which is what `fullMatch` budgets for.
fun backtrack(program : Program, text : String) -> Option Trail {
    let code = program.code
    let joins = program.joins
    let width = len(code) + 1
    let visited = BitSet.new(width * (String.byteLength(text) + 1))
    let marks = Vec.new(program.boundaries)
    let places = Vec.new(program.boundaries)
    let pending = Vec.new(program.splits + 1)
    Vec.push(pending, Resume { pc = 0, at = String.start(text), count = 0, logged = 0 })
    while let Some(resume) = Vec.pop(pending) {
        while len(marks) > resume.logged {
            let _ = Vec.pop(marks)
            let _ = Vec.pop(places)
        }
        var pc = resume.pc
        var at = resume.at
        var count = resume.count
        loop {
            if joins[pc] {
                let key = count * width + pc
                if BitSet.contains(visited, key) { break }
                BitSet.add(visited, key)
            }
            if pc == len(code) {
                if String.atEnd(text, at) { return Some(Trail { marks, places }) }
                break
            }
            match code[pc] {
                Consume(predicate) -> match String.step(text, at) {
                    Some((c, next)) -> {
                        if !predicate(c) { break }
                        at = next
                        count = count + 1
                        pc = pc + 1
                    }
                    None -> break
                }
                Exactly(wanted) -> match String.step(text, at) {
                    Some((c, next)) -> {
                        if c != wanted { break }
                        at = next
                        count = count + 1
                        pc = pc + 1
                    }
                    None -> break
                }
                Jump(target) -> { pc = target }
                Split(first, second) -> {
                    Vec.push(pending, Resume { pc = second, at, count, logged = len(marks) })
                    pc = first
                }
                Open(tag) -> {
                    Vec.push(marks, 2 * tag)
                    Vec.push(places, at)
                    pc = pc + 1
                }
                Close(tag) -> {
                    Vec.push(marks, 2 * tag + 1)
                    Vec.push(places, at)
                    pc = pc + 1
                }
            }
        }
    }
    None
}

-- -- Pike VM ---------------------------------------------------------------------------

-- Persistent event histories share prefixes across threads. Branches do not
-- mutate each other's captures. Only the winner's is turned into a log.
type History = Empty | Crossed(Int, String.Index, History)

-- A list of threads, in priority order, as parallel vectors: a thread is an
-- instruction and its history.
type Threads = Threads { pcs : Vec Int, histories : Vec History }

fun threads() -> Threads = Threads { pcs = [], histories = [] }

fun add(ts : Threads, pc : Int, history : History) -> Unit {
    Vec.push(ts.pcs, pc)
    Vec.push(ts.histories, history)
}

fun clear(ts : Threads) -> Unit {
    Vec.clear(ts.pcs)
    Vec.clear(ts.histories)
}

fun trailOf(history : History) -> Trail {
    let marks = []
    let places = []
    var rest = history
    while let Crossed(mark, at, previous) = rest {
        Vec.push(marks, mark)
        Vec.push(places, at)
        rest = previous
    }
    Trail { marks = Vec.reverse(marks), places = Vec.reverse(places) }
}

-- Follow every jump, split and capture boundary from `pc` at position `at`,
-- adding a thread for each `Consume` reached and for the end of the pattern.
-- Splits go on `pending` second branch first, so the first branch is
-- followed first and its threads come first. `seen[pc] == stamp` marks an
-- instruction already reached at this position: the first arrival has the
-- higher priority, and a later one would only repeat it.
fun addThread(code : Array Instruction, out : Threads, pending : Threads,
        seen : Array Int, stamp : Int, pc : Int, history : History, at : String.Index) -> Unit {
    add(pending, pc, history)
    while let Some(start) = Vec.pop(pending.pcs) {
        var current = start
        var h = Option.expect(Vec.pop(pending.histories), "Regex: thread stacks out of step")
        loop {
            if seen[current] == stamp { break }
            seen[current] = stamp
            if current == len(code) {
                add(out, current, h)
                break
            }
            match code[current] {
                Jump(target) -> { current = target }
                Split(first, second) -> {
                    add(pending, second, h)
                    current = first
                }
                Open(tag) -> {
                    h = Crossed(2 * tag, at, h)
                    current = current + 1
                }
                Close(tag) -> {
                    h = Crossed(2 * tag + 1, at, h)
                    current = current + 1
                }
                Consume(_) | Exactly(_) -> {
                    add(out, current, h)
                    break
                }
            }
        }
    }
}

-- The thread lists for this position and the next are two that swap, so
-- stepping allocates no list. A position with no threads left ends the
-- match there.
fun pike(program : Program, text : String) -> Option Trail {
    let code = program.code
    let seen = Array.filled(len(code) + 1, -1)
    let pending = threads()
    var stamp = 0
    var current = threads()
    var following = threads()
    var at = String.start(text)
    addThread(code, current, pending, seen, stamp, 0, Empty, at)
    while let Some((c, next)) = String.step(text, at) {
        if len(current.pcs) == 0 { return None }
        stamp = stamp + 1
        for var i = 0; i < len(current.pcs); i = i + 1 {
            let pc = current.pcs[i]
            if pc < len(code) {
                let accepts = match code[pc] {
                    Consume(predicate) -> predicate(c)
                    Exactly(wanted) -> c == wanted
                    _ -> False
                }
                if accepts {
                    addThread(code, following, pending, seen, stamp, pc + 1, current.histories[i], next)
                }
            }
        }
        let done = current
        clear(done)
        current = following
        following = done
        at = next
    }
    for var i = 0; i < len(current.pcs); i = i + 1 {
        if current.pcs[i] == len(code) { return Some(trailOf(current.histories[i])) }
    }
    None
}
