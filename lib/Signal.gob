export (Signal(..), Listener, listen, wait, waitUnbounded, stop, number)

-- Waiting for a signal: a task asks for the signals it wants with `listen`,
-- and waits for the next of them as it waits for anything else, suspended
-- while its worker runs other tasks. No code of the program runs in signal
-- context, so what the task does about a signal -- stop a server, reopen a
-- log, read the terminal's new size -- is ordinary code.
--
--     let signals = Signal.listen([Signal.Terminate, Signal.Interrupt])?
--     let got = Signal.waitUnbounded(signals)
--     print("stopping on " + show(got))
--     Server.stop(server, Duration.seconds(10))
--
-- **Repeats coalesce.** A listener holds each kind of signal at most once
-- until a wait takes it, as the kernel holds a pending signal once: three
-- `SIGHUP`s that arrive before the wait are one `Hangup`. Different kinds are
-- kept apart, and waits take them in the order they were found; two that
-- arrived between the same two looks come in `Signal`'s declaration order.
-- Every listener that asked for a signal gets it.
--
-- **While anyone listens, the signal does not do what it did.** A program
-- that listens for `Terminate` is not ended by `SIGTERM`; it ends when its
-- code decides to. `stop` the last listener for a signal and the disposition
-- it had before the first `listen` comes back: the default for most, or
-- ignored for one the program was started with ignored, as `nohup` starts
-- `SIGHUP`. A signal that arrives while nobody listens for it is not kept.
--
-- **Children start clean.** A program started while this one listens gets
-- the default disposition for every signal listened for, since `exec` resets
-- a caught signal, and no signal is blocked. Child exits are not signals
-- here: `Process` waits for each child of its own.
--
-- **How it works.** The self-pipe trick: a handler counts the signal and
-- writes a byte to a pipe (`Turkey.Entry.signalNote`), and a waiting task
-- parks on the pipe's read end through the poller. A task that wakes reads
-- the pipe empty, then takes the counts and hands each signal to every
-- listener that asked for it, so whichever task wakes first delivers for all
-- of them, and a listener whose task is not waiting gets its signals when it
-- next waits. Both targets work this way.

import Time (Timeout(..))
import Time.Clock as Clock
import Time.Deadline as Deadline
import System.Sync as Sync
import System.Sync (Mutex)
import Target (OS(..))
import Target as Target
import Turkey.Entry as Entry
import Turkey.Errors (IOError)
import Turkey.Errors as Errors
import Turkey.IO as IO
import Turkey.Libc as Libc
import Turkey.Ptr (Ptr)
import Turkey.Ptr as Ptr
import Turkey.Sys as Sys
import Turkey.Wait as Wait

-- The signals a program can wait for: `SIGHUP`, `SIGINT`, `SIGTERM`,
-- `SIGUSR1`, `SIGUSR2` and `SIGWINCH`.
type Signal = Hangup | Interrupt | Terminate | User1 | User2 | WindowChange

-- Returns the signal's number on this target, as `kill` takes it. Darwin's
-- are `<sys/signal.h>`, Linux's `<bits/signum-arch.h>`.
fun number(s : Signal) -> Int = match s {
    Hangup -> 1
    Interrupt -> 2
    Terminate -> 15
    User1 -> match Target.os {
        Darwin -> 30
        Linux -> 10
    }
    User2 -> match Target.os {
        Darwin -> 31
        Linux -> 12
    }
    WindowChange -> 28
}

let kinds = [Hangup, Interrupt, Terminate, User1, User2, WindowChange]

fun index(s : Signal) -> Int = match s {
    Hangup -> 0
    Interrupt -> 1
    Terminate -> 2
    User1 -> 3
    User2 -> 4
    WindowChange -> 5
}

-- The signals one `listen` asked for, each once, and those of them that have
-- arrived and not been taken, in the order they were found. `pending` and
-- `stopped` change only with the registry's mutex held; `stopped` is read
-- without it too, by a wait deciding whether to park.
type Listener = Listener {
    id          : Int,
    signals     : Array Signal,
    pending     : Vec Signal,
    var stopped : Bool,
}

-- What every listener shares. The pipe's read end, or -1 before the first
-- `listen`; the pipe is made once and never closed, since the handler may be
-- writing to it on another thread at any time. The listeners not stopped. By
-- `index`, how many of them asked for the signal, and the disposition
-- `signal` returned when the first of them did, as an address.
type Registry = Registry {
    var readEnd  : Int,
    var nextId   : Int,
    var listeners : Vec Listener,
    listening    : Vec Int,
    previous     : Vec Int,
}

let registry : Mutex Registry = Sync.mutex(Registry {
    readEnd = -1,
    nextId = 0,
    listeners = [],
    listening = Vec.filled(len(kinds), 0),
    previous = Vec.filled(len(kinds), 0),
})

-- Where the pipe is read to, with the registry's mutex held.
let drainBuffer : Ptr = Libc.malloc(64)
let drainBytes : Int = 64

-- Returns a listener for `signals`, which from now on keeps every one of them
-- that arrives until a wait takes it. Fails only if the pipe the signals
-- arrive through cannot be made, the first time.
fun listen(signals : Array Signal) -> Either IOError Listener =
    Sync.withLock(registry, register(_, signals))

fun register(r : Registry, signals : Array Signal) -> Either IOError Listener {
    if r.readEnd < 0 {
        match makePipe() {
            Right(read) -> { r.readEnd = read }
            Left(e) -> return Left(Errors.failure("pipe", None, e))
        }
    }
    let wanted : Vec Signal = []
    for s in signals {
        if !Vec.contains(wanted, s) { Vec.push(wanted, s) }
    }
    for s in wanted { catch(r, s) }
    r.nextId = r.nextId + 1
    let l = Listener { id = r.nextId, signals = Vec.toArray(wanted), pending = [], stopped = False }
    Vec.push(r.listeners, l)
    Right(l)
}

-- One more listener wants `s`: the first installs the handler, keeping the
-- disposition it replaces. A count left from an earlier listener's time is
-- not this one's, and is dropped.
fun catch(r : Registry, s : Signal) -> Unit {
    let i = index(s)
    if r.listening[i] == 0 {
        let _ = Entry.signalTake(number(s))
        r.previous[i] = Ptr.toInt(Libc.signal(number(s), Entry.signalHandler()))
    }
    r.listening[i] = r.listening[i] + 1
}

-- A pipe for the handler: the read end, which this module keeps, or the
-- negated `errno`. Both ends are non-blocking -- the write end because the
-- handler must never wait, the read end because a wait reads it empty -- and
-- close-on-exec.
fun makePipe() -> Either Int Int {
    let fds = Libc.malloc(8)
    if Ptr.isNull(fds) { return Left(-Sys.enomem) }
    let made = match Target.os {
        Darwin -> Sys.cResult(Libc.pipe(fds))
        Linux -> Sys.cResult(Libc.pipe2(fds, Sys.closeOnExec() | Sys.nonBlocking()))
    }
    let read = Ptr.load32(fds, 0)
    let write = Ptr.load32(fds, 4)
    Libc.free(fds)
    if made < 0 { return Left(made) }
    var failure = 0
    match Target.os {
        Darwin -> {
            for fd in [read, write] {
                if failure >= 0 { failure = flagged(fd) }
            }
        }
        Linux -> {}
    }
    if failure < 0 {
        let _ = IO.close(read)
        let _ = IO.close(write)
        return Left(failure)
    }
    Entry.signalPipeSet(write)
    Right(read)
}

-- `fd` made non-blocking and close-on-exec: 0, or the negated `errno`.
fun flagged(fd : Int) -> Int {
    let status = IO.fcntl(fd, Sys.getStatusFlags)
    if status < 0 { return status }
    let r = IO.fcntlWith(fd, Sys.setStatusFlags, status | Sys.nonBlocking())
    if r < 0 { return r }
    IO.fcntlWith(fd, Sys.setDescriptorFlags, Sys.descriptorCloseOnExec)
}

-- Returns the next signal `l` holds, waiting for one until `t` has passed:
-- `None` if none came by then, or if `l` is stopped, before or during the
-- wait.
fun wait[Timeout t](l : Listener, t : t) -> Option Signal =
    waitUntil(l, Clock.nanos(Deadline.reading(deadline(t))))

-- Returns the next signal `l` holds, waiting for one for as long as it
-- takes. Panics if `l` is stopped, before or during the wait.
fun waitUnbounded(l : Listener) -> Signal = match waitUntil(l, -1) {
    Some(s) -> s
    None -> error("Signal.waitUnbounded: the listener is stopped")
}

-- The wait, until `deadline` on `Turkey.Wait.now`'s clock, or -1 for none.
--
-- A signal that arrives after `take` found nothing and before the wait is
-- registered has written its byte already, and the pipe reports readable at
-- once. A `stop` in that window is seen by `readableUnless`, or ends the
-- registered wait with `cancelled`.
fun waitUntil(l : Listener, deadline : Int) -> Option Signal {
    while True {
        match take(l) {
            Taken(s) -> return Some(s)
            Stopped -> return None
            Nothing -> {}
        }
        let fd = Sync.withLock(registry, _.readEnd)
        let r = Wait.readableUnless(fd, deadline, fun() = l.stopped)
        if r == Wait.timedOut {
            return match take(l) {
                Taken(s) -> Some(s)
                _ -> None
            }
        }
        if r < 0 && r != Wait.cancelled {
            error("Signal.wait: the poller cannot watch the signal pipe (error " + show(-r) + ")")
        }
    }
    None
}

type Take = Taken(Signal) | Stopped | Nothing

-- Deliver what has arrived to every listener, then take `l`'s first.
fun take(l : Listener) -> Take = Sync.withLock(registry, fun(r) {
    deliver(r)
    if l.stopped {
        Stopped
    } else if len(l.pending) == 0 {
        Nothing
    } else {
        let first = l.pending[0]
        for var i = 1; i < len(l.pending); i = i + 1 { l.pending[i - 1] = l.pending[i] }
        let _ = Vec.pop(l.pending)
        Taken(first)
    }
})

-- Read the pipe empty, then take the counts. In that order: a signal counted
-- after its count was taken wrote its byte after the pipe was emptied, so
-- the byte is there for the next wait.
fun deliver(r : Registry) -> Unit {
    while Libc.read(r.readEnd, drainBuffer, drainBytes) > 0 {}
    for s in kinds {
        if Entry.signalTake(number(s)) > 0 {
            for l in r.listeners {
                if Array.contains(l.signals, s) && !Vec.contains(l.pending, s) {
                    Vec.push(l.pending, s)
                }
            }
        }
    }
}

-- Stop `l`: it holds no more signals, and a wait on it ends. Each signal no
-- listener wants any more gets back the disposition it had before. Stopping
-- a listener twice does nothing the second time.
fun stop(l : Listener) -> Unit {
    let fd = Sync.withLock(registry, fun(r) {
        if !l.stopped {
            l.stopped = True
            r.listeners = Vec.filter(r.listeners, fun(other) = other.id != l.id)
            for s in l.signals { release(r, s) }
        }
        r.readEnd
    })
    -- Every wait on the pipe ends, not only `l`'s; the others find nothing
    -- and wait again.
    Wait.cancel(fd)
}

fun release(r : Registry, s : Signal) -> Unit {
    let i = index(s)
    r.listening[i] = r.listening[i] - 1
    if r.listening[i] == 0 {
        let _ = Libc.signal(number(s), Ptr.fromInt(r.previous[i]))
        let _ = Entry.signalTake(number(s))
    }
}
