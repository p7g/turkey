module Std.Classes (
    Eq(..),
    Ord(..),
    Add(..),
    Sub(..),
    Mul(..),
    Div(..),
    Rem(..),
    Neg(..),
    Show(..),
    Typed(..),
    Error(..),
    Hash(..),
    Hasher(..),
    Functor(..),
    Applicative(..),
    Monad(..),
    Iterator(..),
    Index(..),
    Length(..),
    Semigroup(..),
    Monoid(..),
    Foldable(..),
    const,
    error,
)

import Prelude ()
import Data.Bool.Type (Bool(..))
import Data.Option.Type (Option(..))
import Data.Typed.Type (TypeRep(..), Proxy(..))

class Eq a {
    fun eq(a, a) -> Bool
    fun ne(x : a, y : a) -> Bool = !eq(x, y)
}

class Ord a : Eq a {
    fun lt(a, a) -> Bool
    fun lte(x : a, y : a) -> Bool = lt(x, y) || eq(x, y)
    fun gt(x : a, y : a) -> Bool = lt(y, x)
    fun gte(x : a, y : a) -> Bool = !lt(x, y)
}

class Add a { fun add(a, a) -> a }
class Sub a { fun sub(a, a) -> a }
class Mul a { fun mul(a, a) -> a }
class Div a { fun div(a, a) -> a }
class Rem a { fun rem(a, a) -> a }
class Neg a { fun neg(a) -> a }

class Show a { fun show(a) -> String }

-- A type as a value, so that a packed payload can be asked what it is.
--
-- Instances are derived by the solver and a program may not write one: a
-- hand-written instance could claim any type for any value, which is exactly
-- what makes an unchecked cast unsound. GHC has rejected user `Typeable`
-- instances since 7.10 for the same reason.
class Typed a { fun typeRep(Proxy a) -> TypeRep }

-- What every payload in the shared error channel can do.
-- Deliberately one method: `Typed` joins it as a superclass when checked
-- downcasting lands, and nothing else belongs here before then.
-- `Typed` is a superclass so that a packed payload can be asked what it is:
-- the `Error` dictionary an existential carries has the `Typed` one inside
-- it, which is how `cast` reaches a rep it never saw packed.
class Error e : Typed e { fun message(e) -> String }

class Hasher h {
    fun digest(h) -> Int
    fun update(h, Int) -> Unit
}

class Hash a : Eq a {
    fun hashInto[Hasher h](a, h) -> Unit
}

class Functor f {
    fun map(f a, fun(a) -> b) -> f b
}

class Applicative f : Functor f {
    fun pure(a) -> f a
}

class Monad m : Applicative m {
    fun bind(m a, fun(a) -> m b) -> m b
}

class Iterator c {
    type Item c
    type Cursor c

    fun iter(c) -> Cursor c
    fun next(c, Cursor c) -> Option (Item c)
}

class Index c {
    type Key c
    type Value c

    fun get(c, Key c) -> Value c
    fun set(c, Key c, Value c) -> Unit
}

class Length c { fun len(c) -> Int }

class Semigroup a { fun combine(a, a) -> a }

class Monoid a : Semigroup a { fun empty() -> a }

class Foldable f {
    fun foldMap[Monoid m](f a, fun(a) -> m) -> m
    fun fold[Monoid m](xs : f m) -> m = foldMap(xs, fun(x) { return x })
}

fun const(x) = fun(_) = x
fun error(message : String) -> a = Prim.error(message)
