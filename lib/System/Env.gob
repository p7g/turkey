module System.Env (args, exit, get)

-- The process's own environment: what it was asked to do, and how it answers.
--
-- `main` keeps the type it has always had, `fun() -> Unit` (turkey/driver.py).
-- A program that wants a non-zero status calls `exit`, which diverges, so the
-- entry point's shape does not have to move in order to carry one.

import Prelude ()
import Std.Classes
import Data.Array (Array)
import Data.Array as Array
import Data.Vec as Vec
import Data.Option.Type (Option(..))
import Data.String as String
import Turkey.Libc as Libc
import Turkey.Ptr as Ptr
import Turkey.Process as Process

-- The program's arguments, its own name not among them.
--
-- Built on demand from the bytes `argv` points at. An argument that is not
-- well-formed UTF-8 panics: a `String` is UTF-8 by construction, and one
-- that broke that would break the invariant every other door checks.
fun args() -> Array String = Array.init(Process.argCount(), fun(i) {
    let p = Ptr.wrap(Process.argBytes(i))
    let n = Process.argLength(i)
    let bs = []
    for var j = 0; j < n; j = j + 1 {
        let b : Byte = Ptr.load(p, j)
        Vec.push(bs, b)
    }
    match String.fromBytes(bs) {
        Some(s) -> s
        None -> error("bytes are not well-formed UTF-8")
    }
})

fun exit(status : Int) -> a = Prim.exit(status)

-- The value of an environment variable, or `None` if it is unset or is not
-- well-formed UTF-8.
--
-- `getenv` is declared once, in `Turkey.Libc`, and what this module exports
-- is ordinary Turkey. That is Rust's `safe fn` inside an `unsafe extern` block
-- -- the declarer takes the risk once so the caller does not repeat it.
--
-- The name is copied into a NUL-terminated block and freed; the answer is
-- *not* freed, because `getenv` points into the environment block rather than
-- into storage the caller owns.
fun get(name : String) -> Option String {
    let key = Ptr.toCString(name)
    if Ptr.isNull(key) { return None }
    let found = Ptr.fromCString(Ptr.wrap(Libc.getenv(Ptr.raw(key))))
    Ptr.free(key)
    found
}
