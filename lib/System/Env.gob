module System.Env (args, exit, get)

-- The process's own environment: what it was asked to do, and how it answers.
--
-- `main` keeps the type it has always had, `fun() -> Unit` (turkey/driver.py).
-- A program that wants a non-zero status calls `exit`, which diverges, so the
-- entry point's shape does not have to move in order to carry one.

import Prelude ()
import Std.Classes
import Data.Array (Array)
import Data.Array as Array
import Data.Option.Type (Option(..))
import Unsafe.Libc as Libc
import Unsafe.Ptr as Ptr
import Unsafe.Runtime as Runtime

-- The program's arguments, its own name not among them (TIX-65).
--
-- Built here from bytes the runtime holds, where it was a primitive with a C
-- body. An argument that is not well-formed UTF-8 panics: a `String` is
-- UTF-8 by construction, and the C this replaced built one anyway -- a
-- `String` that broke the invariant every other door checks (FINDINGS 104).
fun args() -> Array String {
    let out = []
    let count = Runtime.argCount()
    for var i = 0; i < count; i = i + 1 {
        let p = Ptr.wrap(Runtime.argBytes(i))
        let n = Runtime.argLength(i)
        let bs = []
        for var j = 0; j < n; j = j + 1 {
            let b : Byte = Ptr.load(p, j)
            Array.push(bs, b)
        }
        Array.push(out, Prim.stringFromBytes(bs))
    }
    out
}

fun exit(status : Int) -> a = Prim.exit(status)

-- The value of an environment variable, or `None` if it is unset or is not
-- well-formed UTF-8 (TIX-62).
--
-- `Unsafe.` in the import list above is the point of the gate rather than a
-- wart: `getenv` is declared once, in a module whose name says the compiler
-- cannot check it, and what this module exports is ordinary Turkey. That is
-- Rust's `safe fn` inside an `unsafe extern` block -- the declarer takes the
-- risk once so the caller does not repeat it.
--
-- The name is copied into a NUL-terminated block and freed; the answer is
-- *not* freed, because `getenv` points into the environment block rather than
-- into storage the caller owns.
fun get(name : String) -> Option String {
    let key = Ptr.toCString(name)
    if Ptr.isNull(key) { return None }
    let found = Ptr.fromCString(Ptr.wrap(Libc.getenv(Ptr.raw(key))))
    Ptr.free(key)
    found
}
