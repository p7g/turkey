export (args, exit, get, currentDirectory, executablePath)

-- The process's own environment: what it was asked to do, and how it answers.
--
-- `main` keeps the type it has always had, `fun() -> Unit` (turkey/driver.py).
-- A program that wants a non-zero status calls `exit`, which diverges, so the
-- entry point's shape does not have to move in order to carry one.

import Prelude ()
import Data.Int (Int)
import Data.Int as Int
import Data.Byte (Byte)
import Data.String (String)
import Data.Ord (Ord(..), (<), (<=), (>), (>=))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..), (+), (-), (*), (/), (%))
import Data.Index (Index(..), SetIndex(..), Length(..))
import Control.Panic (error)
import Data.Array (Array)
import Data.Array as Array
import Data.Vec as Vec
import Data.Option (Option(..))
import Data.Eq (Eq(..), (==))
import Bits (BitAnd(..), (&))
import Target (OS(..))
import Target as Target
import Data.String as String
import Turkey.IO as IO
import Turkey.Libc as Libc
import Turkey.Ptr (Ptr)
import Turkey.Ptr as Ptr
import Turkey.Process as Process

-- The program's arguments, its own name not among them.
--
-- Built on demand from the bytes `argv` points at. An argument that is not
-- well-formed UTF-8 panics: a `String` is UTF-8 by construction, and one
-- that broke that would break the invariant every other door checks.
fun args() -> Array String = Array.init(Process.argCount(), fun(i) {
    let p = Process.argBytes(i)
    let n = Process.argLength(i)
    let bs = []
    for var j = 0; j < n; j = j + 1 {
        let b : Byte = Ptr.load(p, j)
        Vec.push(bs, b)
    }
    match String.fromBytes(bs) {
        Some(s) -> s
        None -> error("System.Env.args: the argument at index " + Int.toString(i)
                      + " is not well-formed UTF-8")
    }
})

fun exit(status : Int) -> a = Prim.exit(status)

-- The value of an environment variable, or `None` if it is unset or is not
-- well-formed UTF-8.
--
-- `getenv` is declared once, in `Turkey.Libc`, and what this module exports
-- is ordinary Turkey. That is Rust's `safe fn` inside an `unsafe extern` block
-- -- the declarer takes the risk once so the caller does not repeat it.
--
-- The name is copied into a NUL-terminated block and freed; the answer is
-- *not* freed, because `getenv` points into the environment block rather than
-- into storage the caller owns.
fun get(name : String) -> Option String {
    let key = Ptr.toCString(name)
    if Ptr.isNull(key) { return None }
    let found = Ptr.fromCString(Libc.getenv(key))
    Ptr.free(key)
    found
}

-- The working directory's absolute path, or `None` if it cannot be read or is
-- not well-formed UTF-8.
fun currentDirectory() -> Option String {
    let address = IO.workingDirectory()
    if address < 0 { return None }
    let path = Ptr.fromInt(address)
    let found = Ptr.fromCString(path)
    Ptr.free(path)
    found
}

-- The running executable's absolute path, with every symbolic link resolved,
-- or `None` if the system cannot say or the path is not well-formed UTF-8. A
-- program started through a symbolic link gets the file the link points to.
fun executablePath() -> Option String = match Target.os {
    Darwin -> darwinExecutable()
    -- `/proc/self/exe` is a symbolic link to the executable, so resolving it
    -- is the whole answer. Without procfs mounted there is none.
    Linux -> realPath(Prim.cString("/proc/self/exe"))
}

-- `_NSGetExecutablePath` stores the path the executable was started by,
-- which may be relative or a symbolic link, so resolve it as Linux does. When
-- the buffer is too small the call stores the size it needs; retry with that.
fun darwinExecutable() -> Option String {
    let size = Libc.malloc(8)
    if Ptr.isNull(size) { return None }
    var room = 1024
    loop {
        let buffer = Libc.malloc(room)
        if Ptr.isNull(buffer) {
            Libc.free(size)
            return None
        }
        Ptr.store32(size, 0, room)
        let status = Libc.nsGetExecutablePath(buffer, size) & 0xFFFF_FFFF
        if status == 0 {
            let found = realPath(buffer)
            Libc.free(buffer)
            Libc.free(size)
            return found
        }
        Libc.free(buffer)
        room = Ptr.load32(size, 0)
    }
}

-- `path`, a C string, resolved to an absolute path free of symbolic links, or
-- `None` if it cannot be.
fun realPath(path : Ptr) -> Option String {
    let block = match Target.os {
        Darwin -> Libc.realpathDarwin(path, Ptr.null())
        Linux -> Libc.realpathLinux(path, Ptr.null())
    }
    if Ptr.isNull(block) { return None }
    let found = Ptr.fromCString(block)
    Libc.free(block)
    found
}
