module System.IO (readFile, readBytes, writeFile, Output, create, put, close,
                  stderr, print, write)

-- Files, addressed as bytes, and the two standard streams.
--
-- Reading answers `Option String` rather than `String` because a file is not
-- guaranteed to be well-formed UTF-8 and a `String` is. The validation is
-- `String.fromBytes`, the one checked way to build a `String` from bytes,
-- rather than something hidden inside the read, so a program
-- that wants the bytes themselves is not made to go through text to get them.
--
-- Written in Turkey over `Turkey.IO`'s system calls, with no runtime support
-- of its own.

import Prelude ()
import Std.Classes
import Data.Array (Array)
import Data.Array as Array
import Data.Vec (Vec)
import Data.Vec as Vec
import Data.Bool.Type (Bool(..))
import Data.Byte as Byte
import Data.Int as Int
import Data.Option.Type (Option(..))
import Data.String as String
import Data.String.Type as Str
import Turkey.IO as IO
import Turkey.Sys as Sys

-- The file's contents, or `None` if it cannot be read or is not well-formed
-- UTF-8.
fun readFile(path : String) -> Option String = match readBytes(path) {
    Some(bs) -> String.fromBytes(bs)
    None -> None
}

-- The file's bytes, or `None` if it cannot be opened or read -- missing,
-- forbidden, a directory, a device that failed.
--
-- There is deliberately no "can this be read?" predicate beside it. There was
-- one, `canRead`, for a module search path that has to tell "no such file"
-- from "not UTF-8"; but its answer is stale by the time anything
-- acts on it, which is the check-then-use race POSIX's own `access` is
-- documented as. Reading *is* the question: a search path asks this, keeps
-- the first `Some`, and decodes it, so the two failures stay apart and there
-- is no window between asking and using.
fun readBytes(path : String) -> Option (Vec Byte) {
    let fd = IO.open(path, Sys.readOnly, 0)
    if fd < 0 { return None }
    readAll(fd)
}

-- Whether every byte was written. A failed write is an ordinary thing to want
-- to report -- a full disk, a read-only directory -- and unlike a failed read
-- there is no predicate that could be asked first without lying about the race.
fun writeFile(path : String, contents : String) -> Bool {
    let fd = openForWriting(path)
    if fd < 0 { return False }
    let written = writeAll(fd, contents)
    let closed = IO.close(fd) == 0
    written && closed
}

-- A file written a piece at a time, for output too large to hold as one
-- string first. `create` empties the file if it exists, as `writeFile` does,
-- and answers `None` where `writeFile` would answer `False`.
--
-- Whether a piece was written is answered for each `put`, and `close` answers
-- whether the whole file reached the system: a write can fail late, at the
-- close, on a file system that defers it.
type Output = Output(Int)

fun create(path : String) -> Option Output {
    let fd = openForWriting(path)
    if fd < 0 { None } else { Some(Output(fd)) }
}

fun put(Output(fd), text : String) -> Bool = writeAll(fd, text)

fun close(Output(fd)) -> Bool = IO.close(fd) == 0

-- The standard streams. `print` and `write` are the Prelude's, re-exported
-- from here because this is where a descriptor can be written; `Std.Classes`
-- held them while they were one primitive call, and cannot now, because the
-- raw memory underneath imports it.
--
-- A failed write to either stream is not reported, as it never was: there is
-- nowhere to report it to, and a program whose stdout is a closed pipe should
-- not have to test every line it prints.
--
-- A line is one string, newline included, so that it goes out in one `write`
-- where the kernel allows it: two processes sharing a terminal interleave by
-- line and not by fragment.
fun print(x) { let _ = writeAll(1, Str.concat(show(x), "\n")) }
fun write(x) { let _ = writeAll(1, show(x)) }
fun stderr(text : String) -> Unit { let _ = writeAll(2, text) }

-- -- underneath -----------------------------------------------------------------------

-- Write only, created if missing and emptied if not: `fopen(path, "wb")`.
-- 0o666, narrowed by the umask as `fopen` narrows it.
fun openForWriting(path : String) -> Int =
    IO.open(path, Int.or(Sys.writeOnly, Int.or(Sys.create(), Sys.truncate())), 0o666)

-- Everything left on `fd`, which is closed afterwards, or `None` if a read
-- failed. Read in chunks until `read` answers 0 rather than sized by `fstat`
-- first: a pipe or a device has no length to ask for, and a regular file can
-- change between the two calls.
fun readAll(fd : Int) -> Option (Vec Byte) {
    let chunk = Array.filled(65536, Byte.truncate(0))
    let out = []
    loop {
        let n = IO.read(fd, chunk, 0, len(chunk))
        if n == 0 - Sys.eintr { continue }
        if n < 0 {
            let _ = IO.close(fd)
            return None
        }
        if n == 0 { break }
        -- The chunk's elements, 24 bytes past its header (`Turkey.IO`).
        Vec.extendFromRaw(out, Prim.ptrAdd(Prim.objectAddress(chunk), 24), n)
        Prim.keepAlive(chunk)
    }
    let _ = IO.close(fd)
    Some(out)
}

-- `write` may take fewer bytes than it was offered -- a pipe, a signal -- so
-- it is asked again from where it stopped, and again at once if a signal
-- interrupted it before it took any. Any other failure ends it; so does 0,
-- which for a non-empty request would otherwise loop.
fun writeAll(fd : Int, text : String) -> Bool {
    let size = String.byteLength(text)
    var done = 0
    while done < size {
        let n = IO.writeText(fd, text, done, size)
        if n == 0 - Sys.eintr { continue }
        if n <= 0 { return False }
        done = done + n
    }
    True
}
