export (
    Mutex, mutex, withLock, tryWithLock, update,
    AtomicInt, atomicInt, load, store, addAndGet, compareAndSet,
    Once, once, force,
    Semaphore, semaphore, acquire, release, withPermit,
    Event, event, set, clear, isSet, wait, waitUnbounded,
)

-- What tasks that share data need when they run at once (`System.Task`): a
-- mutex around a value, an integer changed atomically, a value computed once
-- however many tasks ask for it, a count of permits that bounds how many
-- tasks do something at once, and a flag that tasks wait to see raised.
--
-- A task waiting for any of them waits as it does in `Task.join`: it is
-- suspended, and its worker runs other tasks meanwhile. The program's own
-- code waiting for a semaphore's permit or an event runs no task meanwhile,
-- since the one that gives the permit back or sets the event may be among
-- them: it sleeps, and the right to
-- run tasks goes to another thread. So nothing here holds up a worker.
--
-- Each keeps its state word in a `Prim.Atomic`, a cell of its own whose every
-- access is atomic.

import Time (Timeout(..))
import Time.Clock as Clock
import Time.Deadline (Deadline)
import Time.Deadline as Deadline
import Turkey.Coroutine as Co
import Turkey.Poll as Poll
import Turkey.Scheduler as Scheduler
import Turkey.Semaphore (Semaphore)
import Turkey.Semaphore as Semaphores
import Turkey.Wait as Wait

-- -- mutex -----------------------------------------------------------------------------

-- A value only one task at a time may use.
--
-- The state is 0 free, 1 held, or 2 held and perhaps waited for. Taking a free
-- mutex is one compare-and-swap; releasing it is a swap, and wakes the waiting
-- tasks only if the old state was 2. A task that cannot take it marks it 2 and
-- waits, as does one woken from among others, so that the release after it
-- looks for waiters too.
--
-- Any task may take a free mutex, including one that just released it:
-- waiters are woken, not handed the mutex, so one that is never quick enough
-- can wait for as long as others keep taking it.
type Mutex a = Mutex {
    state       : AtomicInt,
    var waiters : Vec Co.Coroutine,
    var value   : a,
}

fun mutex(value : a) -> Mutex a = Mutex { state = atomicInt(0), waiters = [], value = value }

-- `f` of the value, with the mutex held.
fun withLock(m : Mutex a, f : fun(a) -> b) -> b {
    lock(m)
    let made = f(m.value)
    unlock(m)
    made
}

-- `Some` of `f` of the value, with the mutex held, if it is free; `None`,
-- without waiting and without calling `f`, if a task holds it.
fun tryWithLock(m : Mutex a, f : fun(a) -> b) -> Option b {
    if !tryLock(m) { return None }
    let made = f(m.value)
    unlock(m)
    Some(made)
}

-- Replace the value with `f` of it, with the mutex held.
fun update(m : Mutex a, f : fun(a) -> a) -> Unit {
    lock(m)
    m.value = f(m.value)
    unlock(m)
}

fun lock(m : Mutex a) -> Unit {
    if tryLock(m) { return {} }
    Scheduler.waitUntil(fun() = claim(m), fun(c) = Vec.push(m.waiters, c))
}

-- Take `m` if it is free, without waiting: whether it was taken.
fun tryLock(m : Mutex a) -> Bool = compareAndSet(m.state, 0, 1)

-- Under the scheduler's lock: take `m` if it is free, or mark it waited for.
fun claim(m : Mutex a) -> Bool {
    let p = m.state
    while True {
        let state = load(p)
        if state == 0 {
            if compareAndSet(p, 0, 2) { return True }
        } else if state == 1 {
            if compareAndSet(p, 1, 2) { return False }
        } else {
            return False
        }
    }
    False
}

fun unlock(m : Mutex a) -> Unit {
    if swap(m.state, 0) != 2 { return {} }
    Scheduler.lock()
    for c in m.waiters { Scheduler.wake(c) }
    m.waiters = []
    Scheduler.changed()
    Scheduler.unlock()
}

fun swap(p : AtomicInt, value : Int) -> Int {
    while True {
        let old = load(p)
        if compareAndSet(p, old, value) { return old }
    }
    0
}

-- -- atomic integers -------------------------------------------------------------------

-- An `Int` that tasks read and change without a mutex. Each operation is one
-- atomic instruction, ordered with the reads and writes around it.
--
type AtomicInt = AtomicInt(Prim.Atomic)

fun atomicInt(initial : Int) -> AtomicInt = AtomicInt(Prim.atomicNew(initial))

fun load(AtomicInt(cell)) -> Int = Prim.atomicGet(cell)

fun store(AtomicInt(cell), value : Int) -> Unit = Prim.atomicSet(cell, value)

-- Add `n`, answering the sum. It wraps on overflow, as the instruction does.
fun addAndGet(AtomicInt(cell), n : Int) -> Int =
    Int.addWrapping(Prim.atomicAddTo(cell, n), n)

-- Store `new` if the value is `expected`, answering whether it was.
fun compareAndSet(AtomicInt(cell), expected : Int, new : Int) -> Bool =
    Prim.atomicSwapIf(cell, expected, new) == expected

-- -- computed once ---------------------------------------------------------------------

-- A value computed the first time a task asks for it, by that task; the
-- others that ask meanwhile wait for it. The state is 0 not started, 1 being
-- computed, 2 made.
--
-- A computation that asks for its own value waits for itself, which is a
-- deadlock.
type Once a = Once {
    state       : AtomicInt,
    compute     : fun() -> a,
    var made    : Option a,
    var waiters : Vec Co.Coroutine,
}

fun once(compute : fun() -> a) -> Once a =
    Once { state = atomicInt(0), compute = compute, made = None, waiters = [] }

fun force(o : Once a) -> a {
    let p = o.state
    if load(p) != 2 {
        if compareAndSet(p, 0, 1) {
            let value = o.compute()
            Scheduler.lock()
            o.made = Some(value)
            store(p, 2)
            for c in o.waiters { Scheduler.wake(c) }
            o.waiters = []
            Scheduler.changed()
            Scheduler.unlock()
        } else {
            Scheduler.waitUntil(fun() = load(p) == 2,
                                fun(c) = Vec.push(o.waiters, c))
        }
    }
    -- Written before the state became 2, which this read after.
    match o.made {
        Some(value) -> value
        None -> error("System.Sync.force: a value marked made is missing")
    }
}

-- -- semaphores ------------------------------------------------------------------------

-- A count of permits that tasks take and give back, which bounds how many do
-- something at once: with `semaphore(4)`, four tasks take a permit each, and a
-- fifth waits until one of them gives its permit back.
--
--     let downloads = Sync.semaphore(4)
--     ...
--     Sync.withPermit(downloads, fun() = fetch(url))
--
-- **In order.** A permit given back goes to the task that has waited longest,
-- of those still waiting; one whose deadline passed is skipped. A permit
-- nobody waits for goes back to the count, and a free permit is taken only
-- when nobody waits for one, so a task that comes later never overtakes one
-- that waits.
--
-- A permit is not tied to the task that took it: any task may give one back.

fun semaphore(permits : Int) -> Semaphore = Semaphores.new(permits)

-- Take a permit of `s`, waiting until one is given back if none is free, and
-- until `deadline` if there is one: whether a permit was taken. A deadline
-- that has passed already takes none, even if one is free.
fun acquire(s : Semaphore, deadline : Option Deadline) -> Bool =
    Semaphores.acquire(s, if let Some(d) = deadline { Clock.nanos(Deadline.reading(d)) }
                          else { -1 })

-- Give a permit of `s` back.
fun release(s : Semaphore) -> Unit = Semaphores.release(s)

-- `f()`, holding a permit of `s` while it runs.
fun withPermit(s : Semaphore, f : fun() -> b) -> b {
    let _ = acquire(s, None)
    let made = f()
    release(s)
    made
}

-- -- events --------------------------------------------------------------------------

-- A flag that tasks wait to see raised. `set` raises it and wakes every task
-- waiting, and it stays raised, so every later `wait` returns at once, until
-- `clear` lowers it.
--
--     let ready = Sync.event()
--     ...
--     Sync.set(ready)                     -- in one task
--     Sync.waitUnbounded(ready)           -- in another
--
-- The flag and the waiters are read and written under the scheduler's lock.
-- `waiters` holds a waiter whose deadline ended it until the next `set`, or
-- until a wait finds the list twice as long as after its last pruning.
type Event = Event { var raised : Bool, var waiters : Vec EventWaiter, var pruned : Int }

-- `program` says whether the program's own stack waits, which `set` wakes
-- differently (`Turkey.Wait.wakeEnded`).
type EventWaiter = EventWaiter { waiter : Poll.Waiter, program : Bool }

-- Returns an event, lowered.
fun event() -> Event = Event { raised = False, waiters = [], pruned = 0 }

-- Raises `e`, and wakes every task waiting for it.
fun set(e : Event) -> Unit {
    Scheduler.lock()
    e.raised = True
    for q in e.waiters {
        -- False for a waiter whose deadline ended it.
        if Poll.complete(q.waiter, 0) { Wait.wakeEnded(q.program) }
    }
    e.waiters = []
    e.pruned = 0
    Scheduler.unlock()
}

-- Lowers `e`. A task that waits for it from then on waits for the next `set`.
fun clear(e : Event) -> Unit {
    Scheduler.lock()
    e.raised = False
    Scheduler.unlock()
}

-- Returns whether `e` is raised.
fun isSet(e : Event) -> Bool {
    Scheduler.lock()
    let raised = e.raised
    Scheduler.unlock()
    raised
}

-- Waits until `e` is raised, or until `t` runs out. Returns whether it is
-- raised: at once, even with a deadline that has passed, if it is raised
-- already.
fun wait[Timeout t](e : Event, t : t) -> Bool = waitFor(e, Clock.nanos(Deadline.reading(deadline(t))))

-- Waits until `e` is raised, however long that takes.
fun waitUnbounded(e : Event) -> Unit {
    let _ = waitFor(e, -1)
}

-- `wait` until `deadline` on `Turkey.Wait.now`'s clock, or without limit
-- when it is -1.
fun waitFor(e : Event, deadline : Int) -> Bool {
    if isSet(e) { return True }
    if deadline >= 0 && Wait.now() >= deadline { return False }
    let program = Option.isNone(Co.running())
    let outcome = Wait.parkApart(fun(timer) {
        let w = Poll.sleeper(timer)
        -- Raised since the look above.
        if e.raised {
            let _ = Poll.complete(w, 0)
        } else {
            prune(e)
            Vec.push(e.waiters, EventWaiter { waiter = w, program })
        }
        w
    }, deadline)
    outcome == 0
}

-- Drops the waiters that deadlines ended, once the list has doubled since it
-- was last pruned, so that timed waits on an event never set keep it to
-- twice the waiters still waiting, at a constant cost per wait on average.
fun prune(e : Event) -> Unit {
    if len(e.waiters) < 8 || len(e.waiters) < 2 * e.pruned { return () }
    let kept = []
    for q in e.waiters {
        if !Poll.finished(q.waiter) { Vec.push(kept, q) }
    }
    e.waiters = kept
    e.pruned = len(kept)
}
