export (
    Mutex, mutex, withLock, tryWithLock, update,
    AtomicInt, atomicInt, load, store, addAndGet, compareAndSet,
    Once, once, force,
    Semaphore, semaphore, acquire, release, withPermit,
    Event, event, setEvent, clearEvent, isEventSet, waitEvent, waitEventUnbounded,
    Condition, condition, waitFor, waitForUnbounded, notifyAll,
)

--- What tasks that share data need when they run at once (`System.Task`): a
--- mutex around a value, an integer changed atomically, a value computed once
--- however many tasks ask for it, a count of permits that bounds how many
--- tasks do something at once, a flag that tasks wait to see raised, and a
--- condition on a mutex's value that tasks wait to see hold.
---
--- A task waiting for any of them waits as it does in `Task.join`: it is
--- suspended, and its worker runs other tasks meanwhile. The program's own
--- code waiting for a permit, an event or a condition runs no task
--- meanwhile, since the task that ends its wait may be among them: it sleeps,
--- and the right to run tasks goes to another thread. So nothing here holds
--- up a worker.
---
--- Each keeps its state word in a `Prim.Atomic`, a cell of its own whose every
--- access is atomic.

import Time (Timeout(..))
import Time.Clock as Clock
import Time.Deadline (Deadline)
import Time.Deadline as Deadline
import Turkey.Coroutine as Co
import Turkey.Poll as Poll
import Turkey.Scheduler as Scheduler
import Turkey.Semaphore (Semaphore)
import Turkey.Semaphore as Semaphores
import Turkey.Wait as Wait

-- -- mutex -----------------------------------------------------------------------------

--- A value only one task at a time may use.
---
--- The state is 0 free, 1 held, or 2 held and perhaps waited for. Taking a free
--- mutex is one compare-and-swap; releasing it is a swap, and wakes the waiting
--- tasks only if the old state was 2. A task that cannot take it marks it 2 and
--- waits, as does one woken from among others, so that the release after it
--- looks for waiters too.
---
--- Any task may take a free mutex, including one that just released it:
--- waiters are woken, not handed the mutex, so one that is never quick enough
--- can wait for as long as others keep taking it.
--- `value` may be read only with the mutex held, so `!Debug` keeps a derived
--- `Debug` from reading it.
type Mutex a : !Debug = Mutex {
    state       : AtomicInt,
    var waiters : Vec Co.Coroutine,
    var value   : a,
}

fun mutex(value : a) -> Mutex a = Mutex { state = atomicInt(0), waiters = [], value = value }

--- `f` of the value, with the mutex held.
fun withLock(m : Mutex a, f : fun(a) -> b) -> b {
    lock(m)
    let made = f(m.value)
    unlock(m)
    made
}

--- `Some` of `f` of the value, with the mutex held, if it is free; `None`,
--- without waiting and without calling `f`, if a task holds it.
fun tryWithLock(m : Mutex a, f : fun(a) -> b) -> Option b {
    if !tryLock(m) { return None }
    let made = f(m.value)
    unlock(m)
    Some(made)
}

--- Replace the value with `f` of it, with the mutex held.
fun update(m : Mutex a, f : fun(a) -> a) -> Unit {
    lock(m)
    m.value = f(m.value)
    unlock(m)
}

fun lock(m : Mutex a) -> Unit {
    if tryLock(m) { return {} }
    Scheduler.waitUntil(fun() = claim(m), fun(c) = Vec.push(m.waiters, c))
}

-- Take `m` if it is free, without waiting: whether it was taken.
fun tryLock(m : Mutex a) -> Bool = compareAndSet(m.state, 0, 1)

-- Under the scheduler's lock: take `m` if it is free, or mark it waited for.
fun claim(m : Mutex a) -> Bool {
    let p = m.state
    while True {
        let state = load(p)
        if state == 0 {
            if compareAndSet(p, 0, 2) { return True }
        } else if state == 1 {
            if compareAndSet(p, 1, 2) { return False }
        } else {
            return False
        }
    }
    False
}

fun unlock(m : Mutex a) -> Unit {
    if swap(m.state, 0) != 2 { return {} }
    Scheduler.lock()
    for c in m.waiters { Scheduler.wake(c) }
    m.waiters = []
    Scheduler.changed()
    Scheduler.unlock()
}

fun swap(p : AtomicInt, value : Int) -> Int {
    while True {
        let old = load(p)
        if compareAndSet(p, old, value) { return old }
    }
    0
}

-- -- atomic integers -------------------------------------------------------------------

--- An `Int` that tasks read and change without a mutex. Each operation is one
--- atomic instruction, ordered with the reads and writes around it.
---
type AtomicInt = AtomicInt(Prim.Atomic)

fun atomicInt(initial : Int) -> AtomicInt = AtomicInt(Prim.atomicNew(initial))

fun load(AtomicInt(cell)) -> Int = Prim.atomicGet(cell)

fun store(AtomicInt(cell), value : Int) -> Unit = Prim.atomicSet(cell, value)

--- Adds `n`, and returns the sum. It wraps on overflow, as the instruction does.
fun addAndGet(AtomicInt(cell), n : Int) -> Int =
    Int.addWrapping(Prim.atomicAddTo(cell, n), n)

--- Stores `new` if the value is `expected`, and returns whether it was.
fun compareAndSet(AtomicInt(cell), expected : Int, new : Int) -> Bool =
    Prim.atomicSwapIf(cell, expected, new) == expected

-- -- computed once ---------------------------------------------------------------------

--- A value computed the first time a task asks for it, by that task; the
--- others that ask meanwhile wait for it. The state is 0 not started, 1 being
--- computed, 2 made.
---
--- A computation that asks for its own value waits for itself, which is a
--- deadlock.
--- `made` may be read only once `state` says it is made, so `!Debug` keeps a
--- derived `Debug` from reading it.
type Once a : !Debug = Once {
    state       : AtomicInt,
    compute     : fun() -> a,
    var made    : Option a,
    var waiters : Vec Co.Coroutine,
}

fun once(compute : fun() -> a) -> Once a =
    Once { state = atomicInt(0), compute = compute, made = None, waiters = [] }

fun force(o : Once a) -> a {
    let p = o.state
    if load(p) != 2 {
        if compareAndSet(p, 0, 1) {
            let value = o.compute()
            Scheduler.lock()
            o.made = Some(value)
            store(p, 2)
            for c in o.waiters { Scheduler.wake(c) }
            o.waiters = []
            Scheduler.changed()
            Scheduler.unlock()
        } else {
            Scheduler.waitUntil(fun() = load(p) == 2,
                                fun(c) = Vec.push(o.waiters, c))
        }
    }
    -- Written before the state became 2, which this read after.
    match o.made {
        Some(value) -> value
        None -> error("System.Sync.force: a value marked made is missing")
    }
}

-- -- semaphores ------------------------------------------------------------------------

-- A count of permits that tasks take and give back, which bounds how many do
-- something at once: with `semaphore(4)`, four tasks take a permit each, and a
-- fifth waits until one of them gives its permit back.
--
--     let downloads = Sync.semaphore(4)
--     ...
--     Sync.withPermit(downloads, fun() = fetch(url))
--
-- **In order.** A permit given back goes to the task that has waited longest,
-- of those still waiting; one whose deadline passed is skipped. A permit
-- nobody waits for goes back to the count, and a free permit is taken only
-- when nobody waits for one, so a task that comes later never overtakes one
-- that waits.
--
-- A permit is not tied to the task that took it: any task may give one back.

fun semaphore(permits : Int) -> Semaphore = Semaphores.new(permits)

--- Take a permit of `s`, waiting until one is given back if none is free, and
--- until `deadline` if there is one: whether a permit was taken. A deadline
--- that has passed already takes none, even if one is free.
fun acquire(s : Semaphore, deadline : Option Deadline) -> Bool =
    Semaphores.acquire(s, if let Some(d) = deadline { Clock.nanos(Deadline.reading(d)) }
                          else { -1 })

--- Give a permit of `s` back.
fun release(s : Semaphore) -> Unit = Semaphores.release(s)

--- `f()`, holding a permit of `s` while it runs.
fun withPermit(s : Semaphore, f : fun() -> b) -> b {
    let _ = acquire(s, None)
    let made = f()
    release(s)
    made
}

-- -- waiters -------------------------------------------------------------------------

-- The tasks waiting for an `Event` or a `Condition`, every one of them
-- woken by the next `wakeAll`. Read and written under the scheduler's lock.
-- `list` holds a waiter whose deadline ended it until the next `wakeAll`, or
-- until a wait finds the list twice as long as after its last pruning.
-- Its state is read and written only under its protocol, by tasks that may
-- run in parallel, so `!Debug` keeps a derived `Debug` from reading it.
type Waiters : !Debug = Waiters {
    var list   : Vec Waiter
    var pruned : Int
}

-- `program` is whether the program's own stack waits, which `wakeAll` wakes
-- differently (`Turkey.Wait.complete`).
-- Its state is read and written only under its protocol, by tasks that may
-- run in parallel, so `!Debug` keeps a derived `Debug` from reading it.
type Waiter : !Debug = Waiter {
    waiter  : Poll.Waiter
    program : Bool
}

fun waiters() -> Waiters = Waiters { list = [], pruned = 0 }

-- Ends every wait on `ws`. Under the scheduler's lock.
fun wakeAll(ws : Waiters) -> Unit {
    -- A waiter whose deadline ended it is left as it is.
    for q in ws.list { let _ = Wait.complete(q.waiter, q.program) }
    ws.list = []
    ws.pruned = 0
}

-- Waits on `ws` until a `wakeAll`, or until `deadline` on `Turkey.Wait.now`'s
-- clock, or without limit when it is -1. Returns whether a `wakeAll` ended
-- the wait. Returns `True` without waiting if `woken()` holds when the wait
-- is registered, which is under the scheduler's lock: so the caller states
-- in `woken` what a `wakeAll` since its own look has changed, and that
-- `wakeAll` is never missed.
fun parkOn(ws : Waiters, deadline : Int, woken : fun() -> Bool) -> Bool {
    if deadline >= 0 && Wait.now() >= deadline {
        return False
    }
    let program = Option.isNone(Co.running())
    let outcome = Wait.parkApart(fun(timer) {
        let w = Wait.sleeper(timer)
        if woken() {
            let _ = Wait.complete(w, False)
        } else {
            prune(ws)
            Vec.push(ws.list, Waiter { waiter = w, program })
        }
        w
    }, deadline)
    outcome == 0
}

-- Drops the waiters that deadlines ended, once the list has doubled since it
-- was last pruned, so that timed waits that nothing wakes keep it to twice
-- the waiters still waiting, at a constant cost per wait on average.
fun prune(ws : Waiters) -> Unit {
    if len(ws.list) < 8 || len(ws.list) < 2 * ws.pruned {
        return
    }
    let kept = []
    for q in ws.list {
        if !Wait.finished(q.waiter) {
            Vec.push(kept, q)
        }
    }
    ws.list = kept
    ws.pruned = len(kept)
}

-- Returns `t`'s deadline on `Turkey.Wait.now`'s clock.
fun nanosOf[Timeout t](t : t) -> Int = Clock.nanos(Deadline.reading(deadline(t)))

-- -- events --------------------------------------------------------------------------

--- A flag that tasks wait to see raised. `setEvent` raises it and wakes every
--- task waiting, and it stays raised, so every later `waitEvent` returns at
--- once, until `clearEvent` lowers it.
---
---     let ready = Sync.event()
---     ...
---     Sync.setEvent(ready)                -- in one task
---     Sync.waitEventUnbounded(ready)      -- in another
---
--- The flag is read and written under the scheduler's lock.
--- Its state is read and written only under its protocol, by tasks that may
--- run in parallel, so `!Debug` keeps a derived `Debug` from reading it.
type Event : !Debug = Event {
    var raised : Bool
    waiters    : Waiters
}

--- Returns an event, lowered.
fun event() -> Event = Event { raised = False, waiters = waiters() }

--- Raises `e`, and wakes every task waiting for it.
fun setEvent(e : Event) -> Unit {
    Scheduler.lock()
    e.raised = True
    wakeAll(e.waiters)
    Scheduler.unlock()
}

--- Lowers `e`. A task that waits for it from then on waits for the next
--- `setEvent`.
fun clearEvent(e : Event) -> Unit {
    Scheduler.lock()
    e.raised = False
    Scheduler.unlock()
}

--- Returns whether `e` is raised.
fun isEventSet(e : Event) -> Bool {
    Scheduler.lock()
    let raised = e.raised
    Scheduler.unlock()
    raised
}

--- Waits until `e` is raised, or until `t` runs out. Returns whether it is
--- raised: at once, even with a deadline that has passed, if it is raised
--- already.
fun waitEvent[Timeout t](e : Event, t : t) -> Bool = waitRaised(e, nanosOf(t))

--- Waits until `e` is raised, however long that takes.
fun waitEventUnbounded(e : Event) -> Unit {
    let _ = waitRaised(e, -1)
}

-- `waitEvent` until `deadline` on `Turkey.Wait.now`'s clock, or without
-- limit when it is -1.
fun waitRaised(e : Event, deadline : Int) -> Bool {
    if isEventSet(e) {
        return True
    }
    parkOn(e.waiters, deadline, fun() = e.raised)
}

-- -- conditions ----------------------------------------------------------------------

--- A mutex's value that tasks wait on until it is ready for them. A waiter
--- states what it waits for as a function of the value, run with the mutex
--- held; a task that changes the value calls `notifyAll`, and every waiter
--- runs its function again.
---
---     let jobs = Sync.mutex([])
---     let added = Sync.condition(jobs)
---     ...
---     Sync.withLock(jobs, Vec.push(_, job))          -- in one task
---     Sync.notifyAll(added)
---     ...
---     let job = Sync.waitForUnbounded(added, Vec.pop) -- in another
---
--- Several conditions may share one mutex, one for each kind of change that
--- tasks wait for, so that a change wakes only the tasks it may concern.
---
--- **No notification is lost.** A `notifyAll` made after a waiter's function
--- returned `None`, the mutex still held or not, has that waiter run it
--- again. One made before the function ran finds no waiter, and the function
--- sees the change.
--- Its state is read and written only under its protocol, by tasks that may
--- run in parallel, so `!Debug` keeps a derived `Debug` from reading it.
type Condition a : !Debug = Condition {
    mutex        : Mutex a
    -- Moved by every `notifyAll`, under the scheduler's lock. A waiter that
    -- finds it moved since its function ran has missed a notification.
    var notified : Int
    waiters      : Waiters
}

--- Returns a condition on `m`'s value.
fun condition(m : Mutex a) -> Condition a = Condition { mutex = m, notified = 0, waiters = waiters() }

--- Wakes every task waiting on `c`, to run its function again.
fun notifyAll(c : Condition a) -> Unit {
    Scheduler.lock()
    c.notified = c.notified + 1
    wakeAll(c.waiters)
    Scheduler.unlock()
}

--- Runs `ready` on `c`'s value with the mutex held, and returns the first
--- `Some` it returns: at once, or after a `notifyAll` on `c`. Waits for each
--- `notifyAll` without the mutex. Returns `None` if `ready` still returns
--- `None` once `t` has run out; `ready` runs once more then, so a change
--- made just before the deadline is not missed.
fun waitFor[Timeout t](c : Condition a, t : t, ready : fun(a) -> Option b) -> Option b =
    waitReady(c, nanosOf(t), ready)

--- Runs `ready` as `waitFor` does, however long it takes to return `Some`,
--- and returns what that holds.
fun waitForUnbounded(c : Condition a, ready : fun(a) -> Option b) -> b {
    let Some(made) = waitReady(c, -1, ready) else {
        error("System.Sync.waitForUnbounded: a wait without a deadline ended unready")
    }
    made
}

-- `waitFor` until `deadline` on `Turkey.Wait.now`'s clock, or without
-- limit when it is -1.
fun waitReady(c : Condition a, deadline : Int, ready : fun(a) -> Option b) -> Option b {
    var timedOut = False
    loop {
        -- Read `notified` with the mutex held, so that a change made after
        -- this look, and the `notifyAll` that follows it, moves it.
        let (made, seen) = withLock(c.mutex, fun(value) = (ready(value), notifications(c)))
        if timedOut || Option.isSome(made) {
            return made
        }
        timedOut = !parkOn(c.waiters, deadline, fun() = c.notified != seen)
    }
}

fun notifications(c : Condition a) -> Int {
    Scheduler.lock()
    let n = c.notified
    Scheduler.unlock()
    n
}
