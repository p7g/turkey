module System.Time (monotonic)

-- Time as programs measure it.

import Prelude ()
import Std.Classes
import Target (OS(..))
import Target as Target
import Turkey.Libc as Libc

-- Nanoseconds on a clock that only moves forward, from an arbitrary start: for
-- measuring how long something took, not for telling the time of day.
--
-- The `struct timespec` is the call's own -- seconds, then nanoseconds, a word
-- each on both targets -- so that tasks on several workers can ask at once.
fun monotonic() -> Int {
    let timespec = Libc.malloc(16)
    let _ = Libc.clockGettime(clockMonotonic(), timespec)
    let nanoseconds = Prim.loadI64(timespec, 0) * 1000000000 + Prim.loadI64(timespec, 8)
    Libc.free(timespec)
    nanoseconds
}

-- `CLOCK_MONOTONIC`, from each target's `<time.h>`.
fun clockMonotonic() -> Int = match Target.os {
    Darwin -> 6
    Linux -> 1
}
