module Time (
    Date, TimeOfDay, PlainDateTime, Period(..), Month(..), Weekday(..),
    HasDate(..), HasTime(..), Shift(..),
    year, month, day, weekday, dayOfYear, hour, minute, second, nanosecond,
    years, months, weeks, days,
    module Date, module TimeOfDay, module PlainDateTime, module Period, module Month,
    module Weekday,
)

-- Dates and times. `import Time` brings in the types, the functions every type
-- with a date or a time shares (`year`, `hour`, `shift`, ...), and the period
-- constructors (`days(3)`, `months(1)`), bare; and each type's own functions
-- under its name, `Date.new` or `TimeOfDay.parse`.

import Time.Classes
import Time.Date (Date)
import Time.Date as Date
import Time.Month (Month(..))
import Time.Month as Month
import Time.Period (Period(..), years, months, weeks, days)
import Time.Period as Period
import Time.PlainDateTime (PlainDateTime)
import Time.PlainDateTime as PlainDateTime
import Time.TimeOfDay (TimeOfDay)
import Time.TimeOfDay as TimeOfDay
import Time.Weekday (Weekday(..))
import Time.Weekday as Weekday
