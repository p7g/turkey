module Time.Classes (
    HasDate(..), HasTime(..), Shift(..),
    year, month, day, weekday, dayOfYear, hour, minute, second, nanosecond,
)

-- What the date and time types have in common, as classes, so that one
-- function serves every type that supports it and a type that does not is a
-- missing instance where it is used: `hour` of a `Date`, or `shift` of an
-- instant, fails to type-check.
--
-- Each class has the fewest methods its instances must write, and everything
-- else is written once below in terms of them. The instances live here rather
-- than beside each type so that the types' modules need not import the
-- classes, which keeps the module graph a tree.

import Time.Date (Date)
import Time.Date as Date
import Time.Month (Month)
import Time.Period (Period)
import Time.PlainDateTime (PlainDateTime)
import Time.PlainDateTime as PlainDateTime
import Time.TimeOfDay (TimeOfDay)
import Time.TimeOfDay as TimeOfDay
import Time.Weekday (Weekday)

-- Has a calendar date.
class HasDate a { fun date(a) -> Date }

-- Has a wall-clock time.
class HasTime a { fun timeOfDay(a) -> TimeOfDay }

-- Moves by calendar amounts, keeping its wall-clock time.
class Shift a { fun shift(a, Period) -> a }

instance HasDate Date { fun date(d) = d }
instance HasDate PlainDateTime { fun date(p) = PlainDateTime.date(p) }

instance HasTime TimeOfDay { fun timeOfDay(t) = t }
instance HasTime PlainDateTime { fun timeOfDay(p) = PlainDateTime.timeOfDay(p) }

instance Shift Date { fun shift(d, p) = Date.shift(d, p) }
instance Shift PlainDateTime { fun shift(x, p) = PlainDateTime.shift(x, p) }

fun year[HasDate a](x : a) -> Int = Date.year(date(x))
fun month[HasDate a](x : a) -> Month = Date.month(date(x))
fun day[HasDate a](x : a) -> Int = Date.day(date(x))
fun weekday[HasDate a](x : a) -> Weekday = Date.weekday(date(x))
fun dayOfYear[HasDate a](x : a) -> Int = Date.dayOfYear(date(x))

fun hour[HasTime a](x : a) -> Int = TimeOfDay.hour(timeOfDay(x))
fun minute[HasTime a](x : a) -> Int = TimeOfDay.minute(timeOfDay(x))
fun second[HasTime a](x : a) -> Int = TimeOfDay.second(timeOfDay(x))
fun nanosecond[HasTime a](x : a) -> Int = TimeOfDay.nanosecond(timeOfDay(x))
