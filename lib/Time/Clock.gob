module Time.Clock (realtime, monotonic)

-- The two clocks the system keeps, as nanoseconds. The library reads them
-- here and nowhere else, and hands them out only inside a type that says
-- which clock it was: `Instant` for the first, `Stopwatch` and `Deadline` for
-- the second.

import Target (OS(..))
import Target as Target
import Turkey.Libc as Libc

-- Nanoseconds since 1970-01-01T00:00Z by the system clock, which may be set
-- back or forward while the program runs. `CLOCK_REALTIME` is 0 on both
-- targets.
fun realtime() -> Int = read(0)

-- Nanoseconds on a clock that only moves forward, at a steady rate, from an
-- arbitrary start.
fun monotonic() -> Int = read(clockMonotonic())

-- `CLOCK_MONOTONIC`, from each target's `<time.h>`.
fun clockMonotonic() -> Int = match Target.os {
    Darwin -> 6
    Linux -> 1
}

-- The `struct timespec` is the call's own -- seconds, then nanoseconds, a
-- word each on both targets -- so that tasks on several workers can ask at
-- once.
fun read(clock : Int) -> Int {
    let timespec = Libc.malloc(16)
    let _ = Libc.clockGettime(clock, timespec)
    let nanoseconds = Prim.loadI64(timespec, 0) * 1000000000 + Prim.loadI64(timespec, 8)
    Libc.free(timespec)
    nanoseconds
}
