module Time.Clock (Reading, realtime, monotonic, later, between)

-- The two clocks the system keeps. The library reads them here and nowhere
-- else, and each reading comes out as a type that says which clock it was: an
-- `Instant` for the first, a `Reading` for the second, which `Stopwatch` and
-- `Deadline` are made of.

import Target (OS(..))
import Target as Target
import Time.Duration (Duration)
import Time.Duration as Duration
import Time.Instant (Instant)
import Time.Instant as Instant
import Turkey.Libc as Libc

-- A reading of the monotonic clock: nanoseconds from an arbitrary start, so it
-- means something only next to another reading.
type Reading = Reading(Int)

-- The system clock, which may be set back or forward while the program runs.
-- `CLOCK_REALTIME` is 0 on both targets.
fun realtime() -> Instant = Instant.fromUnixNanos(read(0))

-- The clock that only moves forward, at a steady rate.
fun monotonic() -> Reading = Reading(read(clockMonotonic()))

-- The reading `d` after `r`.
fun later(Reading(r), d : Duration) -> Reading = Reading(r + Duration.toNanos(d))

-- The time from `from` to `to`: negative if `to` is earlier.
fun between(Reading(from), Reading(to)) -> Duration = Duration.nanos(to - from)

instance Eq Reading { fun eq(Reading(a), Reading(b)) = a == b }

instance Ord Reading { fun lt(Reading(a), Reading(b)) = a < b }

-- `CLOCK_MONOTONIC`, from each target's `<time.h>`.
fun clockMonotonic() -> Int = match Target.os {
    Darwin -> 6
    Linux -> 1
}

-- The `struct timespec` is the call's own -- seconds, then nanoseconds, a
-- word each on both targets -- so that tasks on several workers can ask at
-- once.
fun read(clock : Int) -> Int {
    let timespec = Libc.malloc(16)
    let _ = Libc.clockGettime(clock, timespec)
    let nanoseconds = Prim.loadI64(timespec, 0) * 1000000000 + Prim.loadI64(timespec, 8)
    Libc.free(timespec)
    nanoseconds
}
