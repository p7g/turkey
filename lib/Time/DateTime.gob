module Time.DateTime (
    DateTime, Resolution(..), now, of, resolve, fromInstant, instant, plain, zone, offset,
    inZone, after, shift, startOfDay, parse,
)

-- An instant in a time zone: when something happens at a place. It has both
-- a position on the timeline and a reading of the calendar and the clock, and
-- moves both ways -- by elapsed time with `after`, and by the calendar with
-- `shift`, which keeps the wall-clock time across a change to daylight saving
-- time.
--
-- The offset is worked out when a value is made, so reading the calendar or
-- the clock is integer arithmetic with no look-up in the zone's rules.
--
-- A wall-clock reading does not always name exactly one instant: when the
-- clocks go forward an hour of readings is skipped, and when they go back an
-- hour is repeated. `resolve` says which happened; everything that turns a
-- reading into a `DateTime` by itself -- `of`, `shift` -- settles it the way
-- RFC 5545 does: by the offset in force before the transition. A skipped
-- reading lands as far after the transition as it was meant to be after the
-- last reading before it, and a repeated one is its first occurrence.

import Time.Date as Date
import Time.Duration (Duration)
import Time.Duration as Duration
import Time.Frame (LocalSeconds, UnixSeconds)
import Time.Frame as Frame
import Time.Instant (Instant)
import Time.Instant as Instant
import Time.Iso as Iso
import Time.Offset (Offset)
import Time.Offset as Offset
import Time.Period (Period)
import Time.PlainDateTime (PlainDateTime)
import Time.PlainDateTime as PlainDateTime
import Time.TimeOfDay as TimeOfDay
import Time.Zone (Zone)
import Time.Zone as Zone

type DateTime = DateTime { instant : Instant, offset : Offset, zone : Zone }

-- What a wall-clock reading names in a zone: one instant; none, because the
-- clocks skipped over it -- `forward` reads it with the offset before the
-- transition, `backward` with the one after, and `at` is the transition
-- itself, the first instant after the gap; or two, because the clocks went
-- back over it.
type Resolution = Unique(DateTime)
                | Skipped { forward : DateTime, backward : DateTime, at : DateTime }
                | Repeated { earlier : DateTime, later : DateTime }

fun fromInstant(i : Instant, z : Zone) -> DateTime =
    DateTime { instant = i, offset = Zone.offsetAt(z, i), zone = z }

-- The time now in `z`. There is no form without a zone: which zone a program
-- runs in is the system's setting, and `Zone.system()` says so where it is
-- used.
fun now(z : Zone) -> DateTime = fromInstant(Instant.now(), z)

fun instant(dt : DateTime) -> Instant = dt.instant
fun zone(dt : DateTime) -> Zone = dt.zone
fun offset(dt : DateTime) -> Offset = dt.offset

-- The calendar and clock reading.
fun plain(dt : DateTime) -> PlainDateTime {
    let local = Frame.toLocal(Frame.fromInstant(dt.instant), dt.offset)
    let d = Option.expect(Date.fromDayNumber(Frame.day(local)), "in range")
    let since = Frame.sinceMidnight(local) + Duration.nanos(Frame.fraction(dt.instant))
    PlainDateTime.new(d, Option.expect(TimeOfDay.afterMidnight(since), "in range"))
}

-- The same instant in another zone.
fun inZone(dt : DateTime, z : Zone) -> DateTime = fromInstant(dt.instant, z)

fun after(dt : DateTime, d : Duration) -> DateTime = fromInstant(Instant.after(dt.instant, d), dt.zone)

-- What the reading `p` names in `z`.
fun resolve(p : PlainDateTime, z : Zone) -> Resolution {
    let local = localSeconds(p)
    let nanos = TimeOfDay.nanosecond(PlainDateTime.timeOfDay(p))
    -- The instant `t` and its fraction of a second, shown with the offset `o`.
    let make = fun(t : UnixSeconds, o : Offset) = DateTime {
        instant = Option.expect(Frame.toInstant(t, nanos), "DateTime: outside the range of an Instant"),
        offset = o,
        zone = z,
    }
    -- An instant reads as `local` only at an offset some zone can have, so it
    -- lies between the instants the extreme offsets give: the candidates are
    -- the offset in force at the start of that window and the one after each
    -- transition in it, and a candidate holds if it is in force at the instant
    -- it gives.
    let earliest = Frame.toUnix(local, Offset.max)
    let changes = Zone.transitions(z, earliest, Frame.toUnix(local, Offset.min))
    var valid = []
    for o in [Zone.offsetAtSecond(z, earliest)] + Array.map(changes, fun(c) = c.after) {
        if Zone.offsetAtSecond(z, Frame.toUnix(local, o)) == o && !Array.contains(valid, o) {
            valid = valid + [o]
        }
    }
    if len(valid) == 1 { return Unique(make(Frame.toUnix(local, valid[0]), valid[0])) }
    if len(valid) > 1 {
        let sorted = Array.sort(valid)
        -- The larger offset reads `local` at the earlier instant.
        let largest = sorted[len(sorted) - 1]
        return Repeated {
            earlier = make(Frame.toUnix(local, largest), largest),
            later = make(Frame.toUnix(local, sorted[0]), sorted[0]),
        }
    }
    for c in changes {
        if Frame.toLocal(c.at, c.before) <= local && local < Frame.toLocal(c.at, c.after) {
            return Skipped {
                forward = make(Frame.toUnix(local, c.before), c.after),
                backward = make(Frame.toUnix(local, c.after), c.before),
                at = DateTime {
                    instant = Option.expect(Frame.toInstant(c.at, 0), "DateTime: outside the range of an Instant"),
                    offset = c.after,
                    zone = z,
                },
            }
        }
    }
    error("DateTime.resolve: a reading with no instant and no gap around it")
}

-- `p` on the clock, to the second.
fun localSeconds(p : PlainDateTime) -> LocalSeconds {
    let day = Date.dayNumber(PlainDateTime.date(p))
    Frame.local(day, TimeOfDay.sinceMidnight(PlainDateTime.timeOfDay(p)))
}

-- The reading `p` in `z`, settled by the offset before a transition if the
-- clocks skipped or repeated it: 02:30 on the night the clocks go forward from
-- 02:00 to 03:00 is 03:30, and 01:30 on the night they go back is the first
-- 01:30. `resolve` says which happened, for a caller that must decide itself.
fun of(p : PlainDateTime, z : Zone) -> DateTime = match resolve(p, z) {
    Unique(dt) -> dt
    Skipped { forward, .. } -> forward
    Repeated { earlier, .. } -> earlier
}

-- Shifts the calendar reading and keeps the clock reading, resolving the
-- result as `of` does, except that a repeated reading keeps the offset `dt`
-- had if it can: shifting the second 01:30 of a night by nothing gives the
-- second 01:30, not the first.
fun shift(dt : DateTime, by : Period) -> DateTime =
    match resolve(PlainDateTime.shift(plain(dt), by), dt.zone) {
        Unique(x) -> x
        Skipped { forward, .. } -> forward
        Repeated { earlier, later } -> if later.offset == dt.offset { later } else { earlier }
    }

-- The first instant of `dt`'s day in its zone. Not always midnight: where the
-- clocks went forward at midnight, the day starts at the first instant after
-- the gap, never extrapolated across it; where midnight was repeated, at the
-- first one.
fun startOfDay(dt : DateTime) -> DateTime {
    let midnight = PlainDateTime.new(PlainDateTime.date(plain(dt)), TimeOfDay.midnight)
    match resolve(midnight, dt.zone) {
        Unique(x) -> x
        Skipped { at, .. } -> at
        Repeated { earlier, .. } -> earlier
    }
}

instance Eq DateTime {
    fun eq(a, b) = a.instant == b.instant && Zone.id(a.zone) == Zone.id(b.zone)
}

-- By instant, then by zone id, so that the order agrees with `==` and sorts
-- chronologically.
instance Ord DateTime {
    fun lt(a, b) = a.instant < b.instant || (a.instant == b.instant && Zone.id(a.zone) < Zone.id(b.zone))
}

instance Hash DateTime {
    fun hashInto(dt, h) {
        hashInto(dt.instant, h)
        hashInto(Zone.id(dt.zone), h)
    }
}

-- RFC 9557: the reading, its offset, and the zone in brackets,
-- `2026-10-18T14:03:07.52-04:00[America/Toronto]`.
instance Show DateTime {
    fun show(dt) = show(plain(dt)) + show(dt.offset) + "[" + Zone.id(dt.zone) + "]"
}

-- RFC 9557, as `show` writes it. The bracketed zone is required: a zone name,
-- or an offset for a fixed zone. The offset must be the one the zone has at
-- that reading -- if the zone's rules have changed since the text was written,
-- the text no longer says one instant, and this is `None` -- unless it is `Z`,
-- which says only the instant. A zone the system has no file for is `None`.
fun parse(s : String) -> Option DateTime {
    let r = Iso.reader(s)
    let p = PlainDateTime.read(r)?
    let exact = Iso.looking(r, 'Z') || Iso.looking(r, 'z')
    let written = Iso.offset(r)?
    Iso.expect(r, '[')?
    let _ = Iso.accept(r, '!')
    let name = Iso.upTo(r, ']')?
    Iso.expect(r, ']')?
    if !Iso.finished(r) { return None }
    let z = zoneNamed(name)?
    let nanos = TimeOfDay.nanosecond(PlainDateTime.timeOfDay(p))
    let dt = fromInstant(Frame.toInstant(Frame.toUnix(localSeconds(p), written), nanos)?, z)
    if !exact && dt.offset != written { return None }
    Some(dt)
}

fun zoneNamed(name : String) -> Option Zone {
    if name == "UTC" { return Some(Zone.utc) }
    if String.startsWith(name, "+") || String.startsWith(name, "-") {
        return Option.map(Offset.parse(name), Zone.fixed)
    }
    match Zone.named(name) {
        Right(z) -> Some(z)
        Left(_) -> None
    }
}
