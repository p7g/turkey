module Time.Deadline (Deadline, after, remaining, passed)

-- A point ahead on the monotonic clock, for a limit on how long something may
-- take: made once, from a `Duration`, and then asked how much time is left,
-- so that a limit on a whole operation can be handed to each step of it.
-- Like a `Stopwatch`, it reads the clock that only moves forward, so setting
-- the system clock neither cuts it short nor stretches it, and it does not
-- turn into an `Instant`.
--
-- `<` orders deadlines by when they fall, so the tighter of two is the lesser.

import Time.Clock as Clock
import Time.Duration (Duration)
import Time.Duration as Duration

type Deadline = Deadline(Int)

-- The deadline `d` from now.
fun after(d : Duration) -> Deadline = Deadline(Clock.monotonic() + Duration.toNanos(d))

-- The time left before `dl`, and zero once it has passed: never negative, so
-- that handing it on as a timeout cannot ask for a negative wait, which some
-- system calls read as waiting forever.
fun remaining(Deadline(at)) -> Duration {
    let left = at - Clock.monotonic()
    Duration.nanos(if left > 0 { left } else { 0 })
}

-- Whether `dl` has passed.
fun passed(Deadline(at)) -> Bool = Clock.monotonic() >= at

instance Eq Deadline { fun eq(Deadline(a), Deadline(b)) = a == b }

instance Ord Deadline { fun lt(Deadline(a), Deadline(b)) = a < b }
