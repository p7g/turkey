module Time.Duration (
    Duration, hours, minutes, seconds, millis, micros, nanos, zero,
    times, divide, toNanos, toSeconds, parse,
)

-- An exact amount of elapsed time, to the nanosecond: the distance between two
-- points on the timeline. Stored as a count of nanoseconds, so it spans about
-- 292 years either way, and arithmetic on it panics on overflow as `Int`'s
-- does.
--
-- There is no unit of days. A day on the calendar is 23, 24 or 25 hours long
-- depending on the zone and the date; "one day later" is a calendar shift by a
-- `Period`, and "24 hours later" is written as that.

import Time.ISO as ISO

type Duration = Duration(Int)

let perMicro : Int = 1000
let perMilli : Int = 1000000
let perSecond : Int = 1000000000
let perMinute : Int = 60 * perSecond
let perHour : Int = 60 * perMinute

fun hours(n : Int) -> Duration = Duration(n * perHour)
fun minutes(n : Int) -> Duration = Duration(n * perMinute)
fun seconds(n : Int) -> Duration = Duration(n * perSecond)
fun millis(n : Int) -> Duration = Duration(n * perMilli)
fun micros(n : Int) -> Duration = Duration(n * perMicro)
fun nanos(n : Int) -> Duration = Duration(n)

let zero : Duration = Duration(0)

fun toNanos(Duration(n)) -> Int = n

-- Whole seconds, rounded toward zero.
fun toSeconds(Duration(n)) -> Int = n / perSecond

-- `Mul` and `Div` take two values of one type, and a duration times a
-- duration is not a duration, so scaling is by name.
fun times(Duration(n), k : Int) -> Duration = Duration(n * k)

-- Rounded toward zero, to the nanosecond.
fun divide(Duration(n), k : Int) -> Duration = Duration(n / k)

instance Eq Duration { fun eq(a, b) = toNanos(a) == toNanos(b) }

instance Ord Duration { fun lt(a, b) = toNanos(a) < toNanos(b) }

instance Hash Duration { fun hashInto(d, h) = hashInto(toNanos(d), h) }

instance Add Duration { fun add(a, b) = Duration(toNanos(a) + toNanos(b)) }

instance Sub Duration { fun sub(a, b) = Duration(toNanos(a) - toNanos(b)) }

instance Neg Duration { fun neg(d) = Duration(-toNanos(d)) }

-- ISO 8601, with hours as the largest unit: `PT1H30M`, `PT0.25S`, `PT0S` for
-- zero, and a leading `-` for a negative duration, `-PT5M`.
instance Show Duration {
    fun show(d) {
        let n = toNanos(d)
        if n == 0 { return "PT0S" }
        -- The magnitude of each part separately, since `-n` overflows for the
        -- most negative duration and its parts do not.
        let whole = Int.abs(n / perSecond)
        let fraction = Int.abs(n % perSecond)
        var out = if n < 0 { "-PT" } else { "PT" }
        if whole >= 3600 { out = out + Int.toString(whole / 3600) + "H" }
        if whole / 60 % 60 != 0 { out = out + Int.toString(whole / 60 % 60) + "M" }
        if whole % 60 != 0 || fraction != 0 {
            out = out + Int.toString(whole % 60) + ISO.fractionText(fraction) + "S"
        }
        out
    }
}

-- ISO 8601 time-based durations: `PT1H30M`, `PT90M`, `PT1.5S`, an optional sign
-- before the `P`, at least one of the fields in the order H, M, S, and a
-- fraction on the seconds only. A date part (`P1D`) is not a duration, and an
-- amount too large to hold is `None`.
fun parse(s : String) -> Option Duration {
    let r = ISO.reader(s)
    let sign = ISO.sign(r)
    ISO.expect(r, 'P')?
    ISO.expect(r, 'T')?
    if ISO.finished(r) { return None }
    var total = 0
    var next = 0
    while !ISO.finished(r) {
        let n = ISO.someDigits(r)?
        let fraction = ISO.fraction(r)?
        var scale = None
        while next < len(units) && scale == None {
            let (unit, per) = units[next]
            if ISO.accept(r, unit) { scale = Some(per) }
            next = next + 1
        }
        let per = scale?
        if fraction != 0 && per != perSecond { return None }
        let amount = Int.addChecked(Int.mulChecked(n, per)?, fraction)?
        total = Int.addChecked(total, amount)?
    }
    Some(Duration(sign * total))
}

-- The fields `parse` accepts, in the order they must appear.
let units : Array (Char, Int) = [('H', perHour), ('M', perMinute), ('S', perSecond)]
