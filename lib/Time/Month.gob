module Time.Month (Month(..), number, fromNumber)

-- A month of the ISO calendar. A sum rather than an `Int`, so that a month
-- out of range is a type error where it is written rather than a check at run
-- time.

type Month = Jan | Feb | Mar | Apr | May | Jun | Jul | Aug | Sep | Oct | Nov | Dec

-- 1 for January through 12 for December.
fun number(m : Month) -> Int = match m {
    Jan -> 1
    Feb -> 2
    Mar -> 3
    Apr -> 4
    May -> 5
    Jun -> 6
    Jul -> 7
    Aug -> 8
    Sep -> 9
    Oct -> 10
    Nov -> 11
    Dec -> 12
}

fun fromNumber(n : Int) -> Option Month = match n {
    1 -> Some(Jan)
    2 -> Some(Feb)
    3 -> Some(Mar)
    4 -> Some(Apr)
    5 -> Some(May)
    6 -> Some(Jun)
    7 -> Some(Jul)
    8 -> Some(Aug)
    9 -> Some(Sep)
    10 -> Some(Oct)
    11 -> Some(Nov)
    12 -> Some(Dec)
    _ -> None
}

instance Eq Month { fun eq(a, b) = number(a) == number(b) }

instance Ord Month { fun lt(a, b) = number(a) < number(b) }

instance Hash Month { fun hashInto(m, h) = hashInto(number(m), h) }

instance Show Month {
    fun show(m) = match m {
        Jan -> "Jan"
        Feb -> "Feb"
        Mar -> "Mar"
        Apr -> "Apr"
        May -> "May"
        Jun -> "Jun"
        Jul -> "Jul"
        Aug -> "Aug"
        Sep -> "Sep"
        Oct -> "Oct"
        Nov -> "Nov"
        Dec -> "Dec"
    }
}
