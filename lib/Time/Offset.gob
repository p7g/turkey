module Time.Offset (Offset, fromSeconds, toSeconds, utc, parse, text)

-- A difference from UTC, to the second: `-04:00` for New York in summer. East
-- of Greenwich is positive. Less than 26 hours either way, the range a POSIX
-- time zone rule can state.

import Time.Iso as Iso

type Offset = Offset(Int)

-- The offset of `n` seconds east of UTC, if it is less than 26 hours.
fun fromSeconds(n : Int) -> Option Offset =
    if n <= -limit || n >= limit { None } else { Some(Offset(n)) }

let limit : Int = 26 * 3600

fun toSeconds(Offset(n)) -> Int = n

let utc : Offset = Offset(0)

instance Eq Offset { fun eq(a, b) = toSeconds(a) == toSeconds(b) }

instance Ord Offset { fun lt(a, b) = toSeconds(a) < toSeconds(b) }

instance Hash Offset { fun hashInto(o, h) = hashInto(toSeconds(o), h) }

instance Show Offset { fun show(o) = text(toSeconds(o)) }

-- `+05:30`, `-04:00`, and `+00:00` for UTC; with seconds, `-04:56:02`, only
-- if there are any, which happens in old local mean times.
fun text(seconds : Int) -> String {
    let magnitude = Int.abs(seconds)
    let hm = Iso.padded(magnitude / 3600, 2) + ":" + Iso.padded(magnitude / 60 % 60, 2)
    let s = if magnitude % 60 == 0 { "" } else { ":" + Iso.padded(magnitude % 60, 2) }
    (if seconds < 0 { "-" } else { "+" }) + hm + s
}

-- The form `show` writes, or `Z` for UTC.
fun parse(s : String) -> Option Offset {
    let r = Iso.reader(s)
    let n = Iso.offset(r)?
    if Iso.finished(r) { fromSeconds(n) } else { None }
}
