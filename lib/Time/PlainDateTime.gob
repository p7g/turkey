module Time.PlainDateTime (PlainDateTime, new, date, timeOfDay, shift, parse, read)

-- A date and a wall-clock time with no time zone: "the 15th of next month at
-- 09:00", wherever that turns out to be.
--
-- It moves only by a `Period`. There is no elapsed-time arithmetic: without a
-- zone it is not a point on the timeline, so "three hours later" has no single
-- answer -- across a change to daylight saving time the wall clock moves by
-- two hours or by four.

import Time.Date (Date)
import Time.Date as Date
import Time.ISO as ISO
import Time.Period (Period)
import Time.TimeOfDay (TimeOfDay)
import Time.TimeOfDay as TimeOfDay

type PlainDateTime = PlainDateTime { date : Date, time : TimeOfDay }

fun new(d : Date, t : TimeOfDay) -> PlainDateTime = PlainDateTime { date = d, time = t }

fun date(p : PlainDateTime) -> Date = p.date

fun timeOfDay(p : PlainDateTime) -> TimeOfDay = p.time

-- Shifts the date, keeping the time.
fun shift(p : PlainDateTime, by : Period) -> PlainDateTime =
    PlainDateTime { date = Date.shift(p.date, by), time = p.time }

instance Eq PlainDateTime { fun eq(a, b) = a.date == b.date && a.time == b.time }

instance Ord PlainDateTime {
    fun lt(a, b) = a.date < b.date || (a.date == b.date && a.time < b.time)
}

instance Hash PlainDateTime {
    fun hashInto(p, h) {
        hashInto(p.date, h)
        hashInto(p.time, h)
    }
}

-- ISO 8601: `2026-10-18T09:30:00`.
instance Show PlainDateTime { fun show(p) = show(p.date) + "T" + show(p.time) }

-- A date, `T`, and a time in any form `TimeOfDay.parse` reads. An offset or a
-- zone is not accepted: text that names one is not a plain date and time.
fun parse(s : String) -> Option PlainDateTime {
    let r = ISO.reader(s)
    let p = read(r)?
    if ISO.finished(r) { Some(p) } else { None }
}

fun read(r : ISO.Reader) -> Option PlainDateTime {
    let d = Date.read(r)?
    ISO.expect(r, 'T')?
    Some(new(d, TimeOfDay.read(r)?))
}
