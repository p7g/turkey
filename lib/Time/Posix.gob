module Time.Posix (Rule, parse, offsetAt, transitions)

-- POSIX time zone rules, the `TZ` form: `EST5EDT,M3.2.0,M11.1.0` is five hours
-- west of UTC, and an hour less from 02:00 on the second Sunday of March to
-- 02:00 on the first Sunday of November. A TZif file ends with one of these,
-- which gives every transition after its table runs out; files written in the
-- default "slim" form rely on it for every year with a recurring rule.
--
-- Offsets are stored as seconds east of UTC, the opposite of the sign the text
-- uses. The extensions TZif version 3 allows are read: a transition time from
-- -167 to 167 hours, so that a rule can fall on the day before or after.

import Time.Calendar as Calendar
import Time.Iso as Iso
import Time.Month as Month

type Rule = Rule { standard : Int, dst : Option Dst }

-- Daylight saving time: its offset, and when it starts and ends, each a day of
-- the year and a time of day on the clock in force before it.
type Dst = Dst { offset : Int, start : Day, startTime : Int, end : Day, endTime : Int }

-- `Jn`, the nth day counting March 1 as day 60 in every year; `n`, counting
-- from 0 and counting February 29; `Mm.w.d`, the dth day of the week (Sunday
-- is 0) of the wth week of month m, where week 5 is the last.
type Day = Julian(Int) | Ordinal(Int) | WeekOf(Int, Int, Int)

fun parse(s : String) -> Option Rule {
    let r = Iso.reader(s)
    name(r)?
    let standard = -clock(r, 24)?
    if Iso.finished(r) { return Some(Rule { standard, dst = None }) }
    name(r)?
    -- With no offset of its own, daylight saving time is an hour ahead.
    let offset = if Iso.finished(r) || Iso.looking(r, ',') {
        standard + 3600
    } else {
        -clock(r, 24)?
    }
    -- With no rules, the United States' since 2007. POSIX leaves this case to
    -- the system; a TZif footer with daylight saving time always has rules, so
    -- only a hand-written `TZ` reaches it.
    let days = if Iso.finished(r) {
        Some((WeekOf(3, 2, 0), 7200, WeekOf(11, 1, 0), 7200))
    } else {
        rules(r)
    }
    let (start, startTime, end, endTime) = days?
    if !Iso.finished(r) { return None }
    Some(Rule { standard, dst = Some(Dst { offset, start, startTime, end, endTime }) })
}

-- The two rules after the comma, with the comma.
fun rules(r : Iso.Reader) -> Option (Day, Int, Day, Int) {
    Iso.expect(r, ',')?
    let start = day(r)?
    let startTime = if Iso.accept(r, '/') { clock(r, 167)? } else { 7200 }
    Iso.expect(r, ',')?
    let end = day(r)?
    let endTime = if Iso.accept(r, '/') { clock(r, 167)? } else { 7200 }
    Some((start, startTime, end, endTime))
}

-- A zone abbreviation: three or more letters, or anything but `>` inside
-- `<...>`, which is how `<+0330>` is written.
fun name(r : Iso.Reader) -> Option Unit {
    if Iso.accept(r, '<') {
        var count = 0
        while !Iso.accept(r, '>') {
            Iso.skip(r)?
            count = count + 1
        }
        if count < 3 { None } else { Some(()) }
    } else {
        var count = 0
        while Iso.letter(r) { count = count + 1 }
        if count < 3 { None } else { Some(()) }
    }
}

-- `[+-]hh[:mm[:ss]]` as seconds, with hours up to `maxHours`.
fun clock(r : Iso.Reader, maxHours : Int) -> Option Int {
    let sign = Iso.sign(r)
    let h = Iso.someDigits(r)?
    let m = if Iso.accept(r, ':') { Iso.digits(r, 2)? } else { 0 }
    let s = if Iso.accept(r, ':') { Iso.digits(r, 2)? } else { 0 }
    if h > maxHours || m > 59 || s > 59 { return None }
    Some(sign * ((h * 60 + m) * 60 + s))
}

fun day(r : Iso.Reader) -> Option Day {
    if Iso.accept(r, 'J') {
        let n = Iso.someDigits(r)?
        if n < 1 || n > 365 { None } else { Some(Julian(n)) }
    } else if Iso.accept(r, 'M') {
        let m = Iso.someDigits(r)?
        Iso.expect(r, '.')?
        let w = Iso.someDigits(r)?
        Iso.expect(r, '.')?
        let d = Iso.someDigits(r)?
        if m < 1 || m > 12 || w < 1 || w > 5 || d > 6 { None } else { Some(WeekOf(m, w, d)) }
    } else {
        let n = Iso.someDigits(r)?
        if n > 365 { None } else { Some(Ordinal(n)) }
    }
}

-- The day number of `d` in `year`.
fun dayOf(d : Day, year : Int) -> Int {
    let first = Calendar.daysFromCivil(year, Month.Jan, 1)
    match d {
        Julian(n) -> first + n - 1 + (if Calendar.isLeapYear(year) && n >= 60 { 1 } else { 0 })
        Ordinal(n) -> first + n
        WeekOf(m, w, wd) -> {
            let month = Option.expect(Month.fromNumber(m), "month in range")
            let start = Calendar.daysFromCivil(year, month, 1)
            -- 1970-01-01, day 0, was a Thursday: day 4 counting Sunday as 0.
            var n = start + Int.mod(wd - Int.mod(start + 4, 7), 7) + 7 * (w - 1)
            while n >= start + Calendar.daysInMonth(year, month) { n = n - 7 }
            n
        }
    }
}

-- The transitions in `year`, in order: each as the second it happens, in Unix
-- seconds, the offset before it, and the offset after it.
fun transitions(rule : Rule, year : Int) -> Array (Int, Int, Int) = match rule.dst {
    None -> []
    Some(d) -> {
        let start = dayOf(d.start, year) * 86400 + d.startTime - rule.standard
        let end = dayOf(d.end, year) * 86400 + d.endTime - d.offset
        let begins = (start, rule.standard, d.offset)
        let ends = (end, d.offset, rule.standard)
        if start <= end { [begins, ends] } else { [ends, begins] }
    }
}

-- The offset in force at `t`, in Unix seconds.
fun offsetAt(rule : Rule, t : Int) -> Int {
    if let None = rule.dst { return rule.standard }
    -- The transitions of the year before and after as well, so that a rule
    -- whose times push a transition across New Year is still found.
    let year = Calendar.civilFromDays(Calendar.floorDiv(t + rule.standard, 86400)).0
    var offset = None
    var first = None
    for y in [year - 1, year, year + 1] {
        for transition in transitions(rule, y) {
            let (at, before, after) = transition
            if first == None { first = Some(before) }
            if at <= t { offset = Some(after) }
        }
    }
    Option.unwrapOr(offset, Option.unwrapOr(first, rule.standard))
}
