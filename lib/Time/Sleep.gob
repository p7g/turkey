export (sleep, sleepUntil)

--- Pausing for a time: `sleep` for a duration from now, `sleepUntil` for a
--- deadline. A sleeping task does not hold its worker, so other tasks run
--- meanwhile; from the program's own code, outside any task, the wait runs
--- other tasks until the time has passed. The time is read on the monotonic
--- clock, so setting the system clock neither shortens nor lengthens a sleep.

import Time.Clock as Clock
import Time.Deadline (Deadline)
import Time.Deadline as Deadline
import Time.Duration (Duration)
import Turkey.Wait as Wait

--- Return once `d` has passed. A zero or negative `d` returns at once.
fun sleep(d : Duration) -> Unit = sleepUntil(Deadline.after(d))

--- Return once `dl` has passed.
fun sleepUntil(dl : Deadline) -> Unit = Wait.sleepUntil(Clock.nanos(Deadline.reading(dl)))
