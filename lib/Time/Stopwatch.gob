module Time.Stopwatch (Stopwatch, start, elapsed)

-- A reading of the monotonic clock, for measuring how long something takes.
-- That clock only moves forward, at a steady rate, from an arbitrary start;
-- the system clock an `Instant` reads can be set back or forward while a
-- program runs, so the difference between two instants is not a measurement.
-- A stopwatch has no date and does not turn into an instant.

import Target (OS(..))
import Target as Target
import Time.Duration (Duration)
import Time.Duration as Duration
import Turkey.Libc as Libc

type Stopwatch = Stopwatch(Int)

fun start() -> Stopwatch = Stopwatch(monotonic())

-- The time since `sw` was started.
fun elapsed(Stopwatch(started)) -> Duration = Duration.nanos(monotonic() - started)

instance Eq Stopwatch { fun eq(Stopwatch(a), Stopwatch(b)) = a == b }

instance Ord Stopwatch { fun lt(Stopwatch(a), Stopwatch(b)) = a < b }

-- Nanoseconds on the monotonic clock. The `struct timespec` is the call's own
-- -- seconds, then nanoseconds, a word each on both targets -- so that tasks
-- on several workers can ask at once.
fun monotonic() -> Int {
    let timespec = Libc.malloc(16)
    let _ = Libc.clockGettime(clockMonotonic(), timespec)
    let nanoseconds = Prim.loadI64(timespec, 0) * 1000000000 + Prim.loadI64(timespec, 8)
    Libc.free(timespec)
    nanoseconds
}

-- `CLOCK_MONOTONIC`, from each target's `<time.h>`.
fun clockMonotonic() -> Int = match Target.os {
    Darwin -> 6
    Linux -> 1
}
