module Time.TimeOfDay (
    TimeOfDay, new, withNanosecond, midnight, fromNanosOfDay, nanosOfDay,
    hour, minute, second, nanosecond, parse, read,
)

-- A time on a wall clock, with no date and no time zone: "opens at 09:00".
-- From 00:00 up to but not including 24:00, to the nanosecond.
--
-- Stored as nanoseconds since midnight. There is no arithmetic with a
-- `Duration`: a wall-clock time has no timeline, and the time that passes
-- between two readings depends on the day and the zone.

import Time.Iso as Iso

type TimeOfDay = TimeOfDay(Int)

let nanosPerSecond : Int = 1000000000
let nanosPerDay : Int = 86400 * nanosPerSecond

-- The time with this hour, minute and second, if each is in range.
fun new(h : Int, m : Int, s : Int) -> Option TimeOfDay =
    if h < 0 || h > 23 || m < 0 || m > 59 || s < 0 || s > 59 {
        None
    } else {
        Some(TimeOfDay(((h * 60 + m) * 60 + s) * nanosPerSecond))
    }

-- `t` with its fraction of a second replaced, if `n` is under a second.
fun withNanosecond(t : TimeOfDay, n : Int) -> Option TimeOfDay =
    if n < 0 || n >= nanosPerSecond {
        None
    } else {
        Some(TimeOfDay(nanosOfDay(t) - nanosecond(t) + n))
    }

let midnight : TimeOfDay = TimeOfDay(0)

fun fromNanosOfDay(n : Int) -> Option TimeOfDay =
    if n < 0 || n >= nanosPerDay { None } else { Some(TimeOfDay(n)) }

fun nanosOfDay(TimeOfDay(n)) -> Int = n

fun hour(t : TimeOfDay) -> Int = nanosOfDay(t) / (3600 * nanosPerSecond)
fun minute(t : TimeOfDay) -> Int = nanosOfDay(t) / (60 * nanosPerSecond) % 60
fun second(t : TimeOfDay) -> Int = nanosOfDay(t) / nanosPerSecond % 60
fun nanosecond(t : TimeOfDay) -> Int = nanosOfDay(t) % nanosPerSecond

instance Eq TimeOfDay { fun eq(a, b) = nanosOfDay(a) == nanosOfDay(b) }

instance Ord TimeOfDay { fun lt(a, b) = nanosOfDay(a) < nanosOfDay(b) }

instance Hash TimeOfDay { fun hashInto(t, h) = hashInto(nanosOfDay(t), h) }

-- ISO 8601: `09:30:00`, with a fraction of a second only if there is one, and
-- then only as many digits as it needs: `09:30:00.25`.
instance Show TimeOfDay {
    fun show(t) =
        Iso.padded(hour(t), 2) + ":" + Iso.padded(minute(t), 2) + ":" + Iso.padded(second(t), 2)
            + Iso.fractionText(nanosecond(t))
}

-- `HH:MM`, `HH:MM:SS` or `HH:MM:SS.fff` with one to nine digits after a `.`
-- or `,`. A leap second, `:60`, is read as `:59`: a wall-clock time has no
-- sixty-first second to hold it.
fun parse(s : String) -> Option TimeOfDay {
    let r = Iso.reader(s)
    let t = read(r)?
    if Iso.finished(r) { Some(t) } else { None }
}

-- A time at the reader's position, for the types whose text contains one.
fun read(r : Iso.Reader) -> Option TimeOfDay {
    let h = Iso.digits(r, 2)?
    Iso.expect(r, ':')?
    let m = Iso.digits(r, 2)?
    if !Iso.accept(r, ':') { return new(h, m, 0) }
    let s = Iso.digits(r, 2)?
    let nanos = Iso.fraction(r)?
    withNanosecond(new(h, m, if s == 60 { 59 } else { s })?, nanos)
}
