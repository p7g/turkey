module Time.Weekday (Weekday(..), number, fromNumber)

-- A day of the week. Weeks start on Monday, as in ISO 8601.

type Weekday = Mon | Tue | Wed | Thu | Fri | Sat | Sun

-- 1 for Monday through 7 for Sunday, the ISO numbering.
fun number(d : Weekday) -> Int = match d {
    Mon -> 1
    Tue -> 2
    Wed -> 3
    Thu -> 4
    Fri -> 5
    Sat -> 6
    Sun -> 7
}

fun fromNumber(n : Int) -> Option Weekday = match n {
    1 -> Some(Mon)
    2 -> Some(Tue)
    3 -> Some(Wed)
    4 -> Some(Thu)
    5 -> Some(Fri)
    6 -> Some(Sat)
    7 -> Some(Sun)
    _ -> None
}

instance Eq Weekday { fun eq(a, b) = number(a) == number(b) }

instance Ord Weekday { fun lt(a, b) = number(a) < number(b) }

instance Hash Weekday { fun hashInto(d, h) = hashInto(number(d), h) }

instance Show Weekday {
    fun show(d) = match d {
        Mon -> "Mon"
        Tue -> "Tue"
        Wed -> "Wed"
        Thu -> "Thu"
        Fri -> "Fri"
        Sat -> "Sat"
        Sun -> "Sun"
    }
}
