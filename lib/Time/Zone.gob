module Time.Zone (
    Zone, ZoneError(..), utc, fixed, posix, fromTzif, named, system, id, offsetAt,
    offsetAtSecond, transitions,
)

-- A time zone: the rules that say what the clocks read at each instant in a
-- place. Either a fixed offset, a POSIX rule, or a table of transitions read
-- from the system's time zone files, followed by a POSIX rule.
--
-- A zone is named by its `id`, `America/Toronto`, and two zones are equal when
-- their ids are. That is sound because a zone, once read, is never read
-- again: every `named` lookup of one id in a process gives the same rules.

import System.Env as Env
import System.File as File
import System.IO as IO
import System.Sync as Sync
import Time.Frame (Transition, UnixSeconds)
import Time.Frame as Frame
import Time.Instant (Instant)
import Time.Offset (Offset)
import Time.Offset as Offset
import Time.Posix as Posix
import Time.Tzif as Tzif
import Turkey.Buffer as Buf

type Zone = Zone { id : String, rules : Rules }

type Rules = Fixed(Offset) | Posix(Posix.Rule) | Table(Tzif.Table)

-- Why a zone could not be had: an id with characters or components no zone
-- name has; no file for it; a file that could not be read, or is not a TZif
-- file; or, for the system's zone, nothing that says what it is.
type ZoneError = InvalidName(String)
               | UnknownZone(String)
               | Unreadable(String, String)
               | Malformed(String)
               | NoSystemZone

instance Error ZoneError {
    fun message(e) = match e {
        InvalidName(id) -> "'" + id + "' is not a time zone name"
        UnknownZone(id) -> "no time zone named '" + id + "'"
        Unreadable(path, why) -> "cannot read the time zone file " + path + ": " + why
        Malformed(what) -> what + " is not a valid time zone"
        NoSystemZone -> "the system's time zone is not set"
    }
}

instance Show ZoneError { fun show(e) = message(e) }

let utc : Zone = Zone { id = "UTC", rules = Fixed(Offset.utc) }

-- The zone always `offset` from UTC, named by the offset: `+05:30`.
fun fixed(offset : Offset) -> Zone = Zone { id = show(offset), rules = Fixed(offset) }

-- The zone a POSIX `TZ` rule describes, `EST5EDT,M3.2.0,M11.1.0`, named by
-- the rule's text. Such an id cannot appear in RFC 9557 text, so a `DateTime`
-- in this zone shows text that `DateTime.parse` does not read back; it is for
-- rules that come from outside, and for tests that must not depend on the
-- system's files.
fun posix(rule : String) -> Option Zone =
    Option.map(Posix.parse(rule), fun(r) = Zone { id = rule, rules = Posix(r) })

-- The zone in the TZif file `bytes`, named `id`.
fun fromTzif(id : String, bytes : Array Byte) -> Option Zone =
    Option.map(Tzif.parse(bytes), fun(t) = Zone { id, rules = Table(t) })

fun id(z : Zone) -> String = z.id

instance Eq Zone { fun eq(a, b) = a.id == b.id }

instance Hash Zone { fun hashInto(z, h) = hashInto(z.id, h) }

instance Show Zone { fun show(z) = z.id }

fun offsetAt(z : Zone, i : Instant) -> Offset = offsetAtSecond(z, Frame.fromInstant(i))

-- The offset in force at `t`, which need not be a second an `Instant` can
-- hold.
fun offsetAtSecond(z : Zone, t : UnixSeconds) -> Offset = match z.rules {
    Fixed(o) -> o
    Posix(r) -> Posix.offsetAt(r, t)
    Table(table) -> Tzif.offsetAt(table, t)
}

-- The transitions from `from` to `to`, both included, in order.
fun transitions(z : Zone, from : UnixSeconds, to : UnixSeconds) -> Array Transition = match z.rules {
    Fixed(_) -> []
    Posix(r) -> {
        let out = Vec.new(4)
        for var y = Frame.year(from) - 1; y <= Frame.year(to) + 1; y = y + 1 {
            for transition in Posix.transitions(r, y) {
                if transition.at >= from && transition.at <= to { Vec.push(out, transition) }
            }
        }
        Vec.toArray(out)
    }
    Table(table) -> Tzif.transitions(table, from, to)
}

-- -- named zones ------------------------------------------------------------------

-- The zone the system's time zone files call `id`, `America/Toronto`: read
-- from `$TZDIR`, or `/usr/share/zoneinfo` if that is unset, once per process.
fun named(id : String) -> Either ZoneError Zone {
    if !validName(id) { return Left(InvalidName(id)) }
    if let Some(z) = Sync.withLock(cache, fun(m) = Map.get(m, id)) { return Right(z) }
    let path = directory() + "/" + id
    let z = match File.readAll(path) {
        Right(buffer) -> match fromTzif(id, Buf.bytes(buffer)) {
            Some(z) -> z
            None -> return Left(Malformed(path))
        }
        Left(e) -> return Left(if e.kind == IO.NotFound { UnknownZone(id) } else {
            Unreadable(path, message(e))
        })
    }
    Sync.withLock(cache, fun(m) = Map.put(m, id, z))
    Right(z)
}

let cache : Sync.Mutex (Map String Zone) = Sync.mutex(Map.new())

fun directory() -> String = Option.unwrapOr(Env.get("TZDIR"), "/usr/share/zoneinfo")

-- A zone name is joined onto a directory, and often comes from outside, so it
-- may not climb out of it: no empty, `.` or `..` component, no leading `/`,
-- and only the characters zone names use.
fun validName(id : String) -> Bool {
    if String.isEmpty(id) { return False }
    for part in String.split(id, "/") {
        if String.isEmpty(part) || part == "." || part == ".." { return False }
    }
    for c in String.codePoints(id) {
        if !(Char.isAsciiAlphanumeric(c) || c == '_' || c == '+' || c == '-' || c == '/') {
            return False
        }
    }
    True
}

-- -- the system's zone -------------------------------------------------------------

-- The zone the system is set to, found once per process: from `$TZ` if it is
-- set -- a zone name, `:` and a name, a path to a TZif file, or a POSIX rule
-- -- and otherwise from `/etc/localtime`, which names its zone by being a
-- symbolic link into the zone files. A copied `/etc/localtime` has no name of
-- its own, and its zone's id is its path.
fun system() -> Either ZoneError Zone = Sync.force(systemZone)

let systemZone : Sync.Once (Either ZoneError Zone) = Sync.once(findSystem)

fun findSystem() -> Either ZoneError Zone = match Env.get("TZ") {
    Some(tz) -> fromTz(Option.unwrapOr(String.stripPrefix(tz, ":"), tz))
    None -> fromLocaltime()
}

fun fromTz(tz : String) -> Either ZoneError Zone {
    if String.isEmpty(tz) { return Left(NoSystemZone) }
    if String.startsWith(tz, "/") { return fromFile(tz) }
    match named(tz) {
        Right(z) -> Right(z)
        Left(e) -> match posix(tz) {
            Some(z) -> Right(z)
            None -> Left(e)
        }
    }
}

fun fromLocaltime() -> Either ZoneError Zone {
    let localtime = "/etc/localtime"
    if let Right(target) = File.readLink(localtime) {
        if let Some((_, name)) = String.rsplitOnce(target, "zoneinfo/") {
            if let Right(z) = named(name) { return Right(z) }
        }
    }
    match fromFile(localtime) {
        Right(z) -> Right(z)
        Left(UnknownZone(_)) -> Left(NoSystemZone)
        Left(e) -> Left(e)
    }
}

-- The zone in the TZif file at `path`, whose id is the path.
fun fromFile(path : String) -> Either ZoneError Zone = match File.readAll(path) {
    Right(buffer) -> match fromTzif(path, Buf.bytes(buffer)) {
        Some(z) -> Right(z)
        None -> Left(Malformed(path))
    }
    Left(e) -> Left(if e.kind == IO.NotFound { UnknownZone(path) } else {
        Unreadable(path, message(e))
    })
}
