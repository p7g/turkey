--- What a module has without importing anything: the standard `Prelude` passes
--- on everything here, bare names and qualifiers alike.
---
--- A program that writes a `Prelude` of its own starts from this module:
---
---     export (.., module Turkey (..), module Set)
---
---     import Turkey
---     import Turkey (..)
---     import Data.Set as Set
---
--- `module Turkey (..)` passes on every name and qualifier below, and
--- `import Turkey (..)` brings them for the new module's own declarations.

import Prelude ()
import Data.Eq (Eq(..), (==), (!=))
import Data.Ord (Ord(..), min, max, (<), (<=), (>), (>=))
import Data.Num (
	Add(..),
	Sub(..),
	Mul(..),
	Div(..),
	Mod(..),
	Neg(..),
	Zero(..),
	One(..),
	(+),
	(-),
	(*),
	(/),
	(%),
)
import Bits (BitAnd(..), BitOr(..), BitXor(..), Shift(..), (&), (|), (^), (<<), (>>))
import Text.Show (Show(..))
import Data.Typed (Typed(..))
import Object (Object(..))
import Debug (Debug(..), dbg)
import Data.Error (Error(..))
import Unwrap (Unwrap(..))
import Data.Hashable (Hash(..), Hasher(..))
import Data.Functor (Functor(..), fmap, (<&>), (<$>))
import Control.Applicative (Applicative(..))
import Control.Monad (Monad(..), (|>>))
import Iter (Iterator(..))
import Data.Index (Index(..), SetIndex(..), Length(..))
import Data.Semigroup (Semigroup(..), (<>))
import Data.Monoid (Monoid(..))
import Data.Foldable (Foldable(..))
import Data.Function (const, pipe, (|>))
import Control.Panic (error)
import Turkey.Stdout (print, write)

import Hash.FoldHash (FoldHash)
import Data.Int (Int)
import Data.Float (Float)
import Data.Char (Char)
import Data.Byte (Byte)
import Data.Bool (Bool(..))
import Data.Either (Either(..))
import Data.Error (SomeError(..), fail, throw)
import Data.Option (Option(..))
import Data.Ordering (Ordering(..))
import Data.Array (Array)
import Data.Vec (Vec)
import FrozenArray (FrozenArray)
import Data.Map (Map)
import Data.String (String)
import Data.Tuple (Unit)

-- The modules the export list passes on as qualifiers.
import Data.Array as Array
import Data.Bool as Bool
import Data.Byte as Byte
import Data.Char as Char
import Data.Either as Either
import Data.Error as Error
import Data.Float as Float
import Data.Int as Int
import Iter
