module Turkey.Alloc (cellNew, objectNew, arrayNew, closureShell, stringNew)

-- Generated callers root every managed operand across these calls. The heap
-- does not move, so those operands may travel here as raw words. Each allocator
-- calls the heap once, and holds no newly allocated object across another
-- allocation. Its raw result becomes traced at the caller's allocation opcode.
-- Each passes its own frame to the heap, where the collector's stack walk
-- starts, so everything between that frame and the program's entry must be
-- Turkey. C may call these only when it is itself the outermost code on the
-- stack, as the runtime's own C tests do.
-- No initializer or managed literal may be needed: literal interning calls
-- this module before module initialization.
import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)
import Data.Eq (Eq(..))
import Data.Ord (Ord(..))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..))
import Data.Int ()
import Data.Bool (Bool(..))
import Turkey.Memory as Memory
import Turkey.Heap as Heap
import Turkey.Process as Process

foreign "turkey_cell_new" fun cellNew(value : Int, pointerValue : Int) -> Prim.Ptr {
    let cell = Heap.allocate(16, 3, 7, Prim.frameAddress())
    if !Prim.ptrIsNull(cell) {
        Prim.storeI64(cell, 0, value)
        Prim.storeI32(cell, 8, Prim.charFromInt(pointerValue))
    }
    cell
}

-- An object of `bytes` bytes of fields, the first `pointers` words of them
-- traced. Where each field is within them is the compiler's
-- (`Turkey.Runtime.layout`); all the runtime keeps is the count, which is the
-- collector's whole description of the object.
foreign "turkey_object_new" fun objectNew(kind : Int, tag : Int, bytes : Int,
                                         pointers : Int) -> Prim.Ptr {
    -- The bound on `bytes` is far past any object a program builds, and keeps
    -- the size from overflowing.
    if kind < 0 || kind == 2 || kind > 4 || bytes < 0 || bytes > 0x1_0000_0000
            || Prim.intAnd(bytes, 7) != 0 || pointers < 0 || pointers > Prim.intShr(bytes, 3) {
        Process.panic(Prim.cString("invalid object size"))
        return Prim.ptrNull()
    }
    let object = Heap.allocate(Prim.intAddWrapping(24, bytes), 2, kind, Prim.frameAddress())
    if Prim.ptrIsNull(object) { return object }
    header(object, kind, tag, bytes, pointers)
    -- In line, a word at a time: most objects have a few fields, and are
    -- zeroed in fewer instructions than a call takes.
    let end = Prim.intAddWrapping(24, bytes)
    for var at = 24; at < end; at = Prim.intAddWrapping(at, 8) {
        Prim.storeI64(object, at, 0)
    }
    object
}

-- The collector and generated field accesses share this layout. The two
-- 32-bit fields must not overwrite the count or one another.
fun header(object : Prim.Ptr, kind : Int, tag : Int, count : Int,
           descriptor : Int) -> Unit {
    Prim.storeI32(object, 0, Prim.charFromInt(kind))
    Prim.storeI32(object, 4, Prim.charFromInt(tag))
    Prim.storeI64(object, 8, count)
    Prim.storeI64(object, 16, descriptor)
}

foreign "turkey_array_new" fun arrayNew(length : Int, initial : Int,
                                        elementWidth : Int, elementLayout : Int)
        -> Prim.Ptr {
    if length < 0 {
        Process.panic(Prim.cString("array length cannot be negative"))
        return Prim.ptrNull()
    }
    -- floor((SIZE_MAX - 24) / width). Every nonnegative Int fits at width 1;
    -- widths 4 and 8 have signed-representable bounds. After this check the
    -- size is an unsigned word, passed bit-for-bit to the heap allocator.
    if !(elementWidth == 1 || elementWidth == 4 || elementWidth == 8)
            || (elementWidth == 4 && length > 4611686018427387897)
            || (elementWidth == 8 && length > 2305843009213693948) {
        Process.panic(Prim.cString("invalid array size"))
        return Prim.ptrNull()
    }
    let size = Prim.intAddWrapping(24, Prim.intMulWrapping(length, elementWidth))
    let array = Heap.allocate(size, 2, 2, Prim.frameAddress())
    if Prim.ptrIsNull(array) { return array }
    header(array, 2, elementLayout, length, elementWidth)
    let bytes = Prim.ptrAdd(array, 24)
    if elementWidth == 1 {
        Memory.fill(bytes, length, initial)
    } else {
        for var i = 0; i < length; i = i + 1 {
            let offset = Prim.intMulWrapping(i, elementWidth)
            if elementWidth == 4 {
                Prim.storeI32(bytes, offset, Prim.charFromInt(initial))
            } else {
                Prim.storeI64(bytes, offset, initial)
            }
        }
    }
    array
}

-- The environment is independently allocated and rooted by the caller. Zero
-- initialization makes the shell safe to trace until that pointer is installed.
-- Laid out as `Turkey.Runtime.closureShell` says: the environment, traced,
-- then the code's address.
foreign "turkey_closure_shell" fun closureShell(code : Int) -> Prim.Ptr {
    let closure = objectNew(3, -1, 16, 1)
    if !Prim.ptrIsNull(closure) { Prim.storeI64(closure, 32, code) }
    closure
}

foreign "turkey_string_new" fun stringNew(bytes : Prim.Ptr, length : Int) -> Prim.Ptr {
    let array = arrayNew(length, 0, 1, 2)
    if !Prim.ptrIsNull(array) && length > 0 {
        Memory.copy(Prim.ptrAdd(array, 24), bytes, length)
    }
    array
}
