export (ByteView(..))

--- `ByteView` with its representation open, for the library. `Bytes`
--- re-exports the type abstractly, so a program can read a view but never
--- reach the storage behind it: a view of a string is the string's own bytes,
--- which nothing may write.
---
--- The instances are here rather than in `Bytes` because an instance lives with
--- its class or its type, and this is the type's module.

import Prelude ()
import Data.Int (Int)
import Data.Byte (Byte)
import Data.Num (Add(..), Sub(..), (+), (-))
import Data.Ord (Ord(..), (<), (>), (>=))
import Data.Index (Index(..), Length(..))
import Iter (Iterator(..))
import Data.Option (Option(..))
import Turkey.Array (outOfBounds)
import Debug (Debug(..))
import Data.String (String)

--- The `length` bytes of `storage` from `storage[from]` on, where `from >= 0`,
--- `length >= 0` and `from + length <= len(storage)`. Every view is made in the
--- library, which keeps that so: the word reads in `Hash.Words` check only
--- against `length`, and rely on it to stay inside `storage`.
---
--- The view holds its length rather than its end because the hashers check
--- every word they read against it, and an end would cost a subtraction, with
--- its overflow test, per read.
type ByteView = ByteView { storage : Prim.Array Byte, from : Int, length : Int }

--- The `i`-th byte of the view.
instance Index ByteView {
    type Key = Int
    type Value = Byte
    fun get(v, i) {
        if i < 0 || i >= v.length { outOfBounds("ByteView.get", i, v.length) }
        v.storage[v.from + i]
    }
}

instance Length ByteView { fun len(v) = v.length }

--- The viewed bytes and nothing else: where they sit in the storage is not
--- part of the value.
instance Debug ByteView {
    fun debug(v) {
        var out = "ByteView(["
        for var i = 0; i < v.length; i = i + 1 {
            if i > 0 { out = out + ", " }
            out = out + debug(v.storage[v.from + i])
        }
        out + "])"
    }
}

-- `at` is an index into the view, not into its storage.
type ByteViewCursor = ByteViewCursor { var at : Int }

--- The view's bytes, front to back, each as it is when asked for.
instance Iterator ByteView {
    type Item = Byte
    type Cursor = ByteViewCursor
    fun iter(v) = ByteViewCursor { at = 0 }
    fun next(v, cur) {
        if cur.at >= v.length { return None }
        let x = v.storage[v.from + cur.at]
        cur.at = cur.at + 1
        Some(x)
    }
}
