export (Coroutine, Binding(..), new, resume, suspend, finished, running, waiting, waitingSet,
        waitingSwap, bindings, bindingsSet)

--- Coroutines: a function run on a stack of its own, which can stop part way
--- through -- at any depth of ordinary calls -- and be continued later.
---
--- Asymmetric: `resume` runs a coroutine until it calls `suspend` or its body
--- returns, and either one comes back to whoever resumed it. Nothing is passed
--- across a switch; what the two sides tell each other goes through the
--- coroutine object or other heap objects, where its type is checked.
---
--- A stack's frames are the collector's roots for as long as it is
--- registered, which is until its body returns. A coroutine that is never
--- resumed to the end keeps its stack and everything its frames hold.

import Prelude ()
import Debug (Debug(..))
import Data.Int (Int)
import Data.Tuple (Unit)
import Data.Eq (Eq(..), (==))
import Data.Array (Array)
import Data.Index (Index(..), SetIndex(..), Length(..))
import Control.Panic (error)
import Data.Bool (Bool(..))
import Data.Option (Option(..))
import Turkey.Stack as Stack
import Turkey.Workers as Workers
import Turkey.Ptr (Ptr)
import Turkey.Ptr as Ptr
import Turkey.Array as Storage
import Turkey.Process as Process

--- Its state is read and written only under its protocol, by tasks that may
--- run in parallel, so `!Debug` keeps a derived `Debug` from reading it.
type Coroutine : !Debug = Coroutine {
    -- `Turkey.Stack`'s record of this coroutine's stack.
    stack        : Ptr,
    body         : fun() -> Unit,
    var running  : Bool,
    var finished : Bool,
    -- The scheduler's (`Turkey.Scheduler`), read and written only by atomic
    -- instructions, since a waker and the coroutine's own worker change it
    -- at once.
    waiting      : Prim.Atomic,
    -- The scoped values (`ScopedValue`) bound on this stack, innermost first.
    -- They live here rather than per thread because a coroutine can suspend
    -- on one worker and resume on another, and its bindings must go with it.
    var bindings : Option Binding,
}

--- One scoped value's binding, and the bindings it shadows or extends. `key`
--- is the `ScopedValue`'s number, which is unique to it, so two bindings with
--- one key hold values of one type. Immutable, so a coroutine made inside
--- the binding can share the whole list with its creator.
type Binding = Binding[v] { key : Int, value : v, next : Option Binding }

-- Each thread's running coroutine, if any, by the thread's index in its
-- record (`Turkey.Process`). Held here rather than in the record because it
-- is a traced value, and the record is raw memory the collector does not
-- read. As many as there may be threads (`Turkey.Workers.threadLimit`).
var currents : Prim.Array (Option Coroutine) = Storage.filled(Workers.threadLimit(), None)

fun current() -> Option Coroutine = currents[worker()]

-- Each thread's bindings for code on the thread's own stack, by the thread's
-- index, as `currents` is. That code never moves to another thread, so a
-- slot per thread is a slot per stack.
var threadBindings : Prim.Array (Option Binding) =
    Storage.filled(Workers.threadLimit(), None)

--- Returns the scoped values bound on the running stack.
fun bindings() -> Option Binding = match current() {
    Some(c) -> c.bindings
    None -> threadBindings[worker()]
}

--- Replaces the scoped values bound on the running stack.
fun bindingsSet(b : Option Binding) -> Unit = match current() {
    Some(c) -> { c.bindings = b }
    None -> { threadBindings[worker()] = b }
}

fun currentSet(c : Option Coroutine) -> Unit { currents[worker()] = c }

fun worker() -> Int = Ptr.load(Process.workerRecord(), 288)

-- Chosen without measurement. Reserved, not resident: only the pages a
-- coroutine touches cost memory.
let stackBytes = 1048576

--- Returns a coroutine that runs `body` when first resumed. It starts with
--- the scoped values bound where it is made, not where it is resumed.
fun new(body : fun() -> Unit) -> Coroutine = Coroutine {
    stack = Stack.new(stackBytes),
    body = body,
    running = False,
    finished = False,
    waiting = Prim.atomicNew(0),
    bindings = bindings(),
}

fun finished(c : Coroutine) -> Bool = c.finished

fun waiting(c : Coroutine) -> Int = Prim.atomicGet(c.waiting)

fun waitingSet(c : Coroutine, state : Int) -> Unit = Prim.atomicSet(c.waiting, state)

--- Returns whether `c`'s `waiting` was `expected`, and sets it to `new` if so.
fun waitingSwap(c : Coroutine, expected : Int, new : Int) -> Bool =
    Prim.atomicSwapIf(c.waiting, expected, new) == expected

--- The coroutine whose stack is running, or `None` on the program's own stack.
fun running() -> Option Coroutine = current()

--- Run `c` until it suspends or finishes.
fun resume(c : Coroutine) -> Unit {
    if c.finished { return error("resumed a finished coroutine") }
    -- A running coroutine is suspended inside every coroutine that resumed it
    -- in turn, so resuming it again would run one stack twice.
    if c.running { return error("resumed a running coroutine") }
    let previous = current()
    let here = Stack.running()
    Stack.resumerSet(c.stack, here)
    c.running = True
    currentSet(Some(c))
    Prim.swapStack(here, c.stack)
    currentSet(previous)
    if c.finished { Stack.free(c.stack) }
}

--- Give control back to whoever resumed the running coroutine; this returns
--- when something resumes it again.
fun suspend() -> Unit = match current() {
    None -> error("suspended outside a coroutine")
    Some(c) -> {
        c.running = False
        Prim.swapStack(c.stack, Stack.resumer(c.stack))
    }
}

-- What a coroutine's stack runs first, called by `turkey_stack_start`
-- (`Turkey.Emit.emitStackStart`) the first time the stack is switched to.
-- When this returns, that code switches back to the resumer for the last
-- time. It does so even when the body panics: a panic returns from every
-- call until it reaches the bottom of the stack, and the switch carries it on
-- to the resumer, which goes on unwinding, so a panic in a coroutine ends the
-- program as one anywhere does.
fun start() -> Unit = match current() {
    Some(c) -> {
        c.body()
        c.running = False
        c.finished = True
    }
    None -> error("a coroutine stack started with no coroutine")
}
