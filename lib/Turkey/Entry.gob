export (
    main, entryThread, crashReport, installCrashHandler, traceTableSet,
    signalNote, signalHandler, signalPipeSet, signalTake,
)

-- Start a compiled program and report its result or a fault.
-- C calls these exported functions: the generated main, pthread_create, and
-- signal delivery enter without collector setup. As a giblet module, this
-- code does not allocate or hold a traced value across a call. Text is raw
-- cString bytes, and numbers are written a digit at a time.
--
-- Code before programEntry must not read initialized globals: even giblet
-- initialization runs inside programEntry, after this module's main starts.

import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)
import Data.Eq (Eq(..), (==), (!=))
import Data.Ord (Ord(..), (<), (<=), (>), (>=))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..), (+), (-), (*), (/), (%))
import Bits (BitAnd(..), Shift(..), (&), (<<), (>>))
-- For the instances alone. This module is loaded ahead of every program's
-- entry, so it cannot count on the Prelude having brought them in first, as
-- `Turkey.Memory` does.
import Data.Int ()
import Data.Int as Int
import Data.Bool (Bool(..))
import Target (OS(..))
import Target as Target
import Turkey.Libc as Libc
import Turkey.Process as Process
import Turkey.Alloc ()
import Turkey.Heap as Heap
import Turkey.Output as Output
import Turkey.Ptr (Ptr)
import Turkey.Ptr as Ptr

-- -- starting the program ---------------------------------------------------------------

-- The program itself: its literals interned, its globals computed, and its
-- `main` run, with `turkey_entry_returned` last. Every backend defines it.
foreign "turkey_entry" fun programEntry() -> Unit

-- Hand the arguments over, run the program on a thread of its own, and turn
-- how it ended into a status: an exit's own, `1` and a report for a panic, and
-- `0` after a final collection otherwise.
foreign "turkey_main" fun main(argc : Int, argv : Ptr) -> Int {
    -- Opt-in, as `TURKEY_GC_STRESS` is: taking `SIGSEGV` over for a process
    -- is a debugging choice rather than a default.
    if !Ptr.isNull(Libc.getenv(Prim.cString("TURKEY_SEGV_FRAMES"))) {
        installCrashHandler()
    }
    Process.argsSet(cInt(argc), argv)
    runEntry()
    -- What the standard output still holds, however the program ended, and
    -- before a panic's message. Here, and not in the generated entry before
    -- `turkey_entry_returned`, for two reasons. By now the panic flag is
    -- parked, so calls return normally; in the generated entry they would run
    -- while the program unwinds, every call testing a raised flag. And this is
    -- library code, which every compiler compiles from today's source: a flush
    -- the code generator emitted would be missing from any program built by a
    -- compiler older than it, the compiler built from the committed bootstrap
    -- among them.
    Output.final()
    if Process.exiting() { return Process.exitStatus() & 255 }
    if Process.panicked() {
        reportPanic()
        return 1
    }
    Heap.collect()
    Heap.report()
    0
}

-- The entry runs on a thread of its own, for its stack.
--
-- The stack is a Turkey program's recursion limit, and recursion is ordinary
-- Turkey, so the limit is set the way languages built for recursion set
-- theirs -- GHC's is most of physical memory, OCaml 5's and Go's a gigabyte --
-- rather than the 8MB the main thread gets on macOS. Reserving it costs
-- address space and no memory: a page is only backed once it is touched. The
-- compiler compiling itself needs under a megabyte of it.
--
-- Running out is still silent: the fault is a write to the guard page, a
-- `SIGSEGV` like any other, and the handler cannot even run, because running
-- it needs the stack that just ran out.
--
-- A thread takes its stack size as an attribute and the main thread's cannot
-- be changed once the process is running, so the entry goes on a thread made
-- for it, with 512MB. `main` does nothing but wait, so this costs one thread
-- and no parallelism: one thread runs Turkey code, as the collector needs.
--
-- With no thread to be had, the small stack beats not running at all, and the
-- entry runs here.
fun runEntry() -> Unit {
    -- Storage for the opaque `pthread_attr_t` and `pthread_t`: 64 and 8 bytes
    -- on Darwin, 56 and 8 on Linux, and never read here, so generously sized.
    let attributes = Libc.malloc(128)
    let thread = Libc.malloc(16)
    if Ptr.isNull(attributes) || Ptr.isNull(thread)
            || cInt(Libc.pthreadAttrInit(attributes)) != 0 {
        Libc.free(attributes)
        Libc.free(thread)
        let _ = entryThread(Ptr.null())
        return {}
    }
    let started =
        cInt(Libc.pthreadAttrSetStackSize(attributes, 536870912)) == 0
        && cInt(Libc.pthreadCreate(thread, attributes,
                                   Prim.codeAddress("turkey_entry_thread"),
                                   Ptr.null())) == 0
    let _ = Libc.pthreadAttrDestroy(attributes)
    Libc.free(attributes)
    if started {
        let _ = Libc.pthreadJoin(Ptr.load(thread, 0), Ptr.null())
    } else {
        let _ = entryThread(Ptr.null())
    }
    Libc.free(thread)
}

-- The thread's start routine, `void *(*)(void *)`.
foreign "turkey_entry_thread" fun entryThread(argument : Ptr) -> Ptr {
    programEntry()
    Ptr.null()
}

-- `panic: <message>`, then a line for each call that was active when the
-- panic was raised, innermost first.
fun reportPanic() -> Unit {
    writeText(2, Prim.cString("panic: "))
    writeText(2, Process.panicMessage())
    writeText(2, Prim.cString("\n"))
    let count = Process.traceCount()
    for var i = 0; i < count; i = i + 1 { reportCall(Process.traceAddress(i)) }
}

-- -- the trace table -------------------------------------------------------------------
--
-- The compiler writes one table for the program: for each call that has a
-- source position, where the call returns to, the function it is in, and the
-- position. A frame record holds the address its function returns to, so
-- those are the addresses a trace is made of.
--
-- Every field is four bytes:
--
--     function count, file count, the strings' size in bytes
--     per file          its name's offset in the strings
--     the strings       each NUL-terminated
--     per function      its name's offset, its call count, its site count
--       per call        the return address's distance from `traceBase`;
--                       the line, and the column from bit 20;
--                       the file's number, and the site's from bit 14
--       per site        the inlined function's name's offset, then the
--                       position of the call it was inlined at, as a call's
--
-- A file's number counts from 1 and 0 is no file. A site is a call the
-- compiler inlined into the function: code with a site's number is the text
-- of the function the site names, and the site's own position is the call
-- that was replaced, which may itself be in a site. Site 0 is the function
-- itself, and a site's number is above the number of the site its call is
-- in.
--
-- The table is scanned from the start for each address. It is read only to
-- report a panic, so nothing is spent on it in a program that does not.

var traceTable : Ptr = Ptr.null()
var traceBase : Ptr = Ptr.null()

-- Record the program's trace table, whose distances are from `base`. The
-- generated entry calls it. A program that never does prints no trace.
foreign "turkey_trace_table_set" fun traceTableSet(table : Ptr, base : Ptr) -> Unit {
    traceTable = table
    traceBase = base
}

-- Write the lines of the call that returns to `address`: `  at function
-- (file:line:column)`, first for each function inlined around it, innermost
-- first, and then for the function the code is in. An address the table does
-- not have, which is a call with no source position or one in C, writes
-- nothing.
fun reportCall(address : Ptr) -> Unit {
    let table = traceTable
    if Ptr.isNull(table) { return {} }
    let distance = Int.subWrapping(Ptr.toInt(address), Ptr.toInt(traceBase))
    let functions = Ptr.load32(table, 0)
    let files = Ptr.add(table, 12)
    let strings = Ptr.add(files, 4 * Ptr.load32(table, 4))
    var function = Ptr.add(strings, Ptr.load32(table, 8))
    for var f = 0; f < functions; f = f + 1 {
        let calls = Ptr.load32(function, 4)
        let sites = Ptr.add(function, 12 + 12 * calls)
        for var c = 0; c < calls; c = c + 1 {
            let call = Ptr.add(function, 12 + 12 * c)
            if signed32(Ptr.load32(call, 0)) == distance {
                reportPosition(files, strings, Ptr.load32(function, 0), sites,
                               Ptr.add(call, 4))
                return {}
            }
        }
        function = Ptr.add(sites, 12 * Ptr.load32(function, 8))
    }
}

-- Write the lines of the position at `position`, two fields, in the function
-- whose name is at `name` in `strings` and whose sites are at `sites`.
fun reportPosition(files : Ptr, strings : Ptr, name : Int, sites : Ptr,
                   position : Ptr) -> Unit {
    var at = position
    loop {
        let lineColumn = Ptr.load32(at, 0)
        let fileSite = Ptr.load32(at, 4)
        let site = fileSite >> 14
        let file = fileSite & 0x3FFF
        let inlined = Ptr.add(sites, 12 * (site - 1))
        writeText(2, Prim.cString("  at "))
        writeText(2, Ptr.add(strings, if site == 0 { name } else { Ptr.load32(inlined, 0) }))
        writeText(2, Prim.cString(" ("))
        if file == 0 {
            writeText(2, Prim.cString("?"))
        } else {
            writeText(2, Ptr.add(strings, Ptr.load32(files, 4 * (file - 1))))
        }
        writeText(2, Prim.cString(":"))
        writeNumber(2, lineColumn & 0xF_FFFF)
        writeText(2, Prim.cString(":"))
        writeNumber(2, lineColumn >> 20)
        writeText(2, Prim.cString(")\n"))
        if site == 0 { return {} }
        -- The call the site replaced. Its own site has a lower number, which
        -- is what ends the loop; a table that says otherwise is not followed.
        let outer = Ptr.load32(inlined, 8) >> 14
        if outer >= site { return {} }
        at = Ptr.add(inlined, 4)
    }
}

-- The low 32 bits of `n`, as a signed integer.
fun signed32(n : Int) -> Int = (n << 32) >> 32

-- -- a fault ---------------------------------------------------------------------------

-- A fault in generated code otherwise says nothing at all but "exited -11".
-- Every frame on the collector's root chain carries a name, so walking it says
-- at least which of those the fault happened under. Generated functions keep
-- their roots in frame tables rather than on that chain, so what it names is
-- the globals and any frames C registered, not the Turkey call stack.

-- Take `SIGSEGV` and `SIGBUS` over. Called by `main` when
-- `TURKEY_SEGV_FRAMES` is set.
foreign "turkey_install_crash_handler" fun installCrashHandler() -> Unit {
    let handler = Prim.codeAddress("turkey_crash_report")
    let _ = Libc.signal(sigsegv(), handler)
    let _ = Libc.signal(sigbus(), handler)
}

-- Signal numbers, from each target's `<signal.h>`. Functions rather than
-- top-level `let`s, which would be initialized only after this module has
-- started; each call is a literal once the optimizer has decided the `match`.
fun sigsegv() -> Int = match Target.os {
    Darwin -> 11
    Linux -> 11
}

fun sigbus() -> Int = match Target.os {
    Darwin -> 10
    Linux -> 7
}

-- The handler, `void (*)(int)`.
--
-- It runs on whatever stack faulted and may have interrupted anything,
-- including a push onto the very chains it walks. Being a giblet is what lets
-- it run at all -- it makes nothing the collector could be asked about -- and
-- three more things are true of it that no rule checks:
-- it calls only `write` and `_exit`, which are async-signal-safe; it reads the
-- chain as it stands, which is best-effort, since the stores that push a
-- frame may be reordered; and it never returns into the instruction that
-- faulted.
foreign "turkey_crash_report" fun crashReport(signal : Int) -> Unit {
    if cInt(signal) == sigbus() {
        writeText(2, Prim.cString("\n*** SIGBUS in generated code\n"))
    } else {
        writeText(2, Prim.cString("\n*** SIGSEGV in generated code\n"))
    }
    writeText(2, Prim.cString("  enclosing functions, innermost first:\n"))
    -- `RootFrame { previous, function_name, ... }`.
    var roots = Heap.rootsHead()
    var shown : Int = 0
    while !Ptr.isNull(roots) && shown < 40 {
        writeText(2, Prim.cString("    "))
        writeText(2, orQuery(Ptr.load(roots, 8)))
        writeText(2, Prim.cString("\n"))
        roots = Ptr.load(roots, 0)
        shown = shown + 1
    }
    Libc.exitNow(139)
}

-- -- a signal the program waits for -----------------------------------------------
--
-- `Signal` delivers a signal by the self-pipe trick, and this is its half that
-- runs in signal context: `signalNote` adds 1 to the signal's count, then
-- writes a byte to the pipe whose read end `Signal` waits on through the
-- poller. `Signal` reads the pipe empty first and takes the counts after
-- (`signalTake`), so a signal that comes between the two leaves a byte that
-- wakes the next wait, and none is lost.
--
-- The pipe's write end is non-blocking, so a full pipe drops the byte rather
-- than stopping the thread; the count keeps the delivery, and a full pipe
-- already wakes the reader.

-- Raw words: the pipe's write end at 0, or -1 until `signalPipeSet`; a count
-- for each signal number from 1 to `signalLimit - 1` at `8 * number`; and the
-- byte the handler writes, at `signalByteAt`.
let signalLimit : Int = 32
let signalByteAt : Int = 256
let signalWords : Ptr = signalState()

fun signalState() -> Ptr {
    let words = Libc.malloc(264)
    for var at = 0; at < 264; at = at + 8 { Ptr.store(words, at, 0) }
    Ptr.store(words, 0, -1)
    words
}

-- The handler, `void (*)(int)`, for `signal`.
--
-- It runs on whichever thread the kernel picks, on whatever stack that thread
-- is on, and may have interrupted anything. Being a giblet is what lets it run
-- at all, and it is written to return into the code it interrupted unharmed:
-- it calls only `write`, which is async-signal-safe; it touches only the raw
-- words above, with atomics; and it puts back the `errno` the write may have
-- changed, which the interrupted code may be about to read.
foreign "turkey_signal_note" fun signalNote(signal : Int) -> Unit {
    let number = cInt(signal)
    if number <= 0 || number >= signalLimit { return {} }
    let _ = Ptr.atomicAdd(signalWords, number * 8, 1)
    let fd : Int = Ptr.atomicLoad(signalWords, 0)
    if fd < 0 { return {} }
    let errno = errnoLocation()
    let saved = Ptr.load32(errno, 0)
    let _ = Libc.write(fd, Ptr.add(signalWords, signalByteAt), 1)
    Ptr.store32(errno, 0, saved)
}

-- `signalNote`'s address, to hand to `signal`.
fun signalHandler() -> Ptr = Prim.codeAddress("turkey_signal_note")

-- Have the handler write to `fd`, a non-blocking pipe's write end.
fun signalPipeSet(fd : Int) -> Unit = Ptr.atomicStore(signalWords, 0, fd)

-- How many times signal `number` has arrived since the last call, which
-- starts its count again from 0.
fun signalTake(number : Int) -> Int {
    let at = number * 8
    while True {
        let count = Ptr.atomicLoad(signalWords, at)
        if Ptr.atomicCas(signalWords, at, count, 0) == count { return count }
    }
    0
}

-- Where this thread's `errno` lives, as `Turkey.Sys.location` finds it.
fun errnoLocation() -> Ptr = match Target.os {
    Darwin -> Libc.errnoDarwin()
    Linux -> Libc.errnoLinux()
}

-- -- writing without a `String` ------------------------------------------------------

-- A NUL-terminated string to a descriptor. What is written is not checked:
-- there is nowhere left to report a failure to.
fun writeText(fd : Int, text : Ptr) -> Unit {
    let _ = Libc.write(fd, text, Libc.strlen(text))
}

-- A number that is not negative, in decimal, to a descriptor.
fun writeNumber(fd : Int, n : Int) -> Unit {
    if n >= 10 { writeNumber(fd, n / 10) }
    let _ = Libc.write(fd, Ptr.add(Prim.cString("0123456789"), n % 10), 1)
}

fun orQuery(text : Ptr) -> Ptr =
    if Ptr.isNull(text) { Prim.cString("?") } else { text }

-- A C `int` in an `Int`: the low half, sign-extended, because AAPCS64 leaves
-- the high half of a 32-bit value undefined. `System.IO.cInt`,
-- written again here rather than imported, so that this module's imports are
-- only what a giblet may reach.
fun cInt(r : Int) -> Int {
    let low = r & 0xFFFF_FFFF
    if low >= 0x8000_0000 { low - 0x1_0000_0000 } else { low }
}
