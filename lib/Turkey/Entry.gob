module Turkey.Entry (main, entryThread, crashReport, installCrashHandler)

-- Start a compiled program and report its result or a fault.
-- C calls these exported functions: the generated main, pthread_create, and
-- signal delivery enter without collector setup. As a giblet module, this
-- code does not allocate or hold a traced value across a call. Text is raw
-- cString bytes, and numbers are written a digit at a time.
--
-- Code before programEntry must not read initialized globals: even giblet
-- initialization runs inside programEntry, after this module's main starts.

import Prelude ()
import Std.Classes
-- For the instances alone. This module is loaded ahead of every program's
-- entry, so it cannot count on the Prelude having brought them in first, as
-- `Turkey.Memory` does.
import Data.Int ()
import Data.Bool.Type (Bool(..))
import Target (OS(..))
import Target as Target
import Turkey.Libc as Libc
import Turkey.Process as Process
import Turkey.Alloc ()
import Turkey.Heap as Heap

-- -- starting the program ---------------------------------------------------------------

-- The program itself: its literals interned, its globals computed, and its
-- `main` run, with `turkey_entry_returned` last. Every backend defines it.
foreign "turkey_entry" fun programEntry() -> Unit

-- Hand the arguments over, run the program on a thread of its own, and turn
-- how it ended into a status: an exit's own, `1` and a report for a panic, and
-- `0` after a final collection otherwise.
foreign "turkey_main" fun main(argc : Int, argv : Prim.Ptr) -> Int {
    -- Opt-in, as `TURKEY_GC_STRESS` is: taking `SIGSEGV` over for a process
    -- is a debugging choice rather than a default.
    if !Prim.ptrIsNull(Libc.getenv(Prim.cString("TURKEY_SEGV_FRAMES"))) {
        installCrashHandler()
    }
    Process.argsSet(cInt(argc), argv)
    runEntry()
    if Process.exiting() { return Prim.intAnd(Process.exitStatus(), 255) }
    if Process.panicked() {
        reportPanic()
        return 1
    }
    Heap.collect()
    Heap.report()
    0
}

-- The entry runs on a thread of its own, for its stack.
--
-- A compiler is a tree walk, and a Turkey frame is not small: `Opt#expr` roots
-- every live pointer it holds in one array, so its frame is kilobytes, and a
-- deeply nested program overruns the 8MB the main thread gets on macOS. The
-- fault is a write to the guard page, which is a `SIGSEGV` like any other and
-- says nothing -- the handler cannot even run, because running it needs the
-- stack that just ran out.
--
-- A thread takes its stack size as an attribute and the main thread's cannot
-- be changed once the process is running, so the entry goes on a thread made
-- for it: 512MB, the same `driver.STACK_BYTES` gives the interpreter, so that
-- the two hosts run out of stack in the same place. `main` does nothing but
-- wait, so this costs one thread and no concurrency: the collector still sees
-- exactly one mutator.
--
-- With no thread to be had, the small stack beats not running at all, and the
-- entry runs here.
fun runEntry() -> Unit {
    -- Storage for the opaque `pthread_attr_t` and `pthread_t`: 64 and 8 bytes
    -- on Darwin, 56 and 8 on Linux, and never read here, so generously sized.
    let attributes = Libc.malloc(128)
    let thread = Libc.malloc(16)
    if Prim.ptrIsNull(attributes) || Prim.ptrIsNull(thread)
            || cInt(Libc.pthreadAttrInit(attributes)) != 0 {
        Libc.free(attributes)
        Libc.free(thread)
        let _ = entryThread(Prim.ptrNull())
        return {}
    }
    let started =
        cInt(Libc.pthreadAttrSetStackSize(attributes, 536870912)) == 0
        && cInt(Libc.pthreadCreate(thread, attributes,
                                   Prim.codeAddress("turkey_entry_thread"),
                                   Prim.ptrNull())) == 0
    let _ = Libc.pthreadAttrDestroy(attributes)
    Libc.free(attributes)
    if started {
        let _ = Libc.pthreadJoin(Prim.loadPtr(thread, 0), Prim.ptrNull())
    } else {
        let _ = entryThread(Prim.ptrNull())
    }
    Libc.free(thread)
}

-- The thread's start routine, `void *(*)(void *)`.
foreign "turkey_entry_thread" fun entryThread(argument : Prim.Ptr) -> Prim.Ptr {
    programEntry()
    Prim.ptrNull()
}

-- `panic: <message>`.
fun reportPanic() -> Unit {
    writeText(2, Prim.cString("panic: "))
    writeText(2, Process.panicMessage())
    writeText(2, Prim.cString("\n"))
}

-- -- a fault ---------------------------------------------------------------------------

-- A fault in generated code otherwise says nothing at all but "exited -11".
-- Every frame on the collector's root chain carries a name, so walking it says
-- at least which of those the fault happened under. Generated functions keep
-- their roots in frame tables rather than on that chain, so what it names is
-- the globals and any frames C registered, not the Turkey call stack.

-- Take `SIGSEGV` and `SIGBUS` over. Called by `main` when
-- `TURKEY_SEGV_FRAMES` is set.
foreign "turkey_install_crash_handler" fun installCrashHandler() -> Unit {
    let handler = Prim.codeAddress("turkey_crash_report")
    let _ = Libc.signal(sigsegv(), handler)
    let _ = Libc.signal(sigbus(), handler)
}

-- Signal numbers, from each target's `<signal.h>`. Functions rather than
-- top-level `let`s, which would be initialized only after this module has
-- started; each call is a literal once the optimizer has decided the `match`.
fun sigsegv() -> Int = match Target.os {
    Darwin -> 11
    Linux -> 11
}

fun sigbus() -> Int = match Target.os {
    Darwin -> 10
    Linux -> 7
}

-- The handler, `void (*)(int)`.
--
-- It runs on whatever stack faulted and may have interrupted anything,
-- including a push onto the very chains it walks. Being a giblet is what lets
-- it run at all -- it makes nothing the collector could be asked about -- and
-- three more things are true of it that no rule checks:
-- it calls only `write` and `_exit`, which are async-signal-safe; it reads the
-- chain as it stands, which is best-effort, since the stores that push a
-- frame may be reordered; and it never returns into the instruction that
-- faulted.
foreign "turkey_crash_report" fun crashReport(signal : Int) -> Unit {
    if cInt(signal) == sigbus() {
        writeText(2, Prim.cString("\n*** SIGBUS in generated code\n"))
    } else {
        writeText(2, Prim.cString("\n*** SIGSEGV in generated code\n"))
    }
    writeText(2, Prim.cString("  enclosing functions, innermost first:\n"))
    -- `RootFrame { previous, function_name, ... }`.
    var roots = Heap.rootsHead()
    var shown : Int = 0
    while !Prim.ptrIsNull(roots) && shown < 40 {
        writeText(2, Prim.cString("    "))
        writeText(2, orQuery(Prim.loadPtr(roots, 8)))
        writeText(2, Prim.cString("\n"))
        roots = Prim.loadPtr(roots, 0)
        shown = shown + 1
    }
    Libc.exitNow(139)
}

-- -- writing without a `String` ------------------------------------------------------

-- A NUL-terminated string to a descriptor. What is written is not checked:
-- there is nowhere left to report a failure to.
fun writeText(fd : Int, text : Prim.Ptr) -> Unit {
    let _ = Libc.write(fd, text, Libc.strlen(text))
}

fun orQuery(text : Prim.Ptr) -> Prim.Ptr =
    if Prim.ptrIsNull(text) { Prim.cString("?") } else { text }

-- A C `int` in an `Int`: the low half, sign-extended, because AAPCS64 leaves
-- the high half of a 32-bit value undefined. `System.IO.cInt`,
-- written again here rather than imported, so that this module's imports are
-- only what a giblet may reach.
fun cInt(r : Int) -> Int {
    let low = Prim.intAnd(r, 4294967295)
    if low >= 2147483648 { low - 4294967296 } else { low }
}
