export (IOError(..), ErrorKind(..), failure, kindOf, describe)

--- `IOError`, what a failed operation on a file, a pipe or a standard stream
--- says, and the one place a negated `errno` becomes one. `System.IO`
--- re-exports the two types; the library's I/O modules build them here.

import Turkey.FD as FD
import Turkey.Sys as Sys

--- What failed (`kind`), in which operation (`op`, such as "open"), and on
--- which path, if the operation had one. The path is kept for the message: an
--- error that says "no such file or directory" without saying which file is
--- the shape to avoid.
type IOError = IOError { kind : ErrorKind, op : String, path : Option String }

--- A closed sum, so that a program can recover from each case it cares about
--- and be told when it has not considered one. `NotSeekable` is a positional
--- read or write on something that has no positions: a FIFO, a pipe, a
--- terminal. `NotEmpty` is removing a directory that still has entries.
--- `Closed` is an operation on a file after `close`. `TimedOut` is an
--- operation given a deadline that passed first. `HostNotFound` is a name the
--- system's resolver has no address for (`Net`), and `Resolver` keeps the
--- resolver's own code for any other failure of a lookup: it is not an
--- `errno`, and differs by system. The network's own: `ConnectionRefused`,
--- nothing listening at the address; `ConnectionReset`, the peer ended the
--- connection abruptly; `Unreachable`, no route to the network or the host;
--- `AddressInUse`, a port another socket holds; and `Forbidden`, a name whose
--- every address the connect policy refused (`Net.resolve`). `Other`
--- keeps the `errno` of anything else.
type ErrorKind = NotFound | PermissionDenied | AlreadyExists | IsDirectory | NotDirectory
               | NotEmpty | BrokenPipe | NoSpace | NotSeekable | Closed | TimedOut
               | HostNotFound | Resolver(Int) | ConnectionRefused | ConnectionReset
               | Unreachable | AddressInUse | Forbidden | Other(Int)

--- The error a failed `result` -- a negated `errno`, or `FD.closed` -- means
--- for `op` on `path`.
fun failure(op : String, path : Option String, result : Int) -> IOError =
    IOError { kind = kindOf(result), op = op, path = path }

fun kindOf(result : Int) -> ErrorKind {
    if result == FD.closed { return Closed }
    let errno = -result
    if errno == Sys.enoent { NotFound }
    else if errno == Sys.eacces || errno == Sys.eperm { PermissionDenied }
    else if errno == Sys.eexist { AlreadyExists }
    else if errno == Sys.eisdir { IsDirectory }
    else if errno == Sys.enotdir { NotDirectory }
    else if errno == Sys.enotempty() { NotEmpty }
    else if errno == Sys.epipe { BrokenPipe }
    else if errno == Sys.enospc { NoSpace }
    else if errno == Sys.espipe { NotSeekable }
    else if errno == Sys.etimedout() { TimedOut }
    else if errno == Sys.econnrefused() { ConnectionRefused }
    else if errno == Sys.econnreset() { ConnectionReset }
    else if errno == Sys.enetunreach() || errno == Sys.ehostunreach() { Unreachable }
    else if errno == Sys.eaddrinuse() { AddressInUse }
    else { Other(errno) }
}

--- As `strerror` words it, for the cases it is worth naming.
fun describe(k : ErrorKind) -> String = match k {
    NotFound -> "no such file or directory"
    PermissionDenied -> "permission denied"
    AlreadyExists -> "file exists"
    IsDirectory -> "is a directory"
    NotDirectory -> "not a directory"
    NotEmpty -> "directory not empty"
    BrokenPipe -> "broken pipe"
    NoSpace -> "no space left on device"
    NotSeekable -> "illegal seek"
    Closed -> "file already closed"
    TimedOut -> "timed out"
    HostNotFound -> "no such host"
    Resolver(code) -> resolverMessage(code)
    ConnectionRefused -> "connection refused"
    ConnectionReset -> "connection reset by peer"
    Unreachable -> "network or host unreachable"
    AddressInUse -> "address already in use"
    Forbidden -> "every address refused by the connect policy"
    Other(errno) -> otherMessage(errno)
}

-- As `gai_strerror` words them.
fun resolverMessage(code : Int) -> String {
    if code == Sys.eaiAgain() { "temporary failure in name resolution" }
    else if code == Sys.eaiFail() { "non-recoverable failure in name resolution" }
    else { "name resolution failed: code " + show(code) }
}

fun otherMessage(errno : Int) -> String {
    if errno == Sys.eio { "input/output error" }
    else if errno == Sys.ebadf { "bad file descriptor" }
    else if errno == Sys.einval { "invalid argument" }
    else if errno == Sys.emfile { "too many open files" }
    else if errno == Sys.erofs { "read-only file system" }
    else if errno == Sys.enomem { "cannot allocate memory" }
    else if errno == Sys.exdev { "cross-device link" }
    else if errno == Sys.eloop() { "too many levels of symbolic links" }
    else if errno == Sys.enametoolong() { "file name too long" }
    else if errno == Sys.eilseq() { "illegal byte sequence" }
    else { "errno " + show(errno) }
}

--- "open foo.txt: no such file or directory".
instance Error IOError {
    fun message(e) = match e.path {
        Some(p) -> e.op + " " + p + ": " + describe(e.kind)
        None -> e.op + ": " + describe(e.kind)
    }
}

instance Show IOError { fun show(e) = message(e) }
