export (FD, fd, number, closed, timedOut, read, readBy, write, writeText, readAt, writeAt, using, flock,
        close)

-- A descriptor that tasks share: the one place the I/O layer decides when a
-- descriptor number stops being this file's, and which of two tasks using it
-- goes first.
--
-- Nothing stops two tasks holding the same handle, so `close` can run while
-- another task is inside a `read`. Closing the number there and then would let
-- the next `open` anywhere in the process reuse it, and the read, or one about
-- to start, would then be reading someone else's file. So every operation
-- holds a reference for as long as it uses the number, `close` only marks the
-- descriptor closed, and `close(2)` runs when the last reference is dropped.
--
-- **The state word**, a `Prim.Atomic` of its own, so that every access to it
-- is atomic, as `System.Sync` keeps its own:
--
-- * bit 0, `closedBit`: `close` has been called. Nothing clears it, and an
--   operation that finds it set takes no reference and answers `closed`;
-- * bit 1, `readLock`, and bit 2, `writeLock`: held by the one sequential
--   read and the one sequential write in progress;
-- * bit 3, `readWaited`, and bit 4, `writeWaited`: a task may be waiting for
--   that lock, so the release must look for waiters;
-- * from bit 5 up, the reference count, in units of `reference`.
--
-- A reference is taken in the same compare-and-swap as a lock, and dropped in
-- the same one as its release, so a sequential operation costs two atomic
-- instructions however much it moves.
--
-- **The locks** make a sequential operation atomic with respect to others of
-- its direction: a `write` of a whole buffer goes out contiguously even when
-- the kernel takes it in pieces, and two reads never split one transfer
-- between them. A task waiting for a lock is suspended (`Scheduler.waitUntil`)
-- and its worker runs other tasks; nothing here blocks a worker but the system
-- call itself. A release wakes every task waiting for that lock, and the ones
-- that lose the race wait again, as `System.Sync`'s mutex does.
--
-- **Positional operations take a reference and no lock.** Each names its own
-- offset and leaves the descriptor's position alone, so it is independent of
-- every other operation, and any number of them run at once on one `FD`.
--
-- **The retry loop.** A call interrupted by a signal is made again at once.
-- `EAGAIN`, from a descriptor in non-blocking mode, parks the task until the
-- poller reports the descriptor ready for that direction
-- (`Turkey.Wait.readable`, `writable`) and then makes the call again. Each
-- park registers once and the registration fires once, level-triggered, so
-- readiness that arrived between the `EAGAIN` and the park is reported at
-- once and nothing needs remembering. The lock of the direction is held while
-- parked, so each direction has at most one parked task, and the parked
-- operation holds a reference, so the number cannot be closed and handed to
-- another file while a registration for it exists. `close` ends a parked wait
-- (`Turkey.Wait.cancel`) and the operation answers `closed`; a wait the poller
-- cannot make (the kernel refuses the descriptor) answers its negated `errno`.
-- Positional operations see `EAGAIN` from no descriptor that supports them, and
-- yield instead of parking.
--
-- **Inherited descriptors.** A descriptor the program did not open keeps the
-- mode its parent gave it, and this module never changes it. One in blocking
-- mode that is a FIFO, socket or character device (a terminal) can make a
-- `read` wait in the kernel for as long as nothing arrives, holding its
-- worker; so the first `read` looks at the descriptor once (`readMode`) and,
-- for one of those, every `read` waits for readable first and then makes the
-- call, which returns what is there. Writes to it stay blocking. Regular
-- files and directories are never looked at again and never reach the poller.
-- If the poller refuses such a descriptor the `read` makes its call plainly
-- from then on, as a blocking read of any other descriptor. `polled` records
-- that a wait was ever made on the descriptor,
-- so that only then is its poller registration dropped before the number is
-- closed.
--
-- **A deadline.** `readBy` takes one, a point on `Turkey.Wait.now`'s clock or
-- -1 for none, and gives up at it from either wait: the one before the call
-- and the one after `EAGAIN`.
--
-- Every result is a count, never negative, or the negated `errno`, as
-- `Turkey.IO`'s are, or `closed`, or, for `readBy`, `timedOut`.

import Turkey.Coroutine as Co
import Turkey.IO as IO
import Turkey.Scheduler as Scheduler
import Turkey.Sys as Sys
import Turkey.Wait as Wait
import Target (OS(..))
import Target as Target

-- The state word's bits, as above.
let closedBit : Int = 1
let readLock : Int = 2
let writeLock : Int = 4
let readWaited : Int = 8
let writeWaited : Int = 16
let reference : Int = 32

-- What an operation on an `FD` that has been closed answers: below every
-- negated `errno`, so that it cannot be mistaken for one.
let closed : Int = -0x1_0000_0000

-- What `readBy` answers when its deadline came first: `Turkey.Wait.timedOut`,
-- below every negated `errno` and distinct from `closed`.
let timedOut : Int = Wait.timedOut

-- `readMode` is changed only by whoever holds the read lock, and `polled`
-- only from False to True, so neither needs an atomic instruction.
type FD = FD {
    state        : Prim.Atomic,
    number       : Int,
    var readMode : ReadMode,
    var polled   : Bool,
    var readers  : Vec Co.Coroutine,
    var writers  : Vec Co.Coroutine,
}

-- An `FD` for a descriptor the caller owns from now on: its `close` closes it.
fun fd(number : Int) -> FD = FD { state = Prim.atomicNew(0), number = number, readMode = Unknown, polled = False, readers = [], writers = [] }

-- What `readMode` holds: `Unknown`, not yet looked at; `CallAtOnce`; or
-- `WaitFirst`, wait for readable before each call.
type ReadMode = Unknown | CallAtOnce | WaitFirst

-- The descriptor number, for a caller that only reports it. Using it for a
-- system call races `close` in exactly the way this module exists to prevent.
fun number(f : FD) -> Int = f.number

-- -- sequential -----------------------------------------------------------------------

-- Up to `to - from` bytes into `bytes[from..to)`, from the descriptor's
-- position: how many, at least 1, or 0 at end of file. One read at a time per
-- `FD`.
fun read(f : FD, bytes : Array Byte, from : Int, to : Int) -> Int =
    readBy(f, bytes, from, to, -1)

-- `read`, giving up at `deadline`, a monotonic time in nanoseconds
-- (`Turkey.Wait.now`) or -1 for none: `timedOut` if it came first. A read that
-- timed out has transferred nothing, and leaves the descriptor as it was, so
-- the caller may make it again as it would after `EAGAIN`.
fun readBy(f : FD, bytes : Array Byte, from : Int, to : Int, deadline : Int) -> Int {
    if !lock(f, readLock, readWaited) { return closed }
    var n = 0
    match f.readMode {
        Unknown -> { f.readMode = inherited(f.number) }
        CallAtOnce -> {}
        WaitFirst -> {}
    }
    while True {
        match f.readMode {
            WaitFirst -> {
                let w = park(f, False, deadline)
                if w == closed || w == timedOut {
                    n = w
                    break
                }
                if w != 0 { f.readMode = CallAtOnce }
            }
            Unknown -> {}
            CallAtOnce -> {}
        }
        n = IO.read(f.number, bytes, from, to)
        if n == -Sys.eintr { continue }
        if n == -Sys.eagain() {
            let w = park(f, False, deadline)
            if w == 0 { continue }
            n = w
        }
        break
    }
    unlock(f, readLock, readWaited)
    n
}

-- All of `bytes[from..to)`, at the descriptor's position: `to - from`, or the
-- negated `errno` of the call that failed, after whatever went before it. One
-- write at a time per `FD`, so the bytes go out contiguously.
fun write(f : FD, bytes : Array Byte, from : Int, to : Int) -> Int {
    if !lock(f, writeLock, writeWaited) { return closed }
    let n = writeAll(f, fun(at) = IO.write(f.number, bytes, at, to), from, to, True)
    unlock(f, writeLock, writeWaited)
    n
}

-- `write`, from a string's own bytes, counted in bytes.
fun writeText(f : FD, text : String, from : Int, to : Int) -> Int {
    if !lock(f, writeLock, writeWaited) { return closed }
    let n = writeAll(f, fun(at) = IO.writeText(f.number, text, at, to), from, to, True)
    unlock(f, writeLock, writeWaited)
    n
}

-- -- positional -----------------------------------------------------------------------

-- `bytes[from..to)` filled from `offset` in the file, or as much of it as the
-- file holds: how many, fewer than asked for only at end of file. The
-- position is neither used nor moved, and no lock is taken.
fun readAt(f : FD, offset : Int, bytes : Array Byte, from : Int, to : Int) -> Int {
    if !acquire(f) { return closed }
    var at = from
    var result = 0
    while at < to {
        let n = IO.readAt(f.number, offset + (at - from), bytes, at, to)
        if n == -Sys.eintr { continue }
        if n == -Sys.eagain() {
            Scheduler.yield()
            continue
        }
        if n < 0 {
            result = n
            break
        }
        if n == 0 { break }
        at = at + n
    }
    let _ = release(f)
    if result < 0 { result } else { at - from }
}

-- All of `bytes[from..to)` at `offset` in the file, the position neither used
-- nor moved, and no lock taken: `to - from`, or the negated `errno`. Two
-- overlapping `writeAt`s may interleave, as `pwrite`s do.
fun writeAt(f : FD, offset : Int, bytes : Array Byte, from : Int, to : Int) -> Int {
    if !acquire(f) { return closed }
    let n = writeAll(f, fun(at) = IO.writeAt(f.number, offset + (at - from), bytes, at, to),
                     from, to, False)
    let _ = release(f)
    n
}

-- -- any other call ---------------------------------------------------------------------

-- What `call` answers given the descriptor number, holding a reference while
-- it runs and taking no lock: for a call that is neither a read nor a write,
-- such as `flock`, `fstat` or an `openat` relative to a directory. `closed` if
-- `f` is.
fun using(f : FD, call : fun(Int) -> Int) -> Int {
    if !acquire(f) { return closed }
    let r = call(f.number)
    let _ = release(f)
    r
}

-- Take `flock`'s `operation` lock (`Sys.lockExclusive`, without `LOCK_NB`)
-- on `f`'s file, waiting while another holder has it: 0, `closed` if `f` is or
-- is closed during the wait, `timedOut` if `deadline` came first, or the
-- negated `errno`. Only an answer of 0 leaves the lock taken.
--
-- On Darwin the wait parks the task (`Turkey.Wait.lockedUnless`) and the
-- deadline is a point on `Turkey.Wait.now`'s clock, or -1 for none. Linux
-- reports no release of a lock, so there the call waits in the kernel and
-- holds its worker, and a deadline other than -1 answers `-EINVAL`.
fun flock(f : FD, operation : Int, deadline : Int) -> Int {
    if !acquire(f) { return closed }
    let r = match Target.os {
        Darwin -> flockParked(f, operation, deadline)
        Linux -> if deadline < 0 { IO.flock(f.number, operation) } else { -Sys.einval }
    }
    let _ = release(f)
    r
}

-- Try the lock first, so that one nobody holds costs a single call and no
-- trip through the scheduler's lock.
fun flockParked(f : FD, operation : Int, deadline : Int) -> Int {
    let r = IO.flock(f.number, operation | Sys.lockNonBlocking)
    if r != -Sys.eagain() { return r }
    let stop = fun() = Prim.atomicGet(f.state) & closedBit != 0
    let w = Wait.lockedUnless(f.number, operation, deadline, stop)
    if w == Wait.cancelled { closed } else { w }
}

-- -- closing --------------------------------------------------------------------------

-- Mark `f` closed: every operation that starts afterwards answers `closed`,
-- and a task waiting for a lock is woken to answer it too. The descriptor
-- itself is closed when the last operation using it finishes, which is now
-- if none is.
--
-- 0, or the negated `errno` of `close(2)` if it ran here; a failure in a
-- `close(2)` that an operation finishing later runs is not reported to
-- anyone. 0 again for an `FD` already closed.
fun close(f : FD) -> Int {
    let p = f.state
    while True {
        let state = Prim.atomicGet(p)
        if state & closedBit != 0 { return 0 }
        let marked = (state | closedBit) + reference
        if Prim.atomicSwapIf(p, state, marked) == state { break }
    }
    -- A waiter registers under the scheduler's lock after seeing the bit
    -- clear, so one that registered before this takes the lock is in a list,
    -- and one after sees the bit.
    Scheduler.lock()
    for c in f.readers { Scheduler.wake(c) }
    for c in f.writers { Scheduler.wake(c) }
    f.readers = []
    f.writers = []
    Scheduler.changed()
    Scheduler.unlock()
    -- A task parking on the descriptor either registered before this takes the
    -- scheduler's lock, and is cancelled, or finds the bit set under it
    -- (`park`).
    Wait.cancel(f.number)
    release(f)
}

-- -- underneath -----------------------------------------------------------------------

-- Take a reference, unless `f` is closed. Whether it was taken.
fun acquire(f : FD) -> Bool {
    let p = f.state
    while True {
        let state = Prim.atomicGet(p)
        if state & closedBit != 0 { return False }
        if Prim.atomicSwapIf(p, state, state + reference) == state { return True }
    }
    False
}

-- Drop a reference, closing the descriptor if it was the last and `f` is
-- closed: 0, or the negated `errno` of that `close(2)`. Exactly one release
-- sees the count reach 0 with the bit set, since no reference is taken once
-- it is set and `close` holds one of its own while it sets it.
fun release(f : FD) -> Int {
    let before = Prim.atomicAddTo(f.state, -reference)
    if before - reference == closedBit { closeNumber(f) } else { 0 }
}

-- Take `bit`'s lock and a reference with it, waiting for the lock if it is
-- held, unless `f` is or becomes closed. Whether it was taken.
fun lock(f : FD, bit : Int, waited : Int) -> Bool {
    let p = f.state
    let state = Prim.atomicGet(p)
    if state & (closedBit + bit) == 0 {
        if Prim.atomicSwapIf(p, state, state + bit + reference) == state { return True }
    }
    let claim = Claim { got = False }
    Scheduler.waitUntil(fun() = tryLock(f, bit, waited, claim),
                        fun(c) = if bit == readLock { Vec.push(f.readers, c) }
                                 else { Vec.push(f.writers, c) })
    claim.got
}

-- Whether a task that waited got the lock, or stopped waiting because `f` was
-- closed. Made only when the lock is contended.
type Claim = Claim { var got : Bool }

-- Under the scheduler's lock: take the lock if it is free, or mark it waited
-- for. Whether to stop waiting -- because the lock was taken, or `f` closed.
fun tryLock(f : FD, bit : Int, waited : Int, claim : Claim) -> Bool {
    let p = f.state
    while True {
        let state = Prim.atomicGet(p)
        if state & closedBit != 0 { return True }
        if state & bit == 0 {
            if Prim.atomicSwapIf(p, state, state + bit + reference) == state {
                claim.got = True
                return True
            }
        } else if state & waited != 0 {
            return False
        } else if Prim.atomicSwapIf(p, state, state + waited) == state {
            return False
        }
    }
    False
}

-- Release `bit`'s lock and its reference, waking the tasks waiting for the
-- lock if any may be, and closing the descriptor if this was the last
-- reference to a closed `f`.
fun unlock(f : FD, bit : Int, waited : Int) -> Unit {
    let p = f.state
    var before = 0
    while True {
        before = Prim.atomicGet(p)
        let after = (before & Prim.intNot(bit + waited)) - reference
        if Prim.atomicSwapIf(p, before, after) == before { break }
    }
    if before & waited != 0 {
        Scheduler.lock()
        if bit == readLock {
            for c in f.readers { Scheduler.wake(c) }
            f.readers = []
        } else {
            for c in f.writers { Scheduler.wake(c) }
            f.writers = []
        }
        Scheduler.changed()
        Scheduler.unlock()
    }
    if (before & Prim.intNot(bit + waited)) - reference == closedBit {
        let _ = closeNumber(f)
    }
}

-- Close the number, for the one that dropped the last reference: after the
-- poller has dropped what it holds for it, since no wait can start now and
-- none is parked, a parked task holding a reference.
fun closeNumber(f : FD) -> Int {
    if f.polled { Wait.forget(f.number) }
    IO.close(f.number)
}

-- `write` until all of `from..to` is taken: `step(at)` writes from `at` and
-- answers what the call did. Retried at once after a signal; after `EAGAIN`
-- the task parks until the descriptor is writable if `sequential`, and
-- yields otherwise; 0 from a non-empty write, which would otherwise loop, is
-- reported as `EIO`.
fun writeAll(f : FD, step : fun(Int) -> Int, from : Int, to : Int, sequential : Bool) -> Int {
    var at = from
    while at < to {
        let n = step(at)
        if n == -Sys.eintr { continue }
        if n == -Sys.eagain() {
            if !sequential {
                Scheduler.yield()
                continue
            }
            let w = park(f, True, -1)
            if w == 0 { continue }
            return w
        }
        if n < 0 { return n }
        if n == 0 { return -Sys.eio }
        at = at + n
    }
    to - from
}

-- The descriptor was not ready, and the caller holds a reference and the
-- direction's lock: wait until it is, and answer 0. `closed` if `close` ended
-- the wait, `timedOut` if `deadline` came first, or the negated `errno` of a
-- wait the poller could not make.
fun park(f : FD, writing : Bool, deadline : Int) -> Int {
    f.polled = True
    let stop = fun() = Prim.atomicGet(f.state) & closedBit != 0
    let w = if writing { Wait.writableUnless(f.number, deadline, stop) }
            else { Wait.readableUnless(f.number, deadline, stop) }
    if w == Wait.cancelled { closed } else { w }
}

-- How `read` treats a descriptor it has not looked at: `WaitFirst` for one in
-- blocking mode that is a FIFO, socket or character device, `CallAtOnce`
-- otherwise, including when it cannot tell.
fun inherited(number : Int) -> ReadMode {
    let flags = IO.fcntl(number, Sys.getStatusFlags)
    if flags < 0 || flags & Sys.nonBlocking() != 0 { return CallAtOnce }
    let stat = Array.filled(Sys.statBytes(), Byte.truncate(0))
    if IO.fstat(number, stat) < 0 { return CallAtOnce }
    let kind = Sys.fileType(IO.statMode(stat))
    if kind == Sys.fifo || kind == Sys.socket || kind == Sys.characterDevice {
        WaitFirst
    } else {
        CallAtOnce
    }
}
