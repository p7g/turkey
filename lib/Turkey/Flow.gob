export (Flow(..))

--- What a `return`, `break` or `continue` becomes when it crosses a `?`: the
--- value the rest of the block is given, or the transfer that leaves it. Only
--- the compiler writes one, in any module, so this module imports nothing and
--- the compiler loads it ahead of every other.

import Prelude ()

type Flow a b r = Fall(a) | Brk(b) | Cont | Ret(r)
