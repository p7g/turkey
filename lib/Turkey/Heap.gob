export (
    allocate, collect, report, rootsHead, pause, retireHeld,
)

-- The heap and its collector: regions of fixed-size slots, allocation into
-- them, and a non-moving mark and sweep over exact roots.
--
-- Generational, with sticky marks: an object that survives a collection is
-- old and stays marked, and a minor collection traces only from the roots and
-- the old objects the write barrier remembered, and frees only young objects.
-- A full collection clears the marks and traces everything.
--
-- Non-moving is load-bearing beyond this module. The allocators in
-- `Turkey.Alloc` take managed operands as raw words, which is sound only
-- because the object a word names is still there after a collection, and
-- raw memory may hold an address across calls for the same reason. A moving
-- collector would have to change the allocator interface first.
--
-- A giblet module, and the one that most needs to be: this is the code that
-- runs when nothing may allocate, and it has no roots of its own because it is
-- what reads everyone else's. Every value here is an `Int`, a `Float`, a
-- `Prim.Ptr` or an enumeration such as `Bool`, none of them traced, and every
-- structure is raw memory at fixed offsets.
--
-- The collector's state is this module's globals, set up by early
-- initialization, which runs before anything can allocate. A C caller that
-- uses the program's Turkey code without running the program -- the runtime's
-- own tests -- calls `turkey_giblets_initialize` first, for the same reason.
--
-- The heap verifier, `Turkey.HeapCheck`, is handed a snapshot of this state
-- and decodes it by its own copy of the layouts below, so that a collector bug
-- is not checked by the same bug. It cannot import this module, since this one
-- imports it, and nothing here may move into it for this module to share.

import Prelude ()
import Data.Int (Int)
import Data.Float (Float)
import Data.Tuple (Unit)
import Data.Eq (Eq(..), (==), (!=))
import Data.Ord (Ord(..), (<), (<=), (>), (>=))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..), (+), (-), (*), (/), (%))
-- A shift by a variable amount is written `Prim.intShl` or `Prim.intShr`, not
-- `<<` or `>>`. The operators check the amount and panic through `error`,
-- which allocates, so a variable shift does not compile in a giblet. A
-- constant amount's check folds away.
import Bits (BitAnd(..), BitOr(..), BitXor(..), Shift(..), (&), (|), (^), (<<), (>>))
import Data.Error (Error(..))
import Control.Iterator (Iterator(..))
import Data.Int ()
import Data.Bool (Bool(..))
import Turkey.HeapCheck as Check
import Turkey.Memory as Memory
import Turkey.Process as Process
import Turkey.Libc as Libc
import Turkey.Lock as Lock
import Turkey.Stack as Stack
import Turkey.Sys as Sys
import Turkey.Workers as Workers

-- -- layouts ----------------------------------------------------------------------------
--
-- Copied by `Turkey.HeapCheck` and, for the root frame, the object header,
-- the cursors, the size classes and the size table, shared with the generated
-- code: `Turkey.Emit` builds the globals' root frame, and takes small objects'
-- slots from the cursors itself by `Turkey.Runtime`'s copy of those layouts. A
-- change here is a change there.

-- An object's header, the word its address points at: its generation (u8),
-- its kind (u8), the count of the traced words its fields start with (u16),
-- and its tag (i32), which the collector does not read. In an array the
-- count is the element's layout code, and in a cell it is 1 if the value is
-- traced. `Turkey.Runtime.objectFields` says the same.
let headerGeneration : Int = 0

-- The generation's values. An object is young from its allocation until the
-- first collection that marks it, and old from then on: one survived
-- collection promotes. An old object given a young one by a store is
-- remembered, once, by the write barrier (`writeBarrier`), which `Turkey.Select`
-- emits: the compiler reads these values too, as does every frame object's
-- header, which is young.
let young : Int = 0
let old : Int = 1
let rememberedOld : Int = 2

-- The kinds that are not laid out as fields after the header: an array, whose
-- length follows the header and its elements the length, and a cell, whose
-- value follows the header. The rest are 0 constructor, 1 record, 3 closure
-- and 4 environment.
let arrayKind : Int = 2
let cellKind : Int = 5

-- `HeapRegion`. Small objects live in fixed-size slots of a 64KB region
-- aligned to its size, so a header's region is its address with the low bits
-- cleared. A large object owns a region of its own, `reserved` bytes long,
-- whose one slot is the object.
let regionBytes : Int = 0x10000
-- Clears the offset within a region, leaving its base.
let regionMask : Int = -0x10000
-- The words of each slot bitmap: 4096 bits, which the 4028 slots of the
-- 16-byte class need.
let regionWords : Int = 64
let regionClasses : Int = 26
let regionNext : Int = 0
let regionAvailableNext : Int = 8
let regionSlotSize : Int = 16
let regionReserved : Int = 24
let regionCapacity : Int = 32
let regionUsed : Int = 36
let regionLive : Int = 40
let regionSearchWord : Int = 44
let regionSizeClass : Int = 48
let regionAllocated : Int = 56
let regionMarked : Int = 568
-- The region's size table, or null: see `sizesKept`.
let regionSizes : Int = 1080
-- Where the slots begin. Eight-byte alignment is all an object needs, so
-- every slot size is a multiple of 8 and the smallest is 16: the header and
-- one word.
let regionData : Int = 1088

-- `RootFrame`, the shadow stack -- the globals' frame, and any a C caller
-- registers -- is a chain of these: the previous frame, a NUL-terminated
-- function name, the slot count, the slots, and which of the first 64 slots
-- are live right now. Slots from 64 up are always scanned.
let frameCount : Int = 16
let frameValues : Int = 24
let frameLive : Int = 32

-- Words below this in a traced slot are not pointers: nothing is ever mapped
-- in the first page, on any target. Generated code keeps a compact sum's
-- nullary constructors there -- `None` is 0, a second nullary 1 -- so a traced
-- slot, root or array element may hold one, and the collector skips it the way
-- it skips null.
let immediates : Int = 4096

-- Where an object's fields are, and so its traced words: right after the
-- header, since the compiler puts every traced field first
-- (`Turkey.Runtime.layout`). A cell's value is there too. An array's length
-- is there instead, and its elements after it; they are traced words if the
-- element's layout code is 7.
let objectFields : Int = 8
let arrayLength : Int = 8
let arrayElements : Int = 16

-- One frame-table entry: a return address, how many roots are live across the
-- call, and where their `x29` offsets are.
let entryBytes : Int = 24

-- -- state ------------------------------------------------------------------------------

-- Held by a worker while it edits what the workers share: the region list,
-- the available lists, the region table and the counts. A worker's own
-- cursors and the regions they own are its alone and need no lock. A
-- collection runs with every other worker stopped, so it takes none.
--
-- Never held across a panic: generated code returns from a call that raised
-- one straight to its caller, past any release after it, so a function that
-- runs under the lock reports failure and its caller panics once it has let go.
var heapLock : Prim.Ptr = Lock.new()

var regions : Prim.Ptr = Prim.ptrNull()
-- Per size class, the regions with a free slot that no cursor owns, linked by
-- `availableNext`.
var available : Prim.Ptr = zeroed(8 * regionClasses)
var regionBytesInUse : Int = 0
var regionBytesPeak : Int = 0

-- Every live region's base, as an open-addressed set, so that `findObject`
-- can ask whether an arbitrary word is a heap pointer in constant time. GC
-- stress asks that of every pointer it traces, at every allocation, and a walk
-- of the region list there made a stressed run quadratic in the heap.
-- `regionOf` alone cannot answer it, because the aligned base of a word that is
-- not in the heap is not a region and must not be read. Linear probing with
-- backward-shift deletion, so no tombstones build up across the regions the
-- sweep frees. Only the base block of a large region is entered: its one
-- object's header is in that block.
var regionTable : Prim.Ptr = Prim.ptrNull()
var regionTableCapacity : Int = 0
var regionTableCount : Int = 0

var roots : Prim.Ptr = Prim.ptrNull()
var heapCount : Int = 0
-- Objects, and the bytes of their slots, allocated since the last
-- collection. The bytes are what trigger the next one.
var allocationsSince : Int = 0
var bytesSince : Int = 0

-- What a worker's cursors have taken since it was last folded into the three
-- counts above, by `retire` or when the worker took a region: objects, objects since the collection, and their bytes,
-- in the last three words of its record (`Prim.processState`, from 1984).
-- Kept per worker so that a refill from a region the cursor owns touches
-- nothing shared and takes no lock.
fun localAdd(objects : Int, bytes : Int) -> Unit {
    let w = Prim.processState()
    Prim.storeI64(w, 1984, plus(Prim.loadI64(w, 1984), objects))
    Prim.storeI64(w, 1992, plus(Prim.loadI64(w, 1992), objects))
    Prim.storeI64(w, 2000, plus(Prim.loadI64(w, 2000), bytes))
}

fun localBytes() -> Int = Prim.loadI64(Prim.processState(), 2000)

-- Fold worker `w`'s counts into the heap's and zero them.
fun localFold(w : Prim.Ptr) -> Unit {
    heapCount = plus(heapCount, Prim.loadI64(w, 1984))
    allocationsSince = plus(allocationsSince, Prim.loadI64(w, 1992))
    bytesSince = plus(bytesSince, Prim.loadI64(w, 2000))
    Prim.storeI64(w, 1984, 0)
    Prim.storeI64(w, 1992, 0)
    Prim.storeI64(w, 2000, 0)
}
-- The bytes of the slots the last sweep kept: a large object's whole region.
var liveBytes : Int = 0
var threshold : Int = 131072
var collections : Int = 0

-- The grey set, as an explicit stack per worker: tracing by recursion made
-- the native stack depth proportional to the longest chain of heap pointers,
-- and a long list is an ordinary thing to build. Each worker's is the
-- stack's address, how many entries it holds and how many it has room for,
-- `markerBytes` apart by worker index; kept across collections, so its
-- growth is paid for once.
let markerBytes : Int = 24
var markers : Prim.Ptr = zeroed(markerBytes * Workers.threadLimit())

-- The old objects the write barrier has seen given a young one since the last
-- collection, each once: its generation says it is here.
-- The write barrier's remembered set is per worker, so that no two barriers
-- write one buffer: a `malloc`ed array of objects, its count and its
-- capacity, in words 296, 304 and 312 of the running worker's record
-- (`Prim.processState`). Offsets are literals in the accessors, since a `let`
-- is a load from its global. A collection consumes the running worker's.
fun remembered() -> Prim.Ptr = Prim.loadPtr(Prim.processState(), 296)
fun rememberedSet(buffer : Prim.Ptr) -> Unit = Prim.storePtr(Prim.processState(), 296, buffer)
fun rememberedCount() -> Int = Prim.loadI64(Prim.processState(), 304)
fun rememberedCountSet(n : Int) -> Unit = Prim.storeI64(Prim.processState(), 304, n)
fun rememberedCapacity() -> Int = Prim.loadI64(Prim.processState(), 312)
fun rememberedCapacitySet(n : Int) -> Unit = Prim.storeI64(Prim.processState(), 312, n)

-- The arm64 backend's frame table, sorted by return address.
var frameEntries : Prim.Ptr = Prim.ptrNull()
var frameEntryCount : Int = 0

-- GC stress: a collection at every allocation, or with TURKEY_GC_STRESS=N
-- for N above 1, at random intervals averaging N allocations -- each gap
-- uniform in 1..2N-1, so that no allocation site is always skipped. The
-- sequence is TURKEY_GC_STRESS_SEED's, 1 by default, so that a failing run can
-- be repeated and several seeds can cover different phases. Every allocation
-- takes the slow path while it is on, which is where it counts down.
var stressInterval : Int = intervalFrom(Libc.getenv(Prim.cString("TURKEY_GC_STRESS")))
var stress : Bool = stressInterval > 0
var stressRandom : Int = seedFrom(Libc.getenv(Prim.cString("TURKEY_GC_STRESS_SEED")))
var stressCountdown : Int = 1

-- Heap verification at every collection, by `Turkey.HeapCheck`. Fixed when the
-- program is compiled, by `boot --gc-verify` (`Turkey.Build`), so that a
-- program compiled without it has no verifier at all: nothing writes this
-- `var`, so the optimizer reads it as its constant. A C caller driving the
-- runtime turns it on and off with `turkey_gc_set_verify`, in a build that
-- exports that, which is what keeps it a variable there.
var verify : Bool = Prim.gcVerify
var verifyIgnored : Bool = notCompiledIn(verify, Prim.cString("TURKEY_GC_VERIFY"),
                                         Prim.cString("--gc-verify"))

-- Whether every region keeps a size table: a word per eight bytes of its
-- first 64KB, holding the size of the object at that offset, written by every
-- allocation. No object records its size, so the table is how the verifier
-- checks that an object fits its slot and has its slot's size class, which is
-- the check that the compiler's copy of the class rule
-- (`Turkey.Runtime.sizeClass`) agrees with this module's. Only in a program
-- compiled with `--gc-verify`, whose generated code writes the table too; a
-- program compiled without it has no table and no stores.
let sizesKept : Bool = Prim.gcVerify

-- Whether a collection may be minor: trace only from the roots and the
-- remembered objects, keep every old object's mark, and free only young
-- objects. Sound only in a program whose every store runs the write barrier,
-- which every program this compiler builds does. C that stores pointers into
-- old objects without calling `turkey_write_barrier` must turn it off with
-- `turkey_gc_set_generational`. TURKEY_GC_GENERATIONAL=0 makes every
-- collection full, for comparison.
var generational : Bool = generationalFrom(Libc.getenv(Prim.cString("TURKEY_GC_GENERATIONAL")))
-- Whether the collection in progress, or the last one, is minor.
var minor : Bool = False
-- The bytes the last full collection kept: the live set, as best it is known.
-- A minor collection's `liveBytes` also counts every old object that died
-- since, which only a full collection finds.
var liveBytesAfterFull : Int = 0

-- Opt-in accounting, printed one line per collection and in `report` in a
-- program compiled with `boot --gc-stats`: what the collector costs and what
-- drives it, from one run rather than from a profiler. Counting sends every
-- allocation down the slow path (`refill`), so a run's times include that.
var statsWanted : Bool = Prim.gcStats
var statsIgnored : Bool = notCompiledIn(statsWanted, Prim.cString("TURKEY_GC_STATS"),
                                        Prim.cString("--gc-stats"))

-- The collector runs again once this many times the live set's bytes have
-- been allocated, or 64KB times it while the live set is smaller than that.
-- The live set is what the last full collection kept: sized from a minor
-- collection's count, which includes the old objects that have died since,
-- the young generation grew with the garbage, and the self-compile's peak
-- memory with it, by 41% over the full collector's rather than 1%.
--
-- Bytes rather than objects, because the threshold is what bounds the heap:
-- counted in objects, a program allocating large arrays grows its heap by the
-- array's size for each one it counts as one. On the compiler's own run the
-- two cost the same at equal peak memory, so that is what decided it.
--
-- 2 is measured. The compiler compiling itself, whose heap is a slowly growing
-- long-lived program under a stream of short-lived trees, marks every live
-- object again at each collection, so the objects traced fall as 1/scale and
-- the peak heap grows by about a live set per step: 1.85G objects traced at
-- 3.1GB of regions at 2, 1.24G at 4.1GB at 3, 0.93G at 5.2GB at 4. The test
-- suite runs several of those compiles at once, which is what holds it at 2.
-- TURKEY_GC_THRESHOLD_SCALE overrides it for experiments.
var thresholdScale : Float =
    scaleFrom(Libc.getenv(Prim.cString("TURKEY_GC_THRESHOLD_SCALE")))

-- The counts every worker adds to as it allocates, by atomic adds: objects
-- and bytes allocated, and objects the write barrier remembered.
var statsCounts : Prim.Ptr = zeroed(24)
let statsAllocationsAt : Int = 0
let statsBytesAt : Int = 8
let statsRememberedAt : Int = 16
var statsTraced : Int = 0
var statsFreedTotal : Int = 0
var statsFreedPrevious : Int = 0
var statsLiveTotal : Int = 0
var statsLivePeak : Int = 0
var statsClock : Int = 0
-- The part of `statsClock` spent marking, roots included; the rest is the
-- sweep and the bookkeeping around it.
var statsMarkClock : Int = 0
var statsMinor : Int = 0
-- Allocations by what the object is, indexed by its kind, also added to
-- atomically: 0 constructor, 1 record, 2 array, 3 closure, 4 environment,
-- 5 cell.
var statsByKind : Prim.Ptr = zeroed(64)

-- Room to build one diagnostic or one line of the report, and a `timespec`.
let textBytes : Int = 256
var text : Prim.Ptr = zeroed(textBytes)
var textLength : Int = 0
var clock : Prim.Ptr = zeroed(16)

fun zeroed(bytes : Int) -> Prim.Ptr {
    let p = Libc.malloc(bytes)
    if Prim.ptrIsNull(p) {
        Process.panic(Prim.cString("out of memory"))
        return p
    }
    Memory.fill(p, bytes, 0)
    p
}

fun present(name : Prim.Ptr) -> Bool = !Prim.ptrIsNull(Libc.getenv(name))

-- Whether the environment asks this run for a debugging aid the program was
-- compiled without, which is said on stderr rather than ignored: the variable
-- names the aid, and a run is where it is easiest to expect it to work.
fun notCompiledIn(built : Bool, name : Prim.Ptr, flag : Prim.Ptr) -> Bool {
    if built || !present(name) { return False }
    say(Prim.cString("turkey: "))
    say(name)
    say(Prim.cString(" is ignored, because this program was compiled without "))
    say(flag)
    say(Prim.cString("; compile with "))
    say(flag)
    say(Prim.cString(" to use it\n"))
    True
}

fun say(text : Prim.Ptr) -> Unit {
    let _ = Libc.write(2, text, Libc.strlen(text))
}

-- -- raw words --------------------------------------------------------------------------

fun load32(p : Prim.Ptr, offset : Int) -> Int = Prim.charToInt(Prim.loadI32(p, offset))

fun store32(p : Prim.Ptr, offset : Int, value : Int) -> Unit =
    Prim.storeI32(p, offset, Prim.charFromInt(value))

-- Addresses and bitmaps are unsigned, and the primitives compare and shift
-- signed. A heap address happens to fit in 63 bits, but a word that is merely
-- claimed to be a pointer need not, and a stress run exists to be handed one.
-- Unsigned `a < b`: when the sign bits differ, the one with it set is larger.
fun below(a : Int, b : Int) -> Bool =
    if a ^ b < 0 { b < 0 } else { a < b }

-- The arithmetic on the paths every allocation and every traced object take
-- is wrapping: a checked `+` or `*` is a branch each, and what is computed
-- there -- offsets inside a region, counts of objects -- cannot overflow.
fun plus(augend : Int, addend : Int) -> Int = Prim.intAddWrapping(augend, addend)

fun times8(multiplicand : Int) -> Int = multiplicand << 3

-- `n` in 1..63: arm64 masks a shift amount to six bits, so a shift by 64 is a
-- shift by 0.
fun shiftRight(x : Int, n : Int) -> Int =
    Prim.intShr(x, n) & Prim.intSubWrapping(Prim.intShl(1, 64 - n), 1)

-- Every bit of `x` flipped.
fun complement(x : Int) -> Int = Prim.intNot(x)

fun bit(index : Int) -> Int = Prim.intShl(1, index & 63)

-- Bit `index` of the bitmap at `offset`; `index` is not negative.
fun bitWord(offset : Int, index : Int) -> Int = plus(offset, times8(index >> 6))

fun testBit(p : Prim.Ptr, offset : Int, index : Int) -> Bool =
    Prim.loadI64(p, bitWord(offset, index)) & bit(index) != 0

fun setBit(p : Prim.Ptr, offset : Int, index : Int) -> Unit {
    let word = bitWord(offset, index)
    Prim.storeI64(p, word, Prim.loadI64(p, word) | bit(index))
}

fun maxInt() -> Int = 0x7FFF_FFFF_FFFF_FFFF

-- -- regions ----------------------------------------------------------------------------

fun regionOf(header : Prim.Ptr) -> Prim.Ptr =
    Prim.ptrFromInt(Prim.ptrToInt(header) & regionMask)

-- Fibonacci hashing of the region's number. The verifier recomputes this to
-- check that every entry is reachable by probing, so the two must agree.
fun regionHash(region : Prim.Ptr) -> Int {
    let h = Prim.intMulWrapping(Prim.ptrToInt(region) / regionBytes, -7046029254386353131)
    (h ^ shiftRight(h, 32)) & (regionTableCapacity - 1)
}

fun tableAt(position : Int) -> Prim.Ptr = Prim.loadPtr(regionTable, 8 * position)

fun tableInsert(added : Prim.Ptr) -> Bool {
    if (regionTableCount + 1) * 2 > regionTableCapacity {
        let oldCapacity = regionTableCapacity
        let old = regionTable
        let capacity = if oldCapacity == 0 { 64 } else { oldCapacity * 2 }
        let grown = Libc.malloc(8 * capacity)
        if Prim.ptrIsNull(grown) { return False }
        Memory.fill(grown, 8 * capacity, 0)
        regionTable = grown
        regionTableCapacity = capacity
        for var i = 0; i < oldCapacity; i = i + 1 {
            let entry = Prim.loadPtr(old, 8 * i)
            if !Prim.ptrIsNull(entry) {
                var at = regionHash(entry)
                while !Prim.ptrIsNull(tableAt(at)) { at = (at + 1) & (capacity - 1) }
                Prim.storePtr(regionTable, 8 * at, entry)
            }
        }
        Libc.free(old)
    }
    var at = regionHash(added)
    while !Prim.ptrIsNull(tableAt(at)) {
        at = (at + 1) & (regionTableCapacity - 1)
    }
    Prim.storePtr(regionTable, 8 * at, added)
    regionTableCount = regionTableCount + 1
    True
}

fun tableContains(region : Prim.Ptr) -> Bool {
    if regionTableCapacity == 0 { return False }
    var at = regionHash(region)
    while !Prim.ptrIsNull(tableAt(at)) {
        if Prim.ptrEq(tableAt(at), region) { return True }
        at = (at + 1) & (regionTableCapacity - 1)
    }
    False
}

fun tableRemove(region : Prim.Ptr) -> Unit {
    let mask = regionTableCapacity - 1
    var at = regionHash(region)
    while !Prim.ptrEq(tableAt(at), region) { at = (at + 1) & mask }
    Prim.storePtr(regionTable, 8 * at, Prim.ptrNull())
    regionTableCount = regionTableCount - 1
    -- Pull back each entry after the hole that probing would no longer reach:
    -- one whose home is not cyclically within (hole, here].
    var here = (at + 1) & mask
    while !Prim.ptrIsNull(tableAt(here)) {
        let home = regionHash(tableAt(here))
        if (here - home) & mask >= (here - at) & mask {
            Prim.storePtr(regionTable, 8 * at, tableAt(here))
            Prim.storePtr(regionTable, 8 * here, Prim.ptrNull())
            at = here
        }
        here = (here + 1) & mask
    }
}

-- -- size classes and cursors -----------------------------------------------------------
--
-- Size classes are 16 to 64 bytes in steps of 8, 80 to 256 in steps of 16,
-- then powers of two up to half a region. A request above that is large and
-- gets a region of its own.
--
-- Allocation takes slots a bitmap word at a time. A class's cursor owns one
-- region, taken off the class's available list, and holds the free slots of
-- one word of it, already set in the region's allocation bitmap and counted
-- in its `used`, in
-- `heapCount` and in `allocationsSince`: so a slot is handed out by clearing a
-- bit in the cursor, and nothing else is written until the word runs out.
-- Generated code does exactly that for the small objects it allocates
-- (`Turkey.Select.allocate`), and calls in only when the free word is empty,
-- so that word is the only state an allocation may change before a refill.
--
-- Those reserved slots hold no object, so everything that reads the bitmaps
-- or the counts -- a collection, the verifier, the C queries -- first calls
-- `retire`, which gives them back, and gives up the regions, so that every
-- region with a free slot is on its available list again. After it, the heap
-- is exactly what it would be had each slot been allocated one at a time.
--
-- Owning a region is what lets several workers allocate at once: a region is
-- written by the one worker whose cursor owns it, and the available lists,
-- shared, are touched only to take a region or give one back.

-- The byte offsets of a cursor's fields, and its size.
let cursorFree : Int = 0
-- The header of the word's first slot.
let cursorBase : Int = 8
let cursorSlot : Int = 16
let cursorRegion : Int = 24
let cursorWord : Int = 32
let cursorBytes : Int = 64

-- The cursors are the running worker's, one per class from 320 bytes into its
-- record (`Prim.processState`), where `Turkey.Runtime` puts them and generated
-- code finds them. The offset is a literal in `cursorOf` rather than a `let`
-- because a `let` is a load from its global, on every slow-path allocation.

-- The largest object a size class holds: half a region.
let smallBytes : Int = 32768

-- Each small object's class, indexed by its size rounded up to 8 and divided
-- by 8. Every class boundary is a multiple of 8, so every size in one step
-- has the same class.
var classes : Prim.Ptr = classTable()

fun classTable() -> Prim.Ptr {
    let table = zeroed(4097)
    for var step = 1; step <= 4096; step = step + 1 {
        Prim.storeI8(table, step, Prim.byteFromInt(classFor(8 * step)))
    }
    table
}

fun classFor(bytes : Int) -> Int {
    if bytes <= 16 { return 0 }
    if bytes <= 64 { return ((bytes + 7) >> 3) - 2 }
    if bytes <= 256 { return ((bytes + 15) >> 4) + 2 }
    var classSize = 256
    var sizeClass = 18
    while classSize < bytes {
        classSize = classSize * 2
        sizeClass = sizeClass + 1
    }
    sizeClass
}

fun classSlot(sizeClass : Int) -> Int =
    if sizeClass < 7 { 16 + 8 * sizeClass }
    else if sizeClass < 19 { 64 + 16 * (sizeClass - 6) }
    else { Prim.intShl(256, sizeClass - 18) }

-- The class of an object of at most `smallBytes` bytes.
fun classOf(size : Int) -> Int =
    Prim.byteToInt(Prim.loadI8(classes, plus(size, 7) >> 3))

-- Whether `size`, unsigned, is small enough for the fast path: a class-table
-- step below 4096. The few sizes just under `smallBytes` it turns away are
-- still small, and `allocateSlow` gives them their class.
fun fastSize(size : Int) -> Bool = plus(size, 7) >> 15 == 0

fun cursorOf(sizeClass : Int) -> Prim.Ptr = cursorIn(Prim.processState(), sizeClass)

fun cursorIn(w : Prim.Ptr, sizeClass : Int) -> Prim.Ptr =
    Prim.ptrAdd(w, plus(320, sizeClass << 6))

-- The lowest of the cursor's free slots, `free`, which is not zero.
fun takeSlot(cursor : Prim.Ptr, free : Int) -> Prim.Ptr {
    let lowest = free & Prim.intNegWrapping(free)
    Prim.storeI64(cursor, cursorFree, free ^ lowest)
    Prim.ptrAdd(Prim.loadPtr(cursor, cursorBase),
                Prim.intMulWrapping(bitIndex(lowest), Prim.loadI64(cursor, cursorSlot)))
}

-- The position of the one set bit in `lowest`: `Memory.trailingZeros`'s de
-- Bruijn table, without its test for zero, its isolation of the lowest bit or
-- its checked subtraction, none of which a bit already isolated needs. This
-- runs at every allocation.
fun bitIndex(lowest : Int) -> Int {
    let pattern = Prim.intMulWrapping(lowest, 0x03F7_9D71_B4CB_0A89) >> 58 & 63
    let positions = Prim.cString("01`2iaL3mjbZVMA4ngkTec[F]WQNHB<5o_hKlYU@fSdE\\PG;^JX?RDO:I>C9=876")
    Prim.intSubWrapping(Prim.byteToInt(Prim.loadI8(positions, pattern)), 48)
}

-- Fill the empty cursor of class `sizeClass` from the first word with a free
-- slot in the region it owns, or, when that is full, in one it takes off the
-- class's available list or makes; False if there is no memory for one. The
-- region and the worker's counts are the worker's own, so only taking a
-- region takes `heapLock`. A full region it gives up is on no list, and the sweep puts
-- it back on one if it frees a slot.
--
-- Under GC stress, and while statistics are wanted, it takes one slot, so that
-- every allocation comes back here: generated code takes slots from a cursor
-- itself (`Turkey.Select.allocateInline`) and tests nothing else, so an empty
-- cursor is the only way to make an allocation collect or be counted.
fun refill(cursor : Prim.Ptr, sizeClass : Int) -> Bool {
    var region = Prim.loadPtr(cursor, cursorRegion)
    if Prim.ptrIsNull(region) || load32(region, regionUsed) == load32(region, regionCapacity) {
        Lock.acquire(heapLock)
        region = takeRegion(sizeClass)
        -- While the lock is held anyway: so that what triggers a collection
        -- counts every worker's allocation to within a region's worth each,
        -- and not only the worker that asks.
        localFold(Prim.processState())
        Lock.release(heapLock)
        if Prim.ptrIsNull(region) { return False }
        Prim.storePtr(cursor, cursorRegion, region)
    }
    let capacity = load32(region, regionCapacity)
    -- The region has a free slot below its capacity, so this finds one.
    var w = load32(region, regionSearchWord)
    var taken = Prim.loadI64(region, plus(regionAllocated, times8(w)))
    while plus(taken, 1) == 0 {
        w = plus(w, 1)
        taken = Prim.loadI64(region, plus(regionAllocated, times8(w)))
    }
    -- The last word's bits past the capacity are clear, and are not slots.
    var claim = complement(taken)
    let beyond = Prim.intSubWrapping(capacity, w << 6)
    if beyond < 64 { claim = claim & Prim.intSubWrapping(Prim.intShl(1, beyond), 1) }
    if stress || statsWanted { claim = claim & Prim.intNegWrapping(claim) }
    let now = taken | claim
    Prim.storeI64(region, plus(regionAllocated, times8(w)), now)
    let n = population(claim)
    let used = plus(load32(region, regionUsed), n)
    store32(region, regionUsed, used)
    store32(region, regionSearchWord,
            if plus(now, 1) == 0 && w < regionWords - 1 { plus(w, 1) } else { w })
    let slotSize = Prim.loadI64(region, regionSlotSize)
    localAdd(n, Prim.intMulWrapping(n, slotSize))
    Prim.storeI64(cursor, cursorFree, claim)
    Prim.storePtr(cursor, cursorBase,
                  Prim.ptrAdd(region, plus(regionData, Prim.intMulWrapping(w << 6, slotSize))))
    Prim.storeI64(cursor, cursorSlot, slotSize)
    Prim.storeI64(cursor, cursorWord, w)
    True
}

-- A region of class `sizeClass` with a free slot, off the available list, or
-- a new one; null if there is no memory for one. Under `heapLock`.
fun takeRegion(sizeClass : Int) -> Prim.Ptr {
    var region = Prim.loadPtr(available, times8(sizeClass))
    if Prim.ptrIsNull(region) {
        -- A new region goes on the list, and so comes off it here too.
        let slotBytes = classSlot(sizeClass)
        region = newRegion(slotBytes, slotBytes, sizeClass, False)
        if Prim.ptrIsNull(region) { return region }
    }
    Prim.storePtr(available, times8(sizeClass), Prim.loadPtr(region, regionAvailableNext))
    region
}

-- Give every cursor's unused slots back to its region -- clear them from the
-- allocation bitmap and the counts, and move the search back to their word --
-- give up the region, onto its available list if it has a free slot, and fold
-- the worker's counts into the heap's -- for every worker -- and move every
-- other worker's remembered objects to the running worker's set. Edits the
-- shared lists without the lock: it runs only where no other worker can be
-- allocating, in a collection or with one worker.
fun retire() -> Unit {
    let me = Prim.processState()
    for var i = 0; i < Workers.count(); i = plus(i, 1) {
        let w = Workers.recordOf(i)
        retireWorker(w)
        if !Prim.ptrEq(w, me) { adoptRemembered(w) }
    }
}

fun retireWorker(w : Prim.Ptr) -> Unit {
    for var rc = 0; rc < regionClasses; rc = rc + 1 {
        let cursor = cursorIn(w, rc)
        let r = Prim.loadPtr(cursor, cursorRegion)
        if !Prim.ptrIsNull(r) {
            let left = Prim.loadI64(cursor, cursorFree)
            if left != 0 {
                let lw = Prim.loadI64(cursor, cursorWord)
                let at = plus(regionAllocated, times8(lw))
                Prim.storeI64(r, at, Prim.loadI64(r, at) & complement(left))
                let n = population(left)
                store32(r, regionUsed, load32(r, regionUsed) - n)
                if lw < load32(r, regionSearchWord) { store32(r, regionSearchWord, lw) }
                heapCount = heapCount - n
                allocationsSince = allocationsSince - n
                bytesSince = bytesSince - n * Prim.loadI64(r, regionSlotSize)
                Prim.storeI64(cursor, cursorFree, 0)
            }
            if load32(r, regionUsed) < load32(r, regionCapacity) {
                Prim.storePtr(r, regionAvailableNext, Prim.loadPtr(available, times8(rc)))
                Prim.storePtr(available, times8(rc), r)
            }
            Prim.storePtr(cursor, cursorRegion, Prim.ptrNull())
        }
    }
    localFold(w)
}

-- Give a blocked worker's cursors back, as `retire` does, for the monitor
-- (`Turkey.Monitor`), which holds the worker so that it cannot allocate:
-- under the lock, since every other worker may be allocating.
fun retireHeld(w : Prim.Ptr) -> Unit {
    -- The monitor waits for the lock while it holds a worker that a
    -- collection may be waiting for. That is safe only because the lock is
    -- never held at a safepoint: nothing under it allocates, and no loop in
    -- this module polls, so its holder never stops for that collection.
    Lock.acquire(heapLock)
    retireWorker(w)
    Lock.release(heapLock)
}

-- Append worker `w`'s remembered objects to the running worker's set, which
-- is the one a collection reads, and empty `w`'s.
fun adoptRemembered(w : Prim.Ptr) -> Unit {
    let theirs = Prim.loadPtr(w, 296)
    let n = Prim.loadI64(w, 304)
    for var i = 0; i < n; i = plus(i, 1) { remember(Prim.loadPtr(theirs, times8(i))) }
    Prim.storeI64(w, 304, 0)
}

-- The number of set bits.
fun population(x : Int) -> Int {
    let pairs = Prim.intSubWrapping(x, shiftRight(x, 1) & 0x5555_5555_5555_5555)
    let nibbles = plus(pairs & 0x3333_3333_3333_3333,
                       shiftRight(pairs, 2) & 0x3333_3333_3333_3333)
    let bytes = plus(nibbles, shiftRight(nibbles, 4)) & 0x0F0F_0F0F_0F0F_0F0F
    shiftRight(Prim.intMulWrapping(bytes, 0x0101_0101_0101_0101), 56)
}

-- A region of its own for an object of `bytes`, with its one slot allocated;
-- null if there is no memory for it. Under `heapLock`.
fun largeAllocate(bytes : Int) -> Prim.Ptr {
    let made = newRegion(bytes, bytes, regionClasses, True)
    if Prim.ptrIsNull(made) { return made }
    Prim.storeI64(made, regionAllocated, 1)
    store32(made, regionUsed, 1)
    heapCount = plus(heapCount, 1)
    allocationsSince = plus(allocationsSince, 1)
    bytesSince = plus(bytesSince, Prim.loadI64(made, regionReserved))
    Prim.ptrAdd(made, regionData)
}

-- A fresh, empty region with slots of `slotSize`, on the region list and, if
-- it is small, its class's available list; null if there is no memory for it.
-- Under `heapLock`.
fun newRegion(bytes : Int, slotSize : Int, sizeClass : Int, large : Bool) -> Prim.Ptr {
    let reserved = if large {
        (regionData + bytes + regionBytes - 1) & regionMask
    } else { regionBytes }
    let made = Libc.alignedAlloc(regionBytes, reserved)
    if Prim.ptrIsNull(made) { return made }
    let sizes = if sizesKept { Libc.malloc(regionBytes) } else { Prim.ptrNull() }
    if (sizesKept && Prim.ptrIsNull(sizes)) || !tableInsert(made) {
        Libc.free(sizes)
        Libc.free(made)
        return Prim.ptrNull()
    }
    Memory.fill(made, regionData, 0)
    Prim.storePtr(made, regionSizes, sizes)
    Prim.storeI64(made, regionSlotSize, slotSize)
    Prim.storeI64(made, regionReserved, reserved)
    store32(made, regionCapacity, if large { 1 } else { (regionBytes - regionData) / slotSize })
    store32(made, regionSizeClass, if large { regionClasses } else { sizeClass })
    Prim.storePtr(made, regionNext, regions)
    regions = made
    if !large {
        Prim.storePtr(available, times8(sizeClass), made)
        Prim.storeI64(reciprocals, times8(sizeClass), (0x1_0000_0000 + slotSize - 1) / slotSize)
    }
    regionBytesInUse = regionBytesInUse + reserved
    if regionBytesInUse > regionBytesPeak { regionBytesPeak = regionBytesInUse }
    made
}

-- The largest object a region can be made for: an `Int` that the region's
-- own fields and the rounding up to a whole region all fit beside.
-- 2^63 - 1 - 1088 - 65535.
let largest : Int = 9223372036854709184

-- `value` if it is a live object, or null if it is not: not into a region,
-- not at a slot, or at a free slot.
fun findObject(value : Prim.Ptr) -> Prim.Ptr {
    let address = Prim.ptrToInt(value)
    let region = regionOf(value)
    if !tableContains(region) { return Prim.ptrNull() }
    let first = plus(Prim.ptrToInt(region), regionData)
    if below(address, first) { return Prim.ptrNull() }
    let offset = Prim.intSubWrapping(address, first)
    let slot = Prim.loadI64(region, regionSlotSize)
    if offset % slot != 0 { return Prim.ptrNull() }
    let index = offset / slot
    if index < load32(region, regionCapacity) && testBit(region, regionAllocated, index) {
        return value
    }
    Prim.ptrNull()
}

-- -- allocation -------------------------------------------------------------------------

-- A slot for an object of `size` bytes, header included, and of `kind`,
-- uninitialized, or null with a panic raised. `size` is an unsigned byte
-- count carried in an `Int`'s bits. The caller writes the header before
-- anything can collect.
--
-- May collect, so every managed value the caller holds must be rooted. `frame`
-- is the caller's own frame record, where the walk of the Turkey stack starts:
-- the caller must be the Turkey function the allocation is made for, since a
-- frame passed along from further out would skip the frames between.
--
-- The path taken by nearly every allocation is a slot from the class's cursor;
-- everything else -- a collection, an empty cursor, a large object, GC stress
-- -- is `allocateSlow`, which is also what keeps this one small.
fun allocate(size : Int, kind : Int, frame : Prim.Ptr) -> Prim.Ptr {
    if !fastSize(size) { return allocateSlow(size, kind, frame) }
    let cursor = cursorOf(classOf(size))
    let free = Prim.loadI64(cursor, cursorFree)
    if free == 0 { return allocateSlow(size, kind, frame) }
    taken(takeSlot(cursor, free), size, kind)
}

fun allocateSlow(size : Int, kind : Int, frame : Prim.Ptr) -> Prim.Ptr {
    if stopAsked() { stopAt(frame) }
    if stress { pollWordSet(True) }
    if (stress && stressDue()) || plus(bytesSince, localBytes()) >= threshold {
        collectFrom(frame, Due)
        -- A collection is the only thing here that can raise one, and an
        -- allocation after a failed collection would be into a heap nobody
        -- has finished tracing.
        if Process.pending() { return Prim.ptrNull() }
    }
    if below(largest, size) {
        Process.panicUnsigned(Prim.cString("allocation of "), size,
                              Prim.cString(" bytes is too large"))
        return Prim.ptrNull()
    }
    if below(smallBytes, size) {
        Lock.acquire(heapLock)
        let object = largeAllocate(size)
        Lock.release(heapLock)
        if Prim.ptrIsNull(object) { return outOfMemory() }
        return taken(object, size, kind)
    }
    let sizeClass = classOf(size)
    let cursor = cursorOf(sizeClass)
    if Prim.loadI64(cursor, cursorFree) == 0 && !refill(cursor, sizeClass) {
        return outOfMemory()
    }
    taken(takeSlot(cursor, Prim.loadI64(cursor, cursorFree)), size, kind)
}

fun outOfMemory() -> Prim.Ptr {
    Process.panic(Prim.cString("out of memory"))
    Prim.ptrNull()
}

-- -- polls ------------------------------------------------------------------------------

-- The running worker's poll word, the one every loop's back edge tests
-- (`Turkey.Polls`): word 272 of its record. Its bit 0 is a collection asking
-- the worker to stop (`Turkey.Workers`), added and taken away by the
-- collecting worker; its bit 1 is GC stress, which sends every poll here so
-- that stress collects at polls as at allocations, and is the running
-- worker's own.
fun pollWordSet(up : Bool) -> Unit {
    let w = Prim.processState()
    let raised = Prim.atomicLoad(w, 272) & 2 != 0
    if up && !raised { let _ = Prim.atomicAdd(w, 272, 2) }
    if !up && raised { let _ = Prim.atomicAdd(w, 272, -2) }
}

fun stopAsked() -> Bool = Prim.atomicLoad(Prim.processState(), 272) & 1 != 0

-- A loop's poll, called when the worker's poll word is up, as at any call.
-- Not while the worker is blocked or stopped: the loop is then one of
-- `Turkey.Workers`' own, waiting on the protocol a stop would re-enter.
foreign "turkey_poll" fun poll() -> Unit {
    if !Workers.running() { return {} }
    if stopAsked() { stopAt(Prim.frameAddress()) }
    if stress {
        -- A loop can poll once per byte it copies, so only one poll in
        -- `pollStressEvery` counts as an allocation does towards stress's
        -- next collection.
        pollCountdown = pollCountdown - 1
        if pollCountdown <= 0 {
            pollCountdown = pollStressEvery
            if stressDue() { collectFrom(Prim.frameAddress(), Due) }
        }
    }
}

let pollStressEvery : Int = 257
var pollCountdown : Int = 1

-- Whether GC stress collects at this allocation.
fun stressDue() -> Bool {
    stressCountdown = stressCountdown - 1
    if stressCountdown > 0 { return False }
    stressCountdown = if stressInterval == 1 { 1 } else {
        -- xorshift64*: a full period over the nonzero words, which is all a
        -- sampling interval needs of it.
        var mixed = stressRandom
        mixed = mixed ^ shiftRight(mixed, 12)
        mixed = mixed ^ mixed << 25
        mixed = mixed ^ shiftRight(mixed, 27)
        stressRandom = mixed
        let drawn = shiftRight(Prim.intMulWrapping(mixed, 0x2545_F491_4F6C_DD1D), 1)
        1 + drawn % (2 * stressInterval - 1)
    }
    True
}

-- A fresh slot for an object of `size` bytes and of `kind`, recorded in the
-- size table and the statistics where they are kept.
fun taken(object : Prim.Ptr, size : Int, kind : Int) -> Prim.Ptr {
    if sizesKept {
        let region = regionOf(object)
        Prim.storeI64(Prim.loadPtr(region, regionSizes), Prim.ptrDiff(object, region), size)
    }
    if statsWanted {
        let _ = Prim.atomicAdd(statsCounts, statsAllocationsAt, 1)
        let _ = Prim.atomicAdd(statsCounts, statsBytesAt, size)
        let at = if kind >= 0 && kind < 8 { times8(kind) } else { 0 }
        let _ = Prim.atomicAdd(statsByKind, at, 1)
    }
    object
}

-- -- roots ------------------------------------------------------------------------------

-- Push `pointer`, a `RootFrame` the caller owns, onto the shadow stack.
--
-- Nothing is live at registration: the frame is entered on the way into the
-- region that contains the safepoints, and each safepoint stores its own live
-- set. A caller with roots that outlive the call stores the mask itself right
-- after this returns.
foreign "turkey_root_enter" fun rootEnter(pointer : Prim.Ptr, values : Prim.Ptr,
                                          count : Int, functionName : Prim.Ptr) -> Unit {
    if Prim.ptrIsNull(pointer) || Prim.ptrIsNull(values) || count < 0 {
        Process.panic(Prim.cString("invalid root frame size"))
        return {}
    }
    Prim.storePtr(pointer, 0, roots)
    Prim.storePtr(pointer, 8, functionName)
    Prim.storeI64(pointer, frameCount, count)
    Prim.storePtr(pointer, frameValues, values)
    Prim.storeI64(pointer, frameLive, 0)
    roots = pointer
}

foreign "turkey_root_leave" fun rootLeave(pointer : Prim.Ptr) -> Unit {
    if Prim.ptrIsNull(pointer) || !Prim.ptrEq(roots, pointer) {
        Process.panic(Prim.cString("unbalanced root frame"))
        return {}
    }
    roots = Prim.loadPtr(pointer, 0)
}

-- The innermost root frame, for the crash report in `Turkey.Entry`, which
-- walks the chain by its first word and reads each function name. Null before
-- initialization, since a global's storage starts zeroed.
foreign "turkey_roots_head" fun rootsHead() -> Prim.Ptr = roots

-- -- frame tables -----------------------------------------------------------------------
--
-- The arm64 backend registers roots OCaml's way: no function pushes or pops
-- anything, and each call site that may collect has a table entry naming the
-- frame offsets of the roots live across it, keyed by the return address for
-- it. The collector walks `x29` frame records and looks each return address
-- up.
--
-- Only Turkey's frame records are walked, never C's. The walk starts from the
-- frame of the Turkey allocator that called into the heap, which passes its
-- own `x29` in, and ends at the generated entry's frame. Every frame between is
-- Turkey's, because no C function on the mutator's stack calls back into
-- Turkey code that can allocate, and the backend emits a frame record in every
-- function. A C frame keeps one only if its compiler chose to, and a walk that
-- crossed one would lose the Turkey caller's return address and with it that
-- caller's roots.
--
-- A frame whose return address is in no table has no roots, and is skipped. A
-- binary that registers no table walks no frames.

-- The emitter writes a flat array -- count, then {return address, n, n
-- offsets} -- because it cannot sort by an address the linker has not
-- assigned yet. Sorting it once here is what makes the lookup a binary search.
foreign "turkey_frame_table_register" fun frameTableRegister(table : Prim.Ptr) -> Unit {
    if Prim.ptrIsNull(table) { return {} }
    let count = Prim.loadI64(table, 0)
    if count <= 0 { return {} }
    let entries = Libc.malloc(entryBytes * count)
    if Prim.ptrIsNull(entries) {
        Process.panic(Prim.cString("out of memory"))
        return {}
    }
    var p = Prim.ptrAdd(table, 8)
    for var i = 0; i < count; i = i + 1 {
        let n = Prim.loadI64(p, 8)
        Prim.storeI64(entries, entryBytes * i, Prim.loadI64(p, 0))
        Prim.storeI64(entries, entryBytes * i + 8, n)
        Prim.storePtr(entries, entryBytes * i + 16, Prim.ptrAdd(p, 16))
        p = Prim.ptrAdd(p, 16 + 8 * n)
    }
    sortEntries(entries, count)
    Libc.free(frameEntries)
    frameEntries = entries
    frameEntryCount = count
}

fun entryKey(entries : Prim.Ptr, i : Int) -> Int =
    Prim.loadI64(entries, Prim.intMulWrapping(entryBytes, i))

fun swapEntries(entries : Prim.Ptr, i : Int, j : Int) -> Unit {
    for var w = 0; w < entryBytes; w = w + 8 {
        let a = Prim.loadI64(entries, entryBytes * i + w)
        Prim.storeI64(entries, entryBytes * i + w, Prim.loadI64(entries, entryBytes * j + w))
        Prim.storeI64(entries, entryBytes * j + w, a)
    }
}

-- Heapsort, by return address: in place, without recursion, and n log n at
-- worst, which is everything a sort here needs to be.
fun sortEntries(entries : Prim.Ptr, count : Int) -> Unit {
    var start = count / 2
    while start > 0 {
        start = start - 1
        siftDown(entries, start, count)
    }
    var end = count
    while end > 1 {
        end = end - 1
        swapEntries(entries, 0, end)
        siftDown(entries, 0, end)
    }
}

fun siftDown(entries : Prim.Ptr, first : Int, count : Int) -> Unit {
    var root = first
    while 2 * root + 1 < count {
        var child = 2 * root + 1
        if child + 1 < count && below(entryKey(entries, child), entryKey(entries, child + 1)) {
            child = child + 1
        }
        if !below(entryKey(entries, root), entryKey(entries, child)) { return {} }
        swapEntries(entries, root, child)
        root = child
    }
}

fun frameEntryFor(retaddr : Int) -> Prim.Ptr {
    var low = 0
    var high = frameEntryCount - 1
    while low <= high {
        let middle = plus(low, high) >> 1
        let found = entryKey(frameEntries, middle)
        if found == retaddr {
            return Prim.ptrAdd(frameEntries, Prim.intMulWrapping(entryBytes, middle))
        }
        if below(found, retaddr) { low = plus(middle, 1) } else { high = Prim.intSubWrapping(middle, 1) }
    }
    Prim.ptrNull()
}

-- Every Turkey frame of every stack, as a marking task per stack
-- (`taskStack`): the running one from `frame` outwards, and each other from
-- the frame it was parked at.
--
-- `frame` is the `x29` of the Turkey allocator that called into the heap: a
-- frame record whose return address is in the allocation site, so the first
-- entry found is the allocating function's. Null means the collecting thread
-- has no live Turkey frame, and its running stack is not walked.
--
-- The other stacks are walked either way. The final collection runs from C
-- after the program's own code has returned, so it passes null, but the
-- worker threads are still running: one may be parked at a safepoint or
-- waiting for a lock, holding an object only its frames reach, and it goes on
-- using that object once the world starts again. Freeing the object there is
-- a use after free, and a fault where the C library has returned the region
-- to the system.
fun stackTasks(frame : Prim.Ptr) -> Unit {
    if frameEntryCount == 0 { return {} }
    -- Skipped below even with a null `frame`: the running stack's record may
    -- describe a stack that is gone. The thread that ran the program's own
    -- code exits when that code returns, and the main thread then collects
    -- with the same worker record.
    let running = Stack.running()
    if !Prim.ptrIsNull(frame) {
        if Prim.ptrIsNull(running) {
            -- Reachable only if something ran the program's code without the
            -- generated entry. Scanning from an unknown outer bound is how a
            -- walk runs off the end; not scanning drops live roots silently,
            -- which is worse. So say so instead of doing either.
            Process.panic(Prim.cString("no entry stack bound: the frame walker cannot run"))
            return {}
        }
        addTask(taskStack, frame, Stack.high(running))
    }
    var stack = Stack.first()
    while !Prim.ptrIsNull(stack) {
        let parked = Stack.parked(stack)
        if !Prim.ptrEq(stack, running) && !Prim.ptrIsNull(parked) {
            addTask(taskStack, parked, Stack.high(stack))
        }
        stack = Stack.next(stack)
    }
}

-- One stack's frames, from the record at `frame` out to `high`.
--
-- The stop conditions matter more than the loop: a walk that runs off the end
-- of the chain marks whatever the words beyond it happen to hold, which would
-- surface as a corruption a long way from here and look exactly like a
-- miscompile. So the frame pointer must stay below `high`, stay 8-byte
-- aligned, and strictly increase. There is no low bound to check: the walk
-- starts at a live frame and only ever moves outwards.
fun scanStack(frame : Prim.Ptr, high : Prim.Ptr) -> Unit {
    let top = Prim.ptrToInt(high)
    var here = Prim.ptrToInt(frame)
    while !below(top, here + 16) && here & 7 == 0 {
        -- The return address in *this* record is an address in the *caller*,
        -- so the entry it finds describes the caller's frame -- whose `x29` is
        -- this record's saved one. Applying the offsets to this frame instead
        -- reads whatever the callee happens to have at those offsets.
        let record = Prim.ptrFromInt(here)
        let next = Prim.loadI64(record, 0)
        if !below(here, next) || below(top, next + 16) || next & 7 != 0 {
            return {}
        }
        let entry = frameEntryFor(Prim.loadI64(record, 8))
        if !Prim.ptrIsNull(entry) {
            let count = Prim.loadI64(entry, 8)
            let offsets = Prim.loadPtr(entry, 16)
            let caller = Prim.ptrFromInt(next)
            for var i = 0; i < count; i = plus(i, 1) {
                let value = Prim.loadPtr(caller, Prim.loadI64(offsets, times8(i)))
                -- An object the compiler placed in a frame (`Turkey.Escape`):
                -- a callee's rooted parameter, or one such object's field
                -- naming another. It is not a heap object and has no mark bit;
                -- its own frame lists its fields, which is how what it holds
                -- is traced. Such an object never leaves the function that
                -- placed it, so it is in this stack's own range: only a frame
                -- slot can hold one, since nothing in the heap ever points
                -- into a stack, and a stack never points into another's.
                let at = Prim.ptrToInt(value)
                if below(at, Prim.ptrToInt(frame)) || !below(at, top) {
                    markGrey(value, Prim.cString("arm64 frame"), i)
                }
            }
        }
        here = next
    }
}

-- -- marking ----------------------------------------------------------------------------
--
-- An object is marked when it is first pushed, in its region's mark bitmap:
-- an edge to an object already marked -- most edges, in a heap of shared
-- names and types -- then reads the region's header, which a few thousand
-- objects share and which stays in cache, and not the object's own. The
-- bitmap is the only record of a mark: no object header has one.
--
-- `drain` is the whole of the tracing loop, decoding and pushing in line: the
-- inliner does not copy a body this size, and a call per edge was most of what
-- marking cost.

-- Each size class's slot size as a multiplier: 2^32 / slot, rounded up, and
-- 0 for a large region, whose one slot is at offset 0. A slot's offset times
-- it, over 2^32, is the slot's index, exactly: the offset is a multiple of the
-- slot size below 2^16, so the rounding adds less than 2^16 / 2^32 to a whole
-- number. Set by `newRegion` for each class it makes a region of, which is
-- before anything in the class can be marked.
var reciprocals : Prim.Ptr = zeroed(8 * (regionClasses + 1))

-- Whether a traced word names no object: null, or one of the small integers
-- below `immediates`.
fun immediate(value : Prim.Ptr) -> Bool = below(Prim.ptrToInt(value), immediates)

-- Mark `value`, a root found as `what` `index`, if it is an object and not
-- yet marked, and push it on the running worker's stack. `what` null means a
-- root the caller cannot name.
fun markGrey(value : Prim.Ptr, what : Prim.Ptr, index : Int) -> Unit {
    if immediate(value) { return {} }
    -- Exact roots and object descriptors make the header O(1) to find in normal
    -- execution. GC stress checks membership, and it earns the cost: a pointer
    -- that is not in the heap means a root was missed or a descriptor is
    -- wrong, and this turns that from a rare corruption into a panic on the
    -- first collection.
    if stress && Prim.ptrIsNull(findObject(value)) {
        notHeapPointer(value, what, index)
        return {}
    }
    let region = regionOf(value)
    let slot = slotOf(region, value)
    let at = plus(regionMarked, times8(slot >> 6))
    -- Most roots are marked already, by the time a collection's later tasks
    -- reach them.
    if Prim.loadI64(region, at) & bit(slot) != 0 { return {} }
    if !claim(region, at, bit(slot), value, sharing) { return {} }
    push(value)
}

-- Set `mask` in the mark word at `at` of `region`, and with it the
-- generation of `object` and the region's live count: False if it was set
-- already. With other workers marking (`shared`), the bit is claimed by
-- compare-and-swap and the count added to atomically, since the word holds
-- 64 objects' marks and another worker may be setting one of the others; the
-- header is the winner's alone.
fun claim(region : Prim.Ptr, at : Int, mask : Int, object : Prim.Ptr, shared : Bool) -> Bool {
    while True {
        let marks = Prim.loadI64(region, at)
        if marks & mask != 0 { return False }
        if !shared {
            Prim.storeI64(region, at, marks | mask)
            store32(region, regionLive, plus(load32(region, regionLive), 1))
            break
        }
        if Prim.atomicCas(region, at, marks, marks | mask) == marks {
            -- The count is the low half of the word at `regionLive`, and
            -- never carries into the high half: a region has at most 4096
            -- slots.
            let _ = Prim.atomicAdd(region, regionLive, 1)
            break
        }
    }
    promote(object)
    True
}

-- Make `object` old. A byte store, so that the rest of the header, which
-- nothing else writes once the object is built, is not written at all.
fun promote(object : Prim.Ptr) -> Unit =
    Prim.storeI8(object, headerGeneration, Prim.byteFromInt(old))

-- Push `entry` on the running worker's mark stack.
fun push(entry : Prim.Ptr) -> Unit {
    let m = marker()
    let count = Prim.loadI64(m, 8)
    if count == Prim.loadI64(m, 16) && !growMarkStack(m) { return {} }
    Prim.storePtr(Prim.loadPtr(m, 0), times8(count), entry)
    Prim.storeI64(m, 8, plus(count, 1))
}

-- The running worker's mark stack.
fun marker() -> Prim.Ptr = Prim.ptrAdd(markers, markerBytes * Workers.index())

-- The index of the slot of `object`, in `region`.
fun slotOf(region : Prim.Ptr, object : Prim.Ptr) -> Int {
    let offset = Prim.intSubWrapping(Prim.ptrDiff(object, region), regionData)
    let multiplier = Prim.loadI64(reciprocals, times8(load32(region, regionSizeClass)))
    Prim.intMulWrapping(offset, multiplier) >> 32
}

-- Double the mark stack `m`; False, with the mark failed, if there is no
-- memory.
fun growMarkStack(m : Prim.Ptr) -> Bool {
    let capacity = Prim.loadI64(m, 16)
    let grown = if capacity < 64 { 64 } else { capacity * 2 }
    let stack = Libc.realloc(Prim.loadPtr(m, 0), 8 * grown)
    if Prim.ptrIsNull(stack) {
        markFailed(Prim.cString("out of memory"))
        return False
    }
    Prim.storePtr(m, 0, stack)
    Prim.storeI64(m, 16, grown)
    True
}

-- The write barrier's slow path: `parent` has just been given a young object,
-- and is remembered if it is old and not remembered already. Generated code
-- calls it only then, after testing both inline; the test here is for C.
-- Called between a store and the next instruction, so it must not allocate,
-- collect or panic in any way the caller could miss: it is not a safepoint,
-- and nothing checks the panic flag after it.
--
-- Stores the compiler cannot see -- raw stores of a managed pointer into a
-- managed object, from Turkey or C -- must call it too, unless the object was
-- allocated after the value they store.
foreign "turkey_write_barrier" fun writeBarrier(parent : Prim.Ptr) -> Unit {
    -- Claimed by changing the generation, atomically: two workers storing
    -- into one old object at once must not both remember it. The swap is of
    -- the whole header, whose other bytes nothing changes once the object is
    -- built, and it writes them back as they were.
    let header = Prim.loadI64(parent, 0)
    if header & 255 != old { return {} }
    let remembered = header & complement(255) | rememberedOld
    if Prim.atomicCas(parent, 0, header, remembered) != header { return {} }
    remember(parent)
    let _ = Prim.atomicAdd(statsCounts, statsRememberedAt, 1)
}

-- Add `parent` to the running worker's remembered set.
fun remember(parent : Prim.Ptr) -> Unit {
    let count = rememberedCount()
    if count == rememberedCapacity() {
        let capacity = if count < 64 { 64 } else { count * 2 }
        let grown = Libc.realloc(remembered(), 8 * capacity)
        if Prim.ptrIsNull(grown) {
            Process.panic(Prim.cString("out of memory"))
            return {}
        }
        rememberedSet(grown)
        rememberedCapacitySet(capacity)
    }
    Prim.storePtr(remembered(), times8(count), parent)
    rememberedCountSet(plus(count, 1))
}

-- Trace everything reachable from the running worker's mark stack, emptying
-- it. This is the one place the collector decodes an object's layout.
--
-- An array's tag is its element's layout code: 7 is a traced pointer and 6
-- is a pointer-sized word the collector must not follow, a raw address. A
-- test of `>= 6` follows both, and collects through an address it has no
-- business reading. Any other object's descriptor counts the traced words its
-- fields start with, and the rest of it is not looked at.
--
-- An entry is an object, or the next chunk of one too large to scan at once:
-- its address with the chunk's number, from 1, in the top bits, which no
-- user-space address on arm64 has set; below `chunkLimit`, so that the entry
-- stays positive. Scanning `chunkSlots` slots at a time
-- lets another worker take the rest of a large array.
--
-- With other workers marking, every `shareEvery` entries this one gives a
-- packet of its stack away if one of them is waiting for work.
fun drain() -> Unit {
    let m = marker()
    var stack = Prim.loadPtr(m, 0)
    var capacity = Prim.loadI64(m, 16)
    var top = Prim.loadI64(m, 8)
    let shared = sharing
    var countdown = shareEvery
    while top > 0 {
        if shared {
            countdown = Prim.intSubWrapping(countdown, 1)
            if countdown == 0 {
                countdown = shareEvery
                if top > packetEntries && Prim.atomicLoad(marking, idleAt) > 0 {
                    top = share(stack, top)
                }
            }
        }
        top = Prim.intSubWrapping(top, 1)
        let entry = Prim.ptrToInt(Prim.loadPtr(stack, times8(top)))
        let chunk = entry >> 48
        let object = Prim.ptrFromInt(if chunk == 0 { entry } else { entry & addressBits })
        -- Where its pointers start and how many there are: every word from
        -- `first` to `slots` is one. A cell's flag is the count of its one
        -- word.
        let header = load32(object, 0)
        let kind = header >> 8 & 255
        var first = objectFields
        var slots = header >> 16
        if kind == arrayKind {
            first = arrayElements
            slots = if slots == 7 { Prim.loadI64(object, arrayLength) } else { 0 }
        }
        var field = 0
        var end = slots
        if slots > chunkSlots {
            field = Prim.intMulWrapping(chunk, chunkSlots)
            end = if Prim.intSubWrapping(slots, field) > chunkSlots && chunk < chunkLimit {
                plus(field, chunkSlots)
            } else { slots }
        }
        if end != slots {
            if top == capacity {
                Prim.storeI64(m, 8, top)
                if !growMarkStack(m) {
                    Prim.storeI64(m, 8, 0)
                    return {}
                }
                stack = Prim.loadPtr(m, 0)
                capacity = Prim.loadI64(m, 16)
            }
            let next = Prim.ptrToInt(object) | plus(chunk, 1) << 48
            Prim.storePtr(stack, times8(top), Prim.ptrFromInt(next))
            top = plus(top, 1)
        }
        while field < end {
            let child = Prim.loadPtr(object, plus(first, times8(field)))
            if immediate(child) {
            } else if stress && Prim.ptrIsNull(findObject(child)) {
                notHeapPointer(child, fieldName(kind), field)
            } else {
                let childRegion = regionOf(child)
                let childSlot = slotOf(childRegion, child)
                let at = plus(regionMarked, times8(childSlot >> 6))
                let marks = Prim.loadI64(childRegion, at)
                let mask = bit(childSlot)
                -- In line when this worker marks alone: a call per object
                -- marked is a large share of what marking costs.
                if marks & mask == 0 {
                    let won = if shared { claim(childRegion, at, mask, child, True) } else {
                        Prim.storeI64(childRegion, at, marks | mask)
                        store32(childRegion, regionLive, plus(load32(childRegion, regionLive), 1))
                        promote(child)
                        True
                    }
                    if won {
                        if top == capacity {
                            Prim.storeI64(m, 8, top)
                            if !growMarkStack(m) {
                                Prim.storeI64(m, 8, 0)
                                return {}
                            }
                            stack = Prim.loadPtr(m, 0)
                            capacity = Prim.loadI64(m, 16)
                        }
                        Prim.storePtr(stack, times8(top), child)
                        top = plus(top, 1)
                    }
                }
            }
            field = plus(field, 1)
        }
    }
    Prim.storeI64(m, 8, 0)
}

-- The bits of an entry that are an address (`drain`).
let addressBits : Int = 0xFFFF_FFFF_FFFF

-- The slots scanned at once of one object: 8 KB of pointers. An object of
-- more than `chunkLimit` chunks has its last one scanned whole.
let chunkSlots : Int = 1024
let chunkLimit : Int = 0x7FFF

-- -- marking in parallel ----------------------------------------------------------------
--
-- A collection marks with every worker stopped at a safepoint helping it: they
-- are waiting for it anyway (`stopAt`). A worker held while blocked does not
-- help, since it is waiting on something else. A worker held while it waits
-- for work (`pause`) helps a mark big enough to repay waking it
-- (`pausedHelpFloor`).
--
-- The roots are tasks, which the markers claim one at a time: each stack, each
-- frame of the root chain, and runs of the remembered set. There are many more
-- tasks than markers, so a marker that draws a small one takes another.
--
-- What a root reaches is balanced as it is traced: a marker with work gives a
-- packet of its stack to the pool whenever another is waiting for some
-- (`drain`), and a marker with none takes one. Packets rather than stealing
-- from each other's stacks: a lock taken once a packet costs nothing next to
-- the packet's work, and the stacks stay plain arrays their owner pushes
-- without synchronizing.
--
-- The mark is over when every marker is idle -- its own stack empty, and the
-- pool too -- which a count of idle markers, changed under the pool's lock,
-- says.

let packetEntries : Int = 512
let shareEvery : Int = 64

-- The fewest bytes a mark may trace -- the young generation's for a minor
-- collection, the heap's for a full one -- for it to ask the workers asleep
-- in `pause` to help. Each one asked is woken from the kernel, marks, sleeps
-- again until the collection ends, is woken again, and goes back to the
-- scheduler's queue, whose lock every one of them then takes to find nothing
-- to do. On an M-series Mac with eleven idle workers that is about 50 us of
-- wall time and 200 us of system time per collection, against a few
-- microseconds of marking for a young generation of a few hundred kilobytes:
-- a program with one task ran six times slower than with one worker.
-- The compiler's own collections, of tens of megabytes, are faster with
-- them, and stay above this.
let pausedHelpFloor : Int = 4194304

-- Whether other workers are marking with this one: claims of a mark are
-- atomic then. Set before they are asked to help and cleared after they have
-- all finished.
var sharing : Bool = False
-- How many workers mark this collection.
var participants : Int = 1

-- Words of the mark's state: how many markers are idle, whether the mark is
-- over, how many packets the pool holds, the next task to claim, whether the
-- mark failed, and an epoch idle markers sleep on with how many do: bumped
-- when a packet is put in the pool and when the mark is over (`markSignal`).
var marking : Prim.Ptr = zeroed(56)
let idleAt : Int = 0
let doneAt : Int = 8
let packetsAt : Int = 16
let nextTaskAt : Int = 24
let failedAt : Int = 32
let epochAt : Int = 40
let sleepersAt : Int = 48
-- What `markFailed` was told, once it has been.
var failure : Prim.Ptr = Prim.ptrNull()

-- Each worker's word saying the collection wants it to mark, by index,
-- cleared by the worker once it has finished; and each's saying it is
-- waiting in `pause`, where it would see that.
var helping : Prim.Ptr = zeroed(8 * Workers.threadLimit())
var pausing : Prim.Ptr = zeroed(8 * Workers.threadLimit())

-- The pool: full packets, and empty ones kept for reuse, each a list through
-- its packet's first word. A packet is that word, a count, and its entries.
var poolLock : Prim.Ptr = Lock.new()
var poolFull : Prim.Ptr = Prim.ptrNull()
var poolEmpty : Prim.Ptr = Prim.ptrNull()

-- The tasks: three words each, the kind and two operands.
let taskChain : Int = 0
let taskStack : Int = 1
let taskRemembered : Int = 2
var tasks : Prim.Ptr = Prim.ptrNull()
var taskCount : Int = 0
var taskCapacity : Int = 0

-- The runs the remembered set is split into.
let rememberedRun : Int = 1024

-- Mark everything reachable, with the running worker's stack walked from
-- `frame`: by this worker and every other stopped at a safepoint.
fun markFrom(frame : Prim.Ptr) -> Unit {
    Prim.atomicStore(marking, failedAt, 0)
    taskCount = 0
    var root = roots
    while !Prim.ptrIsNull(root) {
        addTask(taskChain, root, Prim.ptrNull())
        root = Prim.loadPtr(root, 0)
    }
    -- By address: the set is the collecting worker's (`retire`), and the
    -- record a marker reaches through `remembered` is its own.
    if minor {
        let count = rememberedCount()
        for var i = 0; i < count; i = plus(i, rememberedRun) {
            let end = if count - i < rememberedRun { count } else { plus(i, rememberedRun) }
            addTask(taskRemembered, Prim.ptrAdd(remembered(), times8(i)),
                    Prim.ptrAdd(remembered(), times8(end)))
        }
    }
    stackTasks(frame)
    Prim.atomicStore(marking, nextTaskAt, 0)
    let me = Workers.index()
    let n = Workers.count()
    -- Under GC stress every collection asks, so that the stressed runs, whose
    -- heaps are small, still mark with the paused workers.
    let traced = if minor { bytesSince } else { plus(liveBytes, bytesSince) }
    let paused = stress || traced >= pausedHelpFloor
    participants = 1
    for var i = 0; i < n; i = plus(i, 1) {
        if i != me && canHelp(i, paused) { participants = plus(participants, 1) }
    }
    sharing = participants > 1
    if sharing {
        Prim.atomicStore(marking, idleAt, 0)
        Prim.atomicStore(marking, doneAt, 0)
        for var i = 0; i < n; i = plus(i, 1) {
            if i != me && canHelp(i, paused) { Prim.atomicStore(helping, times8(i), 1) }
        }
        -- The stopped ones sleep on the collection epoch, and the paused ones
        -- may still be asleep on the work epoch.
        Workers.signalCollection()
        if paused { Workers.signalWork(True) }
    }
    mark()
    if sharing {
        for var i = 0; i < n; i = plus(i, 1) {
            while Prim.atomicLoad(helping, times8(i)) != 0 { let _ = Libc.schedYield() }
        }
        sharing = False
    }
    if minor { rememberedCountSet(0) }
    if Prim.atomicLoad(marking, failedAt) != 0 { Process.panic(failure) }
}

-- Whether worker `i`, with the world stopped, is to be asked to mark: it is
-- stopped at a safepoint, or, if `paused`, held in `pause`.
fun canHelp(i : Int, paused : Bool) -> Bool =
    Workers.stopped(i) || (paused && Prim.atomicLoad(pausing, times8(i)) != 0)

fun addTask(kind : Int, a : Prim.Ptr, b : Prim.Ptr) -> Unit {
    if taskCount == taskCapacity {
        let capacity = if taskCapacity < 64 { 64 } else { taskCapacity * 2 }
        let grown = Libc.realloc(tasks, 24 * capacity)
        if Prim.ptrIsNull(grown) {
            markFailed(Prim.cString("out of memory"))
            return {}
        }
        tasks = grown
        taskCapacity = capacity
    }
    let at = 24 * taskCount
    Prim.storeI64(tasks, at, kind)
    Prim.storePtr(tasks, plus(at, 8), a)
    Prim.storePtr(tasks, plus(at, 16), b)
    taskCount = plus(taskCount, 1)
}

-- A marker's part: tasks until there are none to claim, then what they reach,
-- until the mark is over.
fun mark() -> Unit {
    while True {
        let i = Prim.atomicAdd(marking, nextTaskAt, 1)
        if i >= taskCount { break }
        run(i)
        drain()
    }
    if !sharing { return {} }
    while take() || waitForWork() { drain() }
}

fun run(task : Int) -> Unit {
    let at = 24 * task
    let kind = Prim.loadI64(tasks, at)
    let a = Prim.loadPtr(tasks, plus(at, 8))
    let b = Prim.loadPtr(tasks, plus(at, 16))
    if kind == taskChain {
        let count = Prim.loadI64(a, frameCount)
        let live = Prim.loadI64(a, frameLive)
        let values = Prim.loadPtr(a, frameValues)
        let name = Prim.loadPtr(a, 8)
        for var i = 0; i < count; i = plus(i, 1) {
            if i >= 64 || Prim.intShr(live, i) & 1 != 0 {
                markGrey(Prim.loadPtr(values, times8(i)), name, i)
            }
        }
    } else if kind == taskStack {
        scanStack(a, b)
    } else {
        -- A minor collection's other roots: the fields of each remembered
        -- object, which is marked already, being old. Each is old and not
        -- remembered after.
        for var at = Prim.ptrToInt(a); at < Prim.ptrToInt(b); at = plus(at, 8) {
            let parent = Prim.loadPtr(Prim.ptrFromInt(at), 0)
            promote(parent)
            push(parent)
        }
    }
}

-- Give the top `packetEntries` of `stack`, which holds `top`, to the pool,
-- and answer what it holds after: `top` itself if there is no memory for a
-- packet, which only means this worker keeps the work.
fun share(stack : Prim.Ptr, top : Int) -> Int {
    Lock.acquire(poolLock)
    var packet = poolEmpty
    if Prim.ptrIsNull(packet) {
        packet = Libc.malloc(16 + 8 * packetEntries)
        if Prim.ptrIsNull(packet) {
            Lock.release(poolLock)
            return top
        }
    } else {
        poolEmpty = Prim.loadPtr(packet, 0)
    }
    let rest = top - packetEntries
    Memory.copy(Prim.ptrAdd(packet, 16), Prim.ptrAdd(stack, times8(rest)), 8 * packetEntries)
    Prim.storeI64(packet, 8, packetEntries)
    Prim.storePtr(packet, 0, poolFull)
    poolFull = packet
    let _ = Prim.atomicAdd(marking, packetsAt, 1)
    markSignal(False)
    Lock.release(poolLock)
    rest
}

-- Move a packet from the pool to the running worker's stack, if there is one.
fun take() -> Bool {
    if Prim.atomicLoad(marking, packetsAt) == 0 { return False }
    Lock.acquire(poolLock)
    let packet = poolFull
    if Prim.ptrIsNull(packet) {
        Lock.release(poolLock)
        return False
    }
    poolFull = Prim.loadPtr(packet, 0)
    let _ = Prim.atomicAdd(marking, packetsAt, -1)
    let m = marker()
    let count = Prim.loadI64(packet, 8)
    while Prim.loadI64(m, 16) < plus(Prim.loadI64(m, 8), count) {
        if !growMarkStack(m) {
            Lock.release(poolLock)
            return False
        }
    }
    let top = Prim.loadI64(m, 8)
    Memory.copy(Prim.ptrAdd(Prim.loadPtr(m, 0), times8(top)), Prim.ptrAdd(packet, 16), 8 * count)
    Prim.storeI64(m, 8, plus(top, count))
    Prim.storePtr(packet, 0, poolEmpty)
    poolEmpty = packet
    Lock.release(poolLock)
    True
}

-- With nothing to mark: idle until a packet is put in the pool, True, or
-- every marker is idle and the mark is over, False.
fun waitForWork() -> Bool {
    Lock.acquire(poolLock)
    if !Prim.ptrIsNull(poolFull) {
        Lock.release(poolLock)
        return True
    }
    let idle = plus(Prim.atomicLoad(marking, idleAt), 1)
    Prim.atomicStore(marking, idleAt, idle)
    let over = idle == participants
    if over { Prim.atomicStore(marking, doneAt, 1) }
    Lock.release(poolLock)
    if over {
        markSignal(True)
        return False
    }
    while True {
        let epoch = Prim.atomicLoad(marking, epochAt)
        if Prim.atomicLoad(marking, doneAt) != 0 { return False }
        if Prim.atomicLoad(marking, packetsAt) > 0 {
            Lock.acquire(poolLock)
            let done = Prim.atomicLoad(marking, doneAt) != 0
            if !done { Prim.atomicStore(marking, idleAt, Prim.atomicLoad(marking, idleAt) - 1) }
            Lock.release(poolLock)
            return !done
        }
        -- Asleep until a packet or the end, rather than spinning: the last
        -- marker with work may be some while about it.
        let _ = Prim.atomicAdd(marking, sleepersAt, 1)
        if Prim.atomicLoad(marking, epochAt) == epoch { Lock.wait(Prim.ptrAdd(marking, epochAt), epoch) }
        let _ = Prim.atomicAdd(marking, sleepersAt, -1)
    }
    False
}

-- A packet for an idle marker, or, `all`, the end of the mark: wake one, or
-- every one, if any sleeps (`waitForWork`).
fun markSignal(all : Bool) -> Unit {
    let _ = Prim.atomicAdd(marking, epochAt, 1)
    if Prim.atomicLoad(marking, sleepersAt) != 0 {
        if all { Lock.wakeAll(Prim.ptrAdd(marking, epochAt)) }
        else { let _ = Lock.wake(Prim.ptrAdd(marking, epochAt)) }
    }
}

-- Record that the mark cannot finish, saying `message`: the collecting worker
-- panics with it once every marker has stopped. The first failure is the
-- one reported.
fun markFailed(message : Prim.Ptr) -> Unit {
    if Prim.atomicCas(marking, failedAt, 0, 1) == 0 { failure = message }
}

-- Sleep until there may be work, blocked, so that a collection need not wait
-- for this worker: until the work epoch is no longer `seen`, which the caller
-- read before it looked for work and found none (`Turkey.Workers.signalWork`).
--
-- A `timeout` of -1 sleeps on the epoch and answers 0. Any other waits in the
-- operating system for readiness events instead, as the worker that holds the
-- poller's claim (`Turkey.Workers.pollWait`), for the nanoseconds it gives or
-- until an event or a signal: it answers how many results there are to read,
-- or the negated `errno` if it could not wait.
--
-- A collection that holds this worker meanwhile may ask it to mark, as it asks
-- the stopped ones (`pausing` says it can), and wakes it to say so; it waits
-- for the collection to let it go either way. A worker blocked on a lock is
-- not asked, since the lock may be the collecting worker's.
foreign "turkey_worker_pause" fun pause(seen : Int, timeout : Int) -> Int {
    let me = times8(Workers.index())
    Prim.atomicStore(pausing, me, 1)
    Workers.blockEnter(Prim.frameAddress())
    var results = 0
    if timeout == -1 { Workers.sleepForWork(seen) } else { results = Workers.pollWait(seen, timeout) }
    while True {
        let epoch = Workers.collectionSeen()
        if Workers.unblock() { break }
        if Prim.atomicLoad(helping, me) != 0 {
            mark()
            Prim.atomicStore(helping, me, 0)
        } else {
            Workers.sleepForCollection(epoch)
        }
    }
    Prim.atomicStore(pausing, me, 0)
    results
}

-- At a safepoint with the running worker's stop word raised: stopped until
-- the collection is over, marking if it asks.
-- It sleeps meanwhile, woken when the collection asks it to mark and when
-- the collection ends (`Turkey.Workers.signalCollection`).
fun stopAt(frame : Prim.Ptr) -> Unit {
    Workers.stopEnter(frame)
    let me = times8(Workers.index())
    while True {
        let epoch = Workers.collectionSeen()
        if !Workers.stopWanted() { break }
        if Prim.atomicLoad(helping, me) != 0 {
            mark()
            Prim.atomicStore(helping, me, 0)
        } else {
            Workers.sleepForCollection(epoch)
        }
    }
    Workers.stopLeave()
}

-- What `notHeapPointer` calls a field, by the kind of object it is in.
fun fieldName(kind : Int) -> Prim.Ptr =
    if kind == cellKind { Prim.ptrNull() }
    else if kind == arrayKind { Prim.cString("array pointer field") }
    else if kind == 0 || kind == 1 { Prim.cString("object pointer field") }
    else { Prim.cString("capture") }

-- "<what> <index> is not a heap pointer (0x...)", or "GC root or field is not
-- a heap pointer (0x...)" when the caller cannot name where it looked. Named,
-- because "a root is not a heap pointer" is true of one slot of one frame, and
-- a compiler emitting roots for the first time needs to know which.
fun notHeapPointer(value : Prim.Ptr, what : Prim.Ptr, index : Int) -> Unit {
    -- The first marker to find one reports it, in the one text buffer.
    if Prim.atomicCas(marking, failedAt, 0, 1) != 0 { return {} }
    textLength = 0
    if Prim.ptrIsNull(what) {
        put(Prim.cString("GC root or field"))
    } else {
        put(what)
        put(Prim.cString(" "))
        putInt(index)
    }
    put(Prim.cString(" is not a heap pointer (0x"))
    putHex(Prim.ptrToInt(value))
    put(Prim.cString(")"))
    Prim.storeI8(text, textLength, Prim.byteFromInt(0))
    failure = text
}

-- -- collecting -------------------------------------------------------------------------

-- A collection with no Turkey frame live: the final one, after the program
-- has returned, and a C caller's. Anything else collects through `allocate`,
-- which knows where the Turkey stack starts. Always full: asked for by name,
-- it frees everything unreachable.
foreign "turkey_collect" fun collect() -> Unit = collectFrom(Prim.ptrNull(), Full)

-- What a collection is asked to be: whatever `fullDue` says, full, or minor.
-- Minor only if minor collections are on.
type Asked = Due | Full | Minor

-- A collection, with every other worker stopped. If another worker is
-- stopping them already, it collects and this one does not.
fun collectFrom(frame : Prim.Ptr, asked : Asked) -> Unit {
    if !Workers.stopTheWorld() { return {} }
    collectStopped(frame, asked)
    Workers.startTheWorld()
}

fun collectStopped(frame : Prim.Ptr, asked : Asked) -> Unit {
    retire()
    minor = generational && match asked {
        Due -> !fullDue()
        Full -> False
        Minor -> True
    }
    if verify { verifyAt(Check.BeforeMarking, frame) }
    let liveBefore = heapCount
    -- Read before the sweep clears it: the allocation pressure this
    -- collection is responding to.
    let allocsSince = allocationsSince
    let wanted = statsWanted
    let started = if wanted { nanoseconds() } else { 0 }
    if !minor {
        -- Everything is traced again, and every live object marked again,
        -- which makes it old and forgets that it was remembered.
        clearMarks()
        rememberedCountSet(0)
    }
    markFrom(frame)
    if Process.pending() { return {} }
    let marked = if wanted { nanoseconds() } else { 0 }
    if verify { verifyAt(Check.BeforeSweeping, frame) }
    sweep()
    if verify { verifyAt(Check.AfterSweeping, frame) }
    allocationsSince = 0
    bytesSince = 0
    if !minor { liveBytesAfterFull = liveBytes }
    let floor = if liveBytesAfterFull > 65536 { liveBytesAfterFull } else { 65536 }
    let next = Prim.floatMul(Prim.intToFloat(floor), thresholdScale)
    -- `maxInt()` rounds up when converted, so the comparison is against 2^63,
    -- and anything that reaches it saturates instead of converting.
    threshold = if Prim.floatGte(next, Prim.intToFloat(maxInt())) { maxInt() }
                else { Prim.floatTruncate(next) }
    if minor { statsMinor = statsMinor + 1 }
    collections = collections + 1
    if wanted {
        statsMarkClock = statsMarkClock + (marked - started)
        logCollection(started, liveBefore, allocsSince)
    }
}

-- Whether this collection must be full: when the live bytes, old objects
-- that died since included, have grown by half since the last full collection
-- kept them. Under GC stress every eighth is, so that a stressed run
-- exercises both.
--
-- Half is measured, on the self-compile against the full collector (17.7 s,
-- 2.60 GB max RSS): 14.3 s at 2.63 GB. Waiting for the live bytes to double
-- instead was 14.3 s at 2.86 GB, and with the young generation also sized
-- from them, 13.5 s at 3.67 GB.
fun fullDue() -> Bool {
    if stress { return collections % 8 == 0 }
    let floor = if liveBytesAfterFull > 65536 { liveBytesAfterFull } else { 65536 }
    Prim.floatGte(Prim.intToFloat(liveBytes), Prim.floatMul(Prim.intToFloat(floor), 1.5))
}

-- Before a full collection's marking: no object is marked.
fun clearMarks() -> Unit {
    var region = regions
    while !Prim.ptrIsNull(region) {
        Memory.fill(Prim.ptrAdd(region, regionMarked), 8 * regionWords, 0)
        store32(region, regionLive, 0)
        region = Prim.loadPtr(region, regionNext)
    }
}

-- Empty regions cost one free, however many objects they held. A survivor's
-- marks become its allocation bitmap, so no individual header is visited.
--
-- The marks are kept: every survivor is old now, and an old object stays
-- marked until a full collection clears the marks to trace everything again.
-- A minor collection's marking starts from them, and stops at them.
fun sweep() -> Unit {
    Memory.fill(available, 8 * regionClasses, 0)
    liveBytes = 0
    var previous = Prim.ptrNull()
    var region = regions
    while !Prim.ptrIsNull(region) {
        let next = Prim.loadPtr(region, regionNext)
        let live = load32(region, regionLive)
        let dead = load32(region, regionUsed) - live
        heapCount = heapCount - dead
        statsFreedTotal = statsFreedTotal + dead
        if live == 0 {
            if Prim.ptrIsNull(previous) { regions = next }
            else { Prim.storePtr(previous, regionNext, next) }
            regionBytesInUse = regionBytesInUse - Prim.loadI64(region, regionReserved)
            tableRemove(region)
            Libc.free(Prim.loadPtr(region, regionSizes))
            Libc.free(region)
        } else {
            Memory.copy(Prim.ptrAdd(region, regionAllocated),
                        Prim.ptrAdd(region, regionMarked), 8 * regionWords)
            store32(region, regionUsed, live)
            store32(region, regionSearchWord, 0)
            let cls = load32(region, regionSizeClass)
            liveBytes = liveBytes + (if cls < regionClasses {
                live * Prim.loadI64(region, regionSlotSize)
            } else { Prim.loadI64(region, regionReserved) })
            if live < load32(region, regionCapacity) && cls < regionClasses {
                Prim.storePtr(region, regionAvailableNext, Prim.loadPtr(available, 8 * cls))
                Prim.storePtr(available, 8 * cls, region)
            }
            previous = region
        }
        region = next
    }
}

-- -- statistics -------------------------------------------------------------------------

fun nanoseconds() -> Int {
    let _ = Libc.clockGettime(Sys.clockMonotonic(), clock)
    Prim.loadI64(clock, 0) * 1000000000 + Prim.loadI64(clock, 8)
}

fun logCollection(started : Int, liveBefore : Int, allocsSince : Int) -> Unit {
    let nanos = nanoseconds() - started
    let freedNow = statsFreedTotal - statsFreedPrevious
    let survived = liveBefore - freedNow
    statsFreedPrevious = statsFreedTotal
    statsClock = statsClock + nanos
    -- A minor collection marks only the young survivors; the old objects were
    -- marked already, and are not traced again.
    let traced = if minor { survived - (liveBefore - allocsSince) } else { survived }
    if traced > 0 { statsTraced = statsTraced + traced }
    statsLiveTotal = statsLiveTotal + heapCount
    if heapCount > statsLivePeak { statsLivePeak = heapCount }
    textLength = 0
    put(Prim.cString("[gc "))
    putInt(collections)
    put(if minor { Prim.cString(" minor") } else { Prim.cString(" full") })
    put(Prim.cString("] allocs-since "))
    putInt(allocsSince)
    put(Prim.cString(", live-before "))
    putInt(liveBefore)
    put(Prim.cString(", survived "))
    putInt(survived)
    put(Prim.cString(", freed "))
    putInt(freedNow)
    put(Prim.cString(", next threshold "))
    putInt(threshold)
    put(Prim.cString(", "))
    putFixed(nanos, 1000000, 3)
    put(Prim.cString(" ms\n"))
    writeLine()
}

-- The run's totals, when TURKEY_GC_STATS asked for them.
foreign "turkey_gc_report" fun report() -> Unit {
    if !statsWanted { return {} }
    -- With the world stopped, as a collection retires: other workers may
    -- still be allocating, and the monitor retiring a blocked one's cursors.
    -- When another worker is collecting, it waits for this one to stop, and
    -- this loop must stop for it by hand: no loop in this module polls
    -- (`Turkey.Polls`).
    while !Workers.stopTheWorld() {
        if stopAsked() { stopAt(Prim.frameAddress()) }
    }
    retire()
    Workers.startTheWorld()
    textLength = 0
    put(Prim.cString("[gc] region bytes "))
    putInt(regionBytesInUse)
    put(Prim.cString(", peak "))
    putInt(regionBytesPeak)
    put(Prim.cString("\n"))
    writeLine()
    put(Prim.cString("[gc] collections "))
    putInt(collections)
    put(Prim.cString(", allocations "))
    putInt(Prim.atomicLoad(statsCounts, statsAllocationsAt))
    put(Prim.cString(", bytes "))
    putInt(Prim.atomicLoad(statsCounts, statsBytesAt))
    put(Prim.cString(" ("))
    putFixed(Prim.atomicLoad(statsCounts, statsBytesAt), 1048576, 1)
    put(Prim.cString(" MB)\n"))
    writeLine()
    put(Prim.cString("[gc] by kind: constr "))
    putKind(0)
    put(Prim.cString(", record "))
    putKind(1)
    put(Prim.cString(", array "))
    putKind(2)
    put(Prim.cString(", closure "))
    putKind(3)
    put(Prim.cString(", closure-env "))
    putKind(4)
    put(Prim.cString(", cell "))
    putKind(cellKind)
    put(Prim.cString("\n"))
    writeLine()
    put(Prim.cString("[gc] final live "))
    putInt(heapCount)
    put(Prim.cString(", peak live "))
    putInt(statsLivePeak)
    put(Prim.cString(", objects traced "))
    putInt(statsTraced)
    put(Prim.cString(", freed "))
    putInt(statsFreedTotal)
    put(Prim.cString(", collect time "))
    putFixed(statsClock, 1000000000, 3)
    put(Prim.cString(" s (mark "))
    putFixed(statsMarkClock, 1000000000, 3)
    put(Prim.cString(" s)\n"))
    writeLine()
    put(Prim.cString("[gc] minor "))
    putInt(statsMinor)
    put(Prim.cString(", full "))
    putInt(collections - statsMinor)
    put(Prim.cString(", remembered "))
    putInt(Prim.atomicLoad(statsCounts, statsRememberedAt))
    put(Prim.cString("\n"))
    writeLine()
    -- Every collection's stop visits every thread.
    put(Prim.cString("[gc] threads "))
    putInt(Workers.count())
    put(Prim.cString(" of at most "))
    putInt(Workers.threadLimit())
    put(Prim.cString(", permits "))
    putInt(Workers.permits())
    put(Prim.cString("\n"))
    writeLine()
}

fun putKind(kind : Int) -> Unit = putInt(Prim.atomicLoad(statsByKind, 8 * kind))

-- -- text without a `String` ------------------------------------------------------------
--
-- Into `text`, a byte at a time, and out in one `write` per line so that lines
-- from two sources do not interleave. What does not fit is dropped.

fun putByte(byte : Int) -> Unit {
    if textLength < textBytes - 1 {
        Prim.storeI8(text, textLength, Prim.byteFromInt(byte))
        textLength = textLength + 1
    }
}

-- A NUL-terminated string.
fun put(s : Prim.Ptr) -> Unit {
    var i = 0
    while Prim.byteToInt(Prim.loadI8(s, i)) != 0 {
        putByte(Prim.byteToInt(Prim.loadI8(s, i)))
        i = i + 1
    }
}

fun putInt(n : Int) -> Unit {
    if n < 0 {
        putByte(45)
        putMagnitude(n)
    } else {
        putMagnitude(Prim.intNeg(n))
    }
}

-- The digits of `-n`, for `n <= 0`: the most negative `Int` has no positive
-- twin, and division truncates toward zero, so each remainder is in `-9..0`.
fun putMagnitude(n : Int) -> Unit {
    if n <= -10 { putMagnitude(n / 10) }
    putByte(48 - n % 10)
}

-- `n / unit` rounded to `places` decimal places, for `n` and `unit`
-- positive: what `%.Nf` prints of the quotient, without a `Float`.
fun putFixed(n : Int, unit : Int, places : Int) -> Unit {
    var scale = 1
    for var i = 0; i < places; i = i + 1 { scale = scale * 10 }
    let rounded = (n * scale + unit / 2) / unit
    putInt(rounded / scale)
    putByte(46)
    let fraction = rounded % scale
    var digit = scale / 10
    while digit > 0 {
        putByte(48 + fraction / digit % 10)
        digit = digit / 10
    }
}

-- Lowercase hexadecimal with no leading zeros, as `%p` prints an address.
fun putHex(n : Int) -> Unit {
    var shift = 60
    while shift > 0 && shiftRight(n, shift) & 15 == 0 { shift = shift - 4 }
    while shift >= 0 {
        let digit = (if shift == 0 { n } else { shiftRight(n, shift) }) & 15
        putByte(if digit < 10 { 48 + digit } else { 87 + digit })
        shift = shift - 4
    }
}

-- There is nowhere to report a failed write to.
fun writeLine() -> Unit {
    let _ = Libc.write(2, text, textLength)
    textLength = 0
}

-- -- the threshold scale ----------------------------------------------------------------

-- TURKEY_GC_THRESHOLD_SCALE, or 2 if it is unset or is not a finite decimal
-- number of at least 1, with optional surrounding whitespace.
--
-- Parsed by hand: the collector cannot build the `String` the library's parser
-- takes. Digits past the eighteenth are counted but not accumulated, and the
-- value is the mantissa scaled by powers of ten. That is not correctly
-- rounded, which a scale factor for a threshold has no use for.
fun scaleFrom(s : Prim.Ptr) -> Float {
    let fallback = 2.0
    if Prim.ptrIsNull(s) { return fallback }
    var i = skipSpace(s, 0)
    var negative = False
    if isSign(byteAt(s, i)) {
        negative = byteAt(s, i) == 45
        i = i + 1
    }
    var mantissa = 0
    var digits = 0
    var exponent = 0
    var seen = False
    while isDigit(byteAt(s, i)) {
        seen = True
        if digits < 18 {
            mantissa = mantissa * 10 + byteAt(s, i) - 48
            if mantissa != 0 { digits = digits + 1 }
        } else {
            exponent = exponent + 1
        }
        i = i + 1
    }
    if byteAt(s, i) == 46 {
        i = i + 1
        while isDigit(byteAt(s, i)) {
            seen = True
            if digits < 18 {
                mantissa = mantissa * 10 + byteAt(s, i) - 48
                if mantissa != 0 { digits = digits + 1 }
                exponent = exponent - 1
            }
            i = i + 1
        }
    }
    if !seen { return fallback }
    if isExponentMark(byteAt(s, i)) {
        var j = i + 1
        var negativeExponent = False
        if isSign(byteAt(s, j)) {
            negativeExponent = byteAt(s, j) == 45
            j = j + 1
        }
        if isDigit(byteAt(s, j)) {
            var e = 0
            while isDigit(byteAt(s, j)) {
                if e < 100000 { e = e * 10 + byteAt(s, j) - 48 }
                j = j + 1
            }
            exponent = if negativeExponent { exponent - e } else { exponent + e }
            i = j
        }
    }
    if byteAt(s, skipSpace(s, i)) != 0 { return fallback }
    var value = Prim.intToFloat(mantissa)
    -- A bounded exponent, but still no more steps than it takes to leave the
    -- range a `Float` holds.
    while exponent > 0 {
        if !finite(value) { break }
        value = Prim.floatMul(value, 10.0)
        exponent = exponent - 1
    }
    while exponent < 0 {
        if Prim.floatEq(value, 0.0) { break }
        value = Prim.floatDiv(value, 10.0)
        exponent = exponent + 1
    }
    if negative { value = Prim.floatNeg(value) }
    if finite(value) && Prim.floatGte(value, 1.0) { value } else { fallback }
}

-- TURKEY_GC_GENERATIONAL: on unless it is set to 0.
fun generationalFrom(s : Prim.Ptr) -> Bool =
    Prim.ptrIsNull(s) || decimalFrom(s) != 0

-- TURKEY_GC_STRESS: 0 if it is unset, N if it is a decimal N of at least 1
-- with optional surrounding whitespace, and 1 if it is anything else, which
-- is how a flag set to "yes" still collects at every allocation. At most
-- 2^60, far past any interval a run could reach.
fun intervalFrom(s : Prim.Ptr) -> Int {
    if Prim.ptrIsNull(s) { return 0 }
    let n = decimalFrom(s)
    if n < 1 { 1 } else { n }
}

-- TURKEY_GC_STRESS_SEED, or 1 if it is unset or not a decimal number; never 0,
-- which xorshift cannot leave.
fun seedFrom(s : Prim.Ptr) -> Int {
    if Prim.ptrIsNull(s) { return 1 }
    let n = decimalFrom(s)
    if n < 1 { 1 } else { n }
}

-- The decimal number `s` holds, with optional surrounding whitespace, capped
-- at 2^60; -1 if it holds anything else.
fun decimalFrom(s : Prim.Ptr) -> Int {
    var at = skipSpace(s, 0)
    if !isDigit(byteAt(s, at)) { return -1 }
    var total = 0
    while isDigit(byteAt(s, at)) {
        if total < 0x1000_0000_0000_0000 { total = total * 10 + byteAt(s, at) - 48 }
        at = at + 1
    }
    if byteAt(s, skipSpace(s, at)) != 0 { return -1 }
    if total > 0x1000_0000_0000_0000 { 0x1000_0000_0000_0000 } else { total }
}

-- Neither infinite nor NaN: either makes `x - x` a NaN, which equals nothing.
fun finite(x : Float) -> Bool = Prim.floatEq(Prim.floatSub(x, x), 0.0)

fun byteAt(text : Prim.Ptr, offset : Int) -> Int = Prim.byteToInt(Prim.loadI8(text, offset))

fun isDigit(c : Int) -> Bool = c >= 48 && c <= 57

fun isSign(c : Int) -> Bool = c == 43 || c == 45

fun isExponentMark(c : Int) -> Bool = c == 101 || c == 69

fun skipSpace(s : Prim.Ptr, from : Int) -> Int {
    var i = from
    while isSpace(byteAt(s, i)) { i = i + 1 }
    i
}

-- C's `isspace`: space, and tab through carriage return.
fun isSpace(c : Int) -> Bool = c == 32 || (c >= 9 && c <= 13)

-- -- for the verifier -------------------------------------------------------------------

-- The state `Turkey.HeapCheck` is handed, at the offsets it names. Rewritten
-- before each check, so it is never stale. Null if there was no memory for it,
-- which the verifier reports.
var state : Prim.Ptr = Libc.malloc(Check.stateBytes)

fun snapshot() -> Prim.Ptr {
    retire()
    if Prim.ptrIsNull(state) { return state }
    Prim.storePtr(state, Check.stateRegions, regions)
    Prim.storePtr(state, Check.stateAvailable, available)
    Prim.storePtr(state, Check.stateRegionTable, regionTable)
    Prim.storeI64(state, Check.stateRegionTableCapacity, regionTableCapacity)
    Prim.storeI64(state, Check.stateRegionTableCount, regionTableCount)
    Prim.storeI64(state, Check.stateRegionBytes, regionBytesInUse)
    Prim.storeI64(state, Check.stateObjects, heapCount)
    Prim.storeI64(state, Check.stateSizesKept, if sizesKept { 1 } else { 0 })
    Prim.storePtr(state, Check.stateFrameEntries, frameEntries)
    Prim.storeI64(state, Check.stateFrameEntryCount, frameEntryCount)
    Prim.storePtr(state, Check.stateStacks, Stack.first())
    Prim.storePtr(state, Check.stateRunning, Stack.running())
    Prim.storePtr(state, Check.stateRoots, roots)
    Prim.storeI64(state, Check.stateGenerational, if generational { 1 } else { 0 })
    Prim.storePtr(state, Check.stateRemembered, remembered())
    Prim.storeI64(state, Check.stateRememberedCount, rememberedCount())
    state
}

fun verifyAt(phase : Check.Phase, frame : Prim.Ptr) -> Unit = Check.verify(phase, frame, snapshot())

-- -- for C ------------------------------------------------------------------------------
--
-- What the runtime's C tests read of this state, and the settings they change.
-- None of these traces, marks or looks anything up on the collector's behalf
-- for the verifier, whose worth is that it does those its own way.

-- The verifier's snapshot, for the tests that call it directly.
foreign "turkey_heap_state" fun heapState() -> Prim.Ptr = snapshot()

foreign "turkey_heap_objects" fun heapObjects() -> Int {
    retire()
    heapCount
}

foreign "turkey_collection_count" fun collectionCount() -> Int = collections

-- `enabled` is a C `int`: only its low half is defined.
foreign "turkey_gc_set_stress" fun setStress(enabled : Int) -> Unit {
    retire()
    stress = enabled & 0xFFFF_FFFF != 0
    stressInterval = if stress { 1 } else { 0 }
    stressCountdown = 1
    pollWordSet(stress)
}

foreign "turkey_gc_set_verify" fun setVerify(enabled : Int) -> Unit {
    verify = enabled & 0xFFFF_FFFF != 0
}

-- A minor collection, if minor collections are on, for the tests of what one
-- keeps; `turkey_collect` is always full.
foreign "turkey_collect_minor" fun collectMinor() -> Unit =
    collectFrom(Prim.ptrNull(), Minor)

foreign "turkey_gc_set_generational" fun setGenerational(enabled : Int) -> Unit {
    generational = enabled & 0xFFFF_FFFF != 0
}

foreign "turkey_heap_regions" fun heapRegions() -> Prim.Ptr = regions

foreign "turkey_heap_available" fun heapAvailable() -> Prim.Ptr = available

foreign "turkey_heap_region_bytes" fun heapRegionBytes() -> Int = regionBytesInUse

foreign "turkey_heap_region_table" fun heapRegionTable() -> Prim.Ptr = regionTable

foreign "turkey_heap_region_table_capacity" fun heapRegionTableCapacity() -> Int =
    regionTableCapacity

-- Whether `value` is a live object, for the tests' questions about reuse and
-- reclamation.
foreign "turkey_heap_contains" fun heapContains(value : Prim.Ptr) -> Int {
    retire()
    if Prim.ptrIsNull(findObject(value)) { 0 } else { 1 }
}

-- For the tests that corrupt the heap on purpose, to see the verifier notice.
foreign "turkey_heap_set_objects" fun setHeapObjects(count : Int) -> Unit {
    retire()
    heapCount = count
}

foreign "turkey_heap_set_region_bytes" fun setRegionBytes(bytes : Int) -> Unit {
    regionBytesInUse = bytes
}
