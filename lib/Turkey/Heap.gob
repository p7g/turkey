module Turkey.Heap (
    allocate, collect, report, rootsHead,
)

-- The heap and its collector: regions of fixed-size slots, allocation into
-- them, and a non-moving mark and sweep over exact roots.
--
-- Generational, with sticky marks: an object that survives a collection is
-- old and stays marked, and a minor collection traces only from the roots and
-- the old objects the write barrier remembered, and frees only young objects.
-- A full collection clears the marks and traces everything.
--
-- Non-moving is load-bearing beyond this module. The allocators in
-- `Turkey.Alloc` take managed operands as raw words, which is sound only
-- because the object a word names is still there after a collection, and
-- raw memory may hold an address across calls for the same reason. A moving
-- collector would have to change the allocator interface first.
--
-- A giblet module, and the one that most needs to be: this is the code that
-- runs when nothing may allocate, and it has no roots of its own because it is
-- what reads everyone else's. Every value here is an `Int`, a `Bool`, a
-- `Float` or a `Prim.Ptr`, and every structure is raw memory at fixed offsets.
--
-- The collector's state is this module's globals, set up by early
-- initialization, which runs before anything can allocate. A C caller that
-- uses the program's Turkey code without running the program -- the runtime's
-- own tests -- calls `turkey_giblets_initialize` first, for the same reason.
--
-- The heap verifier, `Turkey.HeapCheck`, is handed a snapshot of this state
-- and decodes it by its own copy of the layouts below, so that a collector bug
-- is not checked by the same bug. It cannot import this module, since this one
-- imports it, and nothing here may move into it for this module to share.

import Prelude ()
import Std.Classes
import Data.Int ()
import Data.Bool.Type (Bool(..))
import Target (OS(..))
import Target as Target
import Turkey.HeapCheck as Check
import Turkey.Memory as Memory
import Turkey.Process as Process
import Turkey.Libc as Libc

-- -- layouts ----------------------------------------------------------------------------
--
-- Copied by `Turkey.HeapCheck` and, for the root frame, the heap header, the
-- cursors and the size classes, shared with the generated code: `Turkey.Emit`
-- builds the globals' root frame, and takes small objects' slots from the
-- cursors itself by `Turkey.Runtime`'s copy of those layouts. A change here is
-- a change there.

-- `HeapHeader`, immediately before every payload: the generation word, the
-- payload size, the heap kind (u32) and the mark epoch that last reached it
-- (u32).
let headerBytes : Int = 24
let headerGeneration : Int = 0
let headerSize : Int = 8
let headerKind : Int = 16
let headerMarked : Int = 20
-- The header and its kind, from the payload.
let payloadHeader : Int = -24
let payloadKind : Int = -8

-- The generation word's values. An object is young from its allocation until
-- the first collection that marks it, and old from then on: one survived
-- collection promotes. An old object given a young one by a store is
-- remembered, once, by the write barrier (`writeBarrier`), which `Turkey.Select`
-- emits: the compiler reads these values too, as does every frame object's
-- header, which is zero.
let young : Int = 0
let old : Int = 1
let rememberedOld : Int = 2

-- Heap kinds: an object (constructor, record, array, closure, environment)
-- and a cell.
let heapObject : Int = 2
let heapCell : Int = 3

-- `HeapRegion`. Small objects live in fixed-size slots of a 64KB region
-- aligned to its size, so a header's region is its address with the low bits
-- cleared. A large object owns a region of its own, `reserved` bytes long,
-- whose one slot is the object.
let regionBytes : Int = 0x10000
-- Clears the offset within a region, leaving its base.
let regionMask : Int = -0x10000
let regionWords : Int = 32
let regionClasses : Int = 22
let regionNext : Int = 0
let regionAvailableNext : Int = 8
let regionSlotSize : Int = 16
let regionReserved : Int = 24
let regionCapacity : Int = 32
let regionUsed : Int = 36
let regionLive : Int = 40
let regionSearchWord : Int = 44
let regionSizeClass : Int = 48
let regionAllocated : Int = 56
let regionMarked : Int = 312
-- Where the slots begin. Eight-byte alignment is all a payload needs.
let regionData : Int = 568

-- `RootFrame`, the shadow stack -- the globals' frame, and any a C caller
-- registers -- is a chain of these: the previous frame, a NUL-terminated
-- function name, the slot count, the slots, and which of the first 64 slots
-- are live right now. Slots from 64 up are always scanned.
let frameCount : Int = 16
let frameValues : Int = 24
let frameLive : Int = 32

-- Words below this in a traced slot are not pointers: nothing is ever mapped
-- in the first page, on any target. Generated code keeps a compact sum's
-- nullary constructors there -- `None` is 0, a second nullary 1 -- so a traced
-- slot, root or array element may hold one, and the collector skips it the way
-- it skips null.
let immediates : Int = 4096

-- The objects `Turkey.Alloc` builds: `kind` and `tag` (i32), `count`, then the
-- pointer metadata and the slots. A cell is its value and an i32 flag saying
-- whether the value is a pointer.
let objectKind : Int = 0
let objectTag : Int = 4
let objectCount : Int = 8
let objectBitmap : Int = 16
let objectSlots : Int = 24

-- One frame-table entry: a return address, how many roots are live across the
-- call, and where their `x29` offsets are.
let entryBytes : Int = 24

-- -- state ------------------------------------------------------------------------------

var regions : Prim.Ptr = Prim.ptrNull()
-- Per size class, the regions with a free slot, linked by `availableNext`.
var available : Prim.Ptr = zeroed(8 * regionClasses)
var regionBytesInUse : Int = 0
var regionBytesPeak : Int = 0

-- Every live region's base, as an open-addressed set, so that `findHeader`
-- can ask whether an arbitrary word is a heap pointer in constant time. GC
-- stress asks that of every pointer it traces, at every allocation, and a walk
-- of the region list there made a stressed run quadratic in the heap.
-- `regionOf` alone cannot answer it, because the aligned base of a word that is
-- not in the heap is not a region and must not be read. Linear probing with
-- backward-shift deletion, so no tombstones build up across the regions the
-- sweep frees. Only the base block of a large region is entered: its one
-- object's header is in that block.
var regionTable : Prim.Ptr = Prim.ptrNull()
var regionTableCapacity : Int = 0
var regionTableCount : Int = 0

var roots : Prim.Ptr = Prim.ptrNull()
var heapCount : Int = 0
-- Objects, and the bytes of their slots, allocated since the last
-- collection. The bytes are what trigger the next one.
var allocationsSince : Int = 0
var bytesSince : Int = 0
-- The bytes of the slots the last sweep kept: a large object's whole region.
var liveBytes : Int = 0
var threshold : Int = 131072
var collections : Int = 0
-- A u32 in each header, so it wraps; see `startMarking`.
var markEpoch : Int = 0

-- The grey set, as an explicit stack: tracing by recursion made the native
-- stack depth proportional to the longest chain of heap pointers, and a long
-- list is an ordinary thing to build. Kept across collections, so its growth
-- is paid for once.
var markStack : Prim.Ptr = Prim.ptrNull()
var markCount : Int = 0
var markCapacity : Int = 0

-- The old objects the write barrier has seen given a young one since the last
-- collection, each once: its generation word says it is here.
var remembered : Prim.Ptr = Prim.ptrNull()
var rememberedCount : Int = 0
var rememberedCapacity : Int = 0

-- The arm64 backend's frame table, sorted by return address.
var frameEntries : Prim.Ptr = Prim.ptrNull()
var frameEntryCount : Int = 0

-- The generated entry's own frame: the outermost any walk of the Turkey stack
-- may reach. Set by the entry once early initialization has run.
var entryStackHigh : Prim.Ptr = Prim.ptrNull()

-- GC stress: a collection at every allocation, or with TURKEY_GC_STRESS=N
-- for N above 1, at random intervals averaging N allocations -- each gap
-- uniform in 1..2N-1, so that no allocation site is always skipped. The
-- sequence is TURKEY_GC_STRESS_SEED's, 1 by default, so that a failing run can
-- be repeated and several seeds can cover different phases. Every allocation
-- takes the slow path while it is on, which is where it counts down.
var stressInterval : Int = intervalFrom(Libc.getenv(Prim.cString("TURKEY_GC_STRESS")))
var stress : Bool = stressInterval > 0
var stressRandom : Int = seedFrom(Libc.getenv(Prim.cString("TURKEY_GC_STRESS_SEED")))
var stressCountdown : Int = 1
var verify : Bool = present(Prim.cString("TURKEY_GC_VERIFY"))

-- Whether a collection may be minor: trace only from the roots and the
-- remembered objects, keep every old object's mark, and free only young
-- objects. Sound only in a program whose every store runs the write barrier,
-- which every program this compiler builds does. C that stores pointers into
-- old objects without calling `turkey_write_barrier` must turn it off with
-- `turkey_gc_set_generational`. TURKEY_GC_GENERATIONAL=0 makes every
-- collection full, for comparison.
var generational : Bool = generationalFrom(Libc.getenv(Prim.cString("TURKEY_GC_GENERATIONAL")))
-- Whether the collection in progress, or the last one, is minor.
var minor : Bool = False
-- The bytes the last full collection kept: the live set, as best it is known.
-- A minor collection's `liveBytes` also counts every old object that died
-- since, which only a full collection finds.
var liveBytesAfterFull : Int = 0

-- Opt-in accounting, printed one line per collection and in `report` when
-- TURKEY_GC_STATS is set: what the collector costs and what drives it, from
-- one run rather than from a profiler. Counting sends every allocation down
-- the slow path (`refill`), so a run's times include that.
var statsWanted : Bool = present(Prim.cString("TURKEY_GC_STATS"))

-- The collector runs again once this many times the live set's bytes have
-- been allocated, or 64KB times it while the live set is smaller than that.
-- The live set is what the last full collection kept: sized from a minor
-- collection's count, which includes the old objects that have died since,
-- the young generation grew with the garbage, and the self-compile's peak
-- memory with it, by 41% over the full collector's rather than 1%.
--
-- Bytes rather than objects, because the threshold is what bounds the heap:
-- counted in objects, a program allocating large arrays grows its heap by the
-- array's size for each one it counts as one. On the compiler's own run the
-- two cost the same at equal peak memory, so that is what decided it.
--
-- 2 is measured. The compiler compiling itself, whose heap is a slowly growing
-- long-lived program under a stream of short-lived trees, marks every live
-- object again at each collection, so the objects traced fall as 1/scale and
-- the peak heap grows by about a live set per step: 1.85G objects traced at
-- 3.1GB of regions at 2, 1.24G at 4.1GB at 3, 0.93G at 5.2GB at 4. The test
-- suite runs several of those compiles at once, which is what holds it at 2.
-- TURKEY_GC_THRESHOLD_SCALE overrides it for experiments.
var thresholdScale : Float =
    scaleFrom(Libc.getenv(Prim.cString("TURKEY_GC_THRESHOLD_SCALE")))

var statsAllocations : Int = 0
var statsBytes : Int = 0
var statsTraced : Int = 0
var statsFreedTotal : Int = 0
var statsFreedPrevious : Int = 0
var statsLiveTotal : Int = 0
var statsLivePeak : Int = 0
var statsClock : Int = 0
-- The part of `statsClock` spent marking, roots included; the rest is the
-- sweep and the bookkeeping around it.
var statsMarkClock : Int = 0
-- Every object the write barrier remembered.
var statsRemembered : Int = 0
var statsMinor : Int = 0
-- Allocations by what the object is, indexed by `Turkey.Alloc`'s kind:
-- 0 constructor, 1 record, 2 array, 3 closure, 4 environment, 7 cell.
var statsByKind : Prim.Ptr = zeroed(64)

-- Room to build one diagnostic or one line of the report, and a `timespec`.
let textBytes : Int = 256
var text : Prim.Ptr = zeroed(textBytes)
var textLength : Int = 0
var clock : Prim.Ptr = zeroed(16)

fun zeroed(bytes : Int) -> Prim.Ptr {
    let p = Libc.malloc(bytes)
    if Prim.ptrIsNull(p) {
        Process.panic(Prim.cString("out of memory starting the collector"))
        return p
    }
    Memory.fill(p, bytes, 0)
    p
}

fun present(name : Prim.Ptr) -> Bool = !Prim.ptrIsNull(Libc.getenv(name))

-- -- raw words --------------------------------------------------------------------------

fun load32(p : Prim.Ptr, offset : Int) -> Int = Prim.charToInt(Prim.loadI32(p, offset))

fun store32(p : Prim.Ptr, offset : Int, value : Int) -> Unit =
    Prim.storeI32(p, offset, Prim.charFromInt(value))

-- Addresses and bitmaps are unsigned, and the primitives compare and shift
-- signed. A heap address happens to fit in 63 bits, but a word that is merely
-- claimed to be a pointer need not, and a stress run exists to be handed one.
-- Unsigned `a < b`: when the sign bits differ, the one with it set is larger.
fun below(a : Int, b : Int) -> Bool =
    if Prim.intXor(a, b) < 0 { b < 0 } else { a < b }

-- The arithmetic on the paths every allocation and every traced object take
-- is wrapping: a checked `+` or `*` is a branch each, and what is computed
-- there -- offsets inside a region, counts of objects -- cannot overflow.
fun plus(augend : Int, addend : Int) -> Int = Prim.intAddWrapping(augend, addend)

fun times8(multiplicand : Int) -> Int = Prim.intShl(multiplicand, 3)

-- `n` in 1..63: arm64 masks a shift amount to six bits, so a shift by 64 is a
-- shift by 0.
fun shiftRight(x : Int, n : Int) -> Int =
    Prim.intAnd(Prim.intShr(x, n), Prim.intSubWrapping(Prim.intShl(1, 64 - n), 1))

-- Every bit of `x` flipped. `Prim.intNot` is a call into the runtime.
fun complement(x : Int) -> Int = Prim.intSubWrapping(Prim.intNegWrapping(x), 1)

fun bit(index : Int) -> Int = Prim.intShl(1, Prim.intAnd(index, 63))

-- Bit `index` of the bitmap at `offset`; `index` is not negative.
fun bitWord(offset : Int, index : Int) -> Int = plus(offset, times8(Prim.intShr(index, 6)))

fun testBit(p : Prim.Ptr, offset : Int, index : Int) -> Bool =
    Prim.intAnd(Prim.loadI64(p, bitWord(offset, index)), bit(index)) != 0

fun setBit(p : Prim.Ptr, offset : Int, index : Int) -> Unit {
    let word = bitWord(offset, index)
    Prim.storeI64(p, word, Prim.intOr(Prim.loadI64(p, word), bit(index)))
}

fun maxInt() -> Int = 0x7FFF_FFFF_FFFF_FFFF

-- -- regions ----------------------------------------------------------------------------

fun regionOf(header : Prim.Ptr) -> Prim.Ptr =
    Prim.ptrFromInt(Prim.intAnd(Prim.ptrToInt(header), regionMask))

-- Fibonacci hashing of the region's number. The verifier recomputes this to
-- check that every entry is reachable by probing, so the two must agree.
fun regionHash(region : Prim.Ptr) -> Int {
    let h = Prim.intMulWrapping(Prim.ptrToInt(region) / regionBytes, -7046029254386353131)
    Prim.intAnd(Prim.intXor(h, shiftRight(h, 32)), regionTableCapacity - 1)
}

fun tableAt(position : Int) -> Prim.Ptr = Prim.loadPtr(regionTable, 8 * position)

fun tableInsert(added : Prim.Ptr) -> Bool {
    if (regionTableCount + 1) * 2 > regionTableCapacity {
        let oldCapacity = regionTableCapacity
        let old = regionTable
        let capacity = if oldCapacity == 0 { 64 } else { oldCapacity * 2 }
        let grown = Libc.malloc(8 * capacity)
        if Prim.ptrIsNull(grown) { return False }
        Memory.fill(grown, 8 * capacity, 0)
        regionTable = grown
        regionTableCapacity = capacity
        for var i = 0; i < oldCapacity; i = i + 1 {
            let entry = Prim.loadPtr(old, 8 * i)
            if !Prim.ptrIsNull(entry) {
                var at = regionHash(entry)
                while !Prim.ptrIsNull(tableAt(at)) { at = Prim.intAnd(at + 1, capacity - 1) }
                Prim.storePtr(regionTable, 8 * at, entry)
            }
        }
        Libc.free(old)
    }
    var at = regionHash(added)
    while !Prim.ptrIsNull(tableAt(at)) {
        at = Prim.intAnd(at + 1, regionTableCapacity - 1)
    }
    Prim.storePtr(regionTable, 8 * at, added)
    regionTableCount = regionTableCount + 1
    True
}

fun tableContains(region : Prim.Ptr) -> Bool {
    if regionTableCapacity == 0 { return False }
    var at = regionHash(region)
    while !Prim.ptrIsNull(tableAt(at)) {
        if Prim.ptrEq(tableAt(at), region) { return True }
        at = Prim.intAnd(at + 1, regionTableCapacity - 1)
    }
    False
}

fun tableRemove(region : Prim.Ptr) -> Unit {
    let mask = regionTableCapacity - 1
    var at = regionHash(region)
    while !Prim.ptrEq(tableAt(at), region) { at = Prim.intAnd(at + 1, mask) }
    Prim.storePtr(regionTable, 8 * at, Prim.ptrNull())
    regionTableCount = regionTableCount - 1
    -- Pull back each entry after the hole that probing would no longer reach:
    -- one whose home is not cyclically within (hole, here].
    var here = Prim.intAnd(at + 1, mask)
    while !Prim.ptrIsNull(tableAt(here)) {
        let home = regionHash(tableAt(here))
        if Prim.intAnd(here - home, mask) >= Prim.intAnd(here - at, mask) {
            Prim.storePtr(regionTable, 8 * at, tableAt(here))
            Prim.storePtr(regionTable, 8 * here, Prim.ptrNull())
            at = here
        }
        here = Prim.intAnd(here + 1, mask)
    }
}

-- -- size classes and cursors -----------------------------------------------------------
--
-- Size classes are 32 to 256 bytes in steps of 16, then powers of two up to
-- half a region. A request above that is large and gets a region of its own.
--
-- Allocation takes slots a bitmap word at a time. A class's cursor holds the
-- free slots of one word of the region at the head of its available list,
-- already set in the region's allocation bitmap and counted in its `used`, in
-- `heapCount` and in `allocationsSince`: so a slot is handed out by clearing a
-- bit in the cursor, and nothing else is written until the word runs out.
-- Generated code does exactly that for the small objects it allocates
-- (`Turkey.Select.allocate`), and calls in only when the free word is empty,
-- so that word is the only state an allocation may change before a refill.
--
-- Those reserved slots hold no object, so everything that reads the bitmaps
-- or the counts -- a collection, the verifier, the C queries -- first calls
-- `retire`, which gives them back. After it, the heap is exactly what it
-- would be had each slot been allocated one at a time.

-- The byte offsets of a cursor's fields, and its size.
let cursorFree : Int = 0
-- The header of the word's first slot.
let cursorBase : Int = 8
let cursorSlot : Int = 16
let cursorRegion : Int = 24
let cursorWord : Int = 32
let cursorBytes : Int = 64

var cursors : Prim.Ptr = zeroed(cursorBytes * regionClasses)

-- The largest payload a size class holds: half a region, less the header.
let smallPayload : Int = 32744

-- Each small request's class, indexed by its size with the header, rounded up
-- to 16 and divided by 16. Every class boundary is a multiple of 16, so every
-- size in one step has the same class.
var classes : Prim.Ptr = classTable()

fun classTable() -> Prim.Ptr {
    let table = zeroed(2049)
    for var step = 1; step <= 2048; step = step + 1 {
        Prim.storeI8(table, step, Prim.byteFromInt(classFor(16 * step)))
    }
    table
}

fun classFor(bytes : Int) -> Int {
    if bytes <= 32 { return 0 }
    if bytes <= 256 { return Prim.intShr(bytes + 15, 4) - 2 }
    var classSize = 256
    var sizeClass = 14
    while classSize < bytes {
        classSize = classSize * 2
        sizeClass = sizeClass + 1
    }
    sizeClass
}

fun classSlot(sizeClass : Int) -> Int =
    if sizeClass < 15 { 32 + 16 * sizeClass } else { Prim.intShl(256, sizeClass - 14) }

-- The class of a payload of at most `smallPayload` bytes.
fun classOf(size : Int) -> Int =
    Prim.byteToInt(Prim.loadI8(classes, Prim.intShr(plus(size, 39), 4)))

-- Whether `size`, unsigned, is small enough for the fast path: a class-table
-- step below 2048. The few sizes just under `smallPayload` it turns away are
-- still small, and `allocateSlow` gives them their class.
fun fastSize(size : Int) -> Bool = Prim.intShr(plus(size, 39), 15) == 0

fun cursorOf(sizeClass : Int) -> Prim.Ptr = Prim.ptrAdd(cursors, Prim.intShl(sizeClass, 6))

-- The lowest of the cursor's free slots, `free`, which is not zero.
fun takeSlot(cursor : Prim.Ptr, free : Int) -> Prim.Ptr {
    let lowest = Prim.intAnd(free, Prim.intNegWrapping(free))
    Prim.storeI64(cursor, cursorFree, Prim.intXor(free, lowest))
    Prim.ptrAdd(Prim.loadPtr(cursor, cursorBase),
                Prim.intMulWrapping(bitIndex(lowest), Prim.loadI64(cursor, cursorSlot)))
}

-- The position of the one set bit in `lowest`: `Memory.trailingZeros`'s de
-- Bruijn table, without its test for zero, its isolation of the lowest bit or
-- its checked subtraction, none of which a bit already isolated needs. This
-- runs at every allocation.
fun bitIndex(lowest : Int) -> Int {
    let pattern = Prim.intAnd(Prim.intShr(Prim.intMulWrapping(lowest, 0x03F7_9D71_B4CB_0A89), 58), 63)
    let positions = Prim.cString("01`2iaL3mjbZVMA4ngkTec[F]WQNHB<5o_hKlYU@fSdE\\PG;^JX?RDO:I>C9=876")
    Prim.intSubWrapping(Prim.byteToInt(Prim.loadI8(positions, pattern)), 48)
}

-- Fill the empty cursor of class `sizeClass` from the first word with a free
-- slot in the head of its available list, making a region if the list is
-- empty; False, with a panic raised, if there is no memory for one.
--
-- Under GC stress, and while statistics are wanted, it takes one slot, so that
-- every allocation comes back here: generated code takes slots from a cursor
-- itself (`Turkey.Select.allocateInline`) and tests nothing else, so an empty
-- cursor is the only way to make an allocation collect or be counted.
fun refill(cursor : Prim.Ptr, sizeClass : Int) -> Bool {
    var region = Prim.loadPtr(available, times8(sizeClass))
    if Prim.ptrIsNull(region) {
        let slotBytes = classSlot(sizeClass)
        region = newRegion(slotBytes, slotBytes, sizeClass, False)
        if Prim.ptrIsNull(region) { return False }
    }
    let capacity = load32(region, regionCapacity)
    -- A region on an available list has a free slot below its capacity, so
    -- this finds one.
    var w = load32(region, regionSearchWord)
    var taken = Prim.loadI64(region, plus(regionAllocated, times8(w)))
    while plus(taken, 1) == 0 {
        w = plus(w, 1)
        taken = Prim.loadI64(region, plus(regionAllocated, times8(w)))
    }
    -- The last word's bits past the capacity are clear, and are not slots.
    var claim = complement(taken)
    let beyond = Prim.intSubWrapping(capacity, Prim.intShl(w, 6))
    if beyond < 64 { claim = Prim.intAnd(claim, Prim.intSubWrapping(Prim.intShl(1, beyond), 1)) }
    if stress || statsWanted { claim = Prim.intAnd(claim, Prim.intNegWrapping(claim)) }
    let now = Prim.intOr(taken, claim)
    Prim.storeI64(region, plus(regionAllocated, times8(w)), now)
    let n = population(claim)
    let used = plus(load32(region, regionUsed), n)
    store32(region, regionUsed, used)
    store32(region, regionSearchWord,
            if plus(now, 1) == 0 && w < regionWords - 1 { plus(w, 1) } else { w })
    if used == capacity {
        Prim.storePtr(available, times8(sizeClass), Prim.loadPtr(region, regionAvailableNext))
    }
    heapCount = plus(heapCount, n)
    allocationsSince = plus(allocationsSince, n)
    let slotSize = Prim.loadI64(region, regionSlotSize)
    bytesSince = plus(bytesSince, Prim.intMulWrapping(n, slotSize))
    Prim.storeI64(cursor, cursorFree, claim)
    Prim.storePtr(cursor, cursorBase,
                  Prim.ptrAdd(region, plus(regionData, Prim.intMulWrapping(Prim.intShl(w, 6), slotSize))))
    Prim.storeI64(cursor, cursorSlot, slotSize)
    Prim.storePtr(cursor, cursorRegion, region)
    Prim.storeI64(cursor, cursorWord, w)
    True
}

-- Give every cursor's unused slots back to its region: clear them from the
-- allocation bitmap and the counts, move the search back to their word, and
-- put a region they had filled back on its available list.
fun retire() -> Unit {
    for var rc = 0; rc < regionClasses; rc = rc + 1 {
        let cursor = cursorOf(rc)
        let left = Prim.loadI64(cursor, cursorFree)
        if left != 0 {
            let r = Prim.loadPtr(cursor, cursorRegion)
            let lw = Prim.loadI64(cursor, cursorWord)
            let at = plus(regionAllocated, times8(lw))
            Prim.storeI64(r, at, Prim.intAnd(Prim.loadI64(r, at), complement(left)))
            let n = population(left)
            let wasUsed = load32(r, regionUsed)
            if wasUsed == load32(r, regionCapacity) {
                Prim.storePtr(r, regionAvailableNext, Prim.loadPtr(available, times8(rc)))
                Prim.storePtr(available, times8(rc), r)
            }
            store32(r, regionUsed, wasUsed - n)
            if lw < load32(r, regionSearchWord) { store32(r, regionSearchWord, lw) }
            heapCount = heapCount - n
            allocationsSince = allocationsSince - n
            bytesSince = bytesSince - n * Prim.loadI64(r, regionSlotSize)
            Prim.storeI64(cursor, cursorFree, 0)
        }
    }
}

-- The number of set bits.
fun population(x : Int) -> Int {
    let pairs = Prim.intSubWrapping(x, Prim.intAnd(shiftRight(x, 1), 0x5555_5555_5555_5555))
    let nibbles = plus(Prim.intAnd(pairs, 0x3333_3333_3333_3333),
                       Prim.intAnd(shiftRight(pairs, 2), 0x3333_3333_3333_3333))
    let bytes = Prim.intAnd(plus(nibbles, shiftRight(nibbles, 4)), 0x0F0F_0F0F_0F0F_0F0F)
    shiftRight(Prim.intMulWrapping(bytes, 0x0101_0101_0101_0101), 56)
}

-- A region of its own for a request of `bytes`, header included, with its one
-- slot allocated; null, with a panic raised, if there is no memory for it.
fun largeAllocate(bytes : Int) -> Prim.Ptr {
    let made = newRegion(bytes, bytes, regionClasses, True)
    if Prim.ptrIsNull(made) { return made }
    Prim.storeI64(made, regionAllocated, 1)
    store32(made, regionUsed, 1)
    heapCount = plus(heapCount, 1)
    allocationsSince = plus(allocationsSince, 1)
    bytesSince = plus(bytesSince, Prim.loadI64(made, regionReserved))
    Prim.ptrAdd(made, regionData)
}

-- A fresh, empty region with slots of `slotSize`, on the region list and, if
-- it is small, its class's available list; null, with a panic raised, if
-- there is no memory for it.
fun newRegion(bytes : Int, slotSize : Int, sizeClass : Int, large : Bool) -> Prim.Ptr {
    let reserved = if large {
        Prim.intAnd(regionData + bytes + regionBytes - 1, regionMask)
    } else { regionBytes }
    let made = Libc.alignedAlloc(regionBytes, reserved)
    if Prim.ptrIsNull(made) {
        Process.panic(Prim.cString("out of memory"))
        return made
    }
    if !tableInsert(made) {
        Libc.free(made)
        Process.panic(Prim.cString("out of memory"))
        return Prim.ptrNull()
    }
    Memory.fill(made, regionData, 0)
    Prim.storeI64(made, regionSlotSize, slotSize)
    Prim.storeI64(made, regionReserved, reserved)
    store32(made, regionCapacity, if large { 1 } else { (regionBytes - regionData) / slotSize })
    store32(made, regionSizeClass, if large { regionClasses } else { sizeClass })
    Prim.storePtr(made, regionNext, regions)
    regions = made
    if !large {
        Prim.storePtr(available, times8(sizeClass), made)
        Prim.storeI64(reciprocals, times8(sizeClass), (0x1_0000_0000 + slotSize - 1) / slotSize)
    }
    regionBytesInUse = regionBytesInUse + reserved
    if regionBytesInUse > regionBytesPeak { regionBytesPeak = regionBytesInUse }
    made
}

-- The largest payload a region can be made for: an `Int` that the header,
-- the region's own fields and the rounding up to a whole region all fit
-- beside.
-- 2^63 - 1 - 24 - 568 - 65535.
let largest : Int = 9223372036854709680

-- The header of the live object `value` points at, or null if it points at
-- none: not into a region, not at a slot's payload, or at a free slot.
fun findHeader(value : Prim.Ptr) -> Prim.Ptr {
    let address = Prim.ptrToInt(value)
    if below(address, headerBytes) { return Prim.ptrNull() }
    let region = regionOf(Prim.ptrFromInt(Prim.intSubWrapping(address, headerBytes)))
    if !tableContains(region) { return Prim.ptrNull() }
    let first = plus(Prim.ptrToInt(region), plus(regionData, headerBytes))
    if below(address, first) { return Prim.ptrNull() }
    let offset = Prim.intSubWrapping(address, first)
    let slot = Prim.loadI64(region, regionSlotSize)
    if offset % slot != 0 { return Prim.ptrNull() }
    let index = offset / slot
    if index < load32(region, regionCapacity) && testBit(region, regionAllocated, index) {
        return Prim.ptrAdd(region, plus(regionData, Prim.intMulWrapping(index, slot)))
    }
    Prim.ptrNull()
}

-- -- allocation -------------------------------------------------------------------------

-- `size` payload bytes of heap `kind`, uninitialized, or null with a panic
-- raised. `size` is an unsigned byte count carried in an `Int`'s bits.
-- `counted` is what the statistics count it as: `Turkey.Alloc`'s kind, or 7
-- for a cell.
--
-- May collect, so every managed value the caller holds must be rooted. `frame`
-- is the caller's own frame record, where the walk of the Turkey stack starts:
-- the caller must be the Turkey function the allocation is made for, since a
-- frame passed along from further out would skip the frames between.
--
-- The path taken by nearly every allocation is a slot from the class's cursor;
-- everything else -- a collection, an empty cursor, a large object, GC stress
-- -- is `allocateSlow`, which is also what keeps this one small.
fun allocate(size : Int, kind : Int, counted : Int, frame : Prim.Ptr) -> Prim.Ptr {
    if !fastSize(size) { return allocateSlow(size, kind, counted, frame) }
    let cursor = cursorOf(classOf(size))
    let free = Prim.loadI64(cursor, cursorFree)
    if free == 0 { return allocateSlow(size, kind, counted, frame) }
    initialize(takeSlot(cursor, free), size, kind, counted)
}

fun allocateSlow(size : Int, kind : Int, counted : Int, frame : Prim.Ptr) -> Prim.Ptr {
    if (stress && stressDue()) || bytesSince >= threshold {
        collectFrom(frame, askedEither)
        -- A collection is the only thing here that can raise one, and an
        -- allocation after a failed collection would be into a heap nobody
        -- has finished tracing.
        if Process.pending() { return Prim.ptrNull() }
    }
    if below(largest, size) {
        Process.panic(Prim.cString("allocation is too large"))
        return Prim.ptrNull()
    }
    if below(smallPayload, size) {
        let header = largeAllocate(plus(headerBytes, size))
        if Prim.ptrIsNull(header) { return header }
        return initialize(header, size, kind, counted)
    }
    let sizeClass = classOf(size)
    let cursor = cursorOf(sizeClass)
    if Prim.loadI64(cursor, cursorFree) == 0 && !refill(cursor, sizeClass) {
        return Prim.ptrNull()
    }
    initialize(takeSlot(cursor, Prim.loadI64(cursor, cursorFree)), size, kind, counted)
}

-- Whether GC stress collects at this allocation.
fun stressDue() -> Bool {
    stressCountdown = stressCountdown - 1
    if stressCountdown > 0 { return False }
    stressCountdown = if stressInterval == 1 { 1 } else {
        -- xorshift64*: a full period over the nonzero words, which is all a
        -- sampling interval needs of it.
        var mixed = stressRandom
        mixed = Prim.intXor(mixed, shiftRight(mixed, 12))
        mixed = Prim.intXor(mixed, Prim.intShl(mixed, 25))
        mixed = Prim.intXor(mixed, shiftRight(mixed, 27))
        stressRandom = mixed
        let drawn = shiftRight(Prim.intMulWrapping(mixed, 0x2545_F491_4F6C_DD1D), 1)
        1 + drawn % (2 * stressInterval - 1)
    }
    True
}

-- The header of a fresh slot, and the payload after it.
fun initialize(header : Prim.Ptr, size : Int, kind : Int, counted : Int) -> Prim.Ptr {
    Prim.storeI64(header, headerGeneration, young)
    Prim.storeI64(header, headerSize, size)
    -- The kind, and a mark epoch of 0 above it: no epoch is 0.
    Prim.storeI64(header, headerKind, kind)
    if statsWanted {
        statsAllocations = plus(statsAllocations, 1)
        statsBytes = plus(statsBytes, plus(size, headerBytes))
        let at = if counted >= 0 && counted < 8 { times8(counted) } else { 0 }
        Prim.storeI64(statsByKind, at, plus(Prim.loadI64(statsByKind, at), 1))
    }
    Prim.ptrAdd(header, headerBytes)
}

-- -- roots ------------------------------------------------------------------------------

-- Push `pointer`, a `RootFrame` the caller owns, onto the shadow stack.
--
-- Nothing is live at registration: the frame is entered on the way into the
-- region that contains the safepoints, and each safepoint stores its own live
-- set. A caller with roots that outlive the call stores the mask itself right
-- after this returns.
foreign "turkey_root_enter" fun rootEnter(pointer : Prim.Ptr, values : Prim.Ptr,
                                          count : Int, functionName : Prim.Ptr) -> Unit {
    if Prim.ptrIsNull(pointer) || Prim.ptrIsNull(values) || count < 0 {
        Process.panic(Prim.cString("invalid root frame size"))
        return {}
    }
    Prim.storePtr(pointer, 0, roots)
    Prim.storePtr(pointer, 8, functionName)
    Prim.storeI64(pointer, frameCount, count)
    Prim.storePtr(pointer, frameValues, values)
    Prim.storeI64(pointer, frameLive, 0)
    roots = pointer
}

foreign "turkey_root_leave" fun rootLeave(pointer : Prim.Ptr) -> Unit {
    if Prim.ptrIsNull(pointer) || !Prim.ptrEq(roots, pointer) {
        Process.panic(Prim.cString("unbalanced root frame"))
        return {}
    }
    roots = Prim.loadPtr(pointer, 0)
}

-- The innermost root frame, for the crash report in `Turkey.Entry`, which
-- walks the chain by its first word and reads each function name. Null before
-- initialization, since a global's storage starts zeroed.
foreign "turkey_roots_head" fun rootsHead() -> Prim.Ptr = roots

-- -- frame tables -----------------------------------------------------------------------
--
-- The arm64 backend registers roots OCaml's way: no function pushes or pops
-- anything, and each call site that may collect has a table entry naming the
-- frame offsets of the roots live across it, keyed by the return address for
-- it. The collector walks `x29` frame records and looks each return address
-- up.
--
-- Only Turkey's frame records are walked, never C's. The walk starts from the
-- frame of the Turkey allocator that called into the heap, which passes its
-- own `x29` in, and ends at the generated entry's frame. Every frame between is
-- Turkey's, because no C function on the mutator's stack calls back into
-- Turkey code that can allocate, and the backend emits a frame record in every
-- function. A C frame keeps one only if its compiler chose to, and a walk that
-- crossed one would lose the Turkey caller's return address and with it that
-- caller's roots.
--
-- A frame whose return address is in no table has no roots, and is skipped. A
-- binary that registers no table walks no frames.

-- The emitter writes a flat array -- count, then {return address, n, n
-- offsets} -- because it cannot sort by an address the linker has not
-- assigned yet. Sorting it once here is what makes the lookup a binary search.
foreign "turkey_frame_table_register" fun frameTableRegister(table : Prim.Ptr) -> Unit {
    if Prim.ptrIsNull(table) { return {} }
    let count = Prim.loadI64(table, 0)
    if count <= 0 { return {} }
    let entries = Libc.malloc(entryBytes * count)
    if Prim.ptrIsNull(entries) {
        Process.panic(Prim.cString("out of memory registering the frame table"))
        return {}
    }
    var p = Prim.ptrAdd(table, 8)
    for var i = 0; i < count; i = i + 1 {
        let n = Prim.loadI64(p, 8)
        Prim.storeI64(entries, entryBytes * i, Prim.loadI64(p, 0))
        Prim.storeI64(entries, entryBytes * i + 8, n)
        Prim.storePtr(entries, entryBytes * i + 16, Prim.ptrAdd(p, 16))
        p = Prim.ptrAdd(p, 16 + 8 * n)
    }
    sortEntries(entries, count)
    Libc.free(frameEntries)
    frameEntries = entries
    frameEntryCount = count
}

fun entryKey(entries : Prim.Ptr, i : Int) -> Int =
    Prim.loadI64(entries, Prim.intMulWrapping(entryBytes, i))

fun swapEntries(entries : Prim.Ptr, i : Int, j : Int) -> Unit {
    for var w = 0; w < entryBytes; w = w + 8 {
        let a = Prim.loadI64(entries, entryBytes * i + w)
        Prim.storeI64(entries, entryBytes * i + w, Prim.loadI64(entries, entryBytes * j + w))
        Prim.storeI64(entries, entryBytes * j + w, a)
    }
}

-- Heapsort, by return address: in place, without recursion, and n log n at
-- worst, which is everything a sort here needs to be.
fun sortEntries(entries : Prim.Ptr, count : Int) -> Unit {
    var start = count / 2
    while start > 0 {
        start = start - 1
        siftDown(entries, start, count)
    }
    var end = count
    while end > 1 {
        end = end - 1
        swapEntries(entries, 0, end)
        siftDown(entries, 0, end)
    }
}

fun siftDown(entries : Prim.Ptr, first : Int, count : Int) -> Unit {
    var root = first
    while 2 * root + 1 < count {
        var child = 2 * root + 1
        if child + 1 < count && below(entryKey(entries, child), entryKey(entries, child + 1)) {
            child = child + 1
        }
        if !below(entryKey(entries, root), entryKey(entries, child)) { return {} }
        swapEntries(entries, root, child)
        root = child
    }
}

fun frameEntryFor(retaddr : Int) -> Prim.Ptr {
    var low = 0
    var high = frameEntryCount - 1
    while low <= high {
        let middle = Prim.intShr(plus(low, high), 1)
        let found = entryKey(frameEntries, middle)
        if found == retaddr {
            return Prim.ptrAdd(frameEntries, Prim.intMulWrapping(entryBytes, middle))
        }
        if below(found, retaddr) { low = plus(middle, 1) } else { high = Prim.intSubWrapping(middle, 1) }
    }
    Prim.ptrNull()
}

-- Recorded by the generated entry, from its own frame, after early
-- initialization and before anything can allocate.
foreign "turkey_entry_stack_set" fun entryStackSet(frame : Prim.Ptr) -> Unit {
    entryStackHigh = frame
}

-- Every Turkey frame of the mutator's stack, from `frame` outwards.
--
-- `frame` is the `x29` of the Turkey allocator that called into the heap: a
-- frame record whose return address is in the allocation site, so the first
-- entry found is the allocating function's. Null means no Turkey frame is
-- live -- the final collection runs after the program has returned -- and
-- nothing is walked.
--
-- The stop conditions matter more than the loop: a walk that runs off the end
-- of the chain marks whatever the words beyond it happen to hold, which would
-- surface as a corruption a long way from here and look exactly like a
-- miscompile. So the frame pointer must stay below the entry's frame, stay
-- 8-byte aligned, and strictly increase. There is no low bound to check: the
-- walk starts at a live frame and only ever moves outwards.
fun scanNativeFrames(frame : Prim.Ptr) -> Unit {
    if frameEntryCount == 0 || Prim.ptrIsNull(frame) { return {} }
    if Prim.ptrIsNull(entryStackHigh) {
        -- Reachable only if something ran the program's code without the
        -- generated entry. Scanning from an unknown outer bound is how a walk
        -- runs off the end; not scanning drops live roots silently, which is
        -- worse. So say so instead of doing either.
        Process.panic(Prim.cString("no entry stack bound: the frame walker cannot run"))
        return {}
    }
    let high = Prim.ptrToInt(entryStackHigh)
    var here = Prim.ptrToInt(frame)
    while !below(high, here + 16) && Prim.intAnd(here, 7) == 0 {
        -- The return address in *this* record is an address in the *caller*,
        -- so the entry it finds describes the caller's frame -- whose `x29` is
        -- this record's saved one. Applying the offsets to this frame instead
        -- reads whatever the callee happens to have at those offsets.
        let record = Prim.ptrFromInt(here)
        let next = Prim.loadI64(record, 0)
        if !below(here, next) || below(high, next + 16) || Prim.intAnd(next, 7) != 0 {
            return {}
        }
        let entry = frameEntryFor(Prim.loadI64(record, 8))
        if !Prim.ptrIsNull(entry) {
            let count = Prim.loadI64(entry, 8)
            let offsets = Prim.loadPtr(entry, 16)
            let caller = Prim.ptrFromInt(next)
            for var i = 0; i < count; i = plus(i, 1) {
                let value = Prim.loadPtr(caller, Prim.loadI64(offsets, times8(i)))
                -- An object the compiler placed in a frame (`Turkey.Escape`):
                -- a callee's rooted parameter, or one such object's field
                -- naming another. It is not a heap object and has no mark bit;
                -- its own frame lists its fields, which is how what it holds
                -- is traced. Only a frame slot can hold one, since nothing in
                -- the heap ever points into the stack, so this is the one
                -- place the test is needed.
                let at = Prim.ptrToInt(value)
                if below(at, Prim.ptrToInt(frame)) || !below(at, high) {
                    markGrey(value, Prim.cString("arm64 frame"), i)
                    drain()
                }
            }
        }
        here = next
    }
}

-- -- marking ----------------------------------------------------------------------------
--
-- An object is marked when it is first pushed, in its region's mark bitmap:
-- an edge to an object already marked -- most edges, in a heap of shared
-- names and types -- then reads the region's header, which a few thousand
-- objects share and which stays in cache, and not the object's own. The
-- header's epoch is written too, for the verifier, which checks the two agree.
--
-- `drain` is the whole of the tracing loop, decoding and pushing in line: the
-- inliner does not copy a body this size, and a call per edge was most of what
-- marking cost.

-- Each size class's slot size as a multiplier: 2^32 / slot, rounded up, and
-- 0 for a large region, whose one slot is at offset 0. A slot's offset times
-- it, over 2^32, is the slot's index, exactly: the offset is a multiple of the
-- slot size below 2^16, so the rounding adds less than 2^16 / 2^32 to a whole
-- number. Set by `newRegion` for each class it makes a region of, which is
-- before anything in the class can be marked.
var reciprocals : Prim.Ptr = zeroed(8 * (regionClasses + 1))

-- Whether a traced word names no object: null, or one of the small integers
-- below `immediates`.
fun immediate(value : Prim.Ptr) -> Bool = below(Prim.ptrToInt(value), immediates)

-- Mark and push `value`, a root found as `what` `index`, if it is an object
-- and not yet marked. `what` null means a root the caller cannot name.
fun markGrey(value : Prim.Ptr, what : Prim.Ptr, index : Int) -> Unit {
    if immediate(value) { return {} }
    -- Exact roots and layout metadata make the header O(1) to find in normal
    -- execution. GC stress checks membership, and it earns the cost: a pointer
    -- that is not in the heap means a root was missed or a layout bitmap is
    -- wrong, and this turns that from a rare corruption into a panic on the
    -- first collection.
    if stress && Prim.ptrIsNull(findHeader(value)) {
        notHeapPointer(value, what, index)
        return {}
    }
    let header = Prim.ptrFromInt(Prim.intSubWrapping(Prim.ptrToInt(value), headerBytes))
    let region = regionOf(header)
    let slot = slotOf(region, header)
    let at = plus(regionMarked, times8(Prim.intShr(slot, 6)))
    let marks = Prim.loadI64(region, at)
    if Prim.intAnd(marks, bit(slot)) != 0 { return {} }
    Prim.storeI64(region, at, Prim.intOr(marks, bit(slot)))
    store32(region, regionLive, plus(load32(region, regionLive), 1))
    store32(header, headerMarked, markEpoch)
    Prim.storeI64(header, headerGeneration, old)
    if markCount == markCapacity && !growMarkStack() { return {} }
    Prim.storePtr(markStack, times8(markCount), value)
    markCount = plus(markCount, 1)
}

-- The index of the slot whose header is `header`, in `region`.
fun slotOf(region : Prim.Ptr, header : Prim.Ptr) -> Int {
    let offset = Prim.intSubWrapping(Prim.ptrDiff(header, region), regionData)
    let multiplier = Prim.loadI64(reciprocals, times8(load32(region, regionSizeClass)))
    Prim.intShr(Prim.intMulWrapping(offset, multiplier), 32)
}

-- Double the mark stack; False, with a panic raised, if there is no memory.
fun growMarkStack() -> Bool {
    let capacity = if markCapacity < 64 { 64 } else { markCapacity * 2 }
    let grown = Libc.realloc(markStack, 8 * capacity)
    if Prim.ptrIsNull(grown) {
        Process.panic(Prim.cString("out of memory while tracing the heap"))
        return False
    }
    markStack = grown
    markCapacity = capacity
    True
}

-- The write barrier's slow path: `parent` has just been given a young object,
-- and is remembered if it is old and not remembered already. Generated code
-- calls it only then, after testing both inline; the test here is for C.
-- Called between a store and the next instruction, so it must not allocate,
-- collect or panic in any way the caller could miss: it is not a safepoint,
-- and nothing checks the panic flag after it.
--
-- Stores the compiler cannot see -- raw stores of a managed pointer into a
-- managed object, from Turkey or C -- must call it too, unless the object was
-- allocated after the value they store.
foreign "turkey_write_barrier" fun writeBarrier(parent : Prim.Ptr) -> Unit {
    let header = Prim.ptrAdd(parent, payloadHeader)
    if Prim.loadI64(header, headerGeneration) != old { return {} }
    if rememberedCount == rememberedCapacity {
        let capacity = if rememberedCapacity < 64 { 64 } else { rememberedCapacity * 2 }
        let grown = Libc.realloc(remembered, 8 * capacity)
        if Prim.ptrIsNull(grown) {
            Process.panic(Prim.cString("out of memory remembering an old object"))
            return {}
        }
        remembered = grown
        rememberedCapacity = capacity
    }
    Prim.storeI64(header, headerGeneration, rememberedOld)
    Prim.storePtr(remembered, times8(rememberedCount), parent)
    rememberedCount = plus(rememberedCount, 1)
    statsRemembered = plus(statsRemembered, 1)
}

-- Trace everything reachable from the stack, emptying it. This is the one
-- place the collector decodes an object's layout.
--
-- An array's tag is its element's layout code, and the other objects carry a
-- code per slot: three bits each for constructors and records, one bit each
-- for closures and environments. Code 7 is a traced pointer and 6 is a
-- pointer-sized word the collector must not follow: a raw address. A test of
-- `>= 6` follows both, and collects through an address it has no business
-- reading.
fun drain() -> Unit {
    var top = markCount
    while top > 0 {
        top = Prim.intSubWrapping(top, 1)
        let object = Prim.loadPtr(markStack, times8(top))
        -- Where its pointers start, how many slots, and how each is coded:
        -- 0 every slot is a pointer, 1 three bits per slot, 2 one bit.
        var first = objectSlots
        var slots = 0
        var coding = 0
        var codes = 0
        let heapKind = load32(object, payloadKind)
        if heapKind == heapCell {
            first = 0
            slots = if load32(object, 8) != 0 { 1 } else { 0 }
        } else if heapKind == heapObject {
            let kind = load32(object, objectKind)
            codes = Prim.loadI64(object, objectBitmap)
            if kind == 2 {
                if load32(object, objectTag) == 7 { slots = Prim.loadI64(object, objectCount) }
            } else {
                slots = Prim.loadI64(object, objectCount)
                coding = if kind == 0 || kind == 1 { 1 } else { 2 }
            }
        }
        for var field = 0; field < slots; field = plus(field, 1) {
            let traced = if coding == 0 { True } else if coding == 1 {
                Prim.intAnd(Prim.intShr(codes, Prim.intMulWrapping(3, field)), 7) == 7
            } else { Prim.intAnd(codes, bit(field)) != 0 }
            let child = if traced { Prim.loadPtr(object, plus(first, times8(field))) }
                        else { Prim.ptrNull() }
            if immediate(child) {
            } else if stress && Prim.ptrIsNull(findHeader(child)) {
                notHeapPointer(child, fieldName(heapKind, coding), field)
            } else {
                let childHeader = Prim.ptrFromInt(Prim.intSubWrapping(Prim.ptrToInt(child), headerBytes))
                let childRegion = regionOf(childHeader)
                let childSlot = slotOf(childRegion, childHeader)
                let at = plus(regionMarked, times8(Prim.intShr(childSlot, 6)))
                let marks = Prim.loadI64(childRegion, at)
                let mask = bit(childSlot)
                if Prim.intAnd(marks, mask) == 0 {
                    Prim.storeI64(childRegion, at, Prim.intOr(marks, mask))
                    store32(childRegion, regionLive, plus(load32(childRegion, regionLive), 1))
                    store32(childHeader, headerMarked, markEpoch)
                    Prim.storeI64(childHeader, headerGeneration, old)
                    if top == markCapacity && !growMarkStack() {
                        markCount = 0
                        return {}
                    }
                    Prim.storePtr(markStack, times8(top), child)
                    top = plus(top, 1)
                }
            }
        }
    }
    markCount = 0
}

-- What `notHeapPointer` calls a field, by how its object codes its slots.
fun fieldName(cellOrObject : Int, slotCoding : Int) -> Prim.Ptr =
    if cellOrObject == heapCell { Prim.ptrNull() }
    else if slotCoding == 0 { Prim.cString("array pointer field") }
    else if slotCoding == 1 { Prim.cString("object pointer field") }
    else { Prim.cString("capture") }

-- "<what> <index> is not a heap pointer (0x...)", or "GC root or field is not
-- a heap pointer (0x...)" when the caller cannot name where it looked. Named,
-- because "a root is not a heap pointer" is true of one slot of one frame, and
-- a compiler emitting roots for the first time needs to know which.
fun notHeapPointer(value : Prim.Ptr, what : Prim.Ptr, index : Int) -> Unit {
    textLength = 0
    if Prim.ptrIsNull(what) {
        put(Prim.cString("GC root or field"))
    } else {
        put(what)
        put(Prim.cString(" "))
        putInt(index)
    }
    put(Prim.cString(" is not a heap pointer (0x"))
    putHex(Prim.ptrToInt(value))
    put(Prim.cString(")"))
    Prim.storeI8(text, textLength, Prim.byteFromInt(0))
    Process.panic(text)
}

-- -- collecting -------------------------------------------------------------------------

-- A collection with no Turkey frame live: the final one, after the program
-- has returned, and a C caller's. Anything else collects through `allocate`,
-- which knows where the Turkey stack starts. Always full: asked for by name,
-- it frees everything unreachable.
foreign "turkey_collect" fun collect() -> Unit = collectFrom(Prim.ptrNull(), askedFull)

-- What a collection is asked to be: whatever `fullDue` says, full, or minor.
-- Minor only if minor collections are on.
let askedEither : Int = 0
let askedFull : Int = 1
let askedMinor : Int = 2

fun collectFrom(frame : Prim.Ptr, asked : Int) -> Unit {
    retire()
    minor = generational && asked != askedFull && (asked == askedMinor || !fullDue())
    if verify { verifyAt(0, frame) }
    let liveBefore = heapCount
    -- Read before the sweep clears it: the allocation pressure this
    -- collection is responding to.
    let allocsSince = allocationsSince
    let wanted = statsWanted
    let started = if wanted { nanoseconds() } else { 0 }
    startMarking()
    if !minor {
        -- Everything is traced again, and every live object marked again,
        -- which makes it old and forgets that it was remembered.
        clearMarks()
        rememberedCount = 0
    }
    var root = roots
    while !Prim.ptrIsNull(root) {
        let count = Prim.loadI64(root, frameCount)
        let live = Prim.loadI64(root, frameLive)
        let values = Prim.loadPtr(root, frameValues)
        let name = Prim.loadPtr(root, 8)
        for var i = 0; i < count; i = plus(i, 1) {
            if i >= 64 || Prim.intAnd(Prim.intShr(live, i), 1) != 0 {
                markGrey(Prim.loadPtr(values, times8(i)), name, i)
                drain()
            }
        }
        root = Prim.loadPtr(root, 0)
    }
    if minor { traceRemembered() }
    -- Beside the chain, not instead of it: the arm64 backend's frames are
    -- here and everything else's are above.
    scanNativeFrames(frame)
    if Process.pending() { return {} }
    let marked = if wanted { nanoseconds() } else { 0 }
    if verify { verifyAt(1, frame) }
    sweep()
    if verify { verifyAt(2, frame) }
    allocationsSince = 0
    bytesSince = 0
    if !minor { liveBytesAfterFull = liveBytes }
    let floor = if liveBytesAfterFull > 65536 { liveBytesAfterFull } else { 65536 }
    let next = Prim.floatMul(Prim.intToFloat(floor), thresholdScale)
    -- `maxInt()` rounds up when converted, so the comparison is against 2^63,
    -- and anything that reaches it saturates instead of converting.
    threshold = if Prim.floatGte(next, Prim.intToFloat(maxInt())) { maxInt() }
                else { Prim.floatTruncate(next) }
    if minor { statsMinor = statsMinor + 1 }
    collections = collections + 1
    if wanted {
        statsMarkClock = statsMarkClock + (marked - started)
        logCollection(started, liveBefore, allocsSince)
    }
}

-- Whether this collection must be full: when the live bytes, old objects
-- that died since included, have grown by half since the last full collection
-- kept them. Under GC stress every eighth is, so that a stressed run
-- exercises both.
--
-- Half is measured, on the self-compile against the full collector (17.7 s,
-- 2.60 GB max RSS): 14.3 s at 2.63 GB. Waiting for the live bytes to double
-- instead was 14.3 s at 2.86 GB, and with the young generation also sized
-- from them, 13.5 s at 3.67 GB.
fun fullDue() -> Bool {
    if stress { return collections % 8 == 0 }
    let floor = if liveBytesAfterFull > 65536 { liveBytesAfterFull } else { 65536 }
    Prim.floatGte(Prim.intToFloat(liveBytes), Prim.floatMul(Prim.intToFloat(floor), 1.5))
}

-- Before a full collection's marking: no object is marked.
fun clearMarks() -> Unit {
    var region = regions
    while !Prim.ptrIsNull(region) {
        Memory.fill(Prim.ptrAdd(region, regionMarked), 8 * regionWords, 0)
        store32(region, regionLive, 0)
        region = Prim.loadPtr(region, regionNext)
    }
}

-- A minor collection's other roots: the fields of every remembered object,
-- which is marked already, being old. Each is old and not remembered after.
fun traceRemembered() -> Unit {
    for var i = 0; i < rememberedCount; i = plus(i, 1) {
        let parent = Prim.loadPtr(remembered, times8(i))
        Prim.storeI64(Prim.ptrAdd(parent, payloadHeader), headerGeneration, old)
        if markCount == markCapacity && !growMarkStack() { return {} }
        Prim.storePtr(markStack, times8(markCount), parent)
        markCount = plus(markCount, 1)
        drain()
    }
    rememberedCount = 0
}

-- A new epoch, so that no header needs clearing before a mark. The epoch is a
-- u32 in each header, and a stress run collects at every allocation, so it
-- wraps: then every live header is cleared once and counting starts again.
fun startMarking() -> Unit {
    markEpoch = markEpoch + 1
    if markEpoch < 0x1_0000_0000 { return {} }
    var region = regions
    while !Prim.ptrIsNull(region) {
        let slotSize = Prim.loadI64(region, regionSlotSize)
        for var word = 0; word < regionWords; word = word + 1 {
            var bits = Prim.loadI64(region, regionAllocated + 8 * word)
            while bits != 0 {
                let slot = word * 64 + Memory.trailingZeros(bits)
                store32(region, regionData + slot * slotSize + headerMarked, 0)
                bits = Prim.intAnd(bits, Prim.intSubWrapping(bits, 1))
            }
        }
        region = Prim.loadPtr(region, regionNext)
    }
    markEpoch = 1
}

-- Empty regions cost one free, however many objects they held. A survivor's
-- marks become its allocation bitmap, so no individual header is visited.
--
-- The marks are kept: every survivor is old now, and an old object stays
-- marked until a full collection clears the marks to trace everything again.
-- A minor collection's marking starts from them, and stops at them.
fun sweep() -> Unit {
    Memory.fill(available, 8 * regionClasses, 0)
    liveBytes = 0
    var previous = Prim.ptrNull()
    var region = regions
    while !Prim.ptrIsNull(region) {
        let next = Prim.loadPtr(region, regionNext)
        let live = load32(region, regionLive)
        let dead = load32(region, regionUsed) - live
        heapCount = heapCount - dead
        statsFreedTotal = statsFreedTotal + dead
        if live == 0 {
            if Prim.ptrIsNull(previous) { regions = next }
            else { Prim.storePtr(previous, regionNext, next) }
            regionBytesInUse = regionBytesInUse - Prim.loadI64(region, regionReserved)
            tableRemove(region)
            Libc.free(region)
        } else {
            Memory.copy(Prim.ptrAdd(region, regionAllocated),
                        Prim.ptrAdd(region, regionMarked), 8 * regionWords)
            store32(region, regionUsed, live)
            store32(region, regionSearchWord, 0)
            let cls = load32(region, regionSizeClass)
            liveBytes = liveBytes + (if cls < regionClasses {
                live * Prim.loadI64(region, regionSlotSize)
            } else { Prim.loadI64(region, regionReserved) })
            if live < load32(region, regionCapacity) && cls < regionClasses {
                Prim.storePtr(region, regionAvailableNext, Prim.loadPtr(available, 8 * cls))
                Prim.storePtr(available, 8 * cls, region)
            }
            previous = region
        }
        region = next
    }
}

-- -- statistics -------------------------------------------------------------------------

fun nanoseconds() -> Int {
    let _ = Libc.clockGettime(monotonic(), clock)
    Prim.loadI64(clock, 0) * 1000000000 + Prim.loadI64(clock, 8)
}

-- `CLOCK_MONOTONIC`, from each target's `<time.h>`.
fun monotonic() -> Int = match Target.os {
    Darwin -> 6
    Linux -> 1
}

fun logCollection(started : Int, liveBefore : Int, allocsSince : Int) -> Unit {
    let nanos = nanoseconds() - started
    let freedNow = statsFreedTotal - statsFreedPrevious
    let survived = liveBefore - freedNow
    statsFreedPrevious = statsFreedTotal
    statsClock = statsClock + nanos
    -- A minor collection marks only the young survivors; the old objects were
    -- marked already, and are not traced again.
    let traced = if minor { survived - (liveBefore - allocsSince) } else { survived }
    if traced > 0 { statsTraced = statsTraced + traced }
    statsLiveTotal = statsLiveTotal + heapCount
    if heapCount > statsLivePeak { statsLivePeak = heapCount }
    textLength = 0
    put(Prim.cString("[gc "))
    putInt(collections)
    put(if minor { Prim.cString(" minor") } else { Prim.cString(" full") })
    put(Prim.cString("] allocs-since "))
    putInt(allocsSince)
    put(Prim.cString(", live-before "))
    putInt(liveBefore)
    put(Prim.cString(", survived "))
    putInt(survived)
    put(Prim.cString(", freed "))
    putInt(freedNow)
    put(Prim.cString(", next threshold "))
    putInt(threshold)
    put(Prim.cString(", "))
    putFixed(nanos, 1000000, 3)
    put(Prim.cString(" ms\n"))
    writeLine()
}

-- The run's totals, when TURKEY_GC_STATS asked for them.
foreign "turkey_gc_report" fun report() -> Unit {
    if !statsWanted { return {} }
    retire()
    textLength = 0
    put(Prim.cString("[gc] region bytes "))
    putInt(regionBytesInUse)
    put(Prim.cString(", peak "))
    putInt(regionBytesPeak)
    put(Prim.cString("\n"))
    writeLine()
    put(Prim.cString("[gc] collections "))
    putInt(collections)
    put(Prim.cString(", allocations "))
    putInt(statsAllocations)
    put(Prim.cString(", bytes "))
    putInt(statsBytes)
    put(Prim.cString(" ("))
    putFixed(statsBytes, 1048576, 1)
    put(Prim.cString(" MB)\n"))
    writeLine()
    put(Prim.cString("[gc] by kind: constr "))
    putKind(0)
    put(Prim.cString(", record "))
    putKind(1)
    put(Prim.cString(", array "))
    putKind(2)
    put(Prim.cString(", closure "))
    putKind(3)
    put(Prim.cString(", closure-env "))
    putKind(4)
    put(Prim.cString(", cell "))
    putKind(7)
    put(Prim.cString("\n"))
    writeLine()
    put(Prim.cString("[gc] final live "))
    putInt(heapCount)
    put(Prim.cString(", peak live "))
    putInt(statsLivePeak)
    put(Prim.cString(", objects traced "))
    putInt(statsTraced)
    put(Prim.cString(", freed "))
    putInt(statsFreedTotal)
    put(Prim.cString(", collect time "))
    putFixed(statsClock, 1000000000, 3)
    put(Prim.cString(" s (mark "))
    putFixed(statsMarkClock, 1000000000, 3)
    put(Prim.cString(" s)\n"))
    writeLine()
    put(Prim.cString("[gc] minor "))
    putInt(statsMinor)
    put(Prim.cString(", full "))
    putInt(collections - statsMinor)
    put(Prim.cString(", remembered "))
    putInt(statsRemembered)
    put(Prim.cString("\n"))
    writeLine()
}

fun putKind(kind : Int) -> Unit = putInt(Prim.loadI64(statsByKind, 8 * kind))

-- -- text without a `String` ------------------------------------------------------------
--
-- Into `text`, a byte at a time, and out in one `write` per line so that lines
-- from two sources do not interleave. What does not fit is dropped.

fun putByte(byte : Int) -> Unit {
    if textLength < textBytes - 1 {
        Prim.storeI8(text, textLength, Prim.byteFromInt(byte))
        textLength = textLength + 1
    }
}

-- A NUL-terminated string.
fun put(s : Prim.Ptr) -> Unit {
    var i = 0
    while Prim.byteToInt(Prim.loadI8(s, i)) != 0 {
        putByte(Prim.byteToInt(Prim.loadI8(s, i)))
        i = i + 1
    }
}

fun putInt(n : Int) -> Unit {
    if n < 0 {
        putByte(45)
        putMagnitude(n)
    } else {
        putMagnitude(Prim.intNeg(n))
    }
}

-- The digits of `-n`, for `n <= 0`: the most negative `Int` has no positive
-- twin, and division truncates toward zero, so each remainder is in `-9..0`.
fun putMagnitude(n : Int) -> Unit {
    if n <= -10 { putMagnitude(n / 10) }
    putByte(48 - n % 10)
}

-- `n / unit` rounded to `places` decimal places, for `n` and `unit`
-- positive: what `%.Nf` prints of the quotient, without a `Float`.
fun putFixed(n : Int, unit : Int, places : Int) -> Unit {
    var scale = 1
    for var i = 0; i < places; i = i + 1 { scale = scale * 10 }
    let rounded = (n * scale + unit / 2) / unit
    putInt(rounded / scale)
    putByte(46)
    let fraction = rounded % scale
    var digit = scale / 10
    while digit > 0 {
        putByte(48 + fraction / digit % 10)
        digit = digit / 10
    }
}

-- Lowercase hexadecimal with no leading zeros, as `%p` prints an address.
fun putHex(n : Int) -> Unit {
    var shift = 60
    while shift > 0 && Prim.intAnd(shiftRight(n, shift), 15) == 0 { shift = shift - 4 }
    while shift >= 0 {
        let digit = Prim.intAnd(if shift == 0 { n } else { shiftRight(n, shift) }, 15)
        putByte(if digit < 10 { 48 + digit } else { 87 + digit })
        shift = shift - 4
    }
}

-- There is nowhere to report a failed write to.
fun writeLine() -> Unit {
    let _ = Libc.write(2, text, textLength)
    textLength = 0
}

-- -- the threshold scale ----------------------------------------------------------------

-- TURKEY_GC_THRESHOLD_SCALE, or 2 if it is unset or is not a finite decimal
-- number of at least 1, with optional surrounding whitespace.
--
-- Parsed by hand: the collector cannot build the `String` the library's parser
-- takes. Digits past the eighteenth are counted but not accumulated, and the
-- value is the mantissa scaled by powers of ten. That is not correctly
-- rounded, which a scale factor for a threshold has no use for.
fun scaleFrom(s : Prim.Ptr) -> Float {
    let fallback = 2.0
    if Prim.ptrIsNull(s) { return fallback }
    var i = skipSpace(s, 0)
    var negative = False
    if isSign(byteAt(s, i)) {
        negative = byteAt(s, i) == 45
        i = i + 1
    }
    var mantissa = 0
    var digits = 0
    var exponent = 0
    var seen = False
    while isDigit(byteAt(s, i)) {
        seen = True
        if digits < 18 {
            mantissa = mantissa * 10 + byteAt(s, i) - 48
            if mantissa != 0 { digits = digits + 1 }
        } else {
            exponent = exponent + 1
        }
        i = i + 1
    }
    if byteAt(s, i) == 46 {
        i = i + 1
        while isDigit(byteAt(s, i)) {
            seen = True
            if digits < 18 {
                mantissa = mantissa * 10 + byteAt(s, i) - 48
                if mantissa != 0 { digits = digits + 1 }
                exponent = exponent - 1
            }
            i = i + 1
        }
    }
    if !seen { return fallback }
    if isExponentMark(byteAt(s, i)) {
        var j = i + 1
        var negativeExponent = False
        if isSign(byteAt(s, j)) {
            negativeExponent = byteAt(s, j) == 45
            j = j + 1
        }
        if isDigit(byteAt(s, j)) {
            var e = 0
            while isDigit(byteAt(s, j)) {
                if e < 100000 { e = e * 10 + byteAt(s, j) - 48 }
                j = j + 1
            }
            exponent = if negativeExponent { exponent - e } else { exponent + e }
            i = j
        }
    }
    if byteAt(s, skipSpace(s, i)) != 0 { return fallback }
    var value = Prim.intToFloat(mantissa)
    -- A bounded exponent, but still no more steps than it takes to leave the
    -- range a `Float` holds.
    while exponent > 0 {
        if !finite(value) { break }
        value = Prim.floatMul(value, 10.0)
        exponent = exponent - 1
    }
    while exponent < 0 {
        if Prim.floatEq(value, 0.0) { break }
        value = Prim.floatDiv(value, 10.0)
        exponent = exponent + 1
    }
    if negative { value = Prim.floatNeg(value) }
    if finite(value) && Prim.floatGte(value, 1.0) { value } else { fallback }
}

-- TURKEY_GC_GENERATIONAL: on unless it is set to 0.
fun generationalFrom(s : Prim.Ptr) -> Bool =
    Prim.ptrIsNull(s) || decimalFrom(s) != 0

-- TURKEY_GC_STRESS: 0 if it is unset, N if it is a decimal N of at least 1
-- with optional surrounding whitespace, and 1 if it is anything else, which
-- is how a flag set to "yes" still collects at every allocation. At most
-- 2^60, far past any interval a run could reach.
fun intervalFrom(s : Prim.Ptr) -> Int {
    if Prim.ptrIsNull(s) { return 0 }
    let n = decimalFrom(s)
    if n < 1 { 1 } else { n }
}

-- TURKEY_GC_STRESS_SEED, or 1 if it is unset or not a decimal number; never 0,
-- which xorshift cannot leave.
fun seedFrom(s : Prim.Ptr) -> Int {
    if Prim.ptrIsNull(s) { return 1 }
    let n = decimalFrom(s)
    if n < 1 { 1 } else { n }
}

-- The decimal number `s` holds, with optional surrounding whitespace, capped
-- at 2^60; -1 if it holds anything else.
fun decimalFrom(s : Prim.Ptr) -> Int {
    var at = skipSpace(s, 0)
    if !isDigit(byteAt(s, at)) { return -1 }
    var total = 0
    while isDigit(byteAt(s, at)) {
        if total < 0x1000_0000_0000_0000 { total = total * 10 + byteAt(s, at) - 48 }
        at = at + 1
    }
    if byteAt(s, skipSpace(s, at)) != 0 { return -1 }
    if total > 0x1000_0000_0000_0000 { 0x1000_0000_0000_0000 } else { total }
}

-- Neither infinite nor NaN: either makes `x - x` a NaN, which equals nothing.
fun finite(x : Float) -> Bool = Prim.floatEq(Prim.floatSub(x, x), 0.0)

fun byteAt(text : Prim.Ptr, offset : Int) -> Int = Prim.byteToInt(Prim.loadI8(text, offset))

fun isDigit(c : Int) -> Bool = c >= 48 && c <= 57

fun isSign(c : Int) -> Bool = c == 43 || c == 45

fun isExponentMark(c : Int) -> Bool = c == 101 || c == 69

fun skipSpace(s : Prim.Ptr, from : Int) -> Int {
    var i = from
    while isSpace(byteAt(s, i)) { i = i + 1 }
    i
}

-- C's `isspace`: space, and tab through carriage return.
fun isSpace(c : Int) -> Bool = c == 32 || (c >= 9 && c <= 13)

-- -- for the verifier -------------------------------------------------------------------

-- The state `Turkey.HeapCheck` is handed, at the offsets it names. Rewritten
-- before each check, so it is never stale. Null if there was no memory for it,
-- which the verifier reports.
var state : Prim.Ptr = Libc.malloc(Check.stateBytes)

fun snapshot() -> Prim.Ptr {
    retire()
    if Prim.ptrIsNull(state) { return state }
    Prim.storePtr(state, Check.stateRegions, regions)
    Prim.storePtr(state, Check.stateAvailable, available)
    Prim.storePtr(state, Check.stateRegionTable, regionTable)
    Prim.storeI64(state, Check.stateRegionTableCapacity, regionTableCapacity)
    Prim.storeI64(state, Check.stateRegionTableCount, regionTableCount)
    Prim.storeI64(state, Check.stateRegionBytes, regionBytesInUse)
    Prim.storeI64(state, Check.stateObjects, heapCount)
    Prim.storeI64(state, Check.stateMarkEpoch, markEpoch)
    Prim.storePtr(state, Check.stateFrameEntries, frameEntries)
    Prim.storeI64(state, Check.stateFrameEntryCount, frameEntryCount)
    Prim.storePtr(state, Check.stateEntryStackHigh, entryStackHigh)
    Prim.storePtr(state, Check.stateRoots, roots)
    Prim.storeI64(state, Check.stateMinor, if minor { 1 } else { 0 })
    Prim.storeI64(state, Check.stateGenerational, if generational { 1 } else { 0 })
    Prim.storePtr(state, Check.stateRemembered, remembered)
    Prim.storeI64(state, Check.stateRememberedCount, rememberedCount)
    state
}

fun verifyAt(phase : Int, frame : Prim.Ptr) -> Unit = Check.verify(phase, frame, snapshot())

-- -- for C ------------------------------------------------------------------------------
--
-- What the runtime's C tests read of this state, and the settings they change.
-- None of these traces, marks or looks anything up on the collector's behalf
-- for the verifier, whose worth is that it does those its own way.

-- The verifier's snapshot, for the tests that call it directly.
foreign "turkey_heap_state" fun heapState() -> Prim.Ptr = snapshot()

foreign "turkey_heap_objects" fun heapObjects() -> Int {
    retire()
    heapCount
}

foreign "turkey_collection_count" fun collectionCount() -> Int = collections

-- `enabled` is a C `int`: only its low half is defined.
foreign "turkey_gc_set_stress" fun setStress(enabled : Int) -> Unit {
    retire()
    stress = Prim.intAnd(enabled, 0xFFFF_FFFF) != 0
    stressInterval = if stress { 1 } else { 0 }
    stressCountdown = 1
}

foreign "turkey_gc_set_verify" fun setVerify(enabled : Int) -> Unit {
    verify = Prim.intAnd(enabled, 0xFFFF_FFFF) != 0
}

-- A minor collection, if minor collections are on, for the tests of what one
-- keeps; `turkey_collect` is always full.
foreign "turkey_collect_minor" fun collectMinor() -> Unit =
    collectFrom(Prim.ptrNull(), askedMinor)

foreign "turkey_gc_set_generational" fun setGenerational(enabled : Int) -> Unit {
    generational = Prim.intAnd(enabled, 0xFFFF_FFFF) != 0
}

foreign "turkey_heap_regions" fun heapRegions() -> Prim.Ptr = regions

foreign "turkey_heap_available" fun heapAvailable() -> Prim.Ptr = available

foreign "turkey_heap_region_bytes" fun heapRegionBytes() -> Int = regionBytesInUse

foreign "turkey_heap_region_table" fun heapRegionTable() -> Prim.Ptr = regionTable

foreign "turkey_heap_region_table_capacity" fun heapRegionTableCapacity() -> Int =
    regionTableCapacity

foreign "turkey_heap_mark_epoch" fun heapMarkEpoch() -> Int = markEpoch

-- Whether `value` is a live object, for the tests' questions about reuse and
-- reclamation.
foreign "turkey_heap_contains" fun heapContains(value : Prim.Ptr) -> Int {
    retire()
    if Prim.ptrIsNull(findHeader(value)) { 0 } else { 1 }
}

-- For the tests that corrupt the heap on purpose, to see the verifier notice.
foreign "turkey_heap_set_mark_epoch" fun setMarkEpoch(epoch : Int) -> Unit {
    markEpoch = epoch
}

foreign "turkey_heap_set_objects" fun setHeapObjects(count : Int) -> Unit {
    retire()
    heapCount = count
}

foreign "turkey_heap_set_region_bytes" fun setRegionBytes(bytes : Int) -> Unit {
    regionBytesInUse = bytes
}
