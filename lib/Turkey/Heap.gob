export (
	allocate,
	collect,
	report,
	rootsHead,
	pause,
	retireHeld,
)

--- The heap and its collector: regions of fixed-size slots, allocation into
--- them, and a non-moving mark and sweep over exact roots.
---
--- Generational, with sticky marks: an object that survives a collection is
--- old and stays marked, and a minor collection traces only from the roots and
--- the old objects the write barrier remembered, and frees only young objects.
--- A full collection clears the marks and traces everything.
---
--- A full collection on native targets may move the survivors of sparse
--- regions (see "evacuation"), but never an object a stack slot names, nor
--- anything in the region it is in. The allocators in `Turkey.Alloc` take
--- managed operands as raw words, and raw memory may hold an address across
--- calls: both are sound only because each such word's object is named by a
--- root slot of a frame on some stack while the word is held. Nothing moves
--- while a C caller has a root frame registered.
---
--- A giblet module, and the one that most needs to be: this is the code that
--- runs when nothing may allocate, and it has no roots of its own because it is
--- what reads everyone else's. Every value here is an `Int`, a `Float`, a
--- `Ptr` or an enumeration such as `Bool`, none of them traced, and every
--- structure is raw memory at fixed offsets.
---
--- The collector's state is this module's globals, set up by early
--- initialization, which runs before anything can allocate. A C caller that
--- uses the program's Turkey code without running the program -- the runtime's
--- own tests -- calls `turkey_giblets_initialize` first, for the same reason.
---
--- The heap verifier, `Turkey.HeapCheck`, is handed a snapshot of this state
--- and decodes it by its own copy of the layouts below, so that a collector bug
--- is not checked by the same bug. It cannot import this module, since this one
--- imports it, and nothing here may move into it for this module to share.

import Prelude ()
import Data.Int (Int)
import Data.Float (Float)
import Data.Option (Option(..))
import Data.Tuple (Unit)
import Data.Eq ((==), (!=))
import Data.Ord ((<), (<=), (>), (>=))
import Data.Num (Neg(..), (+), (-), (*), (/), (%))
import Bits ((&), (|), (^), (<<), (>>))
import Data.Bool (Bool(..))
import Turkey.HeapCheck as Check
import Turkey.Memory as Memory
import Turkey.Process as Process
import Turkey.Os as Os
import Turkey.Lock as Lock
import Turkey.Stack as Stack
import Turkey.Sys as Sys
import Turkey.Workers as Workers
import Data.Int as Int
import Data.Byte as Byte
import Data.Float as Float
import Turkey.Ptr (Ptr)
import Turkey.Ptr as Ptr
import Target (OS(..))
import Target as Target
import Turkey.Wasi as Wasi

-- -- layouts ----------------------------------------------------------------------------
--
-- Copied by `Turkey.HeapCheck` and, for the root frame, the object header,
-- the cursors, the size classes and the size table, shared with the generated
-- code: `Turkey.Emit` builds the globals' root frame, and takes small objects'
-- slots from the cursors itself by `Turkey.Runtime`'s copy of those layouts. A
-- change here is a change there.

-- An object's header, the word its address points at: its generation (u8),
-- its kind (u8), the count of the traced words its fields start with (u16),
-- and its tag (i32), which the collector does not read but in an array. In an
-- array the count is the traced words each element starts with and the tag
-- is the elements' stride in bytes, and in a cell the count is 1 if the value
-- is traced. `Turkey.Runtime.objectFields` says the same.
let headerGeneration : Int = 0

-- The generation's values. An object is young from its allocation until the
-- first collection that marks it, and old from then on: one survived
-- collection promotes. An old object given a young one by a store is
-- remembered, once, by the write barrier (`writeBarrier`), which `Turkey.Select`
-- emits: the compiler reads these values too, as does every frame object's
-- header, which is young.
let _young : Int = 0
let old : Int = 1
let rememberedOld : Int = 2

-- The kinds that are not laid out as fields after the header: an array, whose
-- length follows the header and its elements the length, and a cell, whose
-- value follows the header. The rest are 0 constructor, 1 record, 3 closure
-- and 4 environment.
let arrayKind : Int = 2
let cellKind : Int = 5

-- `HeapRegion`. Small objects live in fixed-size slots of a 64KB region
-- aligned to its size, so a header's region is its address with the low bits
-- cleared. A large object owns a region of its own, `reserved` bytes long,
-- whose one slot is the object.
let regionBytes : Int = 0x10000
-- Clears the offset within a region, leaving its base.
let regionMask : Int = -0x10000
-- The words of each slot bitmap: 4096 bits, which the 4028 slots of the
-- 16-byte class need.
let regionWords : Int = 64
let regionClasses : Int = 26
let regionNext : Int = 0
let regionAvailableNext : Int = 8
let regionSlotSize : Int = 16
let regionReserved : Int = 24
let regionCapacity : Int = 32
let regionUsed : Int = 36
let regionLive : Int = 40
let regionSearchWord : Int = 44
let regionSizeClass : Int = 48
let regionAllocated : Int = 56
let regionMarked : Int = 568
-- The region's size table, or null: see `sizesKept`.
let regionSizes : Int = 1080
-- Where the slots begin. Eight-byte alignment is all an object needs, so
-- every slot size is a multiple of 8 and the smallest is 16: the header and
-- one word.
let regionData : Int = 1088

-- `RootFrame`, the shadow stack -- the globals' frame, and any a C caller
-- registers -- is a chain of these: the previous frame, a NUL-terminated
-- function name, the slot count, the slots, and which of the first 64 slots
-- are live right now. Slots from 64 up are always scanned.
let frameCount : Int = 16
let frameValues : Int = 24
let frameLive : Int = 32

-- Words below this in a traced slot are not pointers: nothing is ever mapped
-- in the first page, on any target. Generated code keeps a compact sum's
-- nullary constructors there -- `None` is 0, a second nullary 1 -- so a traced
-- slot, root or array element may hold one, and the collector skips it the way
-- it skips null.
let immediates : Int = 4096

-- Where an object's fields are, and so its traced words: right after the
-- header, since the compiler puts every traced field first
-- (`Turkey.Runtime.layout`). A cell's value is there too. An array's length
-- is there instead, and its elements after it, each starting with the traced
-- words its header counts.
let objectFields : Int = 8
let arrayLength : Int = 8
let arrayElements : Int = 16

-- One frame-table entry, three words: a return address, or a site on wasm;
-- how many roots are live across the call; and the address of their offsets
-- from the frame, which are in the emitted table and are four bytes each,
-- signed: from `x29` on arm64, and from the shadow frame on wasm.
let entryBytes : Int = 24

-- -- state ------------------------------------------------------------------------------

-- Held by a worker while it edits what the workers share: the region list,
-- the available lists, the region table and the counts. A worker's own
-- cursors and the regions they own are its alone and need no lock. A
-- collection runs with every other worker stopped, so it takes none.
--
-- Never held across a panic: generated code returns from a call that raised
-- one straight to its caller, past any release after it, so a function that
-- runs under the lock reports failure and its caller panics once it has let go.
var heapLock : Ptr = Lock.new()

var regions : Ptr = Ptr.null()
-- Per size class, the regions with a free slot that no cursor owns, linked by
-- `availableNext`.
var available : Ptr = zeroed(8 * regionClasses)
var regionBytesInUse : Int = 0
var regionBytesPeak : Int = 0

-- Every live region's base, as an open-addressed set, so that `findObject`
-- can ask whether an arbitrary word is a heap pointer in constant time. GC
-- stress asks that of every pointer it traces, at every allocation, and a walk
-- of the region list there made a stressed run quadratic in the heap.
-- `regionOf` alone cannot answer it, because the aligned base of a word that is
-- not in the heap is not a region and must not be read. Linear probing with
-- backward-shift deletion, so no tombstones build up across the regions the
-- sweep frees. Only the base block of a large region is entered: its one
-- object's header is in that block.
var regionTable : Ptr = Ptr.null()
var regionTableCapacity : Int = 0
var regionTableCount : Int = 0

-- Empty 64KB regions, linked by `next`, that `newRegion` takes before it asks
-- libc for memory. A spare is on no region list and not in the region table,
-- so nothing in it is an object, and `regionBytesInUse` does not count it.
-- Its size table, if it has one, stays with it.
--
-- Kept because libc does not keep them cheaply: glibc serves a 64KB-aligned
-- 64KB block from a fresh `mmap`, so a region freed at a sweep and allocated
-- again before the next one costs a `munmap`, an `mmap` and a page fault per
-- page the allocator touches, which a program with short-lived garbage pays
-- every cycle.
var spare : Ptr = Ptr.null()
var spareCount : Int = 0
-- The most bytes the regions in use have reserved since the last full
-- collection, and between the two before it: what the sweep lets the heap
-- hold, spares included.
--
-- A peak rather than the regions each cycle takes, and over full collections
-- rather than cycles, because of how a generational heap grows. Between full
-- collections, old objects that die stay in their regions, so the heap takes
-- regions at every minor collection and gives none back; the full collection
-- then empties them all at once. Keeping only what recent cycles took frees
-- those at every full collection and maps them again before the next, which
-- on the HTTP benchmark was an `mmap` and a `munmap` every 200 requests.
var peakSinceFull : Int = 0
var peakBeforeFull : Int = 0

var roots : Ptr = Ptr.null()
var heapCount : Int = 0
-- Objects, and the bytes of their slots, allocated since the last
-- collection. The bytes are what trigger the next one.
var allocationsSince : Int = 0
var bytesSince : Int = 0

-- What a worker's cursors have taken since it was last folded into the three
-- counts above, by `retire` or when the worker took a region: objects, objects since the collection, and their bytes,
-- in the last three words of its record (`Process.workerRecord`, from 1984).
-- Kept per worker so that a refill from a region the cursor owns touches
-- nothing shared and takes no lock.
fun localAdd(objects : Int, bytes : Int) -> Unit {
	let w = Process.workerRecord()
	Ptr.store(w, 1984, plus(Ptr.load(w, 1984), objects))
	Ptr.store(w, 1992, plus(Ptr.load(w, 1992), objects))
	Ptr.store(w, 2000, plus(Ptr.load(w, 2000), bytes))
}

fun localBytes() -> Int = Ptr.load(Process.workerRecord(), 2000)

-- Fold worker `w`'s counts into the heap's and zero them.
fun localFold(w : Ptr) -> Unit {
	heapCount = plus(heapCount, Ptr.load(w, 1984))
	allocationsSince = plus(allocationsSince, Ptr.load(w, 1992))
	bytesSince = plus(bytesSince, Ptr.load(w, 2000))
	Ptr.store(w, 1984, 0)
	Ptr.store(w, 1992, 0)
	Ptr.store(w, 2000, 0)
}
-- The bytes of the slots the last sweep kept: a large object's whole region.
var liveBytes : Int = 0
var threshold : Int = 131072
var collections : Int = 0

-- The grey set, as an explicit stack per worker: tracing by recursion made
-- the native stack depth proportional to the longest chain of heap pointers,
-- and a long list is an ordinary thing to build. Each worker's is the
-- stack's address, how many entries it holds and how many it has room for,
-- `markerBytes` apart by worker index; kept across collections, so its
-- growth is paid for once.
let markerBytes : Int = 24
var markers : Ptr = zeroed(markerBytes * Workers.threadLimit())

-- The old objects the write barrier has seen given a young one since the last
-- collection, each once: its generation says it is here.
-- The write barrier's remembered set is per worker, so that no two barriers
-- write one buffer: a `malloc`ed array of objects, its count and its
-- capacity, in words 296, 304 and 312 of the running worker's record
-- (`Process.workerRecord`). Offsets are literals in the accessors, since a `let`
-- is a load from its global. A collection consumes the running worker's.
fun remembered() -> Ptr = Ptr.load(Process.workerRecord(), 296)
fun rememberedSet(buffer : Ptr) -> Unit = Ptr.store(Process.workerRecord(), 296, buffer)
fun rememberedCount() -> Int = Ptr.load(Process.workerRecord(), 304)
fun rememberedCountSet(n : Int) -> Unit = Ptr.store(Process.workerRecord(), 304, n)
fun rememberedCapacity() -> Int = Ptr.load(Process.workerRecord(), 312)
fun rememberedCapacitySet(n : Int) -> Unit = Ptr.store(Process.workerRecord(), 312, n)

-- The backend's frame table, sorted by return address, or by site on wasm.
var frameEntries : Ptr = Ptr.null()
var frameEntryCount : Int = 0

-- The program's static objects: the address of the first, and the bytes from
-- it to the end of the last. Empty until the entry sequence registers them.
var staticStart : Int = 0
var staticBytes : Int = 0

-- GC stress: a collection at every allocation, or with TURKEY_GC_STRESS=N
-- for N above 1, at random intervals averaging N allocations -- each gap
-- uniform in 1..2N-1, so that no allocation site is always skipped. The
-- sequence is TURKEY_GC_STRESS_SEED's, 1 by default, so that a failing run can
-- be repeated and several seeds can cover different phases. Every allocation
-- takes the slow path while it is on, which is where it counts down.
var stressInterval : Int = intervalFrom(Os.getenv(Prim.cString("TURKEY_GC_STRESS")))
var stress : Bool = stressInterval > 0
var stressRandom : Int = seedFrom(Os.getenv(Prim.cString("TURKEY_GC_STRESS_SEED")))
var stressCountdown : Int = 1

-- Heap verification at every collection, by `Turkey.HeapCheck`. Fixed when the
-- program is compiled, by `turkey --gc-verify` (`Turkey.Build`), so that a
-- program compiled without it has no verifier at all: nothing writes this
-- `var`, so the optimizer reads it as its constant. A C caller driving the
-- runtime turns it on and off with `turkey_gc_set_verify`, in a build that
-- exports that, which is what keeps it a variable there.
var verify : Bool = Prim.gcVerify
var verifyIgnored : Bool = notCompiledIn(
	verify,
	Prim.cString("TURKEY_GC_VERIFY"),
	Prim.cString("--gc-verify"),
)

-- Whether every region keeps a size table: a word per eight bytes of its
-- first 64KB, holding the size of the object at that offset, written by every
-- allocation. No object records its size, so the table is how the verifier
-- checks that an object fits its slot and has its slot's size class, which is
-- the check that the compiler's copy of the class rule
-- (`Turkey.Runtime.sizeClass`) agrees with this module's. Only in a program
-- compiled with `--gc-verify`, whose generated code writes the table too; a
-- program compiled without it has no table and no stores.
let sizesKept : Bool = Prim.gcVerify

-- Whether a collection may be minor: trace only from the roots and the
-- remembered objects, keep every old object's mark, and free only young
-- objects. Sound only in a program whose every store runs the write barrier,
-- which every program this compiler builds does. C that stores pointers into
-- old objects without calling `turkey_write_barrier` must turn it off with
-- `turkey_gc_set_generational`. TURKEY_GC_GENERATIONAL=0 makes every
-- collection full, for comparison.
var generational : Bool = generationalFrom(Os.getenv(Prim.cString("TURKEY_GC_GENERATIONAL")))
-- Whether the collection in progress, or the last one, is minor.
var minor : Bool = False
-- The bytes the last full collection kept: the live set, as best it is known.
-- A minor collection's `liveBytes` also counts every old object that died
-- since, which only a full collection finds.
var liveBytesAfterFull : Int = 0

-- Opt-in accounting, printed one line per collection and in `report` in a
-- program compiled with `turkey --gc-stats`: what the collector costs and what
-- drives it, from one run rather than from a profiler. Counting sends every
-- allocation down the slow path (`refill`), so a run's times include that.
var statsWanted : Bool = Prim.gcStats
var statsIgnored : Bool = notCompiledIn(
	statsWanted,
	Prim.cString("TURKEY_GC_STATS"),
	Prim.cString("--gc-stats"),
)

-- The most the young generation's budget may be, as a multiple of the bytes
-- the last full collection kept, or of 64KB while that is smaller
-- (`schedule`): 2 natively and 1 on wasm32. The cap keeps a program whose
-- square-root budget is large from collecting less often than at this
-- scale, and it is what small heaps get. The live set here is the full
-- collection's, because a minor collection's count includes the old objects
-- that have died since, and a budget sized from it grows with the garbage:
-- the self-compile's peak memory by 41% over the full collector's, rather
-- than 1%.
--
-- Bytes rather than objects, because the budget is what bounds the heap:
-- counted in objects, a program allocating large arrays grows its heap by the
-- array's size for each one it counts as one. On the compiler's own run the
-- two cost the same at equal peak memory.
--
-- The scale was measured with the budget at the scale alone, minor
-- collections on. Natively, the compiler compiling itself peaks at a 3.2GB
-- footprint in 5.6s at 2, 2.9GB in 5.8s at 1.5, and 2.5GB in 6.2s at 1, and
-- a compile of a small program takes 5% and 7% longer at 1.5 and 1, so 2
-- takes the time. On wasm32, linear memory has a hard 4GiB ceiling and the
-- smaller scale costs little time: the self-compile needs 3.3GiB of linear
-- memory at 2 and 2.4GiB at 1, and takes about 2% longer at 1. The
-- square-root budget is under the cap for most of the native self-compile
-- and over it for most of the wasm32 one, so on wasm32 the scale still sets
-- most of the memory the compile needs.
--
-- TURKEY_GC_THRESHOLD_SCALE overrides it on either, for experiments.
var thresholdScale : Float = scaleFrom(Os.getenv(Prim.cString("TURKEY_GC_THRESHOLD_SCALE")))

-- The counts every worker adds to as it allocates, by atomic adds: objects
-- and bytes allocated, and objects the write barrier remembered.
var statsCounts : Ptr = zeroed(24)
let statsAllocationsAt : Int = 0
let statsBytesAt : Int = 8
let statsRememberedAt : Int = 16
var statsTraced : Int = 0
var statsFreedTotal : Int = 0
var statsFreedPrevious : Int = 0
var statsLiveTotal : Int = 0
var statsLivePeak : Int = 0
var statsClock : Int = 0
-- The part of `statsClock` spent marking, roots included; the rest is the
-- sweep and the bookkeeping around it.
var statsMarkClock : Int = 0
var statsMinor : Int = 0
-- Allocations by what the object is, indexed by its kind, also added to
-- atomically: 0 constructor, 1 record, 2 array, 3 closure, 4 environment,
-- 5 cell.
var statsByKind : Ptr = zeroed(64)

-- Room to build one diagnostic or one line of the report, and a `timespec`.
let textBytes : Int = 256
var text : Ptr = zeroed(textBytes)
var textLength : Int = 0
var clock : Ptr = zeroed(16)

fun zeroed(bytes : Int) -> Ptr {
	let p = Os.malloc(bytes)
	if Ptr.isNull(p) {
		Process.panic(Prim.cString("out of memory"))
		return p
	}
	Memory.fill(p, bytes, 0)
	p
}

fun present(name : Ptr) -> Bool = !Ptr.isNull(Os.getenv(name))

-- Whether the environment asks this run for a debugging aid the program was
-- compiled without, which is said on stderr rather than ignored: the variable
-- names the aid, and a run is where it is easiest to expect it to work.
fun notCompiledIn(built : Bool, name : Ptr, flag : Ptr) -> Bool {
	if built || !present(name) { return False }
	say(Prim.cString("turkey: "))
	say(name)
	say(Prim.cString(" is ignored, because this program was compiled without "))
	say(flag)
	say(Prim.cString("; compile with "))
	say(flag)
	say(Prim.cString(" to use it\n"))
	True
}

fun say(text : Ptr) -> Unit {
	let _ = Os.write(2, text, Os.strlen(text))
}

-- -- raw words --------------------------------------------------------------------------

-- Addresses and bitmaps are unsigned, and the primitives compare and shift
-- signed. A heap address happens to fit in 63 bits, but a word that is merely
-- claimed to be a pointer need not, and a stress run exists to be handed one.
-- Unsigned `a < b`: when the sign bits differ, the one with it set is larger.
fun below(a : Int, b : Int) -> Bool =
	if a ^ b < 0 { b < 0 } else { a < b }

-- The arithmetic on the paths every allocation and every traced object take
-- is wrapping: a checked `+` or `*` is a branch each, and what is computed
-- there -- offsets inside a region, counts of objects -- cannot overflow.
fun plus(augend : Int, addend : Int) -> Int = Int.addWrapping(augend, addend)

fun times8(multiplicand : Int) -> Int = multiplicand << 3

-- `n` in 1..63, so that `64 - n` is a shift amount too.
fun shiftRight(x : Int, n : Int) -> Int =
	x >> n & Int.subWrapping(1 << (64 - n), 1)

-- Every bit of `x` flipped.
fun complement(x : Int) -> Int = Int.not(x)

fun bit(index : Int) -> Int = 1 << (index & 63)

-- Bit `index` of the bitmap at `offset`; `index` is not negative.
fun bitWord(offset : Int, index : Int) -> Int = plus(offset, times8(index >> 6))

fun testBit(p : Ptr, offset : Int, index : Int) -> Bool =
	Ptr.load(p, bitWord(offset, index)) & bit(index) != 0

fun maxInt() -> Int = 0x7FFF_FFFF_FFFF_FFFF

-- -- regions ----------------------------------------------------------------------------

fun regionOf(header : Ptr) -> Ptr =
	Ptr.fromInt(Ptr.toInt(header) & regionMask)

-- Fibonacci hashing of the region's number. The verifier recomputes this to
-- check that every entry is reachable by probing, so the two must agree.
fun regionHash(region : Ptr) -> Int {
	let h = Int.mulWrapping(Ptr.toInt(region) / regionBytes, -7046029254386353131)
	(h ^ shiftRight(h, 32)) & (regionTableCapacity - 1)
}

fun tableAt(position : Int) -> Ptr = Ptr.load(regionTable, 8 * position)

fun tableInsert(added : Ptr) -> Bool {
	if (regionTableCount + 1) * 2 > regionTableCapacity {
		let oldCapacity = regionTableCapacity
		let old = regionTable
		let capacity = if oldCapacity == 0 { 64 } else { oldCapacity * 2 }
		let grown = Os.malloc(8 * capacity)
		if Ptr.isNull(grown) { return False }
		Memory.fill(grown, 8 * capacity, 0)
		regionTable = grown
		regionTableCapacity = capacity
		for var i = 0; i < oldCapacity; i = i + 1 {
			let entry : Ptr = Ptr.load(old, 8 * i)
			if !Ptr.isNull(entry) {
				var at = regionHash(entry)
				while !Ptr.isNull(tableAt(at)) { at = (at + 1) & (capacity - 1) }
				Ptr.store(regionTable, 8 * at, entry)
			}
		}
		Os.free(old)
	}
	var at = regionHash(added)
	while !Ptr.isNull(tableAt(at)) {
		at = (at + 1) & (regionTableCapacity - 1)
	}
	Ptr.store(regionTable, 8 * at, added)
	regionTableCount = regionTableCount + 1
	True
}

fun tableContains(region : Ptr) -> Bool {
	if regionTableCapacity == 0 { return False }
	var at = regionHash(region)
	while !Ptr.isNull(tableAt(at)) {
		if tableAt(at) == region { return True }
		at = (at + 1) & (regionTableCapacity - 1)
	}
	False
}

fun tableRemove(region : Ptr) -> Unit {
	let mask = regionTableCapacity - 1
	var at = regionHash(region)
	while tableAt(at) != region { at = (at + 1) & mask }
	Ptr.store(regionTable, 8 * at, Ptr.null())
	regionTableCount = regionTableCount - 1
	-- Pull back each entry after the hole that probing would no longer reach:
	-- one whose home is not cyclically within (hole, here].
	var here = (at + 1) & mask
	while !Ptr.isNull(tableAt(here)) {
		let home = regionHash(tableAt(here))
		if (here - home) & mask >= (here - at) & mask {
			Ptr.store(regionTable, 8 * at, tableAt(here))
			Ptr.store(regionTable, 8 * here, Ptr.null())
			at = here
		}
		here = (here + 1) & mask
	}
}

-- -- size classes and cursors -----------------------------------------------------------
--
-- Size classes are 16 to 64 bytes in steps of 8, 80 to 256 in steps of 16,
-- then powers of two up to half a region. A request above that is large and
-- gets a region of its own.
--
-- Allocation takes slots a bitmap word at a time. A class's cursor owns one
-- region, taken off the class's available list, and holds the free slots of
-- one word of it, already set in the region's allocation bitmap and counted
-- in its `used`, in
-- `heapCount` and in `allocationsSince`: so a slot is handed out by clearing a
-- bit in the cursor, and nothing else is written until the word runs out.
-- Generated code does exactly that for the small objects it allocates
-- (`Turkey.Select.allocate`), and calls in only when the free word is empty,
-- so that word is the only state an allocation may change before a refill.
--
-- Those reserved slots hold no object, so everything that reads the bitmaps
-- or the counts -- a collection, the verifier, the C queries -- first calls
-- `retire`, which gives them back, and gives up the regions, so that every
-- region with a free slot is on its available list again. After it, the heap
-- is exactly what it would be had each slot been allocated one at a time.
--
-- Owning a region is what lets several workers allocate at once: a region is
-- written by the one worker whose cursor owns it, and the available lists,
-- shared, are touched only to take a region or give one back.

-- The byte offsets of a cursor's fields, and its size.
let cursorFree : Int = 0
-- The header of the word's first slot.
let cursorBase : Int = 8
let cursorSlot : Int = 16
let cursorRegion : Int = 24
let cursorWord : Int = 32
let _cursorBytes : Int = 64

-- The cursors are the running worker's, one per class from 320 bytes into its
-- record (`Process.workerRecord`), where `Turkey.Runtime` puts them and generated
-- code finds them. The offset is a literal in `cursorOf` rather than a `let`
-- because a `let` is a load from its global, on every slow-path allocation.

-- The largest object a size class holds: half a region.
let smallBytes : Int = 32768

-- Each small object's class, indexed by its size rounded up to 8 and divided
-- by 8. Every class boundary is a multiple of 8, so every size in one step
-- has the same class.
var classes : Ptr = classTable()

fun classTable() -> Ptr {
	let table = zeroed(4097)
	for var step = 1; step <= 4096; step = step + 1 {
		Ptr.store(table, step, Byte.truncate(classFor(8 * step)))
	}
	table
}

fun classFor(bytes : Int) -> Int {
	if bytes <= 16 { return 0 }
	if bytes <= 64 { return ((bytes + 7) >> 3) - 2 }
	if bytes <= 256 { return ((bytes + 15) >> 4) + 2 }
	var classSize = 256
	var sizeClass = 18
	while classSize < bytes {
		classSize = classSize * 2
		sizeClass = sizeClass + 1
	}
	sizeClass
}

fun classSlot(sizeClass : Int) -> Int =
	if sizeClass < 7 {
		16 + 8 * sizeClass
	} else if sizeClass < 19 {
		64 + 16 * (sizeClass - 6)
	} else {
		256 << (sizeClass - 18)
	}

-- The class of an object of at most `smallBytes` bytes.
fun classOf(size : Int) -> Int =
	Byte.toInt(Ptr.load(classes, plus(size, 7) >> 3))

-- Whether `size`, unsigned, is small enough for the fast path: a class-table
-- step below 4096. The few sizes just under `smallBytes` it turns away are
-- still small, and `allocateSlow` gives them their class.
fun fastSize(size : Int) -> Bool = plus(size, 7) >> 15 == 0

fun cursorOf(sizeClass : Int) -> Ptr = cursorIn(Process.workerRecord(), sizeClass)

fun cursorIn(w : Ptr, sizeClass : Int) -> Ptr =
	Ptr.add(w, plus(320, sizeClass << 6))

-- The lowest of the cursor's free slots, `free`, which is not zero.
fun takeSlot(cursor : Ptr, free : Int) -> Ptr {
	let lowest = free & Int.negWrapping(free)
	Ptr.store(cursor, cursorFree, free ^ lowest)
	Ptr.add(
		Ptr.load(cursor, cursorBase),
		Int.mulWrapping(bitIndex(lowest), Ptr.load(cursor, cursorSlot)),
	)
}

-- The position of the one set bit in `lowest`: `Memory.trailingZeros`'s de
-- Bruijn table, without its test for zero, its isolation of the lowest bit or
-- its checked subtraction, none of which a bit already isolated needs. This
-- runs at every allocation.
fun bitIndex(lowest : Int) -> Int {
	let pattern = Int.mulWrapping(lowest, 0x03F7_9D71_B4CB_0A89) >> 58 & 63
	let positions = Prim.cString("01`2iaL3mjbZVMA4ngkTec[F]WQNHB<5o_hKlYU@fSdE\\PG;^JX?RDO:I>C9=876")
	Int.subWrapping(Byte.toInt(Ptr.load(positions, pattern)), 48)
}

-- Fill the empty cursor of class `sizeClass` from the first word with a free
-- slot in the region it owns, or, when that is full, in one it takes off the
-- class's available list or makes; False if there is no memory for one. The
-- region and the worker's counts are the worker's own, so only taking a
-- region takes `heapLock`. A full region it gives up is on no list, and the sweep puts
-- it back on one if it frees a slot.
--
-- Under GC stress, and while statistics are wanted, it takes one slot, so that
-- every allocation comes back here: generated code takes slots from a cursor
-- itself (`Turkey.Select.allocateInline`) and tests nothing else, so an empty
-- cursor is the only way to make an allocation collect or be counted.
fun refill(cursor : Ptr, sizeClass : Int) -> Bool {
	var region : Ptr = Ptr.load(cursor, cursorRegion)
	if Ptr.isNull(region) || Ptr.load32(region, regionUsed) == Ptr.load32(region, regionCapacity) {
		Lock.acquire(heapLock)
		region = takeRegion(sizeClass)
		-- While the lock is held anyway: so that what triggers a collection
		-- counts every worker's allocation to within a region's worth each,
		-- and not only the worker that asks.
		localFold(Process.workerRecord())
		Lock.release(heapLock)
		if Ptr.isNull(region) { return False }
		Ptr.store(cursor, cursorRegion, region)
	}
	let capacity = Ptr.load32(region, regionCapacity)
	-- The region has a free slot below its capacity, so this finds one.
	var w = Ptr.load32(region, regionSearchWord)
	var taken : Int = Ptr.load(region, plus(regionAllocated, times8(w)))
	while plus(taken, 1) == 0 {
		w = plus(w, 1)
		taken = Ptr.load(region, plus(regionAllocated, times8(w)))
	}
	-- The last word's bits past the capacity are clear, and are not slots.
	var claim = complement(taken)
	let beyond = Int.subWrapping(capacity, w << 6)
	if beyond < 64 { claim = claim & Int.subWrapping(1 << beyond, 1) }
	if stress || statsWanted { claim = claim & Int.negWrapping(claim) }
	let now = taken | claim
	Ptr.store(region, plus(regionAllocated, times8(w)), now)
	let n = population(claim)
	let used = plus(Ptr.load32(region, regionUsed), n)
	Ptr.store32(region, regionUsed, used)
	Ptr.store32(
		region,
		regionSearchWord,
		if plus(now, 1) == 0 && w < regionWords - 1 { plus(w, 1) } else { w },
	)
	let slotSize : Int = Ptr.load(region, regionSlotSize)
	localAdd(n, Int.mulWrapping(n, slotSize))
	Ptr.store(cursor, cursorFree, claim)
	Ptr.store(
		cursor,
		cursorBase,
		Ptr.add(region, plus(regionData, Int.mulWrapping(w << 6, slotSize))),
	)
	Ptr.store(cursor, cursorSlot, slotSize)
	Ptr.store(cursor, cursorWord, w)
	True
}

-- A region of class `sizeClass` with a free slot, off the available list, or
-- a new one; null if there is no memory for one. Under `heapLock`.
fun takeRegion(sizeClass : Int) -> Ptr {
	var region : Ptr = Ptr.load(available, times8(sizeClass))
	if Ptr.isNull(region) {
		-- A new region goes on the list, and so comes off it here too.
		let slotBytes = classSlot(sizeClass)
		region = newRegion(slotBytes, slotBytes, sizeClass, False)
		if Ptr.isNull(region) { return region }
	}
	Ptr.store(available, times8(sizeClass), Ptr.load(region, regionAvailableNext) : Ptr)
	region
}

-- Give every cursor's unused slots back to its region -- clear them from the
-- allocation bitmap and the counts, and move the search back to their word --
-- give up the region, onto its available list if it has a free slot, and fold
-- the worker's counts into the heap's -- for every worker -- and move every
-- other worker's remembered objects to the running worker's set. Edits the
-- shared lists without the lock: it runs only where no other worker can be
-- allocating, in a collection or with one worker.
fun retire() -> Unit {
	let me = Process.workerRecord()
	for var i = 0; i < Workers.count(); i = plus(i, 1) {
		let w = Workers.recordOf(i)
		retireWorker(w)
		if w != me { adoptRemembered(w) }
	}
}

fun retireWorker(w : Ptr) -> Unit {
	for var rc = 0; rc < regionClasses; rc = rc + 1 {
		let cursor = cursorIn(w, rc)
		let r : Ptr = Ptr.load(cursor, cursorRegion)
		if !Ptr.isNull(r) {
			let left : Int = Ptr.load(cursor, cursorFree)
			if left != 0 {
				let lw : Int = Ptr.load(cursor, cursorWord)
				let at = plus(regionAllocated, times8(lw))
				Ptr.store(r, at, Ptr.load(r, at) & complement(left))
				let n = population(left)
				Ptr.store32(r, regionUsed, Ptr.load32(r, regionUsed) - n)
				if lw < Ptr.load32(r, regionSearchWord) { Ptr.store32(r, regionSearchWord, lw) }
				heapCount = heapCount - n
				allocationsSince = allocationsSince - n
				bytesSince = bytesSince - n * Ptr.load(r, regionSlotSize)
				Ptr.store(cursor, cursorFree, 0)
			}
			if Ptr.load32(r, regionUsed) < Ptr.load32(r, regionCapacity) {
				Ptr.store(r, regionAvailableNext, Ptr.load(available, times8(rc)) : Ptr)
				Ptr.store(available, times8(rc), r)
			}
			Ptr.store(cursor, cursorRegion, Ptr.null())
		}
	}
	localFold(w)
}

--- Give a blocked worker's cursors back, as `retire` does, for the monitor
--- (`Turkey.Monitor`), which holds the worker so that it cannot allocate:
--- under the lock, since every other worker may be allocating.
fun retireHeld(w : Ptr) -> Unit {
	-- The monitor waits for the lock while it holds a worker that a
	-- collection may be waiting for. That is safe only because the lock is
	-- never held at a safepoint: nothing under it allocates, and no loop in
	-- this module polls, so its holder never stops for that collection.
	Lock.acquire(heapLock)
	retireWorker(w)
	Lock.release(heapLock)
}

-- Append worker `w`'s remembered objects to the running worker's set, which
-- is the one a collection reads, and empty `w`'s.
fun adoptRemembered(w : Ptr) -> Unit {
	let theirs : Ptr = Ptr.load(w, 296)
	let n : Int = Ptr.load(w, 304)
	for var i = 0; i < n; i = plus(i, 1) { remember(Ptr.load(theirs, times8(i))) }
	Ptr.store(w, 304, 0)
}

-- The number of set bits.
fun population(x : Int) -> Int {
	let pairs = Int.subWrapping(x, shiftRight(x, 1) & 0x5555_5555_5555_5555)
	let nibbles = plus(pairs & 0x3333_3333_3333_3333, shiftRight(pairs, 2) & 0x3333_3333_3333_3333)
	let bytes = plus(nibbles, shiftRight(nibbles, 4)) & 0x0F0F_0F0F_0F0F_0F0F
	shiftRight(Int.mulWrapping(bytes, 0x0101_0101_0101_0101), 56)
}

-- A region of its own for an object of `bytes`, with its one slot allocated;
-- null if there is no memory for it. Under `heapLock`.
fun largeAllocate(bytes : Int) -> Ptr {
	let made = newRegion(bytes, bytes, regionClasses, True)
	if Ptr.isNull(made) { return made }
	Ptr.store(made, regionAllocated, 1)
	Ptr.store32(made, regionUsed, 1)
	heapCount = plus(heapCount, 1)
	allocationsSince = plus(allocationsSince, 1)
	bytesSince = plus(bytesSince, Ptr.load(made, regionReserved))
	Ptr.add(made, regionData)
}

-- An empty region with slots of `slotSize`, on the region list and, if it is
-- small, its class's available list; null if there is no memory for it. A
-- 64KB one is a spare if there is one. Under `heapLock`.
fun newRegion(bytes : Int, slotSize : Int, sizeClass : Int, large : Bool) -> Ptr {
	let reserved = if large {
		(regionData + bytes + regionBytes - 1) & regionMask
	} else {
		regionBytes
	}
	let reused = reserved == regionBytes && !Ptr.isNull(spare)
	let made = if reused { spare } else { Os.alignedAlloc(regionBytes, reserved) }
	if Ptr.isNull(made) { return made }
	-- A freed slot in a live region is reused as it was left, so no allocation
	-- reads a slot before writing it, and a spare's old slots need no
	-- clearing either. Only the header is cleared, below.
	if reused {
		spare = Ptr.load(made, regionNext)
		spareCount = spareCount - 1
	}
	let sizes = if !sizesKept {
		Ptr.null()
	} else if reused {
		Ptr.load(made, regionSizes)
	} else {
		Os.malloc(regionBytes)
	}
	if (sizesKept && Ptr.isNull(sizes)) || !tableInsert(made) {
		Os.free(sizes)
		Os.free(made)
		return Ptr.null()
	}
	Memory.fill(made, regionData, 0)
	Ptr.store(made, regionSizes, sizes)
	Ptr.store(made, regionSlotSize, slotSize)
	Ptr.store(made, regionReserved, reserved)
	Ptr.store32(made, regionCapacity, if large { 1 } else { (regionBytes - regionData) / slotSize })
	Ptr.store32(made, regionSizeClass, if large { regionClasses } else { sizeClass })
	Ptr.store(made, regionNext, regions)
	regions = made
	if !large {
		Ptr.store(available, times8(sizeClass), made)
		Ptr.store(reciprocals, times8(sizeClass), (0x1_0000_0000 + slotSize - 1) / slotSize)
	}
	regionBytesInUse = regionBytesInUse + reserved
	if regionBytesInUse > regionBytesPeak { regionBytesPeak = regionBytesInUse }
	if regionBytesInUse > peakSinceFull { peakSinceFull = regionBytesInUse }
	made
}

-- The largest object a region can be made for: an `Int` that the region's
-- own fields and the rounding up to a whole region all fit beside.
-- 2^63 - 1 - 1088 - 65535.
let largest : Int = 9223372036854709184

-- `value` if it is a live object, or null if it is not: not into a region,
-- not at a slot, or at a free slot.
fun findObject(value : Ptr) -> Ptr {
	let address = Ptr.toInt(value)
	let region = regionOf(value)
	if !tableContains(region) { return Ptr.null() }
	let first = plus(Ptr.toInt(region), regionData)
	if below(address, first) { return Ptr.null() }
	let offset = Int.subWrapping(address, first)
	let slot : Int = Ptr.load(region, regionSlotSize)
	if offset % slot != 0 { return Ptr.null() }
	let index = offset / slot
	if index < Ptr.load32(region, regionCapacity) && testBit(region, regionAllocated, index) {
		return value
	}
	Ptr.null()
}

-- -- allocation -------------------------------------------------------------------------

--- A slot for an object of `size` bytes, header included, and of `kind`,
--- uninitialized, or null with a panic raised. `size` is an unsigned byte
--- count carried in an `Int`'s bits. The caller writes the header before
--- anything can collect.
---
--- May collect, so every managed value the caller holds must be rooted. `frame`
--- is the caller's own frame record, where the walk of the Turkey stack starts:
--- the caller must be the Turkey function the allocation is made for, since a
--- frame passed along from further out would skip the frames between.
fun allocate(size : Int, kind : Int, frame : Ptr) -> Ptr {
	-- The path taken by nearly every allocation is a slot from the class's
	-- cursor; everything else -- a collection, an empty cursor, a large
	-- object, GC stress -- is `allocateSlow`, which is also what keeps this
	-- one small.
	if !fastSize(size) { return allocateSlow(size, kind, frame) }
	let cursor = cursorOf(classOf(size))
	let free : Int = Ptr.load(cursor, cursorFree)
	if free == 0 { return allocateSlow(size, kind, frame) }
	taken(takeSlot(cursor, free), size, kind)
}

fun allocateSlow(size : Int, kind : Int, frame : Ptr) -> Ptr {
	if stopAsked() { stopAt(frame) }
	if stress { pollWordSet(True) }
	if (stress && stressDue()) || plus(bytesSince, localBytes()) >= threshold {
		collectFrom(frame, Due)
		-- A collection is the only thing here that can raise one, and an
		-- allocation after a failed collection would be into a heap nobody
		-- has finished tracing.
		if Process.pending() { return Ptr.null() }
	}
	if below(largest, size) {
		Process.panicUnsigned(
			Prim.cString("allocation of "),
			size,
			Prim.cString(" bytes is too large"),
		)
		return Ptr.null()
	}
	let object = slotFor(size)
	if !Ptr.isNull(object) { return taken(object, size, kind) }
	-- No memory for a region, though the threshold was not reached: the heap
	-- grows by up to a budget between collections, which can be more than
	-- the memory left. So collect everything and try once more before giving
	-- up. On wasm32, the schedule keeps the budget under the 4 GiB a 32-bit
	-- memory has, less the collector's reserve, but its floor may take half
	-- of that reserve, and an engine may allow less: this is what is left
	-- then.
	collectFrom(frame, Full)
	if Process.pending() { return Ptr.null() }
	let again = slotFor(size)
	if Ptr.isNull(again) { return outOfMemory() }
	taken(again, size, kind)
}

-- A slot of `size` bytes, its header unwritten, or null if there is no memory
-- for a region to hold it.
fun slotFor(size : Int) -> Ptr {
	if below(smallBytes, size) {
		Lock.acquire(heapLock)
		let object = largeAllocate(size)
		Lock.release(heapLock)
		return object
	}
	let sizeClass = classOf(size)
	let cursor = cursorOf(sizeClass)
	if Ptr.load(cursor, cursorFree) == 0 && !refill(cursor, sizeClass) { return Ptr.null() }
	takeSlot(cursor, Ptr.load(cursor, cursorFree))
}

fun outOfMemory() -> Ptr {
	Process.panic(Prim.cString("out of memory"))
	Ptr.null()
}

-- -- polls ------------------------------------------------------------------------------

-- The running worker's poll word, the one every loop's back edge tests
-- (`Turkey.Polls`): word 272 of its record. Its bit 0 is a collection asking
-- the worker to stop (`Turkey.Workers`), added and taken away by the
-- collecting worker; its bit 1 is GC stress, which sends every poll here so
-- that stress collects at polls as at allocations, and is the running
-- worker's own.
fun pollWordSet(up : Bool) -> Unit {
	let w = Process.workerRecord()
	let raised = Ptr.atomicLoad(w, 272) & 2 != 0
	if up && !raised { let _ = Ptr.atomicAdd(w, 272, 2) }
	if !up && raised { let _ = Ptr.atomicAdd(w, 272, -2) }
}

fun stopAsked() -> Bool = Ptr.atomicLoad(Process.workerRecord(), 272) & 1 != 0

-- A loop's poll, called when the worker's poll word is up, as at any call.
-- Not while the worker is blocked or stopped: the loop is then one of
-- `Turkey.Workers`' own, waiting on the protocol a stop would re-enter.
foreign "turkey_poll" fun poll() -> Unit {
	if !Workers.running() { return }
	if stopAsked() { stopAt(Prim.frameAddress()) }
	if stress {
		-- A loop can poll once per byte it copies, so only one poll in
		-- `pollStressEvery` counts as an allocation does towards stress's
		-- next collection.
		pollCountdown = pollCountdown - 1
		if pollCountdown <= 0 {
			pollCountdown = pollStressEvery
			if stressDue() { collectFrom(Prim.frameAddress(), Due) }
		}
	}
}

let pollStressEvery : Int = 257
var pollCountdown : Int = 1

-- Whether GC stress collects at this allocation.
fun stressDue() -> Bool {
	stressCountdown = stressCountdown - 1
	if stressCountdown > 0 { return False }
	stressCountdown = if stressInterval == 1 {
		1
	} else {
		-- xorshift64*: a full period over the nonzero words, which is all a
		-- sampling interval needs of it.
		var mixed = stressRandom
		mixed = mixed ^ shiftRight(mixed, 12)
		mixed = mixed ^ mixed << 25
		mixed = mixed ^ shiftRight(mixed, 27)
		stressRandom = mixed
		let drawn = shiftRight(Int.mulWrapping(mixed, 0x2545_F491_4F6C_DD1D), 1)
		1 + drawn % (2 * stressInterval - 1)
	}
	True
}

-- A fresh slot for an object of `size` bytes and of `kind`, recorded in the
-- size table and the statistics where they are kept.
fun taken(object : Ptr, size : Int, kind : Int) -> Ptr {
	if sizesKept {
		let region = regionOf(object)
		Ptr.store(Ptr.load(region, regionSizes), Ptr.diff(object, region), size)
	}
	if statsWanted {
		let _ = Ptr.atomicAdd(statsCounts, statsAllocationsAt, 1)
		let _ = Ptr.atomicAdd(statsCounts, statsBytesAt, size)
		let at = if kind >= 0 && kind < 8 { times8(kind) } else { 0 }
		let _ = Ptr.atomicAdd(statsByKind, at, 1)
	}
	object
}

-- -- roots ------------------------------------------------------------------------------

-- Push `pointer`, a `RootFrame` the caller owns, onto the shadow stack.
--
-- Nothing is live at registration: the frame is entered on the way into the
-- region that contains the safepoints, and each safepoint stores its own live
-- set. A caller with roots that outlive the call stores the mask itself right
-- after this returns.
foreign "turkey_root_enter" fun rootEnter(
	pointer : Ptr,
	values : Ptr,
	count : Int,
	functionName : Ptr,
) -> Unit {
	if Ptr.isNull(pointer) || Ptr.isNull(values) || count < 0 {
		Process.panic(Prim.cString("invalid root frame size"))
		return
	}
	Ptr.store(pointer, 0, roots)
	Ptr.store(pointer, 8, functionName)
	Ptr.store(pointer, frameCount, count)
	Ptr.store(pointer, frameValues, values)
	Ptr.store(pointer, frameLive, 0)
	roots = pointer
}

foreign "turkey_root_leave" fun rootLeave(pointer : Ptr) -> Unit {
	if Ptr.isNull(pointer) || roots != pointer {
		Process.panic(Prim.cString("unbalanced root frame"))
		return
	}
	roots = Ptr.load(pointer, 0)
}

-- The innermost root frame, for the crash report in `Turkey.Entry`, which
-- walks the chain by its first word and reads each function name. Null before
-- initialization, since a global's storage starts zeroed.
foreign "turkey_roots_head" fun rootsHead() -> Ptr = roots

-- -- frame tables -----------------------------------------------------------------------
--
-- The arm64 backend registers roots OCaml's way: no function pushes or pops
-- anything, and each call site that may collect has a table entry naming the
-- frame offsets of the roots live across it, keyed by the return address for
-- it. The collector walks `x29` frame records and looks each return address
-- up.
--
-- Only Turkey's frame records are walked, never C's. The walk starts from the
-- frame of the Turkey allocator that called into the heap, which passes its
-- own `x29` in, and ends at the generated entry's frame. Every frame between is
-- Turkey's, because no C function on the mutator's stack calls back into
-- Turkey code that can allocate, and the backend emits a frame record in every
-- function. A C frame keeps one only if its compiler chose to, and a walk that
-- crossed one would lose the Turkey caller's return address and with it that
-- caller's roots.
--
-- A frame whose return address is in no table has no roots, and is skipped. A
-- binary that registers no table walks no frames.
--
-- Wasm keys the same table on a site's number instead of a return address,
-- and the walk is of shadow frames (`scanShadow`).

-- -- static objects -----------------------------------------------------------------
--
-- A static object is laid out as the allocator lays out a heap object, but the
-- linker places it, in the program's data, between `start` and `end`. The
-- collector never marks, frees or traces one: it holds only immediates and
-- other static objects, so nothing reachable only through it needs keeping.
-- Its generation is `old`, so the write barrier never remembers an object for
-- holding one.
--
-- The range is registered at run time rather than named as a linker symbol
-- here, because this module is compiled by every compiler, the committed
-- bootstrap among them, and a binary whose emitter predates static objects
-- must still link. Such a binary never registers, and its range stays empty.
-- The entry sequence registers before any code that can hold a static object
-- runs.
foreign "turkey_static_register" fun staticRegister(start : Ptr, end : Ptr) -> Unit {
	staticStart = Ptr.toInt(start)
	staticBytes = Int.subWrapping(Ptr.toInt(end), staticStart)
}

-- Whether `value` is a static object. One unsigned comparison, which touches
-- no memory but this module's two words.
fun isStatic(value : Ptr) -> Bool =
	below(Int.subWrapping(Ptr.toInt(value), staticStart), staticBytes)

-- The emitter writes a flat array of four-byte fields -- count, then per
-- entry its return address's distance from `base`, n, and n offsets -- in
-- ascending order of return address. The distances keep the table free of
-- relocations, so it is read-only and the loader never writes it. Adding
-- `base` back here, into entries of a fixed size, is what makes the lookup a
-- binary search on the address itself.
foreign "turkey_frame_table_set" fun frameTableSet(table : Ptr, base : Ptr) -> Unit {
	if Ptr.isNull(table) { return }
	let count = Ptr.load32(table, 0)
	if count <= 0 { return }
	let entries = Os.malloc(entryBytes * count)
	if Ptr.isNull(entries) {
		Process.panic(Prim.cString("out of memory"))
		return
	}
	var p = Ptr.add(table, 4)
	var sorted = True
	var previous = 0
	for var i = 0; i < count; i = i + 1 {
		let n = Ptr.load32(p, 4)
		let key = plus(Ptr.toInt(base), signed32(Ptr.load32(p, 0)))
		-- Every emitter writes its entries ascending: the native ones in the
		-- order the code is placed, the wasm one by site. Checking costs one
		-- comparison per entry, where sorting costs n log n over tens of
		-- thousands of entries at every start. The sort below stays for a
		-- table that is not ascending, which a compiler older than this
		-- runtime writes natively.
		if i > 0 && below(key, previous) { sorted = False }
		previous = key
		Ptr.store(entries, entryBytes * i, key)
		Ptr.store(entries, entryBytes * i + 8, n)
		Ptr.store(entries, entryBytes * i + 16, Ptr.add(p, 8))
		p = Ptr.add(p, 8 + 4 * n)
	}
	if !sorted {
		-- Under `--gc-verify` we assume the table's emitter is as new as this
		-- runtime, so a table out of order is that emitter's mistake, and one
		-- the sort would hide. Read `Prim.gcVerify`, the constant itself,
		-- because this runs before the program's globals are initialized.
		--
		-- End the process as the heap verifier does, rather than raise a
		-- panic: the entry tests for one only after early initialization, so
		-- the globals' initializer and `main` would run with it pending and
		-- read globals it left unset.
		if Prim.gcVerify {
			let message = Prim.cString("heap verifier: the frame table is not in ascending order\n")
			let _ = Os.write(2, message, Os.strlen(message))
			Os.exit(1)
		}
		sortEntries(entries, count)
	}
	Os.free(frameEntries)
	frameEntries = entries
	frameEntryCount = count
}

-- The offset from its frame of root `i` of an entry, whose offsets are at
-- `offsets`.
fun rootOffset(offsets : Ptr, i : Int) -> Int = signed32(Ptr.load32(offsets, i << 2))

-- The low 32 bits of `n`, as a signed integer.
fun signed32(n : Int) -> Int = (n << 32) >> 32

fun entryKey(entries : Ptr, i : Int) -> Int =
	Ptr.load(entries, Int.mulWrapping(entryBytes, i))

fun swapEntries(entries : Ptr, i : Int, j : Int) -> Unit {
	for var w = 0; w < entryBytes; w = w + 8 {
		let a : Int = Ptr.load(entries, entryBytes * i + w)
		Ptr.store(entries, entryBytes * i + w, Ptr.load(entries, entryBytes * j + w) : Int)
		Ptr.store(entries, entryBytes * j + w, a)
	}
}

-- Heapsort, by return address: in place, without recursion, and n log n at
-- worst, which is everything a sort here needs to be.
fun sortEntries(entries : Ptr, count : Int) -> Unit {
	var start = count / 2
	while start > 0 {
		start = start - 1
		siftDown(entries, start, count)
	}
	var end = count
	while end > 1 {
		end = end - 1
		swapEntries(entries, 0, end)
		siftDown(entries, 0, end)
	}
}

fun siftDown(entries : Ptr, first : Int, count : Int) -> Unit {
	var root = first
	while 2 * root + 1 < count {
		var child = 2 * root + 1
		if child + 1 < count && below(entryKey(entries, child), entryKey(entries, child + 1)) {
			child = child + 1
		}
		if !below(entryKey(entries, root), entryKey(entries, child)) { return }
		swapEntries(entries, root, child)
		root = child
	}
}

fun frameEntryFor(retaddr : Int) -> Ptr {
	var low = 0
	var high = frameEntryCount - 1
	while low <= high {
		let middle = plus(low, high) >> 1
		let found = entryKey(frameEntries, middle)
		if found == retaddr {
			return Ptr.add(frameEntries, Int.mulWrapping(entryBytes, middle))
		}
		if below(found, retaddr) {
			low = plus(middle, 1)
		} else {
			high = Int.subWrapping(middle, 1)
		}
	}
	Ptr.null()
}

-- Every Turkey frame of every stack, as a marking task per stack
-- (`taskStack`): the running one from `frame` outwards, and each other from
-- the frame it was parked at.
--
-- `frame` is the `x29` of the Turkey allocator that called into the heap: a
-- frame record whose return address is in the allocation site, so the first
-- entry found is the allocating function's. Null means the collecting thread
-- has no live Turkey frame, and its running stack is not walked.
--
-- The other stacks are walked either way. The final collection runs from C
-- after the program's own code has returned, so it passes null, but the
-- worker threads are still running: one may be parked at a safepoint or
-- waiting for a lock, holding an object only its frames reach, and it goes on
-- using that object once the world starts again. Freeing the object there is
-- a use after free, and a fault where the C library has returned the region
-- to the system.
fun stackTasks(frame : Ptr) -> Unit {
	if frameEntryCount == 0 { return }
	-- Skipped below even with a null `frame`: the running stack's record may
	-- describe a stack that is gone. The thread that ran the program's own
	-- code exits when that code returns, and the main thread then collects
	-- with the same worker record.
	let running = Stack.running()
	if !Ptr.isNull(frame) {
		if Ptr.isNull(running) {
			-- Reachable only if something ran the program's code without the
			-- generated entry. Scanning from an unknown outer bound is how a
			-- walk runs off the end; not scanning drops live roots silently,
			-- which is worse. So say so instead of doing either.
			Process.panic(Prim.cString("no entry stack bound: the frame walker cannot run"))
			return
		}
		addTask(taskStack, frame, Stack.high(running))
	}
	var stack = Stack.first()
	while !Ptr.isNull(stack) {
		let parked = Stack.parked(stack)
		if stack != running && !Ptr.isNull(parked) {
			addTask(taskStack, parked, Stack.high(stack))
		}
		stack = Stack.next(stack)
	}
}

-- Every stack `stackTasks` makes a task of, walked here and now in `mode`.
fun walkStacks(frame : Ptr, mode : Int) -> Unit {
	if frameEntryCount == 0 { return }
	let running = Stack.running()
	if !Ptr.isNull(frame) && !Ptr.isNull(running) { walkStack(frame, Stack.high(running), mode) }
	var stack = Stack.first()
	while !Ptr.isNull(stack) {
		let parked = Stack.parked(stack)
		if stack != running && !Ptr.isNull(parked) { walkStack(parked, Stack.high(stack), mode) }
		stack = Stack.next(stack)
	}
}

-- One stack's frames, from the record at `frame` out to `high`.
--
-- The stop conditions matter more than the loop: a walk that runs off the end
-- of the chain marks whatever the words beyond it happen to hold, which would
-- surface as a corruption a long way from here and look exactly like a
-- miscompile. So the frame pointer must stay below `high`, stay 8-byte
-- aligned, and strictly increase. There is no low bound to check: the walk
-- starts at a live frame and only ever moves outwards.
fun scanStack(frame : Ptr, high : Ptr) -> Unit = walkStack(frame, high, walkMark)

-- What `walkStack` does with each root it finds: marks it, pins its region
-- (`flagPinned`), or rewrites the slot to the root's new address
-- (`forwarded`).
let walkMark : Int = 0
let walkPin : Int = 1
let walkRewrite : Int = 2

fun walkStack(frame : Ptr, high : Ptr, mode : Int) -> Unit {
	if let Wasi = Target.os { return scanShadow(frame, high) }
	let top = Ptr.toInt(high)
	var here = Ptr.toInt(frame)
	while !below(top, here + 16) && here & 7 == 0 {
		-- The return address in *this* record is an address in the *caller*,
		-- so the entry it finds describes the caller's frame -- whose `x29` is
		-- this record's saved one. Applying the offsets to this frame instead
		-- reads whatever the callee happens to have at those offsets.
		let record = Ptr.fromInt(here)
		let next : Int = Ptr.load(record, 0)
		if !below(here, next) || below(top, next + 16) || next & 7 != 0 {
			return
		}
		let entry = frameEntryFor(Ptr.load(record, 8))
		if !Ptr.isNull(entry) {
			let count : Int = Ptr.load(entry, 8)
			let offsets : Ptr = Ptr.load(entry, 16)
			let caller = Ptr.fromInt(next)
			for var i = 0; i < count; i = plus(i, 1) {
				let value : Ptr = Ptr.load(caller, rootOffset(offsets, i))
				-- An object the compiler placed in a frame (`Turkey.Escape`):
				-- a callee's rooted parameter, or one such object's field
				-- naming another. It is not a heap object and has no mark bit;
				-- its own frame lists its fields, which is how what it holds
				-- is traced. Such an object never leaves the function that
				-- placed it, so it is in this stack's own range: only a frame
				-- slot can hold one, since nothing in the heap ever points
				-- into a stack, and a stack never points into another's.
				let at = Ptr.toInt(value)
				if below(at, Ptr.toInt(frame)) || !below(at, top) {
					if mode == walkMark {
						markGrey(value, Prim.cString("arm64 frame"), i)
					} else if mode == walkPin {
						pin(value)
					} else {
						Ptr.store(caller, rootOffset(offsets, i), forwarded(value))
					}
				}
			}
		}
		here = next
	}
}

-- One stack's shadow frames, on wasm, from the frame at `frame` out to
-- `high`.
--
-- Wasm code cannot read its own stack, so a function that holds roots keeps
-- them in a frame in linear memory (`Turkey.Wasm.Select`), and `frame` is the
-- shadow stack pointer, the innermost one. A frame's first word is the address
-- past it, the next frame out or the stack's top, and its second the site it
-- is stopped at. Unlike a frame record, a frame names its own site, and the
-- entry for the site gives the frame's own roots, as offsets from the frame.
-- The bounds are the native walk's: below `high`, 8-byte aligned, and
-- strictly increasing.
fun scanShadow(frame : Ptr, high : Ptr) -> Unit {
	let top = Ptr.toInt(high)
	var here = Ptr.toInt(frame)
	while !below(top, here + 16) && here & 7 == 0 {
		let record = Ptr.fromInt(here)
		let entry = frameEntryFor(Ptr.load(record, 8))
		if !Ptr.isNull(entry) {
			let count : Int = Ptr.load(entry, 8)
			let offsets : Ptr = Ptr.load(entry, 16)
			for var i = 0; i < count; i = plus(i, 1) {
				let value : Ptr = Ptr.load(record, rootOffset(offsets, i))
				-- A frame object of a frame further out, as on arm64.
				let at = Ptr.toInt(value)
				if below(at, Ptr.toInt(frame)) || !below(at, top) {
					markGrey(value, Prim.cString("wasm frame"), i)
				}
			}
		}
		let next : Int = Ptr.load(record, 0)
		if !below(here, next) { return }
		here = next
	}
}

-- -- marking ----------------------------------------------------------------------------
--
-- An object is marked when it is first pushed, in its region's mark bitmap:
-- an edge to an object already marked -- most edges, in a heap of shared
-- names and types -- then reads the region's header, which a few thousand
-- objects share and which stays in cache, and not the object's own. The
-- bitmap is the only record of a mark: no object header has one.
--
-- `drain` is the whole of the tracing loop, decoding and pushing in line: the
-- inliner does not copy a body this size, and a call per edge was most of what
-- marking cost.

-- Each size class's slot size as a multiplier: 2^32 / slot, rounded up, and
-- 0 for a large region, whose one slot is at offset 0. A slot's offset times
-- it, over 2^32, is the slot's index, exactly: the offset is a multiple of the
-- slot size below 2^16, so the rounding adds less than 2^16 / 2^32 to a whole
-- number. Set by `newRegion` for each class it makes a region of, which is
-- before anything in the class can be marked.
var reciprocals : Ptr = zeroed(8 * (regionClasses + 1))

-- Whether a traced word names no object: null, or one of the small integers
-- below `immediates`.
fun immediate(value : Ptr) -> Bool = below(Ptr.toInt(value), immediates)

-- Mark `value`, a root found as `what` `index`, if it is an object and not
-- yet marked, and push it on the running worker's stack. `what` null means a
-- root the caller cannot name.
fun markGrey(value : Ptr, what : Ptr, index : Int) -> Unit {
	if immediate(value) || isStatic(value) { return }
	-- Exact roots and object descriptors make the header O(1) to find in normal
	-- execution. GC stress checks membership, and it earns the cost: a pointer
	-- that is not in the heap means a root was missed or a descriptor is
	-- wrong, and this turns that from a rare corruption into a panic on the
	-- first collection.
	if stress && Ptr.isNull(findObject(value)) {
		notHeapPointer(value, what, index)
		return
	}
	let region = regionOf(value)
	let slot = slotOf(region, value)
	let at = plus(regionMarked, times8(slot >> 6))
	-- Most roots are marked already, by the time a collection's later tasks
	-- reach them.
	if Ptr.load(region, at) & bit(slot) != 0 { return }
	if !claim(region, at, bit(slot), value, sharing) { return }
	push(value)
}

-- Set `mask` in the mark word at `at` of `region`, and with it the
-- generation of `object` and the region's live count: False if it was set
-- already. With other workers marking (`shared`), the bit is claimed by
-- compare-and-swap and the count added to atomically, since the word holds
-- 64 objects' marks and another worker may be setting one of the others; the
-- header is the winner's alone.
fun claim(region : Ptr, at : Int, mask : Int, object : Ptr, shared : Bool) -> Bool {
	while True {
		let marks : Int = Ptr.load(region, at)
		if marks & mask != 0 { return False }
		if !shared {
			Ptr.store(region, at, marks | mask)
			Ptr.store32(region, regionLive, plus(Ptr.load32(region, regionLive), 1))
			break
		}
		if Ptr.atomicCas(region, at, marks, marks | mask) == marks {
			-- The count is the low half of the word at `regionLive`, and
			-- never carries into the high half: a region has at most 4096
			-- slots.
			let _ = Ptr.atomicAdd(region, regionLive, 1)
			break
		}
	}
	promote(object)
	True
}

-- Make `object` old. A byte store, so that the rest of the header, which
-- nothing else writes once the object is built, is not written at all.
fun promote(object : Ptr) -> Unit =
	Ptr.store(object, headerGeneration, Byte.truncate(old))

-- Push `entry` on the running worker's mark stack.
fun push(entry : Ptr) -> Unit {
	let m = marker()
	let count : Int = Ptr.load(m, 8)
	if count == Ptr.load(m, 16) && !growMarkStack(m) { return }
	Ptr.store(Ptr.load(m, 0), times8(count), entry)
	Ptr.store(m, 8, plus(count, 1))
}

-- The running worker's mark stack.
fun marker() -> Ptr = Ptr.add(markers, markerBytes * Workers.index())

-- The index of the slot of `object`, in `region`.
fun slotOf(region : Ptr, object : Ptr) -> Int {
	let offset = Int.subWrapping(Ptr.diff(object, region), regionData)
	let multiplier : Int = Ptr.load(reciprocals, times8(Ptr.load32(region, regionSizeClass)))
	Int.mulWrapping(offset, multiplier) >> 32
}

-- Double the mark stack `m`; False, with the mark failed, if there is no
-- memory.
fun growMarkStack(m : Ptr) -> Bool {
	let capacity : Int = Ptr.load(m, 16)
	let grown = if capacity < 64 { 64 } else { capacity * 2 }
	let stack = Os.realloc(Ptr.load(m, 0), 8 * grown)
	if Ptr.isNull(stack) {
		markFailed(Prim.cString("out of memory"))
		return False
	}
	Ptr.store(m, 0, stack)
	Ptr.store(m, 16, grown)
	True
}

-- The write barrier's slow path: `parent` has just been given a young object,
-- and is remembered if it is old and not remembered already. Generated code
-- calls it only then, after testing both inline; the test here is for C.
-- Called between a store and the next instruction, so it must not allocate,
-- collect or panic in any way the caller could miss: it is not a safepoint,
-- and nothing checks the panic flag after it.
--
-- Stores the compiler cannot see -- raw stores of a managed pointer into a
-- managed object, from Turkey or C -- must call it too, unless the object was
-- allocated after the value they store.
foreign "turkey_write_barrier" fun writeBarrier(parent : Ptr) -> Unit {
	-- Claimed by changing the generation, atomically: two workers storing
	-- into one old object at once must not both remember it. The swap is of
	-- the whole header, whose other bytes nothing changes once the object is
	-- built, and it writes them back as they were.
	let header : Int = Ptr.load(parent, 0)
	if header & 255 != old { return }
	let remembered = header & complement(255) | rememberedOld
	if Ptr.atomicCas(parent, 0, header, remembered) != header { return }
	remember(parent)
	let _ = Ptr.atomicAdd(statsCounts, statsRememberedAt, 1)
}

-- Add `parent` to the running worker's remembered set.
fun remember(parent : Ptr) -> Unit {
	let count = rememberedCount()
	if count == rememberedCapacity() {
		let capacity = if count < 64 { 64 } else { count * 2 }
		let grown = Os.realloc(remembered(), 8 * capacity)
		if Ptr.isNull(grown) {
			Process.panic(Prim.cString("out of memory"))
			return
		}
		rememberedSet(grown)
		rememberedCapacitySet(capacity)
	}
	Ptr.store(remembered(), times8(count), parent)
	rememberedCountSet(plus(count, 1))
}

-- Trace everything reachable from the running worker's mark stack, emptying
-- it. This is the one place the collector decodes an object's layout.
--
-- An object's descriptor counts the traced words its fields start with. An
-- array's counts the traced words each element starts with, and its tag is
-- the elements' stride: the collector follows that many words at every
-- stride, and none in an array whose count is 0, though its elements may be
-- pointer-sized words such as raw addresses.
--
-- An entry is an object, or the next chunk of one too large to scan at once:
-- its address with the chunk's number, from 1, in the top bits, which no
-- user-space address on arm64 has set; below `chunkLimit`, so that the entry
-- stays positive. Scanning `chunkSlots` elements at a time, or words of an
-- object that is not an array, lets another worker take the rest of a large
-- one.
--
-- With other workers marking, every `shareEvery` entries this one gives a
-- packet of its stack away if one of them is waiting for work.
fun drain() -> Unit {
	let m = marker()
	var stack : Ptr = Ptr.load(m, 0)
	var capacity : Int = Ptr.load(m, 16)
	var top : Int = Ptr.load(m, 8)
	let shared = sharing
	-- `isStatic`'s range, read once rather than once per field.
	let staticFrom = staticStart
	let staticSize = staticBytes
	var countdown = shareEvery
	while top > 0 {
		if shared {
			countdown = Int.subWrapping(countdown, 1)
			if countdown == 0 {
				countdown = shareEvery
				if top > packetEntries && Ptr.atomicLoad(marking, idleAt) > 0 {
					top = share(stack, top)
				}
			}
		}
		top = Int.subWrapping(top, 1)
		let entry = Ptr.toInt(Ptr.load(stack, times8(top)))
		let chunk = entry >> 48
		let object = Ptr.fromInt(if chunk == 0 { entry } else { entry & addressBits })
		-- Where its pointers are: `runs` runs of `per` words, one every
		-- `stride` bytes from `first`. Any object but an array is runs of
		-- one word each, and a cell's flag is the count of its one word.
		let header = Ptr.load32(object, 0)
		let kind = header >> 8 & 255
		var first = objectFields
		var runs = header >> 16
		var per = 1
		var stride = 8
		if kind == arrayKind {
			first = arrayElements
			per = runs
			stride = Ptr.load32(object, 4)
			runs = if per > 0 { Ptr.load(object, arrayLength) } else { 0 }
		}
		var field = 0
		var end = runs
		if runs > chunkSlots {
			field = Int.mulWrapping(chunk, chunkSlots)
			end = if Int.subWrapping(runs, field) > chunkSlots && chunk < chunkLimit {
				plus(field, chunkSlots)
			} else {
				runs
			}
		}
		if end != runs {
			if top == capacity {
				Ptr.store(m, 8, top)
				if !growMarkStack(m) {
					Ptr.store(m, 8, 0)
					return
				}
				stack = Ptr.load(m, 0)
				capacity = Ptr.load(m, 16)
			}
			let next = Ptr.toInt(object) | plus(chunk, 1) << 48
			Ptr.store(stack, times8(top), Ptr.fromInt(next))
			top = plus(top, 1)
		}
		-- `at` is the run's offset and `k` the word's within it.
		var at = plus(first, Int.mulWrapping(field, stride))
		let stop = plus(first, Int.mulWrapping(end, stride))
		var k = 0
		while at < stop {
			let child : Ptr = Ptr.load(object, plus(at, times8(k)))
			if immediate(child) {} else if below(
				Int.subWrapping(Ptr.toInt(child), staticFrom),
				staticSize,
			) {} else if stress && Ptr.isNull(findObject(child)) {
				notHeapPointer(
					child,
					fieldName(kind),
					plus(Int.mulWrapping(Int.subWrapping(at, first) / stride, per), k),
				)
			} else {
				let childRegion = regionOf(child)
				let childSlot = slotOf(childRegion, child)
				let at = plus(regionMarked, times8(childSlot >> 6))
				let marks : Int = Ptr.load(childRegion, at)
				let mask = bit(childSlot)
				-- In line when this worker marks alone: a call per object
				-- marked is a large share of what marking costs.
				if marks & mask == 0 {
					let won = if shared {
						claim(childRegion, at, mask, child, True)
					} else {
						Ptr.store(childRegion, at, marks | mask)
						Ptr.store32(
							childRegion,
							regionLive,
							plus(Ptr.load32(childRegion, regionLive), 1),
						)
						promote(child)
						True
					}
					if won {
						if top == capacity {
							Ptr.store(m, 8, top)
							if !growMarkStack(m) {
								Ptr.store(m, 8, 0)
								return
							}
							stack = Ptr.load(m, 0)
							capacity = Ptr.load(m, 16)
						}
						Ptr.store(stack, times8(top), child)
						top = plus(top, 1)
					}
				}
			}
			k = plus(k, 1)
			if k == per {
				k = 0
				at = plus(at, stride)
			}
		}
	}
	Ptr.store(m, 8, 0)
}

-- The bits of an entry that are an address (`drain`).
let addressBits : Int = 0xFFFF_FFFF_FFFF

-- The slots scanned at once of one object: 8 KB of pointers. An object of
-- more than `chunkLimit` chunks has its last one scanned whole.
let chunkSlots : Int = 1024
let chunkLimit : Int = 0x7FFF

-- -- marking in parallel ----------------------------------------------------------------
--
-- A collection marks with every worker stopped at a safepoint helping it: they
-- are waiting for it anyway (`stopAt`). A worker held while blocked does not
-- help, since it is waiting on something else. A worker held while it waits
-- for work (`pause`) helps a mark big enough to repay waking it
-- (`pausedHelpFloor`).
--
-- The roots are tasks, which the markers claim one at a time: each stack, each
-- frame of the root chain, and runs of the remembered set. There are many more
-- tasks than markers, so a marker that draws a small one takes another.
--
-- What a root reaches is balanced as it is traced: a marker with work gives a
-- packet of its stack to the pool whenever another is waiting for some
-- (`drain`), and a marker with none takes one. Packets rather than stealing
-- from each other's stacks: a lock taken once a packet costs nothing next to
-- the packet's work, and the stacks stay plain arrays their owner pushes
-- without synchronizing.
--
-- The mark is over when every marker is idle -- its own stack empty, and the
-- pool too -- which a count of idle markers, changed under the pool's lock,
-- says.

let packetEntries : Int = 512
let shareEvery : Int = 64

-- The fewest bytes a mark may trace -- the young generation's for a minor
-- collection, the heap's for a full one -- for it to ask the workers asleep
-- in `pause` to help. Each one asked is woken from the kernel, marks, sleeps
-- again until the collection ends, is woken again, and goes back to the
-- scheduler's queue, whose lock every one of them then takes to find nothing
-- to do. On an M-series Mac with eleven idle workers that is about 50 us of
-- wall time and 200 us of system time per collection, against a few
-- microseconds of marking for a young generation of a few hundred kilobytes:
-- a program with one task ran six times slower than with one worker.
-- The compiler's own collections, of tens of megabytes, are faster with
-- them, and stay above this.
let pausedHelpFloor : Int = 4194304

-- Whether other workers are marking with this one: claims of a mark are
-- atomic then. Set before they are asked to help and cleared after they have
-- all finished.
var sharing : Bool = False
-- How many workers mark this collection.
var participants : Int = 1

-- Words of the mark's state: how many markers are idle, whether the mark is
-- over, how many packets the pool holds, the next task to claim, whether the
-- mark failed, and an epoch idle markers sleep on with how many do: bumped
-- when a packet is put in the pool and when the mark is over (`markSignal`).
var marking : Ptr = zeroed(56)
let idleAt : Int = 0
let doneAt : Int = 8
let packetsAt : Int = 16
let nextTaskAt : Int = 24
let failedAt : Int = 32
let epochAt : Int = 40
let sleepersAt : Int = 48
-- What `markFailed` was told, once it has been.
var failure : Ptr = Ptr.null()

-- Each worker's word saying the collection wants it to mark, by index,
-- cleared by the worker once it has finished; and each's saying it is
-- waiting in `pause`, where it would see that.
var helping : Ptr = zeroed(8 * Workers.threadLimit())
var pausing : Ptr = zeroed(8 * Workers.threadLimit())

-- The pool: full packets, and empty ones kept for reuse, each a list through
-- its packet's first word. A packet is that word, a count, and its entries.
var poolLock : Ptr = Lock.new()
var poolFull : Ptr = Ptr.null()
var poolEmpty : Ptr = Ptr.null()

-- The tasks: three words each, the kind and two operands.
let taskChain : Int = 0
let taskStack : Int = 1
let taskRemembered : Int = 2
-- Rewrite the regions in an array of them, from one address to another.
let taskRewrite : Int = 3
var tasks : Ptr = Ptr.null()
var taskCount : Int = 0
var taskCapacity : Int = 0

-- The runs the remembered set is split into.
let rememberedRun : Int = 1024

-- Mark everything reachable, with the running worker's stack walked from
-- `frame`: by this worker and every other stopped at a safepoint.
fun markFrom(frame : Ptr) -> Unit {
	Ptr.atomicStore(marking, failedAt, 0)
	taskCount = 0
	var root = roots
	while !Ptr.isNull(root) {
		addTask(taskChain, root, Ptr.null())
		root = Ptr.load(root, 0)
	}
	-- By address: the set is the collecting worker's (`retire`), and the
	-- record a marker reaches through `remembered` is its own.
	if minor {
		let count = rememberedCount()
		for var i = 0; i < count; i = plus(i, rememberedRun) {
			let end = if count - i < rememberedRun { count } else { plus(i, rememberedRun) }
			addTask(
				taskRemembered,
				Ptr.add(remembered(), times8(i)),
				Ptr.add(remembered(), times8(end)),
			)
		}
	}
	stackTasks(frame)
	runTasks(if minor { bytesSince } else { plus(liveBytes, bytesSince) })
	if minor { rememberedCountSet(0) }
	if Ptr.atomicLoad(marking, failedAt) != 0 { Process.panic(failure) }
}

-- Run the tasks, with every worker stopped at a safepoint and, if `traced`
-- bytes are enough to repay waking them, every paused one.
fun runTasks(traced : Int) -> Unit {
	Ptr.atomicStore(marking, nextTaskAt, 0)
	let me = Workers.index()
	let n = Workers.count()
	-- Under GC stress every collection asks, so that the stressed runs, whose
	-- heaps are small, still mark with the paused workers.
	let paused = stress || traced >= pausedHelpFloor
	participants = 1
	for var i = 0; i < n; i = plus(i, 1) {
		if i != me && canHelp(i, paused) { participants = plus(participants, 1) }
	}
	sharing = participants > 1
	if sharing {
		Ptr.atomicStore(marking, idleAt, 0)
		Ptr.atomicStore(marking, doneAt, 0)
		for var i = 0; i < n; i = plus(i, 1) {
			if i != me && canHelp(i, paused) { Ptr.atomicStore(helping, times8(i), 1) }
		}
		-- The stopped ones sleep on the collection epoch, and the paused ones
		-- may still be asleep on the work epoch.
		Workers.signalCollection()
		if paused { Workers.signalWork(True) }
	}
	mark()
	if sharing {
		for var i = 0; i < n; i = plus(i, 1) {
			while Ptr.atomicLoad(helping, times8(i)) != 0 { let _ = Os.schedYield() }
		}
		sharing = False
	}
}

-- Whether worker `i`, with the world stopped, is to be asked to mark: it is
-- stopped at a safepoint, or, if `paused`, held in `pause`.
fun canHelp(i : Int, paused : Bool) -> Bool =
	Workers.stopped(i) || (paused && Ptr.atomicLoad(pausing, times8(i)) != 0)

fun addTask(kind : Int, a : Ptr, b : Ptr) -> Unit {
	if taskCount == taskCapacity {
		let capacity = if taskCapacity < 64 { 64 } else { taskCapacity * 2 }
		let grown = Os.realloc(tasks, 24 * capacity)
		if Ptr.isNull(grown) {
			markFailed(Prim.cString("out of memory"))
			return
		}
		tasks = grown
		taskCapacity = capacity
	}
	let at = 24 * taskCount
	Ptr.store(tasks, at, kind)
	Ptr.store(tasks, plus(at, 8), a)
	Ptr.store(tasks, plus(at, 16), b)
	taskCount = plus(taskCount, 1)
}

-- A marker's part: tasks until there are none to claim, then what they reach,
-- until the mark is over.
fun mark() -> Unit {
	while True {
		let i = Ptr.atomicAdd(marking, nextTaskAt, 1)
		if i >= taskCount { break }
		run(i)
		drain()
	}
	if !sharing { return }
	while take() || waitForWork() { drain() }
}

fun run(task : Int) -> Unit {
	let at = 24 * task
	let kind : Int = Ptr.load(tasks, at)
	let a : Ptr = Ptr.load(tasks, plus(at, 8))
	let b : Ptr = Ptr.load(tasks, plus(at, 16))
	if kind == taskChain {
		let count : Int = Ptr.load(a, frameCount)
		let live : Int = Ptr.load(a, frameLive)
		let values : Ptr = Ptr.load(a, frameValues)
		let name : Ptr = Ptr.load(a, 8)
		for var i = 0; i < count; i = plus(i, 1) {
			if i >= 64 || live >> i & 1 != 0 {
				markGrey(Ptr.load(values, times8(i)), name, i)
			}
		}
	} else if kind == taskStack {
		scanStack(a, b)
	} else if kind == taskRewrite {
		for var at = Ptr.toInt(a); at < Ptr.toInt(b); at = plus(at, 8) {
			rewriteRegion(Ptr.load(Ptr.fromInt(at), 0))
		}
	} else {
		-- A minor collection's other roots: the fields of each remembered
		-- object, which is marked already, being old. Each is old and not
		-- remembered after.
		for var at = Ptr.toInt(a); at < Ptr.toInt(b); at = plus(at, 8) {
			let parent : Ptr = Ptr.load(Ptr.fromInt(at), 0)
			promote(parent)
			push(parent)
		}
	}
}

-- Give the top `packetEntries` of `stack`, which holds `top`, to the pool,
-- and answer what it holds after: `top` itself if there is no memory for a
-- packet, which only means this worker keeps the work.
fun share(stack : Ptr, top : Int) -> Int {
	Lock.acquire(poolLock)
	var packet = poolEmpty
	if Ptr.isNull(packet) {
		packet = Os.malloc(16 + 8 * packetEntries)
		if Ptr.isNull(packet) {
			Lock.release(poolLock)
			return top
		}
	} else {
		poolEmpty = Ptr.load(packet, 0)
	}
	let rest = top - packetEntries
	Memory.copy(Ptr.add(packet, 16), Ptr.add(stack, times8(rest)), 8 * packetEntries)
	Ptr.store(packet, 8, packetEntries)
	Ptr.store(packet, 0, poolFull)
	poolFull = packet
	let _ = Ptr.atomicAdd(marking, packetsAt, 1)
	markSignal(False)
	Lock.release(poolLock)
	rest
}

-- Move a packet from the pool to the running worker's stack, if there is one.
fun take() -> Bool {
	if Ptr.atomicLoad(marking, packetsAt) == 0 { return False }
	Lock.acquire(poolLock)
	let packet = poolFull
	if Ptr.isNull(packet) {
		Lock.release(poolLock)
		return False
	}
	poolFull = Ptr.load(packet, 0)
	let _ = Ptr.atomicAdd(marking, packetsAt, -1)
	let m = marker()
	let count : Int = Ptr.load(packet, 8)
	while Ptr.load(m, 16) < plus(Ptr.load(m, 8), count) {
		if !growMarkStack(m) {
			Lock.release(poolLock)
			return False
		}
	}
	let top : Int = Ptr.load(m, 8)
	Memory.copy(Ptr.add(Ptr.load(m, 0), times8(top)), Ptr.add(packet, 16), 8 * count)
	Ptr.store(m, 8, plus(top, count))
	Ptr.store(packet, 0, poolEmpty)
	poolEmpty = packet
	Lock.release(poolLock)
	True
}

-- With nothing to mark: idle until a packet is put in the pool, True, or
-- every marker is idle and the mark is over, False.
fun waitForWork() -> Bool {
	Lock.acquire(poolLock)
	if !Ptr.isNull(poolFull) {
		Lock.release(poolLock)
		return True
	}
	let idle = plus(Ptr.atomicLoad(marking, idleAt), 1)
	Ptr.atomicStore(marking, idleAt, idle)
	let over = idle == participants
	if over { Ptr.atomicStore(marking, doneAt, 1) }
	Lock.release(poolLock)
	if over {
		markSignal(True)
		return False
	}
	while True {
		let epoch = Ptr.atomicLoad(marking, epochAt)
		if Ptr.atomicLoad(marking, doneAt) != 0 { return False }
		if Ptr.atomicLoad(marking, packetsAt) > 0 {
			Lock.acquire(poolLock)
			let done = Ptr.atomicLoad(marking, doneAt) != 0
			if !done { Ptr.atomicStore(marking, idleAt, Ptr.atomicLoad(marking, idleAt) - 1) }
			Lock.release(poolLock)
			return !done
		}
		-- Asleep until a packet or the end, rather than spinning: the last
		-- marker with work may be some while about it.
		let _ = Ptr.atomicAdd(marking, sleepersAt, 1)
		if Ptr.atomicLoad(marking, epochAt) == epoch { Lock.wait(Ptr.add(marking, epochAt), epoch) }
		let _ = Ptr.atomicAdd(marking, sleepersAt, -1)
	}
	False
}

-- A packet for an idle marker, or, `all`, the end of the mark: wake one, or
-- every one, if any sleeps (`waitForWork`).
fun markSignal(all : Bool) -> Unit {
	let _ = Ptr.atomicAdd(marking, epochAt, 1)
	if Ptr.atomicLoad(marking, sleepersAt) != 0 {
		if all {
			Lock.wakeAll(Ptr.add(marking, epochAt))
		} else {
			let _ = Lock.wake(Ptr.add(marking, epochAt))
		}
	}
}

-- Record that the mark cannot finish, saying `message`: the collecting worker
-- panics with it once every marker has stopped. The first failure is the
-- one reported.
fun markFailed(message : Ptr) -> Unit {
	if Ptr.atomicCas(marking, failedAt, 0, 1) == 0 { failure = message }
}

-- Sleep until there may be work, blocked, so that a collection need not wait
-- for this worker: until the work epoch is no longer `seen`, which the caller
-- read before it looked for work and found none (`Turkey.Workers.signalWork`).
--
-- A `timeout` of -1 sleeps on the epoch and answers 0. Any other waits in the
-- operating system for readiness events instead, as the worker that holds the
-- poller's claim (`Turkey.Workers.pollWait`), for the nanoseconds it gives or
-- until an event or a signal: it answers how many results there are to read,
-- or the negated `errno` if it could not wait.
--
-- A collection that holds this worker meanwhile may ask it to mark, as it asks
-- the stopped ones (`pausing` says it can), and wakes it to say so; it waits
-- for the collection to let it go either way. A worker blocked on a lock is
-- not asked, since the lock may be the collecting worker's.
foreign "turkey_worker_pause" fun pause(seen : Int, timeout : Int) -> Int {
	let me = times8(Workers.index())
	Ptr.atomicStore(pausing, me, 1)
	Workers.blockEnter(Prim.frameAddress())
	var results = 0
	if timeout == -1 {
		Workers.sleepForWork(seen)
	} else {
		results = Workers.pollWait(seen, timeout)
	}
	while True {
		let epoch = Workers.collectionSeen()
		if Workers.unblock() { break }
		if Ptr.atomicLoad(helping, me) != 0 {
			mark()
			Ptr.atomicStore(helping, me, 0)
		} else {
			Workers.sleepForCollection(epoch)
		}
	}
	Ptr.atomicStore(pausing, me, 0)
	results
}

-- At a safepoint with the running worker's stop word raised: stopped until
-- the collection is over, marking if it asks.
-- It sleeps meanwhile, woken when the collection asks it to mark and when
-- the collection ends (`Turkey.Workers.signalCollection`).
fun stopAt(frame : Ptr) -> Unit {
	Workers.stopEnter(frame)
	let me = times8(Workers.index())
	while True {
		let epoch = Workers.collectionSeen()
		if !Workers.stopWanted() { break }
		if Ptr.atomicLoad(helping, me) != 0 {
			mark()
			Ptr.atomicStore(helping, me, 0)
		} else {
			Workers.sleepForCollection(epoch)
		}
	}
	Workers.stopLeave()
}

-- What `notHeapPointer` calls a field, by the kind of object it is in.
fun fieldName(kind : Int) -> Ptr =
	if kind == cellKind {
		Ptr.null()
	} else if kind == arrayKind {
		Prim.cString("array pointer field")
	} else if kind == 0 || kind == 1 {
		Prim.cString("object pointer field")
	} else {
		Prim.cString("capture")
	}

-- "<what> <index> is not a heap pointer (0x...)", or "GC root or field is not
-- a heap pointer (0x...)" when the caller cannot name where it looked. Named,
-- because "a root is not a heap pointer" is true of one slot of one frame, and
-- a compiler emitting roots for the first time needs to know which.
fun notHeapPointer(value : Ptr, what : Ptr, index : Int) -> Unit {
	-- The first marker to find one reports it, in the one text buffer.
	if Ptr.atomicCas(marking, failedAt, 0, 1) != 0 { return }
	textLength = 0
	if Ptr.isNull(what) {
		put(Prim.cString("GC root or field"))
	} else {
		put(what)
		put(Prim.cString(" "))
		putInt(index)
	}
	put(Prim.cString(" is not a heap pointer (0x"))
	putHex(Ptr.toInt(value))
	put(Prim.cString(")"))
	Ptr.store(text, textLength, Byte.truncate(0))
	failure = text
}

-- -- collecting -------------------------------------------------------------------------

-- A collection with no Turkey frame live: the final one, after the program
-- has returned, and a C caller's. Anything else collects through `allocate`,
-- which knows where the Turkey stack starts. Always full: asked for by name,
-- it frees everything unreachable.
foreign "turkey_collect" fun collect() -> Unit = collectFrom(Ptr.null(), Full)

-- What a collection is asked to be: whatever `fullDue` says, full, or minor.
-- Minor only if minor collections are on.
type Asked = Due | Full | Minor

-- A collection, with every other worker stopped. If another worker is
-- stopping them already, it collects and this one does not.
fun collectFrom(frame : Ptr, asked : Asked) -> Unit {
	if !Workers.stopTheWorld() { return }
	collectStopped(frame, asked)
	Workers.startTheWorld()
}

fun collectStopped(frame : Ptr, asked : Asked) -> Unit {
	let begun = nanoseconds()
	retire()
	minor = generational
		&& match asked {
			Due   -> !fullDue()
			Full  -> False
			Minor -> True
		}
	if verify { verifyAt(Check.BeforeMarking, frame) }
	let liveBefore = heapCount
	-- Read before the sweep clears it: the allocation pressure this
	-- collection is responding to.
	let allocsSince = allocationsSince
	let wanted = statsWanted
	let started = nanoseconds()
	if !minor {
		-- Everything is traced again, and every live object marked again,
		-- which makes it old and forgets that it was remembered.
		clearMarks()
		rememberedCountSet(0)
	}
	markFrom(frame)
	if Process.pending() { return }
	let marked = nanoseconds()
	if verify { verifyAt(Check.BeforeSweeping, frame) }
	-- What the heap held before the sweep: what the last sweep kept, and
	-- what has been allocated since.
	let held = plus(liveBytes, bytesSince)
	let allocated = bytesSince
	let regionsBefore = regionBytesInUse
	let sweeping = nanoseconds()
	sweep()
	let swept = nanoseconds()
	if verify { verifyAt(Check.AfterSweeping, frame) }
	if !minor && evacuating && onlyGlobals() {
		evacuate(frame)
		if Process.pending() { return }
		if verify { verifyAt(Check.AfterSweeping, frame) }
	}
	allocationsSince = 0
	bytesSince = 0
	if !minor { liveBytesAfterFull = liveBytes }
	let sampled = match asked {
		Due -> True
		_   -> False
	}
	schedule(sampled, started, marked - started, swept - sweeping, allocated, held - liveBytes)
	if timeLog {
		textLength = 0
		put(if minor { Prim.cString("[time] minor") } else { Prim.cString("[time] full") })
		put(Prim.cString(" gc "))
		putInt(collections)
		put(Prim.cString(" held "))
		putInt(regionsBefore)
		put(Prim.cString(" after "))
		putInt(regionBytesInUse)
		put(Prim.cString(" spares "))
		putInt(spareCount * regionBytes)
		put(Prim.cString(" kept "))
		putInt(liveBytes)
		put(Prim.cString(" threshold "))
		putInt(threshold)
		put(Prim.cString(" mark-us "))
		putInt((marked - started) / 1000)
		put(Prim.cString(" sweep-us "))
		putInt((swept - sweeping) / 1000)
		put(Prim.cString(" total-us "))
		putInt((nanoseconds() - started) / 1000)
		put(Prim.cString("\n"))
		writeLine()
	}
	if minor { statsMinor = statsMinor + 1 }
	collections = collections + 1
	let pause = nanoseconds() - begun
	collectNanosTotal = collectNanosTotal + pause
	if !minor && pause > fullNanosMax { fullNanosMax = pause }
	if collectionLog { logEvacuation(pause) }
	if wanted {
		statsMarkClock = statsMarkClock + (marked - started)
		logCollection(started, liveBefore, allocsSince)
	}
}

-- TURKEY_GC_TIMELOG: a line per collection (measurement only).
var timeLog : Bool = present(Prim.cString("TURKEY_GC_TIMELOG"))

-- Whether this collection must be full: when the last sweep set `fullNext`,
-- having found more bytes promoted since the last full collection than the
-- room left under the memory target or wasm32's ceiling allows
-- (`schedule`), or when the live bytes, old objects that died since
-- included, have grown by half since the last full collection kept them.
-- Under GC stress every eighth is, so that a stressed run exercises both.
--
-- Half is measured, on the self-compile against the full collector (17.7 s,
-- 2.60 GB max RSS): 14.3 s at 2.63 GB. Waiting for the live bytes to double
-- instead was 14.3 s at 2.86 GB, and with the young generation also sized
-- from them, 13.5 s at 3.67 GB.
fun fullDue() -> Bool {
	if stress { return collections % 8 == 0 }
	if fullNext { return True }
	let floor = if liveBytesAfterFull > 65536 { liveBytesAfterFull } else { 65536 }
	Float.fromInt(liveBytes) >= Float.fromInt(floor) * 1.5
}

-- -- the schedule -----------------------------------------------------------------------
--
-- After each collection, `schedule` sets how many bytes may be allocated
-- before the next one: the young generation's budget. Peak memory is about
-- the bytes the sweep kept plus that budget, so the budget is the trade of
-- time for memory.
--
-- The budget is the square-root rule of MemBalancer (Kirisame, Shenoy and
-- Panchekha, "Optimal Heap Limits for Reducing Browser Memory Use", OOPSLA
-- 2022): with L the bytes the sweep kept, g the allocation rate and s the
-- collection rate, sqrt(L * g / s) times a tuning factor. The paper derives
-- it as the budget that minimizes the heap's size plus the time spent
-- collecting, the tuning factor weighing one against the other.
--
-- * g is the bytes allocated per nanosecond of mutator wall time, every
--   worker's together.
-- * s is the bytes a collection freed per nanosecond of its marking,
--   clearing the marks included; the sweep is not counted. Julia
--   (`gc-stock.c`), whose collector is also non-moving with sticky marks,
--   measures both the same way, and a minor collection's s is its own: it
--   frees much for little marking, so a program whose garbage dies young
--   collects often and cheaply.
-- * Each of the four quantities is smoothed on its own, numerator and
--   denominator, as the paper, V8 and Julia all do: allocation by 0.95 per
--   collection, collection by 0.5, the paper's and Julia's weights. The
--   allocation rate is a program's phase and should move slowly; one
--   collection's speed is noisy and should not decide the next alone.
--   Julia tried other moving averages and measured them a regression.
--
-- The tuning factor is twice Julia's 2e4. The paper's own constant was
-- chosen for interactive programs, and its authors expect a batch program
-- to want a larger one. The compiler compiling itself, natively, medians
-- of interleaved runs against a young generation of twice the live set
-- (6.2-6.5 s, a 3.1-3.6 GB footprint):
--
-- | factor | wall  | footprint |
-- |--------|-------|-----------|
-- | 20000  | +19%  | 1.87 GB   |
-- | 30000  | +11%  | 2.26 GB   |
-- | 40000  | +9%   | 2.40 GB   |
-- | 50000  | +7%   | 2.53 GB   |
-- | 60000  | +6%   | 2.75 GB   |
--
-- 40000 takes 32% off the footprint for 9% more wall time, with 79 minor
-- and 22 full collections against 44 and 21. The extra time is the marking
-- of the young survivors that the more frequent minor collections promote.
-- On wasm32 the scale's cap binds for most of the compile: it needs 2336 MiB
-- of linear memory against 2432, in 2% more wall time. Programs with small
-- heaps, whose square-root budget is above the cap, collect as at the scale.
--
-- The budget is clamped:
-- * Below by a twentieth of L, Julia's floor, so that a heap whose
--   collections are cheap is not collected at every few allocations, and
--   never below `thresholdScale` times 64KB, so that a program with almost
--   nothing live does not collect more often than that.
-- * Above by `thresholdScale` times the bytes the last full collection
--   kept, so that no program collects less often than at that scale.
--
-- A memory target caps the budget at the room under it, with the same
-- floor. Natively there is a target only if TURKEY_GC_TARGET sets one, in
-- bytes (`roomUnderTarget`); it bounds the regions in use, which is most of
-- a program's footprint, not all of it. On wasm32 the 4 GiB ceiling of
-- linear memory, less the collector's own reserve (`roomUnderCeiling`), caps
-- the budget too, and there the floor is at most 32 MiB, half the reserve,
-- less whatever of the reserve the heap already holds, and never below
-- 64KB: a heap living in the reserve collects every so often rather than at
-- every few allocations, and leaves the marking at least half.
--
-- The next collection is full (`fullNext`) when the bytes promoted since the
-- last full collection are more than the room left after the sweep, and,
-- under a target, more than the floor. Under wasm32's ceiling there is no
-- floor to wait for: past the room is the reserve, and promoted bytes that
-- stay there leave the marking nothing. A minor collection frees no old object that has
-- died. A full one frees those promoted since and those it kept itself;
-- nothing counts the dead ones, and the promoted bytes stand in for them.
-- Right after a full collection nothing has been promoted, so a heap held
-- near its target collects in full only once a floor's worth has been, and
-- one whose garbage dies young stays minor. The test is made after the
-- sweep and not when the next collection starts, because by then the
-- budget has used up the room, and every collection would be full.
--
-- A target can be set below what the program needs, and then every
-- collection is full and frees little, which is the spiral to guard
-- against: a heap that keeps choosing full collections as it grows, and
-- spends most of the run collecting. So a guard lets the heap pass
-- TURKEY_GC_TARGET while collecting takes over half the time: Go's leaky
-- bucket (`runtime/mgclimit.go`). Each collection the budget triggered adds
-- its marking and sweeping to the bucket and drains the mutator time
-- before it, between empty and one second; when it fills, the guard is on,
-- and the budget ignores the target until a collection drains it again.
-- With every worker stopped while it collects, wall time is CPU time on
-- every core, so one second of wall time is Go's one CPU-second per
-- processor. Once the bucket has filled, a program held at the target
-- collects for about as long as it runs, not arbitrarily long. One that
-- keeps 128 MB live under a 100 MB target while the lists it builds die old
-- takes 1.4 s, against 2.6 s with no guard and 0.3 s with no target; most
-- of the 1.4 s is the second the bucket takes to fill. One whose garbage
-- dies young, but for an array kept every 100,000 allocations, needs no
-- guard: under a 100 MB target with 256 MB live it takes 1.4 s at a 308 MB
-- footprint, against 1.5 s at 717 MB with no target. The guard never
-- lifts wasm32's ceiling, past which there is no memory to grow into.

-- The tuning factor of the square-root rule, in bytes^(1/2).
let tuning : Float = 40000.0

-- TURKEY_GC_TARGET, the bytes the regions in use should stay under, or 0
-- for no target.
var target : Int = targetFrom(Os.getenv(Prim.cString("TURKEY_GC_TARGET")))

-- Whether the next collection is to be full, set after each sweep.
var fullNext : Bool = False

-- When the last collection ended, in nanoseconds of the monotonic clock.
var collectedAt : Int = nanoseconds()

-- The smoothed bytes allocated and mutator nanoseconds between collections,
-- and the smoothed bytes freed and nanoseconds marked per collection. They
-- start at zero, so the first collection's ratios are its own.
var allocatedSmoothed : Float = 0.0
var mutatorSmoothed : Float = 0.0
var freedSmoothed : Float = 0.0
var markingSmoothed : Float = 0.0

-- The leaky bucket, in nanoseconds, and whether it has filled. The
-- capacity is a second, or TURKEY_GC_GUARD_NANOSECONDS, for tests that must
-- see the guard turn on without running for a second of collecting. It is
-- not a tuning knob: a program should leave it unset.
var bucketCapacity : Int = bucketFrom(Os.getenv(Prim.cString("TURKEY_GC_GUARD_NANOSECONDS")))
var bucket : Int = 0
var guarding : Bool = False

-- Set the next collection's budget and whether it is full, from this one:
-- it began at `started`, marked for `marking` nanoseconds and swept for
-- `sweeping`, and freed `freed` bytes, and `allocated` bytes had been
-- allocated since the last one. Only a collection the budget triggered,
-- `sampled`, updates the rates and the guard: one asked for by name says
-- nothing about the program's allocation rate.
fun schedule(
	sampled : Bool,
	started : Int,
	marking : Int,
	sweeping : Int,
	allocated : Int,
	freed : Int,
) -> Unit {
	let ended = nanoseconds()
	let mutator = started - collectedAt
	collectedAt = ended
	if sampled {
		allocatedSmoothed = smoothed(allocatedSmoothed, allocated, 0.95)
		mutatorSmoothed = smoothed(mutatorSmoothed, mutator, 0.95)
		freedSmoothed = smoothed(freedSmoothed, freed, 0.5)
		markingSmoothed = smoothed(markingSmoothed, marking, 0.5)
		guard(marking + sweeping, mutator)
	}
	let smallest = saturated(65536.0 * thresholdScale)
	let most = saturated(Float.fromInt(atLeast64K(liveBytesAfterFull)) * thresholdScale)
	let fewest = if liveBytes / 20 > smallest { liveBytes / 20 } else { smallest }
	let least = if fewest < most { fewest } else { most }
	var budget = squareRootBudget()
	if budget > most { budget = most }
	if budget < least { budget = least }
	let room = if guarding { maxInt() } else { roomUnderTarget() }
	if room < budget { budget = if room > least { room } else { least } }
	-- Past the ceiling's room is the collector's own reserve, of which the
	-- floor may take at most half, less what the heap already holds of it.
	let ceiling = roomUnderCeiling()
	let half = 0x200_0000 + (if ceiling < 0 { ceiling } else { 0 })
	let nearest = if least < half { least } else { half }
	let nearCeiling = if nearest > 65536 { nearest } else { 65536 }
	if ceiling < budget { budget = if ceiling > nearCeiling { ceiling } else { nearCeiling } }
	-- Under the ceiling, wait for no floor's worth of promotion: the floor
	-- is a twentieth of the live bytes, far more than the reserve.
	let promoted = liveBytes - liveBytesAfterFull
	fullNext = if ceiling <= room {
		promoted > (if ceiling > 0 { ceiling } else { 0 })
	} else {
		promoted > (if room > least { room } else { least })
	}
	threshold = budget
}

-- The square-root rule's budget, or the most an `Int` holds before any
-- collection has measured a rate.
fun squareRootBudget() -> Int {
	if mutatorSmoothed <= 0.0 || freedSmoothed <= 0.0 || markingSmoothed <= 0.0 {
		return maxInt()
	}
	let allocationRate = allocatedSmoothed / mutatorSmoothed
	let collectionRate = freedSmoothed / markingSmoothed
	saturated(tuning * squareRoot(Float.fromInt(liveBytes) * allocationRate / collectionRate))
}

-- The leaky bucket after a collection that paused for `pause` nanoseconds
-- after `mutator` nanoseconds of the program running. The guard turns on
-- when the bucket fills, and off at the first collection that drains it.
fun guard(pause : Int, mutator : Int) -> Unit {
	let change = pause - mutator
	let level = bucket + change
	bucket = if level < 0 { 0 } else if level > bucketCapacity { bucketCapacity } else { level }
	if guarding {
		if change < 0 { guarding = False }
	} else if bucket == bucketCapacity {
		guarding = True
	}
}

-- The bytes the regions in use may still grow by under TURKEY_GC_TARGET, or
-- the most an `Int` holds if it sets none. Negative past the target.
fun roomUnderTarget() -> Int =
	if target > 0 { target - regionBytesInUse } else { maxInt() }

-- The memory left under wasm32's 4 GiB ceiling, which no `memory.grow`
-- passes, less 64 MiB kept for what the collector itself allocates while it
-- marks: chiefly the mark stack, which doubles as the heap deepens, and which
-- a collection that runs with nothing left cannot grow. The compiler compiling
-- itself, with a 1 GB live set, peaks at an 8 MiB mark stack. The remembered
-- set draws on the reserve too, since `remember` reallocates it as it grows
-- during marking. Spares count as left, since a region takes one before it
-- asks for memory.
-- The most an `Int` holds on any other target, which has no ceiling.
fun roomUnderCeiling() -> Int = match Target.os {
	Wasi -> Wasi.memoryLeft() + spareCount * regionBytes - 0x400_0000
	_    -> maxInt()
}

-- `weight` of `old` and the rest of `sample`.
fun smoothed(old : Float, sample : Int, weight : Float) -> Float =
	weight * old + (1.0 - weight) * Float.fromInt(sample)

fun atLeast64K(bytes : Int) -> Int = if bytes > 65536 { bytes } else { 65536 }

-- `x` truncated, or the most an `Int` holds where it does not fit.
fun saturated(x : Float) -> Int = match Float.truncate(x) {
	Some(n) -> n
	None    -> maxInt()
}

-- The square root of `x`: 0 if `x` is not positive, and `x` if it is not
-- finite. By Newton's iteration rather than `Float.sqrt`, which is libc's,
-- and wasm32 has no libc. Started at or above the root, the iteration falls
-- to it monotonically, so it ends at the first step that does not fall.
fun squareRoot(x : Float) -> Float {
	if !Float.isFinite(x) { return x }
	if !(x > 0.0) { return 0.0 }
	var root = if x > 1.0 { x } else { 1.0 }
	while True {
		let next = (root + x / root) * 0.5
		if !(next < root) { return root }
		root = next
	}
	root
}

-- TURKEY_GC_GUARD_NANOSECONDS: a decimal number of at least 1, or a second
-- if it is unset or anything else.
fun bucketFrom(s : Ptr) -> Int {
	if Ptr.isNull(s) { return 1000000000 }
	let n = decimalFrom(s)
	if n < 1 { 1000000000 } else { n }
}

-- TURKEY_GC_TARGET: a decimal number of bytes, with optional surrounding
-- whitespace; 0, no target, if it is unset or anything else.
fun targetFrom(s : Ptr) -> Int {
	if Ptr.isNull(s) { return 0 }
	let n = decimalFrom(s)
	if n < 1 { 0 } else { n }
}

-- Before a full collection's marking: no object is marked.
fun clearMarks() -> Unit {
	var region = regions
	while !Ptr.isNull(region) {
		Memory.fill(Ptr.add(region, regionMarked), 8 * regionWords, 0)
		Ptr.store32(region, regionLive, 0)
		region = Ptr.load(region, regionNext)
	}
}

-- An empty region is set aside whole, as a spare or freed, however many
-- objects it held. A survivor's
-- marks become its allocation bitmap, so no individual header is visited.
--
-- The marks are kept: every survivor is old now, and an old object stays
-- marked until a full collection clears the marks to trace everything again.
-- A minor collection's marking starts from them, and stops at them.
fun sweep() -> Unit {
	Memory.fill(available, 8 * regionClasses, 0)
	liveBytes = 0
	var previous = Ptr.null()
	var region = regions
	while !Ptr.isNull(region) {
		let next : Ptr = Ptr.load(region, regionNext)
		let live = Ptr.load32(region, regionLive)
		let dead = Ptr.load32(region, regionUsed) - live
		heapCount = heapCount - dead
		statsFreedTotal = statsFreedTotal + dead
		if live == 0 {
			if Ptr.isNull(previous) {
				regions = next
			} else {
				Ptr.store(previous, regionNext, next)
			}
			let reserved : Int = Ptr.load(region, regionReserved)
			regionBytesInUse = regionBytesInUse - reserved
			tableRemove(region)
			if reserved == regionBytes {
				Ptr.store(region, regionNext, spare)
				spare = region
				spareCount = spareCount + 1
			} else {
				release(region)
			}
		} else {
			Memory.copy(
				Ptr.add(region, regionAllocated),
				Ptr.add(region, regionMarked),
				8 * regionWords,
			)
			Ptr.store32(region, regionUsed, live)
			Ptr.store32(region, regionSearchWord, 0)
			let cls = Ptr.load32(region, regionSizeClass)
			liveBytes = liveBytes
				+ (if cls < regionClasses {
					live * Ptr.load(region, regionSlotSize)
				} else {
					Ptr.load(region, regionReserved)
				})
			if live < Ptr.load32(region, regionCapacity) && cls < regionClasses {
				Ptr.store(region, regionAvailableNext, Ptr.load(available, 8 * cls) : Ptr)
				Ptr.store(available, 8 * cls, region)
			}
			previous = region
		}
		region = next
	}
	trimSpares()
}

-- Free the spares beyond what the heap's recent peak leaves room for: the
-- regions in use and the spares together reserve no more than the regions in
-- use did at their most, since the last full collection or between the two
-- before it. A program at a steady size keeps what it will take again; one
-- that shrinks gives the excess back to libc at its second full collection
-- after. Spares change which memory a region takes, not how many regions are
-- in use, so what the heap holds from libc never exceeds what its regions in
-- use reserved at their most in that window.
fun trimSpares() -> Unit {
	let peak = if peakSinceFull > peakBeforeFull { peakSinceFull } else { peakBeforeFull }
	let room = (peak - regionBytesInUse) / regionBytes
	let kept = if room > 0 { room } else { 0 }
	while spareCount > kept {
		let freed = spare
		spare = Ptr.load(freed, regionNext)
		spareCount = spareCount - 1
		release(freed)
	}
	if !minor {
		peakBeforeFull = peakSinceFull
		peakSinceFull = regionBytesInUse
	}
}

-- Give a region and its size table back to libc.
fun release(region : Ptr) -> Unit {
	Os.free(Ptr.load(region, regionSizes))
	Os.free(region)
}

-- -- evacuation (prototype) --------------------------------------------------------------
--
-- A full collection, once it has swept, moves the survivors out of its
-- sparsest small regions, per size class, and makes those regions spares.
-- Large regions never move. Native only: on wasm32 it is off.
--
-- After the sweep, so that every allocated object is a survivor: an unswept
-- dead object may point into a region being emptied, and nothing rewrites it.
-- After marking rather than during it, because the mark gives every region's
-- exact live count first. So a class's plan is exact: keep the fewest of its
-- regions whose free slots hold the live objects of the rest, and empty the
-- rest. Marking that evacuated as it went would choose from the previous
-- cycle's counts, and its parallel markers would race to forward an object.
-- The cost is one more pass over the live objects, to rewrite the pointers.
--
-- A slot is copied whole into a free slot of the same class, so no object's
-- size is needed. The old header becomes the new address with `forwardedTag`
-- in its low bits. Every pointer to the old copy is then rewritten: the fields
-- of every marked object, and the root chain's slots.
--
-- Stack roots are not rewritten but pinned: any region a frame-table slot
-- names, on any stack, is not evacuated. Generated code keeps a traced value
-- live across a safepoint in a register as well as in its root slot, and a
-- callee may hold it in its save area: only the root slot is in the table, so
-- the other copies would be stale. Pinning what the slots name keeps every
-- copy valid, and with it every untraced address into such an object
-- (`Ptr.elementAddress`, `turkey_array_new`'s fill, a blocked worker's
-- buffer), since each holder keeps its base rooted.
--
-- TURKEY_GC_EVACUATE=0 turns it off. TURKEY_GC_EVACUATE_LIVE is the percentage
-- of live slots under which a region is a candidate (30). TURKEY_GC_EVACUATE_BUDGET
-- caps the bytes moved per collection (none). TURKEY_GC_EVACUATE_ALL moves
-- every unpinned small region's survivors into new regions at every full
-- collection, and poisons the emptied regions, to shake out missed roots.
-- TURKEY_GC_EVACUATE_REWRITE_STACKS rewrites stack slots instead of pinning:
-- unsound, for showing why. TURKEY_GC_LOG prints a line per collection.

-- A small region's flags, in the four bytes after its size class.
let regionFlags : Int = 52
let flagEvacuating : Int = 1
let flagPinned : Int = 2
-- The low bits of a forwarded header: no generation has them.
let forwardedTag : Int = 7

var evacuating : Bool = evacuationFrom(Os.getenv(Prim.cString("TURKEY_GC_EVACUATE")))
var evacuateAll : Bool = present(Prim.cString("TURKEY_GC_EVACUATE_ALL"))
var rewriteStacks : Bool = present(Prim.cString("TURKEY_GC_EVACUATE_REWRITE_STACKS"))
var evacuateLive : Int = settingFrom(Os.getenv(Prim.cString("TURKEY_GC_EVACUATE_LIVE")), 30)
var evacuateBudget : Int = settingFrom(Os.getenv(Prim.cString("TURKEY_GC_EVACUATE_BUDGET")), 0)
var collectionLog : Bool = present(Prim.cString("TURKEY_GC_LOG"))

-- This collection's evacuation, and the run's.
var movedBytes : Int = 0
-- The bytes this collection's plans have chosen to move so far, against the
-- budget.
var plannedBytes : Int = 0
var movedObjects : Int = 0
var evacuatedRegions : Int = 0
var pinnedRegions : Int = 0
var evacuationNanos : Int = 0
-- The part of `evacuationNanos` up to the end of the copying.
var copiedNanos : Int = 0
var movedBytesTotal : Int = 0
var collectNanosTotal : Int = 0
var fullNanosMax : Int = 0

fun evacuationFrom(s : Ptr) -> Bool {
	if let Wasi = Target.os { return False }
	Ptr.isNull(s) || decimalFrom(s) != 0
}

fun settingFrom(s : Ptr, fallback : Int) -> Int {
	if Ptr.isNull(s) { return fallback }
	let n = decimalFrom(s)
	if n < 0 { fallback } else { n }
}

fun flagsOf(region : Ptr) -> Int = Ptr.load32(region, regionFlags)

fun flagSet(region : Ptr, flag : Int) -> Unit =
	Ptr.store32(region, regionFlags, flagsOf(region) | flag)

-- Pin the region of `value`, a root, if it is a heap object.
fun pin(value : Ptr) -> Unit {
	if immediate(value) || isStatic(value) { return }
	flagSet(regionOf(value), flagPinned)
}

-- `value`'s new address if it was moved, or `value`. A word into an emptied
-- region at a slot that was not forwarded is a pointer to an object that was
-- not marked: a missed root or a wrong descriptor, which is a panic.
fun forwarded(value : Ptr) -> Ptr {
	if immediate(value) || isStatic(value) { return value }
	if flagsOf(regionOf(value)) & flagEvacuating == 0 { return value }
	let header : Int = Ptr.load(value, 0)
	if header & forwardedTag != forwardedTag {
		markFailed(Prim.cString("evacuation: a pointer to an unmarked object in an emptied region"))
		return value
	}
	Ptr.fromInt(header & complement(forwardedTag))
}

-- Move the survivors of the sparse regions, rewrite every pointer to them, and
-- free the regions. With the world stopped, after a full collection's marking.
fun evacuate(frame : Ptr) -> Unit {
	let started = nanoseconds()
	movedBytes = 0
	plannedBytes = 0
	copiedNanos = 0
	movedObjects = 0
	evacuatedRegions = 0
	pinnedRegions = 0
	Ptr.atomicStore(marking, failedAt, 0)
	if !rewriteStacks { walkStacks(frame, walkPin) }
	var n = 0
	var region = regions
	while !Ptr.isNull(region) {
		if flagsOf(region) & flagPinned != 0 { pinnedRegions = pinnedRegions + 1 }
		if candidate(region) { n = n + 1 }
		region = Ptr.load(region, regionNext)
	}
	-- Each entry is the class and live count as one sortable key, and the
	-- region: the frame table's entries, so its sort serves.
	let order = if n == 0 { Ptr.null() } else { Os.malloc(entryBytes * n) }
	if !Ptr.isNull(order) {
		var at = 0
		region = regions
		while !Ptr.isNull(region) {
			if candidate(region) {
				let key = Ptr.load32(region, regionSizeClass) << 13 | Ptr.load32(region, regionLive)
				Ptr.store(order, entryBytes * at, key)
				Ptr.store(order, entryBytes * at + 8, region)
				at = at + 1
			}
			region = Ptr.load(region, regionNext)
		}
		sortEntries(order, n)
		var first = 0
		while first < n {
			let cls = entryKey(order, first) >> 13
			var end = first
			while end < n && entryKey(order, end) >> 13 == cls { end = end + 1 }
			evacuateClass(order, first, end, cls)
			first = end
		}
		Os.free(order)
		copiedNanos = nanoseconds() - started
		if evacuatedRegions > 0 {
			rewriteHeap()
			rewriteChain()
			if rewriteStacks { walkStacks(frame, walkRewrite) }
		}
	}
	releaseEvacuated()
	movedBytesTotal = movedBytesTotal + movedBytes
	evacuationNanos = nanoseconds() - started
	if Ptr.atomicLoad(marking, failedAt) != 0 { Process.panic(failure) }
}

-- Whether the root chain is the generated globals frame alone. A frame a C
-- caller registered may have its values in C locals too, which nothing
-- rewrites, and the runtime's C tests ask by address whether an object is
-- still in the heap: so while one is registered, nothing moves.
fun onlyGlobals() -> Bool {
	if Ptr.isNull(roots) || !Ptr.isNull(Ptr.load(roots, 0) : Ptr) { return False }
	let name : Ptr = Ptr.load(roots, 8)
	let globals = Prim.cString("<globals>")
	var i = 0
	while byteAt(globals, i) != 0 {
		if byteAt(name, i) != byteAt(globals, i) { return False }
		i = i + 1
	}
	byteAt(name, i) == 0
}

-- Whether `region` may be emptied: small, holding a survivor, and not pinned.
fun candidate(region : Ptr) -> Bool =
	Ptr.load32(region, regionSizeClass) < regionClasses
		&& Ptr.load32(region, regionLive) > 0
		&& flagsOf(region) & flagPinned == 0

fun orderRegion(order : Ptr, i : Int) -> Ptr = Ptr.load(order, entryBytes * i + 8)

fun orderLive(order : Ptr, i : Int) -> Int = entryKey(order, i) & 8191

-- Plan and move class `cls`, whose candidates are `order[first..end)`, sparsest
-- first. The sparsest are emptied into the free slots of the densest, which
-- stay: of the regions under the threshold, as many as their free slots and
-- those of the regions over it can take, and the regions over it are never
-- emptied.
fun evacuateClass(order : Ptr, first : Int, end : Int, cls : Int) -> Unit {
	let slot = classSlot(cls)
	let capacity = (regionBytes - regionData) / slot
	var emptied = first
	var targets : Ptr = Ptr.null()
	var targetCount = 0
	if evacuateAll {
		var total = 0
		for var i = first; i < end; i = i + 1 { total = total + orderLive(order, i) }
		let wanted = (total + capacity - 1) / capacity
		targets = Os.malloc(8 * wanted)
		if Ptr.isNull(targets) { return }
		while targetCount < wanted {
			let made = newRegion(slot, slot, cls, False)
			if Ptr.isNull(made) { break }
			Ptr.store(targets, 8 * targetCount, made)
			targetCount = targetCount + 1
		}
		var room = targetCount * capacity
		while emptied < end && orderLive(order, emptied) <= room {
			room = room - orderLive(order, emptied)
			emptied = emptied + 1
		}
	} else {
		var sparse = first
		while sparse < end && orderLive(order, sparse) * 100 < capacity * evacuateLive {
			sparse = sparse + 1
		}
		var free = 0
		for var i = sparse; i < end; i = i + 1 { free = free + capacity - orderLive(order, i) }
		var kept = sparse - 1
		while emptied <= kept {
			let need = orderLive(order, emptied)
			while free < need && kept > emptied {
				free = free + capacity - orderLive(order, kept)
				kept = kept - 1
			}
			if free < need { break }
			if evacuateBudget > 0 && plannedBytes + need * slot > evacuateBudget { break }
			free = free - need
			plannedBytes = plannedBytes + need * slot
			emptied = emptied + 1
		}
		targetCount = end - (kept + 1)
		if emptied == first || targetCount == 0 { return }
		targets = Os.malloc(8 * targetCount)
		if Ptr.isNull(targets) { return }
		for var i = 0; i < targetCount; i = i + 1 {
			Ptr.store(targets, 8 * i, orderRegion(order, kept + 1 + i))
		}
	}
	var t = 0
	var word = 0
	for var i = first; i < emptied; i = i + 1 {
		let source = orderRegion(order, i)
		flagSet(source, flagEvacuating)
		evacuatedRegions = evacuatedRegions + 1
		for var w = 0; w < regionWords; w = w + 1 {
			var bits : Int = Ptr.load(source, plus(regionMarked, times8(w)))
			while bits != 0 {
				let lowest = bits & Int.negWrapping(bits)
				bits = bits ^ lowest
				-- The next free slot of the targets: there is one, by the plan.
				var free = 0
				while free == 0 {
					if t >= targetCount {
						markFailed(Prim.cString("evacuation: the targets ran out of slots"))
						Os.free(targets)
						return
					}
					let target : Ptr = Ptr.load(targets, 8 * t)
					free = complement(Ptr.load(target, plus(regionMarked, times8(word))))
						& slotsBelow(word, capacity)
					if free == 0 {
						word = word + 1
						if word == regionWords {
							word = 0
							t = t + 1
						}
					}
				}
				let target : Ptr = Ptr.load(targets, 8 * t)
				let to = plus(word << 6, bitIndex(free & Int.negWrapping(free)))
				move(source, plus(w << 6, bitIndex(lowest)), target, to, slot)
			}
		}
	}
	Os.free(targets)
}

-- The bits of bitmap word `w` that are slots below `capacity`.
fun slotsBelow(w : Int, capacity : Int) -> Int {
	let beyond = capacity - (w << 6)
	if beyond >= 64 { -1 } else if beyond <= 0 { 0 } else { Int.subWrapping(1 << beyond, 1) }
}

-- Copy slot `from` of `source` to slot `to` of `target`, marked and
-- allocated there, and forward the old header to it.
fun move(source : Ptr, from : Int, target : Ptr, to : Int, slot : Int) -> Unit {
	let old = Ptr.add(source, plus(regionData, Int.mulWrapping(from, slot)))
	let new = Ptr.add(target, plus(regionData, Int.mulWrapping(to, slot)))
	Memory.copy(new, old, slot)
	if !testBit(target, regionAllocated, to) {
		setBit(target, regionAllocated, to)
		Ptr.store32(target, regionUsed, plus(Ptr.load32(target, regionUsed), 1))
		heapCount = plus(heapCount, 1)
	}
	setBit(target, regionMarked, to)
	Ptr.store32(target, regionLive, plus(Ptr.load32(target, regionLive), 1))
	if sizesKept {
		let size : Int = Ptr.load(Ptr.load(source, regionSizes), Ptr.diff(old, source))
		Ptr.store(Ptr.load(target, regionSizes), Ptr.diff(new, target), size)
	}
	Ptr.store(old, 0, Ptr.toInt(new) | forwardedTag)
	movedBytes = plus(movedBytes, slot)
	movedObjects = plus(movedObjects, 1)
}

-- Rewrite the traced words of every marked object outside the emptied
-- regions, the moved copies included: as tasks of `rewriteRun` regions, which
-- the workers share as they share marking. Each region's objects are written
-- by the one worker that claims its task, and the emptied regions are only
-- read, so the workers need no synchronization beyond the tasks'.
fun rewriteHeap() -> Unit {
	var count = 0
	var region = regions
	while !Ptr.isNull(region) {
		if rewritten(region) { count = plus(count, 1) }
		region = Ptr.load(region, regionNext)
	}
	let list = Os.malloc(8 * count)
	if Ptr.isNull(list) {
		-- No memory for the list: rewrite here, alone.
		region = regions
		while !Ptr.isNull(region) {
			if rewritten(region) { rewriteRegion(region) }
			region = Ptr.load(region, regionNext)
		}
		return
	}
	var at = 0
	region = regions
	while !Ptr.isNull(region) {
		if rewritten(region) {
			Ptr.store(list, times8(at), region)
			at = plus(at, 1)
		}
		region = Ptr.load(region, regionNext)
	}
	taskCount = 0
	for var i = 0; i < count; i = plus(i, rewriteRun) {
		let end = if count - i < rewriteRun { count } else { plus(i, rewriteRun) }
		addTask(taskRewrite, Ptr.add(list, times8(i)), Ptr.add(list, times8(end)))
	}
	runTasks(liveBytes)
	Os.free(list)
}

let rewriteRun : Int = 64

fun rewritten(region : Ptr) -> Bool =
	flagsOf(region) & flagEvacuating == 0 && Ptr.load32(region, regionLive) > 0

fun rewriteRegion(region : Ptr) -> Unit {
	let slot : Int = Ptr.load(region, regionSlotSize)
	for var w = 0; w < regionWords; w = w + 1 {
		var bits : Int = Ptr.load(region, plus(regionMarked, times8(w)))
		while bits != 0 {
			let lowest = bits & Int.negWrapping(bits)
			bits = bits ^ lowest
			let index = plus(w << 6, bitIndex(lowest))
			rewriteObject(Ptr.add(region, plus(regionData, Int.mulWrapping(index, slot))))
		}
	}
}

-- Rewrite `object`'s traced words, decoded as `drain` decodes them.
fun rewriteObject(object : Ptr) -> Unit {
	let header = Ptr.load32(object, 0)
	let kind = header >> 8 & 255
	var first = objectFields
	var runs = header >> 16
	var per = 1
	var stride = 8
	if kind == arrayKind {
		first = arrayElements
		per = runs
		stride = Ptr.load32(object, 4)
		runs = if per > 0 { Ptr.load(object, arrayLength) } else { 0 }
	}
	let stop = plus(first, Int.mulWrapping(runs, stride))
	for var at = first; at < stop; at = plus(at, stride) {
		for var k = 0; k < per; k = plus(k, 1) {
			let offset = plus(at, times8(k))
			let child : Ptr = Ptr.load(object, offset)
			let moved = forwarded(child)
			if moved != child { Ptr.store(object, offset, moved) }
		}
	}
}

-- Rewrite the root chain's live slots, as `run` reads them.
fun rewriteChain() -> Unit {
	var root = roots
	while !Ptr.isNull(root) {
		let count : Int = Ptr.load(root, frameCount)
		let live : Int = Ptr.load(root, frameLive)
		let values : Ptr = Ptr.load(root, frameValues)
		for var i = 0; i < count; i = plus(i, 1) {
			if i >= 64 || live >> i & 1 != 0 {
				Ptr.store(values, times8(i), forwarded(Ptr.load(values, times8(i))))
			}
		}
		root = Ptr.load(root, 0)
	}
}

-- Make every emptied region a spare, clear every region's flags, and rebuild
-- the available lists, which the moves and the new targets have changed.
fun releaseEvacuated() -> Unit {
	let poison = evacuateAll || stress || verify
	var previous = Ptr.null()
	var region = regions
	while !Ptr.isNull(region) {
		let next : Ptr = Ptr.load(region, regionNext)
		let flags = flagsOf(region)
		if flags & flagEvacuating != 0 {
			if Ptr.isNull(previous) {
				regions = next
			} else {
				Ptr.store(previous, regionNext, next)
			}
			regionBytesInUse = regionBytesInUse - regionBytes
			heapCount = heapCount - Ptr.load32(region, regionUsed)
			tableRemove(region)
			if poison { Memory.fill(Ptr.add(region, regionData), regionBytes - regionData, 0xA5) }
			Ptr.store32(region, regionFlags, 0)
			Ptr.store(region, regionNext, spare)
			spare = region
			spareCount = spareCount + 1
		} else {
			if flags != 0 { Ptr.store32(region, regionFlags, 0) }
			previous = region
		}
		region = next
	}
	Memory.fill(available, 8 * regionClasses, 0)
	region = regions
	while !Ptr.isNull(region) {
		let cls = Ptr.load32(region, regionSizeClass)
		if cls < regionClasses
				&& Ptr.load32(region, regionUsed) < Ptr.load32(region, regionCapacity) {
			Ptr.store(region, regionAvailableNext, Ptr.load(available, times8(cls)) : Ptr)
			Ptr.store(available, times8(cls), region)
		}
		region = Ptr.load(region, regionNext)
	}
}

-- One line per collection, when TURKEY_GC_LOG asks: its pause, what it moved,
-- and the live bytes against the bytes the regions hold after it.
fun logEvacuation(nanos : Int) -> Unit {
	textLength = 0
	put(Prim.cString("[gc-log "))
	putInt(collections)
	put(if minor { Prim.cString(" minor] ") } else { Prim.cString(" full] ") })
	putFixed(nanos, 1000000, 3)
	put(Prim.cString(" ms, live "))
	putInt(liveBytes)
	put(Prim.cString(" held "))
	putInt(regionBytesInUse)
	put(Prim.cString(" spare "))
	putInt(spareCount * regionBytes)
	put(Prim.cString(" peak "))
	putInt(regionBytesPeak)
	if !minor {
		put(Prim.cString(", moved "))
		putInt(movedBytes)
		put(Prim.cString(" in "))
		putInt(movedObjects)
		put(Prim.cString(" from "))
		putInt(evacuatedRegions)
		put(Prim.cString(" pinned "))
		putInt(pinnedRegions)
		put(Prim.cString(" evac "))
		putFixed(evacuationNanos, 1000000, 3)
		put(Prim.cString(" ms (copy "))
		putFixed(copiedNanos, 1000000, 3)
		put(Prim.cString(")"))
	}
	put(Prim.cString(", total "))
	putFixed(collectNanosTotal, 1000000, 1)
	put(Prim.cString(" ms moved "))
	putInt(movedBytesTotal)
	put(Prim.cString(" max-full "))
	putFixed(fullNanosMax, 1000000, 3)
	put(Prim.cString("\n"))
	writeLine()
}

-- -- statistics -------------------------------------------------------------------------

fun nanoseconds() -> Int {
	let _ = Os.clockGettime(Sys.clockMonotonic(), clock)
	Ptr.load(clock, 0) * 1000000000 + Ptr.load(clock, 8)
}

fun logCollection(started : Int, liveBefore : Int, allocsSince : Int) -> Unit {
	let nanos = nanoseconds() - started
	let freedNow = statsFreedTotal - statsFreedPrevious
	let survived = liveBefore - freedNow
	statsFreedPrevious = statsFreedTotal
	statsClock = statsClock + nanos
	-- A minor collection marks only the young survivors; the old objects were
	-- marked already, and are not traced again.
	let traced = if minor { survived - (liveBefore - allocsSince) } else { survived }
	if traced > 0 { statsTraced = statsTraced + traced }
	statsLiveTotal = statsLiveTotal + heapCount
	if heapCount > statsLivePeak { statsLivePeak = heapCount }
	textLength = 0
	put(Prim.cString("[gc "))
	putInt(collections)
	put(if minor { Prim.cString(" minor") } else { Prim.cString(" full") })
	put(Prim.cString("] allocs-since "))
	putInt(allocsSince)
	put(Prim.cString(", live-before "))
	putInt(liveBefore)
	put(Prim.cString(", survived "))
	putInt(survived)
	put(Prim.cString(", freed "))
	putInt(freedNow)
	put(Prim.cString(", next threshold "))
	putInt(threshold)
	put(Prim.cString(", held "))
	putInt(regionBytesInUse)
	if guarding { put(Prim.cString(", guard")) }
	if fullNext { put(Prim.cString(", next full")) }
	put(Prim.cString(", "))
	putFixed(nanos, 1000000, 3)
	put(Prim.cString(" ms\n"))
	writeLine()
}

-- The run's totals, when TURKEY_GC_STATS asked for them.
foreign "turkey_gc_report" fun report() -> Unit {
	if !statsWanted { return }
	-- With the world stopped, as a collection retires: other workers may
	-- still be allocating, and the monitor retiring a blocked one's cursors.
	-- When another worker is collecting, it waits for this one to stop, and
	-- this loop must stop for it by hand: no loop in this module polls
	-- (`Turkey.Polls`).
	while !Workers.stopTheWorld() {
		if stopAsked() { stopAt(Prim.frameAddress()) }
	}
	retire()
	Workers.startTheWorld()
	textLength = 0
	put(Prim.cString("[gc] region bytes "))
	putInt(regionBytesInUse)
	put(Prim.cString(", peak "))
	putInt(regionBytesPeak)
	put(Prim.cString(", spare "))
	putInt(spareCount * regionBytes)
	put(Prim.cString("\n"))
	writeLine()
	put(Prim.cString("[gc] collections "))
	putInt(collections)
	put(Prim.cString(", allocations "))
	putInt(Ptr.atomicLoad(statsCounts, statsAllocationsAt))
	put(Prim.cString(", bytes "))
	putInt(Ptr.atomicLoad(statsCounts, statsBytesAt))
	put(Prim.cString(" ("))
	putFixed(Ptr.atomicLoad(statsCounts, statsBytesAt), 1048576, 1)
	put(Prim.cString(" MB)\n"))
	writeLine()
	put(Prim.cString("[gc] by kind: constr "))
	putKind(0)
	put(Prim.cString(", record "))
	putKind(1)
	put(Prim.cString(", array "))
	putKind(2)
	put(Prim.cString(", closure "))
	putKind(3)
	put(Prim.cString(", closure-env "))
	putKind(4)
	put(Prim.cString(", cell "))
	putKind(cellKind)
	put(Prim.cString("\n"))
	writeLine()
	put(Prim.cString("[gc] final live "))
	putInt(heapCount)
	put(Prim.cString(", peak live "))
	putInt(statsLivePeak)
	put(Prim.cString(", objects traced "))
	putInt(statsTraced)
	put(Prim.cString(", freed "))
	putInt(statsFreedTotal)
	put(Prim.cString(", collect time "))
	putFixed(statsClock, 1000000000, 3)
	put(Prim.cString(" s (mark "))
	putFixed(statsMarkClock, 1000000000, 3)
	put(Prim.cString(" s)\n"))
	writeLine()
	put(Prim.cString("[gc] minor "))
	putInt(statsMinor)
	put(Prim.cString(", full "))
	putInt(collections - statsMinor)
	put(Prim.cString(", remembered "))
	putInt(Ptr.atomicLoad(statsCounts, statsRememberedAt))
	put(Prim.cString("\n"))
	writeLine()
	-- Every collection's stop visits every thread.
	put(Prim.cString("[gc] threads "))
	putInt(Workers.count())
	put(Prim.cString(" of at most "))
	putInt(Workers.threadLimit())
	put(Prim.cString(", permits "))
	putInt(Workers.permits())
	put(Prim.cString("\n"))
	writeLine()
}

fun putKind(kind : Int) -> Unit = putInt(Ptr.atomicLoad(statsByKind, 8 * kind))

-- -- text without a `String` ------------------------------------------------------------
--
-- Into `text`, a byte at a time, and out in one `write` per line so that lines
-- from two sources do not interleave. What does not fit is dropped.

fun putByte(byte : Int) -> Unit {
	if textLength < textBytes - 1 {
		Ptr.store(text, textLength, Byte.truncate(byte))
		textLength = textLength + 1
	}
}

-- A NUL-terminated string.
fun put(s : Ptr) -> Unit {
	var i = 0
	while Byte.toInt(Ptr.load(s, i)) != 0 {
		putByte(Byte.toInt(Ptr.load(s, i)))
		i = i + 1
	}
}

fun putInt(n : Int) -> Unit {
	if n < 0 {
		putByte(45)
		putMagnitude(n)
	} else {
		putMagnitude(-n)
	}
}

-- The digits of `-n`, for `n <= 0`: the most negative `Int` has no positive
-- twin, and `Int.rem` takes the dividend's sign, so each remainder is in
-- `-9..0`.
fun putMagnitude(n : Int) -> Unit {
	if n <= -10 { putMagnitude(Int.quot(n, 10)) }
	putByte(48 - Int.rem(n, 10))
}

-- `n / unit` rounded to `places` decimal places, for `n` and `unit`
-- positive: what `%.Nf` prints of the quotient, without a `Float`.
fun putFixed(n : Int, unit : Int, places : Int) -> Unit {
	var scale = 1
	for var i = 0; i < places; i = i + 1 { scale = scale * 10 }
	let rounded = (n * scale + unit / 2) / unit
	putInt(rounded / scale)
	putByte(46)
	let fraction = rounded % scale
	var digit = scale / 10
	while digit > 0 {
		putByte(48 + fraction / digit % 10)
		digit = digit / 10
	}
}

-- Lowercase hexadecimal with no leading zeros, as `%p` prints an address.
fun putHex(n : Int) -> Unit {
	var shift = 60
	while shift > 0 && shiftRight(n, shift) & 15 == 0 { shift = shift - 4 }
	while shift >= 0 {
		let digit = (if shift == 0 { n } else { shiftRight(n, shift) }) & 15
		putByte(if digit < 10 { 48 + digit } else { 87 + digit })
		shift = shift - 4
	}
}

-- There is nowhere to report a failed write to.
fun writeLine() -> Unit {
	let _ = Os.write(2, text, textLength)
	textLength = 0
}

-- -- the threshold scale ----------------------------------------------------------------

-- TURKEY_GC_THRESHOLD_SCALE, or the target's default (1 on wasm32, 2
-- elsewhere) if it is unset or is not a finite decimal number of at least 1,
-- with optional surrounding whitespace.
--
-- Parsed by hand: the collector cannot build the `String` the library's parser
-- takes. Digits past the eighteenth are counted but not accumulated, and the
-- value is the mantissa scaled by powers of ten. That is not correctly
-- rounded, which a scale factor for a threshold has no use for.
fun scaleFrom(s : Ptr) -> Float {
	let fallback = match Target.os {
		Wasi -> 1.0
		_    -> 2.0
	}
	if Ptr.isNull(s) { return fallback }
	var i = skipSpace(s, 0)
	var negative = False
	if isSign(byteAt(s, i)) {
		negative = byteAt(s, i) == 45
		i = i + 1
	}
	var mantissa = 0
	var digits = 0
	var exponent = 0
	var seen = False
	while isDigit(byteAt(s, i)) {
		seen = True
		if digits < 18 {
			mantissa = mantissa * 10 + byteAt(s, i) - 48
			if mantissa != 0 { digits = digits + 1 }
		} else {
			exponent = exponent + 1
		}
		i = i + 1
	}
	if byteAt(s, i) == 46 {
		i = i + 1
		while isDigit(byteAt(s, i)) {
			seen = True
			if digits < 18 {
				mantissa = mantissa * 10 + byteAt(s, i) - 48
				if mantissa != 0 { digits = digits + 1 }
				exponent = exponent - 1
			}
			i = i + 1
		}
	}
	if !seen { return fallback }
	if isExponentMark(byteAt(s, i)) {
		var j = i + 1
		var negativeExponent = False
		if isSign(byteAt(s, j)) {
			negativeExponent = byteAt(s, j) == 45
			j = j + 1
		}
		if isDigit(byteAt(s, j)) {
			var e = 0
			while isDigit(byteAt(s, j)) {
				if e < 100000 { e = e * 10 + byteAt(s, j) - 48 }
				j = j + 1
			}
			exponent = if negativeExponent { exponent - e } else { exponent + e }
			i = j
		}
	}
	if byteAt(s, skipSpace(s, i)) != 0 { return fallback }
	var value = Float.fromInt(mantissa)
	-- A bounded exponent, but still no more steps than it takes to leave the
	-- range a `Float` holds.
	while exponent > 0 {
		if !Float.isFinite(value) { break }
		value = value * 10.0
		exponent = exponent - 1
	}
	while exponent < 0 {
		if value == 0.0 { break }
		value = value / 10.0
		exponent = exponent + 1
	}
	if negative { value = -value }
	if Float.isFinite(value) && value >= 1.0 { value } else { fallback }
}

-- TURKEY_GC_GENERATIONAL: on unless it is set to 0.
fun generationalFrom(s : Ptr) -> Bool =
	Ptr.isNull(s) || decimalFrom(s) != 0

-- TURKEY_GC_STRESS: 0 if it is unset, N if it is a decimal N of at least 1
-- with optional surrounding whitespace, and 1 if it is anything else, which
-- is how a flag set to "yes" still collects at every allocation. At most
-- 2^60, far past any interval a run could reach.
fun intervalFrom(s : Ptr) -> Int {
	if Ptr.isNull(s) { return 0 }
	let n = decimalFrom(s)
	if n < 1 { 1 } else { n }
}

-- TURKEY_GC_STRESS_SEED, or 1 if it is unset or not a decimal number; never 0,
-- which xorshift cannot leave.
fun seedFrom(s : Ptr) -> Int {
	if Ptr.isNull(s) { return 1 }
	let n = decimalFrom(s)
	if n < 1 { 1 } else { n }
}

-- The decimal number `s` holds, with optional surrounding whitespace, capped
-- at 2^60; -1 if it holds anything else.
fun decimalFrom(s : Ptr) -> Int {
	var at = skipSpace(s, 0)
	if !isDigit(byteAt(s, at)) { return -1 }
	var total = 0
	while isDigit(byteAt(s, at)) {
		total = if total > 0x1000_0000_0000_0000 / 10 {
			0x1000_0000_0000_0000
		} else {
			total * 10 + byteAt(s, at) - 48
		}
		at = at + 1
	}
	if byteAt(s, skipSpace(s, at)) != 0 { return -1 }
	if total > 0x1000_0000_0000_0000 { 0x1000_0000_0000_0000 } else { total }
}

fun byteAt(text : Ptr, offset : Int) -> Int = Byte.toInt(Ptr.load(text, offset))

fun isDigit(c : Int) -> Bool = c >= 48 && c <= 57

fun isSign(c : Int) -> Bool = c == 43 || c == 45

fun isExponentMark(c : Int) -> Bool = c == 101 || c == 69

fun skipSpace(s : Ptr, from : Int) -> Int {
	var i = from
	while isSpace(byteAt(s, i)) { i = i + 1 }
	i
}

-- C's `isspace`: space, and tab through carriage return.
fun isSpace(c : Int) -> Bool = c == 32 || (c >= 9 && c <= 13)

-- -- for the verifier -------------------------------------------------------------------

-- The state `Turkey.HeapCheck` is handed, at the offsets it names. Rewritten
-- before each check, so it is never stale. Null if there was no memory for it,
-- which the verifier reports.
var state : Ptr = Os.malloc(Check.stateBytes)

fun snapshot() -> Ptr {
	retire()
	if Ptr.isNull(state) { return state }
	Ptr.store(state, Check.stateRegions, regions)
	Ptr.store(state, Check.stateAvailable, available)
	Ptr.store(state, Check.stateRegionTable, regionTable)
	Ptr.store(state, Check.stateRegionTableCapacity, regionTableCapacity)
	Ptr.store(state, Check.stateRegionTableCount, regionTableCount)
	Ptr.store(state, Check.stateRegionBytes, regionBytesInUse)
	Ptr.store(state, Check.stateSpare, spare)
	Ptr.store(state, Check.stateSpareCount, spareCount)
	Ptr.store(state, Check.stateObjects, heapCount)
	Ptr.store(state, Check.stateSizesKept, if sizesKept { 1 } else { 0 })
	Ptr.store(state, Check.stateFrameEntries, frameEntries)
	Ptr.store(state, Check.stateFrameEntryCount, frameEntryCount)
	Ptr.store(state, Check.stateStacks, Stack.first())
	Ptr.store(state, Check.stateRunning, Stack.running())
	Ptr.store(state, Check.stateRoots, roots)
	Ptr.store(state, Check.stateGenerational, if generational { 1 } else { 0 })
	Ptr.store(state, Check.stateRemembered, remembered())
	Ptr.store(state, Check.stateRememberedCount, rememberedCount())
	Ptr.store(state, Check.stateStaticStart, staticStart)
	Ptr.store(state, Check.stateStaticBytes, staticBytes)
	state
}

fun verifyAt(phase : Check.Phase, frame : Ptr) -> Unit = Check.verify(phase, frame, snapshot())

-- -- for C ------------------------------------------------------------------------------
--
-- What the runtime's C tests read of this state, and the settings they change.
-- None of these traces, marks or looks anything up on the collector's behalf
-- for the verifier, whose worth is that it does those its own way.

-- The verifier's snapshot, for the tests that call it directly.
foreign "turkey_heap_state" fun heapState() -> Ptr = snapshot()

foreign "turkey_heap_objects" fun heapObjects() -> Int {
	retire()
	heapCount
}

foreign "turkey_collection_count" fun collectionCount() -> Int = collections

-- `enabled` is a C `int`: only its low half is defined.
foreign "turkey_gc_set_stress" fun setStress(enabled : Int) -> Unit {
	retire()
	stress = enabled & 0xFFFF_FFFF != 0
	stressInterval = if stress { 1 } else { 0 }
	stressCountdown = 1
	pollWordSet(stress)
}

foreign "turkey_gc_set_verify" fun setVerify(enabled : Int) -> Unit {
	verify = enabled & 0xFFFF_FFFF != 0
}

-- A minor collection, if minor collections are on, for the tests of what one
-- keeps; `turkey_collect` is always full.
foreign "turkey_collect_minor" fun collectMinor() -> Unit =
	collectFrom(Ptr.null(), Minor)

foreign "turkey_gc_set_generational" fun setGenerational(enabled : Int) -> Unit {
	generational = enabled & 0xFFFF_FFFF != 0
}

foreign "turkey_heap_regions" fun heapRegions() -> Ptr = regions

foreign "turkey_heap_available" fun heapAvailable() -> Ptr = available

foreign "turkey_heap_region_bytes" fun heapRegionBytes() -> Int = regionBytesInUse

foreign "turkey_heap_spare_bytes" fun heapSpareBytes() -> Int = spareCount * regionBytes

foreign "turkey_heap_region_table" fun heapRegionTable() -> Ptr = regionTable

foreign "turkey_heap_region_table_capacity" fun heapRegionTableCapacity() -> Int =
	regionTableCapacity

-- Whether `value` is a live object, for the tests' questions about reuse and
-- reclamation.
foreign "turkey_heap_contains" fun heapContains(value : Ptr) -> Int {
	retire()
	if Ptr.isNull(findObject(value)) { 0 } else { 1 }
}

-- For the tests that corrupt the heap on purpose, to see the verifier notice.
foreign "turkey_heap_set_objects" fun setHeapObjects(count : Int) -> Unit {
	retire()
	heapCount = count
}

foreign "turkey_heap_set_region_bytes" fun setRegionBytes(bytes : Int) -> Unit {
	regionBytesInUse = bytes
}
