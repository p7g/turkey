export (
    Phase(..), verify, stateBytes, stateRegions, stateAvailable, stateRegionTable,
    stateRegionTableCapacity, stateRegionTableCount, stateRegionBytes, stateObjects,
    stateSizesKept, stateFrameEntries, stateFrameEntryCount, stateStacks,
    stateRoots, stateGenerational, stateRemembered, stateRememberedCount,
    stateRunning,
)

-- The heap verifier: in a program compiled with `--gc-verify`, the collector
-- calls `verify` before marking, after marking and before sweeping, and after
-- sweeping, and a heap that fails is reported and the process ends.
--
-- Its worth is that it is separate code reading the heap its own way, so that a
-- collector bug is not checked by the same bug. That holds only while:
--
-- * it decodes pointer membership, object layouts and roots itself, and never
--   calls the collector's tracing, marking or lookup helpers;
-- * it is written against the heap's *format* -- the region, header, object,
--   size-table and root-frame layouts, the layout codes and the frame table,
--   copied below -- and not against how the collector happens to walk them.
--
-- The first is structural: `Turkey.Heap` imports this module, so this one
-- cannot import it back. What it knows of the collector is what it is handed,
-- a snapshot of the collector's state as words at the offsets below. So a
-- helper here that looks like one in `Turkey.Heap` is a copy on purpose, and
-- must not move somewhere both can import: that would make a check of the
-- collector by the collector, which passes whenever the collector is
-- consistently wrong.
--
-- What it checks is closure of the marked set: if every root is marked and
-- every edge out of a marked object is marked, every reachable object is
-- marked. It never changes a mark.
--
-- And the generational invariants the minor collections rest on: an object is
-- marked between collections exactly when it is old; an old object holding a
-- young one is remembered; and after a sweep every object is old. "Marked" is
-- the region's mark bit, the only record of a mark there is: a minor
-- collection keeps the old objects' bits and sets the young ones' it reaches.
--
-- And, in a program compiled with `--gc-verify`, that every object fits its
-- slot and has its slot's size class, by the size every allocation records in
-- its region's size table: generated code chooses the class of what it
-- allocates by its own copy of the rule, so this is what says the two agree.
--
-- Compiler-emitted layouts and roots are still trusted descriptions -- a root
-- the compiler omitted cannot be reconstructed -- and the region list and
-- root chains must be readable: this diagnoses the runtime's invariants, not
-- arbitrary corruption of the address space.
--
-- A giblet module: it runs inside a collection, when nothing may allocate.
-- Every value is an `Int`, a `Bool` or a `Prim.Ptr`, the scratch it needs is
-- malloc'ed, and a failure is formatted by hand and written to fd 2.
--
-- The trap `Turkey.Heap` describes applies here too: a caller's `var` that
-- shares a name with a local or parameter of something inlined into it is given
-- a heap cell, which the giblet check refuses.

import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)
import Data.Eq (Eq(..), (==), (!=))
import Data.Ord (Ord(..), (<), (<=), (>), (>=))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..), (+), (-), (*), (/), (%))
import Data.Error (Error(..))
import Data.Int ()
import Data.Bool (Bool(..))
import Turkey.Libc as Libc

-- -- what the collector hands over --------------------------------------------------
--
-- One word each: the region list, the per-class available lists, the region
-- set's table, its capacity and its count, the bytes the regions reserve, the
-- objects allocated, whether the regions keep size tables, the frame table
-- and its length, the list of stacks, the innermost shadow-stack frame,
-- whether the program runs the write barrier (and so whether an old object
-- holding a young one must be remembered), the remembered objects and their
-- count, and the stack the mutator is running on.

let stateBytes : Int = 128
let stateRegions : Int = 0
let stateAvailable : Int = 8
let stateRegionTable : Int = 16
let stateRegionTableCapacity : Int = 24
let stateRegionTableCount : Int = 32
let stateRegionBytes : Int = 40
let stateObjects : Int = 48
let stateSizesKept : Int = 56
let stateFrameEntries : Int = 64
let stateFrameEntryCount : Int = 72
let stateStacks : Int = 80
let stateRoots : Int = 88
let stateGenerational : Int = 96
let stateRemembered : Int = 104
let stateRememberedCount : Int = 112
let stateRunning : Int = 120

-- -- the heap's format ----------------------------------------------------------------

-- An object's header, the word its address points at: the generation (u8),
-- the kind (u8), the count of the traced words its fields start with (u16),
-- and the tag (i32). An array has its element's layout code in the count's
-- place, and a cell 1 if its value is traced and 0 if not.
--
-- The generation's values: young, old, and old and remembered.
let young : Int = 0
let old : Int = 1
let rememberedOld : Int = 2
-- Traced words below this are immediates, not pointers.
let immediates : Int = 4096

-- The kinds: 0 constructor, 1 record, 2 array, 3 closure, 4 environment and
-- 5 cell.
let arrayKind : Int = 2
let closureKind : Int = 3
let cellKind : Int = 5

-- Where an object's fields start, after the header. A cell's one field is its
-- value. An array's is its length, and its elements follow.
let objectFields : Int = 8
let cellBytes : Int = 16
let closureBytes : Int = 24
let arrayLength : Int = 8
let arrayElements : Int = 16
-- The largest object a size class holds; a larger one has a region of its own.
let smallBytes : Int = 32768

-- A region. Small regions are 64KB, aligned to their size, with `capacity`
-- slots of their size class; a large region is a whole number of 64KB blocks
-- holding one object, of class `regionClasses`.
let regionBytes : Int = 0x10000
let regionWords : Int = 64
let regionClasses : Int = 26
let regionNext : Int = 0
let regionAvailableNext : Int = 8
let regionSlotSize : Int = 16
let regionReserved : Int = 24
let regionCapacity : Int = 32
let regionUsed : Int = 36
let regionLive : Int = 40
let regionSearchWord : Int = 44
let regionSizeClass : Int = 48
let regionAllocated : Int = 56
let regionMarked : Int = 568
-- The size table: a word per eight bytes of the region's first 64KB, holding
-- the size of the object at that offset; null in a program compiled without
-- `--gc-verify`.
let regionSizes : Int = 1080
let regionData : Int = 1088

-- A shadow-stack frame: the previous frame, the function's name, the slot
-- count, the slots, and which of the first 64 slots are live. Slots from 64 up
-- are always live.
let rootPrevious : Int = 0
let rootCount : Int = 16
let rootValues : Int = 24
let rootLive : Int = 32

-- A frame-table entry, sorted by return address: the address, how many roots
-- are live across the call, and their offsets from the caller's `x29`.
let entryBytes : Int = 24

-- A stack: the outermost frame record a walk of it may reach, the record it was
-- parked at (null while it runs or before it has run), and the next stack.
let stackHigh : Int = 0
let stackParked : Int = 8
let stackNext : Int = 16

-- Bigger than any region or slot can be on a 64-bit address space, and small
-- enough that the sum of two such values stays inside an `Int`. A slot's
-- offset, its index times the slot size, is below the region's size once the
-- capacity has been checked against it.
let sizeBound : Int = 0x4000_0000_0000_0000

-- -- state ----------------------------------------------------------------------------

-- The regions, sorted by address, for membership: rebuilt at each check.
var index : Prim.Ptr = Prim.ptrNull()
var indexCount : Int = 0

-- One check's settings, and the collector's state it was handed.
var state : Prim.Ptr = Prim.ptrNull()
var phase : Phase = BeforeMarking
var sizesKept : Bool = False
var barriers : Bool = False
-- The objects whose generation says they are remembered, as counted.
var rememberedSeen : Int = 0
var entries : Prim.Ptr = Prim.ptrNull()
var entryCount : Int = 0

-- Per size class, how many regions have room, and how many the available
-- lists hold: set to zero by each check before it counts.
var expected : Prim.Ptr = Libc.malloc(8 * regionClasses)
var actual : Prim.Ptr = Libc.malloc(8 * regionClasses)

-- The diagnostic, NUL-terminated. If there was no memory for it, a failure is
-- still a failure, and ends the process unexplained.
let textBytes : Int = 256
var text : Prim.Ptr = Libc.malloc(textBytes)
var textLength : Int = 0

-- -- the entry points -----------------------------------------------------------------

-- Where in a collection a check is made.
type Phase = BeforeMarking | BeforeSweeping | AfterSweeping

-- Whether marking has run, so a reached object is marked by now.
fun afterMarking() -> Bool = match phase {
    BeforeMarking -> False
    BeforeSweeping -> True
    AfterSweeping -> True
}

fun beforeSweeping() -> Bool = match phase {
    BeforeSweeping -> True
    _ -> False
}

fun afterSweeping() -> Bool = match phase {
    AfterSweeping -> True
    _ -> False
}

-- A phase as C numbers it: 0 before marking, 1 before sweeping, 2 after.
fun phaseOf(when : Int) -> Phase =
    if when == 0 { BeforeMarking } else if when == 1 { BeforeSweeping } else { AfterSweeping }

-- Check the heap at `when` for a collection whose Turkey stack starts at
-- `frame`, and end
-- the process with status 1 if it fails. A corrupt heap is not something to
-- unwind through: an entry initializer may dereference an allocation result
-- before it can see a panic.
--
-- With a panic pending this checks nothing, because Turkey code unwinds at
-- every call while the flag is up. Nor does the collector mark or sweep then,
-- for the same reason, so there is nothing for a check to catch.
fun verify(when : Phase, frame : Prim.Ptr, handed : Prim.Ptr) -> Unit {
    if check(when, frame, handed) { return {} }
    if !Prim.ptrIsNull(text) {
        putByte(10)
        let _ = Libc.write(2, text, textLength)
    }
    Libc.exit(1)
}

-- The same check, answering 1 if it passes and 0 with `message` set if not:
-- for the tests that corrupt the heap on purpose, which take the state from
-- `turkey_heap_state`.
foreign "turkey_heap_check" fun checkForTests(when : Int, frame : Prim.Ptr,
                                              handed : Prim.Ptr) -> Int =
    if check(phaseOf(when), frame, handed) { 1 } else { 0 }

foreign "turkey_heap_check_message" fun message() -> Prim.Ptr = text

-- The native frame walk alone, from `current`: for a test that builds stacks
-- and a frame table and puts them in the state it hands over.
foreign "turkey_heap_check_frames" fun checkFramesForTests(when : Int, current : Int,
                                                          handed : Prim.Ptr) -> Int {
    if !begin(phaseOf(when), handed) { return 0 }
    let passed = checkFrames(current)
    releaseIndex()
    if passed { 1 } else { 0 }
}

fun check(when : Phase, frame : Prim.Ptr, handed : Prim.Ptr) -> Bool {
    if !begin(when, handed) { return False }
    let passed = checkRegions() && checkTable() && checkObjects() && checkRemembered()
                 && checkAvailable() && checkRoots()
                 && checkFrames(Prim.ptrToInt(frame))
    releaseIndex()
    passed
}

-- Take the state, and index its regions.
fun begin(when : Phase, handed : Prim.Ptr) -> Bool {
    textLength = 0
    if Prim.ptrIsNull(handed) || Prim.ptrIsNull(expected) || Prim.ptrIsNull(actual) {
        return fail(Prim.cString("out of memory"), 0, -1)
    }
    state = handed
    phase = when
    sizesKept = stateWord(stateSizesKept) != 0
    barriers = stateWord(stateGenerational) != 0
    entries = Prim.loadPtr(state, stateFrameEntries)
    entryCount = stateWord(stateFrameEntryCount)
    buildIndex()
}

fun stateWord(offset : Int) -> Int = Prim.loadI64(state, offset)

-- -- the diagnostic -------------------------------------------------------------------

-- "heap verifier: <reason> (at 0x<owner>, slot <at>)", and False.
fun fail(reason : Prim.Ptr, owner : Int, at : Int) -> Bool {
    if Prim.ptrIsNull(text) { return False }
    textLength = 0
    put(Prim.cString("heap verifier: "))
    put(reason)
    put(Prim.cString(" (at 0x"))
    putHex(owner)
    put(Prim.cString(", slot "))
    putInt(at)
    putByte(41)
    Prim.storeI8(text, textLength, Prim.byteFromInt(0))
    False
}

fun failAt(reason : Prim.Ptr, owner : Prim.Ptr, at : Int) -> Bool =
    fail(reason, Prim.ptrToInt(owner), at)

-- Two bytes are kept free: one for the NUL, and one for the newline `verify`
-- writes in its place.
fun putByte(byte : Int) -> Unit {
    if textLength < textBytes - 2 {
        Prim.storeI8(text, textLength, Prim.byteFromInt(byte))
        textLength = textLength + 1
    }
}

fun put(s : Prim.Ptr) -> Unit {
    var k = 0
    while Prim.byteToInt(Prim.loadI8(s, k)) != 0 {
        putByte(Prim.byteToInt(Prim.loadI8(s, k)))
        k = k + 1
    }
}

fun putInt(n : Int) -> Unit {
    if n < 0 {
        putByte(45)
        putDigits(n)
    } else {
        putDigits(Prim.intNeg(n))
    }
}

-- The digits of `-n`, for `n <= 0`, which the most negative `Int` has.
fun putDigits(n : Int) -> Unit {
    if n <= -10 { putDigits(n / 10) }
    putByte(48 - n % 10)
}

fun putHex(n : Int) -> Unit {
    var place = 60
    while place > 0 && nibble(n, place) == 0 { place = place - 4 }
    while place >= 0 {
        let digit = nibble(n, place)
        putByte(if digit < 10 { 48 + digit } else { 87 + digit })
        place = place - 4
    }
}

fun nibble(n : Int, shift : Int) -> Int = Prim.intAnd(Prim.intShr(n, shift), 15)

-- -- words ----------------------------------------------------------------------------

fun load32(p : Prim.Ptr, offset : Int) -> Int = Prim.charToInt(Prim.loadI32(p, offset))

-- The header's fields, from the object at `h`.
fun generationOf(h : Int) -> Int = Prim.intAnd(load32(Prim.ptrFromInt(h), 0), 255)
fun kindOf(h : Int) -> Int = Prim.intAnd(Prim.intShr(load32(Prim.ptrFromInt(h), 0), 8), 255)
fun countOf(h : Int) -> Int = Prim.intShr(load32(Prim.ptrFromInt(h), 0), 16)

fun word(address : Int, offset : Int) -> Int =
    Prim.loadI64(Prim.ptrFromInt(address), offset)

-- Unsigned `a < b`: a word claimed to be a pointer need not fit in 63 bits.
fun below(a : Int, b : Int) -> Bool =
    if Prim.intXor(a, b) < 0 { b < 0 } else { a < b }

fun hasBit(bits : Int, at : Int) -> Bool = Prim.intAnd(Prim.intShr(bits, at), 1) != 0

fun bitAt(base : Int, offset : Int, at : Int) -> Bool =
    hasBit(word(base, offset + 8 * (at / 64)), at % 64)

-- -- the region index -----------------------------------------------------------------

-- The region list, checked for a cycle and copied into `index` in address
-- order. False, with the failure recorded, if it cannot be.
fun buildIndex() -> Bool {
    index = Prim.ptrNull()
    indexCount = 0
    let first = stateWord(stateRegions)
    var tortoise = first
    var hare = first
    while hare != 0 && word(hare, regionNext) != 0 {
        tortoise = word(tortoise, regionNext)
        hare = word(word(hare, regionNext), regionNext)
        if tortoise == hare { return fail(Prim.cString("cyclic region chain"), tortoise, -1) }
    }
    var found = 0
    var walk = first
    while walk != 0 {
        found = found + 1
        walk = word(walk, regionNext)
    }
    if found == 0 { return True }
    let table = Libc.malloc(8 * found)
    if Prim.ptrIsNull(table) { return fail(Prim.cString("out of memory"), 0, -1) }
    var filled = 0
    var copied = first
    while copied != 0 {
        Prim.storeI64(table, 8 * filled, copied)
        filled = filled + 1
        copied = word(copied, regionNext)
    }
    sortRegions(table, found)
    index = table
    indexCount = found
    True
}

fun releaseIndex() -> Unit {
    if !Prim.ptrIsNull(index) { Libc.free(index) }
    index = Prim.ptrNull()
    indexCount = 0
}

fun indexAt(at : Int) -> Int = Prim.loadI64(index, 8 * at)

-- Heapsort, in place and without recursion.
fun sortRegions(table : Prim.Ptr, n : Int) -> Unit {
    var top = n / 2
    while top > 0 {
        top = top - 1
        sink(table, top, n)
    }
    var last = n
    while last > 1 {
        last = last - 1
        exchange(table, 0, last)
        sink(table, 0, last)
    }
}

fun sink(table : Prim.Ptr, from : Int, n : Int) -> Unit {
    var parent = from
    while 2 * parent + 1 < n {
        var larger = 2 * parent + 1
        if larger + 1 < n && below(Prim.loadI64(table, 8 * larger),
                                   Prim.loadI64(table, 8 * (larger + 1))) {
            larger = larger + 1
        }
        if !below(Prim.loadI64(table, 8 * parent), Prim.loadI64(table, 8 * larger)) {
            return {}
        }
        exchange(table, parent, larger)
        parent = larger
    }
}

fun exchange(table : Prim.Ptr, a : Int, b : Int) -> Unit {
    let saved = Prim.loadI64(table, 8 * a)
    Prim.storeI64(table, 8 * a, Prim.loadI64(table, 8 * b))
    Prim.storeI64(table, 8 * b, saved)
}

-- The last region at or below `address`, or 0 if there is none: the only one
-- that could hold it.
fun regionAt(address : Int) -> Int {
    var low = 0
    var high = indexCount
    while low < high {
        let middle = low + (high - low) / 2
        if below(address, indexAt(middle)) { high = middle } else { low = middle + 1 }
    }
    if low == 0 { 0 } else { indexAt(low - 1) }
}

fun listed(region : Int) -> Bool = region != 0 && regionAt(region) == region

-- -- regions --------------------------------------------------------------------------

-- Each region's geometry, bitmaps and counts, and the heap's totals. Runs
-- before anything looks a pointer up, which trusts what it establishes: that
-- every listed region's size, slot size and capacity are consistent, and so
-- that every slot below the capacity is inside the region.
fun checkRegions() -> Bool {
    var regionTotal = 0
    var objectTotal = 0
    for var ri = 0; ri < indexCount; ri = ri + 1 {
        let r = indexAt(ri)
        let reserved = word(r, regionReserved)
        let slotSize = word(r, regionSlotSize)
        let capacity = load32(Prim.ptrFromInt(r), regionCapacity)
        let used = load32(Prim.ptrFromInt(r), regionUsed)
        let cls = load32(Prim.ptrFromInt(r), regionSizeClass)
        let search = load32(Prim.ptrFromInt(r), regionSearchWord)
        if Prim.intAnd(r, regionBytes - 1) != 0
                || below(reserved, regionBytes) || !below(reserved, sizeBound)
                || Prim.intAnd(reserved, regionBytes - 1) != 0
                || below(slotSize, objectFields) || !below(slotSize, sizeBound)
                || capacity == 0 || capacity > regionWords * 64
                || capacity > (reserved - regionData) / slotSize
                || used > capacity || cls > regionClasses || search >= regionWords {
            return fail(Prim.cString("invalid region geometry"), r, -1)
        }
        let classOk = if cls < regionClasses {
            reserved == regionBytes && slotSize == classSlot(cls)
                && capacity == (regionBytes - regionData) / classSlot(cls)
        } else { capacity == 1 }
        if !classOk { return fail(Prim.cString("invalid region size class"), r, -1) }
        if sizesKept && word(r, regionSizes) == 0 {
            return fail(Prim.cString("region has no size table"), r, -1)
        }
        for var wi = 0; wi < search; wi = wi + 1 {
            if word(r, regionAllocated + 8 * wi) != -1 {
                return fail(Prim.cString("allocation search skips free slots"), r, wi)
            }
        }
        if ri > 0 {
            let previous = indexAt(ri - 1)
            if below(r - previous, word(previous, regionReserved)) {
                return fail(Prim.cString("overlapping regions"), r, -1)
            }
        }
        if regionTotal > sizeBound { return fail(Prim.cString("region byte count overflow"), r, -1) }
        regionTotal = regionTotal + reserved
        if !checkSlots(r, capacity, slotSize) { return False }
        objectTotal = objectTotal + used
    }
    let counted = stateWord(stateObjects)
    if counted < 0 || objectTotal != counted || regionTotal != stateWord(stateRegionBytes) {
        return fail(Prim.cString("heap totals disagree"), 0, -1)
    }
    True
}

-- Every bit of a region's two bitmaps against its capacity, its counts and
-- the generations of the objects it holds.
fun checkSlots(r : Int, capacity : Int, slotSize : Int) -> Bool {
    var usedSeen = 0
    var liveSeen = 0
    for var si = 0; si < regionWords * 64; si = si + 1 {
        let allocated = bitAt(r, regionAllocated, si)
        let marked = bitAt(r, regionMarked, si)
        if (si >= capacity && allocated) || (marked && !allocated) {
            return fail(Prim.cString("marked/free slot or bitmap outside region"), r, si)
        }
        if allocated {
            usedSeen = usedSeen + 1
            if marked { liveSeen = liveSeen + 1 }
            let h = r + regionData + si * slotSize
            let generation = generationOf(h)
            if generation != young && generation != old && generation != rememberedOld {
                return fail(Prim.cString("invalid generation"), h, si)
            }
            if !beforeSweeping() && marked != (generation != young) {
                return fail(Prim.cString("region marks and generation disagree"), h, si)
            }
            if afterSweeping() && !marked {
                return fail(Prim.cString("unmarked sweep survivor"), h, si)
            }
            if afterSweeping() && generation != old {
                return fail(Prim.cString("young or remembered sweep survivor"), h, si)
            }
        }
    }
    let p = Prim.ptrFromInt(r)
    if usedSeen != load32(p, regionUsed) || liveSeen != load32(p, regionLive) {
        return fail(Prim.cString("region counts disagree"), r, -1)
    }
    True
}

-- The open-addressed set of region bases holds exactly the listed regions,
-- each reachable by linear probing from its home slot: no empty slot between
-- the home and the entry.
fun checkTable() -> Bool {
    let table = Prim.loadPtr(state, stateRegionTable)
    let capacity = stateWord(stateRegionTableCapacity)
    let count = stateWord(stateRegionTableCount)
    if count != indexCount || capacity < 0 || Prim.intAnd(capacity, capacity - 1) != 0
            || (indexCount > 0 && count * 2 > capacity) {
        return failAt(Prim.cString("region table disagrees with region list"), table, -1)
    }
    var entriesSeen = 0
    for var ti = 0; ti < capacity; ti = ti + 1 {
        let r = Prim.loadI64(table, 8 * ti)
        if r != 0 {
            entriesSeen = entriesSeen + 1
            if !listed(r) {
                return fail(Prim.cString("region table holds an unlisted region"), r, ti)
            }
            var probe = home(r, capacity)
            while probe != ti {
                if Prim.loadI64(table, 8 * probe) == 0 {
                    return fail(Prim.cString("region table entry unreachable by probing"), r, ti)
                }
                probe = Prim.intAnd(probe + 1, capacity - 1)
            }
        }
    }
    if entriesSeen != indexCount {
        return failAt(Prim.cString("region table disagrees with region list"), table, -1)
    }
    True
}

-- Fibonacci hashing of the region's number, masked to the table: the same
-- function the collector inserts with, restated.
fun home(region : Int, capacity : Int) -> Int {
    let h = Prim.intMulWrapping(Prim.intShr(region, 16), -7046029254386353131)
    let folded = Prim.intXor(h, Prim.intAnd(Prim.intShr(h, 32), 0xFFFF_FFFF))
    Prim.intAnd(folded, capacity - 1)
}

-- Every allocated object's size, header and layout, and each pointer in it.
fun checkObjects() -> Bool {
    rememberedSeen = 0
    for var oi = 0; oi < indexCount; oi = oi + 1 {
        let r = indexAt(oi)
        let capacity = load32(Prim.ptrFromInt(r), regionCapacity)
        let slotSize = word(r, regionSlotSize)
        let cls = load32(Prim.ptrFromInt(r), regionSizeClass)
        for var oj = 0; oj < capacity; oj = oj + 1 {
            if bitAt(r, regionAllocated, oj) {
                let h = r + regionData + oj * slotSize
                if sizesKept && !checkSize(r, h, slotSize, cls) { return False }
                if !checkObject(r, oj, h, slotSize) { return False }
            }
        }
    }
    True
}

-- The object at `h`, in region `r` of class `cls` with slots of `slotSize`,
-- fits its slot and has the slot's class, by the size its allocation
-- recorded.
fun checkSize(r : Int, h : Int, slotSize : Int, cls : Int) -> Bool {
    let size = sizeOf(r, h)
    if below(slotSize, size) { return fail(Prim.cString("object exceeds allocation slot"), h, -1) }
    let classed = if cls < regionClasses { ofClass(size, cls) } else { below(smallBytes, size) }
    if !classed { return fail(Prim.cString("object in another size class's slot"), h, -1) }
    True
}

-- The size recorded for the object at `h` in region `r`'s size table.
fun sizeOf(r : Int, h : Int) -> Int = word(word(r, regionSizes), h - r)

-- The bytes between one slot of a small class and the next.
fun classSlot(cls : Int) -> Int =
    if cls < 7 { 16 + 8 * cls }
    else if cls < 19 { 64 + 16 * (cls - 6) }
    else { Prim.intShl(256, cls - 18) }

-- Whether an object of `size` bytes has the size class `cls`: its size,
-- rounded up to 8, fits that class's slot and not the class below's. The
-- collector and generated code each choose the class of what they allocate,
-- by their own copies of one rule, and this is what says the two agree.
fun ofClass(size : Int, cls : Int) -> Bool {
    if !below(size, regionBytes) { return False }
    let bytes = Prim.intAnd(size + 7, -8)
    bytes <= classSlot(cls) && (cls == 0 || bytes > classSlot(cls - 1))
}

-- Each size class's available list names exactly the small regions of that
-- class with a free slot. A full region's `availableNext` is stale and not
-- looked at.
fun checkAvailable() -> Bool {
    let lists = Prim.loadPtr(state, stateAvailable)
    for var ac = 0; ac < regionClasses; ac = ac + 1 {
        Prim.storeI64(expected, 8 * ac, 0)
        Prim.storeI64(actual, 8 * ac, 0)
    }
    for var an = 0; an < indexCount; an = an + 1 {
        let p = Prim.ptrFromInt(indexAt(an))
        let cls = load32(p, regionSizeClass)
        if cls < regionClasses && load32(p, regionUsed) < load32(p, regionCapacity) {
            Prim.storeI64(expected, 8 * cls, Prim.loadI64(expected, 8 * cls) + 1)
        }
    }
    for var ac = 0; ac < regionClasses; ac = ac + 1 {
        var ar = Prim.loadI64(lists, 8 * ac)
        while ar != 0 {
            let seen = Prim.loadI64(actual, 8 * ac) + 1
            Prim.storeI64(actual, 8 * ac, seen)
            -- Membership before anything is read from it: the list may hold a
            -- word that is not a region at all.
            if seen > indexCount || !listed(ar)
                    || load32(Prim.ptrFromInt(ar), regionSizeClass) != ac
                    || load32(Prim.ptrFromInt(ar), regionUsed)
                       >= load32(Prim.ptrFromInt(ar), regionCapacity) {
                return fail(Prim.cString("invalid available-region list"), ar, ac)
            }
            ar = word(ar, regionAvailableNext)
        }
        if Prim.loadI64(actual, 8 * ac) != Prim.loadI64(expected, 8 * ac) {
            return fail(Prim.cString("missing available region"), 0, ac)
        }
    }
    True
}

-- -- objects --------------------------------------------------------------------------

-- The object at `h`, slot `slot` of region `r`, which `checkRegions` has
-- bounded at `slotSize` bytes.
--
-- An array's count is its element's layout code, which gives the element's
-- width; code 7 is a traced pointer, and 6 a raw address that must not be
-- followed. Any other object's count is the number of traced words its fields
-- start with, and its fields are a whole number of words. A closure is its
-- environment and then its code's address. Read from the header and the size
-- table alone, by this module's own rules: nothing here knows what the
-- compiler put in which field.
fun checkObject(r : Int, slot : Int, h : Int, slotSize : Int) -> Bool {
    let kind = kindOf(h)
    let count = countOf(h)
    let marked = afterMarking() && bitAt(r, regionMarked, slot)
    let generation = generationOf(h)
    if generation == rememberedOld { rememberedSeen = rememberedSeen + 1 }
    -- Between collections, with the barrier emitted: an old object that is
    -- not remembered holds no young one.
    let unremembered = !afterMarking() && barriers && generation == old
    -- The bytes the object may span: its recorded size, or its slot's.
    let size = if sizesKept { sizeOf(r, h) } else { slotSize }
    if kind > cellKind { return fail(Prim.cString("invalid object header"), h, -1) }
    if kind == cellKind {
        if count > 1 { return fail(Prim.cString("invalid object header"), h, -1) }
        if sizesKept && size != cellBytes { return fail(Prim.cString("invalid cell size"), h, -1) }
        let value = word(h, objectFields)
        return count == 0
            || (checkPointer(value, marked, h, 0) && (!unremembered || notYoung(value, h, 0)))
    }
    -- The words to check, from the first at `first`.
    var first = objectFields
    var traced = count
    if kind == arrayKind {
        let length = word(h, arrayLength)
        if count > 7 { return fail(Prim.cString("invalid array layout"), h, -1) }
        if length < 0 { return fail(Prim.cString("invalid object header"), h, -1) }
        let width = elementWidth(count)
        -- `size` is below a slot's size, so neither side of this can overflow.
        if size < arrayElements || length > (size - arrayElements) / width
                || (sizesKept && arrayElements + length * width != size) {
            return fail(Prim.cString("payload size disagrees with header"), h, -1)
        }
        first = arrayElements
        traced = if count == 7 { length } else { 0 }
    } else {
        if size < objectFields || size % 8 != 0 {
            return fail(Prim.cString("payload size disagrees with header"), h, -1)
        }
        if count > (size - objectFields) / 8
                || (kind == closureKind && (count != 1 || (sizesKept && size != closureBytes))) {
            return fail(Prim.cString("invalid object descriptor"), h, -1)
        }
    }
    for var field = 0; field < traced; field = field + 1 {
        let child = word(h, first + 8 * field)
        if !checkPointer(child, marked, h, field) { return False }
        if unremembered && !notYoung(child, h, field) { return False }
    }
    True
}

-- Bytes one element of an array occupies, by its layout code: a byte, a
-- 32-bit word, or a word for every other code.
fun elementWidth(code : Int) -> Int = if code == 2 { 1 } else if code == 3 { 4 } else { 8 }

-- `value`, found at slot `at` of `owner`, is an immediate or an allocated
-- object; if `marked`, that object is marked too.
--
-- An immediate is a word below the first page's end: null, or a compact sum's
-- nullary constructor, which generated code stores in traced slots as a small
-- integer. The collector skips the same range.
fun checkPointer(value : Int, marked : Bool, owner : Int, at : Int) -> Bool {
    if below(value, immediates) { return True }
    let r = regionAt(value)
    if r == 0 || below(value, r + regionData) {
        return fail(Prim.cString("invalid traced pointer"), owner, at)
    }
    let offset = Prim.intSubWrapping(value, r + regionData)
    let slotSize = word(r, regionSlotSize)
    -- Past the region's reservation is past its last slot, and keeps the
    -- division below on a small positive `offset`.
    if !below(offset, word(r, regionReserved)) || offset % slotSize != 0 {
        return fail(Prim.cString("invalid traced pointer"), owner, at)
    }
    let slot = offset / slotSize
    if slot >= load32(Prim.ptrFromInt(r), regionCapacity) || !bitAt(r, regionAllocated, slot) {
        return fail(Prim.cString("invalid traced pointer"), owner, at)
    }
    if marked && !bitAt(r, regionMarked, slot) {
        return fail(Prim.cString("reachable object is unmarked"), owner, at)
    }
    True
}

-- `value`, a pointer `checkPointer` has accepted, found at slot `at` of an old
-- object that is not remembered, is not a young object.
fun notYoung(value : Int, owner : Int, at : Int) -> Bool {
    if below(value, immediates) { return True }
    if generationOf(value) != young { return True }
    fail(Prim.cString("old object holds a young one and is not remembered"), owner, at)
}

-- Before marking: the remembered objects are allocated, each says it is
-- remembered, and there are as many as there are objects that say so. That is
-- not quite that the two sets are equal -- an entry twice and another missing
-- would pass -- but the collector adds an object only as it changes its word,
-- so a repeat needs the word to have been reset in between, which only a
-- collection does.
--
-- Not after: marking consumes the set, and on a full collection a dead object
-- still says it is remembered until the sweep frees it. After the sweep no
-- object is, which `checkSlots` checks.
fun checkRemembered() -> Bool {
    if afterMarking() { return True }
    let count = stateWord(stateRememberedCount)
    let entries = Prim.loadPtr(state, stateRemembered)
    if count != rememberedSeen {
        return fail(Prim.cString("remembered objects miscounted"), count, rememberedSeen)
    }
    for var ei = 0; ei < count; ei = ei + 1 {
        let value = Prim.loadI64(entries, 8 * ei)
        if below(value, immediates) || !checkPointer(value, False, Prim.ptrToInt(entries), ei) {
            return fail(Prim.cString("invalid remembered object"), Prim.ptrToInt(entries), ei)
        }
        if generationOf(value) != rememberedOld {
            return fail(Prim.cString("remembered object is not marked remembered"),
                        Prim.ptrToInt(entries), ei)
        }
    }
    True
}

-- -- roots ----------------------------------------------------------------------------

-- The shadow stack, checked for a cycle first, then every live slot of every
-- frame.
fun checkRoots() -> Bool {
    let first = stateWord(stateRoots)
    var behind = first
    var ahead = first
    while ahead != 0 && word(ahead, rootPrevious) != 0 {
        behind = word(behind, rootPrevious)
        ahead = word(word(ahead, rootPrevious), rootPrevious)
        if behind == ahead { return fail(Prim.cString("cyclic root chain"), behind, -1) }
    }
    var rf = first
    while rf != 0 {
        let count = word(rf, rootCount)
        let values = word(rf, rootValues)
        let live = word(rf, rootLive)
        if count < 0 || values == 0 { return fail(Prim.cString("invalid root frame"), rf, -1) }
        for var rs = 0; rs < count; rs = rs + 1 {
            if (rs >= 64 || hasBit(live, rs))
                    && !checkPointer(word(values, 8 * rs), afterMarking(), rf, rs) {
                return False
            }
        }
        rf = word(rf, rootPrevious)
    }
    True
}

-- The frame table's shape, then every stack's arm64 frames: the running
-- stack's from `current`, the collection's Turkey frame record or 0 if none is
-- live, and each other stack's from the record it was parked at.
fun checkFrames(current : Int) -> Bool {
    if entryCount == 0 { return True }
    if entryCount < 0 || Prim.ptrIsNull(entries) {
        return failAt(Prim.cString("invalid native frame table"), entries, -1)
    }
    for var fi = 0; fi < entryCount; fi = fi + 1 {
        let n = entryWord(fi, 8)
        if n < 0 || (n != 0 && entryWord(fi, 16) == 0)
                || (fi > 0 && !below(entryWord(fi - 1, 0), entryWord(fi, 0))) {
            return failAt(Prim.cString("invalid native frame table"), entries, fi)
        }
    }
    if current == 0 { return True }
    let running = stateWord(stateRunning)
    if running == 0 { return fail(Prim.cString("missing native stack bound"), 0, -1) }
    if !checkStack(current, word(running, stackHigh)) { return False }
    var stack = stateWord(stateStacks)
    var seen = False
    while stack != 0 {
        let parked = word(stack, stackParked)
        if stack == running {
            seen = True
        } else if parked != 0 && !checkStack(parked, word(stack, stackHigh)) {
            return False
        }
        stack = word(stack, stackNext)
    }
    if !seen { return fail(Prim.cString("running stack not on the stack list"), running, -1) }
    True
}

-- One stack's frames, from the record at `current` out to `high`.
--
-- The walk follows the same records within the same bounds as the collector's:
-- a record is two words, the caller's record and a return address into the
-- caller, and the entry for that address gives the caller's roots as offsets
-- from the caller's record. Records are 8-byte aligned and strictly increase
-- towards `high`; the walk stops at the first that does not.
fun checkStack(current : Int, high : Int) -> Bool {
    if high == 0 { return fail(Prim.cString("missing native stack bound"), 0, -1) }
    var walked = current
    while !below(high, walked) && !below(high - walked, 16) && Prim.intAnd(walked, 7) == 0 {
        let caller = word(walked, 0)
        if !below(walked, caller) || below(high, caller) || below(high - caller, 16)
                || Prim.intAnd(caller, 7) != 0 {
            return True
        }
        let e = entryFor(word(walked, 8))
        if e >= 0 {
            let offsets = entryWord(e, 16)
            for var fi = 0; fi < entryWord(e, 8); fi = fi + 1 {
                let slot = Prim.intAddWrapping(caller, word(offsets, 8 * fi))
                if Prim.intAnd(slot, 7) != 0 || below(slot, walked + 16) || below(high - 8, slot) {
                    return fail(Prim.cString("invalid native root offset"),
                                Prim.ptrToInt(entries) + entryBytes * e, fi)
                }
                -- A frame slot may hold the address of an object in a frame
                -- of the same stack, which the collector skips by the same
                -- range. The heap may never hold one, and `checkObject`
                -- refuses it there: it is in no region.
                let value = word(slot, 0)
                let onStack = !below(value, current) && below(value, high)
                if !onStack && !checkPointer(value, afterMarking(), caller, fi) { return False }
            }
        }
        walked = caller
    }
    True
}

fun entryWord(i : Int, offset : Int) -> Int = Prim.loadI64(entries, entryBytes * i + offset)

-- The entry for return address `address`, or -1.
fun entryFor(address : Int) -> Int {
    var first = 0
    var past = entryCount
    while first < past {
        let middle = first + (past - first) / 2
        if below(entryWord(middle, 0), address) { first = middle + 1 } else { past = middle }
    }
    if first < entryCount && entryWord(first, 0) == address { first } else { -1 }
}
