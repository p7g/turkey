module Turkey.Memory (fill, copy, trailingZeros)

-- Bytes and bits, for code that may not allocate.
--
-- A giblet module: the compiler refuses it if its code, once optimized, could
-- allocate or hold a traced value across a call, so anything inside the
-- collector may call it. What is here is what the collector would
-- otherwise reach C for -- `memset`, `memcpy` and a count of trailing zeros --
-- written as loops, because a giblet has no reason to call C to move bytes.
--
-- Written against `Prim.Ptr` and `Prim.load*`/`Prim.store*` directly. The
-- `Turkey.Ptr` classes would do, since specialization makes their methods
-- direct calls, but a giblet should not depend on a dictionary going away.

import Prelude ()
import Std.Classes
import Data.Bool.Type (Bool(..))

-- Set `count` bytes from `p` to `value`'s low byte.
--
-- These two run on every allocation, so their index arithmetic wraps rather
-- than checking: a count of bytes that fits in memory is far from overflow.
--
-- A word at a time, then the tail a byte at a time. Every object the
-- allocator hands out is zeroed through here, so a byte loop was a quarter of
-- the compiler's own run time. arm64 permits an unaligned 64-bit store, so
-- nothing depends on `p` being aligned.
fun fill(p : Prim.Ptr, count : Int, value : Int) -> Unit {
    let low = Prim.intAnd(value, 255)
    let word = Prim.intMulWrapping(low, 72340172838076673)
    var i = 0
    while Prim.intAddWrapping(i, 8) <= count {
        Prim.storeI64(p, i, word)
        i = Prim.intAddWrapping(i, 8)
    }
    let byte = Prim.byteFromInt(low)
    while i < count {
        Prim.storeI8(p, i, byte)
        i = Prim.intAddWrapping(i, 1)
    }
}

-- Copy `count` bytes from `source` to `target`, front to back: the regions must
-- not overlap unless `target` is below `source`. A word at a time as `fill`
-- is; each word is loaded before it is stored, so a `target` below `source`
-- only ever overwrites bytes already read.
fun copy(target : Prim.Ptr, source : Prim.Ptr, count : Int) -> Unit {
    var i = 0
    while Prim.intAddWrapping(i, 8) <= count {
        Prim.storeI64(target, i, Prim.loadI64(source, i))
        i = Prim.intAddWrapping(i, 8)
    }
    while i < count {
        Prim.storeI8(target, i, Prim.loadI8(source, i))
        i = Prim.intAddWrapping(i, 1)
    }
}

-- The number of zero bits below the lowest set bit: 64 for zero, as the free
-- bitmap's search wants -- a word with no free slot has none to find.
--
-- A de Bruijn multiply: isolating the lowest set bit and multiplying by the
-- constant puts a distinct 6-bit pattern in the top bits for each of the 64
-- positions, and the table maps the pattern back. The allocator asks this at
-- every allocation, so it is one multiply and one load rather than a loop.
-- The table is the position plus 48, so every entry is a printable byte.
fun trailingZeros(x : Int) -> Int {
    if x == 0 { return 64 }
    let lowest = Prim.intAnd(x, Prim.intNegWrapping(x))
    let pattern = Prim.intAnd(Prim.intShr(Prim.intMulWrapping(lowest, 285870213051386505), 58), 63)
    let positions = Prim.cString("01`2iaL3mjbZVMA4ngkTec[F]WQNHB<5o_hKlYU@fSdE\\PG;^JX?RDO:I>C9=876")
    Prim.byteToInt(Prim.loadI8(positions, pattern)) - 48
}
