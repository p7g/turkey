export (
    malloc, free, realloc, alignedAlloc, strlen, memchr, memcmp, memmem,
    getenv, read, write, close, open, clockGettime, schedYield, exit, exitNow,
)

--- The C library functions the runtime calls from many places, on whichever
--- target it is compiled for: `Turkey.Libc`'s on Darwin and Linux, and
--- `Turkey.Wasi`'s on wasm32-wasi, which has no C library. Each takes and
--- returns what its namesake in `Turkey.Libc` does.
---
--- Each is a `match` on `Target.os`, which the optimizer decides before it
--- inlines the function, so a call here costs what a call to `Turkey.Libc`
--- costs. A function the runtime calls from one module only is dispatched
--- there instead, beside the code that knows why it is called.

import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)
import Target (OS(..))
import Target as Target
import Turkey.Libc as Libc
import Turkey.Wasi as Wasi

type Ptr = Prim.Ptr

fun malloc(size : Int) -> Ptr = match Target.os {
    Wasi -> Wasi.malloc(size)
    _ -> Libc.malloc(size)
}

fun free(p : Ptr) -> Unit = match Target.os {
    Wasi -> Wasi.free(p)
    _ -> Libc.free(p)
}

fun realloc(p : Ptr, size : Int) -> Ptr = match Target.os {
    Wasi -> Wasi.realloc(p, size)
    _ -> Libc.realloc(p, size)
}

fun alignedAlloc(alignment : Int, size : Int) -> Ptr = match Target.os {
    Wasi -> Wasi.alignedAlloc(alignment, size)
    _ -> Libc.alignedAlloc(alignment, size)
}

fun strlen(s : Ptr) -> Int = match Target.os {
    Wasi -> Wasi.strlen(s)
    _ -> Libc.strlen(s)
}

fun memchr(s : Ptr, c : Int, n : Int) -> Ptr = match Target.os {
    Wasi -> Wasi.memchr(s, c, n)
    _ -> Libc.memchr(s, c, n)
}

fun memcmp(a : Ptr, b : Ptr, n : Int) -> Int = match Target.os {
    Wasi -> Wasi.memcmp(a, b, n)
    _ -> Libc.memcmp(a, b, n)
}

fun memmem(s : Ptr, n : Int, needle : Ptr, needleLength : Int) -> Ptr = match Target.os {
    Wasi -> Wasi.memmem(s, n, needle, needleLength)
    _ -> Libc.memmem(s, n, needle, needleLength)
}

fun getenv(name : Ptr) -> Ptr = match Target.os {
    Wasi -> Wasi.getenv(name)
    _ -> Libc.getenv(name)
}

fun read(fd : Int, buf : Ptr, count : Int) -> Int = match Target.os {
    Wasi -> Wasi.read(fd, buf, count)
    _ -> Libc.read(fd, buf, count)
}

fun write(fd : Int, buf : Ptr, count : Int) -> Int = match Target.os {
    Wasi -> Wasi.write(fd, buf, count)
    _ -> Libc.write(fd, buf, count)
}

fun close(fd : Int) -> Int = match Target.os {
    Wasi -> Wasi.close(fd)
    _ -> Libc.close(fd)
}

fun open(path : Ptr, flags : Int, mode : Int) -> Int = match Target.os {
    Wasi -> Wasi.open(path, flags, mode)
    _ -> Libc.open(path, flags, mode)
}

fun clockGettime(id : Int, timespec : Ptr) -> Int = match Target.os {
    Wasi -> Wasi.clockGettime(id, timespec)
    _ -> Libc.clockGettime(id, timespec)
}

fun schedYield() -> Int = match Target.os {
    Wasi -> Wasi.schedYield()
    _ -> Libc.schedYield()
}

--- Ends the program as C's `exit` does, running `atexit` handlers and
--- flushing stdio; on wasm, which has neither, it ends at once.
fun exit(status : Int) -> Unit = match Target.os {
    Wasi -> Wasi.exit(status)
    _ -> Libc.exit(status)
}

--- Ends the program at once, as `_exit` does.
fun exitNow(status : Int) -> Unit = match Target.os {
    Wasi -> Wasi.exit(status)
    _ -> Libc.exitNow(status)
}
