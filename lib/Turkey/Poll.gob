export (
    Waiter, Source, timedOut, cancelled,
    mutex, lock, unlock, now, watch, noDeadline, sleeper, readable, writable, readableBlocking, childExit, locked,
    sourceOf, lockSource, unlockSource, waitOn,
    park, finished, outcome, complete, timeOut,
    timeout, deliver, expire, cancel, forget, takeWoken, endings, takeHeadMoved,
)

-- What tasks wait for besides each other: a time to come, a descriptor to be
-- ready, a child to exit, a file lock to be free. A wait is a `Waiter`; the
-- scheduler's workers deliver what the operating system reports
-- (`Turkey.Workers`' poller) and the time that passes to the waiters, which
-- answer the coroutines to wake.
--
-- **Three locks**, taken in this order and never the other way round:
--
-- * the poller's (`lock`), over every table below: the sources by slot and
--   by descriptor, children, file locks, and the tasks to wake (`takeWoken`).
--   Every function here but `now`, `lock`, `unlock`, `lockSource`,
--   `unlockSource`, `waitOn`, `takeHeadMoved`, `watch` and `timeout` is
--   called under it;
-- * each source's own (`lockSource`), over a persistent descriptor's waiters,
--   its latch and whether it is counted in the interest. A task that has its
--   descriptor's source (`sourceOf`) parks under that lock alone (`waitOn`),
--   so tasks parking on different descriptors do not wait for each other;
-- * a deadline heap's (`Heap`), taken inside either of the others, by the
--   functions that touch the heap and only for as long as they do.
--
-- So a descriptor waiter's state changes under its source's lock, and it
-- ends only under the poller's lock as well: every waiter ends under the
-- poller's lock, which is what guards the tasks to wake. Whoever ends waits
-- calls `takeWoken` before it lets that lock go, so that it wakes exactly the
-- tasks of the waits it ended. None of these functions waits.
--
-- The scheduler's locks are taken outside all three, never inside: this
-- module cannot import `Turkey.Scheduler`, which imports it, so what it has
-- to wake it answers, and whoever ended the wait wakes those tasks after
-- letting the poller's lock go.
--
-- **One way out of waiting.** A waiter is `Waiting` until the first of an
-- event, its deadline and a cancellation reaches it, and then it is `Ready`,
-- `TimedOut` or `Cancelled`, for good: whatever comes later finds it not
-- waiting, or finds no waiter at all, and does nothing. Leaving `Waiting`
-- takes the waiter off its deadline heap and out of the descriptor or child it
-- waited on, so the heap holds waiters that wait and nothing else.
--
-- **Descriptors.** The poller knows a descriptor's number and a token, and on
-- Linux keeps one registration per descriptor, not one per direction. So a
-- `Source` is one descriptor number, or one child, with the waiters on its
-- read side and on its write side, and one token for the kernel. A token is
-- the source's slot and, above 20 bits, its generation, which is raised each
-- time the slot is freed: an event that arrives for a slot that has been
-- freed and used again carries the old generation and is ignored.
--
-- A descriptor is registered once, at its first wait, edge-triggered and in
-- both directions (`Turkey.Workers.pollRegister`), and its source lives until
-- `forget`, so a wait costs no system call. An edge comes once per change of
-- readiness, whoever waits: so an event for a direction with waiters ends all
-- of them, and one for a direction with none is kept (`latched`) and ends the
-- next wait there at once. A kept event may be stale -- the operation it
-- announced may have run already -- and then the woken operation finds
-- nothing and waits again; that costs a call, where a lost event would cost
-- the wait. Every waiter on a direction when its event comes is woken, so two
-- tasks waiting on one descriptor are both woken. A waiter woken by an edge
-- retries until `EAGAIN` before it waits again, or another edge may never
-- come; one that saw `EAGAIN` before an edge that woke others, and registers
-- after it, is not woken by it, which is why a descriptor shared by several
-- waiters has to be drained by whichever of them wakes. `Turkey.FD` holds a
-- direction's lock while it waits, so it has at most one waiter per direction.
--
-- **Every descriptor number that was waited on is forgotten before it is
-- closed** (`forget`, which `Turkey.FD` calls before `close(2)`). A source
-- left behind for a closed number would be found by the next descriptor with
-- that number, which would then skip its registration and never be woken. On
-- Linux, `forget` also removes the descriptor from the epoll set, which
-- `close` does not do while a duplicate of it is open; on Darwin, `close`
-- removes it.
--
-- A descriptor in blocking mode (`readableBlocking`) is not registered that
-- way: a kept event that is stale would send a blocking `read` into the
-- kernel. Its source registers once per wait, level-triggered, so the event
-- means the descriptor is ready when the wait is made or after; it exists
-- while a waiter waits on it, and a direction that still waits after an event
-- is told again (`arm`). A direction whose waiter left first may stay
-- registered; its event wakes nobody. One descriptor number is waited on in
-- one of the two ways until it is forgotten.
--
-- **Interest.** `Turkey.Workers.interest` is the number of sources counted in
-- it (`recount`) plus the number of waiters on the deadline heap, kept exact
-- at the places that change either, so that a count of 0 means nothing can
-- wake a waiter and a worker that sees it need not poll. A registered
-- descriptor with no waiter is not counted: its events can wait in the kernel
-- until a waiter comes. Whoever raises the count from 0 wakes an idle worker
-- to poll (`interestAdd`), since the workers that found nothing to poll sleep
-- until something is queued.
--
-- **Children.** A child is reaped by the one wait that watches it, with
-- `waitpid(pid, WNOHANG)`, never `wait` or `waitpid(-1, ...)`, and no one
-- anywhere else in the program may call either, or set `SIGCHLD` to
-- `SIG_IGN`: any of them takes the status of a child someone is waiting for.
-- A wait for a child that is not this process's answers `-ECHILD`, as does a
-- second wait for one that is waited for already.
--
-- **File locks** (Darwin only). The kernel reports each release of a `flock`
-- lock on a file, by anyone, to a registration on any descriptor for it, and
-- does not say who may take the lock now. So the wait takes the lock itself:
-- it registers, then tries `LOCK_NB`, and on each event registers again and
-- tries again, until the lock is taken, the deadline comes or the descriptor
-- is closed. Registering before each try is what keeps a release that comes
-- between a failed try and the registration from being lost. The tries run
-- under the poller's lock, as `childExit`'s `waitpid` does, and never
-- wait. A waiter that leaves before its try succeeds has not taken the lock,
-- so a deadline or a `cancel` leaves no lock behind. All waits for locks
-- through one descriptor number share a source, since the kernel keeps one
-- registration per descriptor and filter.
--
-- Everything here is reachable from the module's own tables, which are roots:
-- a waiter is held by its source or by the heap until it leaves them, and a
-- coroutine by the waiter. The raw memory below holds no heap value.

import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)
import Data.Eq (Eq(..), (==), (!=))
import Data.Ord (Ord(..), (<), (<=), (>), (>=))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..), (+), (-), (*), (/), (%))
import Control.Iterator (Iterator(..))
import Data.Index (Index(..), SetIndex(..), Length(..))
import Data.Bool (Bool(..))
import Data.Int ()
import Data.Int as Int
import Bits (BitAnd(..), BitOr(..), (&), (|))
import Data.Option (Option(..))
import Data.Option as Option
import Data.Vec (Vec)
import Data.Vec as Vec
import Turkey.Coroutine as Co
import Turkey.Array as Storage
import Turkey.Libc as Libc
import Turkey.Lock as Lock
import Turkey.Sys as Sys
import Turkey.Workers as Workers
import Target (OS(..))
import Target as Target
import Turkey.Ptr (Ptr)
import Turkey.Ptr as Ptr
import Control.Panic (error)

-- What a wait answers when it ended without its event, below every negated
-- error number (and `Turkey.FD.closed`, the next below them).
let timedOut : Int = -0x2_0000_0000
let cancelled : Int = -0x3_0000_0000

-- How a wait stands: still waiting, or ended for good. `Ready` carries the
-- answer: 0 for a descriptor or a lock taken, the wait status for a child, or
-- a negated error number if the wait could not be made or the descriptor
-- failed to register.
type Outcome = Waiting | Ready(Int) | TimedOut | Cancelled

-- What a waiter waits for. A `Lock` carries the `flock` operation to take.
type WaitKind = Sleep | Read | Write | Child | Lock(Int)

-- What a source stands for. A `Descriptor` is registered for its life,
-- edge-triggered; a `BlockingDescriptor` is registered for each wait. A
-- `FileLock` is a descriptor whose file's unlocks are watched.
type SourceKind = Descriptor | BlockingDescriptor | ChildProcess | FileLock

-- One wait. `heapAt` is the waiter's place on its deadline heap, `heap`'s,
-- or -1;
-- `source` is its source's slot, or 0. `coroutine` is the task to wake when it
-- ends, if one has parked on it.
type Waiter = Waiter {
    var outcome   : Outcome,
    kind          : WaitKind,
    deadline      : Int,
    var heapAt    : Int,
    var heap      : Int,
    var source    : Int,
    id            : Int,
    var coroutine : Option Co.Coroutine,
}

-- A descriptor number or a child, its waiters, and what the kernel has been
-- told about it. `lock` and `slot` are the record's for its life. Directions
-- are bits: 1 for read, 2 for write. `armed` is the directions a
-- `BlockingDescriptor` has registered, and on Linux what its one registration
-- was made for; for a `FileLock`, 1 while the unlock is registered. `added` is
-- whether Linux's epoll set holds the descriptor at all, which a one-shot that
-- has fired leaves it doing. `latched` is the directions of a `Descriptor` that
-- an event reported while nobody waited. `counted` is whether the source is
-- counted in the interest. A source's record is reused when its slot is.
type Source = Source {
    lock           : Ptr,
    var slot       : Int,
    var generation : Int,
    var live       : Bool,
    var kind       : SourceKind,
    var number     : Int,
    readers        : Vec Waiter,
    writers        : Vec Waiter,
    var armed      : Int,
    var added      : Bool,
    var latched    : Int,
    var counted    : Bool,
    -- A child's: it has exited, but `waitpid` cannot reap it yet (`exiting`).
    -- `event` is what the poller reported for it, which on Darwin is its status.
    var exiting    : Bool,
    var event      : Int,
}

let slotBits : Int = 1_048_576

fun newSourceRecord() -> Source = Source {
    lock = Lock.new(),
    slot = 0,
    generation = 0,
    live = False,
    kind = Descriptor,
    number = 0,
    readers = [],
    writers = [],
    armed = 0,
    added = False,
    latched = 0,
    counted = False,
    exiting = False,
    event = 0,
}

-- The sources by slot; slot 0 is not one, since token 0 is the poller's own
-- break. The free slots, how many sources are counted in the interest, the
-- slot of the source for each descriptor number (0 for none) and the slots of
-- those for children.
var sources : Vec Source = [newSourceRecord()]
var freeSlots : Vec Int = []
var byFd : Vec Int = []
var childSlots : Vec Int = []
-- The slot of the `FileLock` source for each descriptor number, or 0.
var byLockFd : Vec Int = []
-- The slots of the children that have exited and are not yet waitable, which
-- `expire` asks again, and which keep the poller from waiting for long.
var exiting : Vec Int = []
let exitingRetry : Int = 1_000_000

-- The waiters with a deadline, in `heapCount` binary min-heaps on the
-- deadline. A waiter goes on the heap of the thread that makes it
-- (`Turkey.Workers.index`), so that threads parking at once take different
-- heaps' locks, and stays there until it ends. `earliest` is the heap's first
-- deadline, or `noDeadline`, kept so that `timeout` reads every heap's
-- without taking its lock. Fixed in number, so that a heap is made once as
-- the program starts and then only read: a heap made later would have to be
-- published to the threads that read it.
type Heap = Heap { lock : Ptr, items : Vec Waiter, earliest : Ptr }

let heapCount : Int = 16
let noDeadline : Int = 0x7FFF_FFFF_FFFF_FFFF

let heaps : Prim.Array Heap = newHeaps()

fun newHeaps() -> Prim.Array Heap {
    let all = Storage.filled(heapCount, newHeap())
    for var i = 1; i < heapCount; i = i + 1 { all[i] = newHeap() }
    all
}

fun newHeap() -> Heap {
    let earliest = Libc.malloc(8)
    Ptr.atomicStore(earliest, 0, noDeadline)
    Heap { lock = Lock.new(), items = [], earliest }
}

-- The tasks to wake, and how many waiters have ended: kept so that each
-- function can answer how many it ended (a program's own stack waits too, and
-- has no coroutine to wake).
var woken : Vec Co.Coroutine = []
var ended = 0

-- Words changed by atomic instructions, since the locks above do not cover
-- them: the next waiter's id; how many sources are counted in the interest;
-- 1 when a deadline has come before the one the polling worker waits for
-- since `takeHeadMoved`; that deadline (`watch`); and how many children are
-- `exiting`.
let words : Ptr = zeroedWords(5)
let nextIdAt : Int = 0
let countedAt : Int = 8
let headMovedAt : Int = 16
let watchedAt : Int = 24
let exitingAt : Int = 32

fun zeroedWords(n : Int) -> Ptr {
    let p = Libc.malloc(8 * n)
    for var i = 0; i < n; i = i + 1 { Ptr.atomicStore(p, 8 * i, 0) }
    p
}

-- Count `n` more, or fewer, in `Turkey.Workers.interest`. The count leaving 0
-- wakes an idle worker to poll for what was just registered.
fun interestAdd(n : Int) -> Unit {
    if Workers.interestAdd(n) == 0 && n > 0 { Workers.signalWork(False) }
}

fun countedSources() -> Int = Ptr.atomicLoad(words, countedAt)

-- Where `waitpid` stores a status; only used under the lock.
var statusBuffer : Ptr = Libc.malloc(8)

-- The poller's lock. A thread waiting for it is blocked
-- (`Turkey.Workers.acquire`), so its holder may allocate and collect. A
-- `let`, since nothing replaces it: a `var` would be a heap cell.
let mutex : Ptr = Lock.new()

fun lock() -> Unit = Workers.acquire(mutex)
fun unlock() -> Unit = Lock.release(mutex)

-- -- time ---------------------------------------------------------------------------------

-- Nanoseconds on a clock that only moves forward, which every deadline is
-- on. Each call has its own `struct timespec`, since workers read it at once.
fun now() -> Int {
    let timespec = Libc.malloc(16)
    let _ = Libc.clockGettime(Sys.clockMonotonic(), timespec)
    let nanoseconds : Int = Ptr.load(timespec, 0) * 1000000000 + Ptr.load(timespec, 8)
    Libc.free(timespec)
    nanoseconds
}

-- -- the deadline heap --------------------------------------------------------------------

fun place(h : Heap, i : Int, w : Waiter) -> Unit {
    h.items[i] = w
    w.heapAt = i
}

-- Move the waiter at `start` up to where it belongs, answering where that is.
fun siftUp(h : Heap, start : Int) -> Int {
    var i = start
    let w = h.items[i]
    while i > 0 {
        let parent = (i - 1) / 2
        let p = h.items[parent]
        if !(w.deadline < p.deadline) { break }
        place(h, i, p)
        i = parent
    }
    place(h, i, w)
    i
}

fun siftDown(h : Heap, start : Int) -> Unit {
    var i = start
    let w = h.items[i]
    let n = len(h.items)
    while True {
        var child = 2 * i + 1
        if child >= n { break }
        if child + 1 < n && h.items[child + 1].deadline < h.items[child].deadline {
            child = child + 1
        }
        let c = h.items[child]
        if !(c.deadline < w.deadline) { break }
        place(h, i, c)
        i = child
    }
    place(h, i, w)
}

-- Store `h`'s first deadline in `earliest`. Under `h`'s lock.
fun publish(h : Heap) -> Unit {
    let first = if len(h.items) > 0 { h.items[0].deadline } else { noDeadline }
    Ptr.atomicStore(h.earliest, 0, first)
}

-- Put `w` on the running thread's heap. A deadline before the one the
-- polling worker waits for is noted for `takeHeadMoved`: read after the heap
-- shows `w`, so that a poller that set its deadline later saw `w` when it
-- chose it (`watch`).
fun timerAdd(w : Waiter) -> Unit {
    let at = Workers.index() % heapCount
    let h = heaps[at]
    Workers.acquire(h.lock)
    w.heap = at
    Vec.push(h.items, w)
    if siftUp(h, len(h.items) - 1) == 0 { publish(h) }
    interestAdd(1)
    Lock.release(h.lock)
    if w.deadline < Ptr.atomicLoad(words, watchedAt) { Ptr.atomicStore(words, headMovedAt, 1) }
}

-- Take `w` off its heap, if it is on one. The caller holds the lock `w`'s
-- waiting is changed under, which orders the read of `heapAt` after the
-- store that put it on the heap.
fun timerRemove(w : Waiter) -> Unit {
    if w.heapAt < 0 { return {} }
    let h = heaps[w.heap]
    Workers.acquire(h.lock)
    unheap(h, w)
    Lock.release(h.lock)
}

-- `timerRemove`, under `h`'s lock.
fun unheap(h : Heap, w : Waiter) -> Unit {
    let i = w.heapAt
    if i < 0 { return {} }
    w.heapAt = -1
    interestAdd(-1)
    let last = len(h.items) - 1
    let moved = h.items[last]
    let _ = Vec.pop(h.items)
    if i < last {
        place(h, i, moved)
        siftDown(h, siftUp(h, i))
    }
    if i == 0 { publish(h) }
}

-- The polling worker is about to wait until `deadline` (`noDeadline` while it
-- works out which, and for no deadline at all), or, at -1, waits no more: a
-- deadline added before it is noted (`timerAdd`).
fun watch(deadline : Int) -> Unit = Ptr.atomicStore(words, watchedAt, deadline)

-- Whether a deadline has come before the one the polling worker waits for
-- since this was last asked: that worker has to be told.
fun takeHeadMoved() -> Bool =
    Ptr.atomicLoad(words, headMovedAt) != 0 && Ptr.atomicCas(words, headMovedAt, 1, 0) == 1

-- -- ending waits -------------------------------------------------------------------------

fun newWaiter(kind : WaitKind, deadline : Int) -> Waiter {
    let id = Ptr.atomicAdd(words, nextIdAt, 1) + 1
    Waiter {
        outcome = Waiting,
        kind = kind,
        deadline = deadline,
        heapAt = -1,
        heap = 0,
        source = 0,
        id = id,
        coroutine = None,
    }
}

-- A waiter that never waited: it answers `value` at once.
fun done(w : Waiter, value : Int) -> Waiter {
    w.outcome = Ready(value)
    w
}

fun waiting(w : Waiter) -> Bool = match w.outcome {
    Waiting -> True
    Ready(_) -> False
    TimedOut -> False
    Cancelled -> False
}

-- The one transition out of `Waiting`: False, and nothing changed, if the
-- waiter is not waiting. The task parked on it is queued to be woken.
fun finish(w : Waiter, outcome : Outcome) -> Bool {
    if !waiting(w) { return False }
    w.outcome = outcome
    timerRemove(w)
    match w.coroutine {
        Some(c) -> {
            Vec.push(woken, c)
            w.coroutine = None
        }
        None -> {}
    }
    ended = ended + 1
    True
}

-- `finish`, and take the waiter out of its source, which is freed if no one
-- else waits on it. Takes the source's lock if the source persists
-- (`persists`).
fun end(w : Waiter, outcome : Outcome) -> Unit {
    if w.source == 0 {
        let _ = finish(w, outcome)
        return {}
    }
    let s = sources[w.source]
    let own = persists(s)
    if own { lockSource(s) }
    if finish(w, outcome) { leave(w) }
    if own { unlockSource(s) }
}

fun leave(w : Waiter) -> Unit {
    let slot = w.source
    w.source = 0
    let s = sources[slot]
    match w.kind {
        Write -> drop(s.writers, w.id)
        Sleep -> drop(s.readers, w.id)
        Read -> drop(s.readers, w.id)
        Child -> drop(s.readers, w.id)
        Lock(_) -> drop(s.readers, w.id)
    }
    settleSource(slot, s)
}

fun drop(waiters : Vec Waiter, id : Int) -> Unit {
    let n = len(waiters)
    for var i = 0; i < n; i = i + 1 {
        if waiters[i].id == id {
            Vec.swap(waiters, i, n - 1)
            let _ = Vec.pop(waiters)
            return {}
        }
    }
}

-- End every waiter in `waiters`, a source's, which are all waiting, and empty
-- it: the source is the caller's to free.
fun endAll(waiters : Vec Waiter, outcome : Outcome) -> Unit {
    let n = len(waiters)
    for var i = 0; i < n; i = i + 1 {
        let w = waiters[i]
        w.source = 0
        let _ = finish(w, outcome)
    }
    Vec.clear(waiters)
}

-- -- sources ------------------------------------------------------------------------------

fun tokenOf(slot : Int, s : Source) -> Int = slot + s.generation * slotBits

fun nobodyWaits(s : Source) -> Bool = len(s.readers) == 0 && len(s.writers) == 0

-- Whether the source outlives its waiters: a `Descriptor` lives until
-- `forget`, every other kind while a waiter waits on it.
fun persists(s : Source) -> Bool = match s.kind {
    Descriptor -> True
    BlockingDescriptor -> False
    ChildProcess -> False
    FileLock -> False
}

-- Count `s` in the interest while it is live and a waiter waits on it, or,
-- for a kind that does not persist, while it is live at all.
fun recount(s : Source) -> Unit {
    let wanted = s.live && (!persists(s) || !nobodyWaits(s))
    if wanted != s.counted {
        s.counted = wanted
        let n = if wanted { 1 } else { -1 }
        let _ = Ptr.atomicAdd(words, countedAt, n)
        interestAdd(n)
    }
}

-- After waiters have left `s`: free it if nobody waits and it does not
-- persist, else count it again.
fun settleSource(slot : Int, s : Source) -> Unit {
    if nobodyWaits(s) && !persists(s) { freeSource(slot) } else { recount(s) }
}

-- A source's slot, counted in the interest, or the negated error number.
fun newSource(kind : SourceKind, number : Int) -> Int {
    var slot = 0
    if len(freeSlots) > 0 {
        slot = Option.unwrapOr(Vec.pop(freeSlots), 0)
    } else {
        if len(sources) >= slotBits { return -Sys.enomem }
        slot = len(sources)
        Vec.push(sources, newSourceRecord())
    }
    let s = sources[slot]
    s.slot = slot
    s.live = True
    s.kind = kind
    s.number = number
    s.armed = 0
    s.added = False
    s.latched = 0
    s.exiting = False
    recount(s)
    slot
}

-- Release a source nobody waits on, and drop what the kernel holds for it: a
-- Darwin one-shot that has fired is gone already, and a Linux descriptor stays
-- in the epoll set until it is removed. A `Descriptor` is freed only before
-- its number is closed (`forget`), which on Darwin removes its filters.
fun freeSource(slot : Int) -> Unit {
    let s = sources[slot]
    match s.kind {
        Descriptor -> {
            match Target.os {
                Darwin -> {}
                Linux -> if s.added { Workers.pollForget(s.number) }
            }
            byFd[s.number] = 0
        }
        BlockingDescriptor -> {
            let registered = match Target.os {
                Darwin -> s.armed != 0
                Linux -> s.added
            }
            if registered { Workers.pollForget(s.number) }
            byFd[s.number] = 0
        }
        ChildProcess -> {
            Workers.pollForgetChild(s.number, tokenOf(slot, s))
            forgetChild(slot)
            if s.exiting { forgetExiting(slot) }
        }
        FileLock -> {
            if s.armed != 0 { Workers.pollForgetUnlock(s.number) }
            byLockFd[s.number] = 0
        }
    }
    s.live = False
    recount(s)
    s.generation = s.generation + 1
    s.armed = 0
    s.added = False
    s.latched = 0
    Vec.push(freeSlots, slot)
}

-- Tell the kernel about the directions of `s`, a `BlockingDescriptor`, that
-- wait and are not registered; 0, or the negated error number. On Linux the
-- one registration is replaced by one for exactly the directions that wait,
-- when it does not cover them.
fun arm(slot : Int, s : Source) -> Int {
    var want = 0
    if len(s.readers) > 0 { want = 1 }
    if len(s.writers) > 0 { want = want | 2 }
    let token = tokenOf(slot, s)
    match Target.os {
        Darwin -> {
            var r = 0
            if want & 1 != 0 && s.armed & 1 == 0 {
                r = Workers.pollRead(s.number, token)
                if r >= 0 { s.armed = s.armed | 1 }
            }
            if r >= 0 && want & 2 != 0 && s.armed & 2 == 0 {
                r = Workers.pollWrite(s.number, token)
                if r >= 0 { s.armed = s.armed | 2 }
            }
            r
        }
        Linux -> {
            if want & s.armed == want { return 0 }
            let r = match want {
                1 -> Workers.pollRead(s.number, token)
                2 -> Workers.pollWrite(s.number, token)
                _ -> Workers.pollReadWrite(s.number, token)
            }
            if r >= 0 {
                s.armed = want
                s.added = True
            }
            r
        }
    }
}

-- -- starting waits -----------------------------------------------------------------------

-- A wait that has only a deadline. A negative one never ends.
fun sleeper(deadline : Int) -> Waiter {
    let w = newWaiter(Sleep, deadline)
    if deadline >= 0 { timerAdd(w) }
    w
}

-- Waits for a non-blocking descriptor, which the caller makes only after the
-- operation answered `EAGAIN`.
fun readable(fd : Int, deadline : Int) -> Waiter = waitFd(fd, Read, Descriptor, deadline)

fun writable(fd : Int, deadline : Int) -> Waiter = waitFd(fd, Write, Descriptor, deadline)

-- A wait for a descriptor in blocking mode to be readable, which ends only
-- once a `read` would not wait.
fun readableBlocking(fd : Int, deadline : Int) -> Waiter =
    waitFd(fd, Read, BlockingDescriptor, deadline)

-- A wait for `fd` to be ready for `kind` (`Read` or `Write`): it ends `Ready`
-- with 0 when the descriptor is, or hangs up, or has an error -- the
-- operation then reports which -- and `Ready` with the negated error number
-- if the kernel will not watch it, or with `-EINVAL` if `fd` is waited on as
-- the other of `Descriptor` and `BlockingDescriptor` (`mode`).
fun waitFd(fd : Int, kind : WaitKind, mode : SourceKind, deadline : Int) -> Waiter {
    let w = newWaiter(kind, deadline)
    if fd < 0 { return done(w, -Sys.ebadf) }
    while len(byFd) <= fd { Vec.push(byFd, 0) }
    var slot = byFd[fd]
    if slot == 0 {
        slot = newSource(mode, fd)
        if slot < 0 { return done(w, slot) }
        let r = register(slot, sources[slot])
        if r < 0 {
            freeSource(slot)
            return done(w, r)
        }
        byFd[fd] = slot
    }
    let s = sources[slot]
    if persists(s) != isPersistent(mode) { return done(w, -Sys.einval) }
    let writing = match kind {
        Write -> True
        _ -> False
    }
    if persists(s) {
        lockSource(s)
        let entered = enter(s, w, writing)
        unlockSource(s)
        return entered
    }
    w.source = slot
    if writing { Vec.push(s.writers, w) } else { Vec.push(s.readers, w) }
    let r = arm(slot, s)
    if r < 0 {
        leave(w)
        return done(w, r)
    }
    if deadline >= 0 { timerAdd(w) }
    w
}

-- Make `w` wait on `s`, a `Descriptor`, for its write side if `writing` and
-- its read side otherwise: ended at once if an event for that side was kept.
-- Under the source's lock.
fun enter(s : Source, w : Waiter, writing : Bool) -> Waiter {
    let direction = if writing { 2 } else { 1 }
    if s.latched & direction != 0 {
        s.latched = s.latched & Int.not(direction)
        return done(w, 0)
    }
    w.source = s.slot
    if writing { Vec.push(s.writers, w) } else { Vec.push(s.readers, w) }
    recount(s)
    if w.deadline >= 0 { timerAdd(w) }
    w
}

-- The source of `fd`, if it is a `Descriptor` that has been waited on: what
-- `waitOn` takes. It stays `fd`'s until `forget`.
fun sourceOf(fd : Int) -> Option Source {
    if fd < 0 || fd >= len(byFd) || byFd[fd] == 0 { return None }
    let s = sources[byFd[fd]]
    if persists(s) { Some(s) } else { None }
}

fun lockSource(s : Source) -> Unit = Workers.acquire(s.lock)
fun unlockSource(s : Source) -> Unit = Lock.release(s.lock)

-- `readable` or, if `writing`, `writable`, for the descriptor whose source
-- `s` is (`sourceOf`), under the source's lock rather than the poller's. The
-- caller keeps `s` only until it forgets the descriptor, so `s` is live.
fun waitOn(s : Source, writing : Bool, deadline : Int) -> Waiter {
    let kind = if writing { Write } else { Read }
    enter(s, newWaiter(kind, deadline), writing)
}

fun isPersistent(mode : SourceKind) -> Bool = match mode {
    Descriptor -> True
    _ -> False
}

-- Register a new `Descriptor` for its life; 0, or the negated error number.
-- A `BlockingDescriptor` is registered by each wait instead (`arm`).
fun register(slot : Int, s : Source) -> Int {
    if !persists(s) { return 0 }
    let r = Workers.pollRegister(s.number, tokenOf(slot, s))
    if r >= 0 { s.added = True }
    r
}

-- A wait for the child `pid` to exit, which ends `Ready` with its wait status
-- (reaped here) or with the negated error number if it cannot be waited for.
-- The registration comes before the first `waitpid`, so a child that exits
-- between them is delivered and one that exited before is reaped at once.
fun childExit(pid : Int, deadline : Int) -> Waiter {
    let w = newWaiter(Child, deadline)
    if pid <= 0 { return done(w, -Sys.einval) }
    if findChild(pid) != 0 { return done(w, -Sys.echild) }
    let slot = newSource(ChildProcess, pid)
    if slot < 0 { return done(w, slot) }
    let s = sources[slot]
    Vec.push(childSlots, slot)
    let r = Workers.pollChild(pid, tokenOf(slot, s))
    if r < 0 {
        freeSource(slot)
        return done(w, r)
    }
    let reaped = Sys.cResult(Libc.waitpid(pid, statusBuffer, Sys.waitNoHang))
    if reaped != 0 {
        freeSource(slot)
        return done(w, if reaped > 0 { status() } else { reaped })
    }
    -- Exited by the kernel's account but not waitable yet: the wait goes on,
    -- and `expire` asks again.
    if r == 1 { markExiting(slot, s, 0) }
    w.source = slot
    Vec.push(s.readers, w)
    if deadline >= 0 { timerAdd(w) }
    w
}

fun status() -> Int = Ptr.load32(statusBuffer, 0)

-- A wait that takes `operation`'s `flock` lock on `fd`'s file, `operation`
-- being without `LOCK_NB`: it ends `Ready` with 0 once the lock is taken, or
-- with the negated error number of a try or a registration that failed.
-- Darwin only (`Workers.pollUnlock`).
fun locked(fd : Int, operation : Int, deadline : Int) -> Waiter {
    let w = newWaiter(Lock(operation), deadline)
    if fd < 0 { return done(w, -Sys.ebadf) }
    while len(byLockFd) <= fd { Vec.push(byLockFd, 0) }
    var slot = byLockFd[fd]
    if slot == 0 {
        slot = newSource(FileLock, fd)
        if slot < 0 { return done(w, slot) }
        byLockFd[fd] = slot
    }
    let s = sources[slot]
    w.source = slot
    Vec.push(s.readers, w)
    let r = armUnlock(slot, s)
    if r < 0 {
        leave(w)
        return done(w, r)
    }
    tryLocks(slot, s)
    if waiting(w) && deadline >= 0 { timerAdd(w) }
    w
}

-- Register for the next unlock of the file of `s`, a `FileLock`, if it is not
-- registered; 0, or the negated error number.
fun armUnlock(slot : Int, s : Source) -> Int {
    if s.armed != 0 { return 0 }
    let r = Workers.pollUnlock(s.number, tokenOf(slot, s))
    if r >= 0 { s.armed = 1 }
    r
}

-- Try each waiter's lock without waiting, and end the waiters that took it
-- or failed for a reason other than its being held. Frees the source if
-- nobody waits on it any more.
fun tryLocks(slot : Int, s : Source) -> Unit {
    var i = 0
    while i < len(s.readers) {
        let w = s.readers[i]
        let operation = match w.kind {
            Lock(op) -> op
            _ -> error("a lock source with a waiter that is not a lock")
        }
        let nonBlocking = operation | Sys.lockNonBlocking
        var r = Sys.cResult(Libc.flock(s.number, nonBlocking))
        while r == -Sys.eintr { r = Sys.cResult(Libc.flock(s.number, nonBlocking)) }
        if r == -Sys.eagain() {
            i = i + 1
        } else {
            Vec.swap(s.readers, i, len(s.readers) - 1)
            let _ = Vec.pop(s.readers)
            w.source = 0
            let _ = finish(w, Ready(r))
        }
    }
    if nobodyWaits(s) { freeSource(slot) }
}

fun findChild(pid : Int) -> Int {
    let n = len(childSlots)
    for var i = 0; i < n; i = i + 1 {
        if sources[childSlots[i]].number == pid { return childSlots[i] }
    }
    0
}

fun forgetChild(slot : Int) -> Unit {
    let n = len(childSlots)
    for var i = 0; i < n; i = i + 1 {
        if childSlots[i] == slot {
            Vec.swap(childSlots, i, n - 1)
            let _ = Vec.pop(childSlots)
            return {}
        }
    }
}

-- -- parking and reading the answer ---------------------------------------------------------

-- Let `c`, the task about to suspend, be woken when `w` ends.
fun park(w : Waiter, c : Co.Coroutine) -> Unit {
    w.coroutine = Some(c)
}

fun finished(w : Waiter) -> Bool = !waiting(w)

-- How the wait ended: the answer of one that is `Ready`, else `timedOut` or
-- `cancelled`. Only asked once the wait has finished.
fun outcome(w : Waiter) -> Int = match w.outcome {
    Ready(value) -> value
    TimedOut -> timedOut
    Cancelled -> cancelled
    Waiting -> error("outcome of a wait that has not ended")
}

-- End `w`, a `sleeper`, from outside the poller: `Ready` with `value`, as an
-- event would end it (`complete`), or `TimedOut` before its deadline
-- (`timeOut`). Whether it was still waiting: like every way out of `Waiting`,
-- the first to reach it decides how it ended, and a later one changes
-- nothing. Its task, if one parked, is queued to be woken (`takeWoken`).
fun complete(w : Waiter, value : Int) -> Bool = finish(w, Ready(value))

fun timeOut(w : Waiter) -> Bool = finish(w, TimedOut)

-- -- what the scheduler asks ----------------------------------------------------------------

-- What the poller should wait for, at time `now`: -1 if nothing can end a
-- wait; -2 (`Turkey.Workers.pollTimeoutForever`) if only an event can; else
-- the nanoseconds to the earliest deadline, 0 if it has passed, and at most a
-- millisecond while a child that has exited waits to be reaped.
--
-- Takes no lock: it reads each heap's `earliest`, and the counts, which are
-- atomic words. So it may miss a wait made meanwhile, which `watch` is for.
fun timeout(now : Int) -> Int {
    var earliest = noDeadline
    for var i = 0; i < heapCount; i = i + 1 {
        let first = Ptr.atomicLoad(heaps[i].earliest, 0)
        if first < earliest { earliest = first }
    }
    let timed = earliest != noDeadline
    if Ptr.atomicLoad(words, exitingAt) > 0 {
        let left = if timed { earliest - now } else { exitingRetry }
        if left < 0 { 0 } else if left > exitingRetry { exitingRetry } else { left }
    } else if timed {
        let left = earliest - now
        if left < 0 { 0 } else { left }
    } else if countedSources() > 0 {
        Workers.pollTimeoutForever
    } else {
        -1
    }
}

-- The coroutines of the waiters that have ended since the last call, for the
-- scheduler to wake.
fun takeWoken() -> Vec Co.Coroutine {
    let tasks = woken
    if len(tasks) > 0 { woken = [] }
    tasks
}

-- Returns how many waiters have ended so far. Under the lock.
fun endings() -> Int = ended

let readMask : Int = Workers.pollReadable | Workers.pollEof | Workers.pollError
let writeMask : Int = Workers.pollWritable | Workers.pollEof | Workers.pollError

-- The poller reported `value` for `token`; answers how many waiters ended.
-- A descriptor that is readable, hung up or failed ends the waiters that
-- read, and one writable, hung up or failed those that write; for a
-- `Descriptor`, a direction with no waiter keeps the event instead. For a
-- `BlockingDescriptor`, Linux's one-shot registration is gone whatever it
-- reported, and Darwin's filter that reported is.
fun deliver(token : Int, value : Int) -> Int {
    let before = ended
    let slot = token % slotBits
    if slot > 0 && slot < len(sources) {
        let s = sources[slot]
        if s.live && s.generation == token / slotBits {
            match s.kind {
                ChildProcess -> deliverChild(slot, s, value)
                Descriptor -> {
                    lockSource(s)
                    deliverEdge(s, value)
                    unlockSource(s)
                }
                BlockingDescriptor -> deliverFd(slot, s, value)
                FileLock -> deliverUnlock(slot, s)
            }
        }
    }
    ended - before
}

fun deliverEdge(s : Source, value : Int) -> Unit {
    if value & readMask != 0 { reach(s, s.readers, 1) }
    if value & writeMask != 0 { reach(s, s.writers, 2) }
    recount(s)
}

-- An edge for `direction` of `s`: it ends `waiters`, or, if there are none,
-- is kept for the next wait.
fun reach(s : Source, waiters : Vec Waiter, direction : Int) -> Unit {
    if len(waiters) > 0 {
        endAll(waiters, Ready(0))
    } else {
        s.latched = s.latched | direction
    }
}

fun deliverFd(slot : Int, s : Source, value : Int) -> Unit {
    match Target.os {
        Linux -> { s.armed = 0 }
        Darwin -> {
            if value & Workers.pollReadable != 0 { s.armed = s.armed & 2 }
            if value & Workers.pollWritable != 0 { s.armed = s.armed & 1 }
        }
    }
    if value & readMask != 0 { endAll(s.readers, Ready(0)) }
    if value & writeMask != 0 { endAll(s.writers, Ready(0)) }
    if nobodyWaits(s) {
        freeSource(slot)
        return {}
    }
    let r = arm(slot, s)
    if r < 0 {
        endAll(s.readers, Ready(r))
        endAll(s.writers, Ready(r))
        freeSource(slot)
    }
}

-- A lock on the file was released, and the one-shot registration is gone:
-- register again, then try every waiter's lock.
fun deliverUnlock(slot : Int, s : Source) -> Unit {
    s.armed = 0
    let r = armUnlock(slot, s)
    if r < 0 {
        endAll(s.readers, Ready(r))
        freeSource(slot)
        return
    }
    tryLocks(slot, s)
}

-- The child exited: reap it and answer its status. On Darwin the event has
-- the status too, and answers it if `waitpid` has none to give, as when
-- something else reaped the child first.
fun deliverChild(slot : Int, s : Source, value : Int) -> Unit {
    s.event = value
    reapChild(slot, s)
}

-- Ask `waitpid` for the child of `s`, once: if it is reaped the waiters end
-- with its status, if it is gone some other way they end with the negated
-- error number -- on Darwin the status the poller reported, since someone
-- else reaped it -- and if it is not waitable yet it is `exiting`.
fun reapChild(slot : Int, s : Source) -> Unit {
    let r = Sys.cResult(Libc.waitpid(s.number, statusBuffer, Sys.waitNoHang))
    if r == 0 {
        markExiting(slot, s, s.event)
        return {}
    }
    let answer = if r > 0 {
        status()
    } else {
        match Target.os {
            Darwin -> s.event
            Linux -> r
        }
    }
    endAll(s.readers, Ready(answer))
    freeSource(slot)
}

fun markExiting(slot : Int, s : Source, event : Int) -> Unit {
    s.event = event
    if !s.exiting {
        s.exiting = True
        Vec.push(exiting, slot)
        let _ = Ptr.atomicAdd(words, exitingAt, 1)
    }
}

fun forgetExiting(slot : Int) -> Unit {
    let n = len(exiting)
    for var i = 0; i < n; i = i + 1 {
        if exiting[i] == slot {
            Vec.swap(exiting, i, n - 1)
            let _ = Vec.pop(exiting)
            let _ = Ptr.atomicAdd(words, exitingAt, -1)
            return {}
        }
    }
}

-- Ask again for the children that were not waitable, and end every waiter
-- whose deadline is at or before `now` with `timedOut`; answers how many.
fun expire(now : Int) -> Int {
    let before = ended
    -- Backwards: a child that is reaped leaves the list by swapping with the
    -- last, which has been asked already.
    for var i = len(exiting) - 1; i >= 0; i = i - 1 {
        if i < len(exiting) {
            let slot = exiting[i]
            reapChild(slot, sources[slot])
        }
    }
    -- Off the heap under its lock, then ended under each one's source's: the
    -- heap's lock is taken inside a source's, never around it.
    var due : Vec Waiter = []
    for var i = 0; i < heapCount; i = i + 1 {
        let h = heaps[i]
        if Ptr.atomicLoad(h.earliest, 0) <= now {
            Workers.acquire(h.lock)
            while len(h.items) > 0 && h.items[0].deadline <= now {
                let w = h.items[0]
                unheap(h, w)
                Vec.push(due, w)
            }
            Lock.release(h.lock)
        }
    }
    for var i = 0; i < len(due); i = i + 1 { end(due[i], TimedOut) }
    ended - before
}

-- End every wait on `fd` with `cancelled`, as before it is closed. A
-- `Descriptor` stays registered until `forget`. Answers how many ended.
fun cancel(fd : Int) -> Int {
    let before = ended
    if fd >= 0 && fd < len(byFd) && byFd[fd] != 0 {
        let slot = byFd[fd]
        let s = sources[slot]
        lockSource(s)
        endAll(s.readers, Cancelled)
        endAll(s.writers, Cancelled)
        settleSource(slot, s)
        unlockSource(s)
    }
    if fd >= 0 && fd < len(byLockFd) && byLockFd[fd] != 0 {
        let slot = byLockFd[fd]
        endAll(sources[slot].readers, Cancelled)
        freeSource(slot)
    }
    ended - before
}

-- `fd` is about to be closed: end every wait on it with `cancelled`, free its
-- source and drop the kernel's interest, which on Linux a registration does
-- not survive while another descriptor for the same open file exists.
-- Answers how many waits ended.
fun forget(fd : Int) -> Int {
    let before = ended
    if fd >= 0 && fd < len(byFd) && byFd[fd] != 0 {
        let slot = byFd[fd]
        let s = sources[slot]
        lockSource(s)
        endAll(s.readers, Cancelled)
        endAll(s.writers, Cancelled)
        freeSource(slot)
        unlockSource(s)
    }
    ended - before
}
