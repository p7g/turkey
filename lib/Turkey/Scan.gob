export (newline, wellFormed, sequenceAt)

-- The read-only scans of the I/O layer and of `String`: where the next
-- newline is, how far a run of ASCII goes, whether bytes are well-formed
-- UTF-8, and how long the sequence at an offset is. Each works on the array's
-- storage, the first three several bytes at a time, over a window checked
-- against the array once, because these run over every byte a program reads
-- and a byte loop is several times slower.
--
-- The loads are `Prim.loadI64` at the address of an element
-- (`Prim.elementAddress`), unaligned: arm64 loads from any address, and both
-- targets are little-endian, so the byte at the lowest address is the word's
-- least significant. The collector does not
-- move objects, nothing here allocates, and each function ends with a
-- `Prim.keepAlive` of the array it reads, so the address stays good.
--
-- The Prelude depends on this module, through `String`, so it imports the
-- library modules it uses by name.

import Prelude ()
import Data.Int (Int)
import Data.Byte (Byte)
import Data.Tuple (Unit)
import Data.Eq (Eq(..))
import Data.Ord (Ord(..))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..))
import Data.Index (Index(..), SetIndex(..), Length(..))
import Control.Panic (error)
import Data.Array (Array)
import Data.Array as Array
import Data.Array ()
import Data.Bool (Bool(..))
import Data.Int ()
import Turkey.Libc as Libc

-- 0x8080_8080_8080_8080, which as a signed literal is out of range.
let highs : Int = -0x7F7F_7F7F_7F7F_7F80

-- Where the first newline is in `bytes[from..to)`, or -1 if there is none.
-- C's `memchr`, whose vector loop is several times what a word at a time in
-- Turkey reaches (`Turkey.Libc.memchr`). It runs in a moment and cannot block,
-- so it is called directly rather than as a blocking call.
fun newline(bytes : Array Byte, from : Int, to : Int) -> Int {
    within(len(bytes), from, to)
    let base = Prim.elementAddress(Array.storage(bytes), 0)
    let p = Libc.memchr(Prim.ptrAdd(base, from), 10, to - from)
    let found = if Prim.ptrIsNull(p) { -1 } else { Prim.ptrDiff(p, base) }
    Prim.keepAlive(bytes)
    found
}

-- Where the first byte of `base[from..to)` that is not ASCII is, or `to` if
-- they all are: 32 bytes per step, with their high bits tested together, then
-- a word at a time, then a byte.
fun asciiFrom(base : Prim.Ptr, from : Int, to : Int) -> Int {
    var i = from
    while i + 32 <= to {
        let any = Prim.intOr(Prim.intOr(Prim.loadI64(base, i), Prim.loadI64(base, i + 8)),
                             Prim.intOr(Prim.loadI64(base, i + 16), Prim.loadI64(base, i + 24)))
        if Prim.intAnd(any, highs) != 0 { break }
        i = i + 32
    }
    while i + 8 <= to {
        let high = Prim.intAnd(Prim.loadI64(base, i), highs)
        if high != 0 { return i + firstFlagged(high) }
        i = i + 8
    }
    while i < to {
        if Prim.byteToInt(Prim.loadI8(base, i)) >= 0x80 { return i }
        i = i + 1
    }
    to
}

-- Whether `bytes[from..to)` is well-formed UTF-8: the shortest encoding of a
-- scalar value, each time, to the end. Overlong forms, surrogates, code points
-- past 10FFFF and truncated sequences all fail.
--
-- A run of ASCII is passed over by `asciiFrom`, and `sequence` runs only from
-- a byte that is not ASCII, until the next ASCII byte.
fun wellFormed(bytes : Prim.Array Byte, from : Int, to : Int) -> Bool {
    within(len(bytes), from, to)
    let base = Prim.elementAddress(bytes, 0)
    var i = from
    var good = True
    while i < to {
        let lead = Prim.byteToInt(Prim.loadI8(base, i))
        if lead < 0x80 {
            i = asciiFrom(base, i, to)
            continue
        }
        let width = sequence(base, i, to, lead)
        if width < 0 {
            good = False
            break
        }
        i = i + width
    }
    Prim.keepAlive(bytes)
    good
}

-- What the bytes of `bytes[i..to)` begin with, for a lossy decoder: the width
-- of the well-formed sequence at `i`, or the negated length of the ill-formed
-- run there that one U+FFFD stands for. An ASCII byte is a sequence of width 1.
fun sequenceAt(bytes : Prim.Array Byte, i : Int, to : Int) -> Int {
    within(Prim.arrayLength(bytes), i, to)
    if i >= to { Prim.error("Turkey.Scan: no sequence at the end of a window") }
    let base = Prim.elementAddress(bytes, 0)
    let lead = Prim.byteToInt(Prim.loadI8(base, i))
    let width = if lead < 0x80 { 1 } else { sequence(base, i, to, lead) }
    Prim.keepAlive(bytes)
    width
}

-- The sequence led by `lead`, a byte that is not ASCII, at `i`: its width if
-- it is well-formed, and otherwise the negated length of its maximal subpart.
--
-- The well-formed sequences are exactly these, by lead byte:
--
--     C2..DF        80..BF
--     E0            A0..BF  80..BF
--     E1..EC EE..EF 80..BF  80..BF
--     ED            80..9F  80..BF
--     F0            90..BF  80..BF  80..BF
--     F1..F3        80..BF  80..BF  80..BF
--     F4            80..8F  80..BF  80..BF
--
-- Only the second byte's range depends on the lead: it is what excludes the
-- overlong forms (E0, F0), the surrogates (ED) and what lies past 10FFFF (F4),
-- so nothing has to be decoded to reject them. Every other byte, and C0, C1
-- and F5..FF as leads, is never part of a well-formed sequence.
--
-- The maximal subpart of an ill-formed sequence is the longest prefix of it
-- that some well-formed sequence begins with, or its first byte alone if
-- there is none (the Unicode Standard, section 3.9). So `E0 80` is two, the lone
-- `E0` and the lone `80`, since no well-formed sequence begins `E0 80`; and
-- `F1 80 80 41` is one, `F1 80 80`, followed by `41`. Each maximal subpart is
-- one U+FFFD to a lossy decoder.
fun sequence(base : Prim.Ptr, i : Int, to : Int, lead : Int) -> Int {
    var width = 0
    var low = 0x80
    var high = 0xBF
    if lead >= 0xC2 && lead <= 0xDF {
        width = 2
    } else if lead >= 0xE0 && lead <= 0xEF {
        width = 3
        if lead == 0xE0 { low = 0xA0 } else if lead == 0xED { high = 0x9F }
    } else if lead >= 0xF0 && lead <= 0xF4 {
        width = 4
        if lead == 0xF0 { low = 0x90 } else if lead == 0xF4 { high = 0x8F }
    } else {
        return -1
    }
    if i + 1 >= to { return -1 }
    let second = Prim.byteToInt(Prim.loadI8(base, i + 1))
    if second < low || second > high { return -1 }
    for var k = 2; k < width; k = k + 1 {
        if i + k >= to { return -k }
        let b = Prim.byteToInt(Prim.loadI8(base, i + k))
        if Prim.intAnd(b, 0xC0) != 0x80 { return -k }
    }
    width
}

-- The index of the lowest byte whose high bit is set in `flags`, which has
-- no other bits set and at least one of those. The lowest set bit,
-- `flags & -flags`, is bit 8k+7; moved down to bit 8k and multiplied by a word
-- whose byte j holds 7 - j, it brings byte 7 - k to the top byte, which holds
-- k. The shift is arithmetic, so for k = 7 the mask clears the copies of the
-- sign bit it brings in.
fun firstFlagged(flags : Int) -> Int {
    let lowest = Prim.intAnd(flags, Prim.intNegWrapping(flags))
    let down = Prim.intAnd(Prim.intShr(lowest, 7), 0x01FF_FFFF_FFFF_FFFF)
    let spread = Prim.intMulWrapping(down, 0x0001_0203_0405_0607)
    Prim.intAnd(Prim.intShr(spread, 56), 0xff)
}

-- Panic unless `from..to` is a window of something `length` long.
fun within(length : Int, from : Int, to : Int) -> Unit {
    if from < 0 || to < from || to > length {
        Prim.error("Turkey.Scan: a window outside its array")
    }
}
