export (lock, unlock, ready, wake, wakeAll, changed, waitUntil, waitOn, yield, afterCall, start)

-- Which task runs next, and on which worker.
--
-- A task is a coroutine (`Turkey.Coroutine`), resumed from a thread's own
-- stack: the program's, whenever code on the program's stack has to wait,
-- and each other thread's, in `workerLoop`, for as long as the program runs.
-- Code on a task's stack never resumes another task; when it has to wait it
-- suspends, which returns to the thread that resumed it. So the program's own
-- stack is never a task, and keeps its full size for deep recursion.
--
-- A thread takes tasks only while it holds a run permit (`Turkey.Workers`).
-- There is a permit per core (`Turkey.Cores`), unless `TURKEY_WORKERS` says
-- how many (`start`). With one, tasks interleave in a fixed order, unless one
-- blocks in a call long enough for the monitor to hand the permit to another
-- thread; with more, they run in parallel, and any order is possible.
--
-- Scheduling is cooperative: a task runs until it waits or yields, and one
-- that computes without doing either holds its worker until it finishes.
--
-- **The locks.** What tasks wait on inside the program -- a task's result, a
-- mutex, an event (`System.Task`, `System.Sync`) -- is read and written under
-- one lock (`lock`); what they wait for outside it, under the poller's
-- (`Turkey.Poll.lock`), which may be taken while this one is held and not the
-- other way round. Each queue has a lock of its own, taken only to push, pop
-- or steal tasks, and never while taking another lock but a second queue's,
-- in order of slot (`stealFrom`): so any code, under either of the others or
-- neither, may wake a task. A worker waiting for any of them is
-- blocked (`Turkey.Workers.acquire`), so a holder may allocate, and collect,
-- without waiting for the worker waiting on it.
--
-- **Waking before parking.** A coroutine that is about to wait registers
-- itself under the lock of what it waits on and then suspends; whatever it
-- waits for may wake it in between, on another worker, while it is still
-- running. So a wake never resumes a coroutine itself. Its `waiting` word
-- says which of the two came first, and every change to it is a
-- compare-and-swap: a wake moves a parked coroutine to active and queues it,
-- or moves a running one to woken; the worker that resumed it, once it has
-- suspended and left its stack, moves it from active to parked, or, finding
-- it woken, queues it (`run`). So exactly one of the two queues it, and only
-- once it is off its stack.
--
-- **The queues.** Each permit has a queue of its own (`Turkey.Workers`'
-- slots), and a task woken by a thread holding a permit goes on that permit's
-- queue: above all the tasks a poll finds ready, which stay with the worker
-- that polled. A thread takes from its permit's queue first, then from the
-- global queue, which holds the tasks woken by threads without a permit and
-- those a full queue had no room for, then polls, then steals half of
-- another permit's queue (`findWork`). A queue belongs to its permit, so the
-- tasks on it are not stranded when the monitor hands a blocked thread's
-- permit to a spare.
--
-- **Waking workers.** Queuing a task wakes an idle worker only if no other
-- worker has been woken to look and not yet found work (`notify`): one woken
-- worker steals what it can, and wakes the next if it leaves any. Waking one
-- for every task queued would cost a system call per task; this costs one
-- per worker that is needed.
--
-- **The poller and time.** What tasks wait for outside the program -- a
-- descriptor, a child, a time (`Turkey.Poll`, `Turkey.Wait`) -- is learned by
-- the workers, not by a thread of its own. A worker with nothing to run polls
-- instead of sleeping on the work epoch, if a wait is registered and no other
-- worker polls (`idle`): it waits in the operating system for the nearest
-- deadline, and `signalWork` breaks that wait when there is something to run.
-- A worker that is busy looks every `pollEvery` tasks (`poll`), without
-- waiting, for one atomic load when nothing is registered. Whoever learns of
-- an event or a passed deadline applies it under the poller's lock, then
-- wakes the tasks it ended. A task that is waiting for one is not stuck: the
-- deadlock check counts it.
--
-- The Prelude's `print` waits through here for the standard output's lock
-- (`Turkey.Stdout`), so this module names what it uses rather than importing
-- the Prelude, and every program compiles it. Starting the workers is
-- `start`, which `System.Task` calls: a program that makes no task has no
-- worker but its own, and nothing for another to run.

import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)
import Data.Eq (Eq(..), (==), (!=))
import Data.Ord (Ord(..), (<), (<=), (>), (>=))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..), (+), (-), (*), (/), (%))
import Bits (BitAnd(..), Shift(..), (&), (>>))
import Iter (Iterator(..))
import Data.Index (Index(..), SetIndex(..), Length(..))
import Control.Panic (error)
import Data.Bool (Bool(..))
import Data.Int ()
import Data.Option (Option(..))
import Data.Option as Option
import Data.Vec (Vec)
import Data.Vec as Vec
import Turkey.Cores as Cores
import Turkey.Coroutine as Co
import Turkey.Heap as Heap
import Turkey.Libc as Libc
import Turkey.Lock as Lock
import Turkey.Monitor as Monitor
import Turkey.Poll as Poll
import Turkey.Stack as Stack
import Turkey.Workers as Workers
import Turkey.Array as Storage
import Data.Byte as Byte
import Turkey.Ptr (Ptr)
import Turkey.Ptr as Ptr

-- A coroutine's `waiting` state: neither queued nor parked (running, or
-- queued to run); parked, until something wakes it; woken while it was still
-- running, to be queued when it suspends; or yielding, to be queued when it
-- suspends, on the global queue (`yield`). A wake finds a yielding coroutine
-- as it finds a woken one, already to be queued.
let active = 0
let parked = 1
let woken = 2
let yielding = 3

-- The lock of what tasks wait on (`lock`).
var waitsLock : Ptr = Lock.new()

-- The lock of the global queue, `runnable` and `head`.
var queueLock : Ptr = Lock.new()

-- The global queue: tasks woken by a thread holding no permit, and those a
-- full permit queue had no room for, oldest first, from `head` on. The slots
-- before `head` still hold the tasks taken from them, which keeps those tasks
-- and everything they reach alive, so `next` drops the slots once they are at
-- least as many as the tasks still queued.
var runnable : Vec Co.Coroutine = []
var head = 0

-- How many tasks are on the global queue, for a look without its lock.
let globalCount : Ptr = zeroedWord()

-- How many tasks a permit's queue holds at most. A push to a full one goes to
-- the global queue instead.
let localCapacity = 256

-- Every permit's queue, `localCapacity` entries for each slot, the one for
-- slot `s` from `s * localCapacity`, used as a ring. An entry holds a task
-- only while it is queued, so a task once taken is not kept alive by its old
-- entry. Made by `start` for every permit it may start; until then there are
-- none (`localSlots` is 0), and every task goes through the global queue.
var localTasks : Prim.Array (Option Co.Coroutine) = Storage.filled(0, None)
var localSlots = 0

-- Three words for each slot's queue: its lock; how many tasks have ever been
-- taken from it; how many have ever been put on it. A task's entry is that
-- count modulo `localCapacity`. Both counts change only under the lock, and
-- are read without it as a hint (`localLength`).
var localWords : Ptr = Ptr.null()

fun lock() -> Unit = Workers.acquire(waitsLock)
fun unlock() -> Unit = Lock.release(waitsLock)

-- 1 while the program's own code is asleep in `waitOn`, which only what a
-- task does can end.
let programWaits : Ptr = zeroedWord()

-- 1 from when `notify` wakes a worker until some worker, idle then, has
-- looked for work (`idle`).
let looking : Ptr = zeroedWord()

fun zeroedWord() -> Ptr {
    let word = Libc.malloc(8)
    Ptr.atomicStore(word, 0, 0)
    word
}

-- Make `c` runnable: it will be resumed in its turn. Takes one queue's lock.
fun ready(c : Co.Coroutine) -> Unit {
    let _ = Workers.tasksAdd(1, 0)
    push(c)
    notify()
}

-- Put `c` on the running thread's permit's queue, or on the global queue if
-- the thread holds no permit or its queue is full. The caller has counted it
-- queued (`Workers.tasksAdd`), first: a thief may take it as soon as it is on
-- a queue, and counts it off, and the count must not go below zero, since it
-- shares a word with the running count.
fun push(c : Co.Coroutine) -> Unit {
    let s = mySlot()
    if s < 0 || !localPush(s, c) { globalPush(c) }
}

-- The running thread's permit's slot, if it holds a permit and the queues
-- are made; else -1.
fun mySlot() -> Int = if localSlots == 0 { -1 } else { Workers.permitSlot() }

fun localLock(s : Int) -> Ptr = Ptr.load(localWords, s * 24)
fun localHead(s : Int) -> Int = Ptr.atomicLoad(localWords, s * 24 + 8)
fun localTail(s : Int) -> Int = Ptr.atomicLoad(localWords, s * 24 + 16)

-- How many tasks slot `s`'s queue holds: exact under its lock, a hint
-- without it.
fun localLength(s : Int) -> Int = localTail(s) - localHead(s)

-- Put `c` on slot `s`'s queue: whether there was room. Takes its lock.
fun localPush(s : Int, c : Co.Coroutine) -> Bool {
    let lock = localLock(s)
    Workers.acquire(lock)
    let tail = localTail(s)
    let room = tail - localHead(s) < localCapacity
    if room {
        localTasks[s * localCapacity + tail % localCapacity] = Some(c)
        Ptr.atomicStore(localWords, s * 24 + 16, tail + 1)
    }
    Lock.release(lock)
    room
}

-- Put `c` on the global queue. Takes its lock.
fun globalPush(c : Co.Coroutine) -> Unit {
    Workers.acquire(queueLock)
    Vec.push(runnable, c)
    let _ = Ptr.atomicAdd(globalCount, 0, 1)
    Lock.release(queueLock)
}

-- Tasks were just queued: wake an idle worker to run them, unless one has
-- been woken already and not yet found work (`idle`).
fun notify() -> Unit {
    if Workers.idlers() > 0 && Ptr.atomicLoad(looking, 0) == 0
            && Ptr.atomicCas(looking, 0, 0, 1) == 0 {
        Workers.signalWork(False)
    }
}

-- Something the program's own code may be waiting for has changed -- a task
-- finished, a mutex was released, a value made: wake it, if it sleeps. Every
-- idle worker wakes with it, since nothing says which sleeper is the program.
-- Called after the change is made, under the lock it was made under or after.
fun changed() -> Unit {
    if Ptr.atomicLoad(programWaits, 0) != 0 { Workers.signalWork(True) }
}

-- Make `c`, which is waiting, runnable once it has suspended.
fun wake(c : Co.Coroutine) -> Unit {
    if claim(c) { ready(c) }
}

-- Returns whether the caller is to queue `c`, which is waiting: True if it was
-- parked, and is now active; False if it is still running, and is now marked
-- woken.
fun claim(c : Co.Coroutine) -> Bool {
    while True {
        if Co.waitingSwap(c, parked, active) { return True }
        if Co.waitingSwap(c, active, woken) { return False }
        let state = Co.waiting(c)
        if state == woken || state == yielding { return False }
    }
    False
}

-- Wakes each of `tasks`, queuing the ones that are parked on the running
-- thread's permit's queue under one taking of its lock, and any it has no
-- room for on the global queue. Overwrites the front of `tasks` with the ones
-- it queues. Wakes an idle worker only if more than one task went on the
-- permit's queue, or any went on the global queue: one on the permit's queue
-- is the caller's to run next.
fun wakeAll(tasks : Vec Co.Coroutine) -> Unit {
    var n = 0
    for var i = 0; i < len(tasks); i = i + 1 {
        if claim(tasks[i]) {
            tasks[n] = tasks[i]
            n = n + 1
        }
    }
    if n == 0 { return {} }
    -- Counted before they are queued, as `push` requires.
    let _ = Workers.tasksAdd(n, 0)
    var placed = 0
    let s = mySlot()
    if s >= 0 {
        let lock = localLock(s)
        Workers.acquire(lock)
        var tail = localTail(s)
        let first = localHead(s)
        while placed < n && tail - first < localCapacity {
            localTasks[s * localCapacity + tail % localCapacity] = Some(tasks[placed])
            tail = tail + 1
            placed = placed + 1
        }
        Ptr.atomicStore(localWords, s * 24 + 16, tail)
        Lock.release(lock)
    }
    for var i = placed; i < n; i = i + 1 { globalPush(tasks[i]) }
    if n > 1 || placed < n { notify() }
}

-- EXPERIMENT: TURKEY_SETTLEGLOBAL=1 queues the tasks a poll wakes on the global queue.
var settleGlobal : Bool = !Ptr.isNull(Libc.getenv(Prim.cString("TURKEY_SETTLEGLOBAL")))

fun wakeAllGlobal(tasks : Vec Co.Coroutine) -> Unit {
    var n = 0
    for var i = 0; i < len(tasks); i = i + 1 {
        if claim(tasks[i]) {
            tasks[n] = tasks[i]
            n = n + 1
        }
    }
    if n == 0 { return {} }
    let _ = Workers.tasksAdd(n, 0)
    Workers.acquire(queueLock)
    for var i = 0; i < n; i = i + 1 { Vec.push(runnable, tasks[i]) }
    let _ = Ptr.atomicAdd(globalCount, 0, n)
    Lock.release(queueLock)
    notify()
}

-- The next coroutine on the global queue, counted as running until `run`
-- has seen it suspend. Under the global queue's lock.
fun next() -> Option Co.Coroutine {
    if head == len(runnable) { return None }
    let c = runnable[head]
    head = head + 1
    let _ = Ptr.atomicAdd(globalCount, 0, -1)
    let _ = Workers.tasksAdd(-1, 1)
    -- Drop the taken slots as tasks are taken, not when a look finds the
    -- queue empty: nothing may ever look while it is. The program's own stack
    -- stops looking once what it waits for is done, a busy worker finds a task
    -- every time, and with one worker there is no idle one. Copying only when
    -- the taken slots are at least as many as the queued tasks copies no more
    -- tasks, over a run, than are taken: a constant per task.
    if head >= len(runnable) - head {
        runnable = Vec.slice(runnable, head, len(runnable))
        head = 0
    }
    Some(c)
}

-- The next coroutine on the global queue, if any. One load when it is empty.
fun globalTake() -> Option Co.Coroutine {
    if Ptr.atomicLoad(globalCount, 0) == 0 { return None }
    Workers.acquire(queueLock)
    let c = next()
    Lock.release(queueLock)
    c
}

-- The oldest coroutine on slot `s`'s queue, if any, counted as running.
fun localTake(s : Int) -> Option Co.Coroutine {
    if localLength(s) <= 0 { return None }
    let lock = localLock(s)
    Workers.acquire(lock)
    let first = localHead(s)
    if first == localTail(s) {
        Lock.release(lock)
        return None
    }
    let at = s * localCapacity + first % localCapacity
    let c = localTasks[at]
    localTasks[at] = None
    Ptr.atomicStore(localWords, s * 24 + 8, first + 1)
    let _ = Workers.tasksAdd(-1, 1)
    Lock.release(lock)
    c
}

-- Take half of another permit's queue onto slot `s`'s, and return the oldest
-- of the tasks taken, counted as running. One pass over the other slots, from
-- a start that moves on with each call so that thieves spread out.
fun steal(s : Int) -> Option Co.Coroutine {
    let n = localSlots
    let from = Ptr.atomicAdd(stealStart, 0, 1) % n
    for var k = 0; k < n; k = k + 1 {
        let v = (from + k) % n
        if v != s && localLength(v) > 0 {
            match stealFrom(v, s) {
                Some(c) -> return Some(c)
                None -> {}
            }
        }
    }
    None
}

let stealStart : Ptr = zeroedWord()

-- Move half of slot `v`'s tasks, rounded up, to slot `s`'s queue, as many as
-- it has room for, and return the oldest, counted as running. Takes both
-- queues' locks, the lower slot's first, so that two thieves stealing from
-- each other cannot each hold one and wait for the other.
fun stealFrom(v : Int, s : Int) -> Option Co.Coroutine {
    let low = if v < s { v } else { s }
    let high = if v < s { s } else { v }
    Workers.acquire(localLock(low))
    Workers.acquire(localLock(high))
    let first = localHead(v)
    let available = localTail(v) - first
    if available <= 0 {
        Lock.release(localLock(high))
        Lock.release(localLock(low))
        return None
    }
    -- Only a slot's own thread puts tasks on its queue, and that is the
    -- caller, so the room seen here is still there below. The oldest task
    -- is returned rather than queued, so it needs none.
    let room = localCapacity - localLength(s)
    let half = available - available / 2
    let taken = if half > room + 1 { room + 1 } else { half }
    let at = v * localCapacity + first % localCapacity
    let c = localTasks[at]
    localTasks[at] = None
    var tail = localTail(s)
    for var j = 1; j < taken; j = j + 1 {
        let entry = v * localCapacity + (first + j) % localCapacity
        localTasks[s * localCapacity + tail % localCapacity] = localTasks[entry]
        localTasks[entry] = None
        tail = tail + 1
    }
    Ptr.atomicStore(localWords, v * 24 + 8, first + taken)
    Ptr.atomicStore(localWords, s * 24 + 16, tail)
    let _ = Workers.tasksAdd(-1, 1)
    Lock.release(localLock(high))
    Lock.release(localLock(low))
    c
}

-- The next task for the running thread to run, if any: from its permit's
-- queue, the queue of a permit no thread runs tasks with (`orphanTake`), the
-- global queue, what a poll finds, or half of another permit's queue. When `globalFirst`, the global queue and the queues of permits no
-- thread holds come before the thread's own, so that neither can starve
-- behind a thread whose own queue never empties.
fun findWork(globalFirst : Bool) -> Option Co.Coroutine {
    let s = mySlot()
    if s < 0 { return globalTake() }
    if globalFirst {
        match globalTake() {
            Some(c) -> return Some(c)
            None -> {}
        }
        match orphanTake(s) {
            Some(c) -> return Some(c)
            None -> {}
        }
    }
    match localTake(s) {
        Some(c) -> return Some(c)
        None -> {}
    }
    match orphanTake(s) {
        Some(c) -> return Some(c)
        None -> {}
    }
    match globalTake() {
        Some(c) -> return Some(c)
        None -> {}
    }
    -- Nothing queued here: look for events, whose tasks queue here, before
    -- taking another worker's.
    poll(False)
    match localTake(s) {
        Some(c) -> return Some(c)
        None -> {}
    }
    steal(s)
}

-- Take half of the queue of a permit that no thread runs tasks with onto
-- slot `s`'s, as `stealFrom` does, and return the oldest: a permit no thread
-- holds, or one whose holder is blocked in a call
-- (`Turkey.Workers.slotStalled`). A busy thread never steals, so without
-- this the tasks on such a queue would wait for the monitor to hand the
-- permit to a spare thread, and the monitor cannot start one while a
-- collection holds the threads' registration (`Turkey.Workers.spareNew`).
fun orphanTake(s : Int) -> Option Co.Coroutine {
    for var v = 0; v < localSlots; v = v + 1 {
        if v != s && localLength(v) > 0 && Workers.slotStalled(v) {
            match stealFrom(v, s) {
                Some(c) -> return Some(c)
                None -> {}
            }
        }
    }
    None
}

-- Whether the running thread leaves tasks queued that another worker could
-- take: on its permit's queue, or on the global queue.
fun more() -> Bool {
    let s = mySlot()
    (s >= 0 && localLength(s) > 0) || Ptr.atomicLoad(globalCount, 0) > 0
}

-- Resume `c` until it suspends, then queue it if it was woken meanwhile, or
-- park it. The last task to stop running wakes the program's own code if it
-- waits, which may now be waiting on nothing that can happen (`waitOn`).
fun run(c : Co.Coroutine) -> Unit {
    Co.resume(c)
    let again = !Co.finished(c) && !Co.waitingSwap(c, active, parked)
    -- Queued and no longer running in one add, so that the deadlock check
    -- sees `c` as one or the other; and counted before it is queued, as
    -- `push` requires.
    if Workers.tasksAdd(if again { 1 } else { 0 }, -1) >> 32 == 1 { changed() }
    if again {
        -- A yield goes to the global queue, behind every other runnable
        -- task, as Go's `Gosched` does: on the permit's own queue the
        -- thread would take it back at once whenever the queue held nothing
        -- else.
        let yielded = Co.waiting(c) == yielding
        Co.waitingSet(c, active)
        if yielded { globalPush(c) } else { push(c) }
        notify()
    }
}

-- Return once `done` holds. A task gives `register` itself, so that whatever
-- makes `done` hold can wake it, and suspends until then; code on a worker's
-- own stack runs other tasks meanwhile. `done` and `register` run under the
-- lock.
fun waitUntil(done : fun() -> Bool, register : fun(Co.Coroutine) -> Unit) -> Unit =
    waitOn(waitsLock, done, register)

-- `waitUntil`, with `done` and `register` run under `mutex` rather than the
-- scheduler's lock. Whatever makes `done` hold does it under `mutex`, wakes
-- the coroutines registered with it (`wake`), and calls `changed`.
fun waitOn(mutex : Ptr, done : fun() -> Bool, register : fun(Co.Coroutine) -> Unit) -> Unit {
    match Co.running() {
        Some(c) -> while True {
            Workers.acquire(mutex)
            if done() {
                Lock.release(mutex)
                return {}
            }
            register(c)
            Lock.release(mutex)
            Co.suspend()
        }
        None -> {
            var ran = 0
            var searching = False
            while True {
            -- The task this stack ran last may have lost its permit (`afterCall`).
            if !Workers.permitHeld() { Workers.permitAwait(True) }
            if holds(mutex, done) {
                if searching { stopLooking() }
                passOn()
                return {}
            }
            let seen = Workers.workSeen()
            match findWork(ran == 0) {
                Some(c) -> {
                    if searching {
                        searching = False
                        stopLooking()
                    }
                    if more() { notify() }
                    run(c)
                    ran = ran + 1
                    if ran % pollEvery == 0 { poll(True) }
                    if ran == globalEvery { ran = 0 }
                }
                None -> {
                    Ptr.atomicStore(programWaits, 0, 1)
                    -- Look again, now that `changed` will signal: whatever made
                    -- `done` hold since the look above called it before
                    -- `programWaits` was set, and anything after moves the
                    -- epoch past `seen`.
                    var over = holds(mutex, done)
                    -- Nothing to run here or anywhere, and nothing done: only a
                    -- task could make it so, and every task is waiting, for
                    -- nothing the poller could deliver either. A task that
                    -- ended after the look at `done` and before `stuck`'s may
                    -- have made it hold, so look once more; with nothing
                    -- running, nothing can change it after.
                    if !over && stuck() {
                        over = holds(mutex, done)
                        if !over { return error("deadlock: every task is waiting") }
                    }
                    if !over {
                        idle(seen)
                        searching = True
                    }
                    Ptr.atomicStore(programWaits, 0, 0)
                    if over { return {} }
                }
            }
            }
        }
    }
}

fun holds(mutex : Ptr, done : fun() -> Bool) -> Bool {
    Workers.acquire(mutex)
    let over = done()
    Lock.release(mutex)
    over
}

-- Returns whether nothing is queued or running and nothing is registered
-- with the poller, so that no task can ever run again.
fun stuck() -> Bool {
    -- A `settle` delivers events under the poller's lock and then queues their
    -- tasks under the queue's lock, and between the two neither shows them. It
    -- moves `settling` to odd before and back to even after, so take an
    -- answer only from a look that no `settle` overlapped. Waits end otherwise
    -- only by what a running task does.
    while True {
        let before = Ptr.atomicLoad(settling, 0)
        if before % 2 == 0 {
            if !Workers.tasksNone() || Workers.interest() > 0 { return False }
            if Ptr.atomicLoad(settling, 0) == before { return True }
        } else {
            let _ = Libc.schedYield()
        }
    }
    False
}

-- -- the poller ------------------------------------------------------------------------

-- Odd while a `settle` is under way (`stuck`).
let settling : Ptr = zeroedWord()

-- Apply what the poller found, as the worker that holds its claim: its first
-- `n` results, and then the deadlines that have passed. Each wait that ends
-- wakes its task, and the program's own code if it waits.
fun settle(n : Int) -> Unit {
    let _ = Ptr.atomicAdd(settling, 0, 1)
    Poll.lock()
    -- Read the clock under the lock, so that waiting for the lock does not
    -- make the reading stale.
    let now = Poll.now()
    var ended = 0
    for var i = 0; i < n; i = i + 1 {
        ended = ended + Poll.deliver(Workers.resultToken(i), Workers.resultValue(i))
    }
    ended = ended + Poll.expire(now)
    let tasks = Poll.takeWoken()
    Poll.unlock()
    if ended > 0 {
        if settleGlobal { wakeAllGlobal(tasks) } else { wakeAll(tasks) }
        changed()
    }
    let _ = Ptr.atomicAdd(settling, 0, 1)
}

-- Look for events and deadlines without waiting: the worker that gets the
-- claim does it, any other has nothing to add. With nothing registered it is
-- one load. A busy worker, which goes on running tasks after, passes
-- `handOn`; one about to look for work and then wait does not, since it
-- takes the claim again in `wait` if it finds none.
fun poll(handOn : Bool) -> Unit {
    if Workers.interest() > 0 && Workers.claim() {
        let n = Workers.pollNow()
        settle(if n > 0 { n } else { 0 })
        Workers.release()
        -- While this worker held the claim none other could poll, and the idle
        -- ones that found it taken are asleep on the work epoch. Wake one, so
        -- that a deadline is not left to a poller that does not exist: it
        -- takes the claim in `idle` and blocks in it. Once one is blocked the
        -- claims here fail, and this signals nothing.
        if handOn && Workers.interest() > 0 { Workers.signalWork(False) }
    }
}

-- Wait for something to do, which `seen`, the work epoch read before looking
-- for it, says has not come. If a wait is registered and no other worker is
-- polling, this one waits for the poller's events instead, until the nearest
-- deadline. When it is done, and waits remain, it wakes another idle worker to
-- take over, since it will be busy or gone.
--
-- A poller that cannot be had (`pause` answers a negated error number) leaves
-- a worker that sleeps as it would if nothing were registered.
--
-- A worker idle when `notify` woke one may be the one it woke. It leaves
-- `looking` set on the way out, so that no other is woken while it looks for
-- work, and its caller clears it once it has looked: having found a task, it
-- then wakes another if it leaves tasks queued (`more`), and having found
-- none, it comes back here. Each clearing is followed by a look, so a task
-- queued while `looking` was set is seen: here, on the way in, at every queue
-- (`Workers.queued`), and by the caller after it clears it, or, if it leaves
-- without looking, by `passOn`.
fun idle(seen : Int) -> Unit {
    Workers.idleEnter()
    stopLooking()
    if Workers.queued() == 0 { wait(seen) }
    Workers.idleLeave()
}

-- Wakes an idle worker if tasks are queued, as `notify` does. Called by a
-- worker that leaves without taking from the queue, which may be the one
-- `notify` woke for them (`idle`).
fun passOn() -> Unit {
    if Workers.queued() > 0 { notify() }
}

fun stopLooking() -> Unit {
    if Ptr.atomicLoad(looking, 0) != 0 { Ptr.atomicStore(looking, 0, 0) }
}

fun wait(seen : Int) -> Unit {
    if Workers.interest() == 0 || !Workers.claim() {
        let _ = Heap.pause(seen, -1)
        return {}
    }
    -- Watch from before the look at the deadlines, so that one made during
    -- the look is either in it or noted, which breaks the wait
    -- (`Turkey.Poll.timerAdd`, `Turkey.Wait.tell`).
    Poll.watch(Poll.noDeadline)
    let now = Poll.now()
    let timeout = Poll.timeout(now)
    if timeout == -1 {
        Poll.watch(-1)
        Workers.release()
        let _ = Heap.pause(seen, -1)
        return {}
    }
    if timeout >= 0 { Poll.watch(now + timeout) }
    let n = Heap.pause(seen, timeout)
    Poll.watch(-1)
    if n < 0 {
        Workers.release()
        let _ = Heap.pause(seen, -1)
        return {}
    }
    settle(n)
    Workers.release()
    if Workers.interest() > 0 { Workers.signalWork(False) }
}

-- Back from a blocking call (`Turkey.Workers.blockingRead` and the rest),
-- in which the monitor may have given the thread's permit to another
-- (`Turkey.Monitor`): if the thread came back without one, give the running
-- task back to be queued, as `yield` does, and go on in it on whichever
-- thread takes it. The thread, back in its own loop, parks as a spare
-- (`workerLoop`). One load when the permit is still there. The program's own
-- stack waits for a permit in the call instead (`Turkey.Workers.callExit`).
fun afterCall() -> Unit {
    if !Workers.permitHeld() { yield() }
}

-- Let the other runnable tasks run before going on. On a worker's own stack,
-- that is each task runnable now, once.
fun yield() -> Unit = match Co.running() {
    Some(c) -> {
        -- Running, so the only other change to its word is a wake's, which
        -- leaves a yielding coroutine as it is (`claim`).
        Co.waitingSet(c, yielding)
        Co.suspend()
    }
    None -> {
        let count = Workers.queued()
        for var i = 0; i < count; i = i + 1 {
            match findWork(i == 0) {
                Some(c) -> run(c)
                None -> {}
            }
        }
    }
}

-- -- workers ----------------------------------------------------------------------------

-- Start a thread holding a permit for each permit `TURKEY_WORKERS` asks for
-- beyond the program's own, and the monitor, and answer how many permits
-- there are. Each thread runs `workerLoop`, entered through
-- `turkey_worker_start` (`Turkey.Emit.emitWorkerStart`), which sets its
-- record in `x28`. Called on the program's own thread, as `System.Task` is
-- initialized and by whatever needs the workers before a task exists
-- (`Turkey.Detach`); a call after the first starts nothing and answers the
-- same.
fun start() -> Int {
    if Workers.started() { return Workers.permits() }
    let wanted = workersWanted()
    -- Every permit's queue, before any other thread can push to one.
    localWords = Libc.malloc(24 * wanted)
    for var s = 0; s < wanted; s = s + 1 {
        Ptr.store(localWords, s * 24, Lock.new())
        Ptr.atomicStore(localWords, s * 24 + 8, 0)
        Ptr.atomicStore(localWords, s * 24 + 16, 0)
    }
    localTasks = Storage.filled(wanted * localCapacity, None)
    localSlots = wanted
    Workers.mainRegister()
    var started = 1
    while started < wanted {
        let record = Workers.new()
        if Ptr.isNull(record) { break }
        let thread = Libc.malloc(8)
        let _ = Libc.pthreadCreate(thread, Ptr.null(),
                                   Prim.codeAddress("turkey_worker_start"), record)
        started = started + 1
    }
    Workers.permitsSet(started)
    let _ = Workers.monitorStart()
    started
}

-- `TURKEY_WORKERS`, a decimal count, or else one per core that runs at full
-- speed (`Turkey.Cores`).
fun workersWanted() -> Int {
    let text = Libc.getenv(Prim.cString("TURKEY_WORKERS"))
    if Ptr.isNull(text) { return Cores.count() }
    var n = 0
    var at = 0
    while True {
        let digit = Byte.toInt(Ptr.load(text, at)) - 48
        if digit < 0 || digit > 9 { break }
        n = n * 10 + digit
        at = at + 1
    }
    if n < 1 { 1 } else { n }
}

-- A thread's Turkey code, other than the program's own: the monitor's
-- (`Turkey.Monitor`), or else the thread's stack registered, then, until the
-- program ends, a permit and the tasks it lets the thread run, until the
-- permit is gone. It returns only when a panic unwinds it, and then
-- `turkey_worker_start` hands the panic to the program's own thread
-- (`Turkey.Workers.ended`).
fun workerLoop() -> Unit {
    if Workers.monitoring() { return Monitor.run() }
    Workers.blockExit()
    -- The bound is the record above this function's, `turkey_worker_start`'s:
    -- a walk scans each frame through the record below it, and stops at the
    -- bound, so this function's own frame is scanned only if it is below it.
    if !Stack.threadStackSet(Ptr.load(Prim.frameAddress(), 0)) {
        return error("no memory for a worker's stack record")
    }
    while True {
        Workers.permitAwait(False)
        serve()
    }
}

-- Run tasks while the running thread holds its permit: until the task it ran
-- last lost it in a call, or the thread gives it to the program's own stack,
-- which waits for one.
fun serve() -> Unit {
    var ran = 0
    -- Whether this worker has come back from `idle` and not yet found work,
    -- and so may hold `looking` for the worker `notify` woke.
    var searching = False
    while Workers.permitHeld() {
        if Workers.permitWanted() && Workers.permitGive() {
            if searching { stopLooking() }
            passOn()
            return {}
        }
        -- Before looking, so that a signal after the look ends its sleep
        -- (`Turkey.Workers.sleepForWork`).
        let seen = Workers.workSeen()
        match findWork(ran == 0) {
            Some(c) -> {
                if searching {
                    searching = False
                    stopLooking()
                }
                if more() { notify() }
                run(c)
                ran = ran + 1
                if ran % pollEvery == 0 { poll(True) }
                if ran == globalEvery { ran = 0 }
            }
            None -> {
                idle(seen)
                searching = True
            }
        }
    }
    if searching { stopLooking() }
    passOn()
}

-- How many tasks a busy worker runs between looks for events (`poll`). A
-- look is a system call whenever anything is registered, and between the
-- looks an event waits for an idle worker blocked in the poller, so this
-- bounds an event's delay only while every worker is busy. A look after
-- every task would cost most of a system call for each request a server
-- answers, most of them finding nothing. 61 was not chosen by measurement.
-- EXPERIMENT: TURKEY_POLLEVERY overrides it.
var pollEvery : Int = envCount(Prim.cString("TURKEY_POLLEVERY"), 61)

-- How many tasks a thread runs between looks at the global queue and the
-- stalled permits' queues before its own (`findWork`).
let globalEvery = 61

fun envCount(name : Ptr, otherwise : Int) -> Int {
    let text = Libc.getenv(name)
    if Ptr.isNull(text) { return otherwise }
    var n = 0
    var at = 0
    while True {
        let digit = Byte.toInt(Ptr.load(text, at)) - 48
        if digit < 0 || digit > 9 { break }
        n = n * 10 + digit
        at = at + 1
    }
    if n < 1 { 1 } else { n }
}
