export (
    running, first, next, high, parked, parkedSet, new, free, resumer, resumerSet,
    threadStackSet,
)

-- The machine stacks Turkey code runs on: the program's own, and a
-- coroutine's, which this module maps, lays out and unmaps. Each is a raw
-- record on one list, which the collector walks for roots (`Turkey.Heap`)
-- and `turkey_swap_stack` switches between (`Turkey.Emit`).
--
-- A giblet module: it runs before anything can allocate and holds nothing
-- the collector traces. It never switches stacks itself, and edits only a
-- stack nothing is running on.

import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)
import Data.Eq (Eq(..), (==), (!=))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..), (+), (-), (*), (/), (%))
import Bits (BitAnd(..), (&))
import Control.Iterator (Iterator(..))
import Data.Int ()
import Data.Bool (Bool(..))
import Target (OS(..))
import Target as Target
import Turkey.Process as Process
import Turkey.Libc as Libc
import Turkey.Lock as Lock
import Data.Int as Int
import Turkey.Ptr (Ptr)
import Turkey.Ptr as Ptr

-- A machine stack Turkey frames run on: the outermost frame record any walk of
-- it may reach, the frame record it was parked at (null while it runs), the
-- next stack on the list, the start of its mapping (null for the program's
-- own stack, which this module did not map), and the stack whose code last
-- resumed it, which `Turkey.Coroutine` switches back to.
--
-- `Turkey.Runtime` holds the compiler's copy of the offsets the code it writes
-- reads: the parked frame and the resumer. `Turkey.HeapCheck` reads the
-- records by its own copy of the layout, so that a mistake here is not
-- checked by the same mistake.
let stackHigh : Int = 0
let stackParked : Int = 8
let stackNext : Int = 16
let stackLow : Int = 24
let stackResumedBy : Int = 32
let stackBytes : Int = 40

-- Every machine stack that holds Turkey frames, as a list of raw records, and
-- the one the running worker is on, which `turkey_swap_stack` changes. The
-- program's own stack is the first, registered by the generated entry once
-- early initialization has run. A collection (`Turkey.Heap`) walks the running
-- stack from the allocator's frame and every other stack from the frame it was
-- parked at, so a stack must be on this list before Turkey code that can
-- allocate runs on it, and must have its parked frame recorded before it stops
-- running.
var stacks : Ptr = Ptr.null()
var entryStack : Ptr = Libc.malloc(stackBytes)

-- Held while a worker edits the list. A collection reads it with every other
-- worker stopped, and takes no lock.
var stacksLock : Ptr = Lock.new()

-- Recorded by the generated entry, from its own frame, after early
-- initialization and before anything can allocate: the program's own stack,
-- running, and the only one there is.
foreign "turkey_entry_stack_set" fun entryStackSet(frame : Ptr) -> Unit {
    if Ptr.isNull(entryStack) {
        Process.panic(Prim.cString("no memory for the stack record"))
        return {}
    }
    Ptr.store(entryStack, stackHigh, frame)
    Ptr.store(entryStack, stackParked, Ptr.null())
    Ptr.store(entryStack, stackNext, Ptr.null())
    Ptr.store(entryStack, stackLow, Ptr.null())
    Ptr.store(entryStack, stackResumedBy, Ptr.null())
    stacks = entryStack
    Ptr.store(Prim.processState(), runningAt(), entryStack)
}

-- The stack the running worker is on: the one `Prim.swapStack` would switch
-- away from. A word of the worker's record (`Prim.processState`), since each
-- worker runs a stack of its own; `Turkey.Runtime.workerRunningStack` is the
-- compiler's copy of the offset, for the switch. A function rather than a
-- `let` because a `let` is a load from its global.
fun running() -> Ptr = Ptr.load(Prim.processState(), runningAt())

fun runningAt() -> Int = 280

-- The list, for walking it: the first stack, and the one after `stack`.
fun first() -> Ptr = stacks
fun next(stack : Ptr) -> Ptr = Ptr.load(stack, stackNext)

-- The outermost frame record any walk of `stack` may reach, and the record it
-- was parked at, null while it runs.
fun high(stack : Ptr) -> Ptr = Ptr.load(stack, stackHigh)
fun parked(stack : Ptr) -> Ptr = Ptr.load(stack, stackParked)

-- Record the frame a stack's worker stopped at, for a collection to walk it
-- from (`Turkey.Workers`), or null when it runs again. A worker stopped for a
-- collection looks to it like any parked stack.
fun parkedSet(stack : Ptr, frame : Ptr) -> Unit =
    Ptr.store(stack, stackParked, frame)

-- A worker thread's own stack, registered and running, as `entryStackSet` does
-- for the program's: `frame` is its outermost Turkey frame record. False if
-- there was no memory for the record.
fun threadStackSet(frame : Ptr) -> Bool {
    let record = Libc.malloc(stackBytes)
    if Ptr.isNull(record) { return False }
    Ptr.store(record, stackHigh, frame)
    Ptr.store(record, stackParked, Ptr.null())
    Ptr.store(record, stackLow, Ptr.null())
    Ptr.store(record, stackResumedBy, Ptr.null())
    Lock.acquire(stacksLock)
    Ptr.store(record, stackNext, stacks)
    stacks = record
    Lock.release(stacksLock)
    Ptr.store(Prim.processState(), runningAt(), record)
    True
}

-- The stack whose code last resumed `stack`, which `Turkey.Coroutine` switches
-- back to.
fun resumer(stack : Ptr) -> Ptr = Ptr.load(stack, stackResumedBy)

fun resumerSet(stack : Ptr, by : Ptr) -> Unit =
    Ptr.store(stack, stackResumedBy, by)

-- Below every coroutine stack, a region mapped with no access, so that running
-- off the end faults instead of writing over whatever is mapped next. A
-- multiple of every page size arm64 systems use (4, 16 and 64KB), which
-- `mprotect` needs; it costs address space and no memory.
let stackGuardBytes = 65536

-- A stack of `bytes` for a coroutine, registered and parked, ready for its
-- first switch; null if there was no memory for it.
--
-- Mapped rather than allocated, so a page costs memory only once it is
-- touched. Laid out from the top, all of it written here because nothing
-- runs on the stack yet:
--
--     high - 16   {0, 0}                   the outermost frame record
--     high - 32   {stack, 0}               what `turkey_stack_start` reads
--     high - 48   {high - 16, start}       the parked record
--
-- The first switch to the stack resumes the parked record as it would any:
-- `x29` from its first word and a return into its second, which is
-- `turkey_stack_start` (`Turkey.Emit.emitStackStart`), with `sp` above the
-- record. That code calls the coroutine's start, whose frame record then
-- links to the outermost one -- a record whose saved `x29` is zero, where
-- every walk of the stack stops.
fun new(bytes : Int) -> Ptr {
    let total = Int.addWrapping(stackGuardBytes, bytes)
    let base = Libc.mmap(Ptr.null(), total, protReadWrite, mapPrivateAnonymous(),
                         -1, 0)
    if Ptr.toInt(base) == -1 { return Ptr.null() }
    if Libc.mprotect(base, stackGuardBytes, protNone) & 0xFFFF_FFFF != 0 {
        let _ = Libc.munmap(base, total)
        return Ptr.null()
    }
    let record = Libc.malloc(stackBytes)
    if Ptr.isNull(record) {
        let _ = Libc.munmap(base, total)
        return Ptr.null()
    }
    let high = Ptr.add(base, total)
    let outermost = Ptr.add(high, -16)
    let entry = Ptr.add(high, -32)
    let parked = Ptr.add(high, -48)
    Ptr.store(outermost, 0, Ptr.null())
    Ptr.store(outermost, 8, Ptr.null())
    Ptr.store(entry, 0, record)
    Ptr.store(entry, 8, Ptr.null())
    Ptr.store(parked, 0, outermost)
    Ptr.store(parked, 8, Prim.codeAddress("turkey_stack_start"))
    Ptr.store(record, stackHigh, high)
    Ptr.store(record, stackParked, parked)
    Ptr.store(record, stackLow, base)
    Ptr.store(record, stackResumedBy, Ptr.null())
    Lock.acquire(stacksLock)
    Ptr.store(record, stackNext, stacks)
    stacks = record
    Lock.release(stacksLock)
    record
}

-- Unregister and unmap a stack whose last frame is gone: one that is parked
-- for good, never to be resumed. Never the running one.
fun free(stack : Ptr) -> Unit {
    if stack == running() || Ptr.isNull(Ptr.load(stack, stackLow)) {
        Process.panic(Prim.cString("freed a stack that is running or not a coroutine's"))
        return {}
    }
    Lock.acquire(stacksLock)
    let found = unlink(stack)
    Lock.release(stacksLock)
    if !found {
        Process.panic(Prim.cString("freed a stack that is not registered"))
        return {}
    }
    let low : Ptr = Ptr.load(stack, stackLow)
    let _ = Libc.munmap(low, Ptr.diff(Ptr.load(stack, stackHigh), low))
    Libc.free(stack)
}

-- Take `stack` off the list; False if it is not on it. Under `stacksLock`, so
-- it reports rather than panics: a panic would return past the release.
fun unlink(stack : Ptr) -> Bool {
    if stacks == stack {
        stacks = Ptr.load(stack, stackNext)
        return True
    }
    var before = stacks
    while !Ptr.isNull(before) && Ptr.load(before, stackNext) != stack {
        before = Ptr.load(before, stackNext)
    }
    if Ptr.isNull(before) { return False }
    Ptr.store(before, stackNext, Ptr.load(stack, stackNext) : Ptr)
    True
}

-- `PROT_*` and the `MAP_*` flags of a private mapping of no file. The protections
-- are the same everywhere; `MAP_ANON` is 0x1000 on Darwin and 0x20 on Linux.
let protNone = 0
let protReadWrite = 3

fun mapPrivateAnonymous() -> Int = match Target.os {
    Darwin -> 0x1002
    Linux -> 0x22
}
