module Turkey.Stdout (print, write, writeAll)

-- `print` and `write`, which the Prelude exports, and so the one part of the
-- standard streams every program compiles.
--
-- Kept apart from `System.IO` because the Prelude imports this module: what it
-- imports cannot import the Prelude, and so cannot import anything that does,
-- such as the scheduler a descriptor's lock suspends tasks through. This
-- module therefore names each library module it uses, and `System.IO`, which
-- only programs that ask for it compile, is free to use the Prelude.
--
-- A failed write to stdout is not reported: there is nowhere to report it to,
-- and a program whose stdout is a closed pipe should not have to test every
-- line it prints.
--
-- A line is one string, newline included, so that it goes out in one `write`
-- where the kernel allows it: two processes sharing a terminal interleave by
-- line and not by fragment.

import Prelude ()
import Std.Classes
import Data.Bool.Type (Bool(..))
import Data.String.Type as Str
import Turkey.IO as IO
import Turkey.Sys as Sys

fun print(x) { let _ = writeAll(1, Str.concat(show(x), "\n")) }
fun write(x) { let _ = writeAll(1, show(x)) }

-- Whether all of `text` reached `fd`. `write` may take fewer bytes than it
-- was offered -- a pipe, a signal -- so it is asked again from where it
-- stopped, and again at once if a signal interrupted it before it took any.
-- Any other failure ends it; so does 0, which for a non-empty request would
-- otherwise loop.
fun writeAll(fd : Int, text : String) -> Bool {
    let size = Prim.arrayLength(Str.bytesOf(text))
    var done = 0
    while done < size {
        let n = IO.writeText(fd, text, done, size)
        if n == 0 - Sys.eintr { continue }
        if n <= 0 { return False }
        done = done + n
    }
    True
}
