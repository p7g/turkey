export (clientHello, alpnSelect, chosenAt, protocolsLengthAt, protocolsAt)

--- The two functions OpenSSL calls back during a server's handshake, written
--- as `foreign` definitions so that `Net.TLS` can hand OpenSSL their addresses
--- (`Prim.codeAddress`).
---
--- A giblet module, because a C caller sets nothing up: these run inside
--- `SSL_do_handshake`, on the stack of the task that called it, and may not
--- allocate or hold anything the collector traces. So they decide nothing
--- that needs a Turkey value. Each reads the connection's block, which slot 0
--- of the `SSL`'s application data points at, and which `Net.TLS` owns: it
--- allocates the block with the connection and frees it straight after
--- `SSL_free`, so the block outlives every callback. The layout, in bytes:
---
--- * at `chosenAt`, nonzero once `Net.TLS` has chosen the connection's
---   certificate;
--- * at `protocolsLengthAt`, the length of the server's ALPN list;
--- * from `protocolsAt`, the list itself, in ALPN's wire form.
---
--- **Choosing a certificate by SNI is done by `Net.TLS`, not here,** because
--- matching a name against a certificate is ordinary code that allocates. The
--- client-hello callback asks OpenSSL to stop the handshake until the choice
--- is made: it answers `SSL_CLIENT_HELLO_RETRY`, `SSL_do_handshake` returns
--- with `SSL_ERROR_WANT_CLIENT_HELLO_CB`, `Net.TLS` reads the name, moves the
--- connection to the chosen context and sets the flag, and the next
--- `SSL_do_handshake` calls this again, which then lets the handshake on.

import Prelude ()
import Data.Int (Int)
import Data.Eq (Eq(..), (==), (!=))
import Data.Num (Neg(..))
import Bits (BitAnd(..), (&))
import Turkey.OpenSSL as OpenSSL
import Turkey.Ptr (Ptr)
import Turkey.Ptr as Ptr

let chosenAt : Int = 0
let protocolsLengthAt : Int = 8
let protocolsAt : Int = 16

-- `int (*)(SSL *, int *alert, void *argument)`: retry until a certificate is
-- chosen, then go on. A connection without a block has nothing to choose.
-- The constants are written out: a giblet reads no global it need not.
foreign "turkey_tls_client_hello" fun clientHello(ssl : Ptr, alert : Ptr,
                                                  argument : Ptr) -> Int {
    let block = OpenSSL.sslGetExData(ssl, 0)
    -- SSL_CLIENT_HELLO_SUCCESS
    if Ptr.isNull(block) { return 1 }
    -- SSL_CLIENT_HELLO_SUCCESS, or SSL_CLIENT_HELLO_RETRY
    let chosen : Int = Ptr.load(block, 0)
    if chosen != 0 { 1 } else { -1 }
}

-- `int (*)(SSL *, const unsigned char **out, unsigned char *outLength, const
-- unsigned char *client, unsigned int clientLength, void *argument)`: the
-- first of the server's protocols that the client also offers. With none in
-- common the handshake fails with a `no_application_protocol` alert, as RFC
-- 7301 asks. A server that offers none answers without ALPN.
foreign "turkey_tls_alpn_select" fun alpnSelect(ssl : Ptr, out : Ptr,
                                                outLength : Ptr, client : Ptr,
                                                clientLength : Int, argument : Ptr) -> Int {
    let block = OpenSSL.sslGetExData(ssl, 0)
    -- SSL_TLSEXT_ERR_NOACK: no protocol, and no alert.
    if Ptr.isNull(block) { return 3 }
    let length : Int = Ptr.load(block, 8)
    if length == 0 { return 3 }
    -- `clientLength` is a C `unsigned int`, with the high half undefined.
    let r = OpenSSL.sslSelectNextProto(out, outLength, Ptr.add(block, 16), length,
                                       client, clientLength & 0xFFFF_FFFF)
    -- OPENSSL_NPN_NEGOTIATED: SSL_TLSEXT_ERR_OK; else SSL_TLSEXT_ERR_ALERT_FATAL.
    if (r & 0xFFFF_FFFF) == 1 { 0 } else { 2 }
}
