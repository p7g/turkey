export (
    now, sleepUntil, readable, writable, readableUnless, writableUnless, childExit, lockedUnless,
    cancel, forget, timedOut, cancelled,
)

-- Waiting for time, a descriptor, a child or a file lock without holding a
-- worker: the caller parks as it does for a mutex
-- (`Turkey.Scheduler.waitUntil`), so from a task it suspends and its worker
-- runs others, and from the program's own stack it runs tasks and drives the
-- poller until the wait ends.
--
-- A separate module from the scheduler because the scheduler is in every
-- program and this is only for those that wait for the outside: it needs
-- `Turkey.Poll`, which the scheduler already has, and the scheduler's lock
-- and `waitUntil`.
--
-- The Prelude imports `Turkey.Stdout`, which parks on a full pipe through this
-- module, so this module names each library module it uses and does not import
-- the Prelude.
--
-- Time is nanoseconds on a monotonic clock (`now`), and a deadline is a point
-- on it, or -1 for none. A wait answers:
--
-- * descriptors: 0 when ready, hung up or failed -- the operation says which;
-- * children: the wait status `waitpid` stored, which is 0 or more;
-- * file locks: 0 once the lock is taken;
-- * for any, `timedOut` if the deadline came first, `cancelled` if the
--   descriptor was closed under the wait (`Turkey.Poll.cancel`), or the
--   negated error number if the wait could not be made.
--
-- A deadline that has passed already answers `timedOut` without waiting, even
-- if the event is ready.

import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)
import Data.Eq (Eq(..), (==), (!=))
import Data.Ord (Ord(..), (<), (<=), (>), (>=))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..), (+), (-), (*), (/), (%))
import Control.Iterator (Iterator(..))
import Data.Index (Index(..), SetIndex(..), Length(..))
import Data.Bool (Bool(..))
import Data.Int ()
import Turkey.Poll as Poll
import Turkey.Scheduler as Scheduler
import Turkey.Workers as Workers

let timedOut : Int = Poll.timedOut
let cancelled : Int = Poll.cancelled

fun now() -> Int = Poll.now()

-- Return at `deadline`.
fun sleepUntil(deadline : Int) -> Unit {
    if passed(deadline) { return {} }
    let _ = park(fun() = Poll.sleeper(deadline))
}

-- Wait for `fd` to be readable.
fun readable(fd : Int, deadline : Int) -> Int =
    if passed(deadline) { timedOut } else { park(fun() = Poll.readable(fd, deadline)) }

-- Wait for `fd` to be writable.
fun writable(fd : Int, deadline : Int) -> Int =
    if passed(deadline) { timedOut } else { park(fun() = Poll.writable(fd, deadline)) }

-- `readable` and `writable` that answer `cancelled` without waiting if `stop()`
-- is true once the wait may be registered, which is under the scheduler's lock,
-- so that `stop` must only read. A closer that makes `stop` true and then calls
-- `cancel` ends this wait either way: `cancel` finds it registered, or `stop`
-- sees what the closer made true.
fun readableUnless(fd : Int, deadline : Int, stop : fun() -> Bool) -> Int =
    if passed(deadline) { timedOut } else { parkUnless(fun() = Poll.readable(fd, deadline), stop) }

fun writableUnless(fd : Int, deadline : Int, stop : fun() -> Bool) -> Int =
    if passed(deadline) { timedOut } else { parkUnless(fun() = Poll.writable(fd, deadline), stop) }

-- Wait for the child `pid` to exit, and reap it. Only the one wait for a
-- child may exist at a time, and nothing else in the program may reap it
-- (`Turkey.Poll`).
fun childExit(pid : Int, deadline : Int) -> Int =
    if passed(deadline) { timedOut } else { park(fun() = Poll.childExit(pid, deadline)) }

-- Take `operation`'s `flock` lock on `fd`'s file, `operation` being without
-- `LOCK_NB`, waiting while another holder has it, unless `stop()` (as for
-- `readableUnless`). A wait that ends other than with 0 has not taken the
-- lock. Darwin only: the poller learns of releases there and not on Linux
-- (`Turkey.Poll`).
fun lockedUnless(fd : Int, operation : Int, deadline : Int, stop : fun() -> Bool) -> Int =
    if passed(deadline) { timedOut } else { parkUnless(fun() = Poll.locked(fd, operation, deadline), stop) }

-- `fd` is about to be closed: end every wait on it with `cancelled`.
fun cancel(fd : Int) -> Unit {
    Scheduler.lock()
    if Poll.cancel(fd) > 0 {
        let tasks = Poll.takeWoken()
        for var i = 0; i < len(tasks); i = i + 1 { Scheduler.wake(tasks[i]) }
        Scheduler.changed()
    }
    Scheduler.unlock()
}

-- Drop the poller's interest in `fd`, before its number is closed.
fun forget(fd : Int) -> Unit {
    Scheduler.lock()
    Poll.forget(fd)
    Scheduler.unlock()
}

fun passed(deadline : Int) -> Bool = deadline >= 0 && Poll.now() >= deadline

-- Make the wait `start` makes, and park until it ends.
--
-- The workers that may not be watching for it are told. A first wait wakes an
-- idle worker to poll for it. A deadline earlier than the others wakes the one
-- that polls, which is waiting for a later one: the signal moves the work
-- epoch too, so that a worker that computed its timeout before this wait was
-- made and has not yet begun to wait does not begin.
fun park(start : fun() -> Poll.Waiter) -> Int = parkUnless(start, fun() = False)

fun parkUnless(start : fun() -> Poll.Waiter, stop : fun() -> Bool) -> Int {
    Scheduler.lock()
    if stop() {
        Scheduler.unlock()
        return cancelled
    }
    let before = Workers.interest()
    let w = start()
    let earlier = Poll.takeHeadMoved()
    if earlier || (before == 0 && Workers.interest() > 0) { Workers.signalWork(False) }
    if earlier { Workers.wakePoller() }
    Scheduler.unlock()
    Scheduler.waitUntil(fun() = Poll.finished(w), fun(c) = Poll.park(w, c))
    Poll.outcome(w)
}
