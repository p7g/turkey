export (
    now, sleepUntil, readable, writable, readableUnless, writableUnless, readableUnlessAsOf,
    writableUnlessAsOf, readableBlockingUnless, childExit, lockedUnless,
    sourceOf, onUnlessAsOf,
    cancel, forget, park, parkApart, sleeper, complete, finished, timedOut, cancelled,
)

-- Waiting for time, a descriptor, a child or a file lock without holding a
-- worker: the caller parks as it does for a mutex
-- (`Turkey.Scheduler.waitUntil`), so from a task it suspends and its worker
-- runs others, and from the program's own stack it runs tasks and drives the
-- poller until the wait ends.
--
-- A separate module from the scheduler because the scheduler is in every
-- program and this is only for those that wait for the outside: it needs
-- `Turkey.Poll`, which the scheduler already has, and the scheduler's
-- `waitOn`.
--
-- A wait is made, checked and parked on under the poller's lock
-- (`Turkey.Poll.lock`), not the scheduler's, and the tasks of the waits that
-- end are woken after it is let go. Waits that another task ends
-- (`parkApart`) are made under the scheduler's lock too, which guards what
-- their owners keep beside them, a semaphore's queue, say; the poller's is
-- taken inside it, never the other way round.
--
-- The Prelude imports `Turkey.Stdout`, which parks on a full pipe through this
-- module, so this module names each library module it uses and does not import
-- the Prelude.
--
-- Time is nanoseconds on a monotonic clock (`now`), and a deadline is a point
-- on it, or -1 for none. A wait answers:
--
-- * descriptors: 0 when ready, hung up or failed -- the operation says which;
-- * children: the wait status `waitpid` stored, which is 0 or more;
-- * file locks: 0 once the lock is taken;
-- * for any, `timedOut` if the deadline came first, `cancelled` if the
--   descriptor was closed under the wait (`Turkey.Poll.cancel`), or the
--   negated error number if the wait could not be made.
--
-- A deadline that has passed already answers `timedOut` without waiting, even
-- if the event is ready.

import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)
import Data.Eq (Eq(..), (==), (!=))
import Data.Ord (Ord(..), (<), (<=), (>), (>=))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..), (+), (-), (*), (/), (%))
import Control.Iterator (Iterator(..))
import Data.Index (Index(..), SetIndex(..), Length(..))
import Data.Bool (Bool(..))
import Data.Int ()
import Data.Option (Option(..))
import Data.Vec (Vec)
import Turkey.Coroutine as Co
import Turkey.Libc as Libc
import Turkey.Lock as Lock
import Turkey.Poll as Poll
import Turkey.Scheduler as Scheduler
import Turkey.Workers as Workers
import Turkey.Ptr (Ptr)
import Turkey.Ptr as Ptr

let timedOut : Int = Poll.timedOut
let cancelled : Int = Poll.cancelled

fun now() -> Int = Poll.now()

-- Return at `deadline`.
fun sleepUntil(deadline : Int) -> Unit {
    if passed(deadline) { return {} }
    let _ = park(fun() = Poll.sleeper(deadline))
}

-- Wait for `fd` to be readable.
fun readable(fd : Int, deadline : Int) -> Int =
    if passed(deadline) { timedOut } else { park(fun() = Poll.readable(fd, deadline)) }

-- Wait for `fd` to be writable.
fun writable(fd : Int, deadline : Int) -> Int =
    if passed(deadline) { timedOut } else { park(fun() = Poll.writable(fd, deadline)) }

-- `readable` and `writable` that answer `cancelled` without waiting if `stop()`
-- is true once the wait may be registered, which is under the poller's lock,
-- so that `stop` must only read. A closer that makes `stop` true and then calls
-- `cancel` ends this wait either way: `cancel` finds it registered, or `stop`
-- sees what the closer made true.
fun readableUnless(fd : Int, deadline : Int, stop : fun() -> Bool) -> Int =
    if passed(deadline) { timedOut } else { parkUnless(fun() = Poll.readable(fd, deadline), stop) }

fun writableUnless(fd : Int, deadline : Int, stop : fun() -> Bool) -> Int =
    if passed(deadline) { timedOut } else { parkUnless(fun() = Poll.writable(fd, deadline), stop) }

-- `readableUnless` and `writableUnless`, judging whether `deadline` has
-- passed by `now`, a reading of `now()` the caller has just taken, rather
-- than by a reading of their own.
fun readableUnlessAsOf(fd : Int, deadline : Int, now : Int, stop : fun() -> Bool) -> Int =
    if passedAsOf(deadline, now) { timedOut } else { parkUnless(fun() = Poll.readable(fd, deadline), stop) }

fun writableUnlessAsOf(fd : Int, deadline : Int, now : Int, stop : fun() -> Bool) -> Int =
    if passedAsOf(deadline, now) { timedOut } else { parkUnless(fun() = Poll.writable(fd, deadline), stop) }

-- `readableUnless` for a descriptor in blocking mode, before a `read` that
-- must not wait in the kernel: it ends only once the descriptor is readable
-- (`Turkey.Poll.readableBlocking`). The others are for after `EAGAIN`.
fun readableBlockingUnless(fd : Int, deadline : Int, stop : fun() -> Bool) -> Int =
    if passed(deadline) { timedOut } else { parkUnless(fun() = Poll.readableBlocking(fd, deadline), stop) }

-- Wait for the child `pid` to exit, and reap it. Only the one wait for a
-- child may exist at a time, and nothing else in the program may reap it
-- (`Turkey.Poll`).
fun childExit(pid : Int, deadline : Int) -> Int =
    if passed(deadline) { timedOut } else { park(fun() = Poll.childExit(pid, deadline)) }

-- Take `operation`'s `flock` lock on `fd`'s file, `operation` being without
-- `LOCK_NB`, waiting while another holder has it, unless `stop()` (as for
-- `readableUnless`). A wait that ends other than with 0 has not taken the
-- lock. Darwin only: the poller learns of releases there and not on Linux
-- (`Turkey.Poll`).
fun lockedUnless(fd : Int, operation : Int, deadline : Int, stop : fun() -> Bool) -> Int =
    if passed(deadline) { timedOut } else { parkUnless(fun() = Poll.locked(fd, operation, deadline), stop) }

-- `fd` is about to be closed: end every wait on it with `cancelled`.
fun cancel(fd : Int) -> Unit {
    Poll.lock()
    let ended = Poll.cancel(fd)
    let tasks = Poll.takeWoken()
    Poll.unlock()
    wakeAll(ended, tasks)
}

-- Drop the poller's interest in `fd`, before its number is closed, ending any
-- wait still on it as `cancel` does. Every number that was waited on is
-- forgotten before it is closed (`Turkey.Poll`).
fun forget(fd : Int) -> Unit {
    Poll.lock()
    let ended = Poll.forget(fd)
    let tasks = Poll.takeWoken()
    Poll.unlock()
    wakeAll(ended, tasks)
}

-- Wake `tasks`, of the `ended` waits the poller just ended, and the program's
-- own code if it waits. Without the poller's lock.
fun wakeAll(ended : Int, tasks : Vec Co.Coroutine) -> Unit {
    if ended > 0 {
        Scheduler.wakeAll(tasks)
        Scheduler.changed()
    }
}

fun passed(deadline : Int) -> Bool = deadline >= 0 && Poll.now() >= deadline

fun passedAsOf(deadline : Int, now : Int) -> Bool = deadline >= 0 && now >= deadline

-- Make the wait `start` makes, and park until it ends.
--
-- The workers that may not be watching for it are told. A first wait wakes an
-- idle worker to poll for it (`Turkey.Poll`'s interest). A deadline earlier
-- than the others wakes the one that polls, which is waiting for a later one:
-- the signal moves the work epoch too, so that a worker that computed its
-- timeout before this wait was made and has not yet begun to wait does not
-- begin.
fun park(start : fun() -> Poll.Waiter) -> Int = parkUnless(start, fun() = False)

fun parkUnless(start : fun() -> Poll.Waiter, stop : fun() -> Bool) -> Int {
    Poll.lock()
    if stop() {
        Poll.unlock()
        return cancelled
    }
    let endedBefore = Poll.endings()
    let w = start()
    -- Wake the tasks of any other waits `start` ended, as `settle` would: a
    -- lock wait retries every waiter on its file (`Poll.locked`), and one
    -- that takes the lock ends. Skipping this would leave those tasks parked
    -- on waiters that have ended. The count includes `w` itself when `start`
    -- ended it, which costs at most a needless `Scheduler.changed`.
    let ends = Poll.endings() - endedBefore
    let others = Poll.takeWoken()
    let parked = parkNow(w)
    Poll.unlock()
    wakeAll(ends, others)
    settleIn(w, parked)
}

-- `readableUnlessAsOf` or, if `writing`, `writableUnlessAsOf`, for the
-- descriptor whose source `s` is (`sourceOf`), under the source's lock alone.
-- `now` is -1 to have the deadline judged by a reading of its own.
fun onUnlessAsOf(s : Poll.Source, writing : Bool, deadline : Int, now : Int, stop : fun() -> Bool) -> Int {
    if (if now < 0 { passed(deadline) } else { passedAsOf(deadline, now) }) { return timedOut }
    Poll.lockSource(s)
    if stop() {
        Poll.unlockSource(s)
        return cancelled
    }
    let w = Poll.waitOn(s, writing, deadline)
    let parked = parkNow(w)
    Poll.unlockSource(s)
    settleIn(w, parked)
}

-- The source of `fd`, for `onUnlessAsOf`, once a wait on `fd` has been
-- made: it is `fd`'s until `forget`.
fun sourceOf(fd : Int) -> Option Poll.Source {
    Poll.lock()
    let s = Poll.sourceOf(fd)
    Poll.unlock()
    s
}

-- Whether the running task, if one runs, is now parked on `w`, which was just
-- made: rather than taking a lock again for it, as `await`'s first look
-- would. Under the lock `w` was made under.
fun parkNow(w : Poll.Waiter) -> Bool = match Co.running() {
    Some(c) -> if Poll.finished(w) { False } else {
        Poll.park(w, c)
        True
    }
    None -> False
}

-- Tell the workers about the wait `w` just made, park until it ends if
-- `parked`, and answer how it ended. Without the lock it was made under.
fun settleIn(w : Poll.Waiter, parked : Bool) -> Int {
    tell()
    if parked {
        Co.suspend()
        -- Nothing queues a task parked on `w` but the wake that follows `w`'s
        -- end. That wake queues it under the queue's lock, or, if the task
        -- has not suspended yet, marks it woken by a compare-and-swap, and
        -- `run` queues it once it suspends. The worker that resumed it
        -- acquired one or the other after the end, so the end is seen here
        -- without the poller's lock. `await` looks again under it all the
        -- same.
        if Poll.finished(w) { return Poll.outcome(w) }
    }
    await(w)
}

-- Tell the polling worker if a wait just made has the earliest deadline.
fun tell() -> Unit {
    if Poll.takeHeadMoved() {
        Workers.signalWork(False)
        Workers.wakePoller()
    }
}

-- Park until `w` ends, and answer how. Without either lock.
fun await(w : Poll.Waiter) -> Int {
    Scheduler.waitOn(Poll.mutex, fun() = Poll.finished(w), fun(c) = Poll.park(w, c))
    Poll.outcome(w)
}

-- -- waiting apart from the tasks ---------------------------------------------------
--
-- For a wait that a task ends -- a helper's call returning (`Turkey.Detach`),
-- a semaphore's permit released (`Turkey.Semaphore`). From the program's own
-- stack, `park` would run tasks meanwhile, and if one were the task the wait
-- is for, the stack would be inside it until it finished, deadline or not.

-- The word the program's own stack sleeps on in `parkApart`, which
-- `complete` moves and wakes. There is one program stack, so one word. A
-- `let`, since the word moves and the pointer does not: a `var` here would
-- be a heap cell, allocated as every program starts.
let programWord : Ptr = zeroedWord()

fun zeroedWord() -> Ptr {
    let word = Libc.malloc(8)
    Ptr.atomicStore(word, 0, 0)
    word
}

-- `park`, except that the program's own stack runs no task while it waits.
-- A task parks as it does in `park`. The program's own stack sleeps as a
-- thread in a blocking call does (`Turkey.Workers.blockingSleepOn`), and the
-- monitor hands its permit to a thread that runs the tasks; so it starts the
-- workers and the monitor if nothing has (`Turkey.Scheduler.start`).
--
-- `start` makes the waiter with `sleeper` under the scheduler's lock, given
-- the deadline to put on the poller's heap: `deadline` from a task, and -1
-- from the program's own stack, which no worker could wake for it, and which
-- ends the wait itself (`Turkey.Poll.timeOut`) when its sleep runs out.
-- Whoever ends the waiter otherwise calls `complete`, under the scheduler's
-- lock.
fun parkApart(start : fun(Int) -> Poll.Waiter, deadline : Int) -> Int = match Co.running() {
    Some(_) -> {
        Scheduler.lock()
        let w = start(deadline)
        Scheduler.unlock()
        await(w)
    }
    None -> sleepApart(start, deadline)
}

-- A sleep that a wake or the clock cut short only loops. Back from the
-- sleep, the stack holds a permit again (`Turkey.Workers.callExit`).
fun sleepApart(start : fun(Int) -> Poll.Waiter, deadline : Int) -> Int {
    let _ = Scheduler.start()
    Scheduler.lock()
    let w = start(-1)
    Scheduler.unlock()
    while True {
        -- Read before the look, and moved after the waiter ends, so that an
        -- end after the look stops the sleep from starting.
        let seen = Ptr.atomicLoad(programWord, 0)
        Poll.lock()
        let left = if deadline < 0 { -1 } else { deadline - Poll.now() }
        -- No task parked on `w`, so there is none to wake.
        if !Poll.finished(w) && deadline >= 0 && left <= 0 { let _ = Poll.timeOut(w) }
        let over = Poll.finished(w)
        Poll.unlock()
        if over { break }
        Workers.blockingSleepOn(programWord, seen, left)
    }
    Poll.outcome(w)
}

-- A waiter for `parkApart`'s `start` to make: one that only `complete` or
-- `deadline` ends. Takes the poller's lock, so the caller must not hold it.
fun sleeper(deadline : Int) -> Poll.Waiter {
    Poll.lock()
    let w = Poll.sleeper(deadline)
    Poll.unlock()
    tell()
    w
}

-- End `w`, a waiter `parkApart` made, `Ready` with 0, if it still waits:
-- whether it did. Wakes its task, or, when `program` says the program's own
-- stack made it, that stack. Under the scheduler's lock.
fun complete(w : Poll.Waiter, program : Bool) -> Bool {
    Poll.lock()
    let taken = Poll.complete(w, 0)
    let tasks = Poll.takeWoken()
    Poll.unlock()
    for var i = 0; i < len(tasks); i = i + 1 { Scheduler.wake(tasks[i]) }
    if taken && program {
        let _ = Ptr.atomicAdd(programWord, 0, 1)
        let _ = Lock.wake(programWord)
    }
    taken
}

-- Whether `w` has ended. Takes the poller's lock.
fun finished(w : Poll.Waiter) -> Bool {
    Poll.lock()
    let over = Poll.finished(w)
    Poll.unlock()
    over
}
