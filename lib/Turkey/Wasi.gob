export (
    errno, errnoSet,
    malloc, free, realloc, alignedAlloc,
    strlen, memchr, memcmp, memmem,
    startVector, getenv, getcwd, realpath,
    open, openat, read, write, pread, pwrite, close, fstat, fstatat, isatty,
    fcntl, fcntlWith, flock, unlinkat, mkdirat, renameat, readlinkat, mkdtemp,
    fdopendir, readdir, closedir,
    clockGettime, schedYield, exit,
)

--- The C library the runtime calls, written over WASI preview 1 for
--- wasm32-wasi, which has none.
---
--- Each function here takes the arguments its namesake in `Turkey.Libc` takes
--- and returns what that one does: -1 or null on failure, with the error in
--- `errno`, which is this module's own word. And each speaks arm64 Linux's
--- numbers and layouts -- its `O_*` flags, `AT_*` values and clock ids, its
--- error numbers, and its `struct stat` and `struct dirent` -- so that
--- `Turkey.Sys` gives `Wasi` Linux's values, and nothing above it changes. The
--- translation to and from WASI's own numbers is here and nowhere else.
---
--- **One thread.** A wasm program runs on one (`Turkey.Workers.singleThreaded`),
--- so the allocator, the scratch space the calls share and `errno` take no
--- lock. A wasm program with threads would need them first.
---
--- **Paths.** WASI has no working directory and no root: a path is opened
--- relative to a directory the host *preopened* and named, as `wasmtime --dir
--- DIR` does. An absolute path, or a relative one taken from `/`, which is
--- this module's working directory, is opened under the preopened directory
--- whose name is its longest leading run of whole components. A preopen named
--- `.` or `/` matches every path. Anything else -- a path outside every
--- preopen, or `..` out of one -- the host refuses.

import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)
import Data.Eq (Eq(..), (==), (!=))
import Data.Ord (Ord(..), (<), (<=), (>), (>=))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..), (+), (-), (*), (/), (%))
import Bits (BitAnd(..), BitOr(..), BitXor(..), Shift(..), (&), (|), (^), (<<), (>>))
import Data.Int ()
import Data.Bool (Bool(..))

-- A giblet module, since the collector's own allocations come from here:
-- nothing here allocates on the heap or uses a string literal. And
-- `Turkey.Ptr`, `Turkey.Process` and the rest call into this module through
-- `Turkey.Os`, so it reads and writes memory through the primitives alone and
-- imports nothing of theirs.

type Ptr = Prim.Ptr

-- -- the imports -----------------------------------------------------------------------
--
-- WASI preview 1, as the host provides it to a core module. Each returns
-- WASI's error number as an `i32`, 0 for success, and writes what it
-- returns through the pointer it is given. Every pointer is an address in
-- this program's linear memory and crosses as an `i32`; an integer crosses as
-- an `i32` where it is a `Prim.Int32` and as an `i64` where it is an `Int`,
-- which is WASI's `filesize`, `filedelta`, `timestamp`, `rights` and
-- `dircookie`. A string is a pointer and a length, with no NUL.

foreign "wasi_snapshot_preview1" {
    "args_sizes_get" fun argsSizesGet(count : Ptr, bytes : Ptr) -> Prim.Int32
    "args_get" fun argsGet(vector : Ptr, buffer : Ptr) -> Prim.Int32
    "environ_sizes_get" fun environSizesGet(count : Ptr, bytes : Ptr) -> Prim.Int32
    "environ_get" fun environGet(vector : Ptr, buffer : Ptr) -> Prim.Int32
    "fd_prestat_get" fun fdPrestatGet(fd : Prim.Int32, prestat : Ptr) -> Prim.Int32
    "fd_prestat_dir_name" fun fdPrestatDirName(fd : Prim.Int32, name : Ptr,
                                               length : Prim.Int32) -> Prim.Int32
    "path_open" fun pathOpen(dir : Prim.Int32, lookup : Prim.Int32, path : Ptr,
                             pathLength : Prim.Int32, oflags : Prim.Int32, rightsBase : Int,
                             rightsInheriting : Int, fdflags : Prim.Int32,
                             opened : Ptr) -> Prim.Int32
    "fd_read" fun fdRead(fd : Prim.Int32, iovs : Ptr, count : Prim.Int32,
                         done : Ptr) -> Prim.Int32
    "fd_write" fun fdWrite(fd : Prim.Int32, iovs : Ptr, count : Prim.Int32,
                           done : Ptr) -> Prim.Int32
    "fd_pread" fun fdPread(fd : Prim.Int32, iovs : Ptr, count : Prim.Int32, offset : Int,
                           done : Ptr) -> Prim.Int32
    "fd_pwrite" fun fdPwrite(fd : Prim.Int32, iovs : Ptr, count : Prim.Int32, offset : Int,
                             done : Ptr) -> Prim.Int32
    "fd_close" fun fdClose(fd : Prim.Int32) -> Prim.Int32
    "fd_fdstat_get" fun fdFdstatGet(fd : Prim.Int32, stat : Ptr) -> Prim.Int32
    "fd_fdstat_set_flags" fun fdFdstatSetFlags(fd : Prim.Int32, flags : Prim.Int32) -> Prim.Int32
    "fd_filestat_get" fun fdFilestatGet(fd : Prim.Int32, stat : Ptr) -> Prim.Int32
    "path_filestat_get" fun pathFilestatGet(dir : Prim.Int32, lookup : Prim.Int32, path : Ptr,
                                            pathLength : Prim.Int32, stat : Ptr) -> Prim.Int32
    "fd_readdir" fun fdReaddir(fd : Prim.Int32, buffer : Ptr, bytes : Prim.Int32,
                               cookie : Int, used : Ptr) -> Prim.Int32
    "path_create_directory" fun pathCreateDirectory(dir : Prim.Int32, path : Ptr,
                                                    pathLength : Prim.Int32) -> Prim.Int32
    "path_unlink_file" fun pathUnlinkFile(dir : Prim.Int32, path : Ptr,
                                          pathLength : Prim.Int32) -> Prim.Int32
    "path_remove_directory" fun pathRemoveDirectory(dir : Prim.Int32, path : Ptr,
                                                    pathLength : Prim.Int32) -> Prim.Int32
    "path_rename" fun pathRename(fromDir : Prim.Int32, from : Ptr, fromLength : Prim.Int32,
                                 toDir : Prim.Int32, to : Ptr,
                                 toLength : Prim.Int32) -> Prim.Int32
    "path_readlink" fun pathReadlink(dir : Prim.Int32, path : Ptr, pathLength : Prim.Int32,
                                     buffer : Ptr, bytes : Prim.Int32,
                                     used : Ptr) -> Prim.Int32
    "clock_time_get" fun clockTimeGet(id : Prim.Int32, precision : Int,
                                      time : Ptr) -> Prim.Int32
    "proc_exit" fun procExit(status : Prim.Int32) -> Unit
}

fun i32(n : Int) -> Prim.Int32 = Prim.int32FromInt(n)

fun int(n : Prim.Int32) -> Int = Prim.int32ToInt(n)

-- -- raw memory ------------------------------------------------------------------------

fun at(p : Ptr, offset : Int) -> Ptr = Prim.ptrAdd(p, offset)
fun isNull(p : Ptr) -> Bool = Prim.ptrIsNull(p)
fun null() -> Ptr = Prim.ptrNull()
fun address(p : Ptr) -> Int = Prim.ptrToInt(p)

fun load64(p : Ptr, offset : Int) -> Int = Prim.loadI64(p, offset)
fun store64(p : Ptr, offset : Int, value : Int) -> Unit = Prim.storeI64(p, offset, value)
fun loadPtr(p : Ptr, offset : Int) -> Ptr = Prim.loadPtr(p, offset)
fun storePtr(p : Ptr, offset : Int, value : Ptr) -> Unit = Prim.storePtr(p, offset, value)
fun load32(p : Ptr, offset : Int) -> Int = Prim.charToInt(Prim.loadI32(p, offset))
fun store32(p : Ptr, offset : Int, value : Int) -> Unit =
    Prim.storeI32(p, offset, Prim.charFromInt(value & 0xFFFF_FFFF))
fun load8(p : Ptr, offset : Int) -> Int = Prim.byteToInt(Prim.loadI8(p, offset))
fun store8(p : Ptr, offset : Int, value : Int) -> Unit =
    Prim.storeI8(p, offset, Prim.byteFromInt(value & 0xFF))

-- A 32-bit address WASI stored, as a pointer.
fun loadAddress(p : Ptr, offset : Int) -> Ptr = Prim.ptrFromInt(load32(p, offset))

-- -- the state -------------------------------------------------------------------------
--
-- What this module keeps between calls, in a block of its own rather than in
-- globals: a program compiled for another target loads this module too, and
-- would carry and initialize every global it declared. The block is the
-- first `stateBytes()` of the one `startVector` grows, before the argument
-- vector, which `Turkey.Entry` hands `Turkey.Process.argsSet` as `argv`. So
-- the state is found from the `argv` word of the process state, the word at 16,
-- with one thread the only worker record there is. `startVector` runs before
-- anything else here, and grown memory is zeroed, so each field starts as 0,
-- null or False.
--
-- The fields: `errno` at 0; the allocator's block at 8; the environment and
-- how many variables it has at 16 and 24, and whether it has been read at 32;
-- the scratch block at 40; the preopens, how many there are and whether they
-- have been read at 48, 56 and 64; and what `resolve` leaves, a path and its
-- length, at 72 and 80.

fun stateBytes() -> Int = 88

fun state() -> Ptr = at(loadPtr(Prim.processState(), 16), -(8 + stateBytes()))

fun flag(offset : Int) -> Bool = load64(state(), offset) != 0
fun flagSet(offset : Int, value : Bool) -> Unit = store64(state(), offset, if value { 1 } else { 0 })

fun lastError() -> Int = load64(state(), 0)
fun lastErrorSet(n : Int) -> Unit = store64(state(), 0, n)
fun allocator() -> Ptr = loadPtr(state(), 8)
fun allocatorSet(p : Ptr) -> Unit = storePtr(state(), 8, p)
fun environ() -> Ptr = loadPtr(state(), 16)
fun environSet(p : Ptr) -> Unit = storePtr(state(), 16, p)
fun environCount() -> Int = load64(state(), 24)
fun environCountSet(n : Int) -> Unit = store64(state(), 24, n)
fun environRead() -> Bool = flag(32)
fun environReadSet(b : Bool) -> Unit = flagSet(32, b)
fun scratch() -> Ptr = loadPtr(state(), 40)
fun scratchSet(p : Ptr) -> Unit = storePtr(state(), 40, p)
fun preopens() -> Ptr = loadPtr(state(), 48)
fun preopensSet(p : Ptr) -> Unit = storePtr(state(), 48, p)
fun preopenCount() -> Int = load64(state(), 56)
fun preopenCountSet(n : Int) -> Unit = store64(state(), 56, n)
fun preopensRead() -> Bool = flag(64)
fun preopensReadSet(b : Bool) -> Unit = flagSet(64, b)
fun resolvedPath() -> Ptr = loadPtr(state(), 72)
fun resolvedPathSet(p : Ptr) -> Unit = storePtr(state(), 72, p)
fun resolvedLength() -> Int = load64(state(), 80)
fun resolvedLengthSet(n : Int) -> Unit = store64(state(), 80, n)

-- -- errno -----------------------------------------------------------------------------

--- Returns the error number the last failing call here set, in Linux's
--- numbering.
fun errno() -> Int = lastError()

--- Sets `errno`.
fun errnoSet(n : Int) -> Unit = lastErrorSet(n)

-- Record WASI's error `code` as `errno`, and return -1.
fun failed(code : Int) -> Int {
    lastErrorSet(linuxErrno(code))
    -1
}

-- 0 if `code` is WASI's success, and otherwise `failed(code)`.
fun checked(code : Prim.Int32) -> Int {
    let n = int(code)
    if n == 0 { 0 } else { failed(n) }
}

-- Record Linux's error number `n` and return -1, for a failure found here.
fun refused(n : Int) -> Int {
    lastErrorSet(n)
    -1
}

fun einval() -> Int = 22
fun enomem() -> Int = 12
fun enosys() -> Int = 38
fun ebadf() -> Int = 9

-- WASI's error number as Linux's (`<asm-generic/errno.h>`). WASI numbers its
-- errors alphabetically; `notcapable`, a path the sandbox does not grant,
-- has no Linux name and is reported as `EACCES`.
fun linuxErrno(code : Int) -> Int = match code {
    1 -> 7
    2 -> 13
    3 -> 98
    4 -> 99
    5 -> 97
    6 -> 11
    7 -> 114
    8 -> 9
    9 -> 74
    10 -> 16
    11 -> 125
    12 -> 10
    13 -> 103
    14 -> 111
    15 -> 104
    16 -> 35
    17 -> 89
    18 -> 33
    19 -> 122
    20 -> 17
    21 -> 14
    22 -> 27
    23 -> 113
    24 -> 43
    25 -> 84
    26 -> 115
    27 -> 4
    28 -> 22
    29 -> 5
    30 -> 106
    31 -> 21
    32 -> 40
    33 -> 24
    34 -> 31
    35 -> 90
    36 -> 72
    37 -> 36
    38 -> 100
    39 -> 102
    40 -> 101
    41 -> 23
    42 -> 105
    43 -> 19
    44 -> 2
    45 -> 8
    46 -> 37
    47 -> 67
    48 -> 12
    49 -> 42
    50 -> 92
    51 -> 28
    52 -> 38
    53 -> 107
    54 -> 20
    55 -> 39
    56 -> 131
    57 -> 88
    58 -> 95
    59 -> 25
    60 -> 6
    61 -> 75
    62 -> 130
    63 -> 1
    64 -> 32
    65 -> 71
    66 -> 93
    67 -> 91
    68 -> 34
    69 -> 30
    70 -> 29
    71 -> 3
    72 -> 116
    73 -> 110
    74 -> 26
    75 -> 18
    76 -> 13
    _ -> 5
}

-- -- the allocator ---------------------------------------------------------------------
--
-- `malloc` over `memory.grow`, which hands out 64 KiB pages and takes none
-- back. A block of at most `smallLimit()` bytes comes from a page carved into
-- blocks of one power of two, from 16 bytes up; a larger block is a run of
-- whole pages, which is also what `alignedAlloc` returns, since a page is
-- aligned to its own size. A freed small block goes on its size's list and a
-- freed run on the list of runs, first fit, and neither goes back to the
-- engine.
--
-- What a block is, is in the page map: a 32-bit entry per page of the 4 GiB a
-- 32-bit memory can have, 256 KiB in all, which says that a page is carved for
-- size class `c` (`c + 1`), or begins a run of `n` pages (`runBit() | n`), or
-- neither (0). `free` and `realloc` read the size there, so a block carries no
-- header and a page-aligned block stays aligned. The map and the lists'
-- heads take the first pages this allocator grows.

fun pageBytes() -> Int = 65536
fun smallLimit() -> Int = 32768
fun classes() -> Int = 12
fun runBit() -> Int = 0x8000_0000
fun mapBytes() -> Int = 262144

-- The allocator's block (`allocator`): the page map, then the head of each
-- size class's list from `mapBytes()`, and then the head of the list of free
-- runs. Null until the first allocation.
fun runsAt() -> Int = mapBytes() + 8 * classes()

-- `pages` new pages, zeroed, or null if the engine refuses.
fun grow(pages : Int) -> Ptr {
    let before = Prim.memoryGrow(pages)
    if before < 0 { null() } else { Prim.ptrFromInt(before * pageBytes()) }
}

fun ready() -> Bool {
    if !isNull(allocator()) { return True }
    let made = grow((runsAt() + 8 + pageBytes() - 1) / pageBytes())
    if isNull(made) { return False }
    allocatorSet(made)
    True
}

fun pageOf(p : Ptr) -> Int = address(p) / pageBytes()

fun entry(p : Ptr) -> Int = load32(allocator(), 4 * pageOf(p))

fun entrySet(p : Ptr, value : Int) -> Unit = store32(allocator(), 4 * pageOf(p), value)

-- The class of a request of `size` bytes, from 0 for 16 bytes.
fun classOf(size : Int) -> Int {
    var c = 0
    var bytes = 16
    while bytes < size {
        bytes = bytes * 2
        c = c + 1
    }
    c
}

fun classBytes(c : Int) -> Int {
    var bytes = 16
    for var i = 0; i < c; i = i + 1 { bytes = bytes * 2 }
    bytes
}

--- Returns `size` bytes, uninitialized, aligned to 16, or null.
fun malloc(size : Int) -> Ptr {
    if size < 0 { return null() }
    if !ready() { return null() }
    if size > smallLimit() { return pages((size + pageBytes() - 1) / pageBytes()) }
    let c = classOf(size)
    let head = mapBytes() + 8 * c
    var block = loadPtr(allocator(), head)
    if isNull(block) {
        let page = pages(1)
        if isNull(page) { return page }
        entrySet(page, c + 1)
        -- Carve the page, the first block kept for this call and the rest
        -- linked in address order.
        let bytes = classBytes(c)
        var next = null()
        var offset = pageBytes() - bytes
        while offset > 0 {
            let b = at(page, offset)
            storePtr(b, 0, next)
            next = b
            offset = offset - bytes
        }
        storePtr(allocator(), head, next)
        return page
    }
    storePtr(allocator(), head, loadPtr(block, 0))
    block
}

-- A run of `n` pages, from the free runs if one is long enough, and grown
-- otherwise; marked in the map. The rest of a longer free run stays free.
fun pages(n : Int) -> Ptr {
    var previous = null()
    var run = loadPtr(allocator(), runsAt())
    while !isNull(run) {
        let length = load64(run, 8)
        let next = loadPtr(run, 0)
        if length >= n {
            let rest = length - n
            let after = if rest > 0 {
                let tail = at(run, n * pageBytes())
                storePtr(tail, 0, next)
                store64(tail, 8, rest)
                tail
            } else {
                next
            }
            if isNull(previous) { storePtr(allocator(), runsAt(), after) }
            else { storePtr(previous, 0, after) }
            entrySet(run, runBit() | n)
            return run
        }
        previous = run
        run = next
    }
    let made = grow(n)
    if isNull(made) { return made }
    entrySet(made, runBit() | n)
    made
}

--- Gives back a block `malloc`, `realloc` or `alignedAlloc` returned. Does
--- nothing with null.
fun free(p : Ptr) -> Unit {
    if isNull(p) || isNull(allocator()) { return }
    let e = entry(p)
    if e & runBit() != 0 {
        entrySet(p, 0)
        storePtr(p, 0, loadPtr(allocator(), runsAt()))
        store64(p, 8, e & 0xFFFF)
        storePtr(allocator(), runsAt(), p)
    } else if e != 0 {
        let head = mapBytes() + 8 * (e - 1)
        storePtr(p, 0, loadPtr(allocator(), head))
        storePtr(allocator(), head, p)
    }
}

-- How many bytes the block at `p` holds.
fun blockBytes(p : Ptr) -> Int {
    let e = entry(p)
    if e & runBit() != 0 { (e & 0xFFFF) * pageBytes() } else { classBytes(e - 1) }
}

--- Returns `p`'s block resized to `size` bytes, its contents kept, or null with
--- `p` untouched. A null `p` makes this `malloc`.
fun realloc(p : Ptr, size : Int) -> Ptr {
    if isNull(p) { return malloc(size) }
    let held = blockBytes(p)
    if size <= held { return p }
    let grown = malloc(size)
    if isNull(grown) { return grown }
    Prim.copyBytes(grown, p, held)
    free(p)
    grown
}

--- Returns `size` bytes at a multiple of `alignment`, which is a power of two,
--- or null. Takes any alignment up to a page's 64 KiB, and none above it.
fun alignedAlloc(alignment : Int, size : Int) -> Ptr {
    if alignment <= 16 { return malloc(size) }
    if alignment > pageBytes() || size < 0 || !ready() {
        lastErrorSet(einval())
        return null()
    }
    pages((size + pageBytes() - 1) / pageBytes())
}

-- -- bytes -----------------------------------------------------------------------------

--- Returns how many bytes come before the first NUL.
fun strlen(s : Ptr) -> Int {
    var n = 0
    while load8(s, n) != 0 { n = n + 1 }
    n
}

--- Returns the address of the first of the `n` bytes at `s` equal to `c`'s
--- low byte, or null.
fun memchr(s : Ptr, c : Int, n : Int) -> Ptr {
    let byte = c & 0xFF
    for var i = 0; i < n; i = i + 1 {
        if load8(s, i) == byte { return at(s, i) }
    }
    null()
}

--- Returns a negative number, zero or a positive one as the `n` bytes at `a`
--- order below, the same as or above the `n` at `b`, compared as unsigned
--- bytes.
fun memcmp(a : Ptr, b : Ptr, n : Int) -> Int {
    for var i = 0; i < n; i = i + 1 {
        let x = load8(a, i)
        let y = load8(b, i)
        if x != y { return x - y }
    }
    0
}

--- Returns the address of the first place the `needleLength` bytes at
--- `needle` occur among the `n` at `s`, or null.
fun memmem(s : Ptr, n : Int, needle : Ptr, needleLength : Int) -> Ptr {
    if needleLength == 0 { return s }
    for var i = 0; i + needleLength <= n; i = i + 1 {
        if memcmp(at(s, i), needle, needleLength) == 0 { return at(s, i) }
    }
    null()
}

-- -- the process -----------------------------------------------------------------------

--- Returns the arguments as `main`'s `argv` would hold them, at word 1 of a
--- block whose word 0 is `argc`: 8-byte pointers to NUL-terminated strings,
--- then a null, then a null for an empty environment. In pages grown for it,
--- which last as long as the program, or null if there were none to grow. The
--- vector is to be handed to `Turkey.Process.argsSet` before any other call
--- here, which finds this module's state from it.
fun startVector() -> Ptr {
    -- This module's state, then `argc`, the vector and its two nulls, WASI's
    -- own 4-byte vector, and the strings. The two sizes are read into the
    -- first page before the layout is known; the pages grown after it follow
    -- it, so the block is one run. It reads and writes no state, since the
    -- state is found from what it returns.
    let first = grow(1)
    if isNull(first) { return first }
    let vector = at(first, stateBytes())
    store64(vector, 0, 0)
    storePtr(vector, 8, null())
    storePtr(vector, 16, null())
    if int(argsSizesGet(first, at(first, 4))) != 0 { return vector }
    let count = load32(first, 0)
    let bytes = load32(first, 4)
    store64(first, 0, 0)
    let wide = 8 + 8 * (count + 2)
    let narrow = 4 * count
    let total = stateBytes() + wide + narrow + bytes
    if total > pageBytes() {
        if isNull(grow((total - 1) / pageBytes())) { return vector }
    }
    let strings = at(vector, wide + narrow)
    if int(argsGet(at(vector, wide), strings)) != 0 { return vector }
    store64(vector, 0, count)
    for var i = 0; i < count; i = i + 1 {
        storePtr(vector, 8 + 8 * i, loadAddress(vector, wide + 4 * i))
    }
    storePtr(vector, 8 + 8 * count, null())
    storePtr(vector, 8 + 8 * (count + 1), null())
    vector
}

-- The environment (`environ`), as WASI's `environ_get` lays it out: 4-byte
-- pointers to `NAME=value` strings, `environCount` of them. Read at the first
-- `getenv`.

fun environLoad() -> Unit {
    environReadSet(True)
    let sizes = malloc(8)
    if isNull(sizes) { return }
    if int(environSizesGet(sizes, at(sizes, 4))) != 0 {
        free(sizes)
        return
    }
    let count = load32(sizes, 0)
    let bytes = load32(sizes, 4)
    free(sizes)
    let block = malloc(4 * count + bytes)
    if isNull(block) { return }
    if int(environGet(block, at(block, 4 * count))) != 0 {
        free(block)
        return
    }
    environSet(block)
    environCountSet(count)
}

--- Returns the value of the variable whose NUL-terminated name is `name`, or
--- null. The pointer is good for as long as the program runs.
fun getenv(name : Ptr) -> Ptr {
    if !environRead() { environLoad() }
    let n = strlen(name)
    for var i = 0; i < environCount(); i = i + 1 {
        let entry = loadAddress(environ(), 4 * i)
        if memcmp(entry, name, n) == 0 && load8(entry, n) == 61 { return at(entry, n + 1) }
    }
    null()
}

--- Returns `/`, the directory a relative path is resolved from, in a block
--- from `malloc` the caller frees, or null.
fun getcwd(buffer : Ptr, size : Int) -> Ptr {
    let p = malloc(2)
    if isNull(p) {
        lastErrorSet(enomem())
        return p
    }
    store8(p, 0, 47)
    store8(p, 1, 0)
    p
}

--- Returns null, with `errno` `ENOSYS`: WASI has no way to ask where a
--- symbolic link leads short of reading every component, and no absolute name
--- for a preopened directory.
fun realpath(path : Ptr, resolved : Ptr) -> Ptr {
    lastErrorSet(enosys())
    null()
}

--- Ends the program with `status`, at once.
fun exit(status : Int) -> Unit = procExit(i32(status))

--- Returns 0 at once: with one thread there is nothing to yield to.
fun schedYield() -> Int = 0

-- -- the clocks ------------------------------------------------------------------------

--- Fills the `struct timespec` at `timespec` -- seconds, then nanoseconds --
--- from Linux's clock `id`: `CLOCK_REALTIME` (0), `CLOCK_MONOTONIC` (1) or
--- `CLOCK_REALTIME_COARSE` (5). Returns 0, or -1.
fun clockGettime(id : Int, timespec : Ptr) -> Int {
    let clock = match id {
        0 -> 0
        1 -> 1
        5 -> 0
        _ -> return refused(einval())
    }
    if checked(clockTimeGet(i32(clock), 1, timespec)) != 0 { return -1 }
    let nanos = load64(timespec, 0)
    store64(timespec, 0, nanos / 1_000_000_000)
    store64(timespec, 8, nanos % 1_000_000_000)
    0
}

-- -- scratch -----------------------------------------------------------------------------
--
-- The scratch block (`scratch`): room for what a call hands WASI and reads back: an `iovec` at 0, a count
-- or a descriptor at 16, and a `filestat` or an `fdstat` at 64. One thread
-- makes one call at a time, so one block serves every call.

fun scratchReady() -> Bool {
    if isNull(scratch()) { scratchSet(malloc(128)) }
    !isNull(scratch())
}

fun doneAt() -> Int = 16
fun statAt() -> Int = 64

-- -- reading and writing -----------------------------------------------------------------

-- One `iovec` of `count` bytes at `buf`, at the start of the scratch block.
fun oneBuffer(buf : Ptr, count : Int) -> Ptr {
    store32(scratch(), 0, address(buf))
    store32(scratch(), 4, count)
    scratch()
}

-- What a transfer returns: the count WASI stored, or -1.
fun moved(code : Prim.Int32) -> Int =
    if checked(code) != 0 { -1 } else { load32(scratch(), doneAt()) }

-- `moved` for a read from `fd`. WASI answers `badf` for a read from a
-- directory, where Linux answers `EISDIR`, so a directory's `badf` is
-- reported as Linux's.
fun readMoved(fd : Int, code : Prim.Int32) -> Int {
    if int(code) == 8 && isDirectory(fd) { return refused(21) }
    moved(code)
}

-- Whether `fd` is open on a directory.
fun isDirectory(fd : Int) -> Bool {
    let stat = at(scratch(), statAt())
    int(fdFdstatGet(i32(fd), stat)) == 0 && load8(stat, 0) == 3
}

--- Returns how many bytes it read, 0 at the end, or -1.
fun read(fd : Int, buf : Ptr, count : Int) -> Int {
    if !scratchReady() { return refused(enomem()) }
    readMoved(fd, fdRead(i32(fd), oneBuffer(buf, count), i32(1), at(scratch(), doneAt())))
}

--- Returns how many bytes it wrote, or -1.
fun write(fd : Int, buf : Ptr, count : Int) -> Int {
    if !scratchReady() { return refused(enomem()) }
    moved(fdWrite(i32(fd), oneBuffer(buf, count), i32(1), at(scratch(), doneAt())))
}

--- Reads and writes as `read` and `write` do, at `offset` and without moving
--- the file's position.
fun pread(fd : Int, buf : Ptr, count : Int, offset : Int) -> Int {
    if !scratchReady() { return refused(enomem()) }
    readMoved(fd, fdPread(i32(fd), oneBuffer(buf, count), i32(1), offset, at(scratch(), doneAt())))
}

fun pwrite(fd : Int, buf : Ptr, count : Int, offset : Int) -> Int {
    if !scratchReady() { return refused(enomem()) }
    moved(fdPwrite(i32(fd), oneBuffer(buf, count), i32(1), offset, at(scratch(), doneAt())))
}

--- Closes `fd`: returns 0, or -1.
fun close(fd : Int) -> Int = checked(fdClose(i32(fd)))

--- Returns 1 for a terminal, and 0 otherwise, with `errno` `ENOTTY`. A
--- terminal is a character device that cannot seek, since WASI says nothing
--- more about a stream.
fun isatty(fd : Int) -> Int {
    if !scratchReady() { return 0 }
    let stat = at(scratch(), statAt())
    if checked(fdFdstatGet(i32(fd), stat)) != 0 { return 0 }
    -- `fd_seek` and `fd_tell`, rights 1 << 2 and 1 << 5.
    let seeks = load64(stat, 8) & 0x24
    if load8(stat, 0) == 2 && seeks == 0 { return 1 }
    lastErrorSet(enotty())
    0
}

fun enotty() -> Int = 25

-- Linux's `fcntl` commands and the bits of its status flags that WASI keeps.
fun getStatusFlags() -> Int = 3
fun setStatusFlags() -> Int = 4
fun linuxAppend() -> Int = 0x400
fun linuxNonBlocking() -> Int = 0x800

--- Handles `F_GETFD`, `F_SETFD` and `F_GETFL`, with no argument. There is no
--- `exec`, so a descriptor's only flag, close-on-exec, reads as clear.
fun fcntl(fd : Int, command : Int) -> Int {
    if command != getStatusFlags() { return 0 }
    if !scratchReady() { return refused(enomem()) }
    let stat = at(scratch(), statAt())
    if checked(fdFdstatGet(i32(fd), stat)) != 0 { return -1 }
    let flags = load32(stat, 0) >> 16
    var out = 0
    if flags & 1 != 0 { out = out | linuxAppend() }
    if flags & 4 != 0 { out = out | linuxNonBlocking() }
    out
}

--- Handles `F_SETFD` and `F_SETFL`, with one argument: `O_APPEND` and
--- `O_NONBLOCK` are what WASI can set.
fun fcntlWith(fd : Int, command : Int, argument : Int) -> Int {
    if command != setStatusFlags() { return 0 }
    var flags = 0
    if argument & linuxAppend() != 0 { flags = flags | 1 }
    if argument & linuxNonBlocking() != 0 { flags = flags | 4 }
    checked(fdFdstatSetFlags(i32(fd), i32(flags)))
}

--- Returns -1 with `errno` `ENOSYS`: WASI has no file locks.
fun flock(fd : Int, operation : Int) -> Int = refused(enosys())

-- -- paths -------------------------------------------------------------------------------

-- The preopened directories (`preopens`), read at the first path:
-- `preopenCount` of them, each 24 bytes -- its descriptor, its name with no leading
-- `/` or `./` and no trailing `/`, and the name's length.

fun preopenBytes() -> Int = 24

-- Linux's `AT_FDCWD`, `AT_SYMLINK_NOFOLLOW` and `AT_REMOVEDIR`.
fun atWorkingDirectory() -> Int = -100
fun atSymlinkNoFollow() -> Int = 0x100
fun atRemoveDirectory() -> Int = 0x200

-- A host numbers the preopens from 3, after the standard streams, and the
-- first descriptor that is not one ends them.
fun preopensLoad() -> Unit {
    preopensReadSet(True)
    let prestat = malloc(8)
    if isNull(prestat) { return }
    var capacity = 0
    var fd = 3
    loop {
        if int(fdPrestatGet(i32(fd), prestat)) != 0 { break }
        if load8(prestat, 0) == 0 {
            let length = load32(prestat, 4)
            let name = malloc(length + 1)
            if isNull(name) { break }
            if int(fdPrestatDirName(i32(fd), name, i32(length))) != 0 {
                free(name)
                break
            }
            store8(name, length, 0)
            if preopenCount() == capacity {
                capacity = if capacity == 0 { 4 } else { 2 * capacity }
                let grown = realloc(preopens(), preopenBytes() * capacity)
                if isNull(grown) {
                    free(name)
                    break
                }
                preopensSet(grown)
            }
            let skip = leading(name, length)
            var end = length
            while end > skip && load8(name, end - 1) == 47 { end = end - 1 }
            -- `.` alone is the empty name, which matches every path.
            if end - skip == 1 && load8(name, skip) == 46 { end = skip }
            let row = at(preopens(), preopenBytes() * preopenCount())
            store64(row, 0, fd)
            storePtr(row, 8, at(name, skip))
            store64(row, 16, end - skip)
            preopenCountSet(preopenCount() + 1)
        }
        fd = fd + 1
    }
    free(prestat)
}

-- How many bytes of `/`s and `./`s the `length` bytes at `path` start with.
fun leading(path : Ptr, length : Int) -> Int {
    var i = 0
    loop {
        if i < length && load8(path, i) == 47 { i = i + 1 }
        else if i + 1 < length && load8(path, i) == 46 && load8(path, i + 1) == 47 { i = i + 2 }
        else { return i }
    }
}

-- The descriptor WASI is to resolve the NUL-terminated `path` against, as
-- Linux's `at` calls take `dir` and `path`, with what to resolve against it
-- in `resolvedPath` and `resolvedLength`; or -1 with `errno` `ENOENT`, for a
-- path under no preopen.
fun resolve(dir : Int, path : Ptr) -> Int {
    let length = strlen(path)
    let absolute = length > 0 && load8(path, 0) == 47
    if dir >= 0 && !absolute {
        resolvedPathSet(path)
        resolvedLengthSet(length)
        return dir
    }
    if dir != atWorkingDirectory() && !absolute { return refused(ebadf()) }
    if !preopensRead() { preopensLoad() }
    let skip = leading(path, length)
    let rest = at(path, skip)
    let restLength = length - skip
    var best = -1
    var bestLength = -1
    for var i = 0; i < preopenCount(); i = i + 1 {
        let row = at(preopens(), preopenBytes() * i)
        let n = load64(row, 16)
        if n > bestLength && covers(loadPtr(row, 8), n, rest, restLength) {
            best = i
            bestLength = n
        }
    }
    if best < 0 { return refused(2) }
    var inside = bestLength
    while inside < restLength && load8(rest, inside) == 47 { inside = inside + 1 }
    if inside == restLength {
        resolvedPathSet(Prim.cString("."))
        resolvedLengthSet(1)
    } else {
        resolvedPathSet(at(rest, inside))
        resolvedLengthSet(restLength - inside)
    }
    load64(at(preopens(), preopenBytes() * best), 0)
}

-- Whether the preopen named by the `n` bytes at `name` holds the path in the
-- `length` bytes at `path`: its name is the path's leading components.
fun covers(name : Ptr, n : Int, path : Ptr, length : Int) -> Bool {
    if n == 0 { return True }
    if n > length || memcmp(name, path, n) != 0 { return False }
    n == length || load8(path, n) == 47
}

-- Linux's `open` flags, as arm64 Linux numbers them (`Turkey.Sys`).
fun linuxAccessMode() -> Int = 3
fun linuxCreate() -> Int = 0x40
fun linuxExclusive() -> Int = 0x80
fun linuxTruncate() -> Int = 0x200
fun linuxDirectory() -> Int = 0x4000
fun linuxNoFollow() -> Int = 0x8000

-- WASI's rights to read a file or a directory, `fd_read` and `fd_readdir`,
-- and to change one, `fd_datasync`, `fd_write`, `fd_allocate` and
-- `fd_filestat_set_size`. A host decides from them whether a descriptor reads
-- or writes, so an open asks for the ones its access mode needs and no other
-- of the six.
fun readRights() -> Int = 0x2 | 0x4000
fun writeRights() -> Int = 0x1 | 0x40 | 0x100 | 0x40_0000

-- What an open with Linux's `flags` asks for: every right but the six, then
-- those of them its access mode needs, all within what the directory `dir`
-- lets a descriptor opened under it have. -1 if `dir` cannot be asked.
fun rightsFor(dir : Int, flags : Int) -> Int {
    let stat = at(scratch(), statAt())
    if checked(fdFdstatGet(i32(dir), stat)) != 0 { return -1 }
    let inheriting = load64(stat, 16)
    -- Bits 0 to 29 are every right WASI defines.
    var wanted = 0x3FFF_FFFF ^ (readRights() | writeRights())
    let mode = flags & linuxAccessMode()
    if mode == 0 || mode == 2 { wanted = wanted | readRights() }
    if mode == 1 || mode == 2 { wanted = wanted | writeRights() }
    wanted & inheriting
}

--- Opens `path` with Linux's `flags`: returns a descriptor, or -1. WASI has no
--- permissions to set, so `mode` is not read.
fun open(path : Ptr, flags : Int, mode : Int) -> Int =
    openat(atWorkingDirectory(), path, flags, mode)

--- Opens as `open` does, relative to the directory open on `dir`.
fun openat(dir : Int, path : Ptr, flags : Int, mode : Int) -> Int {
    if !scratchReady() { return refused(enomem()) }
    let base = resolve(dir, path)
    if base < 0 { return -1 }
    var oflags = 0
    if flags & linuxCreate() != 0 { oflags = oflags | 1 }
    if flags & linuxDirectory() != 0 { oflags = oflags | 2 }
    if flags & linuxExclusive() != 0 { oflags = oflags | 4 }
    if flags & linuxTruncate() != 0 { oflags = oflags | 8 }
    var fdflags = 0
    if flags & linuxAppend() != 0 { fdflags = fdflags | 1 }
    if flags & linuxNonBlocking() != 0 { fdflags = fdflags | 4 }
    let lookup = if flags & linuxNoFollow() != 0 { 0 } else { 1 }
    let rights = rightsFor(base, flags)
    if rights < 0 { return -1 }
    let inheriting = load64(at(scratch(), statAt()), 16)
    let opened = at(scratch(), doneAt())
    let code = pathOpen(i32(base), i32(lookup), resolvedPath(), i32(resolvedLength()),
                        i32(oflags), rights, inheriting, i32(fdflags), opened)
    if checked(code) != 0 { return -1 }
    load32(opened, 0)
}

-- Linux's `struct stat` on arm64, as `Turkey.Sys` reads it: 128 bytes, the
-- mode's four at 16, the size at 48 and the modification time, seconds then
-- nanoseconds, at 88.
fun statBytes() -> Int = 128

-- Fill the `struct stat` at `buf` from the WASI `filestat` at `stat`.
fun statFill(stat : Ptr, buf : Ptr) -> Unit {
    Prim.fillBytes(buf, statBytes(), 0)
    store64(buf, 0, load64(stat, 0))
    store64(buf, 8, load64(stat, 8))
    -- The file type's `S_IF*` bits; WASI keeps no permissions, so every file
    -- reads as its owner's to read and write, and a directory to search.
    --
    -- WASI names six of the seven kinds of file Linux and Darwin have, and
    -- not a FIFO, which a host reports as `unknown`, 0, as wasmtime does. So
    -- `unknown` reads as a FIFO: without a kind, `System.File` refuses the
    -- stat, and `removeTree` a tree that holds one. Whatever else a host
    -- reports as `unknown` reads as a FIFO too, as a Unix socket does under
    -- wasmtime.
    let mode = match load8(stat, 16) {
        1 -> 0o060600
        2 -> 0o020600
        3 -> 0o040700
        4 -> 0o100600
        5 -> 0o140600
        6 -> 0o140600
        7 -> 0o120600
        _ -> 0o010600
    }
    store32(buf, 16, mode)
    store32(buf, 20, load64(stat, 24))
    store64(buf, 48, load64(stat, 32))
    let modified = load64(stat, 48)
    store64(buf, 88, modified / 1_000_000_000)
    store64(buf, 96, modified % 1_000_000_000)
}

--- Fills the `struct stat` at `buf` for the file open on `fd`: returns 0, or
--- -1.
fun fstat(fd : Int, buf : Ptr) -> Int {
    if !scratchReady() { return refused(enomem()) }
    let stat = at(scratch(), statAt())
    if checked(fdFilestatGet(i32(fd), stat)) != 0 { return -1 }
    statFill(stat, buf)
    0
}

--- Fills the `struct stat` at `buf` as `fstat` does, for `path` relative to
--- `dir`, or for the link itself when `flags` has `AT_SYMLINK_NOFOLLOW`.
fun fstatat(dir : Int, path : Ptr, buf : Ptr, flags : Int) -> Int {
    if !scratchReady() { return refused(enomem()) }
    let base = resolve(dir, path)
    if base < 0 { return -1 }
    let lookup = if flags & atSymlinkNoFollow() != 0 { 0 } else { 1 }
    let stat = at(scratch(), statAt())
    let code = pathFilestatGet(i32(base), i32(lookup), resolvedPath(), i32(resolvedLength()), stat)
    if checked(code) != 0 { return -1 }
    statFill(stat, buf)
    0
}

--- Removes a file, or with `AT_REMOVEDIR` in `flags` an empty directory.
fun unlinkat(dir : Int, path : Ptr, flags : Int) -> Int {
    let base = resolve(dir, path)
    if base < 0 { return -1 }
    if flags & atRemoveDirectory() != 0 {
        checked(pathRemoveDirectory(i32(base), resolvedPath(), i32(resolvedLength())))
    } else {
        checked(pathUnlinkFile(i32(base), resolvedPath(), i32(resolvedLength())))
    }
}

--- Makes a directory. WASI has no permissions, so `mode` is not read.
fun mkdirat(dir : Int, path : Ptr, mode : Int) -> Int {
    let base = resolve(dir, path)
    if base < 0 { return -1 }
    checked(pathCreateDirectory(i32(base), resolvedPath(), i32(resolvedLength())))
}

--- Renames `from`, relative to `fromDir`, to `to`, relative to `toDir`.
fun renameat(fromDir : Int, from : Ptr, toDir : Int, to : Ptr) -> Int {
    let fromBase = resolve(fromDir, from)
    if fromBase < 0 { return -1 }
    let fromPath = resolvedPath()
    let fromLength = resolvedLength()
    let toBase = resolve(toDir, to)
    if toBase < 0 { return -1 }
    checked(pathRename(i32(fromBase), fromPath, i32(fromLength), i32(toBase), resolvedPath(),
                       i32(resolvedLength())))
}

--- Writes the target of the symbolic link `path` into `buf`, with no NUL and
--- cut short at `size` bytes: returns how many it wrote, or -1.
fun readlinkat(dir : Int, path : Ptr, buf : Ptr, size : Int) -> Int {
    if !scratchReady() { return refused(enomem()) }
    let base = resolve(dir, path)
    if base < 0 { return -1 }
    let used = at(scratch(), doneAt())
    let code = pathReadlink(i32(base), resolvedPath(), i32(resolvedLength()), buf, i32(size), used)
    if checked(code) != 0 { return -1 }
    load32(used, 0)
}

--- Returns null, with `errno` `ENOSYS`: WASI has no source of unique names
--- that a program could rely on to make a private directory.
fun mkdtemp(template : Ptr) -> Ptr {
    lastErrorSet(enosys())
    null()
}

-- -- directories ---------------------------------------------------------------------------
--
-- A stream is a block of `streamBytes()`: the descriptor at 0, the cookie of
-- the next entry to ask WASI for at 8, the buffer `fd_readdir` fills at 16,
-- its size at 24, how much of it holds entries at 32 and how far they have
-- been read at 40, and whether the last fill reached the directory's end at
-- 48. Then the Linux `struct dirent` `readdir` returns, from `direntAt()`:
-- its type at 18 and its name, NUL-terminated, from 19.

fun streamBytes() -> Int = 56
fun direntAt() -> Int = 56
fun direntRoom() -> Int = 19 + 4096 + 1
fun bufferBytes() -> Int = 4096

--- Returns a directory stream over `fd`, which it owns from now on, or null.
fun fdopendir(fd : Int) -> Ptr {
    let stream = malloc(streamBytes() + direntRoom())
    if isNull(stream) {
        lastErrorSet(enomem())
        return stream
    }
    let buffer = malloc(bufferBytes())
    if isNull(buffer) {
        free(stream)
        lastErrorSet(enomem())
        return buffer
    }
    store64(stream, 0, fd)
    store64(stream, 8, 0)
    storePtr(stream, 16, buffer)
    store64(stream, 24, bufferBytes())
    store64(stream, 32, 0)
    store64(stream, 40, 0)
    store64(stream, 48, 0)
    stream
}

-- WASI's `dirent`: the next entry's cookie at 0, the name's length at 16 and
-- the type at 20, then the name, not terminated.
fun wasiDirentBytes() -> Int = 24

--- Returns the next entry of `stream`, in storage the stream owns until the
--- next call, or null: at the end, with `errno` untouched, or with it set.
fun readdir(stream : Ptr) -> Ptr {
    loop {
        let buffer = loadPtr(stream, 16)
        let used = load64(stream, 32)
        let read = load64(stream, 40)
        let left = used - read
        if left >= wasiDirentBytes() {
            let entry = at(buffer, read)
            let length = load32(entry, 16)
            if left >= wasiDirentBytes() + length {
                store64(stream, 8, load64(entry, 0))
                store64(stream, 40, read + wasiDirentBytes() + length)
                if length > 4096 { continue }
                let out = at(stream, direntAt())
                store8(out, 18, direntType(load8(entry, 20)))
                Prim.copyBytes(at(out, 19), at(entry, wasiDirentBytes()), length)
                store8(out, 19 + length, 0)
                return out
            }
            -- An entry larger than the whole buffer: make room for it.
            if read == 0 && used == load64(stream, 24) {
                let bytes = 2 * load64(stream, 24)
                let grown = realloc(buffer, bytes)
                if isNull(grown) {
                    lastErrorSet(enomem())
                    return null()
                }
                storePtr(stream, 16, grown)
                store64(stream, 24, bytes)
            }
        }
        -- A short fill was the last; what it left over is no whole entry.
        if load64(stream, 48) != 0 { return null() }
        if !scratchReady() {
            lastErrorSet(enomem())
            return null()
        }
        let room = load64(stream, 24)
        let code = fdReaddir(i32(load64(stream, 0)), loadPtr(stream, 16), i32(room),
                             load64(stream, 8), at(scratch(), doneAt()))
        if checked(code) != 0 { return null() }
        let filled = load32(scratch(), doneAt())
        store64(stream, 32, filled)
        store64(stream, 40, 0)
        if filled < room { store64(stream, 48, 1) }
    }
}

-- WASI's file type as Linux's `d_type`.
fun direntType(t : Int) -> Int = match t {
    1 -> 6
    2 -> 2
    3 -> 4
    4 -> 8
    5 -> 12
    6 -> 12
    7 -> 10
    _ -> 0
}

--- Closes the stream and its descriptor: returns 0, or -1.
fun closedir(stream : Ptr) -> Int {
    let r = close(load64(stream, 0))
    free(loadPtr(stream, 16))
    free(stream)
    r
}
