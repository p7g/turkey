export (
    Bool(..), Option(..), String, TypeRep(..), Proxy(..), Typed(..), error,
    Neg(..), Index(..), SetIndex(..), Iterator(..), Applicative(..), Monad(..),
    Eq(..), Ord(..), Hash(..), Hasher(..), Object(..), Debug(..), Show(..),
    debugConstructor, debugRecord, debugObject,
)

--- The declarations the compiler refers to by name: `if` needs a `Bool`, a
--- string literal is a `String`, a `for` loop gets an `Option` from its
--- iterator, a cast compares `TypeRep`s through `Typed`, and an arm the
--- language makes unreachable calls `error`. The classes are those whose
--- methods `-x`, `xs[i]`, `xs[i] = v`, `for`, `?` and `do` call, and those a
--- type declaration's derive list may name, with the `Hasher` a derived `Hash`
--- feeds and the functions a derived `Debug` is written in.
---
--- The compiler loads this module with every program and looks each name up
--- through the export list above, so this list is the whole of the contract:
--- a declaration may live in any library module, and move, as long as this
--- module re-exports it under the same name.

import Prelude ()
import Data.Bool (Bool(..))
import Data.Option (Option(..))
import Data.String (String)
import Data.Typed (Typed(..), TypeRep(..), Proxy(..))
import Control.Panic (error)
import Data.Num (Neg(..))
import Data.Index (Index(..), SetIndex(..))
import Iter (Iterator(..))
import Control.Applicative (Applicative(..))
import Control.Monad (Monad(..))
import Data.Eq (Eq(..))
import Data.Ord (Ord(..))
import Data.Hashable (Hash(..), Hasher(..))
import Object (Object(..))
import Debug (Debug(..))
import Text.Show (Show(..))
import Turkey.DebugText (debugConstructor, debugRecord, debugObject)
