export (
    count, index, new, recordOf,
    workSeen, sleepForWork, signalWork, collectionSeen, sleepForCollection, signalCollection, stopTheWorld, startTheWorld, stopEnter, stopLeave,
    stopWanted, stopped, running,
    blockEnter, blockExit, unblock, acquire, ended,
    blockingRead, blockingWrite, blockingPread, blockingPwrite, blockingOpen, blockingClose,
    blockingFstat, blockingOpenat, blockingFstatat, blockingUnlinkat, blockingMkdirat,
    blockingRenameat, blockingReadlinkat, blockingFlock, blockingReaddir,
    claim, release, wakePoller, interestAdd, interest,
    pollRead, pollWrite, pollReadWrite, pollChild, pollForget, pollForgetChild, pollWait, pollNow,
    resultToken, resultValue,
    pollReadable, pollWritable, pollEof, pollError, pollTimeoutForever,
)

-- The workers: the threads that run Turkey code, each with a record of its own
-- (`Turkey.Process` lays it out) that `x28` holds while it runs, and how a
-- collection stops all but itself.
--
-- A giblet module, since the collector and the allocator call it.
--
-- **Stopping the world.** A collection runs with every other worker stopped at
-- a safepoint, where the frame tables describe its roots. The collecting
-- worker raises each other worker's stop word -- the word every loop's poll
-- tests (`Turkey.Polls`), which the allocator's slow path tests too -- and
-- waits until each is either stopped or blocked:
--
-- * **stopped**: it saw its stop word at a safepoint, recorded that frame as
--   its running stack's parked frame, so that the collection walks its stack
--   like any parked one, and waits for the word to come down, marking for
--   the collection meanwhile if it is asked to (`Turkey.Heap.stopAt`);
-- * **blocked**: it declared, before waiting on something outside Turkey code
--   -- a lock, or for work -- that its stack is parked at a frame and that it
--   holds nothing else. The collector claims a blocked worker (*held*) so that
--   it cannot run again until the collection ends.
--
-- A worker's state is one word, changed only atomically. The collector waits
-- at the end until every worker it stopped is running again, so that a second
-- collection never mistakes a worker still leaving the first for one stopped
-- for it.

import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)
import Data.Eq (Eq(..))
import Data.Ord (Ord(..))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..))
import Data.Int ()
import Data.Bool (Bool(..))
import Target (OS(..))
import Target as Target
import Turkey.Libc as Libc
import Turkey.Lock as Lock
import Turkey.Memory as Memory
import Turkey.Stack as Stack
import Turkey.Sys as Sys

-- At most this many workers, so that the tables below are allocated once.
let limit : Int = 64

-- Each worker's record, by index; index 0 is the main worker's, the process
-- state every program defines.
var records : Prim.Ptr = zeroed(8 * limit)
-- Each worker's state, by index: `running` (0), `stopped` (1), `blocked` (2)
-- or `held` (3).
var states : Prim.Ptr = zeroed(8 * limit)
-- Word 0: 1 while a collection is stopping the world, claimed by
-- compare-and-swap. Word 8: how many workers there are.
var control : Prim.Ptr = zeroed(16)

-- What workers with nothing to do sleep on, so that they use no processor
-- until there is something for them, and the words that choose which of them
-- waits for the operating system's readiness events instead (the poller, below).
--
-- Word 0 is the work epoch: bumped when a task becomes runnable, and when one
-- finishes while the program's own code waits for it (`signalWork`). Word 16
-- is the collection epoch: bumped when a collection asks its stopped and held
-- workers to mark, and when it lets them go (`signalCollection`). Words 8
-- and 24 count the threads asleep on each, so that bumping one costs a system
-- call only when one is.
--
-- A sleeper reads the epoch before it looks for what it waits for, and sleeps
-- only while the epoch is still what it read: so a bump made after it looked
-- either shows in the epoch, and it does not sleep, or finds it counted, and
-- wakes it (`sleepOn`).
--
-- Word 32 is the poller's claim: 1 while a worker holds the right to poll,
-- taken by compare-and-swap (`claim`), so that at most one polls at a time.
-- Word 40 is 1 while the claimant is inside, or about to enter, a wait that
-- only a kernel event ends (`pollWait`). Word 48 is 1 while a break is on its
-- way to that wait, so that a burst of signals costs one system call
-- (`wakePoller`). Word 56 counts the registrations and timers the scheduler
-- is waiting on (`interestAdd`); workers read it without a lock to decide
-- whether to poll at all.
--
-- A poller sleeps in the kernel and not on the work epoch, so `signalWork`
-- reaches it by breaking its wait. The signaller bumps the epoch and then
-- reads word 40; the poller sets word 40 and then reads the epoch again
-- before it waits, and does not wait if the epoch moved (`pollWait`): the
-- same two orderings as a futex sleeper's, so a signal either shows in the
-- epoch or finds the poller marked and breaks its wait. On the way out the
-- poller clears word 40 and then word 48: a signaller that finds word 48 set
-- relies on a break already on its way, which the kernel holds for the next
-- wait if this one has ended, so at worst the next wait ends early.
var signals : Prim.Ptr = zeroed(64)

let claimedAt : Int = 32
let blockedAt : Int = 40
let wakePendingAt : Int = 48
let interestAt : Int = 56

fun workSeen() -> Int = Prim.atomicLoad(signals, 0)
fun collectionSeen() -> Int = Prim.atomicLoad(signals, 16)

fun sleepForWork(seen : Int) -> Unit = sleepOn(0, seen)
fun sleepForCollection(seen : Int) -> Unit = sleepOn(16, seen)

-- Sleep while the epoch at `word` is `seen`. The count goes up before the
-- epoch is read again, and the bump goes before the count is read, so one of
-- the two sees the other.
fun sleepOn(word : Int, seen : Int) -> Unit {
    let _ = Prim.atomicAdd(signals, plus(word, 8), 1)
    if Prim.atomicLoad(signals, word) == seen { Lock.wait(Prim.ptrAdd(signals, word), seen) }
    let _ = Prim.atomicAdd(signals, plus(word, 8), -1)
}

-- Something for an idle worker to do: wake one, or, `all`, every one. A
-- poller is one more idle worker: it is broken out of its wait when every one
-- is to be woken, and when no sleeper on the epoch was there to take a single
-- wake.
fun signalWork(all : Bool) -> Unit {
    let _ = Prim.atomicAdd(signals, 0, 1)
    var woken = False
    if Prim.atomicLoad(signals, 8) != 0 {
        if all { Lock.wakeAll(signals) } else { woken = Lock.wake(signals) }
    }
    if (all || !woken) && Prim.atomicLoad(signals, blockedAt) != 0 { wakePoller() }
}

fun signalCollection() -> Unit {
    let _ = Prim.atomicAdd(signals, 16, 1)
    if Prim.atomicLoad(signals, 24) != 0 { Lock.wakeAll(Prim.ptrAdd(signals, 16)) }
}

fun zeroed(bytes : Int) -> Prim.Ptr {
    let p = Libc.malloc(bytes)
    if !Prim.ptrIsNull(p) { Memory.fill(p, bytes, 0) }
    p
}

-- How many workers there are: 1 until the first is added.
fun count() -> Int {
    let n = Prim.atomicLoad(control, 8)
    if n == 0 { 1 } else { n }
}

-- The running worker's index, a word of its record.
fun index() -> Int = Prim.loadI64(Prim.processState(), 288)

-- Whether the running worker is running Turkey code, rather than blocked or
-- stopped -- which it may be in a loop of this module's, inlined into a
-- caller and so given a poll (`Turkey.Polls`).
fun running() -> Bool = Prim.atomicLoad(states, 8 * index()) == 0

fun recordOf(i : Int) -> Prim.Ptr =
    if i == 0 && Prim.atomicLoad(control, 8) == 0 { Prim.processState() }
    else { Prim.loadPtr(records, 8 * i) }

-- A record for a new worker, registered and blocked until its thread starts
-- running Turkey code (`blockExit`); null if there is no room or no memory.
-- Called on the main worker, which registers itself first.
--
-- Not while a collection is stopping the world, which counted the workers
-- when it began: registration claims the same word a collection does, and
-- waits blocked for it, so that a collection under way can finish.
--
-- This and the other functions that record where the worker parked
-- (`acquire`, `Turkey.Heap.pause`) are `foreign` so that they are never inlined: the frame
-- they record must be their own, whose return address is a safepoint in their
-- caller, where the caller's roots are stored and mapped.
foreign "turkey_worker_new" fun new() -> Prim.Ptr {
    -- The first: no other worker exists to be collecting.
    if Prim.atomicLoad(control, 8) == 0 { return register() }
    blockEnter(Prim.frameAddress())
    while Prim.atomicCas(control, 0, 0, 1) != 0 { let _ = Libc.schedYield() }
    let record = register()
    Prim.atomicStore(control, 0, 0)
    blockExit()
    record
}

fun register() -> Prim.Ptr {
    var n = Prim.atomicLoad(control, 8)
    if n == 0 {
        Prim.storePtr(records, 0, Prim.processState())
        n = 1
    }
    if n == limit { return Prim.ptrNull() }
    -- The record's size, `Turkey.Runtime.processStateBytes`.
    let record = zeroed(2008)
    if Prim.ptrIsNull(record) { return record }
    Prim.storeI64(record, 288, n)
    Prim.storePtr(records, 8 * n, record)
    Prim.atomicStore(states, 8 * n, 2)
    Prim.atomicStore(control, 8, plus(n, 1))
    record
}

-- Stop every other worker, for a collection. False if another worker is
-- stopping them already: that one collects, and this one stops at its next
-- safepoint like the rest.
fun stopTheWorld() -> Bool {
    let n = count()
    if n < 2 { return True }
    if Prim.atomicCas(control, 0, 0, 1) != 0 { return False }
    let me = index()
    for var i = 0; i < n; i = plus(i, 1) {
        if i != me { let _ = Prim.atomicAdd(recordOf(i), 272, 1) }
    }
    for var i = 0; i < n; i = plus(i, 1) {
        if i != me {
            while !stoppedOrHeld(i) { let _ = Libc.schedYield() }
        }
    }
    True
}

fun stoppedOrHeld(i : Int) -> Bool {
    let state = Prim.atomicLoad(states, 8 * i)
    state == 1 || (state == 2 && Prim.atomicCas(states, 8 * i, 2, 3) == 2)
}

-- Let the other workers go again, and wait until every one that stopped is
-- running before another collection may stop them.
fun startTheWorld() -> Unit {
    let n = count()
    if n < 2 { return {} }
    let me = index()
    for var i = 0; i < n; i = plus(i, 1) {
        if i != me {
            if Prim.atomicLoad(states, 8 * i) == 3 { Prim.atomicStore(states, 8 * i, 2) }
            let _ = Prim.atomicAdd(recordOf(i), 272, -1)
        }
    }
    -- The stopped and held workers sleep until this says so (`Turkey.Heap.stopAt`).
    signalCollection()
    for var i = 0; i < n; i = plus(i, 1) {
        if i != me {
            while Prim.atomicLoad(states, 8 * i) == 1 { let _ = Libc.schedYield() }
        }
    }
    Prim.atomicStore(control, 0, 0)
}

-- At a safepoint whose caller's frame record is `frame`, with the running
-- worker's stop word raised: stopped, until `stopLeave`. The collection may
-- ask a stopped worker to help it mark (`Turkey.Heap.stopAt`), which is why
-- the wait between the two is the heap's.
fun stopEnter(frame : Prim.Ptr) -> Unit {
    parkAt(frame)
    Prim.atomicStore(states, 8 * index(), 1)
}

-- Whether the collection that stopped the running worker is still going.
fun stopWanted() -> Bool = Prim.intAnd(Prim.atomicLoad(Prim.processState(), 272), 1) != 0

fun stopLeave() -> Unit {
    parkAt(Prim.ptrNull())
    Prim.atomicStore(states, 8 * index(), 0)
}

-- Whether worker `i` is stopped at a safepoint, rather than held while
-- blocked; only the collecting worker asks, with the world stopped.
fun stopped(i : Int) -> Bool = Prim.atomicLoad(states, 8 * i) == 1

-- About to wait outside Turkey code, with every root the caller holds in its
-- frames and the caller's frame record at `frame`: from here a collection may
-- run without this worker stopping.
fun blockEnter(frame : Prim.Ptr) -> Unit {
    if Prim.atomicLoad(control, 8) == 0 { return {} }
    parkAt(frame)
    Prim.atomicStore(states, 8 * index(), 2)
}

-- Back from waiting: running again once no collection holds this worker.
fun blockExit() -> Unit {
    while True {
        let epoch = collectionSeen()
        if unblock() { return {} }
        -- Held by a collection, which bumps the epoch when it lets go.
        sleepForCollection(epoch)
    }
}

-- Running again, True, unless a collection holds this worker.
fun unblock() -> Bool {
    if Prim.atomicLoad(control, 8) == 0 { return True }
    if Prim.atomicCas(states, 8 * index(), 2, 0) != 2 { return False }
    parkAt(Prim.ptrNull())
    True
}

-- Record `frame` as where the running worker's stack is parked, or null. A
-- worker thread has no stack registered until its first Turkey code does it
-- (`Turkey.Scheduler.workerLoop`), and nothing on it to walk before then.
fun parkAt(frame : Prim.Ptr) -> Unit {
    let stack = Stack.running()
    if !Prim.ptrIsNull(stack) { Stack.parkedSet(stack, frame) }
}

-- Take `mutex` (`Turkey.Lock`), blocking the worker while it waits if another
-- holds it, so that a holder that allocates -- and so may collect -- never
-- waits on a worker that is waiting on it.
foreign "turkey_lock_acquire" fun acquire(mutex : Prim.Ptr) -> Unit {
    if Lock.tryAcquire(mutex) { return {} }
    blockEnter(Prim.frameAddress())
    Lock.acquire(mutex)
    blockExit()
}

-- -- the poller ----------------------------------------------------------------------
--
-- Waiting for the operating system to say that a descriptor is ready, a child
-- has exited or a time has come: Darwin's `kqueue` and Linux's `epoll`, behind
-- one set of calls that take and answer Ints and raw memory only. What a
-- registration means to the program, and what to do when it fires, is the
-- scheduler's: this layer knows a `token`, an Int chosen by the caller that
-- comes back with the event. Token 0 is reserved for the break.
--
-- The poller is made by the first call that needs it, and is never closed.
--
-- **One poller at a time.** The functions that wait, `pollWait` and
-- `pollNow`, share one buffer of events and one of results, so a caller holds
-- the claim (`claim`) across them and across reading the results back
-- (`resultToken`, `resultValue`), and gives it up with `release`. Registering
-- and dropping interest are safe from any worker at any time.
--
-- **One-shot, level-triggered.** A registration delivers one event and is gone
-- (`EV_ONESHOT`, `EPOLLONESHOT`), and one made for a descriptor that is ready
-- already delivers at once, so readiness that arrived before the call is not
-- lost. A descriptor closed while it is registered is dropped by Darwin
-- without an event. On Linux, interest is dropped when every descriptor for
-- the same open file is closed, so a descriptor that may have been duplicated
-- is dropped with `pollForget` before it is closed. Linux keeps one
-- registration per descriptor, not one per direction: a second one for the
-- same descriptor, in either direction, replaces the first, and the first's
-- token is never delivered.
--
-- **Results.** An event decodes to a `(token, value)` pair of Ints. For a
-- descriptor the value is a mask of `pollReadable`, `pollWritable`, `pollEof`
-- and `pollError`: what the kernel reported, which is more than what was asked
-- for when a descriptor hangs up or fails. A waiter treats any result as "try
-- the operation again". For a child the value is, on Darwin, the child's
-- `wait` status exactly as `waitpid` stores it, which is 0 for a clean exit
-- and so cannot be told from "nothing" by its value; on Linux it is
-- `pollReadable`, and the status comes from `waitpid`. Either way the child
-- is not reaped, and the caller passes the token to `pollForgetChild` once it
-- has the result, which on Linux closes the descriptor that was watching it.

let pollReadable : Int = 1
let pollWritable : Int = 2
let pollEof : Int = 4
let pollError : Int = 8

-- `pollWait`'s timeout for "until an event or a break".
let pollTimeoutForever : Int = -2

-- How many events a wait takes at once; the rest wait for the next call.
let batch : Int = 64

-- The poller's words. State: 0 not made, 1 being made by some worker, 2 made,
-- 3 could not be made. The descriptor of the `kqueue` or the epoll instance.
-- Linux's `eventfd`, registered with token 0. The negated `errno` a failed
-- making left. The scratch block (`scratchAt`). The results block, `batch`
-- `(token, value)` pairs of Ints. How many pairs the last wait left there.
var poller : Prim.Ptr = zeroed(64)

let stateAt : Int = 0
let descriptorAt : Int = 8
let wakeDescriptorAt : Int = 16
let failureAt : Int = 24
let scratchAt : Int = 32
let resultsAt : Int = 40
let countAt : Int = 48

-- The scratch block, which only the claimant and the maker use: `batch` events
-- of the target's size (`Turkey.Sys.keventBytes`, `epollEventBytes`; 32 is the
-- larger), a `struct timespec` after them for `kevent`'s timeout, then the
-- eight bytes holding the number 1 that Linux writes to break a wait, and
-- eight to read it back into.
let eventsEnd : Int = 2048
let timespecAt : Int = 2048
let oneAt : Int = 2064
let drainAt : Int = 2072
let scratchBytes : Int = 2080

-- The poller, made if it was not, or the negated `errno` of why it cannot be.
-- Workers that arrive while another is making it wait for it; the making is a
-- few system calls, with no safepoint in it.
fun pollerReady() -> Int {
    while True {
        let state = Prim.atomicLoad(poller, stateAt)
        if state == 2 { return 0 }
        if state == 3 { return Prim.atomicLoad(poller, failureAt) }
        if state == 0 && Prim.atomicCas(poller, stateAt, 0, 1) == 0 {
            let r = make()
            if r == 0 {
                Prim.atomicStore(poller, stateAt, 2)
            } else {
                Prim.atomicStore(poller, failureAt, r)
                Prim.atomicStore(poller, stateAt, 3)
            }
        } else {
            let _ = Libc.schedYield()
        }
    }
    0
}

fun make() -> Int {
    let scratch = zeroed(scratchBytes)
    let results = Libc.malloc(Prim.intMulWrapping(batch, 16))
    if Prim.ptrIsNull(scratch) || Prim.ptrIsNull(results) {
        Libc.free(scratch)
        Libc.free(results)
        return Prim.intNeg(Sys.enomem)
    }
    Prim.storeI64(scratch, oneAt, 1)
    Prim.storePtr(poller, scratchAt, scratch)
    Prim.storePtr(poller, resultsAt, results)
    let r = match Target.os {
        Darwin -> makeKqueue()
        Linux -> makeEpoll()
    }
    if r != 0 {
        Prim.storePtr(poller, scratchAt, Prim.ptrNull())
        Prim.storePtr(poller, resultsAt, Prim.ptrNull())
        Libc.free(scratch)
        Libc.free(results)
    }
    r
}

-- A `kqueue`, with the user event that breaks a wait registered under ident 0:
-- `EV_CLEAR` makes each trigger one event that a wait takes.
fun makeKqueue() -> Int {
    let kq = Sys.cInt(Libc.kqueue())
    if kq < 0 { return Prim.intNeg(Sys.errno()) }
    let _ = Libc.fcntlWith(kq, Sys.setDescriptorFlags, Sys.descriptorCloseOnExec)
    Prim.atomicStore(poller, descriptorAt, kq)
    let r = change(Sys.filterUser(), 0, Prim.intOr(Sys.evAdd, Sys.evClear), 0, 0)
    if r < 0 { let _ = Libc.close(kq) }
    r
}

-- An epoll instance, with an `eventfd` that breaks a wait registered under
-- token 0, level-triggered: it stays readable until a wait reads it.
fun makeEpoll() -> Int {
    let ep = Sys.cInt(Libc.epollCreate1(Sys.closeOnExec()))
    if ep < 0 { return Prim.intNeg(Sys.errno()) }
    let wake = Sys.cInt(Libc.eventfd(0, Prim.intOr(Sys.nonBlocking(), Sys.closeOnExec())))
    if wake < 0 {
        let failure = Prim.intNeg(Sys.errno())
        let _ = Libc.close(ep)
        return failure
    }
    let r = epollControl(ep, Sys.epollCtlAdd, wake, Sys.epollIn, 0)
    if r < 0 {
        let _ = Libc.close(ep)
        let _ = Libc.close(wake)
        return r
    }
    Prim.atomicStore(poller, descriptorAt, ep)
    Prim.atomicStore(poller, wakeDescriptorAt, wake)
    0
}

-- -- Darwin

-- Fill the `struct kevent` at `at` in `buf` (`Turkey.Sys.keventBytes`). The
-- `filter`, `flags` and `fflags` fields share one word, little-endian.
fun setEvent(buf : Prim.Ptr, at : Int, ident : Int, filter : Int, flags : Int, fflags : Int,
             data : Int, udata : Int) -> Unit {
    Prim.storeI64(buf, at, ident)
    let packed = Prim.intOr(Prim.intAnd(filter, 0xFFFF),
                            Prim.intOr(Prim.intShl(flags, 16), Prim.intShl(fflags, 32)))
    Prim.storeI64(buf, plus(at, 8), packed)
    Prim.storeI64(buf, plus(at, 16), data)
    Prim.storeI64(buf, plus(at, 24), udata)
}

-- Make one change to the queue, with `EV_RECEIPT`, so that the call answers
-- the change and takes no pending event; 0, or the negated error number the
-- receipt carries. Never without a receipt: a change that fails reports it
-- only if there is room in the event list to carry it. A process or
-- descriptor that is already gone is reported as `ESRCH` or `EBADF`.
fun change(filter : Int, ident : Int, flags : Int, fflags : Int, udata : Int) -> Int {
    -- The change, its receipt, and a zero timeout.
    let buf = zeroed(80)
    if Prim.ptrIsNull(buf) { return Prim.intNeg(Sys.enomem) }
    setEvent(buf, 0, ident, filter, Prim.intOr(flags, Sys.evReceipt), fflags, 0, udata)
    let kq = Prim.atomicLoad(poller, descriptorAt)
    var answer = 0
    while True {
        let n = Sys.cInt(Libc.kevent(kq, buf, 1, Prim.ptrAdd(buf, 32), 1, Prim.ptrAdd(buf, 64)))
        if n < 0 {
            answer = Prim.intNeg(Sys.errno())
            if answer != Prim.intNeg(Sys.eintr) { break }
        } else {
            let head = Prim.loadI64(buf, 40)
            if Prim.intAnd(Prim.intShr(head, 16), Sys.evError) != 0 {
                answer = Prim.intNeg(Prim.loadI64(buf, 48))
            }
            break
        }
    }
    Libc.free(buf)
    answer
}

-- -- Linux

-- `epoll_ctl`, with `events` and `token` as the `struct epoll_event`; 0 or
-- the negated `errno`.
fun epollControl(ep : Int, operation : Int, fd : Int, events : Int, token : Int) -> Int {
    let event = Libc.malloc(16)
    if Prim.ptrIsNull(event) { return Prim.intNeg(Sys.enomem) }
    Prim.storeI64(event, 0, events)
    Prim.storeI64(event, 8, token)
    let r = Sys.cResult(Libc.epollCtl(ep, operation, fd, event))
    Libc.free(event)
    r
}

-- Interest in `fd`'s `events`, once, delivering `token`: a change of the
-- descriptor's registration, or a new one if it has none.
fun epollArm(fd : Int, events : Int, token : Int) -> Int {
    let ep = Prim.atomicLoad(poller, descriptorAt)
    let armed = Prim.intOr(events, Sys.epollOneShot)
    let r = epollControl(ep, Sys.epollCtlMod, fd, armed, token)
    if r == Prim.intNeg(Sys.enoent) { epollControl(ep, Sys.epollCtlAdd, fd, armed, token) } else { r }
}

-- -- registering

-- Tell the poller to deliver `token` once `fd` is readable, or at end of file
-- or on an error; 0, or the negated `errno`.
fun pollRead(fd : Int, token : Int) -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    match Target.os {
        Darwin -> change(Sys.filterRead(), fd, Prim.intOr(Sys.evAdd, Sys.evOneShot), 0, token)
        Linux -> epollArm(fd, Sys.epollIn, token)
    }
}

-- The same for `fd` writable.
fun pollWrite(fd : Int, token : Int) -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    match Target.os {
        Darwin -> change(Sys.filterWrite(), fd, Prim.intOr(Sys.evAdd, Sys.evOneShot), 0, token)
        Linux -> epollArm(fd, Sys.epollOut, token)
    }
}

-- The same for either: `token` is delivered once `fd` is readable or
-- writable. On Linux this is the one registration the descriptor has, which
-- replaces a read or a write registration made before it; on Darwin it is
-- both filters, each of which delivers its own event and is gone when it has.
fun pollReadWrite(fd : Int, token : Int) -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    match Target.os {
        Darwin -> {
            let flags = Prim.intOr(Sys.evAdd, Sys.evOneShot)
            let r = change(Sys.filterRead(), fd, flags, 0, token)
            if r < 0 { r } else { change(Sys.filterWrite(), fd, flags, 0, token) }
        }
        Linux -> epollArm(fd, Prim.intOr(Sys.epollIn, Sys.epollOut), token)
    }
}

-- Tell the poller to deliver `token` once the child `pid` has exited: 0 if it
-- will; 1 if it has exited already -- Darwin reports a child that is a zombie,
-- or gone, as `ESRCH`, and nothing will be delivered -- in which case the
-- caller reaps it with `waitpid`; or the negated `errno`. On Linux the child
-- is watched through a descriptor from `pidfd_open`, which is kept in a table
-- under `token` until `pollForgetChild`. A zombie is registered like any
-- other and delivers at once; `pidfd_open` fails with `ESRCH` for a pid that
-- no longer exists, which is the negated result.
fun pollChild(pid : Int, token : Int) -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    match Target.os {
        Darwin -> {
            let flags = Prim.intOr(Sys.evAdd, Sys.evOneShot)
            let r = change(Sys.filterProc(), pid, flags, Prim.intOr(Sys.noteExit, Sys.noteExitStatus), token)
            if r == Prim.intNeg(Sys.esrch) { 1 } else { r }
        }
        Linux -> watchPid(pid, token)
    }
}

fun watchPid(pid : Int, token : Int) -> Int {
    let fd = Sys.result(Libc.syscall(Sys.pidfdOpen, Prim.ptrFromInt(pid), 0, 0, Prim.ptrNull()))
    if fd < 0 { return fd }
    let r = epollArm(fd, Sys.epollIn, token)
    if r < 0 {
        let _ = Libc.close(fd)
        return r
    }
    if !childAdd(token, fd) {
        let _ = Libc.close(fd)
        return Prim.intNeg(Sys.enomem)
    }
    0
}

-- Drop interest in `fd`, both directions, ignoring that there may be none.
-- Before it is closed, on Linux (see above).
fun pollForget(fd : Int) -> Unit {
    if Prim.atomicLoad(poller, stateAt) != 2 { return {} }
    match Target.os {
        Darwin -> {
            let _ = change(Sys.filterRead(), fd, Sys.evDelete, 0, 0)
            let _ = change(Sys.filterWrite(), fd, Sys.evDelete, 0, 0)
        }
        Linux -> { let _ = epollControl(Prim.atomicLoad(poller, descriptorAt), Sys.epollCtlDel, fd, 0, 0) }
    }
}

-- Drop interest in the child registered under `token`, and release what
-- watched it, ignoring that it may have fired or never been registered:
-- the caller does this once the child's result has been delivered, too.
fun pollForgetChild(pid : Int, token : Int) -> Unit {
    if Prim.atomicLoad(poller, stateAt) != 2 { return {} }
    match Target.os {
        Darwin -> { let _ = change(Sys.filterProc(), pid, Sys.evDelete, 0, 0) }
        Linux -> {
            let fd = childTake(token)
            -- Closing the descriptor removes it from the epoll instance: no
            -- other descriptor refers to the pidfd.
            if fd >= 0 { let _ = Libc.close(fd) }
        }
    }
}

-- -- the pidfd table (Linux)

-- The pidfds being watched: word 0 an array of `(token, descriptor)` pairs,
-- 8 how many, 16 how many fit. Under `childLock`, taken with `acquire` so
-- that a waiter does not hold up a collection. Only registration and
-- `pollForgetChild` use it; the wait does not.
var children : Prim.Ptr = zeroed(24)
var childLock : Prim.Ptr = Lock.new()

fun childAdd(token : Int, fd : Int) -> Bool {
    acquire(childLock)
    var n = Prim.loadI64(children, 8)
    var table = Prim.loadPtr(children, 0)
    var ok = True
    if n == Prim.loadI64(children, 16) {
        let room = if n == 0 { 8 } else { Prim.intMulWrapping(n, 2) }
        let grown = Libc.realloc(table, Prim.intMulWrapping(room, 16))
        if Prim.ptrIsNull(grown) {
            ok = False
        } else {
            table = grown
            Prim.storePtr(children, 0, grown)
            Prim.storeI64(children, 16, room)
        }
    }
    if ok {
        Prim.storeI64(table, Prim.intMulWrapping(n, 16), token)
        Prim.storeI64(table, plus(Prim.intMulWrapping(n, 16), 8), fd)
        Prim.storeI64(children, 8, plus(n, 1))
    }
    Lock.release(childLock)
    ok
}

-- Remove the pair for `token` and answer its descriptor, or -1.
fun childTake(token : Int) -> Int {
    acquire(childLock)
    let n = Prim.loadI64(children, 8)
    let table = Prim.loadPtr(children, 0)
    var found = -1
    for var i = 0; i < n; i = plus(i, 1) {
        let at = Prim.intMulWrapping(i, 16)
        if found < 0 && Prim.loadI64(table, at) == token {
            found = Prim.loadI64(table, plus(at, 8))
            let last = Prim.intMulWrapping(plus(n, -1), 16)
            Prim.storeI64(table, at, Prim.loadI64(table, last))
            Prim.storeI64(table, plus(at, 8), Prim.loadI64(table, plus(last, 8)))
            Prim.storeI64(children, 8, plus(n, -1))
        }
    }
    Lock.release(childLock)
    found
}

-- -- electing and breaking

-- Whether the caller is now the one worker that may poll: it stays so until
-- `release`.
fun claim() -> Bool = Prim.atomicCas(signals, claimedAt, 0, 1) == 0

fun release() -> Unit = Prim.atomicStore(signals, claimedAt, 0)

-- Registrations and timers the scheduler is waiting on, `n` more (or fewer,
-- negative).
fun interestAdd(n : Int) -> Unit {
    let _ = Prim.atomicAdd(signals, interestAt, n)
}

fun interest() -> Int = Prim.atomicLoad(signals, interestAt)

-- End the poller's wait, if it is in one, or keep its next from starting: a
-- Darwin user event is triggered, a Linux `eventfd` written. A break is one
-- event that a wait takes whenever it comes, so one sent a moment after the
-- wait ended wakes the next wait early, which is harmless. Only the signaller
-- that sets word 48 sends it, and a send that fails clears the word again so
-- that the next signaller tries.
fun wakePoller() -> Unit {
    if Prim.atomicLoad(poller, stateAt) != 2 { return {} }
    if Prim.atomicCas(signals, wakePendingAt, 0, 1) != 0 { return {} }
    let failed = match Target.os {
        Darwin -> change(Sys.filterUser(), 0, 0, Sys.noteTrigger, 0) < 0
        -- `EAGAIN` is a counter that cannot take another 1: a break is
        -- pending already.
        Linux -> {
            let wake = Prim.atomicLoad(poller, wakeDescriptorAt)
            let one = Prim.ptrAdd(Prim.loadPtr(poller, scratchAt), oneAt)
            let r = Sys.result(Libc.write(wake, one, 8))
            r < 0 && r != Prim.intNeg(Sys.eagain())
        }
    }
    if failed { Prim.atomicStore(signals, wakePendingAt, 0) }
}

-- -- waiting

-- Wait for events, as the worker that holds the claim (`claim`) and is blocked
-- already (`blockEnter`; `Turkey.Heap.pause` does it): until a registered
-- event, a break, `timeout` nanoseconds (rounded up to the kernel's
-- granularity, so that a deadline is never met early), or never if `timeout`
-- is `pollTimeoutForever`. `seen` is the work epoch the caller read before it
-- looked for work and found none: if the epoch has moved, the wait is skipped.
--
-- Answers how many results there are to read (`resultToken`, `resultValue`),
-- which is 0 for a break, a timeout, or a signal that interrupted the wait, or
-- the negated `errno` if the poller cannot be had or the wait failed.
fun pollWait(seen : Int, timeout : Int) -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    Prim.atomicStore(poller, countAt, 0)
    Prim.atomicStore(signals, blockedAt, 1)
    var n = 0
    if Prim.atomicLoad(signals, 0) == seen { n = waitFor(timeout) }
    Prim.atomicStore(signals, blockedAt, 0)
    Prim.atomicStore(signals, wakePendingAt, 0)
    n
}

-- Take the events that are ready now, as the worker that holds the claim,
-- without blocking and without `blockEnter`: how many results, or the
-- negated `errno`.
fun pollNow() -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    Prim.atomicStore(poller, countAt, 0)
    waitFor(0)
}

fun resultToken(i : Int) -> Int =
    Prim.loadI64(Prim.loadPtr(poller, resultsAt), Prim.intMulWrapping(i, 16))

fun resultValue(i : Int) -> Int =
    Prim.loadI64(Prim.loadPtr(poller, resultsAt), plus(Prim.intMulWrapping(i, 16), 8))

-- The kernel's wait and the decoding of what it left. An interrupted wait
-- answers 0, as a timeout does; the caller looks again. `errno` is read
-- straight after the call, before anything else can set it.
--
-- Taking a break clears the break word: the event is gone from the kernel, so
-- the next signaller must send another.
fun waitFor(timeout : Int) -> Int {
    let scratch = Prim.loadPtr(poller, scratchAt)
    let n = match Target.os {
        Darwin -> kqueueWait(scratch, timeout)
        Linux -> epollWaitFor(scratch, timeout)
    }
    if n <= 0 { return n }
    var count = 0
    for var i = 0; i < n; i = plus(i, 1) {
        count = match Target.os {
            Darwin -> decodeKevent(scratch, i, count)
            Linux -> decodeEpoll(scratch, i, count)
        }
    }
    Prim.atomicStore(poller, countAt, count)
    count
}

-- The number of events the kernel stored at `scratch`, or the negated `errno`
-- of a wait that failed, with an interruption counted as no events.
fun kqueueWait(scratch : Prim.Ptr, timeout : Int) -> Int {
    -- Capped at about 31 years, which Darwin accepts and which is as good as
    -- never.
    var limit = Prim.ptrNull()
    if timeout >= 0 {
        limit = Prim.ptrAdd(scratch, timespecAt)
        let capped = if timeout > 1_000_000_000_000_000 { 1_000_000_000_000_000 } else { timeout }
        Prim.storeI64(limit, 0, capped / 1_000_000_000)
        Prim.storeI64(limit, 8, capped % 1_000_000_000)
    }
    let n = Sys.cInt(Libc.kevent(Prim.atomicLoad(poller, descriptorAt), Prim.ptrNull(), 0,
                                 scratch, batch, limit))
    afterWait(n)
}

fun epollWaitFor(scratch : Prim.Ptr, timeout : Int) -> Int {
    -- Milliseconds, rounded up; a C `int`, so capped.
    let ms = if timeout < 0 {
        -1
    } else if timeout > 1_000_000_000_000_000 {
        1_000_000_000
    } else {
        plus(timeout, 999_999) / 1_000_000
    }
    let n = Sys.cInt(Libc.epollWait(Prim.atomicLoad(poller, descriptorAt), scratch, batch, ms))
    afterWait(n)
}

fun afterWait(n : Int) -> Int {
    if n >= 0 { return n }
    let failure = Prim.intNeg(Sys.errno())
    if failure == Prim.intNeg(Sys.eintr) { 0 } else { failure }
}

-- Add the pair `(token, value)` to the results, answering the new count.
fun push(count : Int, token : Int, value : Int) -> Int {
    let results = Prim.loadPtr(poller, resultsAt)
    Prim.storeI64(results, Prim.intMulWrapping(count, 16), token)
    Prim.storeI64(results, plus(Prim.intMulWrapping(count, 16), 8), value)
    plus(count, 1)
}

-- The `i`th `struct kevent` at `scratch` as a result, if it is not a break.
-- The break is the user filter; an event whose `udata` is the token the
-- caller chose is anything else. A read or write event carries `EV_EOF` at end
-- of stream, and `EV_ERROR` for a failure; a process event carries the wait
-- status in `data`.
fun decodeKevent(scratch : Prim.Ptr, i : Int, count : Int) -> Int {
    let event = Prim.ptrAdd(scratch, Prim.intMulWrapping(i, 32))
    let head = Prim.loadI64(event, 8)
    let raw = Prim.intAnd(head, 0xFFFF)
    let filter = if raw >= 0x8000 { Prim.intSubWrapping(raw, 0x10000) } else { raw }
    let flags = Prim.intAnd(Prim.intShr(head, 16), 0xFFFF)
    if filter == Sys.filterUser() {
        Prim.atomicStore(signals, wakePendingAt, 0)
        return count
    }
    let token = Prim.loadI64(event, 24)
    if filter == Sys.filterProc() {
        return push(count, token, Prim.loadI64(event, 16))
    }
    var value = if filter == Sys.filterRead() { pollReadable } else { pollWritable }
    if Prim.intAnd(flags, Sys.evEof) != 0 { value = Prim.intOr(value, pollEof) }
    if Prim.intAnd(flags, Sys.evError) != 0 { value = Prim.intOr(value, pollError) }
    push(count, token, value)
}

-- The `i`th `struct epoll_event` at `scratch` as a result, if it is not the
-- break, whose `eventfd` is read to empty it, which makes it stop reporting.
fun decodeEpoll(scratch : Prim.Ptr, i : Int, count : Int) -> Int {
    let event = Prim.ptrAdd(scratch, Prim.intMulWrapping(i, 16))
    let events = Prim.intAnd(Prim.loadI64(event, 0), 0xFFFF_FFFF)
    let token = Prim.loadI64(event, 8)
    if token == 0 {
        let _ = Libc.read(Prim.atomicLoad(poller, wakeDescriptorAt), Prim.ptrAdd(scratch, drainAt), 8)
        Prim.atomicStore(signals, wakePendingAt, 0)
        return count
    }
    var value = 0
    if Prim.intAnd(events, Sys.epollIn) != 0 { value = Prim.intOr(value, pollReadable) }
    if Prim.intAnd(events, Sys.epollOut) != 0 { value = Prim.intOr(value, pollWritable) }
    if Prim.intAnd(events, Prim.intOr(Sys.epollHup, Sys.epollRdHup)) != 0 {
        value = Prim.intOr(value, pollEof)
    }
    if Prim.intAnd(events, Sys.epollErr) != 0 { value = Prim.intOr(value, pollError) }
    push(count, token, value)
}

-- -- C calls that may block -------------------------------------------------------------
--
-- A read from a pipe or a terminal, a write to one, an open of a FIFO: each
-- can wait for as long as something outside the program takes. A worker in
-- one is blocked for that time (`blockEnter`), so that a collection need not
-- wait for it; every root its caller holds is in a frame, since the call to
-- these is a safepoint. `foreign`, as `acquire` is, so that the frame they
-- record is their own. `Turkey.IO` calls these rather than `Turkey.Libc`'s.
--
-- Each answers in `Turkey.Sys.result`'s convention, and reads `errno` before
-- `blockExit`: a worker held by a collection sleeps in a C call of its own,
-- which may set `errno` over the one being reported.

foreign "turkey_blocking_read" fun blockingRead(fd : Int, buf : Prim.Ptr, count : Int) -> Int {
    blockEnter(Prim.frameAddress())
    let n = Sys.result(Libc.read(fd, buf, count))
    blockExit()
    n
}

foreign "turkey_blocking_write" fun blockingWrite(fd : Int, buf : Prim.Ptr, count : Int) -> Int {
    blockEnter(Prim.frameAddress())
    let n = Sys.result(Libc.write(fd, buf, count))
    blockExit()
    n
}

foreign "turkey_blocking_pread" fun blockingPread(fd : Int, buf : Prim.Ptr, count : Int,
                                                  offset : Int) -> Int {
    blockEnter(Prim.frameAddress())
    let n = Sys.result(Libc.pread(fd, buf, count, offset))
    blockExit()
    n
}

foreign "turkey_blocking_pwrite" fun blockingPwrite(fd : Int, buf : Prim.Ptr, count : Int,
                                                    offset : Int) -> Int {
    blockEnter(Prim.frameAddress())
    let n = Sys.result(Libc.pwrite(fd, buf, count, offset))
    blockExit()
    n
}

foreign "turkey_blocking_open" fun blockingOpen(path : Prim.Ptr, flags : Int, mode : Int) -> Int {
    blockEnter(Prim.frameAddress())
    let fd = Sys.cResult(Libc.open(path, flags, mode))
    blockExit()
    fd
}

foreign "turkey_blocking_close" fun blockingClose(fd : Int) -> Int {
    blockEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.close(fd))
    blockExit()
    r
}

foreign "turkey_blocking_fstat" fun blockingFstat(fd : Int, buf : Prim.Ptr) -> Int {
    blockEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.fstat(fd, buf))
    blockExit()
    r
}

-- The directory calls block for as long as the file system takes, which on a
-- network file system is unbounded, and `flock` without `LOCK_NB` for as long
-- as another process holds the lock.

foreign "turkey_blocking_openat" fun blockingOpenat(dir : Int, path : Prim.Ptr, flags : Int,
                                                    mode : Int) -> Int {
    blockEnter(Prim.frameAddress())
    let fd = Sys.cResult(Libc.openat(dir, path, flags, mode))
    blockExit()
    fd
}

foreign "turkey_blocking_fstatat" fun blockingFstatat(dir : Int, path : Prim.Ptr, buf : Prim.Ptr,
                                                      flags : Int) -> Int {
    blockEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.fstatat(dir, path, buf, flags))
    blockExit()
    r
}

foreign "turkey_blocking_unlinkat" fun blockingUnlinkat(dir : Int, path : Prim.Ptr,
                                                        flags : Int) -> Int {
    blockEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.unlinkat(dir, path, flags))
    blockExit()
    r
}

foreign "turkey_blocking_mkdirat" fun blockingMkdirat(dir : Int, path : Prim.Ptr,
                                                      mode : Int) -> Int {
    blockEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.mkdirat(dir, path, mode))
    blockExit()
    r
}

foreign "turkey_blocking_renameat" fun blockingRenameat(fromDir : Int, from : Prim.Ptr,
                                                        toDir : Int, to : Prim.Ptr) -> Int {
    blockEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.renameat(fromDir, from, toDir, to))
    blockExit()
    r
}

foreign "turkey_blocking_readlinkat" fun blockingReadlinkat(dir : Int, path : Prim.Ptr,
                                                            buf : Prim.Ptr, size : Int) -> Int {
    blockEnter(Prim.frameAddress())
    let n = Sys.result(Libc.readlinkat(dir, path, buf, size))
    blockExit()
    n
}

foreign "turkey_blocking_flock" fun blockingFlock(fd : Int, operation : Int) -> Int {
    blockEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.flock(fd, operation))
    blockExit()
    r
}

-- The next entry's address as an `Int`, which is positive; 0 at the end of
-- the stream; or the negated `errno`.
foreign "turkey_blocking_readdir" fun blockingReaddir(stream : Prim.Ptr) -> Int {
    blockEnter(Prim.frameAddress())
    Sys.clearErrno()
    let entry = Libc.readdir(stream)
    let r = if Prim.ptrIsNull(entry) { Prim.intNeg(Sys.errno()) } else { Prim.ptrToInt(entry) }
    blockExit()
    r
}

-- A worker thread's Turkey code has returned, which it does only when a panic
-- or an exit unwound it: hand the panic to the main worker, whose code ends
-- the program with it, as a panic in a task on the main worker does. The
-- flag is word 0 of a record, and the message bytes 24 to 272.
foreign "turkey_worker_ended" fun ended() -> Unit {
    let mine = Prim.processState()
    if Prim.loadI64(mine, 0) == 0 { return {} }
    -- Down first: every call below returns to a test of it.
    Prim.storeI64(mine, 0, 0)
    let first = recordOf(0)
    -- The message before the flag, which the main worker may act on at once.
    -- One that is unwinding already keeps its own.
    if Prim.atomicLoad(first, 0) != 0 { return {} }
    for var at = 24; at < 272; at = plus(at, 8) {
        Prim.storeI64(first, at, Prim.loadI64(mine, at))
    }
    let _ = Prim.atomicCas(first, 0, 0, 1)
    -- The main worker may be asleep waiting for work, and sees the flag only
    -- once it runs again.
    signalWork(True)
}

fun plus(a : Int, b : Int) -> Int = Prim.intAddWrapping(a, b)
