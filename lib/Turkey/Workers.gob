export (
    count, index, new, recordOf, threadLimit, mainRegister, started,
    workSeen, sleepForWork, signalWork, collectionSeen, sleepForCollection, signalCollection, stopTheWorld, startTheWorld, stopEnter, stopLeave,
    stopWanted, stopped, running,
    blockEnter, blockExit, unblock, acquire, ended,
    permits, permitsSet, permitHeld, permitWanted, permitGive, permitAwait,
    queuedSet, idleEnter, idleLeave,
    monitorStart, monitoring, monitorState, monitorCalling, monitorWork, monitorHold, monitorTake,
    monitorHandOut, monitorSleep,
    blockingRead, blockingWrite, blockingPread, blockingPwrite, blockingOpen, blockingClose,
    blockingFstat, blockingOpenat, blockingFstatat, blockingUnlinkat, blockingMkdirat,
    blockingRenameat, blockingReadlinkat, blockingFlock, blockingMkdtemp, blockingFdopendir,
    blockingReaddir, blockingGetcwd, blockingGetaddrinfo, blockingSpawnp, blockingSleepOn,
    claim, release, wakePoller, interestAdd, interest,
    pollRegister, pollRead, pollWrite, pollReadWrite, pollChild, pollUnlock, pollForget,
    pollForgetChild, pollForgetUnlock, pollWait, pollNow,
    resultToken, resultValue,
    pollReadable, pollWritable, pollEof, pollError, pollTimeoutForever,
)

-- The threads that run Turkey code, each with a record of its own
-- (`Turkey.Process` lays it out) that `x28` holds while it runs; the run
-- permits that say which of them may take tasks; and how a collection stops
-- all but itself.
--
-- A giblet module, since the collector and the allocator call it.
--
-- **Records and permits.** A thread's record is what makes it a mutator: its
-- allocator cursors, its remembered set, its stop word, its stack and its
-- index. A thread keeps the record it starts with for life, so every table
-- indexed by a thread's index (`Turkey.Coroutine`'s, the heap's) has one
-- owner. What `TURKEY_WORKERS` counts is permits: a thread takes tasks from
-- the queue only while it holds one (`Turkey.Scheduler.workerLoop`). Permits
-- are interchangeable, so what is kept is how many no thread holds.
--
-- **Blocking calls.** A thread about to wait in a C call that may take as long
-- as something outside the program does -- a file read, `flock` -- says so
-- with one store (`callEnter`) and keeps its permit. If it is still in the
-- same call on two ticks of the monitor while tasks wait for a thread, the
-- monitor takes the permit and hands it to a spare thread (`Turkey.Monitor`).
-- A call that returns first costs one compare-and-swap (`callExit`). One that
-- finds its permit gone takes a free one if there is one. Otherwise its
-- record is still its own, so it can still take the scheduler's lock: it
-- gives its task back to the scheduler to queue and parks as a spare
-- (`Turkey.Scheduler.afterCall`). Which C calls are made this way, and which
-- may wait inline, is the contract under "C calls that may block" below.
--
-- **Stopping the world.** A collection runs with every other thread stopped at
-- a safepoint, where the frame tables describe its roots. The collecting
-- thread raises each other thread's stop word -- the word every loop's poll
-- tests (`Turkey.Polls`), which the allocator's slow path tests too -- and
-- waits until each is either stopped or blocked:
--
-- * **stopped**: it saw its stop word at a safepoint, recorded that frame as
--   its running stack's parked frame, so that the collection walks its stack
--   like any parked one, and waits for the word to come down, marking for
--   the collection meanwhile if it is asked to (`Turkey.Heap.stopAt`);
-- * **blocked**: it declared, before waiting on something outside Turkey code
--   -- a lock, work, a permit or a C call -- that its stack is parked at a
--   frame and that it holds nothing else. The collector claims a blocked
--   thread (*held*) so that it cannot run again until the collection ends.
--   The monitor holds a blocked thread the same way while it takes its permit.
--
-- The collector waits at the end until every thread it stopped is running
-- again, so that a second collection never mistakes a thread still leaving
-- the first for one stopped for it.

import Prelude ()
import Data.Int (Int)
import Data.Tuple (Unit)
import Data.Eq (Eq(..), (==), (!=))
import Data.Ord (Ord(..), (<), (<=), (>), (>=))
import Data.Num (Add(..), Sub(..), Mul(..), Div(..), Rem(..), Neg(..), (+), (-), (*), (/), (%))
import Data.Int ()
import Data.Bool (Bool(..))
import Bits (BitAnd(..), BitOr(..), Shift(..), (&), (|), (<<), (>>))
import Target (OS(..))
import Target as Target
import Turkey.Libc as Libc
import Turkey.Lock as Lock
import Turkey.Memory as Memory
import Turkey.Process as Process
import Turkey.Stack as Stack
import Turkey.Sys as Sys
import Data.Int as Int
import Turkey.Ptr (Ptr)
import Turkey.Ptr as Ptr

-- At most this many threads run Turkey code, the program's own included, and
-- every table indexed by a thread is this long: about 80 bytes a thread, all
-- of it allocated at start. One more crashes the program
-- (`threadsExhausted`), as Go's runtime crashes past 10000.
--
-- A thread beyond the permits exists only to carry a permit while another
-- thread is blocked in a call, so this bounds the calls blocked at once. Past
-- about a thousand, synchronous calls stop paying: Haas and Leis (VLDB 2023)
-- needed a little over 1000 `pread`s in flight to keep an NVMe drive busy,
-- and found more threads than that spending most of their time in the
-- kernel. A program that blocks more threads than this is more likely stuck,
-- with tasks waiting on each other's file locks, than busy; and every
-- collection visits every thread.
fun threadLimit() -> Int = 1024

-- Each thread's record, by index; index 0 is the program's own thread's, the
-- process state every program defines.
var records : Ptr = zeroed(8 * threadLimit())

-- Each thread's state, by index: one word, changed only atomically.
--
-- * Bits 0 to 2 are what the thread is doing: running Turkey code (0),
--   stopped at a safepoint (1), waiting (2) -- for a lock, for work or for a
--   permit -- or in a blocking call (4). 3 and 5 are those two, held.
-- * Bit 3 is set while the thread holds no permit.
-- * The bits from 4 up count the thread's blocking calls, so that the monitor
--   can tell one long call from two short ones.
--
-- The thread writes its own word with plain stores only while it runs, when
-- nothing else writes it, and leaves a wait or a call by compare-and-swap,
-- which fails while it is held. A holder holds a waiting or calling thread by
-- compare-and-swap and lets it go by a store.
var states : Ptr = zeroed(8 * threadLimit())

let stoppedState : Int = 1
let waitingState : Int = 2
let callingState : Int = 4
let noPermit : Int = 8
let callStep : Int = 16

-- Word 0: 1 while a collection is stopping the world, 2 while a thread is
-- being registered, claimed by compare-and-swap. Word 8: how many threads
-- there are.
var control : Ptr = zeroed(16)

-- The permits' words: how many there are; how many no thread holds; 1 while
-- the program's own stack waits for one, and 2 once a holder has given it one
-- (`permitAwait`); the epoch it sleeps on; the epoch spare threads sleep on,
-- and how many do; how many spares the monitor has woken or started that
-- have not yet looked for a permit; the scheduler's count of runnable tasks
-- (`queuedSet`); how many holders are idle, waiting for work; and 1 while the
-- monitor sleeps because every holder is.
var permitWords : Ptr = zeroed(80)

let permitCountAt : Int = 0
let permitFreeAt : Int = 8
let wantedAt : Int = 16
let wantEpochAt : Int = 24
let spareEpochAt : Int = 32
let sparesAt : Int = 40
let handingAt : Int = 48
let queuedAt : Int = 56
let idlersAt : Int = 64
let monitorAsleepAt : Int = 72

-- The monitor's record (`monitorStart`), or null.
var monitorRecord : Ptr = Ptr.null()

-- What threads with nothing to do sleep on, so that they use no processor
-- until there is something for them, and the words that choose which of them
-- waits for the operating system's readiness events instead (the poller, below).
--
-- Word 0 is the work epoch: bumped when a task becomes runnable, and when one
-- finishes while the program's own code waits for it (`signalWork`). Word 16
-- is the collection epoch: bumped when a collection asks its stopped and held
-- threads to mark, and when it, or the monitor, lets them go
-- (`signalCollection`). Words 8 and 24 count the threads asleep on each, so
-- that bumping one costs a system call only when one is.
--
-- A sleeper reads the epoch before it looks for what it waits for, and sleeps
-- only while the epoch is still what it read: so a bump made after it looked
-- either shows in the epoch, and it does not sleep, or finds it counted, and
-- wakes it (`sleepOn`).
--
-- Word 32 is the poller's claim: 1 while a thread holds the right to poll,
-- taken by compare-and-swap (`claim`), so that at most one polls at a time.
-- Word 40 is 1 while the claimant is inside, or about to enter, a wait that
-- only a kernel event ends (`pollWait`). Word 48 is 1 while a break is on its
-- way to that wait, so that a burst of signals costs one system call
-- (`wakePoller`). Word 56 counts the registrations and timers the scheduler
-- is waiting on (`interestAdd`); threads read it without a lock to decide
-- whether to poll at all.
--
-- A poller sleeps in the kernel and not on the work epoch, so `signalWork`
-- reaches it by breaking its wait. The signaller bumps the epoch and then
-- reads word 40; the poller sets word 40 and then reads the epoch again
-- before it waits, and does not wait if the epoch moved (`pollWait`): the
-- same two orderings as a futex sleeper's, so a signal either shows in the
-- epoch or finds the poller marked and breaks its wait. On the way out the
-- poller clears word 40 and then word 48: a signaller that finds word 48 set
-- relies on a break already on its way, which the kernel holds for the next
-- wait if this one has ended, so at worst the next wait ends early.
var signals : Ptr = zeroed(64)

let claimedAt : Int = 32
let blockedAt : Int = 40
let wakePendingAt : Int = 48
let interestAt : Int = 56

fun workSeen() -> Int = Ptr.atomicLoad(signals, 0)
fun collectionSeen() -> Int = Ptr.atomicLoad(signals, 16)

fun sleepForWork(seen : Int) -> Unit = sleepOn(0, seen)
fun sleepForCollection(seen : Int) -> Unit = sleepOn(16, seen)

-- Sleep while the epoch at `word` is `seen`. The count goes up before the
-- epoch is read again, and the bump goes before the count is read, so one of
-- the two sees the other.
fun sleepOn(word : Int, seen : Int) -> Unit {
    let _ = Ptr.atomicAdd(signals, plus(word, 8), 1)
    if Ptr.atomicLoad(signals, word) == seen { Lock.wait(Ptr.add(signals, word), seen) }
    let _ = Ptr.atomicAdd(signals, plus(word, 8), -1)
}

-- Something for an idle thread to do: wake one, or, `all`, every one. A
-- poller is one more idle thread: it is broken out of its wait when every one
-- is to be woken, and when no sleeper on the epoch was there to take a single
-- wake.
fun signalWork(all : Bool) -> Unit {
    let _ = Ptr.atomicAdd(signals, 0, 1)
    var woken = False
    if Ptr.atomicLoad(signals, 8) != 0 {
        if all { Lock.wakeAll(signals) } else { woken = Lock.wake(signals) }
    }
    if (all || !woken) && Ptr.atomicLoad(signals, blockedAt) != 0 { wakePoller() }
}

fun signalCollection() -> Unit {
    let _ = Ptr.atomicAdd(signals, 16, 1)
    if Ptr.atomicLoad(signals, 24) != 0 { Lock.wakeAll(Ptr.add(signals, 16)) }
}

fun zeroed(bytes : Int) -> Ptr {
    let p = Libc.malloc(bytes)
    if !Ptr.isNull(p) { Memory.fill(p, bytes, 0) }
    p
}

-- How many threads there are: 1 until the program's own is registered.
fun count() -> Int {
    let n = Ptr.atomicLoad(control, 8)
    if n == 0 { 1 } else { n }
}

-- The running thread's index, a word of its record.
fun index() -> Int = Ptr.load(Process.workerRecord(), 288)

-- The offset of the running thread's state word in `states`.
fun mine() -> Int = index() << 3

-- Whether the running thread is running Turkey code, rather than blocked or
-- stopped -- which it may be in a loop of this module's, inlined into a
-- caller and so given a poll (`Turkey.Polls`).
fun running() -> Bool = (Ptr.atomicLoad(states, mine()) & 7) == 0

fun recordOf(i : Int) -> Ptr =
    if i == 0 && Ptr.atomicLoad(control, 8) == 0 { Process.workerRecord() }
    else { Ptr.load(records, 8 * i) }

-- Whether the program's own thread is registered (`mainRegister`), which it is
-- once the workers have started.
fun started() -> Bool = Ptr.atomicLoad(control, 8) != 0

-- Register the program's own thread, as the first, holding a permit: from
-- here on its waits and calls are counted. Called once, before any other
-- thread starts.
fun mainRegister() -> Unit {
    if Ptr.atomicLoad(control, 8) != 0 { return {} }
    Ptr.store(records, 0, Process.workerRecord())
    Ptr.atomicStore(control, 8, 1)
}

-- A record for a new thread holding a permit, registered and blocked until
-- the thread starts running Turkey code (`blockExit`); null if there is no
-- room or no memory. Called on the program's own thread.
--
-- Not while a collection is stopping the world, which counted the threads
-- when it began: registration claims the same word a collection does, and
-- waits blocked for it, so that a collection under way can finish.
--
-- This and the other functions that record where the thread parked
-- (`acquire`, `permitAwait`, `Turkey.Heap.pause`) are `foreign` so that they
-- are never inlined: the frame they record must be their own, whose return
-- address is a safepoint in their caller, where the caller's roots are stored
-- and mapped.
foreign "turkey_worker_new" fun new() -> Ptr {
    mainRegister()
    blockEnter(Prim.frameAddress())
    while Ptr.atomicCas(control, 0, 0, 2) != 0 { let _ = Libc.schedYield() }
    let record = register(True)
    Ptr.atomicStore(control, 0, 0)
    blockExit()
    record
}

-- A record for a spare thread, registered without a permit, for the monitor,
-- which has no state of its own to block in: null if a collection or another
-- registration holds the word, or there is no memory, for the monitor to try
-- again at its next tick. A program that has `threadLimit` threads ends here.
fun spareNew() -> Ptr {
    if Ptr.atomicCas(control, 0, 0, 2) != 0 { return Ptr.null() }
    if Ptr.atomicLoad(control, 8) == threadLimit() { threadsExhausted() }
    let record = register(False)
    Ptr.atomicStore(control, 0, 0)
    record
}

-- Under the registration claim.
fun register(permitted : Bool) -> Ptr {
    let n = Ptr.atomicLoad(control, 8)
    if n == threadLimit() { return Ptr.null() }
    -- The record's size, `Turkey.Runtime.processStateBytes`.
    let record = zeroed(2008)
    if Ptr.isNull(record) { return record }
    Ptr.store(record, 288, n)
    Ptr.store(records, 8 * n, record)
    Ptr.atomicStore(states, 8 * n, if permitted { waitingState } else { plus(waitingState, noPermit) })
    Ptr.atomicStore(control, 8, plus(n, 1))
    record
}

-- End the program from the monitor's thread, which has no Turkey code to
-- unwind: the status is 2, as a Go program's is for the same failure.
fun threadsExhausted() -> Unit {
    Process.panicInt(Prim.cString("thread exhaustion: the program needs more than "),
                     threadLimit(), Prim.cString(" threads"))
    die()
}

-- Write the running thread's panic message and leave at once: no other
-- thread's Turkey code can be trusted to finish.
fun die() -> Unit {
    say(Prim.cString("turkey: "))
    say(Process.panicMessage())
    say(Prim.cString("\n"))
    Libc.exitNow(2)
}

fun say(text : Ptr) -> Unit {
    let _ = Libc.write(2, text, Libc.strlen(text))
}

-- Stop every other thread, for a collection. False if another thread is
-- stopping them already: that one collects, and this one stops at its next
-- safepoint like the rest. A registration under way is waited for, since it
-- ends without a safepoint.
fun stopTheWorld() -> Bool {
    if Ptr.atomicLoad(control, 8) == 0 { return True }
    while True {
        let claimed = Ptr.atomicCas(control, 0, 0, 1)
        if claimed == 0 { break }
        if claimed == 1 { return False }
        let _ = Libc.schedYield()
    }
    let n = count()
    let me = index()
    for var i = 0; i < n; i = plus(i, 1) {
        if i != me { let _ = Ptr.atomicAdd(recordOf(i), 272, 1) }
    }
    for var i = 0; i < n; i = plus(i, 1) {
        if i != me {
            while !stoppedOrHeld(i) { let _ = Libc.schedYield() }
        }
    }
    True
}

-- A thread held by the monitor is not yet held by the collection: the
-- monitor lets it go in a few hundred instructions, and the collector holds
-- it then.
fun stoppedOrHeld(i : Int) -> Bool {
    let s = Ptr.atomicLoad(states, 8 * i)
    let status = s & 7
    status == stoppedState
        || ((status == waitingState || status == callingState)
            && Ptr.atomicCas(states, 8 * i, s, plus(s, 1)) == s)
}

-- Let the other threads go again, and wait until every one that stopped is
-- running before another collection may stop them.
fun startTheWorld() -> Unit {
    if Ptr.atomicLoad(control, 8) == 0 { return {} }
    let n = count()
    let me = index()
    for var i = 0; i < n; i = plus(i, 1) {
        if i != me {
            -- Every held thread is this collection's: the monitor holds only a
            -- calling thread, and every one is held here.
            let s = Ptr.atomicLoad(states, 8 * i)
            let status = s & 7
            if status == 3 || status == 5 { Ptr.atomicStore(states, 8 * i, plus(s, -1)) }
            let _ = Ptr.atomicAdd(recordOf(i), 272, -1)
        }
    }
    -- The stopped and held threads sleep until this says so (`Turkey.Heap.stopAt`).
    signalCollection()
    for var i = 0; i < n; i = plus(i, 1) {
        if i != me {
            while (Ptr.atomicLoad(states, 8 * i) & 7) == stoppedState {
                let _ = Libc.schedYield()
            }
        }
    }
    Ptr.atomicStore(control, 0, 0)
}

-- At a safepoint whose caller's frame record is `frame`, with the running
-- thread's stop word raised: stopped, until `stopLeave`. The collection may
-- ask a stopped thread to help it mark (`Turkey.Heap.stopAt`), which is why
-- the wait between the two is the heap's.
fun stopEnter(frame : Ptr) -> Unit {
    parkAt(frame)
    let at = mine()
    Ptr.atomicStore(states, at, plus(Ptr.atomicLoad(states, at), stoppedState))
}

-- Whether the collection that stopped the running thread is still going.
fun stopWanted() -> Bool = Ptr.atomicLoad(Process.workerRecord(), 272) & 1 != 0

fun stopLeave() -> Unit {
    parkAt(Ptr.null())
    let at = mine()
    Ptr.atomicStore(states, at, Int.subWrapping(Ptr.atomicLoad(states, at), stoppedState))
}

-- Whether thread `i` is stopped at a safepoint, rather than held while
-- blocked; only the collecting thread asks, with the world stopped.
fun stopped(i : Int) -> Bool = (Ptr.atomicLoad(states, 8 * i) & 7) == stoppedState

-- About to wait outside Turkey code, with every root the caller holds in its
-- frames and the caller's frame record at `frame`: from here a collection may
-- run without this thread stopping.
fun blockEnter(frame : Ptr) -> Unit {
    if Ptr.atomicLoad(control, 8) == 0 { return {} }
    parkAt(frame)
    let at = mine()
    Ptr.atomicStore(states, at, plus(Ptr.atomicLoad(states, at), waitingState))
}

-- Back from waiting: running again once nobody holds this thread.
fun blockExit() -> Unit {
    while True {
        let epoch = collectionSeen()
        if unblock() { return {} }
        -- Held by a collection or the monitor, which bump the epoch when they
        -- let go.
        sleepForCollection(epoch)
    }
}

-- Running again, True, unless a collection or the monitor holds this thread.
fun unblock() -> Bool {
    if Ptr.atomicLoad(control, 8) == 0 { return True }
    let at = mine()
    let s = Ptr.atomicLoad(states, at)
    let status = s & 7
    if status != waitingState && status != callingState { return False }
    if Ptr.atomicCas(states, at, s, Int.subWrapping(s, status)) != s { return False }
    parkAt(Ptr.null())
    True
}

-- About to wait in a C call that may take as long as something outside the
-- program does: blocked, as `blockEnter` is, and counted, so that the monitor
-- can tell this call from the next. One store, since this runs at every read
-- of a file; the constants are literals here and in `callExit` so that
-- neither loads them from a global (`states` lays them out).
fun callEnter(frame : Ptr) -> Unit {
    if Ptr.atomicLoad(control, 8) == 0 { return {} }
    parkAt(frame)
    let at = mine()
    -- `callStep` plus `callingState`.
    Ptr.atomicStore(states, at, plus(Ptr.atomicLoad(states, at), 20))
}

-- Back from the call: running again once nobody holds this thread, and
-- holding a permit if it can (`permitRegain`). A call back before the monitor
-- took its permit costs one compare-and-swap.
fun callExit() -> Unit {
    if Ptr.atomicLoad(control, 8) == 0 { return {} }
    let at = mine()
    let s = Ptr.atomicLoad(states, at)
    -- Still calling, with the permit (the low four bits are `callingState`).
    if (s & 15) == 4 && Ptr.atomicCas(states, at, s, Int.subWrapping(s, 4)) == s {
        parkAt(Ptr.null())
        return {}
    }
    blockExit()
    if !permitHeld() { permitRegain() }
}

-- Running again after a call, without a permit: take a free one if there is
-- one. On the program's own stack, whose code no other thread can run, wait
-- for one if not. On a task's stack, return without one, for the caller to
-- give the task back (`Turkey.Scheduler.afterCall`): that switches stacks,
-- which no giblet may do.
--
-- Every coroutine is a task, resumed by the scheduler from a thread's own
-- stack, so a stack with a resumer is a task's.
fun permitRegain() -> Unit {
    let stack = Stack.running()
    let task = !Ptr.isNull(stack) && !Ptr.isNull(Stack.resumer(stack))
    if !permitTake(!task) && !task { permitAwait(True) }
}

-- Record `frame` as where the running thread's stack is parked, or null. A
-- worker thread has no stack registered until its first Turkey code does it
-- (`Turkey.Scheduler.workerLoop`), and nothing on it to walk before then.
fun parkAt(frame : Ptr) -> Unit {
    let stack = Stack.running()
    if !Ptr.isNull(stack) { Stack.parkedSet(stack, frame) }
}

-- Take `mutex` (`Turkey.Lock`), blocking the thread while it waits if another
-- holds it, so that a holder that allocates -- and so may collect -- never
-- waits on a thread that is waiting on it.
foreign "turkey_lock_acquire" fun acquire(mutex : Ptr) -> Unit {
    if Lock.tryAcquire(mutex) { return {} }
    blockEnter(Prim.frameAddress())
    Lock.acquire(mutex)
    blockExit()
}

-- -- permits ----------------------------------------------------------------------------

-- How many permits there are: what `TURKEY_WORKERS` asked for, or 1 before
-- the workers start.
fun permits() -> Int {
    let n = Ptr.atomicLoad(permitWords, permitCountAt)
    if n == 0 { 1 } else { n }
}

fun permitsSet(n : Int) -> Unit = Ptr.atomicStore(permitWords, permitCountAt, n)

-- Whether the running thread holds a permit, which every thread does until
-- the workers start.
fun permitHeld() -> Bool =
    Ptr.atomicLoad(control, 8) == 0 || (Ptr.atomicLoad(states, mine()) & noPermit) == 0

-- Whether the program's own stack is waiting for a permit, which the next
-- holder to look gives it (`permitGive`).
fun permitWanted() -> Bool = Ptr.atomicLoad(permitWords, wantedAt) == 1

-- Give the running thread's permit to the program's own stack, which waits
-- for one: True if this thread gave it, False if another holder did first.
-- The thread holds none after.
fun permitGive() -> Bool {
    if Ptr.atomicCas(permitWords, wantedAt, 1, 2) != 1 { return False }
    permitDrop()
    let _ = Ptr.atomicAdd(permitWords, wantEpochAt, 1)
    let _ = Lock.wake(Ptr.add(permitWords, wantEpochAt))
    True
}

-- Give up the running thread's permit: marked as not held, and then free.
fun permitDrop() -> Unit {
    let at = mine()
    Ptr.atomicStore(states, at, plus(Ptr.atomicLoad(states, at), noPermit))
    let _ = Ptr.atomicAdd(permitWords, permitFreeAt, 1)
}

-- Take a free permit for the running thread, which holds none: whether it did.
-- While the program's own stack waits for one, only it may take one.
fun permitTake(program : Bool) -> Bool {
    while permitFree(program) {
        let free = Ptr.atomicLoad(permitWords, permitFreeAt)
        if Ptr.atomicCas(permitWords, permitFreeAt, free, plus(free, -1)) == free {
            let at = mine()
            Ptr.atomicStore(states, at, Int.subWrapping(Ptr.atomicLoad(states, at), noPermit))
            return True
        }
    }
    False
}

fun permitFree(program : Bool) -> Bool =
    Ptr.atomicLoad(permitWords, permitFreeAt) > 0
        && (program || Ptr.atomicLoad(permitWords, wantedAt) == 0)

-- Return holding a permit, asleep and blocked meanwhile, so that a collection
-- need not wait. A spare thread (`program` False) sleeps until the monitor
-- hands it one (`monitorHandOut`). The program's own stack, whose code no
-- other thread can run (`program` True), asks the holders for one: it wakes
-- an idle one, which gives it, and a busy one gives it between tasks
-- (`Turkey.Scheduler`).
--
-- A sleeper reads its epoch, then looks for a free permit; whoever frees one
-- does so before bumping the epoch, so the sleeper either sees the permit or
-- sleeps on an epoch that has moved.
foreign "turkey_permit_await" fun permitAwait(program : Bool) -> Unit {
    if permitHeld() { return {} }
    if !program { handingDone() }
    if permitTake(program) { return {} }
    let epoch = if program { wantEpochAt } else { spareEpochAt }
    if program {
        Ptr.atomicStore(permitWords, wantedAt, 1)
        signalWork(False)
    }
    while True {
        let seen = Ptr.atomicLoad(permitWords, epoch)
        blockEnter(Prim.frameAddress())
        if !program { let _ = Ptr.atomicAdd(permitWords, sparesAt, 1) }
        if !permitFree(program) && Ptr.atomicLoad(permitWords, epoch) == seen {
            Lock.wait(Ptr.add(permitWords, epoch), seen)
        }
        if !program {
            let _ = Ptr.atomicAdd(permitWords, sparesAt, -1)
            handingDone()
        }
        blockExit()
        if permitTake(program) { break }
    }
    if program {
        Ptr.atomicStore(permitWords, wantedAt, 0)
        -- One the monitor freed meanwhile, or a second holder's, is a spare's.
        if Ptr.atomicLoad(permitWords, permitFreeAt) > 0 { spareWake() }
    }
}

-- One fewer spare on its way to a permit (`monitorHandOut`): a spare says so
-- each time it looks for one. A spare that looks for another reason counts
-- too, which at worst wakes or starts one spare too many.
fun handingDone() -> Unit {
    let handing = Ptr.atomicLoad(permitWords, handingAt)
    if handing > 0 { let _ = Ptr.atomicCas(permitWords, handingAt, handing, plus(handing, -1)) }
}

fun spareWake() -> Unit {
    let _ = Ptr.atomicAdd(permitWords, spareEpochAt, 1)
    if Ptr.atomicLoad(permitWords, sparesAt) != 0 {
        let _ = Lock.wake(Ptr.add(permitWords, spareEpochAt))
    }
}

-- The scheduler's count of runnable tasks, which the monitor reads without
-- its lock. Under the scheduler's lock.
fun queuedSet(n : Int) -> Unit = Ptr.atomicStore(permitWords, queuedAt, n)

-- A holder with nothing to run is about to wait for work, and is back.
fun idleEnter() -> Unit {
    let _ = Ptr.atomicAdd(permitWords, idlersAt, 1)
}

fun idleLeave() -> Unit {
    let _ = Ptr.atomicAdd(permitWords, idlersAt, -1)
    if Ptr.atomicLoad(permitWords, monitorAsleepAt) != 0
            && Ptr.atomicCas(permitWords, monitorAsleepAt, 1, 0) == 1 {
        let _ = Lock.wake(Ptr.add(permitWords, monitorAsleepAt))
    }
}

-- -- the monitor's side -----------------------------------------------------------------

-- Start the monitor's thread (`Turkey.Monitor`), whose record is registered
-- nowhere, so that no collection waits for it: it never allocates, and it
-- touches the heap only under the heap's lock while it holds the thread whose
-- cursors it retires. Its index is -1, which no table has. False if it could
-- not be started.
fun monitorStart() -> Bool {
    let record = zeroed(1752)
    let thread = Libc.malloc(8)
    if Ptr.isNull(record) || Ptr.isNull(thread) { return False }
    Ptr.store(record, 288, -1)
    monitorRecord = record
    (Libc.pthreadCreate(thread, Ptr.null(), Prim.codeAddress("turkey_worker_start"), record)
        & 0xFFFF_FFFF) == 0
}

-- Whether the running thread is the monitor's.
fun monitoring() -> Bool =
    !Ptr.isNull(monitorRecord) && Process.workerRecord() == monitorRecord

fun monitorState(i : Int) -> Int = Ptr.atomicLoad(states, 8 * i)

-- Whether `state` is a blocking call by a thread that holds its permit.
fun monitorCalling(state : Int) -> Bool = (state & 15) == callingState

-- Whether there is more to run than the threads free to run it: runnable
-- tasks beyond the idle holders and the free permits, or the program's own
-- stack waiting for a permit with none free.
fun monitorWork() -> Bool {
    let free = Ptr.atomicLoad(permitWords, permitFreeAt)
    let supply = plus(Ptr.atomicLoad(permitWords, idlersAt), free)
    Ptr.atomicLoad(permitWords, queuedAt) > supply
        || (Ptr.atomicLoad(permitWords, wantedAt) == 1 && free <= 0)
}

-- Hold thread `i`, whose state was `state`, a call (`monitorCalling`):
-- whether it still was.
fun monitorHold(i : Int, state : Int) -> Bool =
    Ptr.atomicCas(states, 8 * i, state, plus(state, 1)) == state

-- Let thread `i`, held from `state`, go without its permit, which is free
-- first so that the thread may take it back. A thread that returned from its
-- call meanwhile sleeps on the collection epoch.
fun monitorTake(i : Int, state : Int) -> Unit {
    let _ = Ptr.atomicAdd(permitWords, permitFreeAt, 1)
    Ptr.atomicStore(states, 8 * i, plus(state, noPermit))
    signalCollection()
}

-- Hand a free permit on: to the program's own stack, if it waits for one,
-- else to a spare thread, waking one or starting one. Whether it did.
fun monitorHandOut() -> Bool {
    let free = Ptr.atomicLoad(permitWords, permitFreeAt)
    if free <= 0 { return False }
    if Ptr.atomicLoad(permitWords, wantedAt) != 0 {
        let _ = Ptr.atomicAdd(permitWords, wantEpochAt, 1)
        return Lock.wake(Ptr.add(permitWords, wantEpochAt))
    }
    if Ptr.atomicLoad(permitWords, handingAt) >= free { return False }
    let _ = Ptr.atomicAdd(permitWords, handingAt, 1)
    if Ptr.atomicLoad(permitWords, sparesAt) > 0 {
        spareWake()
        return True
    }
    let record = spareNew()
    let thread = Libc.malloc(8)
    if Ptr.isNull(record) || Ptr.isNull(thread) {
        Libc.free(thread)
        let _ = Ptr.atomicAdd(permitWords, handingAt, -1)
        return False
    }
    let started = Libc.pthreadCreate(thread, Ptr.null(),
                                     Prim.codeAddress("turkey_worker_start"), record)
    if (started & 0xFFFF_FFFF) != 0 {
        Process.panicInt(Prim.cString("could not start a thread: error "),
                         started & 0xFFFF_FFFF, Prim.cString(""))
        die()
    }
    True
}

-- Sleep while every holder is idle, with nothing free to hand out: then no
-- thread can be in a call holding a permit until a holder stops being idle,
-- which wakes this (`idleLeave`). Whether it slept.
fun monitorSleep() -> Bool {
    if !allIdle() { return False }
    Ptr.atomicStore(permitWords, monitorAsleepAt, 1)
    if allIdle() { Lock.wait(Ptr.add(permitWords, monitorAsleepAt), 1) }
    Ptr.atomicStore(permitWords, monitorAsleepAt, 0)
    True
}

fun allIdle() -> Bool =
    Ptr.atomicLoad(permitWords, idlersAt) >= permits()
        && Ptr.atomicLoad(permitWords, permitFreeAt) <= 0

-- -- the poller ----------------------------------------------------------------------
--
-- Waiting for the operating system to say that a descriptor is ready, a child
-- has exited or a time has come: Darwin's `kqueue` and Linux's `epoll`, behind
-- one set of calls that take and answer Ints and raw memory only. What a
-- registration means to the program, and what to do when it fires, is the
-- scheduler's: this layer knows a `token`, an Int chosen by the caller that
-- comes back with the event. Token 0 is reserved for the break.
--
-- The poller is made by the first call that needs it, and is never closed.
--
-- **One poller at a time.** The functions that wait, `pollWait` and
-- `pollNow`, share one buffer of events and one of results, so a caller holds
-- the claim (`claim`) across them and across reading the results back
-- (`resultToken`, `resultValue`), and gives it up with `release`. Registering
-- and dropping interest are safe from any worker, one at a time: they share
-- one buffer (`changesAt`), and every caller holds the scheduler's lock
-- (`Turkey.Poll`). `wakePoller`, which needs no lock, makes its own.
--
-- **Two kinds of registration.** `pollRegister` registers a descriptor for the
-- rest of its life, edge-triggered (`EV_CLEAR`, `EPOLLET`), in both
-- directions: each time the descriptor becomes readable or writable again it
-- delivers one event, whether anyone waits for it or not, so the caller keeps
-- what an event said until a wait asks. `pollRead`, `pollWrite` and
-- `pollReadWrite` register once, level-triggered (`EV_ONESHOT`,
-- `EPOLLONESHOT`): one event, and the registration is gone. Either kind, made
-- for a descriptor that is ready already, delivers at once, so readiness that
-- arrived before the call is not lost. A descriptor closed while it is
-- registered is dropped by Darwin without an event. On Linux, interest is
-- dropped when every descriptor for the same open file is closed, so a
-- descriptor that may have been duplicated is dropped with `pollForget` before
-- it is closed. Linux keeps one registration per descriptor, not one per
-- direction: a second one for the same descriptor, in either direction,
-- replaces the first, and the first's token is never delivered.
--
-- **Results.** An event decodes to a `(token, value)` pair of Ints. For a
-- descriptor the value is a mask of `pollReadable`, `pollWritable`, `pollEof`
-- and `pollError`: what the kernel reported, which is more than what was asked
-- for when a descriptor hangs up or fails. A waiter treats any result as "try
-- the operation again". For a child the value is, on Darwin, the child's
-- `wait` status exactly as `waitpid` stores it, which is 0 for a clean exit
-- and so cannot be told from "nothing" by its value; on Linux it is
-- `pollReadable`, and the status comes from `waitpid`. Either way the child
-- is not reaped, and the caller passes the token to `pollForgetChild` once it
-- has the result, which on Linux closes the descriptor that was watching it.
-- For an unlock (Darwin only) the value is `pollReadable`, and says only that
-- some lock on the file was released, not that the caller can take it.

let pollReadable : Int = 1
let pollWritable : Int = 2
let pollEof : Int = 4
let pollError : Int = 8

-- `pollWait`'s timeout for "until an event or a break".
let pollTimeoutForever : Int = -2

-- How many events a wait takes at once; the rest wait for the next call.
let batch : Int = 64

-- The poller's words. State: 0 not made, 1 being made by some worker, 2 made,
-- 3 could not be made. The descriptor of the `kqueue` or the epoll instance.
-- Linux's `eventfd`, registered with token 0. The negated `errno` a failed
-- making left. The scratch block (`scratchAt`). The results block, `batch`
-- `(token, value)` pairs of Ints. How many pairs the last wait left there.
-- The changes block (`changesBytes`), for registering and dropping interest.
var poller : Ptr = zeroed(64)

let stateAt : Int = 0
let descriptorAt : Int = 8
let wakeDescriptorAt : Int = 16
let failureAt : Int = 24
let scratchAt : Int = 32
let resultsAt : Int = 40
let countAt : Int = 48
let changesAt : Int = 56

-- The scratch block, which only the claimant and the maker use: `batch` events
-- of the target's size (`Turkey.Sys.keventBytes`, `epollEventBytes`; 32 is the
-- larger), a `struct timespec` after them for `kevent`'s timeout, then the
-- eight bytes holding the number 1 that Linux writes to break a wait, and
-- eight to read it back into.
let eventsEnd : Int = 2048
let timespecAt : Int = 2048
let oneAt : Int = 2064
let drainAt : Int = 2072
let scratchBytes : Int = 2080

-- The changes block: two `struct kevent` changes, their two receipts, and a
-- zero `struct timespec` after them; Linux uses the first 16 bytes for its
-- one `struct epoll_event`.
let receiptsAt : Int = 64
let changeTimeoutAt : Int = 128
let changesBytes : Int = 144

-- The poller, made if it was not, or the negated `errno` of why it cannot be.
-- Workers that arrive while another is making it wait for it; the making is a
-- few system calls, with no safepoint in it.
fun pollerReady() -> Int {
    while True {
        let state = Ptr.atomicLoad(poller, stateAt)
        if state == 2 { return 0 }
        if state == 3 { return Ptr.atomicLoad(poller, failureAt) }
        if state == 0 && Ptr.atomicCas(poller, stateAt, 0, 1) == 0 {
            let r = make()
            if r == 0 {
                Ptr.atomicStore(poller, stateAt, 2)
            } else {
                Ptr.atomicStore(poller, failureAt, r)
                Ptr.atomicStore(poller, stateAt, 3)
            }
        } else {
            let _ = Libc.schedYield()
        }
    }
    0
}

fun make() -> Int {
    let scratch = zeroed(scratchBytes)
    let results = Libc.malloc(Int.mulWrapping(batch, 16))
    let changes = zeroed(changesBytes)
    if Ptr.isNull(scratch) || Ptr.isNull(results) || Ptr.isNull(changes) {
        Libc.free(scratch)
        Libc.free(results)
        Libc.free(changes)
        return -Sys.enomem
    }
    Ptr.store(scratch, oneAt, 1)
    Ptr.store(poller, scratchAt, scratch)
    Ptr.store(poller, resultsAt, results)
    Ptr.store(poller, changesAt, changes)
    let r = match Target.os {
        Darwin -> makeKqueue()
        Linux -> makeEpoll()
    }
    if r != 0 {
        Ptr.store(poller, scratchAt, Ptr.null())
        Ptr.store(poller, resultsAt, Ptr.null())
        Ptr.store(poller, changesAt, Ptr.null())
        Libc.free(scratch)
        Libc.free(results)
        Libc.free(changes)
    }
    r
}

-- A `kqueue`, with the user event that breaks a wait registered under ident 0:
-- `EV_CLEAR` makes each trigger one event that a wait takes.
fun makeKqueue() -> Int {
    let kq = Sys.cInt(Libc.kqueue())
    if kq < 0 { return -Sys.errno() }
    let _ = Libc.fcntlWith(kq, Sys.setDescriptorFlags, Sys.descriptorCloseOnExec)
    Ptr.atomicStore(poller, descriptorAt, kq)
    let r = change(Sys.filterUser(), 0, Sys.evAdd | Sys.evClear, 0, 0)
    if r < 0 { let _ = Libc.close(kq) }
    r
}

-- An epoll instance, with an `eventfd` that breaks a wait registered under
-- token 0, level-triggered: it stays readable until a wait reads it.
fun makeEpoll() -> Int {
    let ep = Sys.cInt(Libc.epollCreate1(Sys.closeOnExec()))
    if ep < 0 { return -Sys.errno() }
    let wake = Sys.cInt(Libc.eventfd(0, Sys.nonBlocking() | Sys.closeOnExec()))
    if wake < 0 {
        let failure = -Sys.errno()
        let _ = Libc.close(ep)
        return failure
    }
    let r = epollControl(ep, Sys.epollCtlAdd, wake, Sys.epollIn, 0)
    if r < 0 {
        let _ = Libc.close(ep)
        let _ = Libc.close(wake)
        return r
    }
    Ptr.atomicStore(poller, descriptorAt, ep)
    Ptr.atomicStore(poller, wakeDescriptorAt, wake)
    0
}

-- -- Darwin

-- Fill the `struct kevent` at `at` in `buf` (`Turkey.Sys.keventBytes`). The
-- `filter`, `flags` and `fflags` fields share one word, little-endian.
fun setEvent(buf : Ptr, at : Int, ident : Int, filter : Int, flags : Int, fflags : Int,
             data : Int, udata : Int) -> Unit {
    Ptr.store(buf, at, ident)
    let packed = filter & 0xFFFF | flags << 16 | fflags << 32
    Ptr.store(buf, plus(at, 8), packed)
    Ptr.store(buf, plus(at, 16), data)
    Ptr.store(buf, plus(at, 24), udata)
}

-- Make one change to the queue, with `EV_RECEIPT`, so that the call answers
-- the change and takes no pending event; 0, or the negated error number the
-- receipt carries. Never without a receipt: a change that fails reports it
-- only if there is room in the event list to carry it. A process or
-- descriptor that is already gone is reported as `ESRCH` or `EBADF`.
fun change(filter : Int, ident : Int, flags : Int, fflags : Int, udata : Int) -> Int {
    -- The change, its receipt, and a zero timeout.
    let buf = zeroed(80)
    if Ptr.isNull(buf) { return -Sys.enomem }
    setEvent(buf, 0, ident, filter, flags | Sys.evReceipt, fflags, 0, udata)
    let kq = Ptr.atomicLoad(poller, descriptorAt)
    var answer = 0
    while True {
        let n = Sys.cInt(Libc.kevent(kq, buf, 1, Ptr.add(buf, 32), 1, Ptr.add(buf, 64)))
        if n < 0 {
            answer = -Sys.errno()
            if answer != -Sys.eintr { break }
        } else {
            let head : Int = Ptr.load(buf, 40)
            if head >> 16 & Sys.evError != 0 {
                answer = -Ptr.load(buf, 48)
            }
            break
        }
    }
    Libc.free(buf)
    answer
}

-- -- Linux

-- `epoll_ctl`, with `events` and `token` as the `struct epoll_event` in the
-- changes block; 0 or the negated `errno`.
fun epollControl(ep : Int, operation : Int, fd : Int, events : Int, token : Int) -> Int {
    let event : Ptr = Ptr.load(poller, changesAt)
    Ptr.store(event, 0, events)
    Ptr.store(event, 8, token)
    Sys.cResult(Libc.epollCtl(ep, operation, fd, event))
}

-- Interest in `fd`'s `events`, once, delivering `token`: a change of the
-- descriptor's registration, or a new one if it has none.
fun epollArm(fd : Int, events : Int, token : Int) -> Int {
    let ep = Ptr.atomicLoad(poller, descriptorAt)
    let armed = events | Sys.epollOneShot
    let r = epollControl(ep, Sys.epollCtlMod, fd, armed, token)
    if r == -Sys.enoent { epollControl(ep, Sys.epollCtlAdd, fd, armed, token) } else { r }
}

-- -- registering

-- Register `fd` for the rest of its life, edge-triggered, in both directions:
-- `token` is delivered each time it becomes readable or writable, hangs up or
-- fails, and once at once if it is ready now. 0, or the negated `errno`, in
-- which case nothing stays registered. Only one registration per descriptor:
-- a second answers `EEXIST` on Linux.
fun pollRegister(fd : Int, token : Int) -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    match Target.os {
        Darwin -> registerKqueue(fd, token)
        Linux -> {
            let events = Sys.epollIn | Sys.epollOut | Sys.epollRdHup | Sys.epollEdgeTriggered
            epollControl(Ptr.atomicLoad(poller, descriptorAt), Sys.epollCtlAdd, fd, events, token)
        }
    }
}

-- Both filters in one `kevent`, each with a receipt. A filter whose change
-- failed is not registered, and the other is deleted, so that a failure
-- leaves nothing behind.
fun registerKqueue(fd : Int, token : Int) -> Int {
    let changes : Ptr = Ptr.load(poller, changesAt)
    let flags = Sys.evAdd | Sys.evClear | Sys.evReceipt
    setEvent(changes, 0, fd, Sys.filterRead(), flags, 0, 0, token)
    setEvent(changes, 32, fd, Sys.filterWrite(), flags, 0, 0, token)
    let kq = Ptr.atomicLoad(poller, descriptorAt)
    let receipts = Ptr.add(changes, receiptsAt)
    var answer = 0
    while True {
        let n = Sys.cInt(Libc.kevent(kq, changes, 2, receipts, 2, Ptr.add(changes, changeTimeoutAt)))
        if n >= 0 {
            for var i = 0; i < n; i = plus(i, 1) {
                let at = Int.mulWrapping(i, 32)
                let head : Int = Ptr.load(receipts, plus(at, 8))
                let failure : Int = Ptr.load(receipts, plus(at, 16))
                if head >> 16 & Sys.evError != 0 && failure != 0 && answer == 0 { answer = -failure }
            }
            break
        }
        answer = -Sys.errno()
        if answer != -Sys.eintr { break }
    }
    if answer < 0 { pollForget(fd) }
    answer
}

-- Tell the poller to deliver `token` once `fd` is readable, or at end of file
-- or on an error; 0, or the negated `errno`.
fun pollRead(fd : Int, token : Int) -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    match Target.os {
        Darwin -> change(Sys.filterRead(), fd, Sys.evAdd | Sys.evOneShot, 0, token)
        Linux -> epollArm(fd, Sys.epollIn, token)
    }
}

-- The same for `fd` writable.
fun pollWrite(fd : Int, token : Int) -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    match Target.os {
        Darwin -> change(Sys.filterWrite(), fd, Sys.evAdd | Sys.evOneShot, 0, token)
        Linux -> epollArm(fd, Sys.epollOut, token)
    }
}

-- The same for either: `token` is delivered once `fd` is readable or
-- writable. On Linux this is the one registration the descriptor has, which
-- replaces a read or a write registration made before it; on Darwin it is
-- both filters, each of which delivers its own event and is gone when it has.
fun pollReadWrite(fd : Int, token : Int) -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    match Target.os {
        Darwin -> {
            let flags = Sys.evAdd | Sys.evOneShot
            let r = change(Sys.filterRead(), fd, flags, 0, token)
            if r < 0 { r } else { change(Sys.filterWrite(), fd, flags, 0, token) }
        }
        Linux -> epollArm(fd, Sys.epollIn | Sys.epollOut, token)
    }
}

-- Tell the poller to deliver `token` once the child `pid` has exited: 0 if it
-- will; 1 if it has exited already -- Darwin reports a child that is a zombie,
-- or gone, as `ESRCH`, and nothing will be delivered -- in which case the
-- caller reaps it with `waitpid`; or the negated `errno`. On Linux the child
-- is watched through a descriptor from `pidfd_open`, which is kept in a table
-- under `token` until `pollForgetChild`. A zombie is registered like any
-- other and delivers at once; `pidfd_open` fails with `ESRCH` for a pid that
-- no longer exists, which is the negated result.
fun pollChild(pid : Int, token : Int) -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    match Target.os {
        Darwin -> {
            let flags = Sys.evAdd | Sys.evOneShot
            let r = change(Sys.filterProc(), pid, flags, Sys.noteExit | Sys.noteExitStatus, token)
            if r == -Sys.esrch { 1 } else { r }
        }
        Linux -> watchPid(pid, token)
    }
}

-- Tell the poller to deliver `token` once a `flock` lock on `fd`'s file is
-- released, by anyone; 0, or the negated `errno`. Darwin only: Linux reports
-- no release, and answers `-EINVAL`.
fun pollUnlock(fd : Int, token : Int) -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    match Target.os {
        Darwin -> change(Sys.filterVnode(), fd, Sys.evAdd | Sys.evOneShot, Sys.noteFunlock, token)
        Linux -> -Sys.einval
    }
}

fun watchPid(pid : Int, token : Int) -> Int {
    let fd = Sys.result(Libc.syscall(Sys.pidfdOpen, Ptr.fromInt(pid), 0, 0, Ptr.null()))
    if fd < 0 { return fd }
    let r = epollArm(fd, Sys.epollIn, token)
    if r < 0 {
        let _ = Libc.close(fd)
        return r
    }
    if !childAdd(token, fd) {
        let _ = Libc.close(fd)
        return -Sys.enomem
    }
    0
}

-- Drop interest in `fd`, both directions, ignoring that there may be none.
-- Before it is closed, on Linux (see above).
fun pollForget(fd : Int) -> Unit {
    if Ptr.atomicLoad(poller, stateAt) != 2 { return {} }
    match Target.os {
        Darwin -> {
            let _ = change(Sys.filterRead(), fd, Sys.evDelete, 0, 0)
            let _ = change(Sys.filterWrite(), fd, Sys.evDelete, 0, 0)
        }
        -- `EPOLL_CTL_DEL` reads no event.
        Linux -> { let _ = Libc.epollCtl(Ptr.atomicLoad(poller, descriptorAt), Sys.epollCtlDel, fd, Ptr.null()) }
    }
}

-- Drop interest in the child registered under `token`, and release what
-- watched it, ignoring that it may have fired or never been registered:
-- the caller does this once the child's result has been delivered, too.
fun pollForgetChild(pid : Int, token : Int) -> Unit {
    if Ptr.atomicLoad(poller, stateAt) != 2 { return {} }
    match Target.os {
        Darwin -> { let _ = change(Sys.filterProc(), pid, Sys.evDelete, 0, 0) }
        Linux -> {
            let fd = childTake(token)
            -- Closing the descriptor removes it from the epoll instance: no
            -- other descriptor refers to the pidfd.
            if fd >= 0 { let _ = Libc.close(fd) }
        }
    }
}

-- Drop interest in releases of locks on `fd`'s file, ignoring that there may
-- be none.
fun pollForgetUnlock(fd : Int) -> Unit {
    if Ptr.atomicLoad(poller, stateAt) != 2 { return }
    match Target.os {
        Darwin -> { let _ = change(Sys.filterVnode(), fd, Sys.evDelete, 0, 0) }
        Linux -> {}
    }
}

-- -- the pidfd table (Linux)

-- The pidfds being watched: word 0 an array of `(token, descriptor)` pairs,
-- 8 how many, 16 how many fit. Under `childLock`, taken with `acquire` so
-- that a waiter does not hold up a collection. Only registration and
-- `pollForgetChild` use it; the wait does not.
var children : Ptr = zeroed(24)
var childLock : Ptr = Lock.new()

fun childAdd(token : Int, fd : Int) -> Bool {
    acquire(childLock)
    var n : Int = Ptr.load(children, 8)
    var table : Ptr = Ptr.load(children, 0)
    var ok = True
    if n == Ptr.load(children, 16) {
        let room = if n == 0 { 8 } else { Int.mulWrapping(n, 2) }
        let grown = Libc.realloc(table, Int.mulWrapping(room, 16))
        if Ptr.isNull(grown) {
            ok = False
        } else {
            table = grown
            Ptr.store(children, 0, grown)
            Ptr.store(children, 16, room)
        }
    }
    if ok {
        Ptr.store(table, Int.mulWrapping(n, 16), token)
        Ptr.store(table, plus(Int.mulWrapping(n, 16), 8), fd)
        Ptr.store(children, 8, plus(n, 1))
    }
    Lock.release(childLock)
    ok
}

-- Remove the pair for `token` and answer its descriptor, or -1.
fun childTake(token : Int) -> Int {
    acquire(childLock)
    let n : Int = Ptr.load(children, 8)
    let table : Ptr = Ptr.load(children, 0)
    var found = -1
    for var i = 0; i < n; i = plus(i, 1) {
        let at = Int.mulWrapping(i, 16)
        if found < 0 && Ptr.load(table, at) == token {
            found = Ptr.load(table, plus(at, 8))
            let last = Int.mulWrapping(plus(n, -1), 16)
            Ptr.store(table, at, Ptr.load(table, last) : Int)
            Ptr.store(table, plus(at, 8), Ptr.load(table, plus(last, 8)) : Int)
            Ptr.store(children, 8, plus(n, -1))
        }
    }
    Lock.release(childLock)
    found
}

-- -- electing and breaking

-- Whether the caller is now the one worker that may poll: it stays so until
-- `release`.
fun claim() -> Bool = Ptr.atomicCas(signals, claimedAt, 0, 1) == 0

fun release() -> Unit = Ptr.atomicStore(signals, claimedAt, 0)

-- Registrations and timers the scheduler is waiting on, `n` more (or fewer,
-- negative).
fun interestAdd(n : Int) -> Unit {
    let _ = Ptr.atomicAdd(signals, interestAt, n)
}

fun interest() -> Int = Ptr.atomicLoad(signals, interestAt)

-- End the poller's wait, if it is in one, or keep its next from starting: a
-- Darwin user event is triggered, a Linux `eventfd` written. A break is one
-- event that a wait takes whenever it comes, so one sent a moment after the
-- wait ended wakes the next wait early, which is harmless. Only the signaller
-- that sets word 48 sends it, and a send that fails clears the word again so
-- that the next signaller tries.
fun wakePoller() -> Unit {
    if Ptr.atomicLoad(poller, stateAt) != 2 { return {} }
    if Ptr.atomicCas(signals, wakePendingAt, 0, 1) != 0 { return {} }
    let failed = match Target.os {
        Darwin -> change(Sys.filterUser(), 0, 0, Sys.noteTrigger, 0) < 0
        -- `EAGAIN` is a counter that cannot take another 1: a break is
        -- pending already.
        Linux -> {
            let wake = Ptr.atomicLoad(poller, wakeDescriptorAt)
            let one = Ptr.add(Ptr.load(poller, scratchAt), oneAt)
            let r = Sys.result(Libc.write(wake, one, 8))
            r < 0 && r != -Sys.eagain()
        }
    }
    if failed { Ptr.atomicStore(signals, wakePendingAt, 0) }
}

-- -- waiting

-- Wait for events, as the worker that holds the claim (`claim`) and is blocked
-- already (`blockEnter`; `Turkey.Heap.pause` does it): until a registered
-- event, a break, `timeout` nanoseconds (rounded up to the kernel's
-- granularity, so that a deadline is never met early), or never if `timeout`
-- is `pollTimeoutForever`. `seen` is the work epoch the caller read before it
-- looked for work and found none: if the epoch has moved, the wait is skipped.
--
-- Answers how many results there are to read (`resultToken`, `resultValue`),
-- which is 0 for a break, a timeout, or a signal that interrupted the wait, or
-- the negated `errno` if the poller cannot be had or the wait failed.
fun pollWait(seen : Int, timeout : Int) -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    Ptr.atomicStore(poller, countAt, 0)
    Ptr.atomicStore(signals, blockedAt, 1)
    var n = 0
    if Ptr.atomicLoad(signals, 0) == seen { n = waitFor(timeout) }
    Ptr.atomicStore(signals, blockedAt, 0)
    Ptr.atomicStore(signals, wakePendingAt, 0)
    n
}

-- Take the events that are ready now, as the worker that holds the claim,
-- without blocking and without `blockEnter`: how many results, or the
-- negated `errno`.
fun pollNow() -> Int {
    let ready = pollerReady()
    if ready < 0 { return ready }
    Ptr.atomicStore(poller, countAt, 0)
    waitFor(0)
}

fun resultToken(i : Int) -> Int =
    Ptr.load(Ptr.load(poller, resultsAt), Int.mulWrapping(i, 16))

fun resultValue(i : Int) -> Int =
    Ptr.load(Ptr.load(poller, resultsAt), plus(Int.mulWrapping(i, 16), 8))

-- The kernel's wait and the decoding of what it left. An interrupted wait
-- answers 0, as a timeout does; the caller looks again. `errno` is read
-- straight after the call, before anything else can set it.
--
-- Taking a break clears the break word: the event is gone from the kernel, so
-- the next signaller must send another.
fun waitFor(timeout : Int) -> Int {
    let scratch : Ptr = Ptr.load(poller, scratchAt)
    let n = match Target.os {
        Darwin -> kqueueWait(scratch, timeout)
        Linux -> epollWaitFor(scratch, timeout)
    }
    if n <= 0 { return n }
    var count = 0
    for var i = 0; i < n; i = plus(i, 1) {
        count = match Target.os {
            Darwin -> decodeKevent(scratch, i, count)
            Linux -> decodeEpoll(scratch, i, count)
        }
    }
    Ptr.atomicStore(poller, countAt, count)
    count
}

-- The number of events the kernel stored at `scratch`, or the negated `errno`
-- of a wait that failed, with an interruption counted as no events.
fun kqueueWait(scratch : Ptr, timeout : Int) -> Int {
    -- Capped at about 31 years, which Darwin accepts and which is as good as
    -- never.
    var limit = Ptr.null()
    if timeout >= 0 {
        limit = Ptr.add(scratch, timespecAt)
        let capped = if timeout > 1_000_000_000_000_000 { 1_000_000_000_000_000 } else { timeout }
        Ptr.store(limit, 0, capped / 1_000_000_000)
        Ptr.store(limit, 8, capped % 1_000_000_000)
    }
    let n = Sys.cInt(Libc.kevent(Ptr.atomicLoad(poller, descriptorAt), Ptr.null(), 0,
                                 scratch, batch, limit))
    afterWait(n)
}

fun epollWaitFor(scratch : Ptr, timeout : Int) -> Int {
    -- Milliseconds, rounded up; a C `int`, so capped.
    let ms = if timeout < 0 {
        -1
    } else if timeout > 1_000_000_000_000_000 {
        1_000_000_000
    } else {
        plus(timeout, 999_999) / 1_000_000
    }
    let n = Sys.cInt(Libc.epollWait(Ptr.atomicLoad(poller, descriptorAt), scratch, batch, ms))
    afterWait(n)
}

fun afterWait(n : Int) -> Int {
    if n >= 0 { return n }
    let failure = -Sys.errno()
    if failure == -Sys.eintr { 0 } else { failure }
}

-- Add the pair `(token, value)` to the results, answering the new count.
fun push(count : Int, token : Int, value : Int) -> Int {
    let results : Ptr = Ptr.load(poller, resultsAt)
    Ptr.store(results, Int.mulWrapping(count, 16), token)
    Ptr.store(results, plus(Int.mulWrapping(count, 16), 8), value)
    plus(count, 1)
}

-- The `i`th `struct kevent` at `scratch` as a result, if it is not a break.
-- The break is the user filter; an event whose `udata` is the token the
-- caller chose is anything else. A read or write event carries `EV_EOF` at end
-- of stream, and `EV_ERROR` for a failure; a process event carries the wait
-- status in `data`; a vnode event is an unlock, the only one asked for.
fun decodeKevent(scratch : Ptr, i : Int, count : Int) -> Int {
    let event = Ptr.add(scratch, Int.mulWrapping(i, 32))
    let head : Int = Ptr.load(event, 8)
    let raw = head & 0xFFFF
    let filter = if raw >= 0x8000 { Int.subWrapping(raw, 0x10000) } else { raw }
    let flags = head >> 16 & 0xFFFF
    if filter == Sys.filterUser() {
        Ptr.atomicStore(signals, wakePendingAt, 0)
        return count
    }
    let token : Int = Ptr.load(event, 24)
    if filter == Sys.filterProc() {
        return push(count, token, Ptr.load(event, 16))
    }
    if filter == Sys.filterVnode() { return push(count, token, pollReadable) }
    var value = if filter == Sys.filterRead() { pollReadable } else { pollWritable }
    if flags & Sys.evEof != 0 { value = value | pollEof }
    if flags & Sys.evError != 0 { value = value | pollError }
    push(count, token, value)
}

-- The `i`th `struct epoll_event` at `scratch` as a result, if it is not the
-- break, whose `eventfd` is read to empty it, which makes it stop reporting.
fun decodeEpoll(scratch : Ptr, i : Int, count : Int) -> Int {
    let event = Ptr.add(scratch, Int.mulWrapping(i, 16))
    let events : Int = Ptr.load(event, 0) & 0xFFFF_FFFF
    let token : Int = Ptr.load(event, 8)
    if token == 0 {
        let _ = Libc.read(Ptr.atomicLoad(poller, wakeDescriptorAt), Ptr.add(scratch, drainAt), 8)
        Ptr.atomicStore(signals, wakePendingAt, 0)
        return count
    }
    var value = 0
    if events & Sys.epollIn != 0 { value = value | pollReadable }
    if events & Sys.epollOut != 0 { value = value | pollWritable }
    if events & (Sys.epollHup | Sys.epollRdHup) != 0 {
        value = value | pollEof
    }
    if events & Sys.epollErr != 0 { value = value | pollError }
    push(count, token, value)
}

-- -- C calls that may block -------------------------------------------------------------
--
-- **The contract.** A C call that can wait on something outside the program --
-- a file system, a pipe, a terminal, another process's lock, a name server, a
-- child, the clock -- is made through one of the entries below, and the Turkey
-- code that calls the entry follows it with `Turkey.Scheduler.afterCall`.
-- Made inline instead, the call keeps its thread's permit for as long as it
-- waits, and with one permit the program stops. Two mechanisms sit on top:
--
-- * where the system reports readiness, the call is made so that it cannot
--   wait -- on a non-blocking descriptor, or with `WNOHANG` or `LOCK_NB` --
--   and a task waits for the readiness on the poller instead (`Turkey.Poll`,
--   `Turkey.Wait`): pipes, terminals, child exits, and `flock` on Darwin. A
--   sleep is a timer on the poller, not a C call;
-- * where the caller needs a deadline, the call runs on a helper task the
--   caller may leave (`Turkey.Detach`): name lookups, and `flock` on Linux.
--
-- A test reads the two lists below from this comment and checks every call to
-- `Turkey.Libc` outside this module against them. A `Turkey.Libc` function
-- neither list names can wait, and outside this module only the calls the
-- second list names make one.
--
-- **Calls that never wait** on anything outside the program, which any module
-- may make:
--
-- * `malloc`, `free`, `alignedAlloc`, `realloc`, `mmap`, `munmap`, `mprotect`,
--   `strlen`, `memchr`, `memcmp` and `memmem`: memory, which `mmap` only
--   ever maps anonymously;
-- * `floor`, `ceil`, `round`, `trunc`, `fmod`, `remainder` and `sqrt`:
--   arithmetic;
-- * `getenv`, `sysctlbyname`, `sysconf`, `schedGetaffinity`, `clockGettime`,
--   `errnoDarwin` and `errnoLinux`: the process's own state and the system's;
-- * `fcntl`, `fcntlWith` and `isatty`: a descriptor's own state, with the
--   commands the library passes, none of which takes a lock;
-- * `closedir`: a directory has no writes to flush, so closing one waits for
--   nothing;
-- * `pipe`, `pipe2`, `kqueue`, `epollCreate1`, `epollCtl` and `eventfd`:
--   making descriptors and registering them with the poller;
-- * `pthreadAttrInit`, `pthreadAttrSetStackSize`, `pthreadAttrDestroy`,
--   `pthreadCreate`, `schedYield`, `osSyncWakeByAddressAny` and
--   `osSyncWakeByAddressAll`: starting threads, giving up a core, and waking
--   threads;
-- * `spawnActionsInit`, `spawnActionsDestroy`, `spawnActionsAddDup2`,
--   `spawnActionsAddOpen`, `spawnActionsAddChdir`, `spawnAttrInit`,
--   `spawnAttrDestroy`, `spawnAttrSetFlags`, `spawnAttrSetPGroup` and `kill`:
--   describing a child before it starts, and signalling one;
-- * `signal`, `exitNow` and `exit`: installing a handler, and ending the
--   process;
-- * `freeaddrinfo`: giving back a lookup's list;
-- * `socket`, `bind`, `listen`, `shutdown`, `setsockopt`, `getsockopt`,
--   `getsockname` and `getpeername`: making a TCP socket and reading or
--   setting its state, with the IP addresses and options the library passes.
--
-- **Calls that can wait, made inline** by the module named, each for the
-- reason given:
--
-- * `Turkey.Cores.open`, `Turkey.Cores.read` and `Turkey.Cores.close`: the
--   files that give the cgroup's CPU limit, read once by
--   `Turkey.Scheduler.start` before the workers start, when no other thread
--   could take the permit;
-- * `Turkey.Entry.write`: the panic's message, written after the program's
--   entry has returned; the crash report, written from a signal handler,
--   which may call only async-signal-safe functions; and the byte
--   `signalNote` writes from one, to a pipe made non-blocking;
-- * `Turkey.Entry.pthreadJoin`: C's main thread waiting for the thread the
--   program runs on, and running no Turkey code until it ends;
-- * `Turkey.Output.write`: `final`, which writes out the standard output after
--   the program's entry has returned; `drain`, while the program runs, goes
--   through `blockingWrite`;
-- * `Turkey.Heap.write`: the collector's diagnostics on the standard error,
--   which a run asks for (`TURKEY_GC_STATS`, or an aid the program was
--   compiled without), written by the collecting thread inside a collection,
--   which cannot give up its thread, or while the globals are made, before any
--   task runs;
-- * `Turkey.HeapCheck.write`: the heap verifier's report, just before it ends
--   the process;
-- * `Turkey.Lock.osSyncWaitOnAddress`, `Turkey.Lock.osSyncWaitOnAddressWithTimeout`
--   and `Turkey.Lock.syscall`: the sleeps under the runtime's locks, its idle
--   threads and `blockingSleepOn`, each waiting for another thread of this
--   program to change a word (`syscall` is `futex`, which wakes too). A
--   caller that may sleep long is blocked first (`acquire`, `blockEnter`,
--   `callEnter`);
-- * `Turkey.Monitor.usleep`: the monitor's tick, on a thread that holds no
--   permit;
-- * `Signal.read`: the signal pipe's read end, which is non-blocking and
--   answers `EAGAIN` once empty; a task waits for it on the poller;
-- * `Turkey.Poll.flock` and `Turkey.Poll.waitpid`: only with `LOCK_NB` and
--   `WNOHANG`, which ask without waiting;
-- * `Turkey.Socket.connect`, `Turkey.Socket.accept`, `Turkey.Socket.accept4`
--   and `Turkey.Socket.send`: only on sockets made non-blocking, which answer
--   `EINPROGRESS` or `EAGAIN` rather than wait, and the caller parks the task.
--
-- This module's own inline waits are the poller's and the sleeping threads'
-- (`kevent`, `epollWait`, `Lock.wait`), each made by a thread that is blocked
-- or stopped first, or by the monitor, and `change`'s `kevent`, whose timeout
-- is zero. The
-- `eventfd` it reads and writes is non-blocking, the descriptors it closes are
-- the poller's own, and the thread-exhaustion message is written just before
-- the process ends.
--
-- **The entries.** A read from a file or a pipe, a write to one, an open of a FIFO: each can
-- wait for as long as something outside the program takes. A thread in one
-- is blocked for that time (`callEnter`), so that a collection need not wait
-- for it and the monitor may give its permit to another; every root its
-- caller holds is in a frame, since the call to these is a safepoint.
-- `foreign`, as `acquire` is, so that the frame they record is their own.
-- `Turkey.IO` calls these rather than `Turkey.Libc`'s.
--
-- Each answers in `Turkey.Sys.result`'s convention, and reads `errno` before
-- `callExit`: a thread held by a collection, or waiting for a permit, sleeps
-- in a C call of its own, which may set `errno` over the one being reported.
-- A task's thread may come back from one without a permit, which its caller
-- then gives back (`Turkey.Scheduler.afterCall`).

foreign "turkey_blocking_read" fun blockingRead(fd : Int, buf : Ptr, count : Int) -> Int {
    callEnter(Prim.frameAddress())
    let n = Sys.result(Libc.read(fd, buf, count))
    callExit()
    n
}

foreign "turkey_blocking_write" fun blockingWrite(fd : Int, buf : Ptr, count : Int) -> Int {
    callEnter(Prim.frameAddress())
    let n = Sys.result(Libc.write(fd, buf, count))
    callExit()
    n
}

foreign "turkey_blocking_pread" fun blockingPread(fd : Int, buf : Ptr, count : Int,
                                                  offset : Int) -> Int {
    callEnter(Prim.frameAddress())
    let n = Sys.result(Libc.pread(fd, buf, count, offset))
    callExit()
    n
}

foreign "turkey_blocking_pwrite" fun blockingPwrite(fd : Int, buf : Ptr, count : Int,
                                                    offset : Int) -> Int {
    callEnter(Prim.frameAddress())
    let n = Sys.result(Libc.pwrite(fd, buf, count, offset))
    callExit()
    n
}

foreign "turkey_blocking_open" fun blockingOpen(path : Ptr, flags : Int, mode : Int) -> Int {
    callEnter(Prim.frameAddress())
    let fd = Sys.cResult(Libc.open(path, flags, mode))
    callExit()
    fd
}

foreign "turkey_blocking_close" fun blockingClose(fd : Int) -> Int {
    callEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.close(fd))
    callExit()
    r
}

foreign "turkey_blocking_fstat" fun blockingFstat(fd : Int, buf : Ptr) -> Int {
    callEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.fstat(fd, buf))
    callExit()
    r
}

-- The directory calls block for as long as the file system takes, which on a
-- network file system is unbounded, and `flock` without `LOCK_NB` for as long
-- as another process holds the lock.

foreign "turkey_blocking_openat" fun blockingOpenat(dir : Int, path : Ptr, flags : Int,
                                                    mode : Int) -> Int {
    callEnter(Prim.frameAddress())
    let fd = Sys.cResult(Libc.openat(dir, path, flags, mode))
    callExit()
    fd
}

foreign "turkey_blocking_fstatat" fun blockingFstatat(dir : Int, path : Ptr, buf : Ptr,
                                                      flags : Int) -> Int {
    callEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.fstatat(dir, path, buf, flags))
    callExit()
    r
}

foreign "turkey_blocking_unlinkat" fun blockingUnlinkat(dir : Int, path : Ptr,
                                                        flags : Int) -> Int {
    callEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.unlinkat(dir, path, flags))
    callExit()
    r
}

foreign "turkey_blocking_mkdirat" fun blockingMkdirat(dir : Int, path : Ptr,
                                                      mode : Int) -> Int {
    callEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.mkdirat(dir, path, mode))
    callExit()
    r
}

foreign "turkey_blocking_renameat" fun blockingRenameat(fromDir : Int, from : Ptr,
                                                        toDir : Int, to : Ptr) -> Int {
    callEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.renameat(fromDir, from, toDir, to))
    callExit()
    r
}

foreign "turkey_blocking_readlinkat" fun blockingReadlinkat(dir : Int, path : Ptr,
                                                            buf : Ptr, size : Int) -> Int {
    callEnter(Prim.frameAddress())
    let n = Sys.result(Libc.readlinkat(dir, path, buf, size))
    callExit()
    n
}

foreign "turkey_blocking_flock" fun blockingFlock(fd : Int, operation : Int) -> Int {
    callEnter(Prim.frameAddress())
    let r = Sys.cResult(Libc.flock(fd, operation))
    callExit()
    r
}

-- `mkdtemp`, which makes a directory as `mkdirat` does: 0, or the negated
-- `errno`.
foreign "turkey_blocking_mkdtemp" fun blockingMkdtemp(template : Ptr) -> Int {
    callEnter(Prim.frameAddress())
    let made = Libc.mkdtemp(template)
    let r = if Ptr.isNull(made) { -Sys.errno() } else { 0 }
    callExit()
    r
}

-- The working directory's absolute path, in a block `getcwd` allocates and the
-- caller frees, as an `Int`, which is positive; or the negated `errno`.
-- `getcwd` may ask the file system for the path.
foreign "turkey_blocking_getcwd" fun blockingGetcwd() -> Int {
    callEnter(Prim.frameAddress())
    let path = Libc.getcwd(Ptr.null(), 0)
    let r = if Ptr.isNull(path) { -Sys.errno() } else { Ptr.toInt(path) }
    callExit()
    r
}

-- A directory stream over `fd`, as an `Int`, which is positive; or the
-- negated `errno`. `fdopendir` asks the file system about the descriptor
-- (`fstat`, and on Darwin `fstatfs`), as `blockingFstat` does.
foreign "turkey_blocking_fdopendir" fun blockingFdopendir(fd : Int) -> Int {
    callEnter(Prim.frameAddress())
    let stream = Libc.fdopendir(fd)
    let r = if Ptr.isNull(stream) { -Sys.errno() } else { Ptr.toInt(stream) }
    callExit()
    r
}

-- The next entry's address as an `Int`, which is positive; 0 at the end of
-- the stream; or the negated `errno`.
foreign "turkey_blocking_readdir" fun blockingReaddir(stream : Ptr) -> Int {
    callEnter(Prim.frameAddress())
    Sys.clearErrno()
    let entry = Libc.readdir(stream)
    let r = if Ptr.isNull(entry) { -Sys.errno() } else { Ptr.toInt(entry) }
    callExit()
    r
}

-- `getaddrinfo` for `node`, with no service, which waits as long as the
-- slowest name server it asks: the list is stored at word 0 of `out`, and,
-- when the answer is `EAI_SYSTEM`, `errno` at word 8. The answer is the C
-- `int` code, sign-extended: 0, or an `EAI_*` code (`Turkey.Sys`).
foreign "turkey_blocking_getaddrinfo" fun blockingGetaddrinfo(node : Ptr, hints : Ptr,
                                                              out : Ptr) -> Int {
    callEnter(Prim.frameAddress())
    let code = Sys.cInt(Libc.getaddrinfo(node, Ptr.null(), hints, out))
    if code == Sys.eaiSystem() { Ptr.store(out, 8, Sys.errno()) }
    callExit()
    code
}

-- `posix_spawnp`, which searches `PATH` and returns only once the program is
-- loaded from its file system: on Linux, once the child has called `exec`.
-- The answer is its C `int` error number, sign-extended: 0, or an `errno`
-- value.
foreign "turkey_blocking_spawnp" fun blockingSpawnp(pid : Ptr, file : Ptr,
                                                    actions : Ptr, attributes : Ptr,
                                                    argv : Ptr, envp : Ptr) -> Int {
    callEnter(Prim.frameAddress())
    let failure = Sys.cInt(Libc.posixSpawnp(pid, file, actions, attributes, argv, envp))
    callExit()
    failure
}

-- Sleep while the word at `word` holds `value`, for at most `nanoseconds`,
-- or without limit when it is negative, as a blocking call: so the program's
-- own stack can wait for a task without running it, while the monitor hands
-- its permit to a thread that does (`Turkey.Detach`). Returns early as
-- `Turkey.Lock.wait` does.
foreign "turkey_blocking_sleep_on" fun blockingSleepOn(word : Ptr, value : Int,
                                                       nanoseconds : Int) -> Unit {
    callEnter(Prim.frameAddress())
    if nanoseconds < 0 { Lock.wait(word, value) } else { Lock.waitFor(word, value, nanoseconds) }
    callExit()
}

-- A worker thread's Turkey code has returned, which it does only when a panic
-- or an exit unwound it: hand the panic to the main worker, whose code ends
-- the program with it, as a panic in a task on the main worker does. The
-- flag is word 0 of a record, and the message bytes 24 to 272.
foreign "turkey_worker_ended" fun ended() -> Unit {
    let mine = Process.workerRecord()
    if Ptr.load(mine, 0) == 0 { return {} }
    -- Down first: every call below returns to a test of it.
    Ptr.store(mine, 0, 0)
    let first = recordOf(0)
    -- The message before the flag, which the main worker may act on at once.
    -- One that is unwinding already keeps its own.
    if Ptr.atomicLoad(first, 0) != 0 { return {} }
    for var at = 24; at < 272; at = plus(at, 8) {
        Ptr.store(first, at, Ptr.load(mine, at) : Int)
    }
    let _ = Ptr.atomicCas(first, 0, 0, 1)
    -- The main worker may be asleep waiting for work, and sees the flag only
    -- once it runs again.
    signalWork(True)
}

fun plus(a : Int, b : Int) -> Int = Int.addWrapping(a, b)
