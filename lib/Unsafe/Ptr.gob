module Unsafe.Ptr (
    Ptr, alloc, free,
    add, diff, null, isNull, toInt, fromInt,
    Load, load, Store, store,
    toCString, fromCString,
    raw, wrap,
)

-- Raw memory.
--
-- The module's name is the point: its subject is "the collector does not know
-- about this", so the name appears in the import list of every module that
-- touches raw memory, the way Oberon's `SYSTEM` and Modula-3's unsafe modules
-- do. It is a label, not a check.
--
-- `Ptr` is a newtype over `Prim.Ptr` and erases to it, so the wrapper costs
-- nothing at run time. `Prim.Ptr` itself is spellable only from `lib/`.
--
-- `alloc` and `free` are `malloc` and `free`, declared in `Unsafe.Libc`.

import Prelude ()
import Std.Classes
import Data.Array as Array
import Data.Bool.Type (Bool(..))
import Data.Byte as Byte
import Data.Option.Type (Option(..))
import Data.String as String
import Unsafe.Libc as Libc

type Ptr = Ptr(Prim.Ptr)

-- `size` bytes of uninitialized memory, or a null pointer if the allocation
-- failed. The contents are undefined -- not zero -- and reading before writing
-- is undefined behaviour rather than a panic.
fun alloc(size : Int) -> Ptr = Ptr(Libc.malloc(size))

-- Freeing a pointer this module did not answer, or one already freed, is
-- undefined behaviour. Freeing a null pointer does nothing.
fun free(p : Ptr) = match p { Ptr(address) -> Libc.free(address) }

-- -- arithmetic ------------------------------------------------------------------------

-- `p` advanced by `offset` *bytes*. Wrapping and unchecked: it is defined for
-- any offset, and dereferencing the result is what is undefined if the offset
-- left the block.
fun add(p : Ptr, offset : Int) -> Ptr = match p { Ptr(raw) -> Ptr(Prim.ptrAdd(raw, offset)) }

-- The number of bytes from `b` to `a`. Meaningful only when both point into
-- the same block; across blocks the answer is a number and nothing more.
fun diff(a : Ptr, b : Ptr) -> Int = match (a, b) {
    (Ptr(x), Ptr(y)) -> Prim.ptrDiff(x, y)
}

fun null() -> Ptr = Ptr(Prim.ptrNull())

fun isNull(p : Ptr) -> Bool = match p { Ptr(raw) -> Prim.ptrIsNull(raw) }

-- The address as an integer. The value is *unspecified* beyond round-tripping
-- through `fromInt`, so a program that prints one prints something neither
-- host promises. It is here for alignment tests and for hashing.
fun toInt(p : Ptr) -> Int = match p { Ptr(raw) -> Prim.ptrToInt(raw) }

-- No provenance is carried and none is checked. Dereferencing an address that
-- did not come from `alloc` is undefined behaviour.
fun fromInt(n : Int) -> Ptr = Ptr(Prim.ptrFromInt(n))

instance Eq Ptr {
    fun eq(Ptr(x), Ptr(y)) = Prim.ptrEq(x, y)
}

-- -- reading and writing ---------------------------------------------------------------

-- A load and a store at the representation the value's type erases to.
--
-- The floor under these is twelve names, `Prim.loadI64` and its siblings, and
-- it has to be: the low IR attaches a representation to every value when the
-- instruction is emitted, so a load whose width were known only at run time
-- would have nothing to tell the register allocator. A witness *value* cannot
-- reach down there. A witness *type* can, which is what these are.
--
-- So `load` is one name and `mono` erases the dictionary: a selection off a
-- ground dictionary becomes a top-level binding, and `opt` inlines the body,
-- which is one `Prim.` call. Nothing is built and nothing allocates, and that
-- is the ordinary case -- runtime code should use these rather than the floor.
--
-- The two exceptions, and they are the reason the `Prim.` names stay
-- reachable from `lib/`: a call site past `mono`'s specialization cap, and a
-- caller that is itself polymorphic. Both keep a dictionary, and a call
-- through one is a call to an unknown function, which a giblet module may not
-- make. Giblet code drops to the floor; everything else should not.
--
-- Dispatch is on the *result*, as `Monoid.empty` is, so a call site annotates:
-- `let n : Int = Ptr.load(p, 0)`.
--
-- Offsets are bytes. An access that leaves the block, or one at an alignment
-- the target does not allow, is undefined behaviour and is not checked.
class Load a { fun load(Ptr, Int) -> a }
class Store a { fun store(Ptr, Int, a) -> Unit }

instance Load Int { fun load(p, off) = match p { Ptr(r) -> Prim.loadI64(r, off) } }
instance Load Byte { fun load(p, off) = match p { Ptr(r) -> Prim.loadI8(r, off) } }
instance Load Char { fun load(p, off) = match p { Ptr(r) -> Prim.loadI32(r, off) } }
instance Load Float { fun load(p, off) = match p { Ptr(r) -> Prim.loadF64(r, off) } }
instance Load Bool { fun load(p, off) = match p { Ptr(r) -> Prim.loadI1(r, off) } }
instance Load Ptr { fun load(p, off) = match p { Ptr(r) -> Ptr(Prim.loadPtr(r, off)) } }

instance Store Int {
    fun store(p, off, v) = match p { Ptr(r) -> Prim.storeI64(r, off, v) }
}
instance Store Byte {
    fun store(p, off, v) = match p { Ptr(r) -> Prim.storeI8(r, off, v) }
}
instance Store Char {
    fun store(p, off, v) = match p { Ptr(r) -> Prim.storeI32(r, off, v) }
}
instance Store Float {
    fun store(p, off, v) = match p { Ptr(r) -> Prim.storeF64(r, off, v) }
}
instance Store Bool {
    fun store(p, off, v) = match p { Ptr(r) -> Prim.storeI1(r, off, v) }
}
instance Store Ptr {
    fun store(p, off, v) = match (p, v) {
        (Ptr(r), Ptr(x)) -> Prim.storePtr(r, off, x)
    }
}

-- -- crossing to a declaration --------------------------------------------------------

-- The address inside, and the wrapper around one.
--
-- A `foreign` declaration is written over `Prim.Ptr`, because the type mapping
-- is the seven types that each erase to one representation and a newtype is
-- not one of them by name. These two are the seam, and they are free: `Ptr` is
-- a newtype and erases to exactly what it wraps.
--
-- They are exported rather than kept private because that seam is the whole
-- job of an `Unsafe.` module -- the containment is the module's name being in
-- an import list, not a value being out of reach inside it.
fun raw(p : Ptr) -> Prim.Ptr = match p { Ptr(address) -> address }

fun wrap(address : Prim.Ptr) -> Ptr = Ptr(address)

-- -- C strings ------------------------------------------------------------------------

-- A `String` copied into a NUL-terminated block the caller must `free`, or
-- null if the allocation failed.
--
-- **A copy, and deliberately.** The collector does not move, so a string could
-- instead be padded with a NUL and passed in place, as OCaml does. That is
-- declined: the only NUL-terminated arguments here are paths and environment
-- names, and paying a byte on every string in the program to save a copy at a
-- handful of call sites is the wrong trade.
--
-- A `String` containing a NUL byte is truncated on the C side, and that is not
-- checked here: the block holds the whole string, and it is C's reader that
-- stops early.
fun toCString(s : String) -> Ptr {
    let bs = String.toBytes(s)
    let p = alloc(len(bs) + 1)
    if isNull(p) { return p }
    for var i = 0; i < len(bs); i = i + 1 {
        store(add(p, i), 0, bs[i])
    }
    store(add(p, len(bs)), 0, Byte.truncate(0))
    p
}

-- The bytes up to the first NUL, as a `String`, or `None` if they are not
-- well-formed UTF-8 -- the same validating boundary `String.fromBytes` is, and
-- for the same reason: a C string is bytes and a `String` is not.
--
-- Reading a pointer that is not NUL-terminated runs off the end of the block,
-- which is undefined. Reading null is not: it answers
-- `None`, because a C function that failed answers null and a caller should
-- not have to test twice.
fun fromCString(p : Ptr) -> Option String {
    if isNull(p) { return None }
    let bs = []
    var i = 0
    loop {
        let b : Byte = load(add(p, i), 0)
        if Byte.toInt(b) == 0 { break }
        Array.push(bs, b)
        i = i + 1
    }
    String.fromBytes(bs)
}
