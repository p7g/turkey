module Unsafe.Ptr (
    Ptr(..), alloc, free,
    add, diff, null, isNull, toInt, fromInt,
)

-- Raw memory (TIX-61).
--
-- The module's name is the point. `LIBRARY-DESIGN.md` makes a public root a
-- subject, and this subject is "the collector does not know about this"; the
-- name then appears in the import list of every module that touches raw
-- memory, which is the gesture Oberon makes with `SYSTEM` and Modula-3 makes
-- with an unsafe module. It is not a substitute for TIX-63's checker.
--
-- `Ptr` is a newtype over `Prim.Ptr` and erases to it, so the wrapper costs
-- nothing at run time. `Prim.Ptr` itself is spellable only from `lib/`.
--
-- `alloc` and `free` are `malloc` and `free` and are temporary: TIX-62's FFI
-- declares both directly and this pair goes with the primitives underneath.

import Prelude ()
import Std.Classes
import Data.Bool.Type (Bool(..))

type Ptr = Ptr(Prim.Ptr)

-- `size` bytes of uninitialized memory, or a null pointer if the allocation
-- failed. The contents are undefined -- not zero -- and reading before writing
-- is undefined behaviour rather than a panic.
fun alloc(size : Int) -> Ptr = Ptr(Prim.ptrAlloc(size))

-- Freeing a pointer this module did not answer, or one already freed, is
-- undefined behaviour. Freeing a null pointer does nothing.
fun free(p : Ptr) = match p { Ptr(raw) -> Prim.ptrFree(raw) }

-- -- arithmetic ------------------------------------------------------------------------

-- `p` advanced by `offset` *bytes*. Wrapping and unchecked: it is defined for
-- any offset, and dereferencing the result is what is undefined if the offset
-- left the block.
fun add(p : Ptr, offset : Int) -> Ptr = match p { Ptr(raw) -> Ptr(Prim.ptrAdd(raw, offset)) }

-- The number of bytes from `b` to `a`. Meaningful only when both point into
-- the same block; across blocks the answer is a number and nothing more.
fun diff(a : Ptr, b : Ptr) -> Int = match (a, b) {
    (Ptr(x), Ptr(y)) -> Prim.ptrDiff(x, y)
}

fun null() -> Ptr = Ptr(Prim.ptrNull())

fun isNull(p : Ptr) -> Bool = match p { Ptr(raw) -> Prim.ptrIsNull(raw) }

-- The address as an integer. The value is *unspecified* beyond round-tripping
-- through `fromInt`, so a program that prints one prints something neither
-- host promises. It is here for alignment tests and for hashing.
fun toInt(p : Ptr) -> Int = match p { Ptr(raw) -> Prim.ptrToInt(raw) }

-- No provenance is carried and none is checked. Dereferencing an address that
-- did not come from `alloc` is undefined behaviour.
fun fromInt(n : Int) -> Ptr = Ptr(Prim.ptrFromInt(n))

instance Eq Ptr {
    fun eq(a, b) = match (a, b) { (Ptr(x), Ptr(y)) -> Prim.ptrEq(x, y) }
}
