module Unsafe.Runtime (programEntry)

-- Symbols the code generator defines in every program, where Turkey has to
-- reach them.
--
-- `Unsafe.` for the reason `Unsafe.Libc` is: each line is a signature nothing
-- checks against the definition, which here is the code `Turkey.Emit` and
-- `Turkey.Llvm` write.

import Prelude ()

-- The program itself: its literals interned, its globals computed, and its
-- `main` run, with `turkey_entry_returned` last.
foreign "turkey_entry" fun programEntry() -> Unit
