module Unsafe.Runtime (argCount, argBytes, argLength)

-- The C runtime's own symbols, where Turkey has to reach them.
--
-- A seam, and a temporary one. `turkey_main` is handed the arguments before
-- any Turkey runs, so they are held in C until the entry sequence itself is
-- written in Turkey. This module is how `System.Env.args` reads them back, and
-- it disappears when that happens.
--
-- `Unsafe.` for the reason `Unsafe.Libc` is: each line is a signature nothing
-- can check against the C that defines it, and `runtime/turkey_runtime.h` is
-- the header to check it against by hand.

import Prelude ()

-- How many arguments the program was given, its own name not among them.
foreign "turkey_arg_count" fun argCount() -> Int

-- Argument `index`'s bytes, owned by the runtime for the life of the run. Not
-- NUL-terminated as far as a reader should assume -- use `argLength`.
foreign "turkey_arg_bytes" fun argBytes(index : Int) -> Prim.Ptr

foreign "turkey_arg_length" fun argLength(index : Int) -> Int
