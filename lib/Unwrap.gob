export (Unwrap(..))

import Prelude ()
import Data.Either (Either(..))
import Data.Error (Error(..))
import Data.Option (Option(..))
import Data.String (String)

--- The values postfix `!` takes apart. `e!` is the `x` of `Right(x)` when
--- `tryUnwrap(e)` returns one, and otherwise panics with the text of the
--- `Left`, at the `!`.
class Unwrap f {
	--- Returns `Right(x)` when the argument holds a value `x`, and otherwise
	--- `Left` with the text the panic at a `!` reports. Never panics itself.
	fun tryUnwrap(f a) -> Either String a
}

-- The method classifies and `!` acts, so that the panic is raised where the
-- `!` is written and the trace starts there. A method that panicked itself
-- would start the trace inside its instance, one line above the caller.

instance Unwrap Option {
	fun tryUnwrap(o) = match o {
		Some(x) -> Right(x)
		None    -> Left("unwrapped None")
	}
}

instance Unwrap (Either e) : Error e {
	fun tryUnwrap(r) = match r {
		Right(x) -> Right(x)
		Left(e)  -> Left(message(e))
	}
}
