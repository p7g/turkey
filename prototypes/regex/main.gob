import Regex as R

type Assignment = Assignment { key : String, value : String }

fun main() {
    let word = R.some(R.satisfy(fun(c) = c >= 'a' && c <= 'z'))
    let assignment = do {
        let key = R.capture(word)?
        R.literal("=")?
        let value = R.capture(word)?
        pure(R.map2(key, value, fun(k, v) = Assignment { key = k, value = v }))
    }
    let row = do {
        let result = assignment?
        R.literal(";")?
        pure(result)
    }
    match R.fullMatch(R.some(row), "hello=world;foo=bar;") {
        Some(rows) -> {
            for row in rows { print(row.key + "=" + row.value) }
        }
        None -> print("no match")
    }
    print(R.fullMatch(R.choice(R.literal("yes"), R.satisfy(fun(c) = c == 'n')), "n"))
    print(R.fullMatch(R.optional(R.literal("yes")), ""))
}
