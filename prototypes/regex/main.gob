-- Eager construction, typed capture recipes, and an ordered Thompson VM.
-- Prototype only: full matches, text captures, no ownership guarantees.

type Instruction
    = Consume(fun(Char) -> Bool)
    | Jump(Int)
    | Split(Int, Int)
    | Save(Int)

-- Falling off the code is acceptance. Targets are local instruction offsets.
type Builder a = Builder { code : Array Instruction, value : a }
type Capture a = Capture(fun(String, Array String.Index) -> a)
type Supply = Supply { next : Int }
let supply = Supply { next = 0 }

fun shifted(inst, offset) = match inst {
    Jump(pc) -> Jump(pc + offset)
    Split(a, b) -> Split(a + offset, b + offset)
    _ -> inst
}

fun appendCode(left, right) {
    let out = Array.new(len(left) + len(right))
    for inst in left { Array.push(out, inst) }
    for inst in right { Array.push(out, shifted(inst, len(left))) }
    out
}

instance Functor Builder {
    fun map(b, f) = Builder { code = b.code, value = f(b.value) }
}
instance Applicative Builder {
    fun pure(x) = Builder { code = [], value = x }
}
instance Monad Builder {
    fun bind(b, f) {
        -- The continuation runs NOW, once; matching never calls it again.
        let next = f(b.value)
        Builder { code = appendCode(b.code, next.code), value = next.value }
    }
}

instance Functor Capture {
    fun map(Capture(read), f) = Capture(fun(text, slots) = f(read(text, slots)))
}
instance Applicative Capture {
    fun pure(x) = Capture(fun(text, slots) = x)
}
-- Stand-in for adding map2 to Applicative: avoids changing the whole stdlib.
class Combining f : Applicative f {
    fun map2(f a, f b, fun(a, b) -> c) -> f c
}
instance Combining Capture {
    fun map2(Capture(left), Capture(right), f) =
        Capture(fun(text, slots) = f(left(text, slots), right(text, slots)))
}

-- Associated families turn a recipe, or a tuple of recipes, into its output.
class Resolve r {
    type Output r
    fun resolve(r, String, Array String.Index) -> Output r
}
instance Resolve (Capture a) {
    type Output = a
    fun resolve(Capture(read), text, slots) = read(text, slots)
}
instance Resolve (a, b) : Resolve a, Resolve b {
    type Output = (Output a, Output b)
    fun resolve((a, b), text, slots) =
        (resolve(a, text, slots), resolve(b, text, slots))
}
instance Resolve Unit {
    type Output = Unit
    fun resolve(value, text, slots) = ()
}

fun satisfy(predicate) = Builder { code = [Consume(predicate)], value = () }
fun literal(text) {
    let code = Array.new(0)
    for c in String.codePoints(text) {
        Array.push(code, Consume(fun(other) = other == c))
    }
    Builder { code = code, value = () }
}

-- Structural operators accept uncaptured fragments in this small prototype.
fun choice(left : Builder Unit, right : Builder Unit) -> Builder Unit {
    let code = [Split(1, len(left.code) + 2)]
    for inst in left.code { Array.push(code, shifted(inst, 1)) }
    Array.push(code, Jump(len(left.code) + len(right.code) + 2))
    for inst in right.code { Array.push(code, shifted(inst, len(left.code) + 2)) }
    Builder { code = code, value = () }
}

fun many(body : Builder Unit) -> Builder Unit {
    let code = [Split(1, len(body.code) + 2)]
    for inst in body.code { Array.push(code, shifted(inst, 1)) }
    Array.push(code, Jump(0))
    Builder { code = code, value = () }
}
fun some(body : Builder Unit) -> Builder Unit = do {
    body?
    many(body)?
    pure(())
}

fun capture(body : Builder Unit) -> Builder (Capture String) {
    let slot = supply.next
    supply.next = slot + 2
    let code = [Save(slot)]
    for inst in body.code { Array.push(code, shifted(inst, 1)) }
    Array.push(code, Save(slot + 1))
    Builder {
        code = code,
        value = Capture(fun(text, slots) = String.slice(text, slots[slot], slots[slot + 1]))
    }
}

type Thread = Thread { pc : Int, slots : Array String.Index }

fun copySlots(slots) {
    let out = Array.new(len(slots))
    for slot in slots { Array.push(out, slot) }
    out
}
fun unseen(code) {
    let seen = Array.new(len(code) + 1)
    for var i = 0; i <= len(code); i = i + 1 { Array.push(seen, False) }
    seen
}

-- Ordered epsilon closure. First arrival at a PC wins at this input position.
-- Save copies its history, so sibling threads never overwrite each other.
fun addThread(code, threads, seen, pc, slots, at) {
    if seen[pc] { return }
    seen[pc] = True
    if pc == len(code) {
        Array.push(threads, Thread { pc = pc, slots = slots })
        return
    }
    match code[pc] {
        Jump(target) -> addThread(code, threads, seen, target, slots, at)
        Split(left, right) -> {
            addThread(code, threads, seen, left, slots, at)
            addThread(code, threads, seen, right, slots, at)
        }
        Save(slot) -> {
            let updated = copySlots(slots)
            updated[slot] = at
            addThread(code, threads, seen, pc + 1, updated, at)
        }
        Consume(_) -> Array.push(threads, Thread { pc = pc, slots = slots })
    }
}

fun fullMatch[Resolve r](pattern : Builder r, text : String) -> Option (Output r) {
    let slots = Array.new(supply.next)
    for var i = 0; i < supply.next; i = i + 1 {
        Array.push(slots, String.start(text))
    }
    var current = []
    var at = String.start(text)
    addThread(pattern.code, current, unseen(pattern.code), 0, slots, at)
    loop {
        match String.step(text, at) {
            None -> break
            Some((c, next)) -> {
                let following = []
                let seen = unseen(pattern.code)
                for thread in current {
                    if thread.pc < len(pattern.code) {
                        match pattern.code[thread.pc] {
                            Consume(predicate) -> {
                                if predicate(c) {
                                    addThread(pattern.code, following, seen,
                                        thread.pc + 1, thread.slots, next)
                                }
                            }
                            _ -> ()
                        }
                    }
                }
                current = following
                at = next
            }
        }
    }
    for thread in current {
        if thread.pc == len(pattern.code) {
            return Some(resolve(pattern.value, text, thread.slots))
        }
    }
    None
}

type Assignment = Assignment { key : String, value : String }
type Counter = Counter { value : Int }
fun check(condition, label) {
    if !condition { error("FAIL: " + label) }
    print("PASS: " + label)
}

fun main() {
    let word = some(satisfy(fun(c) = c >= 'a' && c <= 'z'))
    let built = Counter { value = 0 }
    let extracted = Counter { value = 0 }
    let assignment = do {
        let key = capture(word)?
        built.value = built.value + 1
        literal("=")?
        let value = capture(word)?
        pure(map2(key, value, fun(k, v) {
            extracted.value = extracted.value + 1
            Assignment { key = k, value = v }
        }))
    }
    check(built.value == 1 && extracted.value == 0, "construction is eager; extraction is deferred")
    match fullMatch(assignment, "hello=world") {
        Some(a) -> {
            check(a.key == "hello" && a.value == "world", "typed Assignment")
            print(a.key + "=" + a.value)
        }
        None -> error("expected Assignment")
    }
    match fullMatch(assignment, "foo=bar") {
        Some(a) -> check(a.key == "foo" && a.value == "bar", "reuse constructed NFA")
        None -> error("expected second Assignment")
    }
    check(Option.isNone(fullMatch(assignment, "hello=")), "missing value fails")
    check(Option.isNone(fullMatch(assignment, "hello=world!")), "full match rejects suffix")
    check(built.value == 1 && extracted.value == 2, "matching never reruns bind; failures never extract")

    let pair = do {
        let key = capture(word)?
        literal("=")?
        let value = capture(word)?
        pure((key, value))
    }
    check(fullMatch(pair, "hello=world") == Some(("hello", "world")), "tuple associated-family result")
    let nested = map(pair, fun((key, value)) = (key, (value, key)))
    check(fullMatch(nested, "a=b") == Some(("a", ("b", "a"))), "recursive tuple resolution")

    let unicode = capture(some(satisfy(fun(c) = c != '=')))
    check(fullMatch(unicode, "hé🙂") == Some("hé🙂"), "UTF-8 capture boundaries")
    let empty = capture(many(literal("")))
    check(fullMatch(empty, "") == Some(""), "nullable repetition terminates")
    let alternatives = capture(choice(literal("a"), literal("ab")))
    check(fullMatch(alternatives, "ab") == Some("ab"), "left alternative cannot commit prematurely")

    let greedy = do {
        let first = capture(many(literal("a")))?
        let second = capture(many(literal("a")))?
        pure((first, second))
    }
    check(fullMatch(greedy, "aaa") == Some(("aaa", "")), "greedy capture priority")
    -- Later construction must not invalidate previously returned handles.
    check(fullMatch(pair, "x=y") == Some(("x", "y")), "capture handles survive later construction")

    var hard = literal("")
    for var i = 0; i < 24; i = i + 1 {
        hard = do { hard?; choice(literal("a"), literal(""))?; pure(()) }
    }
    for var i = 0; i < 24; i = i + 1 {
        hard = do { hard?; literal("a")?; pure(()) }
    }
    check(Option.isSome(fullMatch(hard, String.repeat("a", 24))), "ambiguous optional-prefix NFA")
}
