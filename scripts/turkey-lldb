#!/bin/sh
# lldb with the formatters for Turkey's values loaded (debugger/turkey_lldb.py),
# so that a program built with `turkey build -g` shows a String as its text, a
# Vec as its elements and a sum as the constructor it holds.
#
# Usage: scripts/turkey-lldb [LLDB ARGUMENTS...]
#
# Every argument goes to lldb, after the import. $LLDB names the lldb to run,
# `lldb` if it is unset.

set -eu

here=$(cd "$(dirname "$0")/.." && pwd)
exec "${LLDB:-lldb}" -O "command script import $here/debugger/turkey_lldb.py" "$@"
