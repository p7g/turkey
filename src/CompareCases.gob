-- An entry point in `src/`, beside `MarkdownCases.gob`: parses each pair of
-- files it is given with `Turkey.Parser`, compares the two trees with
-- `Turkey.Compare`, and prints a line for each pair: `same`, or `differs at
-- LINE:COL` with where the first file's tree first differs.
--
-- `tests/test_compare.py` runs it.

import Turkey.Compare as Compare
import Turkey.Parser as Parser
import Turkey.Source as Source
import Turkey.Source (Source)
import System.Env as Env

fun main() {
    let paths = Env.args()
    for var i = 0; i + 1 < len(paths); i = i + 2 {
        let a = Parser.parse(load(paths[i]), [])
        let b = Parser.parse(load(paths[i + 1]), [])
        match Compare.firstDifference(a, b) {
            Some(at) -> print("differs at " + Source.showSpan(at))
            None -> print("same")
        }
    }
}

fun load(path : String) -> Source = match Source.read(path) {
    Some(s) -> s
    None -> error("cannot read '" + path + "'")
}
