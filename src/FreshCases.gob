-- An entry point in `src/`, beside `CompareCases.gob`: makes type variables,
-- kind variables and skolems with `Turkey.Types` from many tasks at once, and
-- prints how many ids of each sort were handed out twice. Every count is 0
-- when the counters are safe to share between workers.
--
-- `tests/test_fresh_ids.py` runs it.

import Data.Set as Set
import System.Parallel as Parallel
import Turkey.Types as Ty
import Turkey.Types (Kind(..))

-- Enough tasks to keep every worker busy, each making enough cells that two
-- workers' increments interleave many times over.
let tasks = 64

let perTask = 20000

fun main() {
	let made = Parallel.map(Array.filled(tasks, ()), fun(_) = make())
	let tyvars = Set.new()
	let kinds = Set.new()
	let skolems = Set.new()
	var tyvarRepeats = 0
	var kindRepeats = 0
	var skolemRepeats = 0
	for (t, k, s) in made {
		tyvarRepeats = tyvarRepeats + added(tyvars, t)
		kindRepeats = kindRepeats + added(kinds, k)
		skolemRepeats = skolemRepeats + added(skolems, s)
	}
	print("type variables repeated: ${tyvarRepeats}")
	print("kind variables repeated: ${kindRepeats}")
	print("skolems repeated: ${skolemRepeats}")
}

-- Returns the ids of `perTask` new type variables, kind variables and
-- skolems, made in turn.
fun make() -> (Array Int, Array Int, Array Int) {
	let t = []
	let k = []
	let s = []
	for var i = 0; i < perTask; i = i + 1 {
		Vec.push(t, Ty.newVar(1, KStar).id)
		Vec.push(k, kindId(Ty.kvar()))
		Vec.push(s, Ty.skolemCon("a", KStar).uid)
	}
	(Vec.toArray(t), Vec.toArray(k), Vec.toArray(s))
}

fun kindId(k : Kind) -> Int = match k {
	KVar(cell) -> cell.id
	_          -> error("Ty.kvar made a kind that is not a variable")
}

-- Adds each of `ids` to `seen`, and returns how many were there already.
fun added(seen : Set.Set Int, ids : Array Int) -> Int {
	var repeats = 0
	for id in ids {
		if Set.contains(seen, id) { repeats = repeats + 1 } else { Set.add(seen, id) }
	}
	repeats
}
