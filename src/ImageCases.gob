-- A fourth entry point in `src/`, beside `SsaCheck.gob` and
-- `MachineCheckCases.gob`: a hand-built object put to `Turkey.Image.apply`,
-- with a loaded code section and a debug section written but not mapped,
-- printing each debug field after it is filled in.
--
-- `tests/test_image.py` runs it.

import Turkey.Asm as Asm
import Turkey.Arm64.Encode as Encode
import Turkey.Arm64.Encode (Fixup)
import Turkey.Assembler (Object(..), SectionData(..), Relocation(..), Use(..), Definition(..))
import Turkey.Image as Image

let function = Asm.symbolFor(Asm.MachO, "f")
let block = Asm.localLabel(Asm.MachO, "block")
let string = Asm.localLabel(Asm.MachO, "string")

fun main() {
    let text = section(Asm.Text, 16, [])
    -- An address of each kind of label, and a reference into the strings.
    let info = section(Asm.DebugInfo, 20, [
        Relocation { offset = 0, use = Address64, target = function },
        Relocation { offset = 8, use = Address64, target = block },
        Relocation { offset = 16, use = Offset32, target = string },
    ])
    let strings = section(Asm.DebugStr, 8, [])
    let defined = [
        Definition { symbol = function, section = 0, offset = 4, exported = False,
                     function = True },
        Definition { symbol = block, section = 0, offset = 12, exported = False,
                     function = False },
        Definition { symbol = string, section = 2, offset = 5, exported = False,
                     function = False },
    ]
    let obj : Object Fixup = Object { sections = [text, info, strings], defined = defined,
                                      undefined = [] }
    Image.apply(Encode.isa(), obj, [0x100000400, -1, -1], [1],
                fun(sym) = error("no import is expected: " + Asm.spell(sym)))
    print("function: " + Int.toString(Byte.getLE(info.bytes, 0, 8)))
    print("block: " + Int.toString(Byte.getLE(info.bytes, 8, 8)))
    print("string: " + Int.toString(Byte.getLE(info.bytes, 16, 4)))
}

fun section(kind : Asm.Section, size : Int, relocations : Vec (Relocation Fixup))
        -> SectionData Fixup {
    let bytes = []
    for var k = 0; k < size; k = k + 1 { Vec.push(bytes, Byte.truncate(0)) }
    SectionData { kind = kind, bytes = bytes, align = 0, relocations = relocations }
}
