-- Where the language's own library lives: `TURKEY_LIB` if it is set and not
-- empty, and otherwise the nearest `lib` holding `Prelude.gob` in the
-- directory of the compiler's own executable, symbolic links resolved, or in
-- a directory above it. That finds a checkout's `lib` from
-- `build/stages/stage2`, and through a symbolic link to it on `PATH`. The
-- working directory is not searched, because a `lib` in the program's own
-- project would shadow the real one.
--
-- A root found under the working directory is named relative to it. A
-- compiler run from the repository root then names library files `lib/...` in
-- diagnostics and debug information, and its output does not depend on where
-- the checkout is.
fun libRoot() -> String {
    let fix = "; set TURKEY_LIB to the 'lib' directory of a Turkey checkout"
    let root = Option.unwrapOr(Env.get("TURKEY_LIB"), "")
    if root != "" {
        if !isLibrary(root) {
            die("cannot find the standard library: TURKEY_LIB is '" + root
                + "', which has no " + landmark + fix)
        }
        return root
    }
    let executable = match Env.executablePath() {
        Some(path) -> path
        None -> die("cannot find the standard library: the path of this "
                    + "compiler's own executable is unknown" + fix)
    }
    let start = parentOf(executable)
    match libraryAbove(start) {
        Some(root) -> relativeToWorking(root)
        None -> die("cannot find the standard library: no lib/" + landmark
                    + " in '" + start + "' or a directory above it" + fix)
    }
}

-- The file whose presence makes a directory the library.
let landmark = "Prelude.gob"

fun isLibrary(root : String) -> Bool = match File.metadata(root + "/" + landmark) {
    Right(_) -> True
    Left(_) -> False
}

-- The `lib` that is a library in the absolute directory `start` or the
-- nearest directory above it.
fun libraryAbove(start : String) -> Option String {
    var directory = start
    loop {
        let candidate = if directory == "/" { "/lib" } else { directory + "/lib" }
        if isLibrary(candidate) { return Some(candidate) }
        if directory == "/" { return None }
        directory = parentOf(directory)
    }
}

-- Returns the directory holding the absolute path `path`: `/` for `/` and for
-- every entry of the root.
fun parentOf(path : String) -> String {
    -- `directoryOf` returns `""` for an entry of the root and `"."` for `""`,
    -- and a walk upward that followed them would search the working directory.
    let parent = directoryOf(path)
    if parent == "" || parent == "." { "/" } else { parent }
}

-- `path`, absolute, relative to the working directory if it lies under it.
fun relativeToWorking(path : String) -> String = match Env.currentDirectory() {
    Some(working) -> {
        let prefix = if working == "/" { "/" } else { working + "/" }
        Option.unwrapOr(String.stripPrefix(path, prefix), path)
    }
    None -> path
}

-- What `--target` chose, for every file of this run.
var target = Target.host()

-- And what the other flags did (`Turkey.Build`).
var build = Build.plain

-- `--timings`: how long each phase took, and how the backend's time is spread
-- over functions, on stderr. What a decision about parallel or incremental
-- compilation needs to know first: which phases are worth splitting, and
-- whether the work in them is even enough to split.
var timings = False

-- How much debug information `build` writes (`Debug`). The code is the
-- same at every level; only the items `Turkey.Emit` and `Turkey.Dwarf` add,
-- none of which has a byte in the code, tell the builds apart.
var debug = NoDebug

-- What `--debug` and `-g` ask for: nothing; the line table, each function's
-- name and range, and the calls inlined into it (`--debug=lines`), which is
-- what a profiler and a backtrace need; or that and each function's
-- variables, with their locations and types (`-g`, `--debug=full`), which is
-- what a debugger needs to show values.
type Debug = NoDebug | Lines | Full

-- Whether `build` writes any debug information.
fun debugInfo() -> Bool = match debug {
    NoDebug -> False
    _ -> True
}

-- Whether it writes the variables, with their locations and types.
fun debugVariables() -> Bool = match debug {
    Full -> True
    _ -> False
}

fun debugNamed(level : String) -> Debug = match level {
    "lines" -> Lines
    "full" -> Full
    _ -> die("unknown debug level '" + level + "'; the levels are lines and full")
}

-- A stopwatch started now, after reporting `phase` as having run since
-- `since` was started.
fun lap(phase : String, since : Stopwatch.Stopwatch) -> Stopwatch.Stopwatch {
    if timings {
        toStderr("time\t" + phase + "\t" + millis(Stopwatch.elapsed(since)) + "\n")
    }
    Stopwatch.start()
}

fun millis(d : Duration) -> String {
    let tenths = Duration.toNanos(d) / 100000
    Int.toString(tenths / 10) + "." + Int.toString(tenths % 10) + "ms"
}

-- What `--dump` can name, in the order the stages run. Its position is how far
-- a compile has to go to print it.
let stages = ["decls", "classes", "types", "core", "mono", "opt", "ssa",
              "select", "listing", "positions"]

-- Where `check` stops when no dump asks for more: lowering to Core, the last
-- stage that can reject a program. Everything after it reports only internal
-- errors, so whoever gives a later stage a diagnostic a program can earn has
-- to move this.
let checkedThrough = "core"

-- What `build` writes: assembly, a relocatable object for the system
-- linker, or an executable, with the linker's work done here as well.
type Format = Executable | Object | Assembly

-- Where the output goes: standard output, a file open for it, or an
-- executable's path, written whole once its bytes are complete
-- (`writeExecutable`).
type Destination = ToStdout | ToFile(File.File File.WriteOnly) | ToExecutable(String)

-- What `build` writes, and where. `name` is what the program is called: the
-- entry file's name without its extension, whatever the output's.
type Sink = Sink { to : Destination, format : Format, name : String }

fun main() {
    let p = Args.parser(Env.args())
    let building = match Args.next(p) {
        Right(Some(Value("check"))) -> False
        Right(Some(Value("build"))) -> True
        Right(Some(Value("doc"))) -> return doc(p)
        Right(Some(Value(other))) -> die("unknown command '" + other
                                         + "'; the commands are 'check', "
                                         + "'build' and 'doc'")
        _ -> usage()
    }
    var output = None
    var format = None
    let dumps = Set.new()
    let paths = []
    loop {
        match Args.next(p) {
            Left(message) -> die(message)
            Right(None) -> break
            Right(Some(arg)) -> match arg {
                Short('o') -> { output = Some(valueOf(p)) }
                Short('f') -> { format = Some(formatNamed(valueOf(p))) }
                Short('g') -> { debug = Full }
                Long("debug") -> { debug = debugNamed(valueOf(p)) }
                Long("target") -> {
                    let name = valueOf(p)
                    target = match Target.named(name) {
                        Some(t) -> t
                        None -> die("unknown target '" + name + "'; supported: "
                                    + Target.spellings())
                    }
                }
                Long("timings") -> {
                    timings = True
                    Opt.measure(True)
                }
                Long("dump") -> for stage in String.split(valueOf(p), ",") {
                    if !Array.contains(stages, stage) {
                        die("cannot dump '" + stage + "'; the stages are "
                            + String.join(stages, ", "))
                    }
                    Set.add(dumps, stage)
                }
                Long(name) -> match Build.flag(build, "--" + name) {
                    Some(b) -> { build = b }
                    None -> die(Args.unexpected(arg))
                }
                Value(path) -> Vec.push(paths, path)
                Short(_) -> die(Args.unexpected(arg))
            }
        }
    }
    if len(paths) == 0 { usage() }
    let sink = if building {
        Some(openSink(output, format, paths, len(Set.elements(dumps)) > 0))
    } else {
        match (output, format) {
            (None, None) -> None
            _ -> die("'boot check' writes no output, so it takes no -o or "
                     + "-f; use 'boot build' to write one")
        }
    }
    -- One builder for every file, which the dumps are pushed to line by line
    -- and written from in one piece after each stage.
    let b = String.builder()
    let listing = Encode.newListing()
    for path in paths {
        Diag.compiling(path)
        compile(b, path, dumps, listing, sink)
    }
    write(String.build(b))
    if let Some(Sink { to = ToFile(out), .. }) = sink {
        if let Left(e) = File.close(out) { die(message(e)) }
    }
}

fun valueOf(p : Args.Parser) -> String = match Args.value(p) {
    Left(message) -> die(message)
    Right(v) -> v
}

fun formatNamed(name : String) -> Format = match name {
    "exe" -> Executable
    "obj" -> Object
    "asm" -> Assembly
    _ -> die("unknown format '" + name + "'; the formats are exe, obj, asm")
}

-- The format a file name asks for. An executable has no extension on the
-- systems this targets, so a name without one is an executable, and a name
-- with one this does not know is refused rather than taken for an executable:
-- `-o prog.S` silently writing a binary is the mistake this rule is for.
fun formatOf(path : String) -> Format {
    let parts = String.split(path, "/")
    match String.rsplitOnce(parts[len(parts) - 1], ".") {
        None -> Executable
        Some((_, "s")) -> Assembly
        Some((_, "o")) -> Object
        Some((_, ext)) -> die("cannot tell what to write from the extension '."
                              + ext + "'; name the file .s or .o, or say which "
                              + "with -f")
    }
}

-- Where `build` writes, refused here if it is something this cannot write,
-- before any compiling is spent on it. With no `-f`, the format is the one
-- `-o` names by its extension, or an executable. With no `-o`, an executable
-- goes to the working directory, named after the entry file without its
-- extension, and assembly or an object to standard output.
fun openSink(output : Option String, format : Option Format, paths : Vec String,
             dumping : Bool) -> Sink {
    let chosen = match (format, output) {
        (Some(f), _) -> f
        (None, None) | (None, Some("-")) -> Executable
        (None, Some(path)) -> formatOf(path)
    }
    let one = match chosen {
        Object -> Some("object")
        Executable -> Some("executable")
        Assembly -> None
    }
    if let Some(what) = one {
        if len(paths) > 1 {
            die(Int.toString(len(paths)) + " input files cannot be written as "
                + "one " + what + "; build each file separately")
        }
    }
    let base = baseName(paths[0])
    let name = match String.rsplitOnce(base, ".") {
        Some((stem, _)) -> stem
        None -> base
    }
    let to = match (output, chosen) {
        (None, Executable) -> {
            -- An entry file without an extension has the executable's name,
            -- and in the working directory it is the executable's path.
            if name == base {
                die("cannot name the executable after '" + base + "', which "
                    + "has no extension to drop; name it with -o PATH")
            }
            if name == "" {
                die("cannot name the executable after '" + base + "', which "
                    + "has nothing before its extension; name it with -o PATH")
            }
            ToExecutable(executablePath(name, "./" + name))
        }
        (None, _) | (Some("-"), _) -> {
            -- Dumps go to standard output too, and two things in one stream
            -- can be told apart only by parsing both.
            if dumping {
                die("--dump and the build would both write to standard "
                    + "output; write the build to a file with -o PATH")
            }
            ToStdout
        }
        (Some(path), _) -> {
            if len(paths) > 1 {
                die("-o '" + path + "' can take only one input file, and "
                    + Int.toString(len(paths)) + " were given; build each "
                    + "file separately, or write to standard output with -o -")
            }
            match chosen {
                Executable -> ToExecutable(executablePath(path, path))
                Object | Assembly -> match File.create(path, File.Truncate) {
                    Right(out) -> ToFile(out)
                    Left(e) -> die(message(e))
                }
            }
        }
    }
    Sink { to = to, format = chosen, name = name }
}

-- Returns `path`, refusing it if it names a directory. `writeExecutable`
-- renames over `path` only once the program is compiled, so without this a
-- directory would be found only after all of that work. `shown` is `path` as
-- the diagnostic names it.
fun executablePath(path : String, shown : String) -> String = match File.metadata(path) {
    Right(File.Stat { kind = File.Directory, .. }) ->
        die("cannot write the executable to '" + shown + "', which is a "
            + "directory; name a file with -o PATH")
    _ -> path
}

-- The last component of `path`.
fun baseName(path : String) -> String {
    let parts = String.split(path, "/")
    parts[len(parts) - 1]
}

-- `boot doc [--html DIR] FILE...`: checks the modules the files hold, as one
-- program, and writes what each exports: as one JSON document on standard
-- output, or with `--html` as the files of a website in `DIR`, the JSON
-- among them, creating `DIR` if it is not there.
--
-- A file under the library is the module its path from the library names,
-- and any other file the module its name names beside it, so the files
-- outside the library must share a directory. The program is an entry that
-- imports each module and nothing else, so a library module, which cannot be
-- an entry itself, is checked as it is when a program imports it.
fun doc(p : Args.Parser) -> Unit {
    let paths = []
    var site = None
    loop {
        match Args.next(p) {
            Left(message) -> die(message)
            Right(None) -> break
            Right(Some(Long("html"))) -> { site = Some(valueOf(p)) }
            Right(Some(Value(path))) -> Vec.push(paths, path)
            Right(Some(arg)) -> die(Args.unexpected(arg))
        }
    }
    if len(paths) == 0 { usage() }
    let library = realPath(libRoot())
    -- The directory every file outside the library is in: as the first such
    -- argument spells it, which is how the files' diagnostics will name it,
    -- and as a real path, to compare the others with.
    var directory = None
    let names = []
    for path in paths {
        if let Left(e) = File.metadata(path) { die(message(e)) }
        let (root, name) = moduleNamed(path, library)
        if root != library {
            match directory {
                Some((spelled, d)) -> if d != root {
                    die("'" + path + "' is not in '" + spelled + "', where the "
                        + "other modules outside the library are; document "
                        + "each directory separately")
                }
                None -> { directory = Some((directoryOf(path), root)) }
            }
        } else if String.startsWith(name, "Turkey.") {
            die("'" + path + "' is part of the library's implementation, which "
                + "no program can import, so it has no documentation")
        }
        Vec.push(names, name)
    }
    let imports = String.builder()
    for name in names {
        -- The entry has the Prelude already, and an empty import of it would
        -- opt out of it instead.
        if name != Prelude.preludeName { String.push(imports, "import " + name + " ()\n") }
    }
    -- The entry's directory is the first place an import is looked for, so
    -- with no file outside the library it is one that does not exist, and
    -- nothing in the working directory can stand in for a library module.
    -- The entry cannot be in the library itself: a module is the library's
    -- only when it is found in the last place looked.
    let entry = match directory {
        Some((spelled, _)) -> spelled + "/doc-entry.gob"
        None -> libRoot() + "/.doc/doc-entry.gob"
    }
    Diag.compiling(entry)
    let source = Source { name = entry, text = String.build(imports) }
    let (checked, _, groups) = checkSource(source)
    let modules = []
    for group in groups {
        for m in group {
            if Vec.contains(names, m.name) { Vec.push(modules, m) }
        }
    }
    let tables = Doc.Tables {
        classes = checked.classes,
        scheme = fun(name) = Option.map(Constraints.lookup_(checked.env, name),
                                        fun(b) = reduced(checked.classes, b.scheme)),
    }
    let docs = Doc.describe(modules, tables)
    match site {
        Some(dir) -> writeSite(dir, DocSite.site(docs))
        None -> write(Doc.document(docs))
    }
}

-- Writes each of `files`, a path relative to `dir` and its contents, under
-- `dir`, creating `dir` first if it is not there.
fun writeSite(dir : String, files : Vec (String, String)) -> Unit {
    if let Left(e) = File.createDirAll(dir) { die(message(e)) }
    for (path, text) in files {
        if let Left(e) = File.writeText(dir + "/" + path, text) { die(message(e)) }
    }
}

-- The search root `path` is under, as a real path, and the module it holds
-- there. `library` is the library's root, as a real path. A file whose real
-- path is under it is the library module its path below the root names; any
-- other is a module named by its file. Refuses a path no import could name.
fun moduleNamed(path : String, library : String) -> (String, String) {
    let full = realPath(path)
    let (root, relative) = match String.stripPrefix(full, library + "/") {
        Some(rest) -> (library, rest)
        None -> (directoryOf(full), baseName(full))
    }
    let stem = match String.stripSuffix(relative, ".gob") {
        Some(s) -> s
        None -> die("'" + path + "' is not a module; a module's file ends in .gob")
    }
    let parts = String.split(stem, "/")
    for part in parts {
        if !isModuleName(part) {
            die("'" + path + "' cannot be imported: '" + part + "' is not a "
                + "module name, which starts with a capital letter and holds "
                + "only letters, digits, '_' and \"'\"")
        }
    }
    (root, String.join(parts, "."))
}

fun isModuleName(part : String) -> Bool {
    var first = True
    for c in String.codePoints(part) {
        let ok = if first { Char.isAsciiUpper(c) }
                 else { Char.isAsciiAlphanumeric(c) || c == '_' || c == '\'' }
        if !ok { return False }
        first = False
    }
    !first
}

-- `path` as an absolute path with every symbolic link resolved, so that two
-- spellings of one file compare equal.
fun realPath(path : String) -> String = match Env.resolvedPath(path) {
    Some(real) -> real
    None -> die("cannot resolve '" + path + "' to a real path")
}

-- Writes `bytes` as an executable at `path`, through a new file beside it
-- that is renamed over `path` once every byte is in. So `path` is never
-- half written, a build that fails before this leaves it as it was, and the
-- executable is a new file rather than the old one rewritten: macOS keeps
-- the code signature of a file it has run, and kills a process started from
-- that file once its bytes change in place.
fun writeExecutable(path : String, bytes : IO.Buffer) -> Unit {
    let stem = match String.rsplitOnce(path, "/") {
        Some((directory, base)) -> directory + "/." + base + ".partial"
        None -> "." + path + ".partial"
    }
    let (partial, out) = createPartial(stem, 0)
    let failed = fun(e) {
        let _ = File.removeFile(partial)
        die(message(e))
    }
    if let Left(e) = IO.writeFrom(out, bytes) {
        let _ = File.close(out)
        failed(e)
    }
    if let Left(e) = File.close(out) { failed(e) }
    if let Left(e) = File.rename(partial, path) { failed(e) }
}

-- Returns the first of `stem` followed by `n`, `n + 1`, ... that names
-- nothing yet, made exclusively, and the file open. The exclusive create is
-- what gives each build of one output a file of its own: one never writes
-- into, removes or renames another's. A build killed while writing leaves
-- its file, which only moves the next build to a later number.
fun createPartial(stem : String, n : Int) -> (String, File.File File.WriteOnly) {
    let candidate = stem + Int.toString(n)
    match File.createExecutable(candidate, File.Exclusive) {
        Right(out) -> (candidate, out)
        Left(e) -> match e.kind {
            IO.AlreadyExists -> createPartial(stem, n + 1)
            _ -> die(message(e))
        }
    }
}

-- Each stage, and the dumps of it that were asked for, as far as this
-- compile has to go: to the code if there is a sink to write it to, and
-- otherwise to the latest stage dumped or `checkedThrough`, whichever is
-- later. Dumps are written out as each stage finishes, so a stage that
-- refuses the program still leaves what came before it to look at.
fun compile(b : String.Builder, path : String, dumps : Set.Set String,
            listing : Encode.Listing, sink : Option Sink) -> Unit {
    let wants = Set.contains(dumps, _)
    var reach = position(checkedThrough)
    for stage in Set.elements(dumps) {
        if position(stage) > reach { reach = position(stage) }
    }
    if let Some(_) = sink { reach = len(stages) }
    let through = fun(stage) = reach <= position(stage)
    if wants("decls") { dumpDecls(b, path) }
    if wants("classes") { dumpClasses(b, path) }
    write(String.drain(b))
    var at = Stopwatch.start()
    let (checked, entry) = checkProgram(path)
    at = lap("check", at)
    if wants("types") { dumpTypes(b, checked, entry) }
    let program = lowered(checked)
    at = lap("lower", at)
    if wants("core") { String.push(b, Core.showProgram(program, Some(entry.name), slotNames(checked))) }
    write(String.drain(b))
    if through("core") { return }
    let main = Map.getOr(entry.scope.values, "main", "main")
    let specialized = monomorphized(checked, main, program)
    at = lap("mono", at)
    if wants("mono") { dumpMono(b, checked, entry, specialized) }
    if through("mono") { return }
    let optimized = optimize(checked, main, specialized)
    at = lap("opt", at)
    if wants("opt") { String.push(b, Core.showProgram(optimized, Some(entry.name), slotNames(checked))) }
    write(String.drain(b))
    if through("opt") { return }
    let files = Position.files(checked.files)
    let (module_, skipped) = lowerModule(optimized, checked.decls, checked.classes, files,
                                         path)
    at = lap("ssa", at)
    if wants("ssa") { dumpSsa(b, module_, skipped) }
    write(String.drain(b))
    if through("ssa") { return }
    refuseSkipped(skipped, path)
    if wants("select") { dumpSelect(b, path, module_) }
    write(String.drain(b))
    if through("select") { return }
    -- With `-g`, the types of the variables, as they are named. Nothing
    -- asks for a type without it, so the tags are not worked out.
    let tags = if debugVariables() {
        SsaLower.tagsOf(checked.decls, Map.keys(checked.classes.classes))
    } else {
        Map.new()
    }
    let types = DebugTypes.new(checked.decls, tags)
    -- The listing and the assembly come from one emission, each consumer
    -- with its own text, since the program's text is too large to emit twice.
    let outs = []
    if wants("listing") {
        Vec.push(outs, Out { text = b, sink = Some(ToStdout), apart = False,
                               render = fun(d, code, t) { Encode.listing(listing, code, t) } })
    }
    let coverage = newCoverage()
    if wants("positions") {
        Vec.push(outs, Out { text = b, sink = Some(ToStdout), apart = False,
                               render = fun(d, code, t) {
                                   showPositions(d, files, coverage, code, t)
                               } })
    }
    match sink {
        Some(Sink { to, format = Assembly, .. }) -> {
            Vec.push(outs, Out { text = String.builder(), sink = Some(to), apart = True,
                                   render = Stream.print })
            let _ = emitModule(path, entry, module_, files, types, outs)
        }
        Some(Sink { to, format, name }) -> {
            let assembler = Assembler.new(Encode.isa(), Asm.dialectFor(target))
            Vec.push(outs, Out { text = String.builder(), sink = None, apart = False,
                                   render = fun(d, code, t) { Assembler.feed(assembler, code) } })
            let refused = emitModule(path, entry, module_, files, types, outs)
            -- A function that is not there is a link error at best, and no
            -- error at all if its callers were refused too.
            if len(refused) > 0 {
                Diag.fail(Diag.whole("internal error", "the backend refused:\n  "
                                     + String.join(refused, "\n  ")), path)
            }
            let started = Stopwatch.start()
            let obj = Assembler.finish(assembler)
            match format {
                Executable -> {
                    let dialect = Asm.dialectFor(target)
                    let imported = importedLibraries(checked.decls, obj.undefined, dialect)
                    let main = Asm.runtimeFor(dialect, "main")
                    sendBytes(to, match dialect {
                        Asm.MachO -> MachOExecutable.executableFile(obj, main, name,
                                                                    installNames(imported, path))
                        Asm.Elf -> ElfExecutable.executableFile(obj, main, sonames(imported))
                    })
                    let _ = lap("executable", started)
                }
                _ -> {
                    sendBytes(to, Vec.toArray(match Asm.dialectFor(target) {
                        Asm.MachO -> MachO.objectFile(obj)
                        Asm.Elf -> Elf.objectFile(obj)
                    }))
                    let _ = lap("object", started)
                }
            }
        }
        None -> { let _ = emitModule(path, entry, module_, files, types, outs) }
    }
    if wants("positions") {
        showCoverage(coverage, b)
        write(String.drain(b))
    }
}

-- -- the `positions` dump ----------------------------------------------------

-- How many instructions the `positions` dump has seen, and which had no
-- source position, by opcode and by the function they are in.
type Coverage = Coverage {
    var instructions : Int,
    var missing      : Int,
    byOpcode         : Map String Int,
    byFunction       : Map String Int,
    -- The function the instructions being read are in, or the empty string
    -- outside every function.
    var function     : String,
}

fun newCoverage() -> Coverage =
    Coverage { instructions = 0, missing = 0, byOpcode = Map.new(), byFunction = Map.new(),
               function = "" }

-- Appends `code`'s labels and instructions to `b`, each instruction with its
-- position, counts them into `coverage`, and empties `code`.
--
-- The position is printed here, beside `show`, never by it: `Show` of an
-- instruction prints no position (`Turkey.Arm64.Inst`).
fun showPositions(d : Asm.Dialect, files : Position.Files, coverage : Coverage,
                  code : Vec (Stream.Item Arm64.Inst), b : String.Builder) -> Unit {
    for item in code {
        match item {
            Stream.FunctionType(symbol) -> { coverage.function = symbol.name }
            Stream.Section(_) -> { coverage.function = "" }
            Stream.Label(symbol) -> String.push(b, Asm.spell(symbol) + ":\n")
            Stream.Instruction(i) -> {
                let text = show(i)
                String.push(b, "    " + text)
                let width = String.byteLength(text)
                if width < 40 { String.push(b, String.repeat(" ", 40 - width)) }
                String.push(b, " ; " + Position.describe(files, i.at) + "\n")
                coverage.instructions = coverage.instructions + 1
                if i.at == 0 {
                    coverage.missing = coverage.missing + 1
                    let opcode = match String.splitOnce(text, " ") {
                        Some((first, _)) -> first
                        None -> text
                    }
                    bump(coverage.byOpcode, opcode)
                    bump(coverage.byFunction,
                         if coverage.function == "" { "(outside any function)" }
                         else { coverage.function })
                }
            }
            _ -> {}
        }
    }
    Vec.clear(code)
}

fun bump(counts : Map String Int, key : String) -> Unit =
    Map.put(counts, key, Map.getOr(counts, key, 0) + 1)

-- Appends the totals to `b`: the fraction of instructions with no position,
-- then the opcodes and the functions that have most of them.
fun showCoverage(c : Coverage, b : String.Builder) -> Unit {
    let tenths = if c.instructions == 0 { 0 } else { c.missing * 1000 / c.instructions }
    String.push(b, "-- positions: " + Int.toString(c.missing) + " of "
                   + Int.toString(c.instructions) + " instructions have none ("
                   + Int.toString(tenths / 10) + "." + Int.toString(tenths % 10) + "%)\n")
    String.push(b, "-- without a position, by opcode:\n")
    showCounts(c.byOpcode, len(c.byOpcode), b)
    String.push(b, "-- without a position, by function (the 20 with most):\n")
    showCounts(c.byFunction, 20, b)
}

-- The `most` largest of `counts`, largest first and then by name.
fun showCounts(counts : Map String Int, most : Int, b : String.Builder) -> Unit {
    let sorted = Vec.sortBy(Vec.fromArray(Map.entries(counts)), fun(x, y) =
        if x.1 != y.1 { Array.threeWay(y.1, x.1) } else { Array.threeWay(x.0, y.0) })
    for var k = 0; k < len(sorted) && k < most; k = k + 1 {
        String.push(b, "--   " + Int.toString(sorted[k].1) + "\t" + sorted[k].0 + "\n")
    }
}

fun position(stage : String) -> Int = match Array.indexOf(stages, stage) {
    Some(i) -> i
    None -> error("not a stage: " + stage)
}

-- Every module of the program, loaded, resolved and desugared, in dependency
-- order. What every stage from here on starts from.
fun loadResolved(path : String) -> Vec Modules.Module {
    let (groups, _, _) = loadProgram(path)
    let modules = Vec.new(8)
    for group in groups {
        for m in group { Vec.push(modules, m) }
    }
    modules
}

-- Every module of the program, a component of modules that import each other
-- at a time, the entry among them, and the binder table resolution filled.
-- The entry is in the last component to finish loading, since a component
-- finishes after everything it imports, but saying so here beats relying on it
-- at every call site.
fun loadProgram(path : String) -> (Vec (Vec Modules.Module), Modules.Module,
                                    Binders.Table) = loadSource(readOrDie(path))

-- `loadProgram`, for an entry whose text is `source`, and whose modules are
-- looked for beside `source.name` and in the library.
fun loadSource(source : Source) -> (Vec (Vec Modules.Module), Modules.Module,
                                    Binders.Table) {
    let loader = Modules.newLoader([directoryOf(source.name), libRoot()])
    let entry = Modules.loadEntry(loader, source, "Main")
    -- An import that failed leaves its names out of scope, and resolving
    -- against that scope would report every use of them again.
    Diag.stopOnErrors()
    let operators = Resolve.operators(loader.order, Resolve.arities(loader.order))
    let binders = Binders.newTable()
    Resolve.declare(loader.order, binders)
    let checking = checkingBinders()
    for m in loader.order {
        Resolve.program(m.scope, m.program, operators, binders)
        -- Resolution goes on to every module past an error, so that all of
        -- them report. Desugaring does not: it reads what resolution
        -- recorded, and a reported error left a gap there.
        if !Diag.hasErrors() {
            Desugar.program(m.program, m.scope, binders)
            if checking { Binders.checkReferences(binders, m.program, m.file) }
        }
    }
    Diag.stopOnErrors()
    (loader.groups, entry, binders)
}

-- Whether to check that resolution and desugaring recorded a binder for every
-- binding occurrence and reference. The test suite sets
-- `TURKEY_CHECK_BINDERS` for everything it compiles. Off otherwise, because
-- each check walks the whole program, and a gap the check finds turns a valid
-- program into an internal error.
fun checkingBinders() -> Bool = match Env.get("TURKEY_CHECK_BINDERS") {
    Some(_) -> True
    None -> False
}

-- The program's declaration table, and nothing after it: every type constructor
-- with the kind inferred for it, every value constructor with the scheme it was
-- generalized to. One table for the whole program, which is what makes the
-- two-modules-claim-one-short-name rule visible at all.
fun dumpDecls(b : String.Builder, path : String) -> Unit {
    let (table, _) = registerTables(path, False)
    String.push(b, Decls.showDeclarations(table))
}

-- Everything before the first constraint is generated: types, constructors,
-- classes, their methods' schemes, their families, and the instance table. One
-- pair of tables for the whole program.
fun dumpClasses(b : String.Builder, path : String) -> Unit {
    let (_, classes) = registerTables(path, True)
    String.push(b, Classes.showClasses(classes))
}

fun registerTables(path : String,
                   withClasses : Bool) -> (Decls.DeclTable, Classes.ClassTable) {
    let table = Decls.newDeclTable()
    let classes = Classes.newClassTable(table)
    let (groups, _, _) = loadProgram(path)
    for group in groups {
        let types = Vec.new(8)
        let classDecls = Vec.new(4)
        let instDecls = Vec.new(4)
        for m in group {
            for d in m.program.decls {
                match d {
                    DType(td) -> Vec.push(types, td)
                    DClass(cd) -> Vec.push(classDecls, (cd, m.name))
                    DInstance(idl) -> Vec.push(instDecls, (idl, m.name))
                    _ -> {}
                }
            }
        }
        Decls.registerAll(table, types)
        if withClasses { Classes.registerAll(classes, classDecls, instDecls) }
        Diag.stopOnErrors()
    }
    (table, classes)
}

-- The inferred type of each of the entry module's top-level bindings.
--
-- The whole front end, end to end: load, resolve, desugar, register the
-- declarations and classes, generate a constraint per module, solve it, check
-- exhaustiveness and elaborate the evidence. What is printed is the last step's
-- input rather than its output, because a scheme is what a reader can check by
-- eye and evidence is not.
fun dumpTypes(b : String.Builder, checked : Checked, entry : Modules.Module) -> Unit {
    for (name, scheme) in signatures(entry, checked.env, checked.classes, checked.binders) {
        String.push(b, name + " : " + Ty.showScheme(scheme) + "\n")
    }
}

-- The typed Core the elaboration produces: what solving decided stops being
-- an agreement between passes and becomes a term.
--
-- The `core`, `mono` and `opt` dumps print only the entry module's part, for
-- the reason `types` prints one module's signatures -- a whole program's Core
-- is mostly the Prelude's.
--
-- The lowering, and the check that makes it evidence rather than a claim.
--
-- The check is not optional and is not a flag. Evidence that is checkable but
-- unchecked is evidence nobody has checked, so it runs the way exhaustiveness
-- does: always, on every program.
-- How a dump names a dictionary's slots, which the program holds by position.
fun slotNames(checked : Checked) -> fun(String, Int) -> String =
    fun(cls, index) = Classes.slotName(checked.classes, cls, index)

fun lowered(checked : Checked) -> Core.CProgram {
    let lowerer = Lower.newLowerer(checked.decls, checked.classes, checked.env,
                                   checked.types, target, build, checked.binders)
    let program = Lower.program(lowerer, checked.ordered)
    Coretc.checkProgram(checked.decls, checked.classes, program,
                        Coretc.globalsOf(checked.env, checked.binders))
    program
}

-- That Core with its polymorphism specialized away.
--
-- Checked again, and by the same checker: specialization rewrites every type in
-- every body it copies, so "the copy still typechecks" is the property that a
-- substitution went wrong would break first. Every copy specialization makes
-- is given binders of its own, so no id is bound twice here either.
fun monomorphized(checked : Checked, main : String,
                  program : Core.CProgram) -> Core.CProgram {
    let specialized = Mono.monomorphize(program, checked.binders, checked.decls,
                                        checked.classes, main, roots(checked))
    Coretc.checkProgram(checked.decls, checked.classes, specialized,
                        Coretc.globalsOf(checked.env, checked.binders))
    specialized
}

fun dumpMono(b : String.Builder, checked : Checked, entry : Modules.Module,
             specialized : Core.CProgram) -> Unit =
    String.push(b, Core.showProgram(specialized, Some(entry.name), slotNames(checked)))

-- And that with the optimizations applied.
--
-- The composition is load-bearing and is reproduced exactly: reduction exposes
-- local continuations for join discovery, and discovery in turn exposes
-- constructor-valued jumps for join specialization, so each pass gets one look
-- at the representation it knows how to simplify.
--
-- Checked again, and for the sharpest reason yet: join discovery decides that a
-- call is in tail position, and the checker decides the same thing
-- independently by threading a join scope. A pass that called a position a tail
-- where the rule does not emits a jump with nowhere to go, and this is where
-- that is caught.
-- Everything between the elaboration and the backend, in one place.
--
-- What `opt` prints is exactly what the backend is handed: the dump and the
-- compile both run this one function, so they cannot come to disagree about
-- the pass order.
fun optimize(checked : Checked, main : String, specialized : Core.CProgram)
        -> Core.CProgram {
    -- Each step's time, for `--timings`, under `opt.`.
    var at = Stopwatch.start()
    let first = Opt.reduceProgram(specialized, checked.decls, checked.binders)
    at = lap("opt.reduce", at)
    let discovered = Joins.discover(first)
    at = lap("opt.joins", at)
    let second = Opt.reduceProgram(discovered, checked.decls, checked.binders)
    at = lap("opt.reduce", at)
    -- Reachability again, now that the reductions have inlined calls away and
    -- folded the branches a constant decides: what only they reached is dead.
    let reduced = Mono.reachable(second, main, roots(checked), checked.decls.definitions,
                                 prunable(checked, Giblets.gibletModules(), _))
    at = lap("opt.reachable", at)
    Coretc.checkProgram(checked.decls, checked.classes, reduced,
                        Coretc.globalsOf(checked.env, checked.binders))
    at = lap("opt.check", at)
    -- Family applications reduced before the layouts are decided, since a stuck
    -- one has no representation and the backend would guess. See
    -- `Mono.reduceTypes`.
    let settled = Mono.reduceTypes(reduced, checked.classes)
    at = lap("opt.types", at)
    -- What the cap left generic, shared by layout instead of by type. This is
    -- after the optimizations rather than among them: a copy is the optimized
    -- body under another name, so there is nothing left to reduce in it.
    let out = Uncurry.program(Layout.share(settled, checked.binders, checked.decls,
                                           checked.classes, main),
                              checked.binders)
    at = lap("opt.share", at)
    Coretc.checkProgram(checked.decls, checked.classes, out,
                        Coretc.globalsOf(checked.env, checked.binders))
    at = lap("opt.check", at)
    -- After the last check, which is the last pass that reads what the
    -- coercions grant.
    let erased = Erase.program(out, checked.binders, checked.classes)
    at = lap("opt.erase", at)
    -- Every layout the backend asks for has to be knowable, and this is the
    -- program it is handed: erased, so with no coercion in it, and with the
    -- family applications the coercions decided rewritten.
    Mono.checkLayouts(erased)
    let unknown = Layout.unknownLayouts(erased, checked.decls)
    if len(unknown) > 0 {
        Diag.fail(Diag.whole("internal error", "a body reached the backend with "
            + "types whose layout it cannot know: "
            + String.join(if len(unknown) > 8 { Vec.slice(unknown, 0, 8) }
                          else { unknown }, "; ")),
            "")
    }
    let _ = lap("opt.layouts", at)
    erased
}

-- Whether reachability after the optimizer may drop a binding: one from the
-- library or the implementation (`Turkey.*`). A program's own functions stay
-- whole, for the dumps that show them and for the giblet check, which judges
-- each function a giblet module defines -- and so does a giblet module a test
-- names, which comes from the library but is the test's own program.
fun prunable(checked : Checked, giblets : Set.Set String, b : Core.CBind) -> Bool {
    let implementation = String.startsWith(b.module_, "Turkey.")
    if !implementation && !Set.contains(checked.library, b.module_) { return False }
    implementation || !Set.contains(giblets, b.module_)
}

-- What reachability starts from besides `main` (`Mono.runtimeRoots`).
fun defines(m : SsaLower.Module, name : String) -> Bool {
    for f in m.functions { if f.name == name { return True } }
    False
}

-- Whether some function switches stacks, which needs the switch's code.
fun switchesStacks(m : SsaLower.Module) -> Bool {
    for f in m.functions {
        for block in f.blocks {
            for i in block.insts {
                if let LowIr.Call(LowIr.Runtime(Rt.SwapStack), _) = i.op {
                    return True
                }
            }
        }
    }
    False
}

-- Besides the `foreign` definitions: a coroutine's start and a worker
-- thread's, which only the code `Turkey.Emit` writes calls.
fun roots(checked : Checked) -> Vec String =
    Vec.append(Mono.runtimeRoots(checked.decls, build.exportRuntime),
                 [Rt.coroutineStart, Rt.workerRun])

-- The Low IR, and the checks on it. Every path that lowers comes through here,
-- so what they refuse stops the compile whichever backend was asked for.
--
-- `Ssa.verify` owns one graph's shape, `LowIr.checkReps` each instruction's
-- representations, `LowIr.checkResults` where a call's further results are
-- read, and `LowIr.checkCalls` the agreement between graphs -- a call's arity
-- and representations against its callee's signature, which is the property
-- the signature table exists for. All four run on every compile
-- and not only under the `ssa` dump: a check that runs only when someone asks
-- to look is a check a real compile does not have.
--
-- The optimizations run first, so the checks judge what the backends will be
-- given. That includes the giblets check, deliberately: none of them adds an
-- allocation, a call or a string literal, or makes a value live anywhere a
-- value it stands for was not already live, so running them first can only
-- remove what the check objects to -- a literal on a branch proven dead, an
-- allocation nothing reads -- and cannot make acceptable code unacceptable.
fun lowerModule(program : Core.CProgram, decls : Decls.DeclTable,
                classes : Classes.ClassTable, files : Position.Files, path : String)
        -> (SsaLower.Module, Vec SsaLower.Unsupported) {
    let (module_, skipped) = SsaLower.lowerProgram(program, decls, Map.keys(classes.classes),
                                                   files, debugVariables())
    -- Each function's own, so on as many workers as there are.
    module_.functions = Parallel.map(module_.functions, fun(lowered) = {
        Fields.forward(lowered)
        var f = simplified(lowered)
        -- A comparison `Bounds` folds is removed by the clean-up, which can
        -- give a block one way in where it had two, and so facts that decide
        -- another. Each round folds a comparison and nothing makes one, so
        -- this ends.
        while Bounds.run(f) { f = simplified(f) }
        f
    })
    let complaints = []
    for found in Parallel.map(module_.functions, complaintsOf) {
        for message in found { Vec.push(complaints, message) }
    }
    for message in LowIr.checkCalls(module_.functions) {
        Vec.push(complaints, message)
    }
    if len(complaints) > 0 {
        Diag.fail(Diag.whole("internal error", "the low IR is malformed:\n  "
                             + String.join(complaints, "\n  ")), path)
    }
    Giblets.checkLowered(module_.functions, module_.definitions, path)
    -- After the giblets check, which judges the heap allocations the source
    -- asked for: whether giblet code allocates must not come to depend on this
    -- pass. It only swaps an allocation for its frame form, with the same
    -- operands and result, so the checks above hold of what it leaves.
    let giblets = Giblets.gibletModules()
    let gibletCode = Set.new()
    for f in module_.functions {
        if Giblets.isGiblet(giblets, f) { Set.add(gibletCode, f.name) }
    }
    let isGiblet = fun(name) = Set.contains(gibletCode, name)
    Escape.run(module_.functions, isGiblet)
    -- Last, and after the giblets check: a poll is a call into the runtime,
    -- which giblet code may not make and gets none of.
    let recursive = Polls.recursive(module_.functions, isGiblet)
    for f in module_.functions {
        if !isGiblet(f.name) { Polls.insert(f, Set.contains(recursive, f.name)) }
    }
    (module_, skipped)
}

-- Constant propagation, which turns a branch on a constant into a jump and
-- drops the arm it no longer takes, and the clean-up after it. Threading runs
-- after copy elimination, which makes a join's argument the value it copies,
-- so that a branch's own condition passed on is recognised as one.
fun simplified(f : Ssa.Func LowIr.Low) -> Ssa.Func LowIr.Low {
    let propagated = Sccp.run(f)
    Clean.eliminateCopies(propagated, True)
    let threaded = Threading.run(propagated)
    Clean.eliminateDead(threaded)
    Clean.mergeBlocks(threaded)
}

-- What `Ssa.verify`, `LowIr.checkReps` and `LowIr.checkResults` say of one
-- function.
fun complaintsOf(f : Ssa.Func LowIr.Low) -> Vec String {
    let out = Ssa.verify(f)
    for message in LowIr.checkResults(f) { Vec.push(out, message) }
    for block in f.blocks {
        for i in block.insts {
            for message in LowIr.checkReps(f, i) { Vec.push(out, f.name + ": " + message) }
        }
    }
    out
}

-- A binding that did not lower stops a compile that is meant to produce code.
-- Its callers would link against a symbol that is not there, so the one place
-- to say so is here, naming each binding and the form that stopped it.
--
-- A program past one of the runtime's limits is reported first, as the
-- program's error: its refusal says what to change. Any other skip is a form
-- only a compiler bug leaves unlowered. Either ends the compile, since this
-- runs after the front end, where nothing collects diagnostics.
fun refuseSkipped(skipped : Vec SsaLower.Unsupported, path : String) -> Unit {
    for u in skipped {
        if u.overLimit {
            let message = "in '" + u.name + "': " + u.what
            Diag.fail(match u.span {
                Some(s) -> Diag.at("error", message, s)
                None -> Diag.whole("error", message)
            }, path)
        }
    }
    if len(skipped) > 0 {
        let lines = Array.map(skipped, fun(u) = u.name + ": " + u.what)
        Diag.fail(Diag.whole("internal error", "bindings did not lower:\n  "
                             + String.join(lines, "\n  ")), path)
    }
}

-- What the backend makes of one selected function: its registers, its checks,
-- its frame and its code, or why it was skipped, and how long that took. The
-- code is rendered already for each consumer that renders pieces apart
-- (`Out.apart`), and left as items for the others.
type Made = Made {
    layout     : Option Frame.Layout,
    skipped    : String,
    complaints : Vec String,
    code       : Vec (Stream.Item Arm64.Inst),
    -- With `-g`, the calls inlined into it and its own variables, for its
    -- debug information, and the label its variables' locations are offsets
    -- from.
    inlined    : Vec Dwarf.Inlined,
    variables  : Vec Dwarf.Variable,
    base       : Asm.Symbol,
    -- Its calls' return addresses and positions, for the trace table.
    calls      : Vec (Asm.Symbol, Int),
    texts      : Array (Option String),
    cost       : Duration,
}

-- Selected function `i`, through the backend. It reads only what selection
-- has finished with -- `asm` is done interning, and the tables are only read
-- -- so several can run at once.
fun backendOf(asm : Asm.Asm, f : Ssa.Func Arm64.Inst, i : Int,
              lows : Map.Map String (Ssa.Func LowIr.Low),
              sigs : Map.Map String MachineCheck.Signature, outs : Vec Out) -> Made {
    let started = Stopwatch.start()
    let frame = match Map.get(lows, f.name) {
        Some(low) -> Roots.analyze(low)
        None -> Roots.Frame { slots = Map.new(), at = Map.new(), objects = [],
                             objectIndex = Map.new(), held = Map.new() }
    }
    let a = Regalloc.allocate(f, frame.slots)
    match a.stopped {
        Some(why) -> Made { layout = None, skipped = why, complaints = [], code = [],
                            inlined = [], variables = [], base = Emit.functionEnd(asm.dialect, i),
                            calls = [], texts = [], cost = Stopwatch.elapsed(started) }
        None -> {
            let complaints = MachineCheck.check(a.func, sigs)
            let l = Frame.layout(a, frame)
            let (marks, located, base) = if debugVariables() {
                Locations.locate(asm.dialect, i, a, l, frame.slots)
            } else { (Map.new(), [], Emit.functionEnd(asm.dialect, i)) }
            let emitted = []
            let calls = []
            Emit.emitFunc(asm, a.func, a, l, i, debugInfo(), marks, calls, emitted)
            let (code, inlined, variables) = if debugInfo() {
                Dwarf.inlinedCalls(asm.dialect, i, a.func.sites, located, emitted,
                                   Emit.functionEnd(asm.dialect, i))
            } else { (emitted, [], []) }
            let texts = Array.map(outs, fun(o) = if o.apart {
                let text = String.builder()
                o.render(asm.dialect, Vec.slice(code, 0, len(code)), text)
                Some(String.build(text))
            } else { None })
            Made { layout = Some(l), skipped = "", complaints = complaints, code = code,
                   inlined = inlined, variables = variables, base = base, calls = calls,
                   texts = texts,
                   cost = Stopwatch.elapsed(started) }
        }
    }
}

-- Returns the name a panic's trace prints for the function whose internal
-- name is `name`: its display form (`Demangle.displayName`) without the
-- modules before it and without the type arguments and the namers' suffixes
-- after it, so `Data.Vec#reserve@Int` is `reserve`. A trace names the file
-- and line beside it, which tell two functions of one name apart.
fun tracedName(name : String) -> String {
    let shown = String.builder()
    for c in String.codePoints(Demangle.displayName(name)) {
        if c == '[' || c == '{' || c == '~' { break }
        String.push(shown, Char.toString(c))
    }
    let parts = String.split(String.build(shown), ".")
    var from = 0
    while from + 1 < len(parts) && isModulePart(parts[from]) { from = from + 1 }
    String.join(Vec.slice(parts, from, len(parts)), ".")
}

-- Whether `part` of a display name is a module's: capitalized, and not an
-- instance's `Class(Type)`.
fun isModulePart(part : String) -> Bool {
    var first = True
    for c in String.codePoints(part) {
        if first && !Char.isAsciiUpper(c) { return False }
        if c == '(' { return False }
        first = False
    }
    !first
}

-- Each of `files` as a panic's trace names it: a library file by its path
-- below the library, and any other by its path below the directory of
-- `path`, the program's main file, when it is in it. So a trace does not
-- depend on where the library is installed or where the program was built.
fun tracedFiles(files : Position.Files, path : String) -> Array String {
    let library = libRoot() + "/"
    let directory = directoryOf(path) + "/"
    Array.map(files.names, fun(name) = match String.stripPrefix(name, library) {
        Some(below) -> below
        None -> Option.unwrapOr(String.stripPrefix(name, directory), name)
    })
}

-- One emission's consumer: what it makes of each piece of code, the text it
-- makes it into, and where that text goes.
type Out = Out {
    render : fun(Asm.Dialect, Vec (Stream.Item Arm64.Inst), String.Builder) -> Unit,
    text   : String.Builder,
    -- None for a consumer whose output is not text and is written afterwards.
    sink   : Option Destination,
    -- Whether it renders a piece of code without anything left from the last
    -- piece, so that pieces can be rendered at once and joined in order. The
    -- encoder's listing carries whether it is in the code section from one
    -- piece to the next; the assembly printer carries nothing.
    apart  : Bool,
}

-- The program as arm64 machine code, handed to each consumer a piece at a
-- time: as assembly text to `build`'s output, and as the encoder's listing to
-- the `listing` dump.
--
-- The `select` dump prints the machine IR and its measurements -- virtual
-- registers, the verifiers, the histograms -- and this the code. They are
-- separate because they answer different questions and every test of the
-- first parses its numbers.
--
-- **A whole module.** The functions, then the entry sequence, the panic
-- messages, the module's data -- globals, string literals, the permanent root
-- array -- and the frame tables. What this prints assembles *and* links: it is
-- the input `tests/test_arm64_native.py` runs the corpus from.
--
-- The order below is not incidental. A message is interned by the guard that
-- raises it, and the entry sequence interns `<globals>`, so the message table
-- is complete only once every function *and* the entry have been emitted.
--
-- Answers what the backend refused, which in assembly is only a comment.
fun emitModule(path : String, entry : Modules.Module, module_ : SsaLower.Module,
              files : Position.Files, types : DebugTypes.Types, outs : Vec Out) -> Vec String {
    let refused = []
    let note = fun(text) { for o in outs { String.push(o.text, text) } }
    -- Each consumer empties the array it is handed, so all but the last are
    -- handed a copy.
    let consume = fun(d, code) {
        for var i = 0; i < len(outs); i = i + 1 {
            let o = outs[i]
            o.render(d, if i + 1 < len(outs) { Vec.slice(code, 0, len(code)) }
                        else { code }, o.text)
        }
    }
    -- Written as it is emitted: held until the end, the program's text was
    -- millions of strings the collector kept tracing.
    let flush = fun() {
        for o in outs {
            let text = String.drain(o.text)
            if let Some(to) = o.sink { send(to, text) }
        }
    }
    note("// === " + path + "\n")
    -- A build that counts its allocations by site (`Turkey.Sites`): the table
    -- of what each site is goes to stderr.
    let sites = match Env.get("TURKEY_ALLOC_SITES") {
        Some(_) -> {
            let table = Sites.instrument(module_.functions)
            for var k = 0; k < len(table); k = k + 1 {
                toStderr("site\t" + Int.toString(k) + "\t" + table[k] + "\n")
            }
            len(table)
        }
        None -> 0
    }
    var at = Stopwatch.start()
    let (selected, unsupported, asm) =
        Select.selectModule(module_, target, build.gcVerify)
    at = lap("select", at)
    let code = []
    Vec.push(code, Stream.Architecture)
    Vec.push(code, Stream.Section(Asm.Text))
    -- With `-g`, the line table's files before any row names one, and a
    -- label at the start of the code, where the compile unit's range begins.
    let directory = Option.unwrapOr(Env.currentDirectory(), ".")
    let textStart = Asm.localLabel(asm.dialect, "text_start")
    if debugInfo() {
        Dwarf.sourceFiles(directory, path, files, code)
        Vec.push(code, Stream.Label(textStart))
    }
    consume(asm.dialect, code)
    for u in unsupported {
        Vec.push(refused, u.name + ": " + u.what)
        note("// skipped " + u.name + ": " + u.what + "\n")
    }
    let lows = Map.new()
    for low in module_.functions { Map.put(lows, low.name, low) }
    -- Each function's frame layout is kept: the frame table is one section
    -- after the code, and its entries are those layouts' safepoint maps.
    let layouts = []
    -- With `-g`, each laid-out function's inlined calls and variables, beside
    -- its layout.
    let inlinedCalls = []
    let variables = []
    let traced = []
    let sigs = MachineCheck.signatures(module_.functions, asm.dialect)
    let complaints = []
    -- Each function's time from its roots to its text, for `--timings`.
    let costs : Vec (String, Duration) = []
    -- Each function made by a task when there are workers to run them in
    -- parallel, and handed on in order as soon as it and those before it are.
    let indices = Array.init(len(selected), fun(i) = i)
    Parallel.mapInOrder(indices, fun(i) = backendOf(asm, selected[i], i, lows, sigs, outs),
                        fun(i, m) {
        match m.layout {
            None -> {
                Vec.push(refused, selected[i].name + ": " + m.skipped)
                note("// skipped " + selected[i].name + ": " + m.skipped + "\n")
            }
            Some(l) -> {
                for message in m.complaints { Vec.push(complaints, message) }
                for var o = 0; o < len(outs); o = o + 1 {
                    match m.texts[o] {
                        Some(text) -> String.push(outs[o].text, text)
                        None -> outs[o].render(asm.dialect,
                                               Vec.slice(m.code, 0, len(m.code)),
                                               outs[o].text)
                    }
                }
                flush()
                Vec.push(layouts, (i, l))
                Vec.push(inlinedCalls, m.inlined)
                Vec.push(variables, (m.variables, m.base))
                Vec.push(traced, Emit.Traced { name = selected[i].name, at = selected[i].at,
                                               sites = selected[i].sites, calls = m.calls })
            }
        }
        if timings { Vec.push(costs, (selected[i].name, m.cost)) }
    })
    at = lap("backend", at)
    if timings { reportCosts(costs) }
    -- The representations, on what was actually allocated: nothing below here
    -- has a type system, so a scalar in a pointer's register assembles, links
    -- and runs until a collection looks at it.
    if len(complaints) > 0 {
        Diag.fail(Diag.whole("internal error", "the machine code is malformed:\n  "
                             + String.join(complaints, "\n  ")), path)
    }
    -- After the code: a message is interned by the guard that raises it, so
    -- the table is only complete once every function has been emitted.
    -- The entry first: it interns the `<globals>` message, so the message
    -- table is not complete until it has run either.
    -- The entry and the stubs after it have no source position, so with `-g`
    -- one row with no line covers them all, rather than the last function's
    -- last row.
    if debugInfo() { Vec.push(code, Stream.Loc(0, False)) }
    Emit.emitEntry(asm, module_, Map.getOr(entry.scope.values, "main", "main"),
                   sites, code)
    -- Each only in a program that needs it: the switch names the runtime's
    -- record of the running stack, and the start calls a coroutine's start
    -- and then the switch.
    let coroutines = defines(module_, Rt.coroutineStart)
    if coroutines || switchesStacks(module_) {
        Emit.emitSwapStack(asm, code)
    }
    if coroutines { Emit.emitStackStart(asm, code) }
    if defines(module_, Rt.workerRun) { Emit.emitWorkerStart(asm, code) }
    Emit.emitDefinitions(module_, asm, code)
    Emit.emitMessages(asm, code)
    Emit.emitData(module_, asm, sites, code)
    Emit.emitFrameTable(asm, layouts, code)
    Emit.emitTraceTable(asm, tracedFiles(files, path), traced, tracedName, code)
    if debugInfo() {
        -- The end of the code, after everything the text section holds.
        let textEnd = Asm.localLabel(asm.dialect, "text_end")
        Vec.push(code, Stream.Section(Asm.Text))
        Vec.push(code, Stream.Label(textEnd))
        let functions = []
        for var k = 0; k < len(layouts); k = k + 1 {
            let (i, _) = layouts[k]
            let (own, base) = variables[k]
            Vec.push(functions, Dwarf.Subprogram {
                name = selected[i].name, low = Asm.symbolFor(asm.dialect, selected[i].name),
                high = Emit.functionEnd(asm.dialect, i), inlined = inlinedCalls[k],
                variables = own, base = base,
            })
        }
        Dwarf.emitUnit(asm.dialect, Dwarf.CompileUnit {
            producer = "boot", name = path, directory = directory, low = textStart,
            high = textEnd, functions = functions, types = DebugTypes.entries(types),
            typeOf = DebugTypes.typeOf(types, _),
        }, code)
    }
    consume(asm.dialect, code)
    flush()
    let _ = lap("tables", at)
    refused
}

-- How the backend's time is spread over functions: what parallelizing it
-- per function could gain is bounded by the largest one, and how evenly the
-- rest divide decides how close to that bound it gets.
fun reportCosts(costs : Vec (String, Duration)) -> Unit {
    let sorted = Vec.sortBy(costs, fun((_, a), (_, b)) = Array.threeWay(b, a))
    var total = Duration.zero
    for (_, c) in sorted { total = total + c }
    let n = len(sorted)
    -- The cost at the given rank, in thousandths from the largest.
    let rank = fun(thousandths) = if n == 0 { Duration.zero } else {
        let k = n * thousandths / 1000
        let (_, c) = sorted[if k < n { k } else { n - 1 }]
        c
    }
    toStderr("functions\t" + Int.toString(n) + "\ttotal " + millis(total)
              + "\tlargest " + millis(rank(0)) + "\tp99 " + millis(rank(10))
              + "\tp90 " + millis(rank(100)) + "\tmedian " + millis(rank(500)) + "\n")
    for var k = 0; k < n && k < 10; k = k + 1 {
        let (name, c) = sorted[k]
        toStderr("largest\t" + millis(c) + "\t" + name + "\n")
    }
}

fun send(to : Destination, text : String) -> Unit = match to {
    ToStdout -> write(text)
    ToFile(out) -> if let Left(e) = IO.writeText(out, text) { die(message(e)) }
    ToExecutable(_) -> die("internal error: an executable is written as bytes, not text")
}

fun sendBytes(to : Destination, array : Array Byte) -> Unit {
    let buffer = IO.buffer(len(array))
    IO.append(buffer, array, 0, len(array))
    match to {
        ToStdout -> {
            if let Left(_) = IO.writeFrom(IO.stdout(), buffer) {
                die("cannot write the output to standard output")
            }
            if let Left(_) = IO.flush(IO.stdout()) {
                die("cannot write the output to standard output")
            }
        }
        ToFile(out) -> if let Left(e) = IO.writeFrom(out, buffer) { die(message(e)) }
        ToExecutable(path) -> writeExecutable(path, buffer)
    }
}

-- Returns the library each of `imports` comes from, with its C symbol, by
-- the import's name, for each one declared inside a library's block. Every
-- other import comes from the C library. `dialect` is the one the imports are
-- named in.
fun importedLibraries(decls : Decls.DeclTable, imports : Vec Asm.Symbol,
                      dialect : Asm.Dialect) -> Map String (String, ForeignLibrary) {
    let declared = Map.new()
    for (_, info) in Map.entries(decls.foreigns) {
        Map.put(declared, Asm.symbolFor(dialect, info.symbol).name, info)
    }
    let out = Map.new()
    for sym in imports {
        let info = match Map.get(declared, sym.name) {
            Some(info) -> info
            None -> die("internal error: '" + sym.name + "' is called and never declared")
        }
        if let Some(library) = info.library { Map.put(out, sym.name, (info.symbol, library)) }
    }
    out
}

-- Returns the soname of each import's library, by the import's name.
fun sonames(imported : Map String (String, ForeignLibrary)) -> Map String String {
    let out = Map.new()
    for (name, (_, library)) in Map.entries(imported) {
        Map.put(out, name, Libraries.soname(library))
    }
    out
}

-- The directories searched for a Mach-O library before any other, separated
-- by colons.
let dylibPath = "TURKEY_DYLIB_PATH"

-- Returns the install name of each import's library, by the import's name,
-- read from the library's file where `Libraries.searchPath` finds it. Dies
-- naming the file and the places searched if it is not found, and if the
-- program is for another machine and `$TURKEY_DYLIB_PATH` names no directory.
fun installNames(imported : Map String (String, ForeignLibrary), path : String)
        -> Map String String {
    let out = Map.new()
    let given = Array.filter(Vec.toArray(String.split(Option.unwrapOr(Env.get(dylibPath), ""),
                                                      ":")),
                             fun(d) = d != "")
    let native = target.spelling == Target.host().spelling
    let directories = Libraries.searchPath(given, native)
    let found = Map.new()
    for (name, (symbol, library)) in Map.entries(imported) {
        let leaf = Libraries.leaf(library)
        let calls = "it calls '" + symbol + "' from library '" + library.name + "' "
                    + Int.toString(library.major)
        if !native && len(given) == 0 {
            die("cannot write '" + path + "' for " + target.spelling + " on this machine: "
                + calls + ", whose install name is read from '" + leaf + "' itself; set "
                + dylibPath + " to a directory holding a copy of it")
        }
        let installName = match Map.get(found, leaf) {
            Some(known) -> known
            None -> match Libraries.find(leaf, directories) {
                Right((file, known)) -> {
                    if !String.startsWith(known, "/") {
                        die("cannot write '" + path + "' as an executable: " + calls + ", and '"
                            + file + "' is installed as '" + known + "', which is not an "
                            + "absolute path; an executable boot writes can load a library "
                            + "only by an absolute install name")
                    }
                    Map.put(found, leaf, known)
                    known
                }
                Left(passed) -> {
                    let others = if len(passed) == 0 { "" } else {
                        " (" + String.join(Vec.map(passed, fun(p) = "'" + p + "'"), ", ")
                        + (if len(passed) == 1 { " is not an arm64 library" }
                           else { " are not arm64 libraries" }) + ")"
                    }
                    die("cannot write '" + path + "' as an executable: " + calls
                        + ", and no '" + leaf + "' is in " + Libraries.searched(given, native)
                        + others + "; install it, or set " + dylibPath
                        + " to the directory that holds it")
                }
            }
        }
        Map.put(out, name, installName)
    }
    out
}

-- The machine IR, with what selection could not translate.
--
-- Incomplete and says so: an opcode with no selection rule stops one function
-- and is counted, so the histogram at the end names what is missing. The text
-- is what the system assembler accepts, which is what makes `as` able to check
-- it.
fun dumpSelect(b : String.Builder, path : String, module_ : SsaLower.Module) -> Unit {
    String.push(b, "; === " + path + "\n")
    let (selected, unsupported, asm) =
        Select.selectModule(module_, target, build.gcVerify)
    for f in selected {
        String.push(b, Ssa.showFunc(f))
        -- The same verifier the low IR gets, on the machine graph, because
        -- `Turkey.Ssa` is parameterized over the instruction and not over the
        -- CFG. Selection now *creates* blocks -- a guard splits the one it is
        -- in -- so a terminator naming the wrong block, a value used outside
        -- the blocks its definition dominates, and a jump whose arguments do
        -- not match its target's parameters are all mistakes this pass can
        -- newly make, and all ones this catches at the pass that made them.
        for message in Ssa.verify(f) {
            String.push(b, "  !! " + message + "\n")
        }
    }
    String.push(b, "-- selected " + Int.toString(len(selected)) + " of "
                   + Int.toString(len(module_.functions)) + " functions\n")
    -- Maximum register pressure, which is the number that decides whether a
    -- spiller is needed at all: on SSA the registers required are exactly the
    -- values live at once, so a corpus that stays under the file size can be
    -- allocated by the colourer alone. Reported per program rather than per
    -- function, with any function over budget named, because one function
    -- over is the whole answer.
    var maxGp = 0
    var maxFp = 0
    var effGp = 0
    var effFp = 0
    for f in selected {
        let p = Regalloc.pressureOf(f)
        if p.gp > maxGp { maxGp = p.gp }
        if p.fp > maxFp { maxFp = p.fp }
        let e = Regalloc.effectivePressure(f)
        if e.gp > effGp { effGp = e.gp }
        if e.fp > effFp { effFp = e.fp }
        if p.gp > Regalloc.availableGp || p.fp > Regalloc.availableFp {
            String.push(b, "--   over budget  " + f.name + "  gp "
                           + Int.toString(p.gp) + "  fp "
                           + Int.toString(p.fp) + "\n")
        }
    }
    String.push(b, "-- pressure  gp " + Int.toString(maxGp) + " of "
                   + Int.toString(Regalloc.availableGp) + "  fp "
                   + Int.toString(maxFp) + " of "
                   + Int.toString(Regalloc.availableFp) + "\n")
    String.push(b, "-- effective  gp " + Int.toString(effGp) + " of "
                   + Int.toString(Regalloc.availableGp) + "  fp "
                   + Int.toString(effFp) + " of "
                   + Int.toString(Regalloc.availableFp) + "\n")
    -- Register allocation, and its own verifier. A colouring that puts two
    -- simultaneously live values in one register assembles, links and runs --
    -- and computes a wrong answer -- so it is checked here rather than
    -- trusted, exactly as the machine graph is.
    let sigs = MachineCheck.signatures(module_.functions, asm.dialect)
    var coloured = 0
    var hintTaken = 0
    var hintTotal = 0
    let colourStops = Map.new()
    -- Spilling needs each function's root slots, which `Turkey.Roots` computes
    -- from the low IR. Selection keeps the value numbering, so a slot found
    -- there names the same value here.
    let lows = Map.new()
    for low in module_.functions { Map.put(lows, low.name, low) }
    var spilled = 0
    var stores = 0
    var reloads = 0
    var rootSpills = 0
    var spillSlots = 0
    var remats = 0
    var copies = 0
    var maxRounds = 0
    var maxFrame = 0
    var maxSavedGp = 0
    var maxSavedFp = 0
    var stackArgs = 0
    var maps = 0
    for f in selected {
        let frame = match Map.get(lows, f.name) {
            Some(low) -> Roots.analyze(low)
            None -> Roots.Frame { slots = Map.new(), at = Map.new(), objects = [],
                                 objectIndex = Map.new(), held = Map.new() }
        }
        let a = Regalloc.allocate(f, frame.slots)
        if let Some(why) = a.stopped {
            Map.put(colourStops, why, Map.getOr(colourStops, why, 0) + 1)
        } else {
            coloured = coloured + 1
        }
        -- Only an allocation that finished. One that stopped has values with
        -- no register *by construction* -- that is what stopping means -- so
        -- verifying it reports hundreds of consequences of the one thing
        -- already in the histogram. Selection has the same rule: a function it
        -- could not select is not then checked for being badly selected.
        --
        -- Three checks, because spilling rewrote the function: the graph is
        -- still a graph, the colouring is still a colouring, and the spill
        -- code is where it claims to be.
        if let None = a.stopped {
            for message in Ssa.verify(a.func) {
                String.push(b, "  !! " + f.name + ": " + message + "\n")
            }
            for message in Regalloc.verifyColouring(a.func, a.colouring) {
                String.push(b, "  !! " + f.name + ": " + message + "\n")
            }
            for message in Regalloc.verifyAllocation(a) {
                String.push(b, "  !! " + f.name + ": " + message + "\n")
            }
            -- And the frame, which only means something once every value
            -- has a register or a slot.
            let l = Frame.layout(a, frame)
            for message in Frame.verifyFrame(a, frame, l) {
                String.push(b, "  !! " + f.name + ": " + message + "\n")
            }
            for message in MachineCheck.check(a.func, sigs) {
                String.push(b, "  !! " + message + "\n")
            }
            if l.size > maxFrame { maxFrame = l.size }
            if len(l.savedGp) > maxSavedGp { maxSavedGp = len(l.savedGp) }
            if len(l.savedFp) > maxSavedFp { maxSavedFp = len(l.savedFp) }
            if l.outgoing > 0 { stackArgs = stackArgs + 1 }
            maps = maps + len(l.maps)
        }
        let (got, want) = Regalloc.hintsTaken(a.func, a.colouring)
        hintTaken = hintTaken + got
        hintTotal = hintTotal + want
        for id in Map.keys(a.spills.slots) {
            spilled = spilled + 1
            if let Some(slot) = Map.get(a.spills.slots, id) {
                if Arm64.isRootSlot(slot) { rootSpills = rootSpills + 1 }
            }
        }
        stores = stores + a.spills.stores
        remats = remats + len(Map.keys(a.spills.remat))
        for (_, from) in Map.entries(a.spills.reloadOf) {
            if Map.contains(a.spills.remat, from) { copies = copies + 1 }
            else { reloads = reloads + 1 }
        }
        spillSlots = spillSlots + a.spills.spillSlots
        if a.rounds > maxRounds { maxRounds = a.rounds }
    }
    -- The two numbers that say whether a real spiller is ever needed. An
    -- untraced value has no root slot, so if those alone overflow the file a
    -- frame is required; and the worst single call site is what the ten
    -- callee-saved registers are actually spent against.
    var untraced = 0
    var worst = 0
    for f in selected {
        let u = Regalloc.untracedPressure(f)
        if u.gp > untraced { untraced = u.gp }
        let w = Regalloc.worstCall(f)
        if w > worst { worst = w }
    }
    String.push(b, "-- untraced  gp " + Int.toString(untraced) + " of "
                   + Int.toString(Regalloc.availableGp)
                   + "   worst call site  " + Int.toString(worst) + " of "
                   + Int.toString(Regalloc.calleeSavedGp) + "\n")
    String.push(b, "-- coloured " + Int.toString(coloured) + " of "
                   + Int.toString(len(selected)) + " functions\n")
    -- What spilling cost, which is the number splitting would be measured
    -- against: every reload here is one load a split live range might save.
    String.push(b, "-- spilled " + Int.toString(spilled) + " values  "
                   + Int.toString(rootSpills) + " into root slots  "
                   + Int.toString(spillSlots) + " spill slots  "
                   + Int.toString(stores) + " stores  "
                   + Int.toString(reloads) + " reloads  rounds "
                   + Int.toString(maxRounds) + "\n")
    -- The values spilled by repeating their definitions, and the repeats.
    String.push(b, "-- rematerialized " + Int.toString(remats) + " values  "
                   + Int.toString(copies) + " copies\n")
    -- The frames, and the frame tables that replace the shadow stack.
    String.push(b, "-- frames  max size " + Int.toString(maxFrame)
                   + "  saved gp " + Int.toString(maxSavedGp)
                   + " fp " + Int.toString(maxSavedFp)
                   + "  stack args in " + Int.toString(stackArgs)
                   + " functions  maps " + Int.toString(maps) + "\n")
    -- Every missed hint is one `mov` the emitter keeps at the top of a
    -- function. A miss is not a bug -- a parameter live across a call must
    -- miss, its argument register being caller-saved -- so this is the first
    -- number this backend reports that is about code quality rather than
    -- about whether the thing works at all.
    String.push(b, "-- argument hints  " + Int.toString(hintTaken) + " of "
                   + Int.toString(hintTotal) + " taken\n")
    -- A different prefix from selection's histogram on purpose. Both are
    -- "-- <count> <reason>" and a reader can tell them apart by context, but
    -- `tests/test_select.py` parses the selection one by prefix, and two
    -- histograms sharing it would silently add colouring's reasons to
    -- selection's totals -- which is a test that goes green while measuring
    -- the wrong thing.
    for why in Map.keys(colourStops) {
        String.push(b, "-- colour  " + Int.toString(Map.getOr(colourStops, why, 0))
                       + "  " + why + "\n")
    }
    -- And the tighter number: what is live *across* a call can only be in a
    -- callee-saved register, of which there are ten. Total pressure can fit in
    -- 28 and this can still not fit in 10.
    var acUg = 0
    var acTg = 0
    var acUf = 0
    var acTf = 0
    for f in selected {
        let a = Regalloc.acrossCalls(f)
        if a.untracedGp > acUg { acUg = a.untracedGp }
        if a.tracedGp > acTg { acTg = a.tracedGp }
        if a.untracedFp > acUf { acUf = a.untracedFp }
        if a.tracedFp > acTf { acTf = a.tracedFp }
    }
    String.push(b, "-- across calls  gp " + Int.toString(acUg)
                   + " untraced + " + Int.toString(acTg) + " traced of "
                   + Int.toString(Regalloc.calleeSavedGp) + "  fp "
                   + Int.toString(acUf) + " untraced + "
                   + Int.toString(acTf) + " traced of "
                   + Int.toString(Regalloc.calleeSavedFp) + "\n")
    let counts = Map.new()
    for u in unsupported {
        Map.put(counts, u.what, Map.getOr(counts, u.what, 0) + 1)
    }
    let reasons = Array.sortBy(Map.keys(counts), fun(x, y) =
        Array.threeWay(Map.getOr(counts, y, 0), Map.getOr(counts, x, 0)))
    for why in reasons {
        String.push(b, "--   " + Int.toString(Map.getOr(counts, why, 0))
                       + "  " + why + "\n")
    }
}

-- The low IR, and how much of the program reached it.
--
-- Nothing below Core is checked by comparing dumps: what a backend is checked
-- by is what the compiled program does. `Turkey.Ssa.verify` runs over
-- everything that lowered, so a malformed graph is a complaint naming the
-- function that produced it rather than a wrong answer later.
--
-- The lowering is incomplete and reports it. The count is the progress
-- signal: a Core form nothing handles yet stops one function, not the run.
fun dumpSsa(b : String.Builder, module_ : SsaLower.Module,
            skipped : Vec SsaLower.Unsupported) -> Unit {
    let functions = module_.functions
    -- The storage the initializer writes. Printed first because a function
    -- below refers to it, and because a global's *representation* is the fact
    -- a reader most often wants and the least able to derive.
    for (name, r) in module_.globals {
        String.push(b, "global $" + name + " : " + show(r) + "\n")
    }
    for f in functions {
        String.push(b, Ssa.showFunc(f))
        for message in Ssa.verify(f) {
            String.push(b, "  !! " + message + "\n")
        }
        for block in f.blocks {
            for i in block.insts {
                for message in LowIr.checkReps(f, i) {
                    String.push(b, "  !! " + message + "\n")
                }
            }
        }
    }
    -- What one function's calls require of another, which the per-function
    -- verifier cannot see. Everything closure conversion introduces crosses
    -- that boundary.
    for message in LowIr.checkCalls(functions) {
        String.push(b, "!! " + message + "\n")
    }
    -- Functions rather than bindings, since one binding may become several:
    -- a lifted lambda, an adapter and the initializer are all functions no
    -- binding named.
    String.push(b, "-- lowered " + Int.toString(len(functions))
                   + " functions, " + Int.toString(len(skipped))
                   + " skipped\n")
    -- What stopped the rest, most common first. The count says how far this
    -- has come and this says what to write next, which is the whole reason
    -- the lowering reports rather than raises.
    let counts = Map.new()
    for u in skipped {
        Map.put(counts, u.what, Map.getOr(counts, u.what, 0) + 1)
    }
    let reasons = Array.sortBy(Map.keys(counts), fun(x, y) =
        Array.threeWay(Map.getOr(counts, y, 0), Map.getOr(counts, x, 0)))
    for why in reasons {
        String.push(b, "--   " + Int.toString(Map.getOr(counts, why, 0))
                       + "  " + why + "\n")
    }
}

-- What the whole front end leaves behind.
type Checked = Checked {
    decls       : Decls.DeclTable,
    var classes : Classes.ClassTable,
    env         : Constraints.Env,
    types       : Typed.TypeTable,
    -- Every module's top-level items, in evaluation order. A binding is always
    -- initialized before anything that reads it, and the lowering keeps that
    -- order because the running program depends on it.
    ordered     : Vec Stmt,
    -- The modules that came from the shipped library.
    library     : Set.Set String,
    -- Which binder each binding occurrence and reference means.
    binders     : Binders.Table,
    -- Every module's file, in the order the modules were loaded: what a
    -- source position's file number counts.
    files       : Vec String,
}

fun checkProgram(path : String) -> (Checked, Modules.Module) {
    let (checked, entry, _) = checkSource(readOrDie(path))
    (checked, entry)
}

-- `checkProgram`, for an entry whose text is `source`, and every module of
-- the program, a component at a time.
fun checkSource(source : Source) -> (Checked, Modules.Module, Vec (Vec Modules.Module)) {
    Solved.resetDictNames()
    let (groups, entry, binders) = loadSource(source)
    Diag.stopOnErrors()
    let checked = Checked {
        decls = Decls.newDeclTable(), classes = Classes.newClassTable(
            Decls.newDeclTable()),
        env = initialEnv(binders), types = Typed.newTypeTable(),
        ordered = Vec.new(32),
        library = Set.new(), binders = binders, files = [],
    }
    checked.classes = Classes.newClassTable(checked.decls)
    -- A component of modules is checked in one run: their bindings may use
    -- each other, so they are inferred together.
    for group in groups {
        let programs = Vec.new(len(group))
        let visibleByFile = Map.new()
        for m in group {
            Vec.push(checked.files, m.file)
            if m.library { Set.add(checked.library, m.name) }
            Vec.push(programs, (m.name, m.program))
            Map.put(visibleByFile, m.file, visibleConstructors(m))
        }
        let g = Infer.newGenerator(checked.decls, checked.env, checked.classes,
                                   checked.types, binders)
        -- A constraint with no span has no module to go by, and is held to the
        -- group's first; a group of one module has no other. Made before
        -- generation, which derives the instances derive lists ask for, and
        -- a derivation's context is the solver's to simplify.
        let fallback = visibleConstructors(group[0])
        let solver = Constraints.newSolver(checked.decls, checked.env,
            checked.classes, fun(where) = match where {
                Some(sp) -> Map.getOr(visibleByFile, sp.file, fallback)
                None -> fallback
            })
        let (items, constraint) = Infer.generate(g, programs)
        -- The generator goes on past an error with a placeholder in its place,
        -- which a constraint built around it would only report against again.
        Diag.stopOnErrors()
        Infer.solve(g, solver, constraint)
        -- Exhaustiveness and evidence read the solved types, which an error
        -- has left with a harmless answer in place of the real one.
        Diag.stopOnErrors()
        Infer.checkExhaustiveness(g)
        Diag.stopOnErrors()
        Evidence.run(checked.classes, solver.uses, g.instanceChecks)
        for item in items { Vec.push(checked.ordered, item) }
    }
    if checkingBinders() { Binders.checkInferred(binders, source.name) }
    checkMain(entry, checked.env, checked.classes)
    Diag.stopOnErrors()
    Diag.stopCollecting()
    (checked, entry, groups)
}

-- The value constructors a module's scope can name, ambiguous ones included.
fun visibleConstructors(m : Modules.Module) -> Set.Set String {
    let out = Set.new()
    for (_, target) in Map.entries(m.scope.cons) { Set.add(out, target) }
    for other in Modules.reachable(m.scope) {
        for (_, target) in Map.entries(other.exports.cons) { Set.add(out, target) }
    }
    for (_, targets) in Map.entries(Modules.conflictsIn(m.scope, Modules.ConstructorSpace)) {
        for target in targets { Set.add(out, target) }
    }
    out
}

-- `main`, if the entry module defines one, is `fun() -> Unit`.
--
-- Checked on the scheme once inference is done, so a `main` that generalized is
-- refused with the type it was given. Without this a `main` returning a value
-- runs and drops it, and one taking a parameter reaches the backend and crashes
-- it -- both of which a reader is entitled to hear about as a type error.
fun checkMain(entry : Modules.Module, env : Constraints.Env,
              classes : Classes.ClassTable) -> Unit {
    for item in entry.program.decls {
        match item {
            DStmt(s) -> for name in bindingNames(s) {
                if name == Prelude.internal(entry.name, "main") {
                    if let Some(binding) = Constraints.lookup_(env, name) {
                        let scheme = reduced(classes, binding.scheme)
                        if !isEntryType(scheme) {
                            Diag.report(Diag.at("type error",
                                "'main' has type '" + Ty.showScheme(scheme)
                                + "', and the entry point must have type "
                                + "'fun() -> Unit'", s.span))
                        }
                    }
                }
            }
            _ -> {}
        }
    }
}

-- Instantiable at `fun() -> Unit` is what is asked: a `main` that only panics
-- is `forall a. fun() -> a`, and is a `main`.
fun isEntryType(scheme : Ty.Scheme) -> Bool {
    if len(scheme.preds) > 0 { return False }
    match Ty.prune(scheme.body) {
        TFun(params, ret) -> len(params) == 0 && match Ty.prune(ret) {
            TCon(c) -> c.name == "Unit"
            TVar(_) -> True
            _ -> False
        }
        _ -> False
    }
}

-- The environment every module is checked in. What a module may *write* is
-- settled by its scope one stage earlier, so this holds every primitive for
-- everybody.
fun initialEnv(binders : Binders.Table) -> Constraints.Env {
    let env = Constraints.newEnv()
    for b in Prims.all {
        let name = Prims.spelling(b)
        let id = match Binders.named(binders, name) {
            Some(id) -> id
            None -> die("internal error: the primitive '" + name + "' has no binder")
        }
        Constraints.define(env, id, name,
            Constraints.Binding { scheme = PrimTypes.spellingScheme(b),
                                  mutable = False })
    }
    env
}

-- What `types` prints: the entry module's own bindings, under the names the
-- author wrote rather than the qualified ones resolution gave them -- the module
-- a name came from is not news to the person who wrote the file.
-- A scheme with its family applications reduced at every level.
--
-- A field access has the type `Field.n r`, and once `r` is a known record that
-- family *is* the field's type. The solver reduces at the head, which is all
-- unification compares; a signature is read whole, and a monomorphic binding
-- never passes through generalization at all, so the reduction that a reader
-- needs happens here.
fun reduced(classes : Classes.ClassTable, scheme : Ty.Scheme) -> Ty.Scheme {
    let instances = Inert.empty(classes)
    let preds = Vec.new(len(scheme.preds))
    for p in scheme.preds {
        Vec.push(preds, Ty.pred(p.name,
            Array.map(p.args, Inert.rewrite(instances, _))))
    }
    let out = Ty.Scheme {
        quantified = scheme.quantified,
        body = Inert.rewrite(instances, scheme.body),
        preds = preds,
    }
    out
}

fun signatures(entry : Modules.Module, env : Constraints.Env,
               classes : Classes.ClassTable, binders : Binders.Table)
        -> Vec (String, Ty.Scheme) {
    let out = Vec.new(16)
    for item in entry.program.decls {
        match item {
            -- A method's scheme is stated by its class rather than inferred, but
            -- it is still the thing a reader wants to see, and the class
            -- variable's discovered kind shows up nowhere else.
            DClass(c) -> {
                if let Some(info) = Map.get(classes.classes, c.name) {
                    for meth in c.methods {
                        if let Some(mi) = Map.get(info.methods, meth.name) {
                            Vec.push(out, (Classes.surfaceMember(meth.name), mi.scheme))
                        }
                    }
                }
            }
            DStmt(s) -> for name in bindingNames(s) {
                if let Some(binding) = Constraints.lookup_(env, name) {
                    let written = match Binders.named(binders, name) {
                        Some(id) -> Binders.binderAt(binders, id).name
                        None -> name
                    }
                    Vec.push(out, (written, reduced(classes, binding.scheme)))
                }
            }
            _ -> {}
        }
    }
    out
}

fun bindingNames(s : Stmt) -> Vec String = match s.kind {
    SFun(d) -> [d.name]
    SLet(pat, _) -> Vec.sort(patternVars(pat))
    SVar(pat, _) -> Vec.sort(patternVars(pat))
    _ -> []
}

-- The directory a path is in, as a search root. A path with no separator is in
-- the current directory, which is what the empty prefix would mean anyway --
-- but `"" + "/" + rest` is a leading slash, so it is spelled out.
fun directoryOf(path : String) -> String {
    let parts = String.split(path, "/")
    if len(parts) < 2 { return "." }
    String.join(Vec.slice(parts, 0, len(parts) - 1), "/")
}

fun readOrDie(path : String) -> Source = match File.readText(path) {
    Right(text) -> Source { name = path, text = text }
    Left(Left(_)) -> die("'" + path + "' is not valid UTF-8")
    Left(Right(e)) -> die(message(e))
}

fun usage() -> a =
    die("usage: boot check [OPTIONS] FILE...\n"
        + "       boot doc [--html DIR] FILE...\n"
        + "       boot build [OPTIONS] [-o PATH] [-f exe|obj|asm] [-g] [--debug=lines|full]\n"
        + "                  FILE...\n"
        + "options: --target TARGET  --dump STAGE,...  --timings  --gc-verify"
        + "  --gc-stats  --export-runtime\n"
        + "stages: " + String.join(stages, ", "))

fun die(message : String) -> a {
    toStderr("boot: " + message + "\n")
    Env.exit(2)
}

fun toStderr(text : String) -> Unit { let _ = IO.writeText(IO.stderr(), text) }
