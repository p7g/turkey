module Turkey.Arm64 (
    Reg(..), Bank(..), reg, physical, isPhysical, bankOf, Cond(..), Width(..),
    Mem(..), Arm(..), Inst(..), Convention(..), Allocation(..), AllocArg(..), ArrayAllocation(..), anyDest, foldDest, anySrc, eachDest, eachSrc, mapUses, rewrite, setsFlags, isSlot, isRootSlot, isFrameAddress, slotLoad, slotStore, isCSet, csetOf, redundantMove,
    sameRegister, moveHint, safepointOf, allocationOf, arrayAllocationOf,
    writesBeforeReading, memOf,
    xzr, sp, fp, lr, x0, d0, argRegs, fpArgRegs, callerSaved, calleeSaved,
    fpCallerSaved, fpCalleeSaved, showReg, condName, invert, isCall, callClobbers,
    calleeSavedMask,
)

-- The arm64 machine instruction set.
--
-- This is the *second* instantiation of `Turkey.Ssa`'s CFG. That is the whole
-- point of the parameter: dominance, liveness, the verifier's shape checks and
-- the printer were written once over `Inst i`, and instruction selection
-- produces a different instruction type rather than rewriting the low IR in
-- place -- so after selection a virtual opcode is not *representable*, and
-- every `match` in every later pass stays exhaustive over machine
-- instructions only.
--
-- QBE and Go both put virtual and machine opcodes in one enum, and neither
-- language checks a switch for exhaustiveness. The two in the comparison that
-- do -- Haskell with Hoopl, Scheme with nanopass -- both parameterize or
-- generate. This is the parameterizing.
--
-- **Selection yields values, never text.** Assembly text is one consumer of
-- these instructions, their `Show`; a byte encoder would be a second, beside
-- it rather than instead of it, and `as` assembling the first is then an exact
-- instruction-by-instruction check on the second. Emitting strings from
-- selection would lose both.
--
-- **Registers are virtual until the allocator says otherwise.** A `Reg` is a
-- `Value` from selection and a physical register afterwards, and the two are
-- one type with a tag rather than two types, because every pass between them
-- reads both. The allocation itself is a side table -- `VCode::emit` in
-- Cranelift is immutable for the same reason -- so nothing here is rewritten
-- to record it.
--
-- **What is deliberately absent.** No addressing mode beyond a base and a
-- constant or register offset, because the low IR's memory operations are
-- `ObjectGet`, `ArrayGet` and the cell operations and none of them needs more.
-- No condition-code modelling beyond `Cmp` immediately followed by its
-- consumer, because selection emits the pair together and nothing separates
-- them. Both are places where a bigger backend would generalize and this one
-- has no instruction that would use it.

import Turkey.Asm as Asm
import Turkey.Asm (Symbol)
import Turkey.Ssa as Ssa
import Turkey.Ssa (Value(..), Rep(..), RepClass(..),
                   Effects(..), Term(..))

-- A register: virtual while selection and the allocator are running, physical
-- afterwards.
--
-- One type rather than two. A separate `Physical` type would mean every
-- printer, verifier and encoder written twice, and the moment when a function
-- stops containing virtual registers is a *fact about a pass having run*, not
-- something the type system can usefully police at this size.
-- Which file a register comes from. arm64 has two, and they are numbered
-- independently: `x0` and `d0` are different registers that are both 0.
--
-- A *virtual* register's bank is not here, because it is already written down
-- -- `Func.reps` says whether the value is `F64`, and a second copy of that
-- fact is a second copy that can disagree. A *physical* register has no rep
-- to consult, so it carries its bank.
type Bank = Gp | Fp

type Reg
    -- A value from selection. The number is an `Ssa.Value` id.
    = Virtual(Int)
    -- `x0`..`x30` and `d0`..`d31`; 31 in the general file means `xzr` or `sp`
    -- depending on the instruction.
    | Physical(Bank, Int)

fun reg(v : Value) -> Reg = Virtual(Ssa.valueId(v))

fun physical(n : Int) -> Reg = Physical(Gp, n)

fun isPhysical(r : Reg) -> Bool = match r {
    Physical(_, _) -> True
    Virtual(_) -> False
}

-- The file a value of this representation lives in.
fun bankOf(r : Rep) -> Bank = match r.class_ {
    F64 -> Fp
    _ -> Gp
}

let xzr = Physical(Gp, 31)
let sp = Physical(Gp, 31)
let fp = Physical(Gp, 29)
let lr = Physical(Gp, 30)
let x0 = Physical(Gp, 0)
let d0 = Physical(Fp, 0)

-- The first eight are the argument and result registers.
-- Closure conversion keeps most calls under eight, because a closure's
-- captures travel in its environment rather than in registers -- but it does
-- not bound them, and the claim that it did was wrong: `tests/programs/
-- manyargs.gob` has a nine-parameter function. A call needing a ninth stops in
-- `Turkey.Select`, and a *function declaring* a ninth parameter selects
-- silently and wrongly, because the incoming convention is the prologue's job.
--
-- AAPCS64 numbers the two files' argument registers separately: an integer
-- argument takes the next `x` and a double the next `d`, so a call with one of
-- each passes them in `x0` and `d0` rather than in `x0` and `x1`.
let argRegs = [Physical(Gp, 0), Physical(Gp, 1), Physical(Gp, 2),
               Physical(Gp, 3), Physical(Gp, 4), Physical(Gp, 5),
               Physical(Gp, 6), Physical(Gp, 7)]
let fpArgRegs = [Physical(Fp, 0), Physical(Fp, 1), Physical(Fp, 2),
                 Physical(Fp, 3), Physical(Fp, 4), Physical(Fp, 5),
                 Physical(Fp, 6), Physical(Fp, 7)]

-- AAPCS64: x0-x17 are caller-saved, x19-x28 callee-saved. x18 is reserved by
-- the platform on Darwin and is not in either list.
let callerSaved = [Physical(Gp, 0), Physical(Gp, 1), Physical(Gp, 2),
                   Physical(Gp, 3), Physical(Gp, 4), Physical(Gp, 5),
                   Physical(Gp, 6), Physical(Gp, 7), Physical(Gp, 8),
                   Physical(Gp, 9), Physical(Gp, 10), Physical(Gp, 11),
                   Physical(Gp, 12), Physical(Gp, 13), Physical(Gp, 14),
                   Physical(Gp, 15), Physical(Gp, 16), Physical(Gp, 17)]
let calleeSaved = [Physical(Gp, 19), Physical(Gp, 20), Physical(Gp, 21),
                   Physical(Gp, 22), Physical(Gp, 23), Physical(Gp, 24),
                   Physical(Gp, 25), Physical(Gp, 26), Physical(Gp, 27),
                   Physical(Gp, 28)]

-- The vector file's halves are the other way round from the general file's:
-- `v0`-`v7` and `v16`-`v31` are caller-saved, and only the *low 64 bits* of
-- `v8`-`v15` are callee-saved. Every double this compiler makes is 64 bits, so
-- the distinction does not bite here -- but it is why these are named `d` and
-- not `v`, and it would bite the moment anything vectorized.
let fpCallerSaved = [Physical(Fp, 0), Physical(Fp, 1), Physical(Fp, 2),
                     Physical(Fp, 3), Physical(Fp, 4), Physical(Fp, 5),
                     Physical(Fp, 6), Physical(Fp, 7), Physical(Fp, 16),
                     Physical(Fp, 17), Physical(Fp, 18), Physical(Fp, 19),
                     Physical(Fp, 20), Physical(Fp, 21), Physical(Fp, 22),
                     Physical(Fp, 23), Physical(Fp, 24), Physical(Fp, 25),
                     Physical(Fp, 26), Physical(Fp, 27), Physical(Fp, 28),
                     Physical(Fp, 29), Physical(Fp, 30), Physical(Fp, 31)]
let fpCalleeSaved = [Physical(Fp, 8), Physical(Fp, 9), Physical(Fp, 10),
                     Physical(Fp, 11), Physical(Fp, 12), Physical(Fp, 13),
                     Physical(Fp, 14), Physical(Fp, 15)]

-- What a call lets its callee destroy.
--
-- `Standard` is AAPCS64's: the caller-saved registers, in both files.
-- `PreservesNone` is every register the allocator hands out, callee-saved
-- included: a value live across such a call has to be in memory, and so only
-- the values actually live are saved, by the caller, rather than a fixed set
-- by the callee.
--
-- A function that makes a call clobbering a callee-saved register must still
-- save that register itself, because its own caller expects it preserved
-- (`Turkey.Frame.calleeSaved`).
type Convention = Standard | PreservesNone

-- The registers of `bank` a call destroys, as a mask with bit `n` for register
-- `n`, and 0 for an instruction that is not a call. Every register number in
-- either file is below 32. An allocation is a call on its slow path, to the
-- runtime, under the standard convention.
--
-- Masks rather than lists, and computed once: the allocator asks this of
-- every instruction it walks.
fun callClobbers(op : Arm, bank : Bank) -> Int = match op {
    Bl(_, c) -> clobbersUnder(c, bank)
    Blr(_, c) -> clobbersUnder(c, bank)
    Allocate(_, _) -> clobbersUnder(Standard, bank)
    AllocateArray(_, _, _, _) -> clobbersUnder(Standard, bank)
    _ -> 0
}

fun clobbersUnder(c : Convention, bank : Bank) -> Int = match (c, bank) {
    (Standard, Gp) -> callerSavedGpMask
    (Standard, Fp) -> callerSavedFpMask
    (PreservesNone, Gp) -> Int.or(callerSavedGpMask, calleeSavedGpMask)
    (PreservesNone, Fp) -> Int.or(callerSavedFpMask, calleeSavedFpMask)
}

-- The callee-saved registers of `bank`, as a mask.
fun calleeSavedMask(bank : Bank) -> Int = match bank {
    Gp -> calleeSavedGpMask
    Fp -> calleeSavedFpMask
}

let callerSavedGpMask = maskOf(callerSaved)
let callerSavedFpMask = maskOf(fpCallerSaved)
let calleeSavedGpMask = maskOf(calleeSaved)
let calleeSavedFpMask = maskOf(fpCalleeSaved)

fun maskOf(regs : Array Reg) -> Int {
    var mask = 0
    for r in regs {
        match r {
            Physical(_, n) -> { mask = Int.or(mask, Int.shl(1, n)) }
            Virtual(_) -> {}
        }
    }
    mask
}

-- The operand width. arm64 spells the same instruction `add w0, ...` at 32
-- bits and `add x0, ...` at 64, so this is a field rather than two opcodes.
type Width = W32 | W64

type Cond = Eq | Ne | Lt | Le | Gt | Ge | Lo | Ls | Hi | Hs | Vs | Vc

-- A memory operand: a base register and an offset, scaled by the access width
-- the way arm64's addressing modes are.
type Mem
    = Offset(Reg, Int)
    | Indexed(Reg, Reg)
    -- A slot in the function's frame, before the frame is laid out. The number
    -- is a slot of its kind, not an offset: `RootSlot(n)` is slot `n` of the
    -- root array `Turkey.Roots` assigns, and `SpillSlot(n)` one of the
    -- allocator's own. Frame layout turns both into `sp`-relative offsets.
    | RootSlot(Int)
    | SpillSlot(Int)
    -- Byte `k` of object `n` built in the frame, `n` indexing
    -- `Turkey.Roots.Frame.objects`.
    | ObjectSlot(Int, Int)
    -- Stack argument `k`, counted from zero in argument order whatever its
    -- file: `IncomingArg` is one this function was passed, at `x29 + 16 + 8k`;
    -- `OutgoingArg` one it passes, at `sp + 8k` in its preallocated outgoing
    -- area.
    | IncomingArg(Int)
    | OutgoingArg(Int)
    -- A symbol, as the offset within the page its base register holds: the
    -- second half of an `adrp` pair, folded into the access so the address is
    -- never formed on its own. The symbol must be aligned to the access width,
    -- as every global and the process state are.
    | PageOffset(Reg, Symbol)

type Arm
    -- Moves and constants. `MovZ`/`MovK` build a 64-bit constant in up to four
    -- steps; selection decides how many are needed.
    = Mov(Reg, Reg, Width)
    | MovZ(Reg, Int, Int)
    | MovK(Reg, Int, Int)
    -- Arithmetic. `S` in the name means the flags are set, which is what an
    -- overflow check reads.
    | Add(Reg, Reg, Reg, Width)
    | AddImm(Reg, Reg, Int, Width)
    | AddS(Reg, Reg, Reg, Width)
    | Sub(Reg, Reg, Reg, Width)
    | SubImm(Reg, Reg, Int, Width)
    | SubS(Reg, Reg, Reg, Width)
    | AddSImm(Reg, Reg, Int, Width)
    | SubSImm(Reg, Reg, Int, Width)
    | Mul(Reg, Reg, Reg, Width)
    -- The high half of a 64x64 multiply, which is how overflow is detected
    -- when `MulS` does not exist -- and it does not, on arm64.
    | SMulH(Reg, Reg, Reg)
    | SDiv(Reg, Reg, Reg, Width)
    | MSub(Reg, Reg, Reg, Reg, Width)
    | And(Reg, Reg, Reg, Width)
    | Orr(Reg, Reg, Reg, Width)
    | Eor(Reg, Reg, Reg, Width)
    | EorImm(Reg, Reg, Int, Width)
    -- `and` with a logical immediate. Only a run of low ones is selected,
    -- which every width can encode; see `Turkey.Select.lowMask`.
    | AndImm(Reg, Reg, Int, Width)
    | LslImm(Reg, Reg, Int, Width)
    | LsrImm(Reg, Reg, Int, Width)
    | AsrImm(Reg, Reg, Int, Width)
    | Lsl(Reg, Reg, Reg, Width)
    | Lsr(Reg, Reg, Reg, Width)
    | Asr(Reg, Reg, Reg, Width)
    -- Comparison, and materializing its result. `Cmp` sets the flags and
    -- `CSet` reads them; selection emits the pair adjacently and nothing
    -- between them may clobber the flags.
    | Cmp(Reg, Reg, Width)
    | CmpImm(Reg, Int, Width)
    | CSet(Reg, Cond)
    -- Sign and zero extension, which is how a narrow representation reaches a
    -- wide one.
    | Sxtw(Reg, Reg)
    | Uxtb(Reg, Reg)
    | Uxth(Reg, Reg)
    | Ubfx(Reg, Reg, Int, Int)
    -- Bit reversal and leading zeros, 64 bits wide: together a count of
    -- trailing zeros, which arm64 has no single instruction for.
    | Rbit(Reg, Reg)
    | Clz(Reg, Reg)
    -- Memory. The width is the access size, not the register size.
    | Ldr(Reg, Mem, Width)
    | Ldrb(Reg, Mem)
    | Ldrsw(Reg, Mem)
    | Str(Reg, Mem, Width)
    | Strb(Reg, Mem)
    -- A pair, which is how a frame is set up and torn down in one instruction.
    | Stp(Reg, Reg, Reg, Int)
    | Ldp(Reg, Reg, Reg, Int)
    -- The address of a symbol, in the two-instruction form arm64 uses: a page
    -- and an offset within it. How either half is spelled for the assembler is
    -- the object format's business (`Turkey.Asm.page`), not the instruction's.
    | Adrp(Reg, Symbol)
    | AddLo(Reg, Reg, Symbol)
    -- The address of a frame slot, `add d, sp, #offset` once the frame is laid
    -- out. Only an object built in the frame is ever addressed: every other
    -- slot is read and written where it is.
    | FrameAddress(Reg, Mem)
    -- Floating point. One width only, because Turkey's `Float` is a double
    -- and there is no `f32` to spell.
    --
    -- `FMov` moves between two `d`s; `FMovIn` and `FMovOut` move the *bits*
    -- between a `d` and an `x`, which is how a double reaches the runtime's
    -- untyped `i64` interfaces and comes back. All three are `fmov` to the
    -- assembler, and they are three constructors here because the register
    -- banks differ and a printer that guessed from the operands would be
    -- guessing.
    | FMov(Reg, Reg)
    | FMovIn(Reg, Reg)
    | FMovOut(Reg, Reg)
    | FAdd(Reg, Reg, Reg)
    | FSub(Reg, Reg, Reg)
    | FMul(Reg, Reg, Reg)
    | FDiv(Reg, Reg, Reg)
    | FNeg(Reg, Reg)
    | FCmp(Reg, Reg)
    -- Signed integer to double, and back with truncation toward zero, which is
    -- what `Float.truncate` means.
    | Scvtf(Reg, Reg)
    | Fcvtzs(Reg, Reg)
    -- A 64-bit constant, as one instruction.
    --
    -- arm64 builds one out of a `movz` and up to three `movk`s, and every
    -- `movk` reads the register it writes. That is not SSA: the value would be
    -- defined four times, which `Ssa.verify` rejects and a register allocator
    -- would believe. So the sequence is one instruction here and the printer
    -- expands it -- the same answer QBE and Cranelift give a "load immediate",
    -- and the reason a pseudo-instruction is a category the enum has at all.
    | MovConst(Reg, Int)
    -- Calls. `Bl` is direct and `Blr` is through a register; either names
    -- what the callee may destroy.
    | Bl(Symbol, Convention)
    | Blr(Reg, Convention)
    -- A pseudo-instruction: the arguments a call passes and the register it
    -- answers in are not operands of `Bl`, so without this the allocator would
    -- see a call that uses and defines nothing. It carries no encoding.
    | CallArgs(Array Reg, Array Reg)
    -- A pseudo-instruction directly after a call that may collect, naming the
    -- low IR instruction -- block and index -- the call was selected from.
    -- That is the key `Turkey.Roots.liveAt` answers the live roots for, so the
    -- frame layout can turn it into this return address's frame-table entry.
    -- It carries no encoding; the emitter gives the return address a label.
    | SafepointMap(Int, Int)
    -- A small heap allocation, defining its register: a slot taken in line
    -- from its size class's cursor, or a call to the runtime when the cursor
    -- is empty. The emitter expands it (`Turkey.Emit.allocate`), putting the
    -- call out of line after the function's blocks; until then it is one
    -- instruction, and a call, because on one of its paths it is one.
    --
    -- Kept whole rather than selected as blocks and a call: the allocator's
    -- liveness and colouring cost grow with every block and value, and the
    -- self-compile allocates at twenty thousand sites, so a selected fast
    -- path made the compiler slower than the time it saved.
    | Allocate(Reg, Allocation)
    -- An array of the length in the second register, every element the
    -- third register's value: the same take from a cursor, its size class
    -- looked up at run time, then the elements filled in. Its destination is
    -- written before its operands are last read, so it may not share a
    -- register with either (`writesBeforeReading`).
    | AllocateArray(Reg, Reg, Reg, ArrayAllocation)
    | Ret
    -- Branches to a label: a block, an allocation's stub, or another
    -- function's symbol for a tail call. The emitter places them; selection
    -- ends a block with a terminator instead.
    | B(Symbol)
    | BCond(Cond, Symbol)
    -- Branch if the register, at this width, is zero or is not.
    | Cbz(Reg, Symbol, Width)
    | Cbnz(Reg, Symbol, Width)
    | Brk(Int)
    -- The emitter's own, for the frame and the entry sequence. `MovN` writes
    -- the complement of its immediate, which is how `-1` is one instruction.
    -- `AddExt` and `SubExt` are the extended-register forms, the ones that
    -- read register 31 as `sp` rather than `xzr`: how `sp` moves by an amount
    -- too large for an immediate.
    | MovN(Reg, Int)
    | AddExt(Reg, Reg, Reg)
    | SubExt(Reg, Reg, Reg)

-- What `Allocate` takes: the size class, the payload's size and heap kind
-- for the header, the runtime's slow path and its arguments, and the cursor
-- table's symbol. Everything is a constant here, so the instruction reads no
-- register and the slow path needs nothing kept live for it.
type Allocation = Allocation {
    sizeClass : Int,
    slotBytes : Int,
    size      : Int,
    kind      : Int,
    slow      : Symbol,
    args      : Array AllocArg,
    cursors   : Symbol,
}

type AllocArg = Constant(Int) | AddressOf(Symbol)

-- What `AllocateArray` takes: the element's width in bytes and layout code,
-- the runtime's slow path, and the symbols of the cursor table and the size
-- class table.
type ArrayAllocation = ArrayAllocation {
    width   : Int,
    layout  : Int,
    slow    : Symbol,
    cursors : Symbol,
    classes : Symbol,
}

-- An instruction and the register it defines, mirroring `Turkey.LowIr.Low`.
--
-- Not every arm64 instruction defines a register -- a store does not -- so
-- unlike the low IR this cannot give every instruction exactly one result.
-- `defs` reads the opcode instead, which is why `Arm` carries its destination
-- inside the constructor rather than beside it.
type Inst = Inst { op : Arm }

instance Ssa.Inst Inst {
    fun anyUse(i, p) = anySrc(i.op, virtual(_, p))
    fun anyDef(i, p) = anyDest(i.op, virtual(_, p))
    fun effects(i) = if computes(i.op) { Ssa.reads_() } else { Ssa.writes() }
    fun renameUses(i, f) = Inst { op = mapUses(i.op, fun(r) = match r {
        Virtual(n) -> reg(f(Value(n)))
        other -> other
    }) }
    fun copyOf(i) = match i.op {
        Mov(Virtual(d), Virtual(a), W64) -> Some((Value(d), Value(a)))
        FMov(Virtual(d), Virtual(a)) -> Some((Value(d), Value(a)))
        _ -> None
    }
}

-- Whether an instruction does nothing but compute its destination, so that
-- it may be deleted when that destination is unused.
--
-- Everything else answers `writes`, which no pass removes or reorders: a store
-- or a call, anything that sets the flags a later branch or `cset` reads --
-- the flags are not a `Value`, so nothing else would keep `cmp` alive -- and
-- anything that writes a physical register, since an argument register or a
-- result register is read by an instruction that does not name it as a use.
-- A load may be deleted; an address this backend loads through is never one
-- that faults on purpose.
fun computes(op : Arm) -> Bool = match op {
    Mov(d, _, _) -> !isPhysical(d)
    MovZ(d, _, _) -> !isPhysical(d)
    MovConst(d, _) -> !isPhysical(d)
    Add(d, _, _, _) -> !isPhysical(d)
    AddImm(d, _, _, _) -> !isPhysical(d)
    Sub(d, _, _, _) -> !isPhysical(d)
    SubImm(d, _, _, _) -> !isPhysical(d)
    Mul(d, _, _, _) -> !isPhysical(d)
    SMulH(d, _, _) -> !isPhysical(d)
    SDiv(d, _, _, _) -> !isPhysical(d)
    MSub(d, _, _, _, _) -> !isPhysical(d)
    And(d, _, _, _) -> !isPhysical(d)
    Orr(d, _, _, _) -> !isPhysical(d)
    Eor(d, _, _, _) -> !isPhysical(d)
    EorImm(d, _, _, _) -> !isPhysical(d)
    AndImm(d, _, _, _) -> !isPhysical(d)
    LslImm(d, _, _, _) -> !isPhysical(d)
    LsrImm(d, _, _, _) -> !isPhysical(d)
    AsrImm(d, _, _, _) -> !isPhysical(d)
    Lsl(d, _, _, _) -> !isPhysical(d)
    Lsr(d, _, _, _) -> !isPhysical(d)
    Asr(d, _, _, _) -> !isPhysical(d)
    CSet(d, _) -> !isPhysical(d)
    Sxtw(d, _) -> !isPhysical(d)
    Uxtb(d, _) -> !isPhysical(d)
    Uxth(d, _) -> !isPhysical(d)
    Ubfx(d, _, _, _) -> !isPhysical(d)
    Rbit(d, _) -> !isPhysical(d)
    Clz(d, _) -> !isPhysical(d)
    Ldr(d, _, _) -> !isPhysical(d)
    Ldrb(d, _) -> !isPhysical(d)
    Ldrsw(d, _) -> !isPhysical(d)
    Adrp(d, _) -> !isPhysical(d)
    AddLo(d, _, _) -> !isPhysical(d)
    FrameAddress(d, _) -> !isPhysical(d)
    FMov(d, _) -> !isPhysical(d)
    FMovIn(d, _) -> !isPhysical(d)
    FMovOut(d, _) -> !isPhysical(d)
    FAdd(d, _, _) -> !isPhysical(d)
    FSub(d, _, _) -> !isPhysical(d)
    FMul(d, _, _) -> !isPhysical(d)
    FDiv(d, _, _) -> !isPhysical(d)
    FNeg(d, _) -> !isPhysical(d)
    Scvtf(d, _) -> !isPhysical(d)
    Fcvtzs(d, _) -> !isPhysical(d)
    _ -> False
}

-- Whether this instruction is a call, which for the allocator means two
-- things at once: every caller-saved register is clobbered here, so a value
-- live across it needs a callee-saved one or a spill slot -- and it is a
-- safepoint, so the collector may run and every live traced value must be
-- somewhere the collector can see.
--
-- It lives here rather than in the allocator because which opcodes call is a
-- fact about the instruction set. `Ssa.effects` cannot answer it: every
-- machine instruction reports `writes`, deliberately, because the
-- optimizations run above this level and a conservative answer costs them
-- nothing.
-- Frame slots and the spill code that reads and writes them, asked by the
-- allocator's checker. Here rather than there because matching a constructor
-- needs it unqualified, and `Ret` names both a machine instruction and a
-- terminator in the allocator's scope.
fun isSlot(m : Mem) -> Bool = match m {
    RootSlot(_) -> True
    SpillSlot(_) -> True
    _ -> False
}

fun isFrameAddress(op : Arm) -> Bool = match op {
    FrameAddress(_, _) -> True
    _ -> False
}

fun isRootSlot(m : Mem) -> Bool = match m {
    RootSlot(_) -> True
    _ -> False
}

-- The value a load from a frame slot defines, and the slot.
fun slotLoad(op : Arm) -> Option (Int, Mem) = match op {
    Ldr(Virtual(t), m, _) -> if isSlot(m) { Some((t, m)) } else { None }
    _ -> None
}

-- The value a store to a frame slot writes, and the slot.
fun slotStore(op : Arm) -> Option (Int, Mem) = match op {
    Str(Virtual(v), m, _) -> if isSlot(m) { Some((v, m)) } else { None }
    _ -> None
}

-- A same-file move between a virtual and a physical register, as the value
-- and the register number it would like: an incoming parameter, an argument
-- moved into place, a result moved out. `xzr` is not a preference.
fun moveHint(op : Arm) -> Option (Int, Int) = match op {
    Mov(Virtual(d), Physical(Gp, n), _) -> if n == 31 { None } else { Some((d, n)) }
    Mov(Physical(Gp, n), Virtual(a), _) -> if n == 31 { None } else { Some((a, n)) }
    FMov(Virtual(d), Physical(Fp, n)) -> Some((d, n))
    FMov(Physical(Fp, n), Virtual(a)) -> Some((a, n))
    _ -> None
}

-- The low IR position a safepoint map names, if this is one.
fun safepointOf(op : Arm) -> Option (Int, Int) = match op {
    SafepointMap(b, n) -> Some((b, n))
    _ -> None
}

-- The destination and the allocation, if this is an `Allocate`.
fun allocationOf(op : Arm) -> Option (Reg, Allocation) = match op {
    Allocate(d, a) -> Some((d, a))
    _ -> None
}

-- The destination, length, fill and allocation of an `AllocateArray`.
fun arrayAllocationOf(op : Arm) -> Option (Reg, Reg, Reg, ArrayAllocation) = match op {
    AllocateArray(d, n, v, a) -> Some((d, n, v, a))
    _ -> None
}

-- Whether an instruction writes its destination before it has read all of
-- its operands, so that the destination may not share an operand's register
-- even where the operand dies here.
fun writesBeforeReading(op : Arm) -> Bool = match op {
    AllocateArray(_, _, _, _) -> True
    _ -> False
}

-- The memory operand an instruction reads or writes, if it has one.
fun memOf(op : Arm) -> Option Mem = match op {
    FrameAddress(_, m) -> Some(m)
    Ldr(_, m, _) -> Some(m)
    Ldrb(_, m) -> Some(m)
    Ldrsw(_, m) -> Some(m)
    Str(_, m, _) -> Some(m)
    Strb(_, m) -> Some(m)
    _ -> None
}

-- A move from a register into itself, which is what a taken hint looks like
-- once the colouring is substituted.
fun redundantMove(op : Arm) -> Bool = match op {
    Mov(d, s, _) -> sameRegister(d, s)
    FMov(d, s) -> sameRegister(d, s)
    _ -> False
}

fun sameRegister(a : Reg, b : Reg) -> Bool =
    showReg(a, W64) == showReg(b, W64)

fun isCSet(op : Arm) -> Bool = match op {
    CSet(_, _) -> True
    _ -> False
}

-- The value a `cset` into a virtual register defines, and its condition.
fun csetOf(op : Arm) -> Option (Int, Cond) = match op {
    CSet(Virtual(n), c) -> Some((n, c))
    _ -> None
}

fun setsFlags(op : Arm) -> Bool = match op {
    Cmp(_, _, _) -> True
    CmpImm(_, _, _) -> True
    AddS(_, _, _, _) -> True
    SubS(_, _, _, _) -> True
    AddSImm(_, _, _, _) -> True
    SubSImm(_, _, _, _) -> True
    FCmp(_, _) -> True
    _ -> False
}

fun isCall(i : Inst) -> Bool = match i.op {
    Bl(_, _) -> True
    Blr(_, _) -> True
    Allocate(_, _) -> True
    AllocateArray(_, _, _, _) -> True
    _ -> False
}

-- `p` asked of a register only if it is virtual: the values an instruction
-- reads and writes, as liveness and the verifier see them.
--
-- The binder's name is not arbitrary. This is inlined into closures all over
-- the backend, and the compiler in `bootstrap/`, which builds this one,
-- captures a pattern binder spelled like a `var` of the enclosing function as
-- that `var` -- a use of an undefined value when the `var` lives in a slot.
-- `SsaLower.capturesOf` skips such a binder; until `bootstrap/` is rebuilt
-- from a compiler that does, no caller may have a `var number`.
fun virtual(r : Reg, p : fun(Value) -> Bool) -> Bool = match r {
    Virtual(number) -> p(Value(number))
    _ -> False
}

-- Whether `p` holds of some register an instruction *reads*, physical ones
-- included, asked in operand order and stopping at the first that answers
-- true.
--
-- This and `anyDest` are visitors rather than functions returning an array
-- of registers, which would read better; that is a compromise for speed.
-- Every pass from liveness to the allocator asks this of every instruction,
-- often more than once, and a returned array escapes to its caller, so it is
-- an allocation per question that no analysis removes. The closure passed
-- here goes to a parameter that is only called, so it is built in the
-- caller's frame.
--
-- The physical registers are the mirror of `anyDest`'s, and wanted for the
-- mirror reason. The allocator
-- knew what a `mov x0, %5` destroys but not that `x0` is then *live* until the
-- `bl` reads it -- so a value defined in between could have been given `x0`
-- and overwritten the argument. Selection never defines one there, which is
-- why nothing broke; a spiller's reload in front of `mov x1, %6` is exactly
-- such a value.
fun anySrc(op : Arm, p : fun(Reg) -> Bool) -> Bool = match op {
    Mov(_, a, _)        -> p(a)
    MovZ(_, _, _)       -> False
    MovK(d, _, _)       -> p(d)
    Add(_, a, b, _)     -> p(a) || p(b)
    AddImm(_, a, _, _)  -> p(a)
    AddS(_, a, b, _)    -> p(a) || p(b)
    Sub(_, a, b, _)     -> p(a) || p(b)
    SubImm(_, a, _, _)  -> p(a)
    SubS(_, a, b, _)    -> p(a) || p(b)
    AddSImm(_, a, _, _) -> p(a)
    SubSImm(_, a, _, _) -> p(a)
    Mul(_, a, b, _)     -> p(a) || p(b)
    SMulH(_, a, b)      -> p(a) || p(b)
    SDiv(_, a, b, _)    -> p(a) || p(b)
    MSub(_, a, b, c, _) -> p(a) || p(b) || p(c)
    And(_, a, b, _)     -> p(a) || p(b)
    Orr(_, a, b, _)     -> p(a) || p(b)
    Eor(_, a, b, _)     -> p(a) || p(b)
    EorImm(_, a, _, _)  -> p(a)
    AndImm(_, a, _, _)  -> p(a)
    LslImm(_, a, _, _)  -> p(a)
    LsrImm(_, a, _, _)  -> p(a)
    AsrImm(_, a, _, _)  -> p(a)
    Lsl(_, a, b, _)     -> p(a) || p(b)
    Lsr(_, a, b, _)     -> p(a) || p(b)
    Asr(_, a, b, _)     -> p(a) || p(b)
    Cmp(a, b, _)        -> p(a) || p(b)
    CmpImm(a, _, _)     -> p(a)
    CSet(_, _)          -> False
    Sxtw(_, a)          -> p(a)
    Uxtb(_, a)          -> p(a)
    Uxth(_, a)          -> p(a)
    Ubfx(_, a, _, _)    -> p(a)
    Rbit(_, a)          -> p(a)
    Clz(_, a)           -> p(a)
    Ldr(_, m, _)        -> anyMem(m, p)
    Ldrb(_, m)          -> anyMem(m, p)
    Ldrsw(_, m)         -> anyMem(m, p)
    Str(v, m, _)        -> p(v) || anyMem(m, p)
    Strb(v, m)          -> p(v) || anyMem(m, p)
    Stp(a, b, base, _)  -> p(a) || p(b) || p(base)
    Ldp(_, _, base, _)  -> p(base)
    Adrp(_, _)          -> False
    AddLo(_, a, _)      -> p(a)
    FrameAddress(_, m)  -> anyMem(m, p)
    MovConst(_, _)      -> False
    FMov(_, a)          -> p(a)
    FMovIn(_, a)        -> p(a)
    FMovOut(_, a)       -> p(a)
    FAdd(_, a, b)       -> p(a) || p(b)
    FSub(_, a, b)       -> p(a) || p(b)
    FMul(_, a, b)       -> p(a) || p(b)
    FDiv(_, a, b)       -> p(a) || p(b)
    FNeg(_, a)          -> p(a)
    FCmp(a, b)          -> p(a) || p(b)
    Scvtf(_, a)         -> p(a)
    Fcvtzs(_, a)        -> p(a)
    Bl(_, _)            -> False
    Blr(a, _)           -> p(a)
    CallArgs(ins, _)    -> anyIn(ins, p)
    SafepointMap(_, _)  -> False
    Ret                 -> False
    B(_)                -> False
    BCond(_, _)         -> False
    Cbz(a, _, _)        -> p(a)
    Cbnz(a, _, _)       -> p(a)
    Allocate(_, _)      -> False
    AllocateArray(_, n, v, _) -> p(n) || p(v)
    Brk(_)              -> False
    MovN(_, _)          -> False
    AddExt(_, a, b)     -> p(a) || p(b)
    SubExt(_, a, b)     -> p(a) || p(b)
}


-- The same instruction with every register it *reads* passed through `g`, and
-- the registers it writes left alone.
--
-- The spiller's one rewrite: a reload is a fresh value, and the instruction
-- that used the spilled one reads the reload instead. Derived from `anySrc`
-- position by position so that the two cannot disagree about which operand is
-- a read. `MovK` is the exception and is left untouched -- it reads the
-- register it writes, so renaming the read would rename the write -- and
-- selection never emits one: a constant is `MovConst` until the printer.
fun mapUses(op : Arm, g : fun(Reg) -> Reg) -> Arm = match op {
    Mov(k0, a, k2)        -> Mov(k0, g(a), k2)
    MovZ(k0, k1, k2)      -> MovZ(k0, k1, k2)
    MovK(d, k1, k2)       -> MovK(d, k1, k2)
    Add(k0, a, b, k3)     -> Add(k0, g(a), g(b), k3)
    AddImm(k0, a, k2, k3) -> AddImm(k0, g(a), k2, k3)
    AddS(k0, a, b, k3)    -> AddS(k0, g(a), g(b), k3)
    Sub(k0, a, b, k3)     -> Sub(k0, g(a), g(b), k3)
    SubImm(k0, a, k2, k3) -> SubImm(k0, g(a), k2, k3)
    SubS(k0, a, b, k3)    -> SubS(k0, g(a), g(b), k3)
    AddSImm(k0, a, k2, k3) -> AddSImm(k0, g(a), k2, k3)
    SubSImm(k0, a, k2, k3) -> SubSImm(k0, g(a), k2, k3)
    Mul(k0, a, b, k3)     -> Mul(k0, g(a), g(b), k3)
    SMulH(k0, a, b)       -> SMulH(k0, g(a), g(b))
    SDiv(k0, a, b, k3)    -> SDiv(k0, g(a), g(b), k3)
    MSub(k0, a, b, c, k4) -> MSub(k0, g(a), g(b), g(c), k4)
    And(k0, a, b, k3)     -> And(k0, g(a), g(b), k3)
    Orr(k0, a, b, k3)     -> Orr(k0, g(a), g(b), k3)
    Eor(k0, a, b, k3)     -> Eor(k0, g(a), g(b), k3)
    EorImm(k0, a, k2, k3) -> EorImm(k0, g(a), k2, k3)
    AndImm(k0, a, k2, k3) -> AndImm(k0, g(a), k2, k3)
    LslImm(k0, a, k2, k3) -> LslImm(k0, g(a), k2, k3)
    LsrImm(k0, a, k2, k3) -> LsrImm(k0, g(a), k2, k3)
    AsrImm(k0, a, k2, k3) -> AsrImm(k0, g(a), k2, k3)
    Lsl(k0, a, b, k3)     -> Lsl(k0, g(a), g(b), k3)
    Lsr(k0, a, b, k3)     -> Lsr(k0, g(a), g(b), k3)
    Asr(k0, a, b, k3)     -> Asr(k0, g(a), g(b), k3)
    Cmp(a, b, k2)         -> Cmp(g(a), g(b), k2)
    CmpImm(a, k1, k2)     -> CmpImm(g(a), k1, k2)
    CSet(k0, k1)          -> CSet(k0, k1)
    Sxtw(k0, a)           -> Sxtw(k0, g(a))
    Uxtb(k0, a)           -> Uxtb(k0, g(a))
    Uxth(k0, a)           -> Uxth(k0, g(a))
    Ubfx(k0, a, k2, k3)   -> Ubfx(k0, g(a), k2, k3)
    Rbit(k0, a)           -> Rbit(k0, g(a))
    Clz(k0, a)            -> Clz(k0, g(a))
    Ldr(k0, m, k2)        -> Ldr(k0, mapMem(m, g), k2)
    Ldrb(k0, m)           -> Ldrb(k0, mapMem(m, g))
    Ldrsw(k0, m)          -> Ldrsw(k0, mapMem(m, g))
    Str(v, m, k2)         -> Str(g(v), mapMem(m, g), k2)
    Strb(v, m)            -> Strb(g(v), mapMem(m, g))
    Stp(a, b, base, k3)   -> Stp(g(a), g(b), g(base), k3)
    Ldp(k0, k1, base, k3) -> Ldp(k0, k1, g(base), k3)
    Adrp(k0, k1)          -> Adrp(k0, k1)
    AddLo(k0, a, k2)      -> AddLo(k0, g(a), k2)
    FrameAddress(k0, m)   -> FrameAddress(k0, mapMem(m, g))
    MovConst(k0, k1)      -> MovConst(k0, k1)
    FMov(k0, a)           -> FMov(k0, g(a))
    FMovIn(k0, a)         -> FMovIn(k0, g(a))
    FMovOut(k0, a)        -> FMovOut(k0, g(a))
    FAdd(k0, a, b)        -> FAdd(k0, g(a), g(b))
    FSub(k0, a, b)        -> FSub(k0, g(a), g(b))
    FMul(k0, a, b)        -> FMul(k0, g(a), g(b))
    FDiv(k0, a, b)        -> FDiv(k0, g(a), g(b))
    FNeg(k0, a)           -> FNeg(k0, g(a))
    FCmp(a, b)            -> FCmp(g(a), g(b))
    Scvtf(k0, a)          -> Scvtf(k0, g(a))
    Fcvtzs(k0, a)         -> Fcvtzs(k0, g(a))
    Bl(k0, k1)            -> Bl(k0, k1)
    Blr(a, k1)            -> Blr(g(a), k1)
    CallArgs(ins, k1)     -> CallArgs(Array.map(ins, g), k1)
    SafepointMap(k0, k1)  -> SafepointMap(k0, k1)
    Ret                   -> Ret
    B(k0)                 -> B(k0)
    BCond(k0, k1)         -> BCond(k0, k1)
    Cbz(a, k1, k2)        -> Cbz(g(a), k1, k2)
    Cbnz(a, k1, k2)       -> Cbnz(g(a), k1, k2)
    Allocate(k0, k1)      -> Allocate(k0, k1)
    AllocateArray(k0, n, v, k3) -> AllocateArray(k0, g(n), g(v), k3)
    Brk(k0)               -> Brk(k0)
    MovN(k0, k1)          -> MovN(k0, k1)
    AddExt(k0, a, b)      -> AddExt(k0, g(a), g(b))
    SubExt(k0, a, b)      -> SubExt(k0, g(a), g(b))
}

fun mapMem(m : Mem, g : fun(Reg) -> Reg) -> Mem = match m {
    Offset(base, n)      -> Offset(g(base), n)
    Indexed(base, index) -> Indexed(g(base), g(index))
    RootSlot(n)          -> RootSlot(n)
    SpillSlot(n)         -> SpillSlot(n)
    ObjectSlot(n, k)     -> ObjectSlot(n, k)
    IncomingArg(k)       -> IncomingArg(k)
    OutgoingArg(k)       -> OutgoingArg(k)
    PageOffset(base, sym) -> PageOffset(g(base), sym)
}


-- The same instruction with every register through `g` and every memory
-- operand through `m`.
--
-- What the emitter needs and `mapUses` is not: the allocator's colouring
-- replaces the registers an instruction *writes* as well as the ones it reads,
-- and the frame layout replaces a slot with an offset from `sp`. Generated
-- from the opcode declaration field by field, so a new instruction cannot be
-- half-covered. `m` runs before `g`, so a rewritten memory operand's own base
-- register is still coloured.
fun rewrite(op : Arm, g : fun(Reg) -> Reg, m : fun(Mem) -> Mem) -> Arm = match op {
    Mov(f0, f1, f2)          -> Mov(g(f0), g(f1), f2)
    MovZ(f0, f1, f2)         -> MovZ(g(f0), f1, f2)
    MovK(f0, f1, f2)         -> MovK(g(f0), f1, f2)
    Add(f0, f1, f2, f3)      -> Add(g(f0), g(f1), g(f2), f3)
    AddImm(f0, f1, f2, f3)   -> AddImm(g(f0), g(f1), f2, f3)
    AddS(f0, f1, f2, f3)     -> AddS(g(f0), g(f1), g(f2), f3)
    Sub(f0, f1, f2, f3)      -> Sub(g(f0), g(f1), g(f2), f3)
    SubImm(f0, f1, f2, f3)   -> SubImm(g(f0), g(f1), f2, f3)
    SubS(f0, f1, f2, f3)     -> SubS(g(f0), g(f1), g(f2), f3)
    AddSImm(f0, f1, f2, f3)  -> AddSImm(g(f0), g(f1), f2, f3)
    SubSImm(f0, f1, f2, f3)  -> SubSImm(g(f0), g(f1), f2, f3)
    Mul(f0, f1, f2, f3)      -> Mul(g(f0), g(f1), g(f2), f3)
    SMulH(f0, f1, f2)        -> SMulH(g(f0), g(f1), g(f2))
    SDiv(f0, f1, f2, f3)     -> SDiv(g(f0), g(f1), g(f2), f3)
    MSub(f0, f1, f2, f3, f4) -> MSub(g(f0), g(f1), g(f2), g(f3), f4)
    And(f0, f1, f2, f3)      -> And(g(f0), g(f1), g(f2), f3)
    Orr(f0, f1, f2, f3)      -> Orr(g(f0), g(f1), g(f2), f3)
    Eor(f0, f1, f2, f3)      -> Eor(g(f0), g(f1), g(f2), f3)
    EorImm(f0, f1, f2, f3)   -> EorImm(g(f0), g(f1), f2, f3)
    AndImm(f0, f1, f2, f3)   -> AndImm(g(f0), g(f1), f2, f3)
    LslImm(f0, f1, f2, f3)   -> LslImm(g(f0), g(f1), f2, f3)
    LsrImm(f0, f1, f2, f3)   -> LsrImm(g(f0), g(f1), f2, f3)
    AsrImm(f0, f1, f2, f3)   -> AsrImm(g(f0), g(f1), f2, f3)
    Lsl(f0, f1, f2, f3)      -> Lsl(g(f0), g(f1), g(f2), f3)
    Lsr(f0, f1, f2, f3)      -> Lsr(g(f0), g(f1), g(f2), f3)
    Asr(f0, f1, f2, f3)      -> Asr(g(f0), g(f1), g(f2), f3)
    Cmp(f0, f1, f2)          -> Cmp(g(f0), g(f1), f2)
    CmpImm(f0, f1, f2)       -> CmpImm(g(f0), f1, f2)
    CSet(f0, f1)             -> CSet(g(f0), f1)
    Sxtw(f0, f1)             -> Sxtw(g(f0), g(f1))
    Uxtb(f0, f1)             -> Uxtb(g(f0), g(f1))
    Uxth(f0, f1)             -> Uxth(g(f0), g(f1))
    Ubfx(f0, f1, f2, f3)     -> Ubfx(g(f0), g(f1), f2, f3)
    Rbit(f0, f1)             -> Rbit(g(f0), g(f1))
    Clz(f0, f1)              -> Clz(g(f0), g(f1))
    Ldr(f0, f1, f2)          -> Ldr(g(f0), mapMem(m(f1), g), f2)
    Ldrb(f0, f1)             -> Ldrb(g(f0), mapMem(m(f1), g))
    Ldrsw(f0, f1)            -> Ldrsw(g(f0), mapMem(m(f1), g))
    Str(f0, f1, f2)          -> Str(g(f0), mapMem(m(f1), g), f2)
    Strb(f0, f1)             -> Strb(g(f0), mapMem(m(f1), g))
    Stp(f0, f1, f2, f3)      -> Stp(g(f0), g(f1), g(f2), f3)
    Ldp(f0, f1, f2, f3)      -> Ldp(g(f0), g(f1), g(f2), f3)
    Adrp(f0, f1)             -> Adrp(g(f0), f1)
    AddLo(f0, f1, f2)        -> AddLo(g(f0), g(f1), f2)
    FrameAddress(f0, f1)     -> FrameAddress(g(f0), mapMem(m(f1), g))
    FMov(f0, f1)             -> FMov(g(f0), g(f1))
    FMovIn(f0, f1)           -> FMovIn(g(f0), g(f1))
    FMovOut(f0, f1)          -> FMovOut(g(f0), g(f1))
    FAdd(f0, f1, f2)         -> FAdd(g(f0), g(f1), g(f2))
    FSub(f0, f1, f2)         -> FSub(g(f0), g(f1), g(f2))
    FMul(f0, f1, f2)         -> FMul(g(f0), g(f1), g(f2))
    FDiv(f0, f1, f2)         -> FDiv(g(f0), g(f1), g(f2))
    FNeg(f0, f1)             -> FNeg(g(f0), g(f1))
    FCmp(f0, f1)             -> FCmp(g(f0), g(f1))
    Scvtf(f0, f1)            -> Scvtf(g(f0), g(f1))
    Fcvtzs(f0, f1)           -> Fcvtzs(g(f0), g(f1))
    MovConst(f0, f1)         -> MovConst(g(f0), f1)
    Bl(f0, f1)               -> Bl(f0, f1)
    Blr(f0, f1)              -> Blr(g(f0), f1)
    CallArgs(f0, f1)         -> CallArgs(Array.map(f0, g), Array.map(f1, g))
    SafepointMap(f0, f1)     -> SafepointMap(f0, f1)
    Ret                      -> Ret
    B(f0)                    -> B(f0)
    BCond(f0, f1)            -> BCond(f0, f1)
    Cbz(f0, f1, f2)          -> Cbz(g(f0), f1, f2)
    Cbnz(f0, f1, f2)         -> Cbnz(g(f0), f1, f2)
    Allocate(f0, f1)         -> Allocate(g(f0), f1)
    AllocateArray(f0, f1, f2, f3) -> AllocateArray(g(f0), g(f1), g(f2), f3)
    Brk(f0)                  -> Brk(f0)
    MovN(f0, f1)             -> MovN(g(f0), f1)
    AddExt(f0, f1, f2)       -> AddExt(g(f0), g(f1), g(f2))
    SubExt(f0, f1, f2)       -> SubExt(g(f0), g(f1), g(f2))
}

-- Every register an instruction *writes*, physical ones included, folded
-- into `acc` in order; a visitor for the reason `anySrc` gives. A fold rather
-- than a predicate so that a caller can accumulate -- a mask of what is
-- written, say -- without capturing a `var`, which would cost a cell for
-- every instruction it is asked of.
--
-- `anyDef` is this filtered to the virtual ones, which is what liveness and
-- the verifier want. The allocator wants the unfiltered answer: a `mov x0, %5`
-- before a call writes a real `x0`, and any value the allocator has put in
-- `x0` and needs after that instruction has just been destroyed. Deriving all
-- of these from one match is the point -- a second sixty-armed `match` listing
-- the same destinations is exactly the kind of duplication that drifts.
fun foldDest(op : Arm, acc : a, f : fun(a, Reg) -> a) -> a = match op {
    Mov(d, _, _)        -> f(acc, d)
    MovZ(d, _, _)       -> f(acc, d)
    MovK(d, _, _)       -> f(acc, d)
    Add(d, _, _, _)     -> f(acc, d)
    AddImm(d, _, _, _)  -> f(acc, d)
    AddS(d, _, _, _)    -> f(acc, d)
    Sub(d, _, _, _)     -> f(acc, d)
    SubImm(d, _, _, _)  -> f(acc, d)
    SubS(d, _, _, _)    -> f(acc, d)
    AddSImm(d, _, _, _) -> f(acc, d)
    SubSImm(d, _, _, _) -> f(acc, d)
    Mul(d, _, _, _)     -> f(acc, d)
    SMulH(d, _, _)      -> f(acc, d)
    SDiv(d, _, _, _)    -> f(acc, d)
    MSub(d, _, _, _, _) -> f(acc, d)
    And(d, _, _, _)     -> f(acc, d)
    Orr(d, _, _, _)     -> f(acc, d)
    Eor(d, _, _, _)     -> f(acc, d)
    EorImm(d, _, _, _)  -> f(acc, d)
    AndImm(d, _, _, _)  -> f(acc, d)
    LslImm(d, _, _, _)  -> f(acc, d)
    LsrImm(d, _, _, _)  -> f(acc, d)
    AsrImm(d, _, _, _)  -> f(acc, d)
    Lsl(d, _, _, _)     -> f(acc, d)
    Lsr(d, _, _, _)     -> f(acc, d)
    Asr(d, _, _, _)     -> f(acc, d)
    Cmp(_, _, _)        -> acc
    CmpImm(_, _, _)     -> acc
    CSet(d, _)          -> f(acc, d)
    Sxtw(d, _)          -> f(acc, d)
    Uxtb(d, _)          -> f(acc, d)
    Uxth(d, _)          -> f(acc, d)
    Ubfx(d, _, _, _)    -> f(acc, d)
    Rbit(d, _)          -> f(acc, d)
    Clz(d, _)           -> f(acc, d)
    Ldr(d, _, _)        -> f(acc, d)
    Ldrb(d, _)          -> f(acc, d)
    Ldrsw(d, _)         -> f(acc, d)
    Str(_, _, _)        -> acc
    Strb(_, _)          -> acc
    Stp(_, _, _, _)     -> acc
    Ldp(a, b, _, _)     -> f(f(acc, a), b)
    Adrp(d, _)          -> f(acc, d)
    AddLo(d, _, _)      -> f(acc, d)
    FrameAddress(d, _)  -> f(acc, d)
    MovConst(d, _)      -> f(acc, d)
    FMov(d, _)          -> f(acc, d)
    FMovIn(d, _)        -> f(acc, d)
    FMovOut(d, _)       -> f(acc, d)
    FAdd(d, _, _)       -> f(acc, d)
    FSub(d, _, _)       -> f(acc, d)
    FMul(d, _, _)       -> f(acc, d)
    FDiv(d, _, _)       -> f(acc, d)
    FNeg(d, _)          -> f(acc, d)
    -- `fcmp` writes the flags and no register, which is exactly why the guard
    -- that reads it has to stay adjacent.
    FCmp(_, _)          -> acc
    Scvtf(d, _)         -> f(acc, d)
    Fcvtzs(d, _)        -> f(acc, d)
    Bl(_, _)            -> acc
    Blr(_, _)           -> acc
    CallArgs(_, outs)   -> foldIn(outs, acc, f)
    SafepointMap(_, _)  -> acc
    Ret                 -> acc
    B(_)                -> acc
    BCond(_, _)         -> acc
    Cbz(_, _, _)        -> acc
    Cbnz(_, _, _)       -> acc
    Allocate(d, _)      -> f(acc, d)
    AllocateArray(d, _, _, _) -> f(acc, d)
    Brk(_)              -> acc
    MovN(d, _)          -> f(acc, d)
    AddExt(d, _, _)     -> f(acc, d)
    SubExt(d, _, _)     -> f(acc, d)
}

-- Whether `p` holds of some register an instruction writes.
fun anyDest(op : Arm, p : fun(Reg) -> Bool) -> Bool =
    foldDest(op, False, fun(found, r) = found || p(r))

fun eachSrc(op : Arm, f : fun(Reg) -> Unit) -> Unit {
    let _ = anySrc(op, fun(r) {
        f(r)
        False
    })
}

fun eachDest(op : Arm, f : fun(Reg) -> Unit) -> Unit {
    let _ = anyDest(op, fun(r) {
        f(r)
        False
    })
}

fun anyMem(m : Mem, p : fun(Reg) -> Bool) -> Bool = match m {
    Offset(base, _)      -> p(base)
    Indexed(base, index) -> p(base) || p(index)
    RootSlot(_)          -> False
    SpillSlot(_)         -> False
    ObjectSlot(_, _)     -> False
    IncomingArg(_)       -> False
    OutgoingArg(_)       -> False
    PageOffset(base, _)  -> p(base)
}

fun anyIn(rs : Array Reg, p : fun(Reg) -> Bool) -> Bool {
    for r in rs { if p(r) { return True } }
    False
}

fun foldIn(rs : Array Reg, acc : a, f : fun(a, Reg) -> a) -> a {
    var out = acc
    for r in rs { out = f(out, r) }
    out
}

-- -- printing -----------------------------------------------------------------------

-- The assembly the system assembler accepts, which is the point: `as`
-- assembles what this prints, so it is the oracle for the encoder that comes
-- for an encoder that emits bytes directly. A printer that spelled something
-- `as` would reject would be a printer that could not check anything.
fun showReg(r : Reg, w : Width) -> String {
    let prefix = match w {
        W32 -> "w"
        W64 -> "x"
    }
    match r {
        Virtual(n) -> "%" + Int.toString(n)
        -- The bank decides the letter, not the width: a double is always
        -- `d`, and only the general file has a narrow spelling.
        Physical(Fp, n) -> "d" + Int.toString(n)
        Physical(Gp, 31) -> "xzr"
        Physical(Gp, n) -> if n == 29 { "x29" }
                           else if n == 30 { "x30" }
                           else { prefix + Int.toString(n) }
    }
}

fun condName(c : Cond) -> String = match c {
    Eq -> "eq"
    Ne -> "ne"
    Lt -> "lt"
    Le -> "le"
    Gt -> "gt"
    Ge -> "ge"
    Lo -> "lo"
    Ls -> "ls"
    Hi -> "hi"
    Hs -> "hs"
    Vs -> "vs"
    Vc -> "vc"
}

-- The condition that holds exactly when `c` does not. Exact on the flags, so
-- it is exact after `fcmp` too: an unordered comparison sets the flags, and
-- the inverse predicate reads the same flags the other way.
fun invert(c : Cond) -> Cond = match c {
    Eq -> Ne
    Ne -> Eq
    Lt -> Ge
    Ge -> Lt
    Le -> Gt
    Gt -> Le
    Lo -> Hs
    Hs -> Lo
    Ls -> Hi
    Hi -> Ls
    Vs -> Vc
    Vc -> Vs
}

instance Show Reg {
    fun show(r) = showReg(r, W64)
}

instance Show Mem {
    fun show(m) = match m {
        Offset(base, 0) -> "[" + baseName(base) + "]"
        Offset(base, n) -> "[" + baseName(base) + ", #" + Int.toString(n) + "]"
        Indexed(base, index) ->
            "[" + baseName(base) + ", " + showReg(index, W64) + "]"
        RootSlot(n) -> "[root " + Int.toString(n) + "]"
        SpillSlot(n) -> "[spill " + Int.toString(n) + "]"
        ObjectSlot(n, k) -> "[object " + Int.toString(n) + ", #" + Int.toString(k) + "]"
        IncomingArg(k) -> "[incoming " + Int.toString(k) + "]"
        OutgoingArg(k) -> "[outgoing " + Int.toString(k) + "]"
        PageOffset(base, sym) ->
            "[" + baseName(base) + ", " + Asm.pageOffset(sym) + "]"
    }
}

-- A base register is `sp` where a general register would be `xzr`: the same
-- encoding, read differently by the instruction, which is why `Reg` cannot
-- decide it alone.
fun baseName(r : Reg) -> String = match r {
    Physical(Gp, 31) -> "sp"
    other -> showReg(other, W64)
}

instance Show Inst {
    fun show(i) = showArm(i.op)
}

fun showArm(op : Arm) -> String = match op {
    Mov(d, a, w)           -> "mov " + showReg(d, w) + ", " + showReg(a, w)
    MovZ(d, v, shift)      -> "movz " + showReg(d, W64) + ", #" + Int.toString(v)
                              + (if shift == 0 { "" }
                                 else { ", lsl #" + Int.toString(shift) })
    MovK(d, v, shift)      -> "movk " + showReg(d, W64) + ", #" + Int.toString(v)
                              + (if shift == 0 { "" }
                                 else { ", lsl #" + Int.toString(shift) })
    Add(d, a, b, w)        -> three("add", d, a, b, w)
    AddImm(d, a, n, w)     -> stackImm("add", d, a, n, w)
    AddS(d, a, b, w)       -> three("adds", d, a, b, w)
    Sub(d, a, b, w)        -> three("sub", d, a, b, w)
    SubImm(d, a, n, w)     -> stackImm("sub", d, a, n, w)
    SubS(d, a, b, w)       -> three("subs", d, a, b, w)
    AddSImm(d, a, n, w)    -> imm("adds", d, a, n, w)
    SubSImm(d, a, n, w)    -> imm("subs", d, a, n, w)
    Mul(d, a, b, w)        -> three("mul", d, a, b, w)
    SMulH(d, a, b)         -> three("smulh", d, a, b, W64)
    SDiv(d, a, b, w)       -> three("sdiv", d, a, b, w)
    MSub(d, a, b, c, w)    -> "msub " + showReg(d, w) + ", " + showReg(a, w) + ", "
                              + showReg(b, w) + ", " + showReg(c, w)
    And(d, a, b, w)        -> three("and", d, a, b, w)
    Orr(d, a, b, w)        -> three("orr", d, a, b, w)
    Eor(d, a, b, w)        -> three("eor", d, a, b, w)
    EorImm(d, a, n, w)     -> imm("eor", d, a, n, w)
    AndImm(d, a, n, w)     -> imm("and", d, a, n, w)
    LslImm(d, a, n, w)     -> imm("lsl", d, a, n, w)
    LsrImm(d, a, n, w)     -> imm("lsr", d, a, n, w)
    AsrImm(d, a, n, w)     -> imm("asr", d, a, n, w)
    Lsl(d, a, b, w)        -> three("lsl", d, a, b, w)
    Lsr(d, a, b, w)        -> three("lsr", d, a, b, w)
    Asr(d, a, b, w)        -> three("asr", d, a, b, w)
    Cmp(a, b, w)           -> "cmp " + showReg(a, w) + ", " + showReg(b, w)
    CmpImm(a, n, w)        -> "cmp " + showReg(a, w) + ", #" + Int.toString(n)
    CSet(d, c)             -> "cset " + showReg(d, W64) + ", " + condName(c)
    Sxtw(d, a)             -> "sxtw " + showReg(d, W64) + ", " + showReg(a, W32)
    Uxtb(d, a)             -> "uxtb " + showReg(d, W32) + ", " + showReg(a, W32)
    Uxth(d, a)             -> "uxth " + showReg(d, W32) + ", " + showReg(a, W32)
    Rbit(d, a)             -> "rbit " + showReg(d, W64) + ", " + showReg(a, W64)
    Clz(d, a)              -> "clz " + showReg(d, W64) + ", " + showReg(a, W64)
    Ubfx(d, a, lsb, width) -> "ubfx " + showReg(d, W64) + ", " + showReg(a, W64)
                              + ", #" + Int.toString(lsb) + ", #"
                              + Int.toString(width)
    Ldr(d, m, w)           -> "ldr " + showReg(d, w) + ", " + show(m)
    Ldrb(d, m)             -> "ldrb " + showReg(d, W32) + ", " + show(m)
    Ldrsw(d, m)            -> "ldrsw " + showReg(d, W64) + ", " + show(m)
    Str(v, m, w)           -> "str " + showReg(v, w) + ", " + show(m)
    Strb(v, m)             -> "strb " + showReg(v, W32) + ", " + show(m)
    Stp(a, b, base, n)     -> "stp " + showReg(a, W64) + ", " + showReg(b, W64)
                              + ", [" + baseName(base) + ", #" + Int.toString(n)
                              + "]"
    Ldp(a, b, base, n)     -> "ldp " + showReg(a, W64) + ", " + showReg(b, W64)
                              + ", [" + baseName(base) + ", #" + Int.toString(n)
                              + "]"
    MovConst(d, n)         -> showConst(d, n)
    -- A virtual register prints as `%n` whichever bank it is in, so these read
    -- the same as their integer counterparts until the allocator has run.
    FMov(d, a)             -> "fmov " + fpName(d) + ", " + fpName(a)
    FMovIn(d, a)           -> "fmov " + fpName(d) + ", " + showReg(a, W64)
    FMovOut(d, a)          -> "fmov " + showReg(d, W64) + ", " + fpName(a)
    FAdd(d, a, b)          -> fp3("fadd", d, a, b)
    FSub(d, a, b)          -> fp3("fsub", d, a, b)
    FMul(d, a, b)          -> fp3("fmul", d, a, b)
    FDiv(d, a, b)          -> fp3("fdiv", d, a, b)
    FNeg(d, a)             -> "fneg " + fpName(d) + ", " + fpName(a)
    FCmp(a, b)             -> "fcmp " + fpName(a) + ", " + fpName(b)
    Scvtf(d, a)            -> "scvtf " + fpName(d) + ", " + showReg(a, W64)
    Fcvtzs(d, a)           -> "fcvtzs " + showReg(d, W64) + ", " + fpName(a)
    Adrp(d, sym)           -> "adrp " + showReg(d, W64) + ", " + Asm.page(sym)
    AddLo(d, a, sym)       -> "add " + showReg(d, W64) + ", " + showReg(a, W64)
                              + ", " + Asm.pageOffset(sym)
    -- After layout the slot is `sp` and an offset, or `sp` and the scratch
    -- register holding one too wide for an immediate.
    FrameAddress(d, m)     -> match m {
        Offset(base, n) -> "add " + showReg(d, W64) + ", " + baseName(base)
                           + ", #" + Int.toString(n)
        Indexed(base, index) -> "add " + showReg(d, W64) + ", " + baseName(base)
                                + ", " + showReg(index, W64)
        other -> "add " + showReg(d, W64) + ", " + show(other)
    }
    Bl(sym, _)             -> "bl " + Asm.spell(sym)
    Blr(a, _)              -> "blr " + showReg(a, W64)
    -- Printed as a comment: it has no encoding and exists to tell the register
    -- allocator what a call reads and writes.
    CallArgs(ins, outs)    -> "// call uses " + Int.toString(len(ins))
                              + " defs " + Int.toString(len(outs))
    SafepointMap(b, n)     -> "// safepoint " + Int.toString(b) + ":" + Int.toString(n)
    Ret                    -> "ret"
    B(target)              -> "b " + Asm.spell(target)
    BCond(c, target)       -> "b." + condName(c) + " " + Asm.spell(target)
    Cbz(a, target, w)      -> "cbz " + showReg(a, w) + ", " + Asm.spell(target)
    Cbnz(a, target, w)     -> "cbnz " + showReg(a, w) + ", " + Asm.spell(target)
    Allocate(d, a)         -> "// allocate " + showReg(d, W64) + ", class "
                              + Int.toString(a.sizeClass) + ", " + Asm.spell(a.slow)
    AllocateArray(d, n, v, a) -> "// allocate array " + showReg(d, W64) + ", "
                                 + showReg(n, W64) + " of " + showReg(v, W64) + ", "
                                 + Asm.spell(a.slow)
    Brk(n)                 -> "brk #" + Int.toString(n)
    MovN(d, n)             -> "movn " + showReg(d, W64) + ", #" + Int.toString(n)
    AddExt(d, a, b)        -> "add " + baseName(d) + ", " + baseName(a) + ", "
                              + showReg(b, W64)
    SubExt(d, a, b)        -> "sub " + baseName(d) + ", " + baseName(a) + ", "
                              + showReg(b, W64)
}

fun three(name : String, d : Reg, a : Reg, b : Reg, w : Width) -> String =
    name + " " + showReg(d, w) + ", " + showReg(a, w) + ", " + showReg(b, w)

fun imm(name : String, d : Reg, a : Reg, n : Int, w : Width) -> String =
    name + " " + showReg(d, w) + ", " + showReg(a, w) + ", #" + Int.toString(n)

-- `add` and `sub` with an immediate read register 31 as `sp`, which is how the
-- frame moves.
fun stackImm(name : String, d : Reg, a : Reg, n : Int, w : Width) -> String =
    match w {
        W32 -> imm(name, d, a, n, w)
        W64 -> name + " " + baseName(d) + ", " + baseName(a) + ", #" + Int.toString(n)
    }


-- A register in the vector file. The width is not a parameter because there is
-- only one: `W64` reaches `showReg`, which answers `d` for anything in `Fp`.
fun fpName(r : Reg) -> String = showReg(r, W64)

fun fp3(name : String, d : Reg, a : Reg, b : Reg) -> String =
    name + " " + fpName(d) + ", " + fpName(a) + ", " + fpName(b)

-- A constant, as the `movz` and `movk`s that build it.
--
-- Sixteen bits at a time, low half first, skipping the halves that are zero --
-- and emitting one `movz` even for zero, so that the sequence is never empty.
fun showConst(d : Reg, n : Int) -> String {
    let out = []
    var first = True
    for var shift = 0; shift < 64; shift = shift + 16 {
        let part = Int.and(Int.shr(n, shift), 0xFFFF)
        if part != 0 {
            let piece = Int.toString(part) + (if shift == 0 { "" }
                                              else { ", lsl #" + Int.toString(shift) })
            if first { Array.push(out, "movz " + showReg(d, W64) + ", #" + piece) }
            else { Array.push(out, "movk " + showReg(d, W64) + ", #" + piece) }
            first = False
        }
    }
    if first { return "movz " + showReg(d, W64) + ", #0" }
    String.join(out, "\n    ")
}
