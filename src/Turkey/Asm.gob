module Turkey.Asm (
    Asm(..), Dialect(..), Section(..), dialectFor, newAsm, symbolFor, runtimeFor,
    messageSymbol, literalSlot, globalSlot, globalSymbol, rootsSymbol,
    literalName, messageName, entrySymbol, globalsFrame, frameTableSymbol,
    localLabel, page, pageOffset, gotPage, gotOffset, section,
    functionType,
)

-- What the arm64 module owns: the names, and who gets a root slot.
--
-- This exists before the module emitter that will use it, and deliberately so.
-- Instruction selection cannot emit a string literal, a global or a panic
-- message without naming a symbol, and a name invented at the point of use is
-- a name a second place has to reproduce by convention -- which it will
-- eventually fail to do, silently, since a symbol that does not match is a link
-- error at best. The naming is written down once, here, and the emitter reads
-- it rather than agreeing with it.
--
-- Nothing here is shared with `Turkey.Llvm`, and that is correct rather than an
-- oversight: the two backends emit separate object files that are never linked
-- together, so their private symbols and their root arrays need not -- and
-- should not -- agree. What must agree is *this* module and the arm64 emitter,
-- which is why they are one file's worth of decisions rather than two.

import Data.Map as Map
import Turkey.LowIr as L
import Turkey.LowIr (Op(..))
import Turkey.Ssa as Ssa
import Turkey.Ssa (Rep(..), Func(..))
import Turkey.SsaLower as SsaLower
import Turkey.SsaLower (Module(..))
import Turkey.Target as Target

type Asm = Asm {
    -- String literal -> its index. Interned per module, so `ConstString` is a
    -- load of an already-decided cache and not an allocation.
    literals : Map String Int,
    -- Panic message -> its index.
    messages : Map String Int,
    -- Traced global -> its slot in the permanent root array.
    globals  : Map String Int,
    -- How many slots that array has: the traced globals, then one cache per
    -- literal.
    roots    : Int,
    dialect  : Dialect,
}

-- -- the dialect -----------------------------------------------------------------

-- The assembler syntax of the target's object format. The instructions, the
-- register allocation and the frame layout are the same on every arm64 target;
-- what differs is how a symbol is named, how its address is split into a page
-- and an offset, and what the sections are called. Every one of those is
-- answered below, by a `match` on this, and nowhere else.
type Dialect = MachO | Elf

fun dialectFor(t : Target.Target) -> Dialect = match t.os {
    "Linux" -> Elf
    _ -> MachO
}

-- The data a module emits, by what it holds rather than by its name in either
-- format.
type Section =
    -- Code.
    Text
    -- NUL-terminated C strings: the panic messages.
    | CStrings
    -- Read-only bytes: the string literals.
    | Constants
    -- Writable words: the globals and the root array.
    | Data
    -- Words the linker relocates and nothing writes afterwards: the frame
    -- table, which holds return addresses.
    | Relocated

fun section(d : Dialect, s : Section) -> String = match (d, s) {
    (_, Text) -> ".text"
    (MachO, CStrings) -> ".section __TEXT,__cstring,cstring_literals"
    (MachO, Constants) -> ".section __TEXT,__const"
    (MachO, Data) -> ".section __DATA,__data"
    (MachO, Relocated) -> ".section __DATA,__const"
    -- Not a mergeable string section: a panic message is the program's own
    -- text and may contain a zero byte, which would split it in two.
    (Elf, CStrings) -> ".section .rodata"
    (Elf, Constants) -> ".section .rodata"
    (Elf, Data) -> ".data"
    -- Writable while the dynamic linker relocates it, read-only afterwards. In
    -- a position-independent executable an absolute address is written at
    -- load time, which `.rodata` does not allow.
    (Elf, Relocated) -> ".section .data.rel.ro,\"aw\""
}

-- A symbol the assembler keeps out of the object's symbol table.
fun localLabel(d : Dialect, name : String) -> String = match d {
    MachO -> "L" + name
    Elf -> ".L" + name
}

-- The two halves of a symbol's address, `adrp`'s operand and then the `add`'s:
-- the 4KB page, and the offset within it.
fun page(d : Dialect, sym : String) -> String = match d {
    MachO -> sym + "@PAGE"
    Elf -> sym
}

fun pageOffset(d : Dialect, sym : String) -> String = match d {
    MachO -> sym + "@PAGEOFF"
    Elf -> ":lo12:" + sym
}

-- The same pair for a symbol reached through the global offset table: the page
-- of its entry, and the entry's offset, which the `ldr` reads the address from.
fun gotPage(d : Dialect, sym : String) -> String = match d {
    MachO -> sym + "@GOTPAGE"
    Elf -> ":got:" + sym
}

fun gotOffset(d : Dialect, sym : String) -> String = match d {
    MachO -> sym + "@GOTPAGEOFF"
    Elf -> ":got_lo12:" + sym
}

-- What marks a symbol as a function, if the format has such a thing. ELF's
-- tools read it -- a debugger, a profiler, `objdump` -- and Mach-O has no
-- equivalent.
fun functionType(d : Dialect, sym : String) -> Option String = match d {
    MachO -> None
    Elf -> Some(".type " + sym + ", %function")
}

-- A Turkey name as an assembler symbol.
--
-- **Quoted, and it has to be.** A Turkey name contains `#`, which is ARM
-- assembly's immediate prefix -- `bl _Main#main` is "unexpected token in
-- argument list" and not a call. Quoting takes the whole name through to the
-- object file's symbol table intact, which is the same answer `Turkey.Llvm`
-- reached with `@"..."` for a different reason: there, the character LLVM
-- refuses; here, the character the assembler reads as syntax.
--
-- The alternative is mangling, and it is worse for the reason it is always
-- worse: a crash report or an `nm` then shows a name the compiler invented
-- rather than the one the programmer wrote.
--
-- Mach-O puts an underscore before every C-level name and ELF does not, so
-- `turkey_print` in the C source is `_turkey_print` in a Mach-O object and
-- `turkey_print` in an ELF one.
fun symbolFor(d : Dialect, name : String) -> String =
    "\"" + cPrefix(d) + name + "\""

fun cPrefix(d : Dialect) -> String = match d {
    MachO -> "_"
    Elf -> ""
}

-- A runtime entry point. A C identifier needs no quoting, but gets it anyway:
-- one rule for how a symbol is written beats two and a test for which applies.
fun runtimeFor(d : Dialect, name : String) -> String = symbolFor(d, name)

-- Compiler-private data, named as local labels so these never reach the symbol
-- table.
fun literalName(d : Dialect, index : Int) -> String =
    localLabel(d, "str" + Int.toString(index))
fun messageName(d : Dialect, index : Int) -> String =
    localLabel(d, "msg" + Int.toString(index))

-- The permanent root array, which the collector scans for the whole run.
fun rootsSymbol(d : Dialect) -> String = cPrefix(d) + "turkey_module_roots"

-- The sequence that runs before the program's own: it interns the literals,
-- computes the globals and calls `main`. Global, and named, because
-- `Turkey.Entry` reaches it by its C symbol, `turkey_entry`.
fun entrySymbol(d : Dialect) -> String = runtimeFor(d, "turkey_entry")

-- The `RootFrame` covering the root array. Forty bytes -- previous,
-- function_name, count, values, live -- and it matches `runtime/turkey_runtime.c`
-- by layout rather than by name, which is the same agreement the mask store
-- at offset 32 rests on.
fun globalsFrame(d : Dialect) -> String = localLabel(d, "globals")

-- Every safepoint's roots, keyed by return address.
fun frameTableSymbol(d : Dialect) -> String = cPrefix(d) + "turkey_frame_table"

-- An untraced global is ordinary storage and gets its own symbol; a traced one
-- lives *in* the root array instead, so that storing to it and rooting it are
-- the same store.
fun globalSymbol(d : Dialect, name : String) -> String =
    symbolFor(d, "global." + name)

fun globalSlot(a : Asm, name : String) -> Option Int = Map.get(a.globals, name)

-- The message's symbol, interning it if this is the first mention.
fun messageSymbol(a : Asm, text : String) -> String {
    if !Map.contains(a.messages, text) {
        Map.put(a.messages, text, len(a.messages))
    }
    messageName(a.dialect, Map.getOr(a.messages, text, 0))
}

-- The root slot holding this literal's `TurkeyString`.
--
-- Every literal is interned before anything is selected, so this is a lookup
-- and not an assignment: a slot decided while emitting would depend on the
-- order functions were walked in, and two runs would disagree.
fun literalSlot(a : Asm, text : String) -> Int =
    Map.getOr(a.literals, text, 0) + len(a.globals)

-- The module's naming, decided up front.
--
-- The traced globals take the low slots and the literal caches the rest. Both
-- are roots for the same reason and for the whole run: a dictionary is a
-- global nothing holds in a stack frame, and a literal's `TurkeyString` is
-- allocated once by the entry sequence and never again -- a collector that
-- cannot see either frees them the first time it runs.
--
-- A scalar global holds nothing to trace and stays ordinary storage, which
-- also keeps the array dense: its length is the number of things the collector
-- must scan, not the number of globals.
fun newAsm(m : Module, dialect : Dialect) -> Asm {
    let globals = Map.new()
    var roots = 0
    for (name, r) in m.globals {
        if r.traced {
            Map.put(globals, name, roots)
            roots = roots + 1
        }
    }
    let literals = Map.new()
    for f in m.functions {
        for block in f.blocks {
            for i in block.insts {
                if let ConstString(text) = i.op {
                    if !Map.contains(literals, text) {
                        Map.put(literals, text, len(literals))
                    }
                }
            }
        }
    }
    Asm { literals = literals, messages = Map.new(), globals = globals,
          roots = roots + len(literals), dialect = dialect }
}
