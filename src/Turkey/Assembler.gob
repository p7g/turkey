export (
    Isa(..), Assembler, Use(..), Relocation(..), Definition(..), SectionData(..), Object(..),
    new, feed, finish, sectionOrder,
)

--- The emitter's stream as bytes: sections, the labels defined in them, and
--- the fields that refer to a label, for any instruction set and any object
--- format.
---
--- The instruction set comes in as an `Isa`: how an instruction becomes bytes,
--- which field of it refers to a symbol, and how that field is filled in once
--- addresses are known. Every field is a fixed size, so layout is one pass
--- that appends, and filling fields in is a second that patches in place; no
--- instruction ever changes length.
---
--- A field whose value depends only on the distance from the instruction to a
--- label in the same section -- a branch -- is filled in here, since that
--- distance is the same wherever the section is loaded. Everything else is
--- left as a `Relocation` for the format's writer: a page address depends on
--- where the 4KB boundaries fall, and a symbol defined elsewhere is not here at
--- all. Whether a field is resolved here or by the linker, it means the same.
---
--- **The line table.** As the system assembler does with `.file` and `.loc`,
--- this keeps the `SourceFile` items and a row for each `Loc`, and writes
--- `debug_line` and `debug_line_str` from them once every item is in
--- (`Turkey.Dwarf.lineTable`). A row is at the offset of the next instruction
--- or data item, or of the next `Loc` if one comes first; a label, an
--- alignment and zeros do not take it. That is where the system assembler puts
--- a `.loc`'s row, and the two tables are compared byte for byte. A debug
--- section is made only when an item names it, so a module that names none
--- has the same sections, in the same order, as one built without `-g`.
---
--- **Unwind information.** In the same way, each function's frame rules
--- (`Cfi`) are kept, and the sections an unwinder reads are written from them
--- at finish (`Turkey.Unwind`): on Mach-O, a compact unwind entry for every
--- function and a DWARF description in `__eh_frame` for one compact unwind
--- cannot encode; on ELF, `.eh_frame` for every function.

import Data.Set as Set
import Turkey.Asm as Asm
import Turkey.Asm (Symbol, SymbolKind(..))
import Turkey.Dwarf as Dwarf
import Turkey.Stream (Item(..), Cfi(..), fits32)
import Turkey.Unwind as Unwind

--- What the assembler needs to know about an instruction set, whose
--- instructions are `i` and whose fields that refer to a symbol are `f`.
type Isa i f = Isa {
    --- The instruction's bytes appended to the vector, and the field that
    --- refers to a symbol if there is one, which starts at the instruction's
    --- first byte.
    encode   : fun(i, Vec Byte) -> Option f,
    target   : fun(f) -> Symbol,
    --- Whether the field depends only on the distance to its target.
    relative : fun(f) -> Bool,
    --- Fill in the field at the offset given, for an instruction at the first
    --- address referring to the second.
    patch    : fun(f, Vec Byte, Int, Int, Int) -> Unit,
}

--- What a relocated field holds.
type Use f
    --- A field of an instruction.
    = Code(f)
    --- An eight-byte word holding the target's address.
    | Address64
    --- Four bytes holding the target's offset from the start of its section,
    --- which is in this object: a reference from one debug section into
    --- another.
    | Offset32
    --- Four bytes, or eight, holding the target's address less the field's
    --- own: a function's address in `.eh_frame`.
    | Relative32
    | Relative64

--- A field the linker fills in: at `offset` in its section, referring to
--- `target`.
type Relocation f = Relocation { offset : Int, use : Use f, target : Symbol }

--- A symbol defined at `offset` in section `section`, an index into
--- `Object.sections`. `exported` is the stream's `Global`; `function` its
--- `FunctionType`.
type Definition = Definition {
    symbol   : Symbol,
    section  : Int,
    offset   : Int,
    var exported : Bool,
    var function : Bool,
}

type SectionData f = SectionData {
    kind        : Asm.Section,
    bytes       : Vec Byte,
    --- As a power of two: the largest `Align` in the section.
    var align   : Int,
    relocations : Vec (Relocation f),
}

--- The assembled module. `defined` is in the order the labels were defined;
--- `undefined` holds every named symbol referred to and not defined, in the
--- order first referred to.
type Object f = Object {
    sections  : Array (SectionData f),
    defined   : Vec Definition,
    undefined : Vec Symbol,
}

-- A field waiting for its target to be defined.
type Pending f = Pending { section : Int, offset : Int, use : Use f, target : Symbol }

-- A four-byte field waiting for two labels in one section: `to`'s offset
-- less `from`'s.
type Distance = Distance { section : Int, offset : Int, to : Symbol, from : Symbol }

-- A function's frame rules, from its `StartProc` to its `EndProc`: the
-- section, a label the assembler made at its start, the named symbol defined
-- there if there is one, and its offsets and rules (`Unwind.Proc`).
type Frame = Frame {
    section  : Int,
    label    : Symbol,
    function : Option Symbol,
    start    : Int,
    var end  : Int,
    rules    : Vec (Int, Cfi),
}

type Assembler i f = Assembler {
    isa         : Isa i f,
    -- What the labels the assembler makes for itself are spelled for.
    dialect     : Asm.Dialect,
    -- Every section in `sectionOrder`, then each debug section in the order
    -- an item first names it. `slots` holds each kind's index, by
    -- `kindNumber`, or -1.
    sections    : Vec (SectionData f),
    slots       : Array Int,
    var current : Int,
    -- Every label, by its spelling, which tells a temporary from a named
    -- symbol of the same name.
    labels      : Map String Definition,
    defined     : Vec Definition,
    pending     : Vec (Pending f),
    distances   : Vec Distance,
    -- `Global` and `FunctionType` may come before the label they describe.
    exported    : Set.Set String,
    functions   : Set.Set String,
    -- The line table's source files, as their items gave them; each
    -- section's rows, by section index; and the sections that have rows, in
    -- the order of their first.
    files       : Vec (Int, Option String, String),
    rows        : Vec (Vec Dwarf.Row),
    sequenced   : Vec Int,
    -- The last `Loc`, until an item takes its row: its position, or -1, and
    -- whether it ends the prologue.
    var loc      : Int,
    var prologue : Bool,
    -- Every function's rules, in order; the last is open until its
    -- `EndProc`.
    frames       : Vec Frame,
    var open     : Bool,
}

--- The sections every object has, first and in this order, which is the
--- order the emitter fills them in.
let sectionOrder = [Asm.Text, Asm.CStrings, Asm.Constants, Asm.Data]

fun kindNumber(s : Asm.Section) -> Int = match s {
    Asm.Text -> 0
    Asm.CStrings -> 1
    Asm.Constants -> 2
    Asm.Data -> 3
    Asm.DebugAbbrev -> 4
    Asm.DebugInfo -> 5
    Asm.DebugStr -> 6
    Asm.DebugLine -> 7
    Asm.DebugLineStr -> 8
    Asm.DebugAddr -> 9
    Asm.DebugRnglists -> 10
    Asm.DebugLoclists -> 11
    Asm.DebugGdbScripts -> 12
    Asm.CompactUnwind -> 13
    Asm.EhFrame -> 14
}

let kinds = 15

--- An assembler for `isa`, whose own labels are spelled for `d`.
fun new(isa : Isa i f, d : Asm.Dialect) -> Assembler i f {
    let a = Assembler {
        isa = isa,
        dialect = d,
        sections = [],
        slots = Array.filled(kinds, -1),
        current = 0,
        labels = Map.new(),
        defined = [],
        pending = [],
        distances = [],
        exported = Set.new(),
        functions = Set.new(),
        files = [],
        rows = [],
        sequenced = [],
        loc = -1,
        prologue = False,
        frames = [],
        open = False,
    }
    for kind in sectionOrder { let _ = sectionIndex(a, kind) }
    a
}

-- The index of section `kind`, made empty if no item has named it yet.
fun sectionIndex(a : Assembler i f, kind : Asm.Section) -> Int {
    let n = kindNumber(kind)
    if a.slots[n] < 0 {
        a.slots[n] = len(a.sections)
        Vec.push(a.sections, SectionData { kind = kind, bytes = [], align = 0, relocations = [] })
        Vec.push(a.rows, [])
    }
    a.slots[n]
}

--- One piece of the stream, appended, and the array emptied as
--- `Stream.print` empties it.
fun feed(a : Assembler i f, items : Vec (Item i)) -> Unit {
    for item in items { feedItem(a, item) }
    Vec.clear(items)
}

fun feedItem(a : Assembler i f, item : Item i) -> Unit {
    let s = a.sections[a.current]
    if a.loc >= 0 && takesRow(item) {
        let rows = a.rows[a.current]
        if len(rows) == 0 { Vec.push(a.sequenced, a.current) }
        Vec.push(rows, Dwarf.Row { offset = len(s.bytes), at = a.loc, prologueEnd = a.prologue })
        a.loc = -1
    }
    match item {
        Architecture -> {}
        Section(kind) -> { a.current = sectionIndex(a, kind) }
        Global(sym) -> {
            Set.add(a.exported, Asm.spell(sym))
            if let Some(d) = Map.get(a.labels, Asm.spell(sym)) { d.exported = True }
        }
        FunctionType(sym) -> {
            Set.add(a.functions, Asm.spell(sym))
            if let Some(d) = Map.get(a.labels, Asm.spell(sym)) { d.function = True }
        }
        -- Zeros, in code as well: the emitter aligns code only to the
        -- instruction size it already has, so nothing executes the padding.
        Align(n) -> {
            if n > s.align { s.align = n }
            let size = 1 << n
            while len(s.bytes) % size != 0 { Vec.push(s.bytes, Byte.truncate(0)) }
        }
        Label(sym) -> define(a, sym)
        Instruction(i) -> {
            let at = len(s.bytes)
            if let Some(f) = a.isa.encode(i, s.bytes) {
                Vec.push(a.pending, Pending { section = a.current, offset = at, use = Code(f),
                                              target = a.isa.target(f) })
            }
        }
        Word(n) -> {
            let at = len(s.bytes)
            zeros(s.bytes, 8)
            Byte.putLE(s.bytes, at, 8, n)
        }
        WordOf(sym) -> {
            Vec.push(a.pending, Pending { section = a.current, offset = len(s.bytes),
                                          use = Address64, target = sym })
            zeros(s.bytes, 8)
        }
        Word32(n) -> {
            if !fits32(n) {
                error("internal error: " + Int.toString(n) + " does not fit in four bytes")
            }
            let at = len(s.bytes)
            zeros(s.bytes, 4)
            Byte.putLE(s.bytes, at, 4, n)
        }
        Space(n) -> zeros(s.bytes, n)
        Bytes(text) -> for b in String.bytes(text) { Vec.push(s.bytes, b) }
        CString(text) -> {
            for b in String.bytes(text) { Vec.push(s.bytes, b) }
            Vec.push(s.bytes, Byte.truncate(0))
        }
        Comment(_) -> {}
        Byte(n) -> Vec.push(s.bytes, Byte.truncate(n))
        Uleb(n) -> Dwarf.uleb(s.bytes, n)
        Difference(to, from) -> {
            Vec.push(a.distances, Distance { section = a.current, offset = len(s.bytes),
                                             to = to, from = from })
            zeros(s.bytes, 4)
        }
        UlebDifference(to, from) -> Dwarf.uleb(s.bytes, placedDistance(a, to, from))
        -- The section's start label is for the assembly's spelling of the
        -- offset; here the offset is the target's own.
        SectionOffset(label, _) -> {
            Vec.push(a.pending, Pending { section = a.current, offset = len(s.bytes),
                                          use = Offset32, target = label })
            zeros(s.bytes, 4)
        }
        SourceFile(n, directory, path) -> Vec.push(a.files, (n, directory, path))
        Loc(at, prologueEnd) -> {
            a.loc = at
            a.prologue = prologueEnd
        }
        Cfi(rule) -> frameRule(a, rule)
    }
}

-- Whether `item` takes the row a `Loc` before it starts: an instruction, any
-- data with bytes of its own, and the next `Loc`, so that two in a row each
-- leave one.
fun takesRow(item : Item i) -> Bool = match item {
    Instruction(_) | Word(_) | WordOf(_) | Word32(_) | Bytes(_) | CString(_) | Byte(_)
        | Uleb(_) | Difference(_, _) | UlebDifference(_, _) | SectionOffset(_, _)
        | Loc(_, _) -> True
    Architecture | Section(_) | Global(_) | FunctionType(_) | Align(_) | Label(_)
        | Space(_) | Comment(_) | SourceFile(_, _, _) | Cfi(_) -> False
}

-- A rule of the open function, or its start or end.
fun frameRule(a : Assembler i f, rule : Cfi) -> Unit {
    let s = a.sections[a.current]
    let at = len(s.bytes)
    match rule {
        StartProc -> {
            if a.open { error("internal error: a function's frame rules start inside another's") }
            let label = Asm.localLabel(a.dialect, "cfi" + Int.toString(len(a.frames)))
            -- The function's own symbol, when its label is the one just
            -- defined here.
            var function = None
            if len(a.defined) > 0 {
                let d = a.defined[len(a.defined) - 1]
                if d.section == a.current && d.offset == at {
                    if let Named = d.symbol.kind { function = Some(d.symbol) }
                }
            }
            defineAt(a, label, a.current, at)
            Vec.push(a.frames, Frame { section = a.current, label = label, function = function,
                                       start = at, end = at, rules = [] })
            a.open = True
        }
        EndProc -> {
            if !a.open { error("internal error: a function's frame rules end before they start") }
            a.frames[len(a.frames) - 1].end = at
            a.open = False
        }
        _ -> {
            if !a.open { error("internal error: a frame rule outside any function") }
            Vec.push(a.frames[len(a.frames) - 1].rules, (at, rule))
        }
    }
}

-- Returns the distance from `from` to `to`, both already placed in one
-- section.
fun placedDistance(a : Assembler i f, to : Symbol, from : Symbol) -> Int =
    match (Map.get(a.labels, Asm.spell(to)), Map.get(a.labels, Asm.spell(from))) {
        (Some(t), Some(f)) -> if t.section == f.section { t.offset - f.offset } else {
            error("internal error: the distance from " + Asm.spell(from) + " to "
                  + Asm.spell(to) + " crosses a section")
        }
        _ -> error("internal error: the distance from " + Asm.spell(from) + " to "
                   + Asm.spell(to) + " names a label not yet placed")
    }

fun zeros(bytes : Vec Byte, n : Int) -> Unit {
    for var k = 0; k < n; k = k + 1 { Vec.push(bytes, Byte.truncate(0)) }
}

fun define(a : Assembler i f, sym : Symbol) -> Unit =
    defineAt(a, sym, a.current, len(a.sections[a.current].bytes))

fun defineAt(a : Assembler i f, sym : Symbol, section : Int, offset : Int) -> Unit {
    let key = Asm.spell(sym)
    if Map.contains(a.labels, key) {
        error("internal error: the label " + key + " is defined twice")
    }
    let d = Definition { symbol = sym, section = section, offset = offset,
                         exported = Set.contains(a.exported, key),
                         function = Set.contains(a.functions, key) }
    Map.put(a.labels, key, d)
    Vec.push(a.defined, d)
}

--- The module, once every item has been fed: each field whose target is in
--- its own section and whose value is only a distance filled in, and the rest
--- left as relocations.
---
--- Section addresses are not known here, so a distance is computed between
--- offsets in one section, which is why only those fields are filled in.
fun finish(a : Assembler i f) -> Object f {
    if len(a.files) > 0 { lines(a) }
    if a.open { error("internal error: a function's frame rules never end") }
    if len(a.frames) > 0 {
        match a.dialect {
            Asm.MachO -> compactUnwind(a)
            Asm.Elf -> ehFrame(a, a.frames)
        }
    }
    -- Each distance is final here because a section's bytes stay together:
    -- the object never sets `MH_SUBSECTIONS_VIA_SYMBOLS`, and there is one
    -- section per kind, so the linker moves `__text` and `.text` whole and
    -- cannot strip or reorder what lies between two labels. Subsections, or
    -- dead-stripping within a section, would let the linker move a function
    -- or drop it, and every frame-table return address past it would name
    -- the wrong instruction. Either needs each distance left to the linker,
    -- as a `SUBTRACTOR` and `UNSIGNED` pair, so that it is computed after
    -- the code has moved.
    for p in a.distances {
        let bytes = a.sections[p.section].bytes
        match (Map.get(a.labels, Asm.spell(p.to)), Map.get(a.labels, Asm.spell(p.from))) {
            (Some(to), Some(from)) -> {
                if to.section != from.section {
                    error("internal error: the distance from " + Asm.spell(p.from) + " to "
                          + Asm.spell(p.to) + " crosses a section")
                }
                let distance = to.offset - from.offset
                if !fits32(distance) {
                    error("internal error: the distance from " + Asm.spell(p.from) + " to "
                          + Asm.spell(p.to) + " does not fit in four bytes")
                }
                Byte.putLE(bytes, p.offset, 4, distance)
            }
            _ -> error("internal error: the distance from " + Asm.spell(p.from) + " to "
                       + Asm.spell(p.to) + " names a label never defined")
        }
    }
    let undefined = []
    let seen = Set.new()
    for p in a.pending {
        let s = a.sections[p.section]
        let key = Asm.spell(p.target)
        match Map.get(a.labels, key) {
            Some(d) -> match p.use {
                Code(f) -> if d.section == p.section && a.isa.relative(f) {
                    a.isa.patch(f, s.bytes, p.offset, p.offset, d.offset)
                } else {
                    Vec.push(s.relocations, relocation(p))
                }
                Address64 | Offset32 | Relative32 | Relative64 ->
                    Vec.push(s.relocations, relocation(p))
            }
            None -> {
                if let Temporary = p.target.kind {
                    error("internal error: the label " + key + " is never defined")
                }
                if let Offset32 = p.use {
                    error("internal error: the section offset of " + key
                          + " names a symbol outside the object")
                }
                if !Set.contains(seen, key) {
                    Set.add(seen, key)
                    Vec.push(undefined, p.target)
                }
                Vec.push(s.relocations, relocation(p))
            }
        }
    }
    Object { sections = Vec.toArray(a.sections), defined = a.defined, undefined = undefined }
}

-- `debug_line`, after whatever the stream put there, and `debug_line_str`.
-- Each sequence's start address refers to a label made here at its first
-- row, and each path to a label at its string, so the object writers
-- relocate them as they would the stream's own.
fun lines(a : Assembler i f) -> Unit {
    let sequences = Vec.map(a.sequenced, fun(k) =
        Dwarf.Sequence { rows = a.rows[k], end = len(a.sections[k].bytes) })
    let t = Dwarf.lineTable(a.files, sequences)
    let line = sectionIndex(a, Asm.DebugLine)
    let strings = sectionIndex(a, Asm.DebugLineStr)
    let base = len(a.sections[line].bytes)
    for b in t.line { Vec.push(a.sections[line].bytes, b) }
    let stringsBase = len(a.sections[strings].bytes)
    for b in t.strings { Vec.push(a.sections[strings].bytes, b) }
    let named = Map.new()
    for (field, offset) in t.paths {
        let sym = match Map.get(named, offset) {
            Some(sym) -> sym
            None -> {
                let sym = Asm.localLabel(a.dialect, "debug_line_str" + Int.toString(len(named)))
                Map.put(named, offset, sym)
                defineAt(a, sym, strings, stringsBase + offset)
                sym
            }
        }
        Vec.push(a.pending, Pending { section = line, offset = base + field, use = Offset32,
                                      target = sym })
    }
    for var k = 0; k < len(a.sequenced); k = k + 1 {
        let sym = Asm.localLabel(a.dialect, "debug_line_sequence" + Int.toString(k))
        defineAt(a, sym, a.sequenced[k], sequences[k].rows[0].offset)
        Vec.push(a.pending, Pending { section = line, offset = base + t.addresses[k],
                                      use = Address64, target = sym })
    }
}

-- `__compact_unwind`: per function, its address, its length, its encoding,
-- and no personality or language-specific data. A function the encoding
-- cannot describe is described in `__eh_frame` as well.
fun compactUnwind(a : Assembler i f) -> Unit {
    let k = sectionIndex(a, Asm.CompactUnwind)
    let s = a.sections[k]
    s.align = 3
    let described = []
    for frame in a.frames {
        let encoding = Unwind.compactEncoding(frame.rules)
        if Unwind.dwarfMode(encoding) { Vec.push(described, frame) }
        let at = len(s.bytes)
        zeros(s.bytes, 32)
        Vec.push(a.pending, Pending { section = k, offset = at, use = Address64,
                                      target = frame.label })
        Byte.putLE(s.bytes, at + 8, 4, frame.end - frame.start)
        Byte.putLE(s.bytes, at + 12, 4, encoding)
    }
    if len(described) > 0 { ehFrame(a, described) }
}

-- `.eh_frame`, for `frames`. On Mach-O each function's address refers to its
-- own symbol, which the relocation has to name; on ELF, to the label at its
-- start, which the writer turns into its section's.
fun ehFrame(a : Assembler i f, frames : Vec Frame) -> Unit {
    let k = sectionIndex(a, Asm.EhFrame)
    let s = a.sections[k]
    s.align = 3
    let procs = Vec.map(frames, fun(frame) =
        Unwind.Proc { start = frame.start, end = frame.end, rules = frame.rules })
    let t = Unwind.ehFrame(a.dialect, procs)
    let base = len(s.bytes)
    for b in t.bytes { Vec.push(s.bytes, b) }
    for var n = 0; n < len(frames); n = n + 1 {
        let frame = frames[n]
        let (use, target) = match a.dialect {
            Asm.MachO -> match frame.function {
                Some(sym) -> (Relative64, sym)
                None -> error("internal error: a function described in __eh_frame has no symbol")
            }
            Asm.Elf -> (Relative32, frame.label)
        }
        Vec.push(a.pending, Pending { section = k, offset = base + t.addresses[n], use = use,
                                      target = target })
    }
}

fun relocation(p : Pending f) -> Relocation f =
    Relocation { offset = p.offset, use = p.use, target = p.target }
