module Turkey.Ast (
    Type(..), TypeKind(..),
    Pat(..), PatKind(..), Opening(..),
    Expr(..), ExprKind(..),
    Stmt(..), StmtKind(..),
    Lit(..), litKind, literalText,
    Arm(..),
    Pred(..), PredKind(..),
    FunDecl(..),
    ForeignDecl(..),
    ConDecl(..),
    TypeDecl(..),
    FamDecl(..),
    FamBind(..),
    ClassDecl(..),
    InstanceDecl(..),
    ExportItem(..),
    ModuleHeader(..),
    ImportDecl(..),
    Decl(..),
    Program(..),
    patternVars, freshNodeId, armBody, declBody,
    Child(..), children, exprChildren, stmtChildren,
    shorthandPrefix, isShorthand, sketch,
)

import Turkey.Types (ConCell)

-- Abstract syntax, as the compiler represents it.
--
-- Two decisions shape every node here, both forced by the language.
--
-- **A mutable record wrapping an immutable variant.** Multi-variant ADTs are
-- immutable and single-variant records are the mutable ones, so each syntactic
-- category is a record carrying a variant. `Desugar` rewrites a node by
-- assigning a new `kind` rather than building a new node, and the rewrite is
-- then visible through every reference already held -- which is what lets a
-- rewrite happen after the tree has been shared.
--
-- **An integer identity.** The tables that hold an expression's inferred type,
-- a use site's evidence and a group's dictionary abstraction all key on the
-- node, and there is no identity hash: a record has reference semantics but no
-- address a program can see. So the parser stamps a monotone `id` on every node
-- as it builds it, which is the only place nodes are made. A node without one
-- is a node inference cannot talk about.
--
-- Declarations are ordinary records: nothing rewrites one in place, and nothing
-- keys a table by one.

import Turkey.Source (Span)
import Turkey.Token (quote)

-- Where a node's `id` comes from.
--
-- Program-wide rather than per-file, and that is the whole point: the tables
-- keyed by it -- every expression's inferred type, a use site's evidence, a
-- group's dictionary abstraction -- hold a whole program at once, so an id that
-- restarted per file would have two nodes sharing an entry.
--
-- Never reset, and never printed. Uniqueness is all that is asked of it, and a
-- monotone counter gives that for as many programs as one process compiles.
var nextNodeId = 0

fun freshNodeId() -> Int {
    nextNodeId = nextNodeId + 1
    nextNodeId
}

-- -- literals ---------------------------------------------------------------------

type Lit
    = LInt(Int)
    | LFloat(Float)
    | LString(String)
    | LChar(Char)

-- The name the type of a literal goes by, which is what a dump prints and what
-- a literal pattern carries.
fun litKind(l : Lit) -> String = match l {
    LInt(_) -> "Int"
    LFloat(_) -> "Float"
    LString(_) -> "String"
    LChar(_) -> "Char"
}

-- A literal, spelled the way the language spells it rather than the host.
--
-- Every dump that prints a literal prints it through here, so they cannot
-- disagree. A float gets the shortest spelling that reads back as the same
-- float, and a string or char gets the language's escapes -- which is what
-- keeps a control character inside a literal from ending the line it is
-- printed on.
fun literalText(l : Lit) -> String = match l {
    LInt(n) -> Int.toString(n)
    LFloat(f) -> Float.toString(f)
    LString(s) -> quote(s)
    LChar(c) -> quote(Char.toString(c))
}

-- -- type syntax ------------------------------------------------------------------
--
-- What the author wrote. The semantic types inference manipulates are a
-- different thing entirely; see `Turkey.Types`.

type Type = Type {
    id   : Int,
    span : Span,
    kind : TypeKind,
}

type TypeKind
    = TEVar(String)
    | TECon(String, Array Type)
    -- An application whose head is a type *variable*. A named head keeps
    -- `TECon`, because that is also what an alias is looked up by, and an alias
    -- must be saturated where a constructor need not be.
    | TEApp(Type, Array Type)
    | TETuple(Array Type)
    | TEFun(Array Type, Type)

-- -- patterns ---------------------------------------------------------------------

type Pat = Pat {
    id      : Int,
    span    : Span,
    kind    : PatKind,
    -- What opening an existential constructor binds, set by inference on the
    -- `PCon` or `PRecord` that opens one.
    opening : Option Opening,
}

-- The dictionaries an opened existential carries, the rigid constants it hides,
-- and, once `Turkey.Layout` has copied the arm, the layouts this copy is for.
type Opening = Opening {
    evidence : Array String,
    skolems  : Array ConCell,
    layouts  : Option (Array String),
}

type PatKind
    = PVar(String)
    | PWild
    | PCon(String, Array Pat)
    -- The punning form `C { x }` is expanded to `x = x` by the parser, so a
    -- field is always a pair.
    -- The flag is a trailing `..`: the fields left unnamed are ignored on
    -- purpose. Without it every field must be named, so that adding a field to
    -- a declaration is an error in the patterns that claim to cover all of it.
    | PRecord(String, Array (String, Pat), Bool)
    | PLit(Lit)
    | PTuple(Array Pat)
    | PAnnot(Pat, Type)

-- -- expressions ------------------------------------------------------------------

type Expr = Expr {
    id   : Int,
    span : Span,
    kind : ExprKind,
}

type ExprKind
    = ELit(Lit)
    | EUnit
    -- The `Bool` is set when the parser wrote this node itself to mean a
    -- *class method* -- the `add` a `+` desugars to. Resolution leaves such a
    -- node alone, so a module defining its own `add` shadows the Prelude's for
    -- ordinary calls without quietly capturing every `+` in the file.
    | EVar(String, Bool)
    | ECon(String)
    | ETuple(Array Expr)
    | EArray(Array Expr)
    | ERecord(String, Array (String, Expr))
    | ELambda(Array Pat, Option Type, Expr)
    | ECall(Expr, Array Expr)
    -- The two trailing references are `Index`'s `get` and `set`, filled in by
    -- resolution and consumed by desugaring, which turns every bracket into
    -- the call it means. The parser writes `None` for both.
    | EIndex(Expr, Expr, Option Expr, Option Expr)
    | EField(Expr, String)
    | EProject(Expr, Int)
    -- The trailing `Option Expr` of each operator form is the method it means,
    -- as a marked reference. `!` is not a method and leaves it `None`.
    | EUnary(String, Expr, Option Expr)
    | EBinary(String, Expr, Expr, Option Expr)
    | EAnnot(Expr, Type)
    | EIf(Expr, Expr, Option Expr)
    | EWhile(Expr, Expr)
    -- The two trailing references are `Iterator`'s `iter` and `next`, so that
    -- solving demands `Iterator` of the sequence and elaboration hands the loop
    -- its dictionary without the loop being a special case anywhere.
    | EForIn(Pat, Expr, Expr, Option Expr, Option Expr)
    | EForC(Option Stmt, Expr, Option Stmt, Expr)
    | ELoop(Expr)
    | EMatch(Expr, Array Arm)
    | EReturn(Option Expr)
    | EBreak(Option Expr)
    | EContinue
    | EBlock(Array Stmt)
    | EQuestion(Expr, Option Expr)
    | EDo(Expr)

type Arm = Arm {
    span     : Span,
    patterns : Array Pat,
    body     : Expr,
}

-- -- statements -------------------------------------------------------------------

type Stmt = Stmt {
    id   : Int,
    span : Span,
    kind : StmtKind,
}

type StmtKind
    = SLet(Pat, Expr)
    | SVar(Pat, Expr)
    | SFun(FunDecl)
    | SAssign(Expr, Expr)
    | SExpr(Expr)

-- -- declarations -----------------------------------------------------------------

-- One constraint as written: `Ord a`, or an equality `Item c ~ Op`. The same
-- node serves a `fun`'s context, a class's superclass list and an instance's
-- context, because they all mean the same thing and differ only in where they
-- are attached.
type Pred = Pred {
    span : Span,
    kind : PredKind,
}

type PredKind
    = PClass(String, Type)
    | PEq(Type, Type)

-- A function, or -- with no body -- a bare signature, which is legal only
-- inside a `class`. A signature's parameters are types rather than binders, and
-- are still stored as patterns: a parameter of a stated type with no name is
-- exactly an annotated wildcard, so a method's type is read off a signature and
-- off a defaulted method by the same code.
type FunDecl = FunDecl {
    -- From the same supply as every other node's, so a table keyed by node id
    -- can hold declarations and expressions at once. What wants one is the
    -- dictionary abstraction a signature-checked `fun` is given, whose type is
    -- defined in a module above this one and so cannot be a field here.
    id      : Int,
    span    : Span,
    name    : String,
    params  : Array Pat,
    ret     : Option Type,
    body    : Option Expr,
    context : Array Pred,
    -- Set on the local `fun` a lifted loop becomes, and on nothing else. Such
    -- a function has one call site plus its own recursion, so there is nothing
    -- for a scheme to be used at twice. Generalizing one instead leaves a
    -- variable in the `Brk` slot that nothing can solve, which puts every
    -- lifted loop out of reach of the inliner. See `Turkey.Desugar.loopFun`.
    monomorphic : Bool,
    -- The C symbol a `foreign` definition is callable under (SPEC-DELTAS 74),
    -- and `None` for every other function. A definition is also
    -- `monomorphic`: its signature is a monotype by construction.
    symbol : Option String,
}

-- A function this compiler does not compile: a C symbol, and an assertion about
-- its signature that nothing can check.
--
-- Its own declaration rather than a `FunDecl` with no body, because a bodiless
-- `FunDecl` is a class method's signature and the two mean opposite things
-- about who supplies the code.
--
-- Parameters may be named, which a signature's cannot. The reason a signature
-- forbids it is the ambiguity `Turkey.Parser.funDecl` describes -- a bare
-- identifier is both a parameter name and a type variable, and only a body
-- decides which. A foreign signature states every parameter's type, with a
-- body or without (SPEC-DELTAS 74), so `x : T` is always a name and a bare `T`
-- always a type -- there is nothing to decide, and a declaration whose whole
-- hazard is getting the argument order wrong should be allowed to say what its
-- arguments are.
type ForeignDecl = ForeignDecl {
    span   : Span,
    -- The name Turkey binds.
    name   : String,
    -- The symbol C defines. Always written, even when it is spelled the same,
    -- so which of the two is which is never something a reader works out.
    symbol : String,
    params : Array Pat,
    ret    : Type,
}

-- One variant of a data type. Exactly one of `args` and `fields` is meaningful.
type ConDecl = ConDecl {
    span    : Span,
    name    : String,
    args    : Array Type,
    fields  : Option (Array (String, Type)),
    -- An existential constructor's bracket, as written: the bare variables it
    -- binds, and its class predicates.
    binders : Array String,
    context : Array Pred,
}

type TypeDecl = TypeDecl {
    span     : Span,
    name     : String,
    params   : Array String,
    variants : Option (Array ConDecl),
    alias    : Option Type,
}

-- `type Elem c` inside a class: an associated type family. Its argument must be
-- the class's own parameter -- there is nothing else in scope for it to be a
-- function of -- so its arity is one and the parameter is named rather than
-- implied.
type FamDecl = FamDecl {
    span  : Span,
    name  : String,
    param : String,
}

-- `type Elem = a` inside an instance: what the family is, here.
type FamBind = FamBind {
    span : Span,
    name : String,
    body : Type,
}

type ClassDecl = ClassDecl {
    span     : Span,
    name     : String,
    param    : String,
    supers   : Array Pred,
    methods  : Array FunDecl,
    families : Array FamDecl,
}

type InstanceDecl = InstanceDecl {
    span     : Span,
    cls      : String,
    head     : Type,
    context  : Array Pred,
    methods  : Array FunDecl,
    families : Array FamBind,
}

-- One entry of an export list, or of an import's `(...)` / `hiding (...)`.
-- `kind` is "name" for `f`, `T(A, B)` and `T(..)`, and "module" for the
-- re-export form, which names no entity of its own.
type ExportItem = ExportItem {
    span : Span,
    name : String,
    kind : String,
    subs : Option (Array String),
}

type ModuleHeader = ModuleHeader {
    span    : Span,
    name    : String,
    exports : Option (Array ExportItem),
}

type ImportDecl = ImportDecl {
    span      : Span,
    name      : String,
    alias     : Option String,
    items     : Option (Array ExportItem),
    -- `hidden`, not `hiding`: `hiding` is a reserved word and so cannot be a
    -- field name.
    hidden    : Option (Array ExportItem),
    qualified : Bool,
}

-- A top-level item. Statements are only `let`, `var` and `fun` up here; the
-- parser is what enforces that, not this type.
type Decl
    = DStmt(Stmt)
    | DType(TypeDecl)
    | DClass(ClassDecl)
    | DInstance(InstanceDecl)
    | DForeign(ForeignDecl)

type Program = Program {
    span    : Span,
    header  : Option ModuleHeader,
    imports : Array ImportDecl,
    decls   : Array Decl,
}

-- Every variable a pattern binds.
--
-- A structural question about the tree and nothing more, which is why it lives
-- here rather than in whichever stage happens to ask first: `Modules` wants a
-- `let`'s binders to know what a module declares, `Resolve` wants a match arm's
-- to know what is local, and `Infer` wants a parameter's.
fun patternVars(p : Pat) -> Array String {
    let out = Array.new(4)
    collectPatternVars(p, out)
    out
}

fun collectPatternVars(p : Pat, out : Array String) -> Unit = match p.kind {
    PVar(name) -> Array.push(out, name)
    PWild -> {}
    PLit(_) -> {}
    PCon(_, args) -> for a in args { collectPatternVars(a, out) }
    PRecord(_, fields, _) -> for (_, sub) in fields { collectPatternVars(sub, out) }
    PTuple(elems) -> for e in elems { collectPatternVars(e, out) }
    PAnnot(inner, _) -> collectPatternVars(inner, out)
}

-- -- the child enumerator -----------------------------------------------------------

-- Every `Expr`, `Stmt`, `Arm` or `FunDecl` directly under a node.
--
-- The method references the parser writes -- `EBinary`'s `add`, `EForIn`'s
-- `iter`, `EQuestion`'s `bind` -- are deliberately not children. Each is a bare
-- `EVar`, so no scanner's answer can depend on whether it is walked, and
-- leaving them out keeps this list to the syntax.
type Child
    = ChExpr(Expr)
    | ChStmt(Stmt)
    | ChArm(Arm)
    | ChFun(FunDecl)

fun children(c : Child) -> Array Child = match c {
    ChExpr(e) -> exprChildren(e)
    ChStmt(s) -> stmtChildren(s)
    ChArm(a) -> [ChExpr(armBody(a))]
    ChFun(f) -> match declBody(f) {
        Some(b) -> [ChExpr(b)]
        None -> []
    }
}

fun exprChildren(e : Expr) -> Array Child = match e.kind {
    ELit(_) -> []
    EUnit -> []
    EVar(_, _) -> []
    ECon(_) -> []
    EContinue -> []
    ETuple(xs) -> Array.map(xs, ChExpr)
    EArray(xs) -> Array.map(xs, ChExpr)
    ERecord(_, fields) -> fieldChildren(fields)
    ELambda(_, _, body) -> [ChExpr(body)]
    ECall(fn, args) -> Array.append([ChExpr(fn)], Array.map(args, ChExpr))
    EIndex(arr, index, _, _) -> [ChExpr(arr), ChExpr(index)]
    EField(obj, _) -> [ChExpr(obj)]
    EProject(obj, _) -> [ChExpr(obj)]
    EUnary(_, operand, _) -> [ChExpr(operand)]
    EBinary(_, left, right, _) -> [ChExpr(left), ChExpr(right)]
    EAnnot(inner, _) -> [ChExpr(inner)]
    EIf(cond, then, otherwise) ->
        Array.append([ChExpr(cond), ChExpr(then)], optExpr(otherwise))
    EWhile(cond, body) -> [ChExpr(cond), ChExpr(body)]
    EForIn(_, iterable, body, _, _) -> [ChExpr(iterable), ChExpr(body)]
    EForC(init, cond, step, body) ->
        Array.append(Array.append(optStmt(init), [ChExpr(cond)]),
                     Array.append(optStmt(step), [ChExpr(body)]))
    ELoop(body) -> [ChExpr(body)]
    EMatch(scrutinee, arms) ->
        Array.append([ChExpr(scrutinee)], Array.map(arms, ChArm))
    EReturn(value) -> optExpr(value)
    EBreak(value) -> optExpr(value)
    EBlock(stmts) -> Array.map(stmts, ChStmt)
    EQuestion(inner, _) -> [ChExpr(inner)]
    EDo(body) -> [ChExpr(body)]
}

fun stmtChildren(s : Stmt) -> Array Child = match s.kind {
    SLet(_, value) -> [ChExpr(value)]
    SVar(_, value) -> [ChExpr(value)]
    SFun(d) -> [ChFun(d)]
    SAssign(target, value) -> [ChExpr(target), ChExpr(value)]
    SExpr(e) -> [ChExpr(e)]
}

-- The expression an arm holds, and the body a declaration holds. Named because
-- three modules ask -- `children` below, `Infer.diverges`, `Desugar`'s rewrite
-- -- not because either is more than the field access it reads as.
fun armBody(a : Arm) -> Expr {
    a.body
}

fun declBody(d : FunDecl) -> Option Expr {
    d.body
}

fun fieldChildren(fields : Array (String, Expr)) -> Array Child {
    Array.map(fields, fun((_, value)) = ChExpr(value))
}

fun optExpr(e : Option Expr) -> Array Child = match e {
    Some(x) -> [ChExpr(x)]
    None -> []
}

fun optStmt(s : Option Stmt) -> Array Child = match s {
    Some(x) -> [ChStmt(x)]
    None -> []
}

-- -- lambda shorthand ---------------------------------------------------------------

-- What the parser names the parameter of a function made by `_` or `\`, with a
-- counter after it. A `%` cannot be written in a program, so the name cannot
-- capture one the body uses, and the prefix is how a later stage recognises
-- the function as shorthand.
let shorthandPrefix = "%it"

fun isShorthand(e : Expr) -> Bool = match e.kind {
    ELambda(params, _, _) -> len(params) == 1 && match params[0].kind {
        PVar(name) -> String.startsWith(name, shorthandPrefix)
        _ -> False
    }
    _ -> False
}

-- An expression as source, near enough for a diagnostic to show what `_` made:
-- `fun($x) = pow($x, 2)`, with the parameter spelled the way the reference
-- spells a hidden name. Operators are parenthesized by precedence, so the text
-- groups the way the tree does. Anything with a block in it is `...`, since
-- the point is the extent of a short function and not a listing.
fun sketch(e : Expr) -> String = sketchAt(e, 0)

-- The operator levels of the grammar, loosest first; a postfix form is 7 and
-- an atom 8.
fun opLevel(op : String) -> Int = match op {
    "||" -> 0
    "&&" -> 1
    "==" | "!=" -> 2
    "<" | "<=" | ">" | ">=" -> 3
    "+" | "-" -> 4
    _ -> 5
}

fun sketchAt(e : Expr, need : Int) -> String {
    let (text, level) = sketchLevel(e)
    if level < need { "(" + text + ")" } else { text }
}

fun sketchList(xs : Array Expr) -> String =
    String.join(Array.map(xs, fun(x) = sketchAt(x, 0)), ", ")

fun sketchName(name : String) -> String =
    if String.startsWith(name, shorthandPrefix) { "$x" } else { name }

fun sketchLevel(e : Expr) -> (String, Int) = match e.kind {
    ELit(l) -> (literalText(l), 8)
    EUnit -> ("()", 8)
    EVar(name, _) -> (sketchName(name), 8)
    ECon(name) -> (name, 8)
    ETuple(xs) -> ("(" + sketchList(xs) + ")", 8)
    EArray(xs) -> ("[" + sketchList(xs) + "]", 8)
    ERecord(name, fields) -> {
        let shown = Array.map(fields, fun((f, v)) = f + " = " + sketchAt(v, 0))
        (name + " { " + String.join(shown, ", ") + " }", 8)
    }
    ELambda(params, _, body) -> {
        let names = Array.map(params, fun(p) = match p.kind {
            PVar(name) -> sketchName(name)
            _ -> "..."
        })
        ("fun(" + String.join(names, ", ") + ") = " + sketchAt(body, 0), 0)
    }
    ECall(fn, args) -> (sketchAt(fn, 7) + "(" + sketchList(args) + ")", 7)
    EIndex(arr, index, _, _) -> (sketchAt(arr, 7) + "[" + sketchAt(index, 0) + "]", 7)
    EField(obj, name) -> (sketchAt(obj, 7) + "." + name, 7)
    EProject(obj, n) -> (sketchAt(obj, 7) + "." + Int.toString(n), 7)
    EQuestion(inner, _) -> (sketchAt(inner, 7) + "?", 7)
    EUnary(op, operand, _) -> (op + sketchAt(operand, 6), 6)
    EBinary(op, left, right, _) -> {
        let level = opLevel(op)
        (sketchAt(left, level) + " " + op + " " + sketchAt(right, level + 1), level)
    }
    EAnnot(inner, _) -> sketchLevel(inner)
    _ -> ("...", 8)
}
