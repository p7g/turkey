module Turkey.Build (Build(..), plain, flag, chosen)

-- What a compile fixes besides the target, from `boot`'s command line.
--
-- Two of them are the runtime's debugging aids. Each is a primitive the
-- runtime reads as a `Bool`, and lowering writes the constructor in its place,
-- as it does for `Target.os`. So a program compiled without one has the flag
-- as a constant, the optimizer deletes what it guards, and reachability drops
-- what only that reached: the heap verifier, most of `Turkey.HeapCheck`, and
-- the statistics, about a quarter of `Turkey.Heap`. Between them they are most
-- of a small program's code.
--
-- Flags rather than environment variables because the compiler is itself a
-- program with a runtime: `TURKEY_GC_VERIFY` set for a compile would be read
-- by the compiler's own heap as well as asked of the program it compiles.
import Turkey.Prelude as Prelude

type Build = Build {
    -- `--gc-verify`: check the heap at every collection.
    gcVerify      : Bool,
    -- `--gc-stats`: count allocations and collections, and report them.
    gcStats       : Bool,
    -- `--export-runtime`: keep every `foreign` definition, for a program that
    -- C drives without running it, as the runtime's own tests do
    -- (`Turkey.Mono.runtimeRoots`).
    exportRuntime : Bool,
}

let plain = Build { gcVerify = False, gcStats = False, exportRuntime = False }

-- `b` with the command-line flag `name` set, or `None` if it is not one.
fun flag(b : Build, name : String) -> Option Build = match name {
    "--gc-verify" -> Some(Build { gcVerify = True, gcStats = b.gcStats,
                                  exportRuntime = b.exportRuntime })
    "--gc-stats" -> Some(Build { gcVerify = b.gcVerify, gcStats = True,
                                 exportRuntime = b.exportRuntime })
    "--export-runtime" -> Some(Build { gcVerify = b.gcVerify, gcStats = b.gcStats,
                                       exportRuntime = True })
    _ -> None
}

-- The constructor a build primitive stands for, as an internal name, or
-- `None` for any other name.
fun chosen(b : Build, name : String) -> Option String = match name {
    "Prim.gcVerify" -> Some(boolean(b.gcVerify))
    "Prim.gcStats" -> Some(boolean(b.gcStats))
    _ -> None
}

fun boolean(value : Bool) -> String =
    if value { Prelude.boolTrue } else { Prelude.boolFalse }
