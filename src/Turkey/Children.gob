export (runSelf)

--- Runs this program again, as child processes.
---
--- WASI has no processes to start, so a wasm program must not reach this
--- module: call it only from an arm of a `match` on `Target.os` that is not
--- `Wasi`.

-- This is a module of its own, apart from `Main`, because reachability after
-- the optimizer keeps every function of a program's own modules but drops the
-- implementation's that nothing reaches. On a wasm target the optimizer
-- removes the arm that calls `runSelf`, and reachability then drops it, so the
-- compiler built for wasm holds no call to `Process.run`.

import Process as Process
import System.Env as Env
import System.Parallel as Parallel

--- Runs this program once for each of `argvs`, the arguments after its own
--- path, all at once, and waits for every run to end. Returns each run's exit
--- status and what it wrote to standard error, in the order of `argvs`, with
--- -1 for a run that did not exit, as one a signal ended. Returns why when
--- this program's executable cannot be found or a run cannot be started.
fun runSelf(argvs : Vec (Array String)) -> Either String (Vec (Int, String)) {
    let self = match Env.executablePath() {
        Some(path) -> path
        None -> return Left("cannot find this program's own executable")
    }
    let runs = Parallel.map(argvs, fun(argv) =
        Process.run(Process.command(Array.append([self], argv)), None))
    let outcomes = []
    for var i = 0; i < len(runs); i = i + 1 {
        let out = match runs[i] {
            Right(o) -> o
            Left(e) -> return Left("cannot run '" + String.join(Array.append([self], argvs[i]), " ")
                                   + "': " + message(e))
        }
        let status = match out.status {
            Process.Exited(n) -> n
            _ -> -1
        }
        Vec.push(outcomes, (status, String.fromBytesLossy(out.stderr)))
    }
    Right(outcomes)
}
