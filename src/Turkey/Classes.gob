export (
    Evidence(..), MethodImpl(..), InstancePlan(..), newInstancePlan,
    MethodInfo(..), hasDefault, methodDicts, methodEqualities, methodEvidence,
    ClassInfo(..), classKind,
    InstInfo(..), instCon, instHeadKey, typedSuffix, showDeclared, writtenNamer,
    ClassTable(..), newClassTable,
    Derivation(..), derivedMethod, derive, checkDerives, whyMissing,
    Slot(..), dictSlots, slotAt, superSlot, methodSlot, keyedSlot, slotName,
    registerAll, resolveContext,
    reduceFam,
    uncovered,
    bySuper, superEqualities, equalityAt, openedPreds,
    byInst, selectInstance, contextAt, equalitiesAt, provenEqualities, contextPreds,
    entail, prove, superPath, isClass, method, minimal,
    fieldClass, setterClass, fieldFamily, projectionClass, projectionFamily,
    generatedLabel, setterLabel, generatedIndex, fieldFamilyOwner, isGenerated, accessor,
    ensureGenerated, synthesize,
    match_, matches,
    Skolems(..), newSkolems, skolemBind, skolemApply, skolemApplyPred,
    surfaceMember, memberNamed,
    showClasses,
)

-- Single-parameter type classes: declaration, the instance table, entailment
-- (`turkey/classes.py`).
--
-- The shape is Jones's, from "Typing Haskell in Haskell": `bySuper` walks a
-- predicate's superclass closure, `byInst` matches it against the instance
-- table and answers that instance's own obligations, and `entail` puts the two
-- together.
--
-- Three restrictions hold it up, and each buys something:
--
-- * **One parameter.** With a single class variable, ambiguity is the plain
--   free-variable test -- a quantified variable a predicate mentions and the
--   type does not is unresolvable, full stop. Multi-parameter classes need
--   functional dependencies before that test says anything useful, and an
--   associated family makes the second parameter unnecessary: `Elem c` is the
--   element type of a container, computed rather than quantified.
-- * **An instance head is a constructor applied to distinct type variables.**
--   Matching is then a one-way structural walk that cannot fail to terminate,
--   and two instances of a class overlap exactly when they name the same
--   constructor -- so the check is a lookup rather than a unification test.
-- * **A superclass constrains the class variable itself.** `class Monoid a :
--   Semigroup a` may not say `Semigroup (Array a)`, so `bySuper` substitutes by
--   simply carrying the predicate's argument across.
--
-- **Skolems are nullary constructors.** Checking an instance method against the
-- class's signature requires the method to be polymorphic in everything the
-- instance does not fix, and a fresh unification variable would happily be
-- narrowed by a body that is *less* general than it claims. So the quantified
-- variables are replaced by rigid nullary constructors named after them --
-- `unify` already treats one as rigid and compares by name, so this needs no
-- new machinery, and the name means an error about one reads as though it were
-- still the type variable the author wrote.
--
-- **A family is `byInst` for types.** `reduceFam` matches a family application
-- against the same instance table, by the same one-way match, and answers what
-- that instance said the family is. Failing to match is *stuck*, never false:
-- the class predicate that travels beside every family application is what
-- reports a missing instance, with the better message.
--
-- ## Why the evidence types are here
--
-- `FromInstance` holds the instance whose dictionary it is, and an instance
-- holds the plan for building that dictionary, which is made of evidence. In
-- so the two are mutually recursive. There are no mutually recursive modules,
-- which is why they are one module rather than two. The *elaborator* is still
-- separate: what is merged here is the data, not the algorithm.

import Data.Set as Set
import Turkey.Ast (Pred as _, ..)
-- `Pred` below is the semantic predicate; the syntactic one a context is
-- written as is `Ast.Pred`.
import Turkey.Ast as Ast
import Turkey.Decls as Decls
import Turkey.Decls (DeclTable(..), FamilyInfo(..), ConInfo(..), TyconInfo(..))
import Turkey.Diag as Diag
import Turkey.Prelude as P
import Turkey.Source as Source
import Turkey.Source (Span)
import Turkey.Types as Ty
import Turkey.Types (Kind(..), VarCell(..), ConCell(..), Scheme(..), Pred(..),
                     TVar, TCon, TApp, TFam, TFun, TTuple,
                     TSet, TBottom)

-- -- evidence ----------------------------------------------------------------------

type Evidence
    -- A dictionary already in scope, reached through zero or more superclasses.
    -- The `Array String` is the chain of superclass names to walk: `Semigroup a`
    -- from a `Monoid a` parameter is `["Semigroup"]`. A superclass edge is a
    -- *selection*, not a lookup, which is what makes `class Monoid a : Semigroup
    -- a` mean the dictionary carries its superclass rather than the caller
    -- passing both. The predicate of the parameter itself is kept because
    -- looking its type up later by generated name is fragile when evidence is
    -- completed away from a use site.
    = FromDict(String, Array String, Option Pred)
    -- The dictionary of an instance at the class argument it was selected
    -- for, given evidence for that instance's context. `instance Semigroup
    -- (Array a)` is a *function* from a `Semigroup a` dictionary to a
    -- `Semigroup (Array a)` one. The map is the match that selected it, from
    -- each of the head's variables to a type, against the argument as the
    -- solver rewrote it by the equalities in scope: `Add Int` for a demand
    -- `Add (Elem a)` under `Elem a ~ Int`.
    | FromInstance(InstInfo, Map Int Ty.Type, Array Evidence)
    -- A predicate whose argument is bottom, and so has no instance to find. The
    -- mirror of the same rule in the solver: bottom is absorbed by whatever it
    -- meets, so there is no type to look up and no value that would ever ask
    -- for a method.
    | Absent(String)

-- One method body, and the names its dictionaries arrive under.
--
-- `selfName` is the dictionary the body belongs to -- the instance's own, or for
-- a default the one the class is being defaulted into. It is bound when the
-- dictionary is built, which is why a default method may call another method of
-- its own class without anything being passed.
--
-- `dictParams` are the method's *own* context, which is per call rather than per
-- instance and so arrives as arguments.
--
-- `skolems` records which rigid constant stands for which quantified variable
-- while this body is checked. A method body is checked against skolems -- the
-- instance's variables *and* the method's own -- so every type recorded inside
-- it names constants, while the type the class declares names variables. They
-- are the same types, and this is the only record of which is which.
type MethodImpl = MethodImpl {
    decl       : FunDecl,
    selfName   : String,
    dictParams : Vec String,
    skolems    : Map Int Ty.Type,
}

-- Everything the evaluator needs to build one instance's dictionary.
type InstancePlan = InstancePlan {
    params  : Vec String,
    methods : Map String MethodImpl,
    supers  : Map String Evidence,
}

fun newInstancePlan(params : Vec String) -> InstancePlan =
    InstancePlan { params = params, methods = Map.new(), supers = Map.new() }

-- -- the tables --------------------------------------------------------------------

-- One method of one class, as a scheme any use site can instantiate.
--
-- The scheme's first predicate is the class's own -- `combine` is
-- `[Semigroup a] fun(a, a) -> a` -- which is what makes a method call demand an
-- instance without the caller doing anything special.
type MethodInfo = MethodInfo {
    name     : String,
    cls      : String,
    scheme   : Scheme,
    decl     : FunDecl,
    classVar : VarCell,
    -- Quantified variable id -> the name it was written as.
    names    : Map Int String,
}

fun hasDefault(m : MethodInfo) -> Bool = Option.isSome(m.decl.body)

-- Returns the method's own context that arrives as dictionaries, per call:
-- its class predicates, in order.
fun methodDicts(m : MethodInfo) -> Vec Pred {
    let out = Vec.new(len(m.scheme.preds))
    for var i = 1; i < len(m.scheme.preds); i = i + 1 {
        if m.scheme.preds[i].name != Ty.equals {
            Vec.push(out, m.scheme.preds[i])
        }
    }
    out
}

-- Returns the method's own equalities, in order: each a fact its body may use
-- and every caller must prove.
fun methodEqualities(m : MethodInfo) -> Vec Pred =
    Vec.filter(m.scheme.preds, fun(p) = p.name == Ty.equals)

-- Returns the method's own context as the parameters a call passes: its class
-- predicates, then its equalities, each in order.
fun methodEvidence(m : MethodInfo) -> Vec Pred = Vec.append(methodDicts(m), methodEqualities(m))

type ClassInfo = ClassInfo {
    name     : String,
    param    : String,
    -- The class variable, shared by every method's scheme. Not `var`, which
    -- is a reserved word and so cannot name a field.
    cvar     : VarCell,
    supers   : Vec Pred,
    -- The equalities among the superclasses, over `cvar`, in the order the
    -- class declares them: each a fact a given `C t` grants at `t`, and one
    -- every instance proves at its head.
    equalities : Vec Pred,
    methods  : Map String MethodInfo,
    span     : Option Span,
    -- Which module declared it, for the orphan rule.
    module_  : String,
    -- Family name -> the parameter it was written over. The types themselves
    -- live in the declaration table, because a family is a name in type
    -- position and one table decides what those mean.
    families : Map String String,
    -- Method name -> the elaborated default body, shared by every instance that
    -- does not override it. Filled in by the generator.
    defaults : Map String MethodImpl,
}

fun classKind(info : ClassInfo) -> Kind = info.cvar.kind

type InstInfo = InstInfo {
    cls      : String,
    head     : Ty.Type,
    -- The class predicates of the context, one per dictionary parameter, in
    -- order.
    context  : Vec Pred,
    -- The equalities of the context, one per coercion parameter, in order.
    -- They follow the dictionaries, and every use proves them at its types.
    equalities : Vec Pred,
    decl     : InstanceDecl,
    names    : Map Int String,
    -- Family name -> what it is at this head, over the head's own variables.
    families : Map String Ty.Type,
    -- What the evaluator needs to build this dictionary. Set by the generator
    -- once the method bodies are checked.
    var plan : Option InstancePlan,
    -- The module that declared it, for the orphan rule.
    module_  : String,
    -- Whether the compiler built it from a type declaration's derive list,
    -- with the method `derivedMethod` names left for the lowering to write.
    derived  : Bool,
}

fun instCon(inst : InstInfo) -> String {
    let (h, _) = Ty.spine(inst.head)
    match h {
        TCon(c) -> c.name
        TTuple(elems) -> "Tuple" + Int.toString(len(elems))
        _ -> bug("validated instance head has no stable key", None)
    }
}

-- Returns `cls head` as an instance declaration writes it, with the head
-- parenthesized where it needs to be: `Iterator (Bag a)`.
fun showInstance(cls : String, head : Ty.Type) -> String =
    cls + " " + Ty.showAt(head, Ty.namer(""), 2)

-- Returns a namer that calls each of an instance's variables what the
-- declaration does, and a family bare, as a context writes it.
fun writtenNamer(names : Map Int String) -> Ty.Namer {
    let n = Ty.namer("")
    for (id, name) in Map.entries(names) { Map.put(n.names, id, name) }
    n.bare = True
    n
}

-- Returns `inst` as its declaration writes it, with the declaration's own
-- variable names: `Source (Layer s)`.
fun showDeclared(inst : InstInfo) -> String =
    inst.cls + " " + Ty.showAt(inst.head, writtenNamer(inst.names), 2)

fun instHeadKey(t : Ty.Type) -> String {
    let (h, _) = Ty.spine(t)
    match h {
        TCon(c) -> "con " + c.name
        TTuple(elems) -> "tuple " + Int.toString(len(elems))
        _ -> bug("instance head was not shape-checked", None)
    }
}

type ClassTable = ClassTable {
    decls     : DeclTable,
    classes   : Map String ClassInfo,
    instances : Map String (Vec InstInfo),
    -- Method name -> owning class. Methods share the value namespace with
    -- ordinary functions, so this is also what detects a collision.
    owner     : Map String String,
    -- Class -> the keyed slots `Turkey.Layout` adds to its dictionaries, as
    -- (method, layout key), in slot order. Empty until Layout settles, and
    -- written once when it does. See `dictSlots`.
    keyed     : Map String (Vec (String, String)),
    -- Set by `Turkey.Erase` once it has removed every coercion: from then on
    -- a dictionary has no `EqualitySlot`. See `dictSlots`.
    var erased : Bool,
    -- How far deriving each instance got, by `derivationKey`. See `derive`.
    derivations : Map String Derivation,
    -- The keys of the derivations begun since the outermost one still
    -- running began, which its failure takes back.
    provisional : Vec String,
    -- Whether a call of `derive` is running, which settles any derivation
    -- begun inside it.
    var deriving : Bool,
}

fun newClassTable(decls : DeclTable) -> ClassTable = ClassTable {
    decls = decls,
    classes = Map.new()
    instances = Map.new()
    owner = Map.new()
    keyed = Map.new()
    erased = False
    derivations = Map.new()
    provisional = []
    deriving = False
}

-- -- dictionary slots ---------------------------------------------------------------

-- What one slot of a class's dictionary holds.
type Slot
    -- The dictionary of a superclass, by the superclass's name.
    = SuperSlot(String)
    -- The evidence for an equality superclass, by its position in
    -- `ClassInfo.equalities`. Zero-width, and gone after `Turkey.Erase`.
    | EqualitySlot(Int)
    -- A method, by its qualified name.
    | MethodSlot(String)
    -- A method polymorphic in its own variables, compiled at one layout key for
    -- them. A closure is compiled at one set of layouts, so a dictionary that a
    -- call reads without knowing it carries the method once per key such calls
    -- ask for (`Turkey.Layout`).
    | KeyedSlot(String, String)

-- A class's dictionary, slot by slot: its class superclasses in the order the
-- class declares them, then its equality superclasses in the same order, then
-- its methods ordered by name, then the keyed copies `Turkey.Layout` adds.
-- Every dictionary of the class has exactly these, so a slot's position is
-- the same in each, and this is the one place that says what the position is.
--
-- Once `t.erased`, the equality slots are gone. They come before the methods,
-- as superclasses do, so erasing them moves every slot after them, and
-- `Turkey.Erase` renumbers the reads.
fun dictSlots(t : ClassTable, cls : String) -> Vec Slot {
    let info = match Map.get(t.classes, cls) {
        Some(i) -> i
        None -> bug("no class '" + cls + "'", None)
    }
    let out = Vec.new(len(info.supers) + len(info.equalities) + len(info.methods))
    for sup in info.supers { Vec.push(out, SuperSlot(sup.name)) }
    if !t.erased {
        for var i = 0; i < len(info.equalities); i = i + 1 { Vec.push(out, EqualitySlot(i)) }
    }
    for name in Array.sort(Map.keys(info.methods)) { Vec.push(out, MethodSlot(name)) }
    for (method, key) in Map.getOr(t.keyed, cls, []) {
        Vec.push(out, KeyedSlot(method, key))
    }
    out
}

-- What slot `index` of a `cls` dictionary holds.
fun slotAt(t : ClassTable, cls : String, index : Int) -> Option Slot {
    let slots = dictSlots(t, cls)
    if index >= 0 && index < len(slots) { Some(slots[index]) } else { None }
}

-- Where a `cls` dictionary holds the dictionary of its superclass `sup`.
fun superSlot(t : ClassTable, cls : String, sup : String) -> Option Int {
    let slots = dictSlots(t, cls)
    for var i = 0; i < len(slots); i = i + 1 {
        match slots[i] {
            SuperSlot(s) -> if s == sup { return Some(i) }
            _ -> {}
        }
    }
    None
}

-- Where a `cls` dictionary holds `method`, by its qualified name.
fun methodSlot(t : ClassTable, cls : String, method : String) -> Option Int {
    let slots = dictSlots(t, cls)
    for var i = 0; i < len(slots); i = i + 1 {
        match slots[i] {
            MethodSlot(m) -> if m == method { return Some(i) }
            _ -> {}
        }
    }
    None
}

-- Where a `cls` dictionary holds `method` compiled at layout key `key`.
fun keyedSlot(t : ClassTable, cls : String, method : String,
              key : String) -> Option Int {
    let slots = dictSlots(t, cls)
    for var i = 0; i < len(slots); i = i + 1 {
        match slots[i] {
            KeyedSlot(m, k) -> if m == method && k == key { return Some(i) }
            _ -> {}
        }
    }
    None
}

-- A slot as a dump prints it: `%super.Eq`, `show`, `hashInto@[ptr]`.
fun slotName(t : ClassTable, cls : String, index : Int) -> String =
    match slotAt(t, cls, index) {
        Some(SuperSlot(sup)) -> "%super." + sup
        Some(EqualitySlot(i)) -> "%super.~" + Int.toString(i)
        Some(MethodSlot(m)) -> surfaceMember(m)
        Some(KeyedSlot(m, k)) -> surfaceMember(m) + "@[" + k + "]"
        None -> "%" + Int.toString(index)
    }

-- -- registration ------------------------------------------------------------------

-- Declare every class before resolving any signature.
--
-- A method's context may name a class declared further down the file --
-- `foldMap[Monoid m]` above `class Monoid` -- and a superclass may too, so names
-- come first and bodies second. Kinds ride along: the class variable starts as
-- an undecided kind and every signature that applies it narrows it, which is how
-- `Foldable t` discovers `t :: * -> *`.
fun registerAll(t : ClassTable, classes : Vec (ClassDecl, String),
                instances : Vec (InstanceDecl, String)) -> Unit {
    -- A class reported as a duplicate is left out of the passes below, so its
    -- methods are not reported again as duplicates of the first's.
    let kept = []
    for (d, owner) in classes {
        if Map.contains(t.classes, d.name) {
            report("class '" + d.name + "' is declared more than once", Some(d.span))
            continue
        }
        Vec.push(kept, (d, owner))
        Map.put(t.classes, d.name, ClassInfo {
            name = d.name
            param = d.param
            cvar = Ty.freshVar(1)
            supers = Vec.new(2)
            equalities = Vec.new(1)
            methods = Map.new()
            span = Some(d.span)
            module_ = owner
            families = Map.new()
            defaults = Map.new()
        })
        declareFamilies(t, d)
    }

    for (d, _) in kept { resolveClass(t, d) }
    -- One report per cycle, not one per class in it.
    let cyclic = Set.new()
    for (d, _) in kept {
        if !Set.contains(cyclic, d.name) { let _ = checkSuperAcyclic(t, d.name, [], cyclic) }
    }
    for (_, fam) in Map.entries(t.decls.families) {
        let _ = Ty.defaultKind(fam.resKind)
    }
    for (_, info) in Map.entries(t.classes) {
        let _ = Ty.defaultKind(info.cvar.kind)
        for (_, m) in Map.entries(info.methods) {
            for v in m.scheme.quantified {
                let _ = Ty.defaultKind(v.kind)
            }
        }
    }
    checkConstructorContexts(t)

    -- An instance reported here is left out of the table.
    let registered = []
    for (d, owner) in instances {
        if let Some(inst) = resolveInstance(t, d, owner) { Vec.push(registered, inst) }
    }
    -- Coverage is checked only once every instance is in the table, since
    -- `instance Monoid (Array a)` is entitled to be satisfied by a
    -- `Semigroup (Array a)` written further down the file.
    for inst in registered { checkInstance(t, inst) }
}

-- The class half of an existential constructor's bracket. The declaration
-- table builds the predicates before any class is registered, so it cannot know
-- whether `Error` names one or what kind its variable has; this is the check
-- `resolveContext` makes for a `fun`, made once the classes exist.
fun checkConstructorContexts(t : ClassTable) -> Unit {
    for (con, written) in t.decls.uncheckedContexts {
        var i = 0
        while i < len(con.scheme.preds) && i < len(written.context) {
            let p = con.scheme.preds[i]
            let source = written.context[i]
            i = i + 1
            let info = match Map.get(t.classes, p.name) {
                Some(found) -> found
                None -> {
                    report("unknown class '" + p.name + "'", Some(source.span))
                    continue
                }
            }
            let arg = p.args[0]
            if !Ty.isBottom(arg) && !Ty.unifyKinds(Ty.kindOf(arg), info.cvar.kind) {
                report("'" + Ty.show(arg) + "' has kind "
                       + Ty.showKind(Ty.kindOf(arg)) + ", but '" + p.name
                       + "' constrains a type of kind "
                       + Ty.showKind(info.cvar.kind), Some(source.span))
            }
        }
    }
    t.decls.uncheckedContexts = []
}

-- Register a class's families before any signature is read.
--
-- They go in the declaration table, because that is what `toType` consults, and
-- a family shares the type namespace with constructors and aliases -- `Elem`
-- cannot also be a data type. The argument kind is the class variable's own kind
-- cell, so a family applied in a signature constrains the class exactly as a
-- method's use of the parameter does; the result kind starts undecided and is
-- settled by use.
fun declareFamilies(t : ClassTable, d : ClassDecl) -> Unit {
    let info = classNamed(t, d.name)
    for fam in d.families {
        let written = surfaceMember(fam.name)
        if fam.param != d.param {
            report("associated type '" + written + "' must take the class "
                   + "parameter '" + d.param + "', not '" + fam.param + "'; write "
                   + "'type " + written + " " + d.param + "'", Some(fam.span))
        }
        if let Some(other) = Map.get(t.decls.families, fam.name) {
            report("'" + written + "' is already an associated type of "
                   + "class '" + other.cls + "'", Some(fam.span))
            continue
        }
        if Map.contains(t.decls.tycons, fam.name) {
            report("'" + written + "' is already a type; an associated type "
                   + "cannot share its name", Some(fam.span))
            continue
        }
        Map.put(t.decls.families, fam.name, FamilyInfo {
            name = fam.name
            cls = d.name
            argKind = info.cvar.kind
            resKind = Ty.kvar()
            span = Some(fam.span)
        })
        Map.put(info.families, fam.name, fam.param)
    }
}

-- Reports a superclass cycle reachable from `name`, and removes the edge that
-- closes it, so that nothing later follows the superclasses round for ever.
-- When it reports, it adds the classes on the walk's path to `cyclic`, so
-- that a walk from another of them does not report the same cycle again.
--
-- Returns whether `name` is already on the path `seen`, that is, whether the
-- edge to it closes a cycle.
fun checkSuperAcyclic(t : ClassTable, name : String, seen : Array String,
                      cyclic : Set.Set String) -> Bool {
    if Array.contains(seen, name) {
        if !Set.contains(cyclic, name) {
            for s in seen { Set.add(cyclic, s) }
            report("class '" + name + "' is its own superclass", classNamed(t, name).span)
        }
        return True
    }
    let inner = Array.append(seen, [name])
    let info = classNamed(t, name)
    let kept = []
    for sup in info.supers {
        if !checkSuperAcyclic(t, sup.name, inner, cyclic) { Vec.push(kept, sup) }
    }
    if len(kept) < len(info.supers) {
        Vec.clear(info.supers)
        for sup in kept { Vec.push(info.supers, sup) }
    }
    False
}

fun resolveClass(t : ClassTable, d : ClassDecl) -> Unit {
    let info = classNamed(t, d.name)
    for sup in d.supers {
        match sup.kind {
            PEq(left, right) -> {
                let tyvars = Map.new()
                Map.put(tyvars, d.param, TVar(info.cvar))
                let reported = Diag.errorCount()
                let equality = resolveEquality(t, sup, left, right, tyvars,
                                               fun() = Ty.freshVar(1))
                if Diag.errorCount() > reported { continue }
                -- A variable other than the parameter would be universally
                -- quantified in every given the class grants, which no instance
                -- could prove.
                let others = Array.filter(Array.sort(Map.keys(tyvars)), fun(n) = n != d.param)
                if len(others) > 0 {
                    report("'" + others[0] + "' is not the parameter of '" + d.name
                           + "'; a superclass equality can mention only '" + d.param
                           + "'", Some(sup.span))
                    continue
                }
                Vec.push(info.equalities, equality)
            }
            PClass(name, arg) -> {
                let supInfo = match Map.get(t.classes, name) {
                    Some(i) -> i
                    None -> {
                        report("unknown class '" + name + "'", Some(sup.span))
                        continue
                    }
                }
                let ok = match arg.kind {
                    TEVar(v) -> v == d.param
                    _ -> False
                }
                if !ok {
                    report("superclass '" + name + "' must constrain '" + d.param
                           + "', the parameter of '" + d.name + "'; write '" + name
                           + " " + d.param + "'", Some(sup.span))
                    continue
                }
                if !Ty.unifyKinds(supInfo.cvar.kind, info.cvar.kind) {
                    report("'" + d.param + "' cannot be both a '" + name + "' and "
                           + "a '" + d.name + "': the two disagree about its kind",
                           Some(sup.span))
                }
                Vec.push(info.supers, Ty.pred(name, [TVar(info.cvar)]))
            }
        }
    }

    for decl in d.methods {
        if let Some(other) = Map.get(t.owner, decl.name) {
            report("'" + surfaceMember(decl.name) + "' is already a method of class '"
                   + other + "'", Some(decl.span))
            continue
        }
        let tyvars = Map.new()
        Map.put(tyvars, d.param, TVar(info.cvar))
        let body = methodType(t, decl, tyvars)
        let preds = Vec.append([Ty.pred(d.name, [TVar(info.cvar)])],
                                 resolveContext(t, decl.context, tyvars, None))
        let s = Ty.generalize(body, 0, preds)
        let names = Map.new()
        for (name, stood) in Map.entries(tyvars) {
            if let TVar(cell) = stood {
                Map.put(names, cell.id, name)
            }
        }
        Map.put(info.methods, decl.name, MethodInfo {
            name = decl.name
            cls = d.name
            scheme = s
            decl = decl
            classVar = info.cvar
            names = names
        })
        Map.put(t.owner, decl.name, d.name)
    }
}

-- A method's declared type, read off its annotations.
--
-- A signature and a defaulted method are read the same way, because a
-- signature's parameters are stored as anonymous annotated binders. Both must be
-- fully annotated: a class fixes its methods' types, so there is nothing here
-- for inference to discover.
fun methodType(t : ClassTable, decl : FunDecl,
               tyvars : Map String Ty.Type) -> Ty.Type {
    let fresh = fun() = Ty.freshVar(1)
    let params = Array.map(decl.params, fun(p) = match p.kind {
        PAnnot(_, te) -> Decls.star(t.decls, te, tyvars, fresh)
        PVar(x) -> {
            report("parameter '" + x + "' of method '"
                   + surfaceMember(decl.name) + "' needs a type annotation",
                   Some(p.span))
            TBottom
        }
        _ -> {
            report("parameter of method '" + surfaceMember(decl.name)
                   + "' needs a type annotation", Some(p.span))
            TBottom
        }
    })
    match decl.ret {
        None -> {
            report("method '" + surfaceMember(decl.name)
                   + "' must state a return type", Some(decl.span))
            TBottom
        }
        Some(ret) -> TFun(params, Decls.star(t.decls, ret, tyvars, fresh))
    }
}

-- Translate a written `[C a, D b]` into predicates over `tyvars`.
--
-- `tyvars` is the enclosing declaration's annotation scope, so the `a` in
-- `[Ord a]` and the `a` in `xs : Array a` are the same variable -- a context
-- constrains, it does not bind.
fun resolveContext(t : ClassTable, context : Vec Ast.Pred, tyvars : Map String Ty.Type,
                   supplied : Option Ty.Fresh) -> Vec Pred {
    let fresh = match supplied {
        Some(f) -> f
        None -> fun() = Ty.freshVar(1)
    }
    let out = Vec.new(len(context))
    let answers = Map.new()
    for p in context {
        match p.kind {
            PEq(left, right) -> {
                let equality = resolveEquality(t, p, left, right, tyvars, fresh)
                -- A family is a function of its argument, so a context may give
                -- it one answer. Two are caught here rather than by improvement,
                -- which only sees the *deferred* queue: a written equality
                -- becomes an assumption and never joins it.
                let key = Ty.typeKey(equality.args[0])
                if let Some(had) = Map.get(answers, key) {
                    report("'" + Ty.show(equality.args[0])
                        + "' is required to be both '" + Ty.show(had) + "' and '"
                        + Ty.show(equality.args[1]) + "'; keep one equality",
                        Some(p.span))
                }
                Map.put(answers, key, equality.args[1])
                Vec.push(out, equality)
            }
            PClass(name, argTe) -> {
                let info = match Map.get(t.classes, name) {
                    Some(i) -> i
                    None -> {
                        report("unknown class '" + name + "'", Some(p.span))
                        continue
                    }
                }
                let arg = Decls.toType(t.decls, argTe, tyvars, fresh)
                if !Ty.isBottom(arg) && !Ty.unifyKinds(Ty.kindOf(arg), info.cvar.kind) {
                    report("'" + Ty.show(arg) + "' has kind "
                           + Ty.showKind(Ty.kindOf(arg)) + ", but '" + name
                           + "' constrains a type of kind "
                           + Ty.showKind(info.cvar.kind), Some(p.span))
                }
                Vec.push(out, Ty.pred(name, [arg]))
            }
        }
    }
    out
}

-- Translate a written `Item c ~ Op`.
--
-- The left side must be a family application, and the right side may not
-- mention it. `Turkey.Inert` makes the givens canonical whatever their shape;
-- these are restrictions on what a context may say, not on what the solver can
-- use. A general equality between two arbitrary types is not needed: `Int ~ a`
-- says nothing a plain annotation cannot.
fun resolveEquality(t : ClassTable, p : Ast.Pred, leftTe : Type, rightTe : Type,
                    tyvars : Map String Ty.Type, fresh : Ty.Fresh) -> Pred {
    let left = Decls.toType(t.decls, leftTe, tyvars, fresh)
    let right = Decls.toType(t.decls, rightTe, tyvars, fresh)
    -- A side already reported as a wrong type has nothing left to check.
    if Ty.isBottom(left) || Ty.isBottom(right) { return Ty.pred(Ty.equals, [left, right]) }
    match left {
        TFam(_, _, _) -> {}
        _ -> report("'" + Ty.show(left) + "' is not an associated type; the left "
                    + "side of '~' must be one, as in 'Item s ~ Int'", Some(p.span))
    }
    for sub in Ty.subterms(right) {
        if Ty.sameType(sub, left) {
            report("'" + Ty.show(right) + "' mentions '" + Ty.show(left)
                   + "', so the equality defines it in terms of itself", Some(p.span))
            break
        }
    }
    if !Ty.unifyKinds(Ty.kindOf(left), Ty.kindOf(right)) {
        report("'" + Ty.show(left) + "' has kind " + Ty.showKind(Ty.kindOf(left))
               + ", but '" + Ty.show(right) + "' has kind "
               + Ty.showKind(Ty.kindOf(right)), Some(p.span))
    }
    Ty.pred(Ty.equals, [left, right])
}

-- Returns the instance `d` declares, or `None` when it reported why the
-- instance cannot be registered.
fun resolveInstance(t : ClassTable, d : InstanceDecl, owner : String) -> Option InstInfo {
    let info = match Map.get(t.classes, d.cls) {
        Some(i) -> i
        None -> {
            report("unknown class '" + d.cls + "'", Some(d.span))
            return None
        }
    }
    if d.cls == P.typedClass {
        -- The one class a program may name but not instance. `typeRep` is what
        -- a cast compares, so an instance that lied about a type would make the
        -- cast return a value of a type it is not -- there is nothing
        -- downstream that would catch it, because the comparison *is* the
        -- check. A derived instance cannot lie: the compiler reads the name off
        -- the type it is deriving for.
        report("'Typed' instances cannot be declared; the compiler derives one "
               + "for every type", Some(d.span))
        return None
    }
    let tyvars = Map.new()
    let fresh = fun() = Ty.freshVar(1)
    let h = Decls.toType(t.decls, d.head, tyvars, fresh)
    -- A head already reported as a wrong type is not registered.
    if Ty.isBottom(h) { return None }
    if !Ty.unifyKinds(Ty.kindOf(h), info.cvar.kind) {
        report("'" + Ty.show(h) + "' has kind " + Ty.showKind(Ty.kindOf(h))
               + ", but '" + d.cls + "' constrains a type of kind "
               + Ty.showKind(info.cvar.kind), Some(d.span))
        return None
    }
    if !checkHeadShape(d, h) { return None }

    let key = instHeadKey(h)
    for other in instancesOf(t, d.cls) {
        if instHeadKey(other.head) == key {
            report("overlapping instances: '" + showInstance(d.cls, h)
                   + "' is already declared" + declaredAt(other, owner), Some(d.span))
            return None
        }
    }
    -- A context constrains the head's variables and binds none of its own:
    -- an instance is selected by its head alone, so nothing at a use could
    -- say what another variable is.
    for p in d.context {
        let sides = match p.kind {
            PClass(_, arg) -> [arg]
            PEq(left, right) -> [left, right]
        }
        for side in sides {
            if let Some((name, at)) = strayVar(side, tyvars) {
                report("'" + name + "' is not bound by the instance head '"
                       + Ty.showAt(h, writtenNamer(namesOf(tyvars)), 0) + "'", Some(at))
            }
        }
    }
    let written = resolveContext(t, d.context, tyvars, None)
    let context = Vec.filter(written, fun(p) = p.name != Ty.equals)
    let equalities = Vec.filter(written, fun(p) = p.name == Ty.equals)
    let families = resolveFamilies(t, d, info, h, tyvars, fresh)
    for (_, stood) in Map.entries(tyvars) {
        if let TVar(cell) = stood { let _ = Ty.defaultKind(cell.kind) }
    }
    let names = namesOf(tyvars)
    let inst = InstInfo {
        cls = d.cls
        head = h
        context
        equalities
        decl = d
        names
        families
        plan = None
        module_ = owner
        derived = False
    }
    checkOrphan(t, inst, d)
    match Map.get(t.instances, d.cls) {
        Some(existing) -> Vec.push(existing, inst)
        None -> Map.put(t.instances, d.cls, [inst])
    }
    Some(inst)
}

-- Returns what each variable of the annotation scope `tyvars` is called, by
-- its id.
fun namesOf(tyvars : Map String Ty.Type) -> Map Int String {
    let names = Map.new()
    for (name, stood) in Map.entries(tyvars) {
        if let TVar(cell) = stood { Map.put(names, cell.id, name) }
    }
    names
}

-- Returns the first type variable in `te` that `bound` does not name, and
-- where it is written.
fun strayVar(te : Type, bound : Map String Ty.Type) -> Option (String, Span) = match te.kind {
    TEVar(name) -> if Map.contains(bound, name) { None } else { Some((name, te.span)) }
    TECon(_, args) -> strayIn(args, bound)
    TEApp(fn, args) -> match strayVar(fn, bound) {
        Some(found) -> Some(found)
        None -> strayIn(args, bound)
    }
    TETuple(elems) -> strayIn(elems, bound)
    TEFun(params, ret) -> match strayIn(params, bound) {
        Some(found) -> Some(found)
        None -> strayVar(ret, bound)
    }
}

fun strayIn(tes : Vec Type, bound : Map String Ty.Type) -> Option (String, Span) {
    for te in tes {
        if let Some(found) = strayVar(te, bound) { return Some(found) }
    }
    None
}

-- Where `other` is declared, for a message about an instance in `module_`.
fun declaredAt(other : InstInfo, module_ : String) -> String {
    if other.module_ == "" { return " by the compiler" }
    let at = " at " + Source.showSpan(other.decl.span)
    if other.module_ == module_ { at } else { " in '" + other.module_ + "'" + at }
}

-- An instance belongs to its class's module or its head's.
--
-- Instances are global -- every module sees every one, because a predicate has
-- to mean the same thing wherever it is solved. Global and *unrestricted* is
-- what would make coherence a matter of luck: two libraries could each write
-- `instance Show Point` over someone else's `Show` and someone else's `Point`,
-- and whichever loaded second would be the error, in a file neither author
-- wrote. The orphan rule makes the overlap check a local obligation instead: an
-- instance can only clash with one its author was in a position to see.
fun checkOrphan(t : ClassTable, inst : InstInfo, d : InstanceDecl) -> Unit {
    let home = classNamed(t, inst.cls).module_
    let name = instCon(inst)
    let headModule = Option.unwrapOr(P.moduleOf(name), "")
    let builtinHome = builtinHomeOf(name)
    let tupleHome = if String.startsWith(name, "Tuple") { "Data.Tuple" } else { "" }
    let allowed = [home, headModule, builtinHome, tupleHome]
    if Array.contains(allowed, inst.module_) {
        return {}
    }
    let typeHome = if headModule != "" { headModule }
                   else if builtinHome != "" { builtinHome }
                   else { tupleHome }
    let cls = "'" + d.cls + "'"
    let ty = "'" + Ty.show(inst.head) + "'"
    let owners = if home == "" && typeHome == "" {
        cls + " and " + ty + " are built in"
    } else if home == "" {
        cls + " is built in and " + ty + " belongs to '" + typeHome + "'"
    } else if typeHome == "" {
        cls + " belongs to '" + home + "' and " + ty + " is built in"
    } else {
        cls + " belongs to '" + home + "' and " + ty + " to '" + typeHome + "'"
    }
    let move = if home == "" && typeHome == "" { "" }
               else if home == "" || typeHome == "" { "move it there, or " }
               else { "move it to one of those modules, or " }
    report("orphan instance: '" + showInstance(d.cls, inst.head)
           + "' is declared in '" + inst.module_ + "', but " + owners + "; "
           + move + "wrap " + ty + " in a type of your own", Some(d.span))
}

fun builtinHomeOf(name : String) -> String = match name {
    "Int" -> "Data.Int"
    "Byte" -> "Data.Byte"
    "Float" -> "Data.Float"
    "Char" -> "Data.Char"
    _ -> ""
}

-- `type Elem = a`: what each of the class's families is, at this head.
--
-- The right-hand side is read in the *head's* scope, so its variables are the
-- head's and nothing else may appear -- an unbound one would be a type the
-- instance never fixed, which is a family with no definition rather than a
-- polymorphic one.
fun resolveFamilies(t : ClassTable, d : InstanceDecl, info : ClassInfo,
                    h : Ty.Type, tyvars : Map String Ty.Type,
                    fresh : Ty.Fresh) -> Map String Ty.Type {
    let bound = Map.new()
    for fb in d.families {
        let resolved = match memberNamed(Map.keys(info.families), fb.name) {
            Some(r) -> r
            None -> {
                report("'" + fb.name + "' is not an associated type of class '"
                       + d.cls + "'", Some(fb.span))
                continue
            }
        }
        fb.name = resolved
        if Map.contains(bound, resolved) {
            report("'" + fb.name + "' is defined twice in this instance",
                   Some(fb.span))
            continue
        }
        let known = Set.new()
        for k in Map.keys(tyvars) { Set.add(known, k) }
        let body = Decls.toType(t.decls, fb.body, tyvars, fresh)
        let escaped = Vec.new(2)
        for k in Map.keys(tyvars) {
            if !Set.contains(known, k) { Vec.push(escaped, k) }
        }
        if len(escaped) > 0 {
            report("'" + Vec.sort(escaped)[0] + "' is not bound by the instance "
                   + "head '" + Ty.show(h) + "'", Some(fb.span))
        }
        let fam = match Map.get(t.decls.families, resolved) {
            Some(f) -> f
            None -> bug("unknown type family '" + resolved + "'", Some(fb.span))
        }
        if !Ty.isBottom(body) && !Ty.unifyKinds(Ty.kindOf(body), fam.resKind) {
            report("'" + Ty.show(body) + "' has kind "
                   + Ty.showKind(Ty.kindOf(body)) + ", but '" + fb.name
                   + "' produces a type of kind " + Ty.showKind(fam.resKind),
                   Some(fb.span))
        }
        checkFamDecreasing(fb, body)
        Map.put(bound, resolved, body)
    }
    let missing = Vec.new(2)
    for n in Map.keys(info.families) {
        if !Map.contains(bound, n) { Vec.push(missing, "'" + surfaceMember(n) + "'") }
    }
    if len(missing) > 0 {
        report("instance '" + showInstance(d.cls, h) + "' does not define "
               + String.join(Vec.sort(missing), ", "), Some(d.span))
    }
    bound
}

-- A family's definition may only apply a family to a *variable*.
--
-- That is what makes reduction terminate. An instance head is a constructor over
-- distinct variables, so a family applied to one of them is applied to a proper
-- subterm of the argument that selected this instance, and every step is a
-- strict decrease. `type Elem = Elem (Array a)` is the rule's whole point: it
-- would reduce forever.
fun checkFamDecreasing(fb : FamBind, body : Ty.Type) -> Unit = match Ty.prune(body) {
    TFam(_, arg, _) -> {
        match Ty.prune(arg) {
            TVar(_) -> {}
            _ -> report("'" + Ty.show(body) + "' cannot appear here: an associated "
                        + "type can only be applied to a type variable of the "
                        + "instance head", Some(fb.span))
        }
        checkFamDecreasing(fb, arg)
    }
    TApp(fn, arg, _) -> {
        checkFamDecreasing(fb, fn)
        checkFamDecreasing(fb, arg)
    }
    TFun(params, ret) -> {
        for p in params { checkFamDecreasing(fb, p) }
        checkFamDecreasing(fb, ret)
    }
    TTuple(elems) -> for e in elems { checkFamDecreasing(fb, e) }
    _ -> {}
}

-- Haskell 98: a constructor applied to distinct type variables.
--
-- `instance Functor (Either Int)` is rejected here, not because it could not be
-- given a meaning, but because allowing it makes instance selection depend on
-- how much of a type is known yet -- and that is what turns a missing instance
-- into a silently different one.
--
-- Returns whether `h` has that shape, reporting why when it does not.
fun checkHeadShape(d : InstanceDecl, h : Ty.Type) -> Bool {
    -- One namer for the head and its arguments, so a variable is called the
    -- same in both.
    let n = Ty.namer("")
    let shown = Ty.showAt(h, n, 0)
    let (c, spineArgs) = Ty.spine(h)
    let args = match c {
        TTuple(elems) -> elems
        TCon(_) -> spineArgs
        _ -> {
            report("'" + Ty.show(h) + "' cannot be an instance head: it must be a "
                   + "type constructor applied to distinct type variables",
                   Some(d.head.span))
            return False
        }
    }
    let seen = Set.new()
    for arg in args {
        match Ty.prune(arg) {
            TVar(cell) -> {
                if Set.contains(seen, cell.id) {
                    report("'" + shown + "' cannot be an instance head: '"
                           + Ty.showAt(arg, n, 0) + "' appears twice in it",
                           Some(d.head.span))
                    return False
                }
                Set.add(seen, cell.id)
            }
            _ -> {
                report("'" + shown + "' cannot be an instance head: '"
                       + Ty.showAt(arg, n, 0) + "' must be a type variable",
                       Some(d.head.span))
                return False
            }
        }
    }
    True
}

-- Superclass coverage, and the method roster.
fun checkInstance(t : ClassTable, inst : InstInfo) -> Unit {
    let info = classNamed(t, inst.cls)
    for sup in info.supers {
        let demand = Ty.pred(sup.name, [inst.head])
        if !entail(t, inst.context, demand) {
            report("'" + Ty.showPred(demand) + "' is required by '" + inst.cls
                   + "', but there is no such instance", Some(inst.decl.span))
        }
    }
    let defined = Set.new()
    for m in inst.decl.methods {
        let resolved = match memberNamed(Map.keys(info.methods), m.name) {
            Some(r) -> r
            None -> {
                report("'" + m.name + "' is not a method of class '"
                       + inst.cls + "'", Some(m.span))
                continue
            }
        }
        m.name = resolved
        if Set.contains(defined, resolved) {
            report("'" + m.name + "' is defined twice in this instance", Some(m.span))
            continue
        }
        if Option.isNone(m.body) {
            bug("'" + m.name + "' needs a body: an instance method's type comes "
                 + "from the class, so it does not restate it", Some(m.span))
        }
        Set.add(defined, resolved)
    }
    let missing = Vec.new(2)
    for (name, m) in Map.entries(info.methods) {
        if !Set.contains(defined, name) && !hasDefault(m) {
            Vec.push(missing, "'" + surfaceMember(name) + "'")
        }
    }
    if len(missing) > 0 {
        report("instance '" + showInstance(inst.cls, inst.head)
               + "' does not define " + String.join(Vec.sort(missing), ", "),
               Some(inst.decl.span))
    }
}

-- -- reduction ---------------------------------------------------------------------

-- A family application's definition, or `None` if no instance decides it yet.
--
-- This is `byInst` for types instead of predicates, and it is the same one-way
-- match against the same instance table -- a family is a function defined by
-- cases on the instance head, so there is nothing else it could be. `None` is
-- *stuck*, never failure: an argument no instance covers is a missing instance,
-- and the class predicate that travels beside every family application is what
-- reports it, with the better message and the right span.

-- -- generated classes -------------------------------------------------------------
--
-- A field access is a class method, and the reason it did not look like one is
-- that `HasField l r a` has three arguments where a class has one. The label is
-- a compile-time constant and folds into the class's *name*; the field's type
-- is a function of the receiver, which is what an associated family is for. So
-- `r.cap` demands `%HasField.cap r` and has the type `%Field.cap r`, and both
-- the class and its instances are generated rather than written.
--
-- This is what stops `HasField` being erased. A predicate the solver discharges
-- and throws away leaves a record-polymorphic body knowing a field's type and
-- not its position, which cannot be compiled and -- worse -- can be compiled
-- wrong, since the backend answers `BOXED` for anything read out of a receiver
-- it does not know. As a class it carries a dictionary of accessors instead,
-- and the body is handed the offset rather than guessing it.
--
-- Nothing ground pays for this. An instance below has no context, so wherever
-- specialization reaches the dictionary is ground, the devirtualizer hoists the
-- accessor, and the inliner takes it -- the body is a single node -- leaving
-- the `CProject` a field access on a known record lowers to directly.
--
-- Writing is a class of its own. `r.cap = v` demands `%SetField.cap r` as well
-- as `%HasField.cap r`, and only a field declared `var` has a `%SetField`
-- instance, so assigning any other field is a missing instance -- reported
-- where the receiver's type becomes known, which for a polymorphic receiver is
-- the caller that supplies it. The setter declares no family: the type it
-- writes is `%Field.cap r`, which the read predicate beside it determines.

let fieldClassHead = "%HasField"
let setterClassHead = "%SetField"
let projectionClassHead = "%HasProjection"
let fieldFamilyHead = "%Field"
let projectionFamilyHead = "%Elem"

fun fieldClass(label : String) -> String = fieldClassHead + "." + label

fun setterClass(label : String) -> String = setterClassHead + "." + label

fun fieldFamily(label : String) -> String = fieldFamilyHead + "." + label

fun projectionClass(index : Int) -> String =
    projectionClassHead + "." + Int.toString(index)

fun projectionFamily(index : Int) -> String =
    projectionFamilyHead + "." + Int.toString(index)

-- The label a generated name carries, if its head is the one asked for. A
-- generated name is `head` and a label with one `.` between them, and a field
-- name cannot contain a `.`, so the last one is the separator.
fun generatedPart(name : String, head : String) -> Option String =
    match String.rsplitOnce(name, ".") {
        Some((before, after)) -> if before == head { Some(after) } else { None }
        None -> None
    }

-- The field name a generated class reads, if it is one of them.
fun generatedLabel(cls : String) -> Option String =
    generatedPart(cls, fieldClassHead)

-- The field name a generated class writes, if it is one of them.
fun setterLabel(cls : String) -> Option String =
    generatedPart(cls, setterClassHead)

-- The position a generated projection class reads, if it is one.
fun generatedIndex(cls : String) -> Option Int =
    match generatedPart(cls, projectionClassHead) {
        Some(digits) -> Int.parse(digits)
        None -> None
    }

-- The generated class a generated family belongs to, or the name itself.
--
-- `%Field.cap` is declared by `%HasField.cap` and `%Elem.0` by
-- `%HasProjection.0`, so the label is recoverable from either name.
fun fieldFamilyOwner(fam : String) -> String {
    if let Some(label) = generatedPart(fam, fieldFamilyHead) {
        return fieldClass(label)
    }
    if let Some(digits) = generatedPart(fam, projectionFamilyHead) {
        if let Some(index) = Int.parse(digits) {
            return projectionClass(index)
        }
    }
    fam
}

fun isGenerated(cls : String) -> Bool =
    Option.isSome(generatedLabel(cls)) || Option.isSome(setterLabel(cls))
        || Option.isSome(generatedIndex(cls))

-- The internal name of a generated class's method.
--
-- `#` and not `.`, because `surfaceMember` splits on it: the dictionary's field
-- ends up called `get`, while the method's own name stays unique across labels.
-- `ClassTable.owner` is one flat namespace and rejects a method declared twice,
-- so every label needs its own pair.
fun accessor(cls : String, which : String) -> String = cls + "#" + which

-- A declaration for something nobody wrote. Spans are not optional on `FunDecl`
-- and `InstanceDecl`, and a generated class has no source to point at.
fun generatedSpan() -> Span = Source.generated()

-- Declare a field, setter or projection class, once per label.
--
-- Built here rather than enumerated up front for two reasons. A label's class
-- has to exist before any signature mentioning it is read, and eager
-- registration would have to guess the order; and no pass can know which tuple
-- arities a program projects from. Generated on demand, a class appears exactly
-- when something asks for it.
fun ensureGenerated(t : ClassTable, cls : String) -> ClassInfo {
    if let Some(found) = Map.get(t.classes, cls) {
        return found
    }
    let cell = Ty.freshVar(1)
    let info = ClassInfo {
        name = cls
        param = "r"
        cvar = cell
        supers = []
        equalities = []
        methods = Map.new()
        span = None
        module_ = ""
        families = Map.new()
        defaults = Map.new()
    }
    Map.put(t.classes, cls, info)
    let receiver = TVar(cell)
    let members = match setterLabel(cls) {
        Some(label) -> {
            let fam = fieldFamily(label)
            let reader = ensureGenerated(t, fieldClass(label))
            let res = match Map.get(t.decls.families, fam) {
                Some(f) -> f.resKind
                None -> bug("'" + reader.name + "' declared no family", None)
            }
            [("set", TFun([receiver, TFam(fam, receiver, res)], Ty.tUnit()))]
        }
        None -> {
            let fam = match generatedLabel(cls) {
                Some(name) -> fieldFamily(name)
                None -> match generatedIndex(cls) {
                    Some(index) -> projectionFamily(index)
                    None -> bug("'" + cls + "' is not a generated class", None)
                }
            }
            let res = Ty.kvar()
            Map.put(t.decls.families, fam, FamilyInfo {
                name = fam
                cls = cls
                argKind = cell.kind
                resKind = res
                span = None
            })
            Map.put(info.families, fam, "r")
            [("get", TFun([receiver], TFam(fam, receiver, res)))]
        }
    }
    let pred = Ty.pred(cls, [receiver])
    let names = Map.new()
    Map.put(names, cell.id, "r")
    for (which, ty) in members {
        let name = accessor(cls, which)
        Map.put(info.methods, name, MethodInfo {
            name = name
            cls = cls
            scheme = Ty.generalize(ty, 0, [pred])
            decl = FunDecl {
                id = 0
                span = generatedSpan()
                name = name
                params = []
                ret = None
                body = None
                context = []
                monomorphic = False
                symbol = None
            },
            classVar = cell
            names = names
        })
        Map.put(t.owner, name, cls)
    }
    info
}

-- The instance covering a generated class's demand, on demand.
--
-- Coherent by construction: one record type declares one field once, so there
-- is exactly one instance per head and nothing to overlap with. That is why
-- this bypasses `checkInstance` -- its coverage and orphan rules exist to
-- police what a *program* may declare.
--
-- One class has many instances, because many record types may declare a field
-- of the same name. They are keyed by head, and an instance is built the first
-- time its head is demanded.
fun synthesize(t : ClassTable, p : Pred) -> Option InstInfo {
    let cls = p.name
    if !isGenerated(cls) {
        return None
    }
    let receiver = Ty.prune(p.args[0])
    let (head, _) = Ty.spine(receiver)
    let label = generatedLabel(cls)
    let setter = setterLabel(cls)
    let index = generatedIndex(cls)

    -- The instance's head is the *general* one -- `Map k v`, not
    -- `Map String Int` -- so one instance covers every use. It is read off the
    -- constructor's own scheme, which is where those variables live.
    let general = match head {
        TTuple(elems) -> match index {
            -- A tuple has positions, not field names.
            None -> return None
            Some(_) -> {
                -- Over fresh variables, not over the tuple that happened to be
                -- demanded first: one instance covers every 2-tuple, and giving
                -- it a concrete head would make it cover exactly one of them
                -- while still claiming the slot for the rest.
                TTuple(Array.init(len(elems), fun(_) = Ty.tvar(1)))
            }
        }
        TCon(c) -> match Map.get(t.decls.tycons, c.name) {
            None -> return None
            Some(info) -> if len(info.variants) != 1 { return None } else {
                match Ty.prune(info.variants[0].scheme.body) {
                    TFun(_, ret) -> ret
                    _ -> return None
                }
            }
        }
        _ -> return None
    }
    let key = instHeadKey(general)
    for inst in instancesOf(t, cls) {
        if instHeadKey(inst.head) == key {
            return Some(inst)
        }
    }

    -- What the instance says the class's family is. A setter's class has none.
    let families = Map.new()
    if let Some(name) = label {
        match Decls.recordFields(t.decls, ownerOf(head)) {
            None -> return None
            Some(names) -> if !Array.contains(names, name) { return None }
        }
        Map.put(families, fieldFamily(name), Decls.fieldType(t.decls, general, name))
    } else if let Some(name) = setter {
        match Decls.varFields(t.decls, ownerOf(head)) {
            None -> return None
            Some(names) -> if !Vec.contains(names, name) { return None }
        }
    } else if let Some(at) = index {
        let choices = match general {
            TTuple(elems) -> elems
            _ -> match Decls.projectionTypes(t.decls, general) {
                Some(found) -> found
                None -> return None
            }
        }
        if at >= len(choices) {
            return None
        }
        Map.put(families, projectionFamily(at), choices[at])
    } else {
        return None
    }
    let inst = InstInfo {
        cls = cls
        head = general
        context = []
        equalities = []
        decl = InstanceDecl {
            span = generatedSpan()
            cls = cls
            head = Type {
                id = 0
                span = generatedSpan()
                kind = TECon(cls, [])
            }
            context = []
            methods = []
            families = []
        },
        names = Map.new()
        families
        plan = None
        module_ = ""
        derived = False
    }
    match Map.get(t.instances, cls) {
        Some(found) -> Vec.push(found, inst)
        None -> Map.put(t.instances, cls, [inst])
    }
    Some(inst)
}

-- The type constructor a field demand's receiver is headed by; a tuple's is
-- the empty name, which no record has.
fun ownerOf(head : Ty.Type) -> String = match head {
    TCon(c) -> c.name
    _ -> ""
}

-- Returns what the instance that covers `arg` says the family `name` is at
-- `arg`, or `None` if no instance does: one reduction step, with `arg` already
-- reduced. The step of the compiler's one family reducer,
-- `Turkey.Inert.rewrite`, which reduces the argument first and applies this
-- at every depth beside the givens; nothing else calls it.
fun reduceFam(t : ClassTable, name : String, arg : Ty.Type) -> Option Ty.Type {
    let target = Ty.prune(arg)
    let cls = match Map.get(t.decls.families, name) {
        Some(f) -> f.cls
        None -> return None
    }
    if isGenerated(cls) {
        -- A generated class's instances are built on demand, and a family
        -- application is a demand: `Field.cap (Map k v)` is the first thing to
        -- ask about the record, and there is no predicate ahead of it to have
        -- created the instance already.
        let _ = synthesize(t, Ty.pred(cls, [target]))
    }
    for inst in instancesOf(t, cls) {
        if let Some(mapping) = match_(inst.head, target) {
            if let Some(body) = Map.get(inst.families, name) {
                return Some(Decls.substitute(body, mapping))
            }
        }
    }
    None
}

-- The instance a stuck family application is missing, if its argument is rigid
-- enough. A family over a variable is waiting; one over a constructor that no
-- instance names will wait forever, and saying so where the equation was written
-- beats a stranded-predicate report at the end of the group. `arg` is
-- already reduced.
fun uncovered(t : ClassTable, name : String, arg : Ty.Type) -> Option Pred {
    let target = Ty.prune(arg)
    let (h, _) = Ty.spine(target)
    match h {
        TCon(_) -> {}
        _ -> return None
    }
    let cls = match Map.get(t.decls.families, name) {
        Some(f) -> f.cls
        None -> return None
    }
    let p = Ty.pred(cls, [target])
    if Option.isSome(byInst(t, p)) { None } else { Some(p) }
}

-- -- entailment --------------------------------------------------------------------

-- A predicate together with everything a class's superclasses imply of it.
--
-- A superclass constrains the class variable itself, so the substitution is just
-- carrying the predicate's argument across.
fun bySuper(t : ClassTable, p : Pred) -> Vec Pred {
    let out = [p]
    if let Some(info) = Map.get(t.classes, p.name) {
        for sup in info.supers {
            for q in bySuper(t, Ty.pred(sup.name, p.args)) {
                Vec.push(out, q)
            }
        }
    }
    out
}

-- Returns the equalities a given `p` grants: those its class declares among
-- its superclasses, and those of every class in its superclass closure, each
-- at `p`'s argument.
fun superEqualities(t : ClassTable, p : Pred) -> Vec Pred {
    let out = Vec.new(0)
    for q in bySuper(t, p) {
        if let Some(info) = Map.get(t.classes, q.name) {
            for e in info.equalities { Vec.push(out, equalityAt(info, e, q.args[0])) }
        }
    }
    out
}

-- Returns the class predicates whose dictionaries an arm binds when it opens
-- the existential constructor `con`, with `skolems` standing for its hidden
-- types. Empty for a constructor that is not existential.
fun openedPreds(t : ClassTable, con : String, skolems : Vec ConCell) -> Vec Pred {
    let info = match Map.get(t.decls.constructors, con) {
        Some(i) -> i
        None -> return []
    }
    let mapping = Map.new()
    for var i = 0; i < len(info.exists) && i < len(skolems); i = i + 1 {
        Map.put(mapping, info.exists[i].id, TCon(skolems[i]))
    }
    Vec.map(info.scheme.preds, fun(p) =
        Ty.pred(p.name, Array.map(p.args, Decls.substitute(_, mapping))))
}

-- Returns the equality superclass `e` of `info`, over its class variable, at
-- `arg`.
fun equalityAt(info : ClassInfo, e : Pred, arg : Ty.Type) -> Pred {
    let mapping = Map.new()
    Map.put(mapping, info.cvar.id, arg)
    Ty.pred(Ty.equals, [Decls.substitute(e.args[0], mapping),
                        Decls.substitute(e.args[1], mapping)])
}

-- The obligations of the instance that covers `p`, or `None` if none does.
-- The arguments a rep describes. A tuple's are its elements, not a spine:
-- `spine` answers none for one, which would leave `(Int, String)` describing
-- itself as a bare `Tuple2` and comparing equal to every other pair.
fun typedArgs(general : Ty.Type) -> Array Ty.Type = match general {
    TTuple(elems) -> elems
    _ -> Ty.spine(general).1
}

-- The `Typed` instance for one type constructor, on demand.
--
-- Coherent for the same reason `synthesize` is: one instance per constructor
-- and count of arguments, and the compiler is the only thing that may write
-- one, so nothing overlaps and nothing can disagree about what a type is
-- called. `Either a` and `Either a b` are two instances, for two types of
-- different kinds.
--
-- The head is the *general* one -- `Map k v`, not `Map String Int` -- so one
-- instance serves every use, and its context is `Typed` over each parameter.
-- That is what makes the dictionary a function: the rep of `Map String Int` is
-- built from the reps its caller passes in, which is the only way a rep can
-- describe a type the instance never saw.
fun deriveTyped(t : ClassTable, p : Pred) -> Option InstInfo {
    let receiver = Ty.prune(p.args[0])
    let (head, args) = Ty.spine(receiver)
    let general = match head {
        TTuple(elems) -> {
            TTuple(Array.init(len(elems), fun(_) = Ty.tvar(1)))
        }
        -- A raw address has no `Typed` instance. `Typed` is what
        -- admits a value to existential packing and to `Data.Error.cast`, and
        -- recovering a pointer out of a dynamic value is a pointer forged
        -- from data whose provenance the checker gave up on.
        TCon(c) -> if c.name == "Prim.Ptr" { return None }
                   -- A skolem, the rigid variable of a signature or of an
                   -- opened existential, stands for a type nobody here knows,
                   -- so its rep can come only from a given, never from its
                   -- name.
                   else if c.uid != 0 { return None }
                   else if len(args) == 0 { receiver } else {
            match Map.get(t.decls.tycons, c.name) {
                None -> return None
                Some(info) -> if len(info.variants) == 0 { return None } else {
                    -- Read off a constructor's own scheme, as `synthesize`
                    -- reads it, because that is where the parameters live with
                    -- their kinds already right. A type with no constructor to
                    -- read has no instance, and says so rather than guessing.
                    match Ty.prune(info.variants[0].scheme.body) {
                        TFun(_, ret) -> appliedTo(ret, len(args))
                        _ -> return None
                    }
                }
            }
        }
        _ -> return None
    }
    let key = typedHeadKey(general)
    for inst in instancesOf(t, P.typedClass) {
        if typedHeadKey(inst.head) == key { return Some(inst) }
    }
    let context = []
    for arg in typedArgs(general) { Vec.push(context, Ty.pred(P.typedClass, [arg])) }
    let inst = InstInfo {
        cls = P.typedClass, head = general, context = context, equalities = [],
        decl = InstanceDecl {
            span = generatedSpan(), cls = P.typedClass,
            head = Type { id = 0, span = generatedSpan(),
                          kind = TECon(P.typedClass, Vec.new(1)) },
            context = Vec.new(1), methods = Vec.new(1),
            families = Vec.new(1),
        },
        names = Map.new(), families = Map.new(), plan = None, module_ = "",
        derived = False,
    }
    match Map.get(t.instances, P.typedClass) {
        Some(found) -> Vec.push(found, inst)
        None -> Map.put(t.instances, P.typedClass, [inst])
    }
    Some(inst)
}

-- Returns the key that tells derived `Typed` instances apart: the head's
-- constructor, then `typedSuffix`.
fun typedHeadKey(head : Ty.Type) -> String = instHeadKey(head) + typedSuffix(head)

-- Returns what tells apart two derived `Typed` heads over one constructor:
-- nothing for a head of kind `*`, and `/` and its count of arguments for a
-- head of another kind. The constructor alone would not do, because
-- `Either a` and `Either a b` are both heads, of different kinds, and so are
-- `Option` and `Option a`. A head of kind `*` applies its constructor to every
-- parameter, so it needs no count.
fun typedSuffix(head : Ty.Type) -> String = match Ty.kprune(Ty.kindOf(head)) {
    KStar -> ""
    _ -> "/" + Int.toString(len(typedArgs(head)))
}

-- Returns `general`, a constructor applied to all its parameters, applied to
-- only the first `n` of them.
--
-- A partial application is a type of its own kind, and `Typed` covers every
-- kind: `Either String` is the argument of `T (Either String)`, and its rep is
-- `Either` applied to `String`, so it needs the head `Either a` and not
-- `Either a b`, which would not match it. Peeling off the outer applications
-- keeps the kind each `TApp` already has.
fun appliedTo(general : Ty.Type, n : Int) -> Ty.Type {
    var t = general
    var extra = len(Ty.spine(general).1) - n
    while extra > 0 {
        t = match t {
            TApp(f, _, _) -> f
            _ -> t
        }
        extra = extra - 1
    }
    t
}

-- -- derived instances ---------------------------------------------------------------
--
-- A type declaration's derive list, `type Suit : Ord = ...`, asks the
-- compiler for an instance it builds from the declaration: each method
-- compares, orders or hashes the constructors and then their fields, through
-- the fields' own instances. Only the method `derivedMethod` names is built;
-- the class's other methods are its defaults. `Turkey.Lower` writes the
-- method, in Core, from the constructors; this section decides whether the
-- instance exists and what its context is.
--
-- **On demand.** An instance is built the first time something asks for it:
-- the check of its type's derive list (`checkDerives`), or a predicate that
-- no written instance covers (`selectInstance`). A class a type's list does
-- not ask for is never built for it.
--
-- **Its context is inferred, as GHC's deriving infers it**
-- (`GHC.Tc.Deriv.Infer`). The class is wanted at each field's type, and
-- each wanted is reduced through the instances that cover it until only
-- classes over the type's own parameters remain: those are the context
-- (`inferContext`). So `type M k v : Eq = M(Map k v)` gets
-- `Eq (M k v) : Hash k, Eq v`, from `Map`'s own instance, and a phantom
-- parameter, in no field's type, gets nothing. The instance is sound
-- because its context is exactly what its fields' instances need: each
-- method the lowering writes calls a field's instance, which `prove` finds
-- under that context by the same reduction.
--
-- **A group is solved together, from below.** `type List a : Eq = Nil |
-- Cons(a, List a)` needs `Eq (List a)` to derive `Eq (List a)`. Every
-- instance begun while a derivation runs is in the table from the start,
-- with an empty context, and `settle` infers each context again under the
-- others until none changes: the least fixed point, as GHC's
-- `inferInstanceContexts` finds it. It is never looped on: a context holds
-- only classes over parameters, so it can grow only so far, and one
-- reduction that grows without end, through a written instance whose
-- context is no smaller than its head, stops at `reductionLimit` and is no
-- instance. A non-regular type is not such a case: `Nest a` holding a
-- `Nest (Array a)` reduces `Eq (Nest (Array a))` back to `Eq a`.

type Derivation
    -- Begun and not finished: assumed to exist, by what it is being derived
    -- from.
    = Deriving(InstInfo)
    | Derived(InstInfo)
    -- Cannot be derived, with the reason, as a diagnostic quotes it after
    -- "'T' cannot derive 'Eq': " or "'T' has no 'Eq': ".
    | Underivable(String)

-- Returns the method a derived instance of `cls` defines, or `None` when
-- `cls` cannot be derived. A derive list may name any class this accepts;
-- one more is a line here and the body `Turkey.Lower` writes for its method.
fun derivedMethod(cls : String) -> Option String =
    if cls == P.eqClass { Some("eq") }
    else if cls == P.ordClass { Some("lt") }
    else if cls == P.hashClass { Some("hashInto") }
    else { None }

-- Whether `!` may refuse `cls`. `Ord` is derived only for a type that asks:
-- a derived order follows the order the constructors are declared in, so a
-- type should not acquire one unasked, and `!Ord` would refuse nothing.
fun refusable(cls : String) -> Bool = cls == P.eqClass || cls == P.hashClass

fun derivationKey(cls : String, tycon : String) -> String = cls + " " + tycon

-- Returns `cls`'s superclasses, transitively, each once, nearest first.
fun superclassesOf(t : ClassTable, cls : String) -> Vec String {
    let out = []
    var i = -1
    while i < len(out) {
        let next = if i < 0 { cls } else { out[i] }
        i = i + 1
        if let Some(info) = Map.get(t.classes, next) {
            for sup in info.supers {
                if !Vec.contains(out, sup.name) && sup.name != cls { Vec.push(out, sup.name) }
            }
        }
    }
    out
}

-- Returns whether `tycon`'s derive list refuses `cls` with `!`.
fun refuses(t : ClassTable, tycon : String, cls : String) -> Bool =
    match Map.get(t.decls.tycons, tycon) {
        Some(info) -> Iterator.any(info.derives, fun(d) = d.refused && d.cls == cls)
        None -> False
    }

-- Returns whether `tycon`'s declaration asks for `cls`: its derive list names
-- `cls`, or a class `cls` is a superclass of, and does not refuse `cls`. A
-- derived `Hash` or `Ord` needs the type's `Eq` derived too, so asking for
-- either asks for `Eq`.
fun asksFor(t : ClassTable, tycon : String, cls : String) -> Bool {
    let info = match Map.get(t.decls.tycons, tycon) {
        Some(i) -> i
        None -> return False
    }
    if refuses(t, tycon, cls) { return False }
    for d in info.derives {
        if !d.refused && (d.cls == cls || Vec.contains(superclassesOf(t, d.cls), cls)) {
            return True
        }
    }
    False
}

-- Returns the instance of `cls` for `tycon` that a program wrote, if one did.
fun writtenInstance(t : ClassTable, cls : String, tycon : String) -> Option InstInfo {
    let key = "con " + tycon
    for inst in instancesOf(t, cls) {
        if !inst.derived && instHeadKey(inst.head) == key { return Some(inst) }
    }
    None
}

-- Returns the derived instance of `cls` for the type constructor `tycon`,
-- deriving it now if it is not derived yet, or `None` when the declaration
-- does not ask for it or it cannot be derived. The section comment says how.
fun derive(t : ClassTable, cls : String, tycon : String) -> Option InstInfo {
    let key = derivationKey(cls, tycon)
    match Map.get(t.derivations, key) {
        Some(Deriving(inst)) -> return Some(inst)
        Some(Derived(inst)) -> return Some(inst)
        Some(Underivable(_)) -> return None
        None -> {}
    }
    if Option.isNone(derivedMethod(cls)) || !asksFor(t, tycon, cls) { return None }
    let info = match Map.get(t.decls.tycons, tycon) {
        Some(i) -> i
        None -> return None
    }
    let general = declaredHead(info)?
    let inst = begin(t, cls, info, general, key)
    -- A derivation begun inside another is settled by the outermost one,
    -- with the rest of its group.
    if t.deriving { return Some(inst) }
    t.deriving = True
    settle(t)
    t.deriving = False
    Vec.clear(t.provisional)
    match Map.get(t.derivations, key) {
        Some(Derived(found)) -> Some(found)
        _ -> None
    }
}

-- Puts the derived instance of `cls` for `info` in the table with an empty
-- context, the first approximation of its context, and returns it.
fun begin(t : ClassTable, cls : String, info : TyconInfo, general : Ty.Type,
          key : String) -> InstInfo {
    let names = Map.new()
    let (_, args) = Ty.spine(general)
    for var i = 0; i < len(args) && i < len(info.params); i = i + 1 {
        if let TVar(cell) = Ty.prune(args[i]) { Map.put(names, cell.id, info.params[i]) }
    }
    let span = Option.unwrapOr(info.span, generatedSpan())
    let inst = InstInfo {
        cls = cls, head = general, context = [], equalities = [],
        decl = InstanceDecl {
            span = span, cls = cls,
            head = Type { id = 0, span = span, kind = TECon(info.name, Vec.new(1)) },
            context = Vec.new(1), methods = Vec.new(1), families = Vec.new(1),
        },
        names = names, families = Map.new(), plan = None, module_ = "",
        derived = True,
    }
    match Map.get(t.instances, cls) {
        Some(found) -> Vec.push(found, inst)
        None -> Map.put(t.instances, cls, [inst])
    }
    Map.put(t.derivations, key, Deriving(inst))
    Vec.push(t.provisional, key)
    inst
}

-- Finds the context of every derivation begun since the outermost one, as
-- the least fixed point of `inferContext` over all of them together.
--
-- Each round infers every context again under the contexts the last round
-- found, and withdraws an instance that has none. What a context implies
-- only grows from round to round, since what the contexts it is inferred
-- under imply only grows. Its predicates may change as it does, when `Ord a`
-- comes to stand for an `Eq a` it implies. A withdrawn instance stays
-- withdrawn, since every instance that relied on it fails next round. A
-- context holds only classes over its own type's parameters, so there are
-- finitely many it can grow to, and the rounds stop.
fun settle(t : ClassTable) -> Unit {
    var rounds = 0
    loop {
        var changed = False
        -- A round may begin derivations of its own, which join this one.
        var i = 0
        while i < len(t.provisional) {
            let key = t.provisional[i]
            i = i + 1
            if let Some(Deriving(inst)) = Map.get(t.derivations, key) {
                match inferContext(t, inst) {
                    Left(reason) -> {
                        withdraw(t, inst)
                        Map.put(t.derivations, key, Underivable(reason))
                        changed = True
                    }
                    Right(context) -> if !sameContext(context, inst.context) {
                        Vec.clear(inst.context)
                        for q in context { Vec.push(inst.context, q) }
                        changed = True
                    }
                }
            }
        }
        if !changed { break }
        rounds = rounds + 1
        if rounds > roundLimit(t) {
            bug("the contexts of derived instances did not settle", None)
        }
    }
    for key in t.provisional {
        if let Some(Deriving(inst)) = Map.get(t.derivations, key) {
            Map.put(t.derivations, key, Derived(inst))
        }
    }
}

-- More rounds than `settle` can take: one per class a context can gain over
-- one parameter, and one per instance that can fail.
fun roundLimit(t : ClassTable) -> Int {
    var params = 0
    for key in t.provisional {
        if let Some(Deriving(inst)) = Map.get(t.derivations, key) {
            params = params + len(Ty.spine(inst.head).1)
        }
    }
    params * len(Map.keys(t.classes)) + len(t.provisional) + 1
}

fun sameContext(a : Vec Pred, b : Vec Pred) -> Bool {
    if len(a) != len(b) { return False }
    let keys = Set.new()
    for p in a { Set.add(keys, Ty.predKey(p)) }
    Iterator.all(b, fun(q) = Set.contains(keys, Ty.predKey(q)))
}

-- Takes the derived instance `inst` out of the table.
fun withdraw(t : ClassTable, inst : InstInfo) -> Unit {
    let found = instancesOf(t, inst.cls)
    let key = instHeadKey(inst.head)
    let kept = Vec.filter(found, fun(other) = !(other.derived && instHeadKey(other.head) == key))
    Vec.clear(found)
    for other in kept { Vec.push(found, other) }
}

-- Returns the type `info` declares, applied to its parameters as the
-- constructors' results are: `Map k v`, over the variables they share.
fun declaredHead(info : TyconInfo) -> Option Ty.Type {
    if len(info.variants) == 0 { return None }
    match Ty.prune(info.variants[0].scheme.body) {
        TFun(_, ret) -> Some(ret)
        _ -> None
    }
}

-- Returns the context `inst` needs under the contexts the derivations being
-- settled have now, or why it can have none.
--
-- This is GHC's `inferConstraints` with `simplifyDeriv`. What is wanted is
-- the class at each field's type, and each superclass at the head itself, so
-- that a derived `Ord`'s context entails its derived `Eq`'s. Each wanted is
-- reduced through the instances that cover it until only classes over the
-- type's own parameters are left. Those are the context, less any implied
-- by another's superclasses. A wanted that reaches anything else, a type
-- with no instance or `f a` over a parameter `f`, leaves no context that
-- could hold, so there is no instance. A parameter only a phantom position
-- mentions is in no field's type, so nothing is ever wanted of it.
fun inferContext(t : ClassTable, inst : InstInfo) -> Either String (Vec Pred) {
    let cls = inst.cls
    let (h, args) = Ty.spine(inst.head)
    let tycon = match h {
        TCon(c) -> c.name
        _ -> return Left("it is not a declared type")
    }
    let info = match Map.get(t.decls.tycons, tycon) {
        Some(i) -> i
        None -> return Left("it is not a declared type")
    }
    let params = Set.new()
    for a in args {
        if let TVar(cell) = Ty.prune(a) { Set.add(params, cell.id) }
    }
    let n = writtenNamer(inst.names)
    let wanted = []
    for c in info.variants {
        -- Two values of one existential constructor may hide different
        -- types, so no instance for one hidden type compares them.
        if len(c.existsNames) > 0 {
            return Left("constructor '" + Ty.shortName(c.name) + "' hides the type '"
                        + c.existsNames[0] + "'")
        }
        let types = match Decls.conFieldTypes(t.decls, inst.head, c.name) {
            Some(ts) -> ts
            None -> return Left("it is not a declared type")
        }
        for var i = 0; i < len(types); i = i + 1 {
            if let Some(unmet) = reduce(t, Ty.pred(cls, [types[i]]), params, 0, wanted) {
                let written = if i < len(c.written) { writtenType(t, c.written[i], 0) }
                              else { Ty.showAt(types[i], n, 0) }
                let fix = match unmet {
                    Associated(_) | Equality(_, _) ->
                        "; write 'instance " + Ty.shortName(cls) + " "
                        + Ty.showAt(inst.head, n, 2) + "' by hand"
                    _ -> ""
                }
                return Left(fieldName(c, i) + " has type '" + written + "'"
                            + unmetTail(t, unmet, types[i], n) + fix)
            }
        }
    }
    match Map.get(t.classes, cls) {
        Some(ci) -> for sup in ci.supers {
            let shown = "'" + Ty.shortName(sup.name) + "'"
            if Option.isSome(writtenInstance(t, sup.name, tycon)) {
                return Left(shown + " is written by hand")
            }
            if refuses(t, tycon, sup.name) {
                return Left(shown + " is refused with '!" + Ty.shortName(sup.name) + "'")
            }
            if Option.isSome(reduce(t, Ty.pred(sup.name, [inst.head]), params, 0, wanted)) {
                return match Map.get(t.derivations, derivationKey(sup.name, tycon)) {
                    Some(Underivable(reason)) -> Left(reason)
                    _ -> Left(shown + " cannot be derived")
                }
            }
        }
        None -> {}
    }
    -- In the order of the parameters, then of the classes, so that a
    -- dictionary's parameters do not depend on the order of the fields.
    let position = Map.new()
    for var i = 0; i < len(args); i = i + 1 {
        if let TVar(cell) = Ty.prune(args[i]) { Map.put(position, cell.id, i) }
    }
    let ordered = Vec.sortByKey(minimal(t, wanted), fun(q) {
        let at = match Ty.prune(q.args[0]) {
            TVar(cell) -> Map.getOr(position, cell.id, 0)
            _ -> 0
        }
        (at, q.name)
    })
    Right(ordered)
}

-- What stopped a wanted from reducing to classes over parameters.
type Unmet
    -- No instance covers `cls` at the type.
    = Missing(String, Ty.Type)
    -- The wanted kept needing more after `reductionLimit` steps that grew.
    | Diverges(Pred)
    -- The type is an associated type applied to a type.
    | Associated(Ty.Type)
    -- The instance for `cls` needs the equality, which does not hold as its
    -- sides stand.
    | Equality(String, Pred)

-- More steps than this that do not ask for one of their instance head's
-- variables (`shrinks`) are taken not to end. A step that does asks for a
-- proper part of its wanted's type, and a run of those always ends, since a
-- type is finite, so only the others are counted. A field's type nested any
-- depth therefore reduces through instances like `Eq (Array a) : Eq a`, but
-- not through more than this many like `Eq (R a) : Eq (Array a)`. A written
-- instance's context may be no smaller than its head,
-- `Eq (W a) : Eq (W (Array a))`, and nothing else stops it reducing for ever.
let reductionLimit = 64

-- Reduces the wanted `p` through the instances that cover it, adding each
-- class over one of `params` it leaves to `out`, once. Returns what it could
-- not reduce, if anything. `grown` is how many steps so far did not ask for
-- one of their instance head's variables (`shrinks`).
fun reduce(t : ClassTable, p : Pred, params : Set.Set Int, grown : Int,
           out : Vec Pred) -> Option Unmet {
    if grown > reductionLimit { return Some(Diverges(p)) }
    let ty = Ty.prune(p.args[0])
    if let TVar(cell) = ty {
        if !Set.contains(params, cell.id) { return Some(Missing(p.name, ty)) }
        let key = Ty.predKey(p)
        if !Iterator.any(out, fun(q) = Ty.predKey(q) == key) { Vec.push(out, p) }
        return None
    }
    -- Match types against instances as they stand, with no associated type
    -- reduced, and refuse a wanted that would need one reduced. The refusal
    -- is conservative: it rejects some instances the solver would accept,
    -- and accepts none it would reject. Reducing here alone is not enough,
    -- because `Turkey.Lower` proves each field's instance at the field's
    -- type as written, and it would have to prove it at the same reduced
    -- type.
    if let TFam(_, _, _) = ty { return Some(Associated(ty)) }
    if let TVar(_) = Ty.spine(ty).0 { return Some(Missing(p.name, ty)) }
    match selectInstance(t, p) {
        None -> Some(Missing(p.name, ty))
        Some((inst, mapping)) -> {
            -- An equality whose sides are not one type as they stand has an
            -- associated type on its left, which would have to be reduced.
            for e in equalitiesAt(inst, mapping) {
                if !Ty.sameType(e.args[0], e.args[1]) { return Some(Equality(p.name, e)) }
            }
            let headVars = Ty.freeVars(inst.head)
            let wanted = contextAt(inst, mapping)
            for var i = 0; i < len(wanted); i = i + 1 {
                let next = if shrinks(inst.context[i], headVars) { grown } else { grown + 1 }
                if let Some(unmet) = reduce(t, wanted[i], params, next, out) { return Some(unmet) }
            }
            None
        }
    }
}

-- Returns whether the instance context predicate `q` asks for a proper part
-- of whatever type its instance's head matches, given `headVars`, the
-- variables of that head. A head is never a bare variable, so a variable of
-- the head stands for a proper part of the matched type. Deciding this from
-- the instance rather than from the types it is matched at costs only the
-- instance's size; a matched type can be exponentially large as a tree,
-- `W ((a, a), (a, a))` after two steps of `Eq (W a) : Eq (W (a, a))`, though
-- its nodes are shared.
fun shrinks(q : Pred, headVars : Set.Set Int) -> Bool = match Ty.prune(q.args[0]) {
    TVar(cell) -> Set.contains(headVars, cell.id)
    _ -> False
}

-- How a reason chain names field `i` of constructor `c`.
fun fieldName(c : ConInfo, i : Int) -> String = match c.fields {
    Some(labels) -> "field '" + labels[i] + "'"
    None -> "field " + Int.toString(i) + " of '" + Ty.shortName(c.name) + "'"
}

-- Returns the rest of a reason chain about a field of type `ty`, which
-- `unmet` stopped from having the class.
fun unmetTail(t : ClassTable, unmet : Unmet, ty : Ty.Type, n : Ty.Namer) -> String =
    match unmet {
        Missing(cls, leaf) -> {
            let inside = if Ty.sameType(leaf, ty) { "" }
                         else { ", which contains '" + Ty.showAt(leaf, n, 0) + "'" }
            inside + whyNot(t, cls, leaf)
        }
        Diverges(p) -> ", whose '" + Ty.shortName(p.name) + "' needs '"
                       + Ty.shortName(p.name) + "' at ever larger types"
        Associated(leaf) -> {
            let shown = "'" + Ty.showAt(leaf, n, 0) + "'"
            let what = if Ty.sameType(leaf, ty) { ", which is an associated type" }
                       else { ", which contains " + shown + ", an associated type" }
            what + ", and a derived instance cannot reduce one"
        }
        Equality(cls, e) -> ", whose '" + Ty.shortName(cls) + "' needs '"
                            + Ty.showAt(e.args[0], n, 0) + " ~ " + Ty.showAt(e.args[1], n, 0)
                            + "', and a derived instance cannot reduce an associated type"
    }

-- Returns `te`, a type as a declaration wrote it, as a diagnostic quotes it:
-- an alias by its own name, not by what it stands for.
fun writtenType(t : ClassTable, te : Type, prec : Int) -> String = match te.kind {
    TEVar(name) -> name
    TECon(name, args) -> applied(t, writtenName(t, name), args, prec)
    TEApp(head, args) -> applied(t, writtenType(t, head, 2), args, prec)
    TETuple(elems) -> "(" + String.join(Vec.map(elems, writtenType(t, _, 0)), ", ") + ")"
    TEFun(ps, ret) -> {
        let out = "fun(" + String.join(Vec.map(ps, writtenType(t, _, 0)), ", ") + ") -> "
                  + writtenType(t, ret, 0)
        if prec > 0 { "(" + out + ")" } else { out }
    }
}

-- An alias by its short name: one that names a built-in type, `Int` for
-- `Prim.Int`, shares that name with the type, and a type is qualified where
-- two share a name. An associated type is named by its member alone, as a
-- program writes it.
fun writtenName(t : ClassTable, name : String) -> String = match Map.get(t.decls.tycons, name) {
    Some(info) -> if info.isAlias { Ty.shortName(name) } else { Ty.display(name) }
    None -> if Map.contains(t.decls.families, name) { Ty.bareName(name) }
            else { Ty.display(name) }
}

fun applied(t : ClassTable, head : String, args : Vec Type, prec : Int) -> String {
    if len(args) == 0 { return head }
    let out = head + " " + String.join(Vec.map(args, writtenType(t, _, 2)), " ")
    if prec > 1 { "(" + out + ")" } else { out }
}

-- The end of a reason chain about `ty`, which has no `cls`.
fun whyNot(t : ClassTable, cls : String, ty : Ty.Type) -> String {
    let shown = "'" + Ty.shortName(cls) + "'"
    let (h, _) = Ty.spine(Ty.prune(ty))
    if let TCon(c) = h {
        if refuses(t, c.name, cls) { return ", which opts out of " + shown }
        if let Some(Underivable(reason)) = Map.get(t.derivations, derivationKey(cls, c.name)) {
            return ", whose " + reason
        }
    }
    ", which has no " + shown
}

-- Returns why the predicate `p`, which no instance covers, has none, when the
-- declaration of its type says why: it refuses the class, or asks for it and
-- it cannot be derived.
fun whyMissing(t : ClassTable, p : Pred) -> Option String {
    let (h, _) = Ty.spine(Ty.prune(p.args[0]))
    let c = match h {
        TCon(c) -> c
        _ -> return None
    }
    let lead = "'" + Ty.shortName(c.name) + "' has no '" + Ty.shortName(p.name) + "': "
    if refuses(t, c.name, p.name) {
        return Some(lead + "its declaration says '!" + Ty.shortName(p.name) + "'")
    }
    match Map.get(t.derivations, derivationKey(p.name, c.name)) {
        Some(Underivable(reason)) -> Some(lead + reason)
        _ -> None
    }
}

-- Checks the derive list of each declaration in `decls`, once every class
-- and instance they could name is in the table, and derives each class an
-- entry asks for, reporting at the entry why one cannot be.
fun checkDerives(t : ClassTable, decls : Vec TypeDecl) -> Unit {
    for d in decls {
        if Option.isSome(d.alias) || !Map.contains(t.decls.tycons, d.name) { continue }
        let wanted = []
        let seen : Vec Derive = []
        var valid = True
        for entry in d.derives {
            if let Some(earlier) = Iterator.find(seen, fun(e) = e.cls == entry.cls) {
                let cls = "'" + Ty.shortName(entry.cls) + "'"
                let ty = "'" + Ty.shortName(d.name) + "'"
                report(if earlier.refused == entry.refused {
                    cls + " appears twice in the derive list of " + ty
                } else {
                    ty + " both derives and refuses " + cls
                }, Some(entry.span))
                valid = False
                continue
            }
            Vec.push(seen, entry)
            if !checkEntry(t, d, entry) {
                valid = False
            } else if !entry.refused {
                Vec.push(wanted, entry)
            }
        }
        -- A list with a mistake in it does not say what to derive.
        if !valid { continue }
        for entry in wanted {
            if Option.isNone(derive(t, entry.cls, d.name)) {
                -- A derivation that failed with no reason found no
                -- constructors to read, which the declaration table has
                -- reported already.
                let state = Map.get(t.derivations, derivationKey(entry.cls, d.name))
                if let Some(Underivable(reason)) = state {
                    report("'" + Ty.shortName(d.name) + "' cannot derive '"
                           + Ty.shortName(entry.cls) + "': " + reason, Some(entry.span))
                }
            }
        }
    }
}

-- Reports what is wrong with one derive list entry, other than whether its
-- class can be derived for the type, and returns whether nothing is.
fun checkEntry(t : ClassTable, d : TypeDecl, entry : Derive) -> Bool {
    let ty = "'" + Ty.shortName(d.name) + "'"
    let cls = "'" + Ty.shortName(entry.cls) + "'"
    let refusal = "'!" + Ty.shortName(entry.cls) + "'"
    let at = Some(entry.span)
    if !Map.contains(t.classes, entry.cls) {
        report("unknown class '" + entry.cls + "'", at)
        return False
    }
    if entry.cls == P.typedClass {
        if entry.refused {
            report("every type has 'Typed', so '!Typed' cannot refuse it", at)
        } else {
            report("every type has 'Typed' already, so it cannot be derived; "
                   + "remove it from the list", at)
        }
        return False
    }
    if Option.isNone(derivedMethod(entry.cls)) {
        if entry.refused {
            report(cls + " is never derived, so " + refusal + " has no effect; remove it", at)
        } else {
            report(cls + " cannot be derived; write 'instance " + Ty.shortName(entry.cls)
                   + " " + Ty.shortName(d.name) + "' instead", at)
        }
        return False
    }
    if let Some(inst) = writtenInstance(t, entry.cls, d.name) {
        if entry.refused {
            report(ty + " has an instance of " + cls + " at "
                   + Source.showSpan(inst.decl.span) + ", so " + refusal
                   + " cannot refuse it; remove one of them", at)
        } else {
            report(ty + " already has an instance of " + cls + " at "
                   + Source.showSpan(inst.decl.span) + ", so it cannot also derive one; "
                   + "remove one of them", at)
        }
        return False
    }
    if entry.refused {
        if !refusable(entry.cls) {
            report(cls + " is derived only when a type asks for it, so " + refusal
                   + " has no effect; remove it", at)
            return False
        }
        return True
    }
    for sup in superclassesOf(t, entry.cls) {
        let supName = "'" + Ty.shortName(sup) + "'"
        if refuses(t, d.name, sup) {
            report("deriving " + cls + " derives " + supName + " as well, which '!"
                   + Ty.shortName(sup) + "' refuses; remove one of them", at)
            return False
        }
        if Option.isSome(writtenInstance(t, sup, d.name)) {
            report(ty + " cannot derive " + cls + " while its " + supName
                   + " is written by hand; write 'instance " + Ty.shortName(entry.cls)
                   + " " + Ty.shortName(d.name) + "' too, or remove 'instance "
                   + Ty.shortName(sup) + " " + Ty.shortName(d.name) + "' and derive "
                   + supName, at)
            return False
        }
    }
    True
}

fun byInst(t : ClassTable, p : Pred) -> Option (Array Pred) =
    Option.map(selectInstance(t, p), fun((inst, mapping)) = contextAt(inst, mapping))

-- Returns `inst`'s class context under `mapping`, a match of its head.
fun contextAt(inst : InstInfo, mapping : Map Int Ty.Type) -> Array Pred =
    Array.map(Vec.toArray(inst.context), fun(q) =
        Ty.pred(q.name, [Decls.substitute(q.args[0], mapping)]))

-- Returns `inst`'s whole context, its class predicates then its equalities:
-- the givens of its methods, and what a lambda over its evidence may assume.
-- `Turkey.Inert.granted` expands it, class predicates into their equality
-- superclasses, in one pass.
fun contextPreds(inst : InstInfo) -> Vec Pred = Vec.append(inst.context, inst.equalities)

-- Returns `inst`'s equalities under `mapping`, a match of its head.
fun equalitiesAt(inst : InstInfo, mapping : Map Int Ty.Type) -> Array Pred =
    Array.map(Vec.toArray(inst.equalities), fun(q) =
        Ty.pred(q.name, Array.map(q.args, Decls.substitute(_, mapping))))

-- Returns every equality the instances in `ev` need, at the types `ev` uses
-- them at. `prove` does not decide them.
fun provenEqualities(ev : Evidence) -> Vec Pred {
    let out = Vec.new(1)
    let work = [ev]
    while len(work) > 0 {
        match Vec.pop(work) {
            Some(FromInstance(inst, mapping, args)) -> {
                for q in equalitiesAt(inst, mapping) { Vec.push(out, q) }
                for a in args { Vec.push(work, a) }
            }
            _ -> {}
        }
    }
    out
}

-- Returns the instance that covers `p` and the match of its head against
-- `p`'s argument, or `None` if no instance does.
fun selectInstance(t : ClassTable, p : Pred) -> Option (InstInfo, Map Int Ty.Type) {
    if isGenerated(p.name) {
        let _ = synthesize(t, p)
    }
    if p.name == P.typedClass {
        let _ = deriveTyped(t, p)
    }
    for inst in instancesOf(t, p.name) {
        if let Some(mapping) = match_(inst.head, p.args[0]) {
            return Some((inst, mapping))
        }
    }
    -- After the table, so that an instance written by hand is the one found
    -- and nothing is derived beside it.
    let (receiver, _) = Ty.spine(Ty.prune(p.args[0]))
    if let TCon(c) = receiver {
        if let Some(inst) = derive(t, p.name, c.name) {
            if let Some(mapping) = match_(inst.head, p.args[0]) {
                return Some((inst, mapping))
            }
        }
    }
    None
}

-- Returns whether `given` proves `p`, by `prove`.
fun entail(t : ClassTable, given : Vec Pred, p : Pred) -> Bool {
    let named = Vec.new(len(given))
    for g in given { Vec.push(named, ("", g)) }
    Option.isSome(prove(t, named, p))
}

-- Returns the evidence that the dictionaries `given`, each under its name,
-- prove `p` with: a given reached through superclasses first, then an
-- instance. Returns `None` if they do not prove it.
--
-- Entailment as THIH has it, with no families and no equalities. It serves an
-- instance declaration, whose head and class context are constructors applied
-- to variables, so there is nothing to rewrite. An instance it selects may
-- have equalities in its context, and those are left to the caller
-- (`provenEqualities`), since deciding them needs the instance's own given
-- equalities.
fun prove(t : ClassTable, given : Vec (String, Pred), p : Pred) -> Option Evidence {
    let key = Ty.predKey(p)
    for (name, g) in given {
        if let Some(path) = superPath(t, g, key, []) {
            return Some(FromDict(name, path, Some(g)))
        }
    }
    let (inst, mapping) = selectInstance(t, p)?
    let args = Vec.new(len(inst.context))
    for q in contextAt(inst, mapping) { Vec.push(args, prove(t, given, q)?) }
    Some(FromInstance(inst, mapping, Vec.toArray(args)))
}

-- Returns the superclass names to select, in order, to reach the predicate
-- whose key is `key` from `given`, or `None` if no chain of superclasses does.
-- `path` is the chain already walked.
fun superPath(t : ClassTable, given : Pred, key : String,
              path : Array String) -> Option (Array String) {
    if Ty.predKey(given) == key { return Some(path) }
    let info = Map.get(t.classes, given.name)?
    for sup in info.supers {
        if let Some(found) = superPath(t, Ty.pred(sup.name, given.args), key,
                                       Array.append(path, [sup.name])) {
            return Some(found)
        }
    }
    None
}

fun isClass(t : ClassTable, name : String) -> Bool = Map.contains(t.classes, name)

-- The method a name denotes, if it denotes one rather than a function.
fun method(t : ClassTable, name : String) -> Option MethodInfo =
    match Map.get(t.owner, name) {
        None -> None
        Some(cls) -> Map.get(classNamed(t, cls).methods, name)
    }

-- Returns `preds` without each predicate that another of them implies by
-- superclasses, without a duplicate, and without an equality whose sides are
-- the same type, in the order given: GHC's `mkMinimalBySCs` (Note [Minimize
-- by Superclasses] in `GHC.Tc.Solver`). `[Ord a, Eq a]` is `[Ord a]`, and
-- `[Value a ~ Byte, Bytes a]` is `[Bytes a]` when `Value s ~ Byte` is a
-- superclass of `Bytes s`.
fun minimal(t : ClassTable, preds : Vec Pred) -> Vec Pred {
    -- What each predicate implies, its own key included, as GHC's
    -- `implicants`: a class predicate's superclass closure with the
    -- equalities that closure declares, and an equality in both directions.
    let clouds = Vec.map(preds, fun(p) {
        let keys = Set.new()
        Set.add(keys, minimalKey(p))
        if isClass(t, p.name) {
            for q in bySuper(t, p) { Set.add(keys, minimalKey(q)) }
            for e in superEqualities(t, p) { Set.add(keys, minimalKey(e)) }
        }
        keys
    })
    let kept = Vec.new(len(preds))
    let out = Vec.new(len(preds))
    for var i = 0; i < len(preds); i = i + 1 {
        let p = preds[i]
        if p.name == Ty.equals && len(p.args) == 2 && Ty.sameType(p.args[0], p.args[1]) {
            continue
        }
        -- Against what is still to come and what was kept, as GHC's `go`:
        -- `Eq a` before `Ord a` goes, and of two copies the second stays.
        let key = minimalKey(p)
        var implied = False
        for var j = i + 1; j < len(preds) && !implied; j = j + 1 {
            if Set.contains(clouds[j], key) { implied = True }
        }
        for j in kept {
            if Set.contains(clouds[j], key) { implied = True }
        }
        if !implied {
            Vec.push(kept, i)
            Vec.push(out, p)
        }
    }
    out
}

-- Returns the key `minimal` compares `p` by, which is the same for an
-- equality and its mirror.
fun minimalKey(p : Pred) -> String =
    if p.name == Ty.equals && len(p.args) == 2 { symmetricKey(p) } else { Ty.predKey(p) }

fun symmetricKey(p : Pred) -> String {
    let parts = Array.sort([Ty.typeKey(p.args[0]), Ty.typeKey(p.args[1])])
    String.join(parts, " ~ ")
}

-- -- matching ----------------------------------------------------------------------

-- One-way matching: bind the pattern's variables so it becomes the target.
--
-- Not unification. An instance head is a *pattern*, and letting it bind
-- variables in the type being classified would let instance selection invent
-- facts about the program rather than discover them.
fun match_(pattern : Ty.Type, target : Ty.Type) -> Option (Map Int Ty.Type) {
    let mapping = Map.new()
    if matchInto(pattern, target, mapping) { Some(mapping) } else { None }
}

fun matches(pattern : Ty.Type, target : Ty.Type) -> Bool =
    Option.isSome(match_(pattern, target))

fun matchInto(p : Ty.Type, t : Ty.Type, mapping : Map Int Ty.Type) -> Bool {
    let pat = Ty.prune(p)
    let target = Ty.prune(t)
    match pat {
        TVar(cell) -> match Map.get(mapping, cell.id) {
            None -> {
                Map.put(mapping, cell.id, target)
                True
            }
            Some(bound) -> Ty.sameType(bound, target)
        }
        TCon(c) -> match target {
            TCon(other) -> c.name == other.name
            _ -> False
        }
        TApp(pf, pa, _) -> match target {
            TApp(tf, ta, _) -> matchInto(pf, tf, mapping) && matchInto(pa, ta, mapping)
            _ -> False
        }
        TFun(pp, pr) -> match target {
            TFun(tp, tr) -> {
                if len(pp) != len(tp) { return False }
                for var i = 0; i < len(pp); i = i + 1 {
                    if !matchInto(pp[i], tp[i], mapping) { return False }
                }
                matchInto(pr, tr, mapping)
            }
            _ -> False
        }
        TTuple(pe) -> match target {
            TTuple(te) -> {
                if len(pe) != len(te) { return False }
                for var i = 0; i < len(pe); i = i + 1 {
                    if !matchInto(pe[i], te[i], mapping) { return False }
                }
                True
            }
            _ -> False
        }
        _ -> False
    }
}

-- -- skolems ----------------------------------------------------------------------

-- Turns a scheme's quantified variables into rigid nullary constructors.
--
-- One of these per checking scope, so that a method variable and an instance
-- variable that happen to share a name still get distinct constants.
type Skolems = Skolems {
    used    : Set.Set String,
    mapping : Map Int Ty.Type,
    -- Every constant made here, for the solver to stamp with the rank of the
    -- binder they belong to. Generation cannot do it: ranks are the solver's,
    -- and it is the one that knows how deep this body sits.
    made    : Vec ConCell,
}

fun newSkolems() -> Skolems =
    Skolems { used = Set.new(), mapping = Map.new(), made = Vec.new(4) }

fun skolemBind(s : Skolems, cell : VarCell, name : String) -> Ty.Type {
    var candidate = name
    var n = 1
    while Set.contains(s.used, candidate) {
        n = n + 1
        candidate = name + Int.toString(n)
    }
    Set.add(s.used, candidate)
    let con = Ty.skolemCon(candidate, cell.kind)
    Map.put(s.mapping, cell.id, TCon(con))
    Vec.push(s.made, con)
    TCon(con)
}

fun skolemApply(s : Skolems, t : Ty.Type) -> Ty.Type = Decls.substitute(t, s.mapping)

fun skolemApplyPred(s : Skolems, p : Pred) -> Pred =
    Ty.pred(p.name, Array.map(p.args, skolemApply(s, _)))

-- -- helpers ----------------------------------------------------------------------

fun classNamed(t : ClassTable, name : String) -> ClassInfo =
    match Map.get(t.classes, name) {
        Some(i) -> i
        None -> bug("unknown class '" + name + "'", None)
    }

fun instancesOf(t : ClassTable, cls : String) -> Vec InstInfo =
    Map.getOr(t.instances, cls, [])

-- Resolve an instance-body member by its surface short name.
--
-- Instance bodies declare `fun show`, not a qualified binding. The selected
-- class makes that spelling unambiguous even when another imported class has a
-- method with the same short name.
fun memberNamed(members : Array String, written : String) -> Option String {
    if Array.contains(members, written) { return Some(written) }
    let found = Vec.new(2)
    for name in members {
        if surfaceMember(name) == written { Vec.push(found, name) }
    }
    if len(found) == 1 { Some(found[0]) } else { None }
}

fun surfaceMember(name : String) -> String {
    let afterDot = match String.rsplitOnce(name, ".") {
        Some((_, after)) -> after
        None -> name
    }
    let afterHash = match String.rsplitOnce(afterDot, "#") {
        Some((_, after)) -> after
        None -> afterDot
    }
    if afterHash == "" { name } else { afterHash }
}

-- Reports a type error and returns, for a check that can skip what it was
-- checking and carry on. Registration goes on past an error so that every
-- declaration reports, and the generator stops once it is done.
fun report(message : String, where : Option Span) -> Unit = match where {
    None -> Diag.report(Diag.whole("type error", message))
    Some(s) -> Diag.report(Diag.at("type error", message, s))
}

-- A check only a compiler bug can fail, so it is not reported as the
-- program's fault.
fun bug(message : String, where : Option Span) -> a = match where {
    None -> Diag.fail(Diag.whole("internal error", message), "")
    Some(s) -> Diag.fail(Diag.at("internal error", message, s), s.file)
}

-- -- the dump -----------------------------------------------------------------------

-- The class table, in registration order.
--
-- Each class names the variable it abstracts over `a`, and its superclasses,
-- families and methods are printed against that one naming -- so the `a` in
-- `[Semigroup a]` and the `a` in `fun(a, a) -> a` are visibly the same variable.
-- An instance does the same over its head's variables.
fun showClasses(t : ClassTable) -> String {
    let b = String.builder()
    for (name, info) in Map.entries(t.classes) {
        let n = Ty.namerFrom([info.cvar], "")
        String.push(b, "class " + name + " " + info.param + " :: "
                       + Ty.showKind(classKind(info)) + "\n")
        for sup in Vec.append(info.supers, info.equalities) {
            String.push(b, "  super " + Ty.showPredWith(sup, n) + "\n")
        }
        for fam in Map.keys(info.families) {
            if let Some(fi) = Map.get(t.decls.families, fam) {
                String.push(b, "  family " + fam + " :: "
                    + Ty.showKind(fi.argKind) + " -> " + Ty.showKind(fi.resKind)
                    + "\n")
            }
        }
        for (mname, m) in Map.entries(info.methods) {
            String.push(b, "  method " + mname + " : " + Ty.showScheme(m.scheme)
                           + "\n")
        }
    }
    for (cls, insts) in Map.entries(t.instances) {
        for inst in insts {
            let n = Ty.namer("")
            String.push(b, "instance " + cls + " " + Ty.showAt(inst.head, n, 0)
                           + " [" + inst.module_ + "]\n")
            for p in Vec.append(inst.context, inst.equalities) {
                String.push(b, "  context " + Ty.showPredWith(p, n) + "\n")
            }
            for (fam, body) in Map.entries(inst.families) {
                String.push(b, "  type " + fam + " = " + Ty.showAt(body, n, 0)
                               + "\n")
            }
        }
    }
    String.build(b)
}
