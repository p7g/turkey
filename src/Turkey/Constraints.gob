export (
    oneOf,
    Constraint(..), Instantiates(..), PredCell(..), Implication(..), LetCell(..), cpredOf,
    cpredInto,
    noBinder,
    Binding(..), Env(..), newEnv, define, lookup_,
    Solver(..), newSolver, run, solve, families,
    fresh, adopt, rank,
    reach,
)

-- The constraint language, and the solver that settles it.
--
-- Inference is split the way HM(X) splits it: the generator walks the tree and
-- *builds* a constraint, deciding nothing and never looking a name up. This
-- module solves that constraint, and owns the two things solving needs: the type
-- environment, and the stack of pools that decides what generalizes.
--
-- A constraint names a binder by its id from `Turkey.Binders`, and the
-- environment is keyed by id. Resolution has already decided which binder each
-- occurrence means, so the environment needs no scopes: an id names one binder
-- wherever it appears, and shadowing cannot reach it.
--
--     t1 ~ t2            CEq         equality
--     P t                CPred       a predicate of the domain X
--     C1 and C2          CAnd        conjunction
--     exists a. C        CExists     variables generation invented
--     def x : t in C     CDef        monomorphic binding
--     let x = C1 in C2   CLet        generalize C1, bind the schemes, solve C2
--     x <= t             CInstance   a use site
--     forall k. Q => C   CAssume     an implication: the obligations a signature
--                                    grants, over the skolems it makes
--     evidence for P     CUse        a site that needs a dictionary it did not ask for
--
-- **Ranks live here, not in the generator.** A variable's rank is the depth of
-- the binder it was created under, and `CLet` is where that depth changes -- so
-- the solver assigns ranks as it descends, and the generator never mentions
-- them. The pools are Remy's: one list of variables per rank, so that leaving a
-- rank is a walk over the variables born there rather than a scan of the
-- environment. Leaving rank r partitions its pool -- variables still at r are
-- quantified, and variables unification has lowered are *adopted* by the parent
-- pool.
--
-- `HasField` is Gaster & Jones's `r \ l` with the rows removed; in that shape it
-- is GHC's `HasField x r a | x r -> a`. Records here are nominal, so entailment
-- is a declaration lookup. See `improve` for what the missing rows cost.
--
-- A class predicate is the fourth form. It is discharged from the instance
-- table, or from the assumptions a `CAssume` has in scope: checking an instance
-- method against its class's signature is the one place a predicate is *granted*
-- rather than proved, because the signature said so.
--
-- **Evidence is fixed when a class predicate is solved.** Each wanted carries
-- a hole (`Solved.Hole`), and the rule that discharges it fills the hole with
-- the derivation it used, at the types and under the givens it used them:
-- `classRule` for a given, an instance or bottom, and `letBody` for a
-- predicate a binding group retains as one of its dictionary parameters.
-- Nothing after solving looks a predicate up again, so no later pass can find
-- a different dictionary from the one solving accepted (Schrijvers et al.,
-- "Type checking with open type functions", ICFP 2008, §5; GHC's evidence
-- bindings).
--
-- **A `CAssume` is an implication** in OutsideIn(X)'s sense (Vytiniotis, Peyton
-- Jones, Schrijvers and Sulzmann, JFP 2011). Its body is always a `CLet` that
-- carries the skolems, so the implication's level is that `CLet`'s rank. Two
-- rules hold of it:
--
-- * Its body is solved against its givens to a *residual*, the predicates
--   `settle` leaves deferred when the `CLet` generalizes. A residual predicate
--   over variables of the implication's own rank is reported by the split,
--   because no scheme of a signature carries it. One over an outer variable
--   floats to the enclosing scope, unless it mentions one of the skolems:
--   then it is reported where it arose (`confine`). So no predicate that
--   mentions a skolem outlives the skolem's scope, and no outer variable is
--   ever bound to a type built from one.
-- * While an equality given is in scope, a variable born outside the
--   implication is *untouchable*: `Ty.unify` does not bind it, and defers the
--   equation instead, which then floats out with the residual. A given such
--   as `F b ~ Int` admits more than one solution for an outer `x` in
--   `x ~ Int` -- `Int` and `F b` both fit -- and choosing one would be a
--   guess the enclosing scope never sees (OutsideIn(X), Example 5.1). Class
--   givens add no such choice, so they leave every variable touchable.
--
-- **Equalities are rewrites, in two sets.** The equality givens in scope are
-- `inert`, a canonical substitution `Turkey.Inert` maintains, and a given that
-- can never hold is refused at its context. Every wanted is kept rewritten by
-- them: `unify` asks them about each family application and skolem it meets,
-- `defer` queues an equation in rewritten form, and `equals` retries one the
-- same way. The family equalities waiting in the queue rewrite the class
-- predicates beside them (`waiting`), but nothing else. So a wanted never
-- rewrites a given, and never proves itself.
--
-- An associated family makes an *equation* deferrable, and it comes back as the
-- equality predicate `~`, which is why there is one queue here rather than
-- two. `OneOf` is the last predicate: the closed set of
-- types a numeric literal could have, settled by three rules -- a singleton set
-- is an equation, two sets over one variable intersect, and a set nothing can
-- narrow further is defaulted.

import Data.Set as Set
import Turkey.Classes as Classes
import Turkey.Classes (ClassTable(..), InstInfo(..), MethodInfo(..))
import Turkey.Decls as Decls
import Turkey.Decls (DeclTable(..))
import Turkey.Diag as Diag
import Turkey.Inert as Inert
import Turkey.Inert (Given(..), Refusal(..))
import Turkey.Solved (Scope(..), Abstraction(..), Use(..), Hole(..), Proof(..), dictName,
                      newScope, newHole)
import Turkey.Source (Span(..), showSpan)
import Turkey.Typed as Typed
import Turkey.Types as Ty
import Turkey.Types (VarCell(..), ConCell(..), Scheme(..), Pred(..),
                     TVar, TCon, TApp, TFam, TFun, TTuple,
                     TSet, TBottom)

let oneOf = "OneOf"

-- -- the tree ----------------------------------------------------------------------

type Constraint
    -- `left ~ right`. The equality fragment of the domain.
    = CEq(Ty.Type, Ty.Type, Option Span, String)
    -- A predicate that must hold. The `String` names where the demand came
    -- from, for a diagnostic if it turns out unsatisfiable. A field access's
    -- predicate carries the verb instead -- "read" or "assign to" -- which is
    -- the one thing about a field access the predicate itself does not record;
    -- any other phrase is spliced into "expected ..., found ... in <phrase>".
    -- Mutable, because `improve` rewrites a predicate's arguments in place.
    | CPred(PredCell)
    | CAnd(Vec Constraint)
    -- `exists vars. body` -- the variables generation invented under a binder.
    -- This is how the generator hands the solver a set of variables without
    -- knowing what rank they belong to. The solver stamps them on the way in.
    | CExists(Vec VarCell, Constraint)
    -- Bind binders to *types* -- monomorphically -- while solving the body.
    -- Function parameters, `match` arm binders, and the placeholders of a
    -- recursive group. Nothing is generalized, so nothing changes rank. Each
    -- binder comes with its id and its name as the tree spells it. The flag
    -- says the binders are top-level.
    | CDef(Vec (Int, String, Ty.Type), Constraint, Bool)
    -- Bind binders to *schemes* already built, each with its id and spelling
    -- as in `CDef`. The one binder whose schemes
    -- solving does not discover: a `fun` with a complete annotation states its
    -- own type, so the scheme is in scope from the group's first line, which is
    -- what lets a recursive occurrence *instantiate* it. That is polymorphic
    -- recursion, admissible here because the type was stated rather than
    -- guessed.
    | CBind(Vec (Int, String, Scheme), Constraint, Bool)
    -- Solve the definition one rank deeper, generalize, bind the schemes, solve
    -- the body. The single place generalization happens.
    | CLet(LetCell)
    -- Solve the body with `givens` taken as facts: the implication described
    -- at the top of this module. The body is a `CLet` whose skolems are the
    -- implication's. The sources of assumptions are a *declared* type a body
    -- is being checked against, where the class's own predicate, the
    -- instance's context and the method's context are all facts, and the
    -- class context an existential pattern opens. An *equality* introduced by
    -- a pattern is what makes GADTs destroy principal types, and none is
    -- introduced here.
    -- Each given comes with where a context at this site wrote it, or `None`
    -- where none did: a class's method signature grants its context to every
    -- override, and an existential pattern grants the class context its
    -- constructor declares.
    | CAssume(Vec (String, Pred, Option Span), Constraint)
    -- `name <= t`: instantiate a scheme at `t`. The generator emits this
    -- instead of looking the name up, which is what lets it run without a type
    -- environment at all. The name is the occurrence's spelling, for
    -- diagnostics.
    | CInstance(String, Ty.Type, Option Span, Option Use, Instantiates)
    -- A site whose predicates were emitted on their own, as `CPred`s sharing
    -- the `Use`'s holes, but whose lowering needs the dictionaries that prove
    -- them. Solving it demands nothing; it records the use and the scopes open
    -- here. A field access is one: its predicates carry the verb a diagnostic
    -- needs, and a use emitted through `CInstance` would re-emit them as reads.
    | CUse(Use)
    -- Solve the body as one unit of diagnostics (`Diag.beginUnit`): after its
    -- first error, the rest of what it reports is dropped. The generator puts
    -- one around each top-level binding group's definition.
    | CUnit(Constraint)

-- A deferred predicate keeps its identity across rounds, and `improve` rewrites
-- its arguments where it stands, so it is a record rather than a variant field.
type PredCell = PredCell {
    var pred : Pred,
    span     : Option Span,
    context  : String,
    -- Where the evidence for a class predicate goes once it is discharged.
    -- Unused for any other predicate.
    hole     : Hole,
    -- The innermost implication enclosing where the predicate arose, whose
    -- givens alone may discharge it. `None` until the solver first meets it.
    var at   : Option Implication,
}

fun cpredOf(p : Pred, where : Option Span, context : String) -> Constraint =
    cpredInto(p, newHole(), where, context)

-- Returns the constraint that `p` holds, with its evidence to go into `hole`.
fun cpredInto(p : Pred, hole : Hole, where : Option Span, context : String) -> Constraint =
    CPred(PredCell { pred = p, span = where, context = context, hole = hole, at = None })

-- The givens of one `CAssume` together with those of every `CAssume` around
-- it: what a wanted that arose inside it may be discharged with.
--
-- A wanted is solved only under the givens of the implications that enclose
-- it, wherever the solver happens to be when it retries the wanted: `settle`
-- re-enters each wanted's own implication first. An outer wanted retried while
-- an inner signature's givens are in force would otherwise be discharged by
-- them, and its evidence would name a dictionary that is out of scope where
-- it is used (OutsideIn(X) keeps each wanted in its implication's tree for
-- the same reason).
type Implication = Implication {
    -- Unique per `CAssume` solved, and 0 for the top level, which has none.
    id          : Int,
    -- The class givens, innermost last, each under the name of its
    -- dictionary. Never changed once made.
    assumptions : Vec (String, Pred),
    -- The equality givens, canonical.
    inert       : Inert.Inert,
    -- The highest rank whose variables are untouchable: the rank a `CAssume`
    -- with an equality among its givens was entered at, or `Ty.noScope` when
    -- no such given is in scope.
    untouchable : Int,
}

-- What a `CInstance` instantiates.
type Instantiates
    -- The scheme bound to the binder with this id.
    = OfBinder(Int)
    -- This scheme, which no binder holds: an existential constructor with a
    -- context is used like a constrained function.
    | OfScheme(Scheme)

-- The id of a binder a `CLet` or `CDef` binds only for its rank, or of a
-- generated class's method: no occurrence names one, and the environment
-- never holds one by id.
let noBinder = -1

type LetCell = LetCell {
    -- Each binder's id, its name as the tree spells it, and its type.
    binds    : Vec (Int, String, Ty.Type),
    defn     : Constraint,
    body     : Constraint,
    span     : Option Span,
    topLevel : Bool,
    dicts    : Option Abstraction,
    -- Skolems that live exactly as long as the definition's rank -- the
    -- constants a signature's variables became. Carried here for the same reason
    -- ranks are the solver's business at all: this is the one place that knows
    -- how deep the definition sits, so this is where they can be stamped.
    skolems  : Vec ConCell,
    -- The partial annotations in the group: each member's source spelling,
    -- span, the variables its header wrote and the context it wrote, checked
    -- for rigidity when the group generalizes.
    rigid    : Vec (String, Span, Vec (String, Ty.Type), Vec Ty.Pred),
}

-- -- the environment ---------------------------------------------------------------

type Binding = Binding {
    scheme  : Scheme,
    -- Declared with `var`, so assignable.
    mutable : Bool,
}

type Env = Env {
    -- The binding of every binder in scope at the constraint being solved,
    -- by id. A local leaves once the constraint that binds it is solved, so a
    -- reference that outlives its binder is reported rather than read.
    binders : Map Int Binding,
    -- Every top-level binding, class method and primitive by its internal
    -- name, which the stages after inference look one up by.
    names   : Map String Binding,
}

fun newEnv() -> Env = Env { binders = Map.new(), names = Map.new() }

-- Binds the top-level binder `id`, internally named `name`, for good. With
-- `noBinder` for `id` -- a generated class's method, which no source
-- declares -- binds it by name only.
fun define(e : Env, id : Int, name : String, b : Binding) -> Unit {
    if id != noBinder { Map.put(e.binders, id, b) }
    Map.put(e.names, name, b)
}

-- Binds the binder `id` until `unbind` removes it.
fun bind(e : Env, id : Int, b : Binding) -> Unit = Map.put(e.binders, id, b)

fun unbind(e : Env, id : Int) -> Unit { let _ = Map.delete(e.binders, id) }

-- Returns what the binder `id` is bound to.
fun binding(e : Env, id : Int) -> Option Binding = Map.get(e.binders, id)

-- Returns the top-level binding, class method or primitive internally named
-- `name`.
fun lookup_(e : Env, name : String) -> Option Binding = Map.get(e.names, name)

-- -- the solver --------------------------------------------------------------------

type Solver = Solver {
    decls           : DeclTable,
    classes         : ClassTable,
    env             : Env,
    -- The value constructors in scope where a span is, by the module it is
    -- in: a component of modules is solved in one run, and each of its
    -- modules sees its own.
    visibleCons     : fun(Option Span) -> Set.Set String,
    -- The implication being solved in: the innermost `CAssume` around the
    -- constraint being solved, or around the wanted `settle` is retrying.
    -- Restored on the way out of each `CAssume`, which is what keeps a given
    -- inside its implication.
    var here        : Implication,
    -- How many `CAssume`s have been entered, for `Implication.id`.
    var entered     : Int,
    -- While `settle` retries the queue: the givens of `here` extended with the
    -- family equalities waiting in it from the same implication, which is
    -- what a class predicate is discharged under. A wanted rewrites other
    -- wanteds of its own implication's work list, and never a given or
    -- itself.
    var wanteds     : Option Inert.Inert,
    -- The dictionary scopes open at the point being solved, innermost last. A
    -- `Use` keeps the records rather than their contents, because what a binder
    -- makes available is only known once its definition is solved.
    scopes          : Vec Scope,
    uses            : Vec Use,
    -- `pools[r]` holds the variables born at rank r.
    pools           : Vec (Vec VarCell),
    -- Predicates that could not be settled yet.
    var deferred    : Vec PredCell,
}

fun newSolver(decls : DeclTable, env : Env, classes : ClassTable,
              visibleCons : fun(Option Span) -> Set.Set String) -> Solver =
    Solver {
        decls = decls, classes = classes, env = env, visibleCons = visibleCons,
        here = Implication {
            id = 0, assumptions = [], inert = Inert.empty(classes),
            untouchable = Ty.noScope,
        },
        entered = 0, wanteds = None,
        scopes = Vec.new(4), uses = Vec.new(16),
        pools = [Vec.new(8)], deferred = Vec.new(8),
    }

-- The two operations unification needs from the solver, as the record
-- `Turkey.Types` asks for. A record of closures rather than an interface, which
-- is what keeps the dependency pointing one way.
fun families(s : Solver) -> Option Ty.Families = Some(Ty.Families {
    reduce = fun(t) = reduceFam(s, t),
    defer = fun(a, b, sp, ctx) = defer(s, a, b, sp, ctx),
    untouchable = s.here.untouchable,
})

-- -- ranks -------------------------------------------------------------------------

fun rank(s : Solver) -> Int = len(s.pools) - 1

-- A variable at the current rank, recorded in the current pool.
fun fresh(s : Solver) -> VarCell {
    let v = Ty.freshVar(rank(s))
    Vec.push(s.pools[len(s.pools) - 1], v)
    v
}

-- Take responsibility for variables generation invented. They were created
-- without a rank -- generation has no idea what rank it is under -- so they are
-- stamped and pooled here.
fun adopt(s : Solver, vars : Vec VarCell) -> Unit {
    for v in vars {
        v.level = rank(s)
        Vec.push(s.pools[len(s.pools) - 1], v)
    }
}

-- -- families ----------------------------------------------------------------------

-- Returns what a family application, a skolem or a variable is by the givens
-- in scope and the instances, rewritten at every depth, or `None` if neither
-- says.
--
-- At every depth, though `unify` asks only about a head: two applications of
-- one family are the same type when their arguments are, and an argument the
-- instances decide has to be rewritten before that comparison can see it
-- (`Field.inner (Wrapped r)` is `r`).
fun reduceFam(s : Solver, t : Ty.Type) -> Option Ty.Type = Inert.rewritten(s.here.inert, t)

-- Take an equation unification could not decide.
--
-- It becomes an equality *predicate* rather than joining a queue of its own.
-- A stuck equation and a deferred predicate are waiting on the same thing, so
-- the binder that can carry one can carry the other.
--
-- Before queueing it, ask whether it *could* ever be decided: a family over a
-- constructor no instance covers is stuck for good, and the equation's own span
-- is the best place to say so. A family over a variable is merely waiting.
fun defer(s : Solver, a : Ty.Type, b : Ty.Type, where : Option Span,
          context : String) -> Unit {
    -- Rewritten by the givens first, at every depth: a wanted is always kept
    -- in that form. Unification decomposes an equation before it defers a
    -- part, so the part it defers is stuck at its head, but what is below the
    -- head may be what a given decides -- `x ~ Option (Elem b)` for an
    -- untouchable `x`, under `Elem b ~ Int`, is `x ~ Option Int`, which no
    -- longer mentions `b` and may leave the implication.
    let left0 = Inert.rewrite(s.here.inert, a)
    let right0 = Inert.rewrite(s.here.inert, b)
    if Ty.sameType(left0, right0) { return {} }
    for t in [left0, right0] {
        match t {
            TFam(name, arg, _) -> match Classes.uncovered(s.classes, name, arg) {
                -- A skolem is a nullary constructor, so a family over one looks
                -- exactly like a family over a type whose instance is missing.
                -- It is not: the declaration assumed that instance, and which
                -- one it will be is the caller's business. Such an equation is
                -- merely stuck, and is reported as stuck.
                Some(missing) -> if Option.isNone(granted(s, missing)) {
                    return Ty.typeError("no instance for '" + Ty.showPred(missing)
                                        + "', which '" + Ty.show(t) + "' needs", where)
                }
                None -> {}
            }
            _ -> {}
        }
    }
    -- Oriented family-first, so a carried equality reads the way a written one
    -- has to be written: `Item a ~ Op`, never `Op ~ Item a`. Nothing depends on
    -- the order, but a scheme is read by people.
    let flip = familyLike(right0) && !familyLike(left0)
    let left = if flip { right0 } else { left0 }
    let right = if flip { left0 } else { right0 }
    Vec.push(s.deferred, PredCell {
        pred = Ty.pred(Ty.equals, [left, right]), span = where, context = context,
        hole = newHole(), at = Some(s.here),
    })
}

-- -- solving -----------------------------------------------------------------------

fun run(s : Solver, c : Constraint) -> Unit {
    solve(s, c)
    settle(s)
    -- What is left open after an error is most often open because of it, so
    -- defaulting it would only guess, and `rejectStranded` reports nothing.
    if Diag.hasErrors() { return }
    -- The outermost boundary: nothing further can narrow what is left, so
    -- anything still open that has a default takes it, and the rest is an error.
    --
    -- A run is one component of modules that import each other -- most often
    -- a single module. So a top-level binding the value restriction keeps
    -- monomorphic has its literals and class constraints settled by the uses
    -- in its own component, and a module that imports it from outside,
    -- checked in a later run, is too late to decide them. Its plain type variables are another matter:
    -- nothing here defaults them, so they stay open in the shared environment
    -- and an importer's uses fix them.
    var going = True
    while going && len(s.deferred) > 0 {
        if applyDefaults(s, Vec.slice(s.deferred, 0, len(s.deferred))) {
            settle(s)
        } else {
            going = False
        }
    }
    rejectStranded(s, s.deferred)
}

fun solve(s : Solver, c : Constraint) -> Unit = match c {
    CEq(left, right, where, context) ->
        Ty.unify(left, right, where, context, families(s))
    CPred(cell) -> {
        if Option.isNone(cell.at) { cell.at = Some(s.here) }
        if !entail(s, cell) { Vec.push(s.deferred, cell) }
    }
    CAnd(parts) -> for p in parts { solve(s, p) }
    CExists(vars, body) -> {
        adopt(s, vars)
        solve(s, body)
    }
    CAssume(givens, body) -> {
        let outside = s.here
        let assumptions = Vec.slice(outside.assumptions, 0, len(outside.assumptions))
        var untouchable = outside.untouchable
        var inert = outside.inert
        let equalities = Vec.new(len(givens))
        let named = Vec.new(len(givens))
        for (n, p, at) in givens {
            Vec.push(named, (n, p))
            if p.name == Ty.equals {
                Vec.push(equalities, Given { pred = p, span = at })
                if rank(s) > untouchable { untouchable = rank(s) }
            } else {
                Vec.push(assumptions, (n, p))
            }
        }
        -- The inert set this implication made, if it made one: only that one
        -- is closed on the way out (`Inert.close`), never the enclosing one it
        -- extends or shares.
        var made = None
        var inaccessible = False
        if len(equalities) > 0 {
            -- Breakers at the rank of the body's `CLet`, so their equations
            -- stay inside the implication.
            let (extended, refused) = Inert.extendAt(outside.inert, Vec.toArray(equalities),
                                                     rank(s) + 1)
            for r in refused {
                if refusedHere(r, body) { inaccessible = True }
            }
            inert = extended
            made = Some(extended)
        }
        s.entered = s.entered + 1
        let inside = Implication {
            id = s.entered, assumptions = assumptions, inert = inert,
            untouchable = untouchable,
        }
        s.here = inside
        let assumed = newScope()
        assumed.givens = named
        Vec.push(s.scopes, assumed)
        -- A given no context here wrote, and that can never hold, makes the body
        -- *inaccessible*: an override checked under it can never be called
        -- (System FC, Sulzmann et al. 2007, §3.5). So the body is solved, but
        -- nothing it reports is shown, as GHC treats an implication whose givens
        -- are insoluble.
        if inaccessible { Diag.beginMuted() }
        solve(s, body)
        if inaccessible { Diag.endMuted() }
        -- What is still queued from inside has floated out: it mentions no
        -- skolem of this implication (`confine`), so it is solved outside it,
        -- with the givens there. Moved before the inert set is closed, after
        -- which its cycle breakers stand for their family applications and
        -- rewriting with it would not end.
        for c in s.deferred {
            if let Some(impl) = c.at {
                if impl.id == inside.id { c.at = Some(outside) }
            }
        }
        match made {
            Some(i) -> Inert.close(i)
            None -> {}
        }
        s.here = outside
        discard(Vec.pop(s.scopes))
    }
    CDef(binds, body, top) -> {
        if top { decideTopLevelLiterals(s) }
        for (id, name, ty) in binds {
            bindFor(s, id, name, Binding { scheme = Ty.mono(ty), mutable = top }, top)
        }
        solve(s, body)
        if !top { for (id, _, _) in binds { unbind(s.env, id) } }
    }
    CBind(binds, body, top) -> {
        for (id, name, sch) in binds {
            bindFor(s, id, name, Binding { scheme = sch, mutable = top }, top)
        }
        solve(s, body)
        if !top { for (id, _, _) in binds { unbind(s.env, id) } }
    }
    CLet(cell) -> solveLet(s, cell)
    CInstance(name, ty, where, use, of) ->
        solveInstance(s, name, ty, where, use, of)
    CUse(u) -> {
        u.scopes = Vec.slice(s.scopes, 0, len(s.scopes))
        Vec.push(s.uses, u)
    }
    CUnit(body) -> {
        Diag.beginUnit()
        solve(s, body)
        discard(Diag.endUnit())
    }
}

-- Reports the refusal `r` of an implication's given where its context wrote
-- it, and returns whether it instead makes the implication, whose body is
-- `body`, inaccessible: a given that can never hold and that no context here
-- wrote.
fun refusedHere(r : Inert.Refusal, body : Constraint) -> Bool = match r {
    Never(g, why) -> match g.span {
        Some(_) -> {
            Ty.typeError("the equality '" + Ty.showPred(g.pred) + "' in this context "
                         + "can never hold; " + why, g.span)
            False
        }
        None -> True
    }
    GaveUp(g, left) -> {
        Ty.typeError("cannot resolve the equalities in this context: the checker "
                     + "gave up with " + Int.toString(left) + " of them still to "
                     + "add; state fewer of them", firstSpan(g.span, assumptionSpan(body)))
        False
    }
}

-- Returns where the declaration an implication checks is: the body of a
-- `CAssume` is the `CLet` that carries its skolems.
fun assumptionSpan(body : Constraint) -> Option Span = match body {
    CLet(cell) -> cell.span
    _ -> None
}

-- Binds `id` to `b`: for good and under its internal name `name` when the
-- binder is top-level, and otherwise until the constraint that binds it is
-- solved. A binder bound only for its rank is not bound at all.
fun bindFor(s : Solver, id : Int, name : String, b : Binding, top : Bool) -> Unit {
    if id == noBinder { return {} }
    if top { define(s.env, id, name, b) } else { bind(s.env, id, b) }
}

-- `name <= t`: instantiate, and re-emit the scheme's obligations.
--
-- A scheme's predicates are demands on whoever instantiates it, so they come
-- back as constraints over this site's fresh variables, attributed to the
-- context of `name`. A field predicate among them reports as a read: a scheme
-- records which field it needs, not whether the access that produced the
-- demand was a read or an assignment.
fun solveInstance(s : Solver, name : String, ty : Ty.Type, where : Option Span,
                  use : Option Use, of : Instantiates) -> Unit {
    let scheme = match of {
        OfScheme(sc) -> sc
        OfBinder(id) -> match binding(s.env, id) {
            Some(b) -> b.scheme
            None -> bug("generation let '" + name + "' through unbound", where)
        }
    }
    let (preds, instantiated, typeArgs) =
        Ty.instantiateQual(scheme, fun() = fresh(s))
    Ty.unify(instantiated, ty, where, "", families(s))
    match use {
        Some(u) -> {
            -- Only the class predicates: `HasField` and `OneOf` are discharged
            -- by a lookup and a decision, and leave nothing behind to pass.
            let kept = Vec.new(len(preds))
            let holes = Vec.new(len(preds))
            for p in preds {
                if Classes.isClass(s.classes, p.name) {
                    Vec.push(kept, p)
                    Vec.push(holes, newHole())
                }
            }
            u.preds = kept
            u.holes = holes
            -- Every type argument, though, and unfiltered: a type application
            -- has to name one per quantified variable or it is not the scheme's
            -- instantiation. They are recorded before unification has run to
            -- completion and are variables at this point, which is correct --
            -- what they turn out to be is read back after solving.
            u.typeArgs = typeArgs
            u.scopes = Vec.slice(s.scopes, 0, len(s.scopes))
            Vec.push(s.uses, u)
        }
        None -> {}
    }
    let context = "the context of '" + Ty.shortName(name) + "'"
    -- A class predicate's evidence goes into the hole the use reads it from.
    var k = 0
    for p in preds {
        let hole = match use {
            Some(u) -> if Classes.isClass(s.classes, p.name) {
                k = k + 1
                u.holes[k - 1]
            } else {
                newHole()
            }
            None -> newHole()
        }
        solve(s, cpredInto(p, hole, where, context))
    }
}

-- Solve the definition one rank in, generalize, then solve the body.
--
-- The order matters and is the reason this is one function. Predicates are
-- settled *before* the split, so that anything the definition learned has been
-- applied; the split then uses the same test generalization uses for type
-- variables, and the pool is emptied either into the schemes or into the
-- parent's pool.
fun solveLet(s : Solver, c : LetCell) -> Unit {
    Vec.push(s.pools, Vec.new(8))
    -- Now that the rank exists, the constants that belong to it can say so.
    -- They keep the stamp after the rank is gone, so an equation solved later
    -- that binds a variable from outside this rank to one of them is still an
    -- escape that `Ty.escaping` reports.
    for con in c.skolems { con.level = rank(s) }
    letBody(s, c)
}

-- A top-level binding group is a unit (`Diag.beginUnit`), its generalization
-- included. Its definition is a `CUnit` of its own, which nests inside this
-- one. When the unit reports an error, its binders are bound to bottom rather
-- than to the scheme its half-solved types would generalize to, so that a
-- later group using one absorbs the use instead of reporting the same error
-- again against it. Bottom unifies with anything and binds nothing.
fun letBody(s : Solver, c : LetCell) -> Unit {
    if c.topLevel { Diag.beginUnit() }
    let scope = newScope()
    Vec.push(s.scopes, scope)
    let firstUse = len(s.uses)
    solve(s, c.defn)
    discard(Vec.pop(s.scopes))
    settle(s)
    confine(s, c.skolems)
    let types = Array.map(c.binds, _.2)
    let retainedPreds = split(s, types)
    -- An equation tied to a variable this binder quantifies can never be decided
    -- by an enclosing one -- nothing outside mentions the variable -- so this is
    -- where it is stuck for good.
    match Vec.pop(s.pools) {
        Some(young) -> dischargePool(s, young)
        None -> {}
    }
    checkRigid(s, c, retainedPreds)

    -- The class predicates are shared across the group, and the dictionary
    -- parameters with them. One member's body may call another's, so a per-name
    -- context would leave that call needing a dictionary the caller's own
    -- signature never promised. Everything else stays per name: a `HasField` is
    -- erased, so nothing has to agree about it.
    let classPreds = Vec.new(4)
    for p in retainedPreds {
        if Classes.isClass(s.classes, p.pred.name) { Vec.push(classPreds, p.pred) }
    }
    let shared = Classes.simplify(s.classes, classPreds)
    let givens = Vec.new(len(shared))
    for p in shared { Vec.push(givens, (dictName(p.name), p)) }
    -- A retained class predicate is discharged by the dictionary parameter
    -- that carries it, or by a superclass of one: `simplify` keeps a
    -- predicate unless another implies it.
    for p in retainedPreds {
        if Classes.isClass(s.classes, p.pred.name) {
            p.hole.proof = Some(fromContext(s, givens, p))
        }
    }
    -- The scope holds the retained equalities too, though they pass no
    -- dictionary: a scrutinee in the body may be a family application that
    -- only one of them decides, and exhaustiveness reads it under the same
    -- (`Infer.resolveUnder`). The scheme carries them as well, and a class
    -- predicate in the body may have been discharged under one (`waiting`),
    -- at a type Core accepts only under the same equality.
    let scopeGivens = Vec.slice(givens, 0, len(givens))
    for p in retainedPreds {
        if p.pred.name == Ty.equals { Vec.push(scopeGivens, ("", p.pred)) }
    }
    scope.givens = scopeGivens
    -- A call from one member of the group to another -- or to itself -- was
    -- solved against the *monomorphic* placeholder `CDef` bound, so it demanded
    -- nothing and would be handed the undischarged binding at run time. It needs
    -- the group's own dictionaries, which is exactly what the scope now holds.
    let group = Set.new()
    for (id, _, _) in c.binds { Set.add(group, id) }
    if len(shared) > 0 {
        for var i = firstUse; i < len(s.uses); i = i + 1 {
            let u = s.uses[i]
            let inGroup = match u.binder {
                Some(id) -> Set.contains(group, id)
                None -> False
            }
            if len(u.preds) == 0 && inGroup && holdsScope(u.scopes, scope) {
                u.preds = shared
                u.holes = Vec.map(givens, fun((name, p)) =
                    Hole { proof = Some(ByGiven(name, [], p)) })
            }
        }
    }
    match c.dicts {
        Some(a) -> {
            let params = Vec.new(len(givens))
            for (n, _) in givens { Vec.push(params, n) }
            a.params = params
            a.preds = shared
        }
        None -> {}
    }

    for (id, name, ty) in c.binds {
        -- Rewritten once more, by the givens and the instances: a side may
        -- have become reducible since the equation was last retried.
        let own = Vec.new(4)
        for p in constrain(retainedPreds, ty) {
            if !Classes.isClass(s.classes, p.name) {
                Vec.push(own, Ty.pred(p.name, Array.map(p.args,
                                                        Inert.rewrite(s.here.inert, _))))
            }
        }
        let preds = Classes.simplify(s.classes, Vec.append(own, shared))
        -- Reduced at every level, not just the head. A field access has the
        -- type `Field.n r`, and once `r` is a known record that family *is*
        -- the field's type -- leaving it unreduced would put machinery in a
        -- signature a reader has to read. Head-only reduction is right for
        -- unification and not for anything that reads a type whole, which a
        -- scheme is.
        let body = Inert.rewrite(s.here.inert, ty)
        let b = Binding {
            scheme = Ty.generalize(body, rank(s), preds), mutable = False,
        }
        match c.dicts {
            -- Recorded here because here is the only place it exists: a local
            -- binding's scheme goes into an environment popped as soon as the
            -- body has been solved.
            Some(a) -> Map.put(a.schemes, name, b.scheme)
            None -> {}
        }
        bindFor(s, id, name, b, c.topLevel)
    }
    if c.topLevel && Diag.endUnit() {
        for (id, name, _) in c.binds {
            bindFor(s, id, name, Binding { scheme = Ty.mono(TBottom), mutable = False }, True)
        }
    }
    solve(s, c.body)
    if !c.topLevel { for (id, _, _) in c.binds { unbind(s.env, id) } }
}

-- Returns the evidence for the retained predicate `c` from `givens`, the
-- dictionary parameters of the binding group that retained it.
fun fromContext(s : Solver, givens : Vec (String, Pred), c : PredCell) -> Proof {
    let key = Ty.predKey(c.pred)
    for (name, g) in givens {
        if let Some(path) = Classes.superPath(s.classes, g, key, []) {
            return ByGiven(name, path, g)
        }
    }
    bug("the context of a binding group does not imply '" + Ty.showPred(c.pred)
        + "', which it retained", c.span)
}

-- A partial annotation is an assertion too: each variable its header wrote must
-- still be a variable, distinct from the header's others, about to be
-- quantified by this binder, and constrained only by the context the header
-- wrote. Otherwise the header claimed something inference did not deliver.
fun checkRigid(s : Solver, c : LetCell, retainedPreds : Vec PredCell) -> Unit {
    for (name, where, header, written) in c.rigid {
        let varNames = Vec.new(len(header))
        for (n, _) in header { Vec.push(varNames, n) }
        let seen = Ty.namer("")
        for varName in Vec.sort(varNames) {
            var t = Ty.tUnit()
            for (n, v) in header { if n == varName { t = v } }
            match Ty.prune(t) {
                TVar(cell) -> {
                    match Map.get(seen.names, cell.id) {
                        Some(other) -> return Ty.typeError("the annotation on '" + name
                            + "' says '" + other + "' and '" + varName + "' are separate "
                            + "types, but its body makes them the same", Some(where))
                        None -> {}
                    }
                    Map.put(seen.names, cell.id, varName)
                    if cell.level <= rank(s) {
                        return Ty.typeError("the annotation on '" + name + "' says '"
                            + varName + "' is any type, but its body ties it to a type "
                            + "from outside '" + name + "'", Some(where))
                    }
                }
                other -> return Ty.typeError("the annotation on '" + name + "' says '"
                    + varName + "' is any type, but its body makes it '"
                    + Ty.show(other) + "'", Some(where))
            }
        }
        let allowed = Set.new()
        for p in written {
            for q in Classes.bySuper(s.classes, p) { Set.add(allowed, predKey(q)) }
        }
        for cp in retainedPreds {
            var touches = False
            for v in Ty.varsOf(cp.pred.args) {
                if Map.contains(seen.names, v.id) { touches = True }
            }
            if touches && !Set.contains(allowed, predKey(cp.pred)) {
                -- A literal's demand cannot be written in a context, so it is
                -- reported as what it does to the variable.
                if cp.pred.name == oneOf {
                    let varName = Ty.showAt(cp.pred.args[0], seen, 0)
                    let members = match cp.pred.args[1] {
                        TSet(names) -> Ty.quoteLiteralSet(names)
                        other -> Ty.show(other)
                    }
                    return Ty.typeError("the annotation on '" + name + "' says '"
                        + varName + "' is any type, but its body makes it one of "
                        + members, Some(where))
                }
                return Ty.typeError("the body of '" + name + "' needs '"
                    + Ty.showPredWith(cp.pred, seen) + "', which its "
                    + "annotation's context does not list; add it to the "
                    + "context", Some(where))
            }
        }
    }
}

fun predKey(p : Ty.Pred) -> String =
    p.name + "(" + String.join(Array.map(p.args, Ty.typeKey), ",") + ")"

-- Membership by the scope's own id: two scopes granting the same predicates are
-- still two scopes, so structure cannot answer this.
fun holdsScope(scopes : Vec Scope, wanted : Scope) -> Bool {
    for sc in scopes {
        if sc.id == wanted.id { return True }
    }
    False
}

-- The predicates the schemes about to be built will carry.
--
-- Defaulting sits between splitting and reporting, because ambiguity is
-- precisely the condition that licenses it: a predicate no scheme can carry
-- mentions a variable that appears in no type being generalized, so no use site
-- will ever pin it. Choosing for one can unblock another, so the split is redone
-- until it stops moving.
fun split(s : Solver, types : Array Ty.Type) -> Vec PredCell {
    var going = True
    var out = []
    while going {
        let retainedPreds = retained(s, rank(s) - 1)
        -- An array literal's container is never quantified, even when the
        -- binding's type mentions it: lowering builds each literal as one
        -- constructor, chosen once, where a quantified container would need a
        -- choice per use. So such a binding takes the default -- `fun empty()
        -- = []` is `fun() -> Array a` -- and a use wanting another container
        -- is a plain mismatch against `Array` at that use.
        -- Nor is an equation whose variable occurs in its other side under a
        -- family, `a ~ Option (F a)`: no signature can state it, and once
        -- nothing more can decide `F a` it is the infinite type it looks like.
        let stranded = Vec.filter(retainedPreds, fun(p) = isArrayLiteralDemand(p)
                                                         || isOccursEquation(p))
        for p in unattributed(retainedPreds, types) {
            if !isArrayLiteralDemand(p) && !isOccursEquation(p) { Vec.push(stranded, p) }
        }
        if len(stranded) == 0 || !applyDefaults(s, stranded) {
            rejectStranded(s, stranded)
            out = retainedPreds
            going = False
        } else {
            -- Something was decided. Put the split back and settle again, so the
            -- choice is visible to everything that was waiting on it.
            for p in retainedPreds { Vec.push(s.deferred, p) }
            settle(s)
        }
    }
    out
}

-- Hand every variable born at the rank just left to its new owner.
--
-- One still at that rank belongs to the scheme about to be built, and
-- `generalize` will quantify it. One unification has lowered escaped into an
-- enclosing binding, and the parent pool adopts it so that the *next* binder
-- sees it as its own. Doing this structurally is the point of the pools: there
-- is no place left to forget it.
fun dischargePool(s : Solver, young : Vec VarCell) -> Unit {
    let left = rank(s) + 1
    for v in young {
        match Ty.prune(TVar(v)) {
            -- Bound during solving; unification adjusted what it points at.
            TVar(pruned) -> if pruned.level < left {
                Vec.push(s.pools[len(s.pools) - 1], pruned)
            }
            _ -> {}
        }
    }
}

-- -- predicates --------------------------------------------------------------------

-- Retries the deferred predicates until a round no longer shrinks the queue.
--
-- Each round improves the queue and re-solves what is in it; a predicate that is
-- still stuck goes straight back on the queue. Discharging one can bind
-- variables another was waiting on, which is why this iterates.
--
-- **Termination.** A round goes on to the next only if it leaves fewer
-- predicates than the queue held before the round began, improvement included,
-- so the length of the queue strictly decreases from round to round and this
-- runs at most as many rounds as it started with predicates. Improvement may
-- add predicates (unifying two answers can defer an equation) and solving may
-- too (an instance's context), which is why the count is taken before both.
--
-- Equalities go first within a round: a family that has become reducible decides
-- a type, and a predicate waiting on that type can then settle in the same
-- round.
fun settle(s : Solver) -> Unit {
    while len(s.deferred) > 0 {
        let before = len(s.deferred)
        improve(s)
        let pending = Vec.sortBy(s.deferred, fun(a, b) = {
            let ka = if a.pred.name == Ty.equals { 0 } else { 1 }
            let kb = if b.pred.name == Ty.equals { 0 } else { 1 }
            Int.compare(ka, kb)
        })
        s.deferred = Vec.new(8)
        let saved = s.wanteds
        let outside = s.here
        -- Each wanted is retried in its own implication, under that
        -- implication's givens and the equalities waiting beside it there.
        let rounds = Map.new()
        for c in pending {
            let impl = Option.unwrapOr(c.at, outside)
            if !Map.contains(rounds, impl.id) {
                Map.put(rounds, impl.id, waiting(s, impl, pending))
            }
            s.here = impl
            s.wanteds = Map.getOr(rounds, impl.id, None)
            solve(s, CPred(c))
        }
        s.here = outside
        s.wanteds = saved
        -- The rounds' own cycle breakers, if their equalities needed any: an
        -- obligation of an instance found under them may mention one.
        for (_, round) in Map.entries(rounds) {
            match round {
                Some(i) -> Inert.close(i)
                None -> {}
            }
        }
        if len(s.deferred) >= before { return {} }
    }
}

-- Returns the givens of `impl` extended with the family equalities among
-- `pending` that arose in it, or `None` if there are none.
fun waiting(s : Solver, impl : Implication, pending : Vec PredCell) -> Option Inert.Inert {
    -- An equality the queue holds is one nothing has proved yet. Used as a
    -- rule for the class predicates beside it, it is sound either way: if a
    -- scheme retains it, every caller proves it, and if it is solved later,
    -- unification makes both sides one anyway. It is never used to retry an
    -- equality (`equals` reads only the givens), so none proves itself.
    let eqs = Vec.new(4)
    for c in pending {
        if c.pred.name == Ty.equals && Ty.isFam(c.pred.args[0])
                && Option.unwrapOr(c.at, impl).id == impl.id {
            Vec.push(eqs, Given { pred = c.pred, span = c.span })
        }
    }
    if len(eqs) == 0 { return None }
    -- What it refuses is a wanted that is false or stuck, which retrying it
    -- reports where it arose.
    let (extended, _) = Inert.extendAt(impl.inert, Vec.toArray(eqs), rank(s))
    Some(extended)
}

-- Improvement: what the deferred set decides between two of its own members.
--
-- There used to be a third rule here, equating the results of two demands for
-- one field of one receiver -- `HasField l r a` and `HasField l r b` forcing
-- `a ~ b` -- because a record type has exactly one type for a given field and
-- with the field type in a third argument nothing else said so. In Gaster &
-- Jones the rule does not exist, since with rows the field's type sits inside
-- the receiver's and two accesses agree by ordinary unification.
--
-- It is gone for the same reason: `r.f` has the type `Field.f r`, so two reads
-- are the same type expression rather than two variables, and unification
-- equates them without being told to.
fun improve(s : Solver) -> Unit {
    improveNumeric(s)
    improveFamilies(s)
}

-- Replaces each equality on a family application that another before it in
-- the queue is also on, by the equation between their two answers.
--
-- OutsideIn(X)'s rule for two equalities on one family application (its
-- `feqfeq`), and the same reason as `improve`'s: a family is a *function* of
-- its argument, so `Item c ~ Op` and `Item c ~ Char` cannot both hold. Neither
-- is discharged while `Item c` is stuck, so without this they would both be
-- carried and the contradiction would never be reported at all. The second is
-- dropped rather than kept beside the first, so this never leaves the queue
-- longer than the equations it adds.
fun improveFamilies(s : Solver) -> Unit {
    let seen = Map.new()
    let keep = Vec.new(len(s.deferred))
    let answers = Vec.new(2)
    for c in s.deferred {
        if c.pred.name == Ty.equals && Ty.isFam(c.pred.args[0]) {
            let left = c.pred.args[0]
            let key = Ty.typeKey(left)
            match Map.get(seen, key) {
                Some((first, at)) -> {
                    if !Ty.sameType(first, c.pred.args[1]) {
                        Vec.push(answers, (first, c.pred.args[1], firstSpan(c.span, at),
                                           "the uses of '" + Ty.show(left) + "'",
                                           Option.unwrapOr(c.at, s.here)))
                    }
                    continue
                }
                None -> Map.put(seen, key, (c.pred.args[1], c.span))
            }
        }
        Vec.push(keep, c)
    }
    s.deferred = keep
    let outside = s.here
    for (a, b, at, context, impl) in answers {
        s.here = impl
        Ty.unify(a, b, at, context, families(s))
    }
    s.here = outside
}

fun firstSpan(a : Option Span, b : Option Span) -> Option Span = match a {
    Some(_) -> a
    None -> b
}

-- Try to discharge one predicate. `False` means "not yet" -- defer it. An
-- unsatisfiable predicate reports; only genuine lack of information answers
-- `False`, so nothing can be quietly dropped.
fun entail(s : Solver, c : PredCell) -> Bool {
    if c.pred.name == Ty.equals { return equals(s, c) }
    if c.pred.name == oneOf { return oneOfRule(s, c) }
    if Classes.isClass(s.classes, c.pred.name) { return classRule(s, c) }
    bug("no rule for predicate '" + c.pred.name + "'", c.span)
}

-- `s ~ t`: retry the equation now that something may have moved.
--
-- Rewriting is what makes progress: a side that has become reducible, through
-- an instance or a given, is rewritten here. Two identical family applications
-- are equal by reflexivity, and a side that is *still* a stuck family means the
-- equation is not yet decidable. Only the givens and the instances rewrite it:
-- no wanted is a rule, so an equation is never proved by itself.
fun equals(s : Solver, c : PredCell) -> Bool {
    let left = Inert.rewrite(s.here.inert, c.pred.args[0])
    let right = Inert.rewrite(s.here.inert, c.pred.args[1])
    c.pred = Ty.pred(c.pred.name, [left, right])
    if Ty.sameType(left, right) { return True }
    if Ty.isFam(left) || Ty.isFam(right) { return False }
    Ty.unify(left, right, c.span, c.context, families(s))
    True
}

-- Returns `t` rewritten for discharging a predicate over it, by the givens in
-- scope, the equalities waiting in the queue (`waiting`) and the instances.
fun discharging(s : Solver, t : Ty.Type) -> Ty.Type = match s.wanteds {
    -- The givens are not optional here: a type that reached the predicate
    -- through a variable bound before a given could rewrite it is still the
    -- family application, and only the given says what it is.
    Some(w) -> Inert.rewrite(w, t)
    None -> Inert.rewrite(s.here.inert, t)
}

-- Returns the evidence for `p` from a fact the enclosing declarations already
-- assumed, the innermost first, or `None` if none of them grants it.
--
-- Both sides are rewritten before they are compared, since an assumption is
-- written down and a demand is discovered, and the two may name the same type by
-- different routes: `Ord (Item a)` is granted by `Ord (Index.Value a)` under
-- `Item a ~ Index.Value a`.
fun granted(s : Solver, p : Pred) -> Option Proof {
    let key = Ty.predKey(Ty.pred(p.name, [discharging(s, p.args[0])]))
    let assumptions = s.here.assumptions
    for var i = len(assumptions) - 1; i >= 0; i = i - 1 {
        let (name, a) = assumptions[i]
        let seen = Ty.pred(a.name, [discharging(s, a.args[0])])
        if let Some(path) = Classes.superPath(s.classes, seen, key, []) {
            return Some(ByGiven(name, path, a))
        }
    }
    None
}

-- `C t`: an assumption grants it, or an instance covers it.
--
-- A predicate whose argument is still headed by a variable defers -- a later
-- unification may yet decide which instance applies. One headed by anything
-- rigid is decided here and now, which is what keeps a missing instance a local
-- error naming the type that lacks one.
--
-- Discharging the predicate fills its hole, by the rule that discharged it
-- and with the types it was discharged at. A predicate reported as an error
-- leaves its hole empty, and nothing reads evidence once an error is reported,
-- with one exception: an error inside an inaccessible implication is muted
-- (`CAssume`), so the program is lowered, and a use there whose predicate has
-- no instance reaches an empty hole.
fun classRule(s : Solver, c : PredCell) -> Bool {
    let t = discharging(s, c.pred.args[0])
    match t {
        -- Absorbed; there is no value to find a method for.
        TBottom -> {
            c.hole.proof = Some(ByNothing(c.pred.name))
            return True
        }
        _ -> {}
    }
    let p = Ty.pred(c.pred.name, [t])
    -- Assumptions are consulted before the shape of the argument is, and that
    -- order matters: a given may be *about* a family application, as
    -- `[Container c, Show (Elem c)]` is, and `Elem c` over a skolem never
    -- reduces. Testing the head first would defer such a predicate for ever.
    if let Some(proof) = granted(s, p) {
        c.hole.proof = Some(proof)
        return True
    }
    let (h, _) = Ty.spine(t)
    match h {
        TVar(_) -> return False
        TFam(_, _, _) -> return False
        _ -> {}
    }
    -- An unsatisfiable predicate is reported and taken as discharged: nothing
    -- later can satisfy it, so deferring it would only report it again.
    if checkFieldVisibility(s, p, t, c) { return True }
    match Classes.selectInstance(s.classes, p) {
        None -> {
            if Classes.isGenerated(p.name) && noField(s, p, t, c) { return True }
            Ty.typeError("no instance for '" + Ty.showPred(p) + "'", c.span)
            True
        }
        Some((inst, mapping)) -> {
            let obligations = Classes.contextAt(inst, mapping)
            -- The instance's own context becomes this site's, over the types the
            -- match supplied: `Eq (Array a)` leaves `Eq a` behind. Each is a
            -- wanted of its own, whose hole the instance's evidence holds.
            let holes = Array.map(obligations, fun(_) = newHole())
            c.hole.proof = Some(ByInstance(inst, mapping, holes))
            for var i = 0; i < len(obligations); i = i + 1 {
                solve(s, cpredInto(obligations[i], holes[i], c.span, c.context))
            }
            True
        }
    }
}

-- Field evidence reveals representation just as a constructor pattern does.
-- Check where the evidence is requested, including a polymorphic accessor's
-- predicate when its caller instantiates it at an abstract record type.
-- Returns whether it reported an error.
fun checkFieldVisibility(s : Solver, p : Pred, receiver : Ty.Type,
                         c : PredCell) -> Bool {
    let label = match fieldLabel(p.name) {
        Some(l) -> l
        None -> return False
    }
    let (h, _) = Ty.spine(receiver)
    match h {
        TCon(con) -> match Map.get(s.decls.tycons, con.name) {
            Some(info) -> if len(info.variants) == 1 {
                let ctor = info.variants[0]
                if Decls.isRecord(ctor) && !Set.contains(s.visibleCons(c.span), ctor.name) {
                    return reported("cannot access field '" + label + "' of abstract type '"
                                    + Ty.show(receiver) + "': constructor '"
                                    + Ty.shortName(ctor.name) + "' is not in scope", c.span)
                }
            }
            None -> {}
        }
        _ -> {}
    }
    False
}

-- Reports a type error and returns `True`, for a check that returns whether
-- it reported one.
fun reported(message : String, where : Option Span) -> Bool {
    Ty.typeError(message, where)
    True
}

-- Why a generated field or projection class has no instance.
--
-- Ordinary instance resolution would say "no instance for `%HasField.cap Int`",
-- which names a class the programmer cannot see and did not write. The class is
-- an implementation of field access, so its failures have to read as field
-- errors. Returns whether it reported an error; `False` leaves the predicate
-- for the caller to report as a plain missing instance.
fun noField(s : Solver, p : Pred, receiver : Ty.Type, c : PredCell) -> Bool {
    let (h, _) = Ty.spine(receiver)
    -- Only an assignment's predicates carry "assign to"; any other context,
    -- such as a scheme's, is a read.
    let verb = if c.context == "assign to" { c.context } else { "read" }
    match fieldLabel(p.name) {
        Some(label) -> {
            match h {
                TCon(con) -> {
                    if Option.isSome(Classes.setterLabel(p.name))
                            && notVar(s, con.name, label, c) {
                        return True
                    }
                    match Decls.recordFields(s.decls, con.name) {
                        Some(names) -> if !Array.contains(names, label) {
                            return reported("type '" + Ty.show(receiver) + "' has no field '"
                                + label + "'; its fields are "
                                + String.join(Array.map(names, fun(n) = "'" + n + "'"),
                                              ", "), c.span)
                        }
                        None -> {}
                    }
                    match Decls.existentialFields(s.decls, con.name) {
                        Some(hidden) -> if Array.contains(hidden, label) {
                            return reported("cannot " + verb + " field '" + label
                                + "' of the existential type '"
                                + Ty.show(receiver) + "'; take it apart in a "
                                + "'match' arm instead", c.span)
                        }
                        None -> {}
                    }
                }
                _ -> {}
            }
            -- Every type that reaches here lacks the one record constructor
            -- that '.' needs. A read from a type with constructors of its own
            -- can take the value apart instead; an assignment has no
            -- alternative, since such a type is immutable.
            let fix = match h {
                TCon(con) -> match Map.get(s.decls.tycons, con.name) {
                    Some(info) -> if verb == "read" && len(info.variants) > 0 {
                        "; take it apart with 'match'"
                    } else { "" }
                    None -> ""
                }
                _ -> ""
            }
            return reported("cannot " + verb + " field '" + label + "': '"
                + Ty.show(receiver) + "' is not a record type with one "
                + "constructor" + fix, c.span)
        }
        None -> {}
    }
    let index = match Classes.generatedIndex(p.name) {
        Some(found) -> found
        None -> return False
    }
    let choices = match receiver {
        TTuple(elems) -> Some(elems)
        _ -> Decls.projectionTypes(s.decls, receiver)
    }
    match choices {
        None -> reported("cannot take '." + Int.toString(index) + "' of '"
                         + Ty.show(receiver) + "': '." + Int.toString(index)
                         + "' can only be taken of a tuple or of a type with one "
                         + "positional constructor", c.span)
        Some(elems) -> reported("projection index " + Int.toString(index)
                                + " is out of bounds for '" + Ty.show(receiver)
                                + "', which has " + Int.toString(len(elems))
                                + " element(s)", c.span)
    }
}

-- The field a generated class reads or writes.
fun fieldLabel(cls : String) -> Option String = match Classes.generatedLabel(cls) {
    Some(label) -> Some(label)
    None -> Classes.setterLabel(cls)
}

-- An assignment to a field the record has but did not declare `var`. Named with
-- its declaration, because that is where the fix goes, and the assignment may
-- be in another function -- or, for a polymorphic receiver, the error is
-- reported at the call that supplied the record type. Returns whether it
-- reported an error.
fun notVar(s : Solver, tycon : String, label : String, c : PredCell) -> Bool {
    match Decls.varFields(s.decls, tycon) {
        Some(vars) -> if Vec.contains(vars, label) { return False }
        None -> return False
    }
    match Decls.fieldSpan(s.decls, tycon, label) {
        Some(at) -> reported("cannot assign to field '" + label + "': it is not 'var' in '"
            + Ty.shortName(tycon) + "' (declared at " + at.file + ":"
            + showSpan(at) + "); declare it 'var " + label
            + "' to make it assignable", c.span)
        None -> False
    }
}

-- `OneOf t {...}`: `t` must be one of a closed set of built-in types.
--
-- A numeral's set holds types; an array literal's holds containers, and its
-- demand carries the literal's element as a third argument, so `t` must be one
-- of them applied to that element. See `memberType`.
--
-- A **singleton set is an equation** and is discharged as one, right here, at
-- the moment the constraint is reached. That is not an optimization: deferring
-- it would let a later unification bind `t` to something else first, and the
-- mismatch would then be reported against the literal rather than against
-- whatever disagreed with it.
fun oneOfRule(s : Solver, c : PredCell) -> Bool {
    let names = setNames(c.pred.args[1], c.span)
    if len(names) == 0 {
        bug("this numeric literal is not representable in any numeric type",
            c.span)
    }
    if len(names) == 1 {
        -- Same argument order as the equation `t ~ T` this stands for, so a
        -- mismatch reads as that equation's would.
        Ty.unify(Ty.prune(c.pred.args[0]), memberType(c.pred, names[0]), c.span,
                 c.context, families(s))
        return True
    }
    let t = discharging(s, c.pred.args[0])
    if isArrayLiteralDemand(c) {
        let (head, args) = Ty.spine(t)
        match head {
            TBottom -> return True
            -- Still open -- a use or defaulting will decide.
            TVar(_) -> return False
            TFam(_, _, _) -> return False
            TCon(con) -> if Array.contains(names, con.name) && len(args) == 1 {
                Ty.unify(args[0], c.pred.args[2], c.span, c.context, families(s))
                return True
            }
            _ -> {}
        }
    } else {
        match t {
            -- Absorbed; there is no value to represent.
            TBottom -> return True
            -- Still open -- improvement or defaulting will decide.
            TVar(_) -> return False
            TFam(_, _, _) -> return False
            TCon(con) -> if Array.contains(names, con.name) { return True }
            _ -> {}
        }
    }
    -- The span is always the literal's, so name it: "expected one of ..." alone
    -- reads as though something at this position asked for a numeric type, when
    -- in fact this position *is* the literal.
    let what = if isArrayLiteralDemand(c) {
        "an array literal"
    } else {
        "a numeric literal"
    }
    reported(what + " cannot have type '" + Ty.show(t) + "'; it must be "
             + "one of " + Ty.quoteLiteralSet(names), c.span)
}

-- The type a `OneOf` demand's member `name` stands for: the member itself for
-- a numeral, and the container applied to the literal's element for an array
-- literal.
fun memberType(p : Ty.Pred, name : String) -> Ty.Type =
    if Ty.isArrayLiteralSet(p.args[1]) {
        TApp(Ty.literalSetType(name), p.args[2], Ty.kstar())
    } else {
        Ty.literalSetType(name)
    }

-- Intersect numeric `OneOf` sets that constrain the same variable.
--
-- Two demands on one variable are one demand on the intersection, and an empty
-- intersection is an error rather than a deferral -- nothing later can widen a
-- closed set. Narrowing to a singleton is what lets the next round discharge it
-- as an equation.
--
-- Array literals' demands are left alone: every one has the same set, so there
-- is nothing to narrow, and each carries its own element, which merging would
-- drop.
fun improveNumeric(s : Solver) -> Unit {
    let merged = Map.new()
    let out = Vec.new(len(s.deferred))
    for c in s.deferred {
        if c.pred.name != oneOf || isArrayLiteralDemand(c) {
            Vec.push(out, c)
            continue
        }
        let key = Ty.typeKey(c.pred.args[0])
        match Map.get(merged, key) {
            None -> {
                Map.put(merged, key, c)
                Vec.push(out, c)
            }
            Some(first) -> {
                let names = intersect(setNames(first.pred.args[1], first.span),
                                      setNames(c.pred.args[1], c.span))
                if len(names) == 0 {
                    -- Dropped once reported: an empty set describes no type, and
                    -- nothing later could widen it.
                    Ty.typeError("no numeric type is both one of "
                                 + Ty.quoteLiteralSet(setNames(first.pred.args[1], first.span))
                                 + " and one of "
                                 + Ty.quoteLiteralSet(setNames(c.pred.args[1], c.span)),
                                 c.span)
                    continue
                }
                first.pred = Ty.pred(first.pred.name,
                                     [first.pred.args[0], TSet(names)])
            }
        }
    }
    s.deferred = out
}

fun setNames(t : Ty.Type, where : Option Span) -> Array String = match t {
    TSet(ns) -> ns
    _ -> bug("a OneOf demand's second argument is not a set", where)
}

fun intersect(a : Array String, b : Array String) -> Array String =
    Array.filter(a, Array.contains(b, _))

fun isArrayLiteralDemand(c : PredCell) -> Bool =
    c.pred.name == oneOf && Ty.isArrayLiteralSet(c.pred.args[1])

-- Resolve `OneOf`s that nothing will ever narrow, by picking a member.
--
-- Haskell's defaulting, for the same reason: the variable is ambiguous -- it
-- appears in no type being generalized, so no use site can pin it and no scheme
-- can carry it. The choice is the set's first member in `Ty.literalOrder`:
-- the head of the numeric tower for a numeral, `Array` for an array literal.
--
-- Only `OneOf` defaults. A stranded `HasField` is a genuine error: there is no
-- preferred record type to guess.
fun applyDefaults(s : Solver, stuck : Vec PredCell) -> Bool {
    var progress = False
    for c in stuck {
        if c.pred.name == oneOf && undecided(c) {
            let names = setNames(c.pred.args[1], c.span)
            var chosen = False
            for n in Ty.literalOrder() {
                if Array.contains(names, n) && !chosen {
                    Ty.unify(Ty.prune(c.pred.args[0]), memberType(c.pred, n), c.span,
                             c.context, families(s))
                    chosen = True
                    progress = True
                }
            }
        }
    }
    progress
}

-- Default the container of every array literal a top-level binding has left
-- open, once that binding's definition is solved and before anything uses it.
--
-- Such a binding is one the value restriction keeps monomorphic, `let table =
-- [...]`, so no generalization decides its literal, and only the end of the
-- module would otherwise. Until then its demand would be carried through every
-- later top-level binding, together with every family equation over its
-- container that a use of the table adds -- `Index.Value t ~ a` for each
-- `table[i]` -- and every `settle` in those bindings, one per local `let`,
-- retries them all. That is quadratic in the module, and on the compiler's own
-- source it does not finish. Deciding here makes a top-level binding's
-- container a fact about its own definition: the same for a use later in the
-- module as for one in a module that imports it, which is checked afterwards
-- and could never decide it.
fun decideTopLevelLiterals(s : Solver) -> Unit {
    let open = Vec.filter(s.deferred, fun(c) = isArrayLiteralDemand(c) && undecided(c))
    if applyDefaults(s, open) { settle(s) }
}

-- Whether a `OneOf` demand's type is still open, which is when defaulting may
-- choose it. One an earlier default in the same round has decided is left to
-- `oneOfRule`, which says whether the choice fits it.
fun undecided(c : PredCell) -> Bool {
    let t = Ty.prune(c.pred.args[0])
    let (head, _) = Ty.spine(t)
    match (if isArrayLiteralDemand(c) { head } else { t }) {
        TVar(_) -> True
        _ -> False
    }
}

-- Refuses every predicate of the residual that would float out of the
-- implication whose skolems are `skolems` but mentions one of them, reporting
-- each where it arose, and removes it from the queue.
fun confine(s : Solver, skolems : Vec ConCell) -> Unit {
    -- Such a predicate is over a variable born outside, so the split would
    -- hand it to the enclosing scope. There the skolem stands for nothing and
    -- the givens that might have decided it are gone. Deciding it there can
    -- only bind the outer variable to a type built from the skolem, which is
    -- an escape. So the only place to judge it is here, and here it is stuck.
    if len(skolems) == 0 { return {} }
    let own = Set.new()
    for k in skolems { Set.add(own, k.uid) }
    let outer = rank(s) - 1
    let keep = Vec.new(len(s.deferred))
    for c in s.deferred {
        if Ty.predLevel(c.pred) <= outer {
            match ownSkolem(c.pred, own) {
                Some(k) -> {
                    trapped(c, k)
                    continue
                }
                None -> {}
            }
        }
        Vec.push(keep, c)
    }
    s.deferred = keep
}

-- The first skolem of `pred`'s arguments whose `uid` is in `own`.
fun ownSkolem(pred : Pred, own : Set.Set Int) -> Option ConCell {
    for k in Ty.skolemsOf(pred.args) {
        if Set.contains(own, k.uid) { return Some(k) }
    }
    None
}

-- Reports a predicate that mentions the skolem `k` and a type from outside
-- `k`'s scope. An equality is an escape, and is reported in the words
-- `Ty.unify` uses for one.
fun trapped(c : PredCell, k : ConCell) -> Unit {
    let opener = Ty.openedBy(k)
    if c.pred.name == Ty.equals {
        return match opener {
            Some(con) -> Ty.typeError("the type '" + k.name + "' hidden by '"
                + Ty.shortName(con) + "' cannot leave the 'match' arm or "
                + "function that opened it", c.span)
            None -> Ty.typeError("the type variable '" + k.name + "' from a "
                + "signature cannot be equal to a type from outside its "
                + "function", c.span)
        }
    }
    let scope = match opener {
        Some(con) -> "the type '" + k.name + "' hidden by '" + Ty.shortName(con) + "'"
        None -> "the type variable '" + k.name + "' from a signature"
    }
    Ty.typeError("cannot determine a type satisfying '" + Ty.showPred(c.pred)
                 + "' in the scope of " + scope + "; add a type annotation", c.span)
}

-- Deferred predicates general enough to be quantified at `level`.
--
-- The test is the one generalization applies to type variables: a predicate tied
-- to a variable created deeper than the binder travels in the scheme; one tied
-- to an outer variable stays behind for an enclosing binding to settle. The
-- caller has already refused one that also mentions the binder's skolems
-- (`confine`).
fun retained(s : Solver, level : Int) -> Vec PredCell {
    promoteFloating(s, level)
    let keep = Vec.new(len(s.deferred))
    let out = Vec.new(len(s.deferred))
    let seen = Map.new()
    for c in s.deferred {
        if Ty.predLevel(c.pred) <= level {
            Vec.push(keep, c)
        } else {
            -- Two demands for the same field of the same type are one
            -- obligation; the context should not repeat itself.
            -- The one dropped takes the evidence of the one kept.
            let key = Ty.predKey(c.pred)
            match Map.get(seen, key) {
                Some(kept) -> { c.hole.proof = Some(Same(kept)) }
                None -> {
                    Map.put(seen, key, c.hole)
                    Vec.push(out, c)
                }
            }
        }
    }
    s.deferred = keep
    out
}

-- Lowers to `level` every variable of a deferred predicate tied to `level`
-- or an outer one, until no predicate changes.
fun promoteFloating(s : Solver, level : Int) -> Unit {
    -- A predicate tied to an outer variable floats to the enclosing scope, and
    -- its other variables go with it. Solving it there may bind them, as
    -- `F r ~ Option y` binds `y` once `r` is known, so none of them may stay
    -- at this rank to be generalized: the scheme would quantify a variable
    -- that the floated predicate binds later, for every instantiation at
    -- once. Lowering one can tie another predicate to `level`, so repeat
    -- until nothing moves.
    var changed = True
    while changed {
        changed = False
        for c in s.deferred {
            if Ty.predLevel(c.pred) <= level {
                for v in Ty.varsOf(c.pred.args) {
                    if v.level > level {
                        v.level = level
                        changed = True
                    }
                }
            }
        }
    }
}

-- Report a predicate that can be neither discharged nor quantified.
fun rejectStranded(s : Solver, stranded : Vec PredCell) -> Unit {
    if len(stranded) == 0 { return {} }
    -- A predicate left open after an error is most often open because of it:
    -- the error left a variable unbound that would have decided it.
    if Diag.hasErrors() { return {} }
    -- An infinite type first: what else is stranded is most often stranded
    -- because of it.
    var c = stranded[0]
    for p in stranded {
        if isOccursEquation(p) && !isOccursEquation(c) { c = p }
    }
    match occursSide(c) {
        -- In the words `Ty.unify` uses for the same cycle.
        Some((v, other)) -> {
            let n = Ty.namer("")
            return Ty.typeError("cannot construct the infinite type '"
                                + Ty.showAt(v, n, 0) + " = " + Ty.showAt(other, n, 0)
                                + "'", c.span)
        }
        None -> {}
    }
    if c.pred.name == Ty.equals {
        -- An equality that reaches here is not wrong, it is undecidable, and the
        -- blame goes on the family rather than on what it was compared with:
        -- what is missing is the knowledge of which instance defines it. A
        -- scheme would have carried it happily, so getting this far means no
        -- type being generalized mentions the family's argument.
        let left = c.pred.args[0]
        let right = c.pred.args[1]
        let leftIsFam = familyLike(left)
        let fam = if leftIsFam { left } else { right }
        let other = if leftIsFam { right } else { left }
        -- A generated field family is machinery, not something a context can
        -- state: a reader wrote `r.n` and cannot write `Field.n r ~ Int`. So it
        -- is reported as the stranded `HasField` predicate below is, naming
        -- what was written.
        let owner = match fam {
            TFam(name, _, _) -> Classes.fieldFamilyOwner(name)
            _ -> "?"
        }
        match fieldLabel(owner) {
            Some(label) -> return unknownReceiver("field '" + label + "' is used",
                                                  c.span)
            None -> {}
        }
        match Classes.generatedIndex(owner) {
            Some(index) -> return unknownReceiver("'." + Int.toString(index)
                                                  + "' is taken", c.span)
            None -> {}
        }
        let where = if c.context == "" { "" } else { " in " + c.context }
        -- Name the remedy. It is not "add a type annotation": an equality is
        -- something a context can state, and stating it is what fixes this.
        let equality = Ty.show(fam) + " ~ " + Ty.show(other)
        return Ty.typeError("cannot tell whether '" + Ty.show(fam) + "' is '"
                            + Ty.show(other) + "'" + where + "; add '" + equality
                            + "' to the context", c.span)
    }
    match fieldLabel(c.pred.name) {
        Some(label) -> return unknownReceiver("field '" + label + "' is used", c.span)
        None -> {}
    }
    match Classes.generatedIndex(c.pred.name) {
        Some(index) -> return unknownReceiver("'." + Int.toString(index) + "' is taken",
                                              c.span)
        None -> {}
    }
    let names = Ty.namer("")
    let shown = Ty.showPredWith(c.pred, names)
    let vars = Ty.varsOf(c.pred.args)
    let unknown = if len(vars) == 0 { None } else { Map.get(names.names, vars[0].id) }
    match unknown {
        Some(v) -> Ty.typeError("cannot determine what type '" + v + "' is in '"
                                + shown + "'; add a type annotation", c.span)
        None -> Ty.typeError("cannot determine a type satisfying '" + shown
                             + "'; add a type annotation", c.span)
    }
}

-- Returns whether `c` is an equation whose variable occurs in its other side,
-- under a family (`occursSide`).
fun isOccursEquation(c : PredCell) -> Bool = Option.isSome(occursSide(c))

-- Returns the variable side of the equation `c` and the other side, if the
-- variable occurs in the other side. `Ty.unify` defers such an equation only
-- while a family stands between the two, so the occurrence is under one.
fun occursSide(c : PredCell) -> Option (Ty.Type, Ty.Type) {
    if c.pred.name != Ty.equals { return None }
    for (v, other) in [(c.pred.args[0], c.pred.args[1]), (c.pred.args[1], c.pred.args[0])] {
        match Ty.prune(v) {
            TVar(cell) -> if Option.isNone(Ty.breakerFor(cell)) && Ty.occursIn(v, other) {
                return Some((Ty.prune(v), other))
            }
            _ -> {}
        }
    }
    None
}

-- Returns whether `t` is a family application, or a cycle breaker standing for
-- one.
fun familyLike(t : Ty.Type) -> Bool = match Ty.prune(t) {
    TFam(_, _, _) -> True
    TVar(cell) -> Option.isSome(Ty.breakerFor(cell))
    _ -> False
}

fun unknownReceiver(what : String, where : Option Span) -> Unit =
    Ty.typeError("cannot determine the type of the value whose " + what
                 + " here; add a type annotation", where)

-- -- context splitting -------------------------------------------------------------

-- The variables `types` pin, following predicates to a fixed point.
--
-- Membership is transitive because a `HasField` is a *function* of its receiver:
-- fix the record and the field type follows. So a variable that appears nowhere
-- in the type is still determined, as long as some chain of predicates connects
-- it to one that is. That functional reading is also why the usual ambiguity
-- objection to a variable appearing only in the context does not apply here.
fun reach[Iterator c, Item c ~ PredCell](preds : c, types : Array Ty.Type) -> Set.Set Int {
    let ids = Set.new()
    for v in Ty.varsOf(types) { Set.add(ids, v.id) }
    var changed = True
    while changed {
        changed = False
        for c in preds {
            let reachable = Ty.varsOf(c.pred.args)
            var touches = False
            for v in reachable {
                if Set.contains(ids, v.id) { touches = True }
            }
            if touches {
                for v in reachable {
                    if !Set.contains(ids, v.id) {
                        Set.add(ids, v.id)
                        changed = True
                    }
                }
            }
        }
    }
    ids
}

-- The retained predicates that constrain one type.
fun constrain(preds : Vec PredCell, t : Ty.Type) -> Vec Pred {
    let ids = reach(preds, [t])
    let out = Vec.new(len(preds))
    for c in preds {
        if touches(c, ids) { Vec.push(out, c.pred) }
    }
    out
}

-- The retained predicates no scheme in the group will carry.
fun unattributed(preds : Vec PredCell, types : Array Ty.Type) -> Vec PredCell {
    let ids = reach(preds, types)
    let out = Vec.new(len(preds))
    for c in preds {
        if !touches(c, ids) { Vec.push(out, c) }
    }
    out
}

fun touches(c : PredCell, ids : Set.Set Int) -> Bool {
    for v in Ty.varsOf(c.pred.args) {
        if Set.contains(ids, v.id) { return True }
    }
    False
}

-- Reports a check that only a compiler bug can fail.
fun bug(message : String, where : Option Span) -> a = match where {
    None -> Diag.fail(Diag.whole("internal error", message), "")
    Some(s) -> Diag.fail(Diag.at("internal error", message, s), s.file)
}

fun discard(x : a) -> Unit = {}
