export (
    Ids(..), Bound(..), CEnv(..), newCEnv, defineC, lookupC, globalsOf,
    Checker(..), newChecker, checkProgram, compatible, famsOf,
)

-- The Core typechecker: what makes evidence checked rather than trusted.
--
-- Elaboration decides which dictionary proves each predicate, and Core records
-- that decision as a term. Without this module the decision would be believed
-- for the same reason as before it was written down, which is that nobody
-- looked -- so this runs on every compile and not behind a flag.
--
-- ## It is a checker, not an inferencer
--
-- Every binder in Core is annotated and every node carries its type, so there
-- is nothing to guess: no constraint, no solver, no ranks, no generalization.
-- Each rule computes what a node's type *must* be from its parts and compares
-- that against what the node claims.
--
-- Two deliberate slacknesses, both of them things the surface language decided:
-- **bottom absorbs**, so a branch that returns is compatible with one that does
-- not; and **a free variable matches anything once**, which keeps the checker
-- from rejecting a term for being *more* general than expected.
--
-- ## What it actually catches
--
-- The point is the dictionaries, and there the checks are exact: a dictionary
-- argument must have the class and head its parameter declares; a method
-- projection must come from a dictionary of the class that declares the method;
-- a superclass projection must name a real superclass; a type application must
-- have one argument per binder. Ordinary term structure is checked alongside,
-- because a checker that only checked dictionaries would be one a mis-lowering
-- could walk straight past.
--
-- ## What it derives rather than reads
--
-- A jump's *tail position* is derived. The checker carries a second environment
-- of join names beside the term environment, and passes it down only into tail
-- positions. Every other recursion gets an empty one. So there is no
-- tail-position predicate to write and none to get wrong: a jump in an argument,
-- in a scrutinee, in a `let`'s value or inside a lambda simply does not find its
-- name.
--
-- An alternative records no binding types, on purpose. The checker works out
-- what a pattern binds from the scrutinee's type and the constructor's
-- declaration, so a pattern that does not fit its scrutinee is a rejected term.
-- That is a check the elaborator never had, because in the surface language the
-- same fact was established by unification and then forgotten.

import System.Parallel as Parallel
import Data.Set as Set
import Turkey.Ast (..)
import Turkey.Ast as Ast
import Turkey.Binders as Binders
import Turkey.Classes as Classes
import Turkey.Classes (ClassTable(..), ClassInfo(..), MethodInfo(..), Slot(..))
import Turkey.Constraints as C
import Turkey.Constraints (Env(..))
import Turkey.Core (..)
import Turkey.Core as Cr
import Turkey.Decls as Decls
import Turkey.Decls (DeclTable(..), ConInfo(..), TyconInfo(..))
import Turkey.Diag as Diag
import Turkey.Prims as Prims
import Turkey.PrimTypes as PrimTypes
import Turkey.Source (Span(..))
import Turkey.Typed as Typed
import Turkey.Types as Ty
import Turkey.Types (Kind(..), VarCell(..), ConCell(..), Scheme(..), Pred(..),
                     TVar, TCon, TApp, TFam, TFun, TTuple, TBottom)


-- -- the environment ---------------------------------------------------------------

-- How often a program may bind one id. In either case no binder is bound
-- inside the scope of another binder with its id, so a reference with an id
-- means the one binder with that id in scope.
type Ids
    -- Each id is bound at most once in the program, which `checkProgram`
    -- checks.
    = UniqueIds
    -- An id may be bound more than once: `Turkey.Layout` copies a binding, or
    -- a local's value, once per layout, and the copies keep the binders'
    -- ids. Each copy is a separate binding or a separate scope, so the rule
    -- above still holds, and the backend, which keeps a scope per binding,
    -- relies on it.
    | ScopedIds

-- What a binder in scope stands for.
type Bound = Bound {
    name    : String,
    id      : Int,
    -- The type variables it abstracts over.
    binders : Vec VarCell,
    ty      : Ty.Type,
}

-- Where the environment files a binder.
type BinderKey = ById(Int) | BySpelling(String)

instance Eq BinderKey {
    fun eq(a, b) = match (a, b) {
        (ById(x), ById(y)) -> x == y
        (BySpelling(x), BySpelling(y)) -> x == y
        _ -> False
    }
}

instance Hash BinderKey {
    fun hashInto(k, h) = match k {
        ById(id) -> hashInto(id, h)
        BySpelling(name) -> hashInto(name, h)
    }
}

-- The binders in scope, each with what it abstracts over.
--
-- One shape for all three binders -- top-level, `let`, `letrec` -- because a
-- type application has to find its binders the same way whichever bound the
-- name, and because the only alternative is a second agreement to keep.
--
-- One map for every scope, with an undo log, rather than a map per scope
-- chained to its parent: a lookup is then one hash however deeply it is
-- nested, and entering a scope allocates nothing. The checker's scopes nest
-- exactly as its recursion does, so a scope is left by rolling the log back to
-- the mark `enter` returned, and every rule that enters one leaves it before it
-- checks anything outside it.
--
-- A binder a scope introduced is rolled back to `None` rather than deleted,
-- which is why an entry is optional: overwriting never leaves a tombstone, and
-- a table that only grows by the distinct binders of the program is the
-- smaller cost.
type CEnv = CEnv {
    ids     : Ids,
    inScope : Map BinderKey (Option Bound),
    -- What `inScope` does not say, read and never written: the top-level
    -- binders, which every binding's check shares (`layered`).
    outer   : Map BinderKey (Option Bound),
    -- Each definition made inside a scope, with what its key meant before.
    undo    : Vec (BinderKey, Option Bound),
}

fun newCEnv(ids : Ids) -> CEnv =
    CEnv { ids = ids, inScope = Map.new(), outer = Map.new(), undo = [] }

-- A scope over `e`, which it reads and never writes: so checks over one `e`
-- can run at once. `e` must be a flat environment, one with nothing outer.
fun layered(e : CEnv) -> CEnv =
    CEnv { ids = e.ids, inScope = Map.new(), outer = e.inScope, undo = [] }

-- The key a reference is looked up by. A binder with no id -- a dictionary,
-- an instance's or a default method's binding, an existential's evidence, or
-- a binder a pass after the lowering made -- is found by its spelling.
-- Spellings of those binders are not unique: every instance method's
-- dictionary parameter is spelled alike, for one.
fun keyOf(name : String, id : Int) -> BinderKey =
    if id == noId { BySpelling(name) } else { ById(id) }

-- Brings a binder into scope, under its spelling, and under its id if it has
-- one. A reference with no id may mean a binder with one: the lowering and
-- the specializer write some references to top-level bindings with no id.
fun defineC(e : CEnv, name : String, id : Int, binders : Vec VarCell,
            ty : Ty.Type) -> Unit {
    let b = Some(Bound { name = name, id = id, binders = binders, ty = ty })
    file(e, BySpelling(name), b)
    if id != noId { file(e, ById(id), b) }
}

fun file(e : CEnv, key : BinderKey, b : Option Bound) -> Unit {
    Vec.push(e.undo, (key, lookupKey(e, key)))
    Map.put(e.inScope, key, b)
}

fun lookupC(e : CEnv, name : String, id : Int) -> Option Bound =
    lookupKey(e, keyOf(name, id))

fun lookupKey(e : CEnv, key : BinderKey) -> Option Bound =
    match Map.get(e.inScope, key) {
        Some(found) -> found
        None -> match Map.get(e.outer, key) {
            Some(found) -> found
            None -> None
        }
    }

-- The mark a scope is left by.
fun enter(e : CEnv) -> Int = len(e.undo)

fun leave(e : CEnv, mark : Int) -> Unit {
    while len(e.undo) > mark {
        match Vec.pop(e.undo) {
            Some((key, before)) -> Map.put(e.inScope, key, before)
            None -> ()
        }
    }
}

-- The top-level bindings, class methods and primitives a solver environment
-- implies, by internal name and with the id `table` gave each.
--
-- Builtins reach Core the way they reach everything else -- through the type
-- environment -- so the checker is seeded from it rather than being told about
-- the primitives a second time.
fun globalsOf(env : Env, table : Binders.Table) -> Vec Bound {
    let out = []
    for (name, binding) in Map.entries(env.names) {
        let id = Option.unwrapOr(Binders.named(table, name), noId)
        Vec.push(out, Bound {
            name = name, id = id, binders = binding.scheme.quantified,
            ty = binding.scheme.body,
        })
    }
    out
}

-- -- the checker --------------------------------------------------------------------

-- A join point in scope: what a jump to it must supply and what it answers.
type JoinPoint = JoinPoint {
    name   : String,
    id     : Int,
    params : Array CParam,
    ty     : Ty.Type,
}

-- The join points a jump may name, filed as `CEnv` files binders. Copied when
-- extended: a join scope is a handful of names deep at most, and a map that is
-- never written after it is built cannot leak a join out of the branch that
-- bound it.
type Joins = Map BinderKey JoinPoint

type Checker = Checker {
    decls         : DeclTable,
    classes       : ClassTable,
    -- The join points a jump here may name. Set by `check`, which gives every
    -- rule an empty one unless the rule asked otherwise -- so tail position is
    -- what a rule opts *into*, and forgetting is safe.
    var joins     : Joins,
    -- The empty scope, shared by every node out of tail position, which is
    -- nearly every node. Never written: a scope is extended by copying.
    noJoins       : Joins,
    -- `equations` and the instance table as a reducer, built when `equations`
    -- changes rather than on every reduction.
    var fams      : Ty.Families,
    -- The equalities the binding being checked states. Consulted before the
    -- instance table, exactly as the solver consults its assumptions first and
    -- for the same reason: a family over a rigid variable will never reduce
    -- through an instance, and the signature that promised it is the only thing
    -- that can say what it is.
    var equations : Vec (Ty.Type, Ty.Type),
    -- Every binder with an id that the top-level binding being checked binds
    -- below its top, with its spelling. Collected only when ids are unique,
    -- for `checkUnique`.
    var bound     : Vec (Int, String),
    -- The uids of the rigid constants the arms around the term being checked
    -- opened. Kept only when ids are unique, for `openArm`.
    opened        : Set.Set Int,
}

fun newChecker(decls : DeclTable, classes : ClassTable) -> Checker = Checker {
    decls = decls, classes = classes, joins = Map.new(), noJoins = Map.new(),
    fams = famsOf(classes, []), equations = [], bound = [], opened = Set.new(),
}

-- Checks `prog` against `globals` (see `globalsOf`), and raises an internal
-- error at the first term that is ill-typed or refers to a binder not in
-- scope. With `UniqueIds`, also raises one if any binder id is bound twice.
fun checkProgram(decls : DeclTable, classes : ClassTable, prog : CProgram,
                 globals : Vec Bound, ids : Ids) -> Unit {
    let all = Vec.append(prog.dicts, prog.binds)
    -- Each id's first binder: its spelling, and the top-level binding it is in.
    let first : Map Int (String, String) = Map.new()
    -- The top-level ids are claimed before any binding is checked, because a
    -- second top-level binding with an id replaces the first in `top`, and a
    -- reference to the first would then fail on whichever worker reached it.
    match ids {
        UniqueIds -> for b in all {
            if b.id != noId { claim(first, b.id, b.name, b) }
        }
        ScopedIds -> {}
    }
    let top = newCEnv(ids)
    for g in globals { defineC(top, g.name, g.id, g.binders, g.ty) }
    -- Every top-level name is in scope for every other: the dictionaries refer
    -- to each other, and the bindings were ordered by dependency but may still
    -- be mutually recursive within a component.
    for b in all { defineC(top, b.name, b.id, b.binders, b.ty) }
    -- Each binding against the top-level names alone, so they are checked on
    -- as many workers as there are, a checker to each worker's chunk.
    let bound = Parallel.mapWith(all, fun() = newChecker(decls, classes),
                                 fun(ck, b) = checkTop(ck, b, layered(top)))
    match ids {
        UniqueIds -> checkUnique(first, all, bound)
        ScopedIds -> {}
    }
}

-- Checks one top-level binding, and returns the binders below its top that
-- `checkUnique` needs.
fun checkTop(ck : Checker, b : CBind, env : CEnv) -> Vec (Int, String) {
    ck.bound = []
    checkBind(ck, b, env)
    ck.bound
}

-- Raises an internal error if any binder id below the top of a binding is
-- bound twice in the program, or is the id of a top-level binding: `first`
-- holds the top-level ids already. `bound[i]` is what `checkTop` returned
-- for `all[i]`. Walked in program order, so the error is the same whatever
-- the schedule of the checks.
fun checkUnique(first : Map Int (String, String), all : Vec CBind,
                bound : Array (Vec (Int, String))) -> Unit {
    for var i = 0; i < len(all); i = i + 1 {
        for (id, name) in bound[i] { claim(first, id, name, all[i]) }
    }
}

fun claim(first : Map Int (String, String), id : Int, name : String,
          within : CBind) -> Unit = match Map.get(first, id) {
    Some((had, hadWithin)) ->
        fail("the binder '" + had + "' in '" + hadWithin
             + "' is bound again as '" + name + "' in '" + within.name + "'",
             within.span)
    None -> Map.put(first, id, (name, within.name))
}

-- Brings a binder the term binds into scope, and notes it for `checkUnique`.
-- Raises an internal error if a binder with its id is in scope already, which
-- protects SsaLower's rule that a reference with an id means the one binder
-- of that id its scoped environment holds.
fun bind(ck : Checker, env : CEnv, name : String, id : Int, binders : Vec VarCell,
         ty : Ty.Type, where : Option Span) -> Unit {
    if id != noId {
        if let Some(outer) = lookupKey(env, ById(id)) {
            fail("'" + name + "' is bound inside the scope of '" + outer.name
                 + "', which has the same id", where)
        }
    }
    noteBound(ck, env, name, id)
    defineC(env, name, id, binders, ty)
}

fun noteBound(ck : Checker, env : CEnv, name : String, id : Int) -> Unit = match env.ids {
    UniqueIds -> if id != noId { Vec.push(ck.bound, (id, name)) }
    ScopedIds -> {}
}

-- The binder a reference names, which must be in scope.
--
-- A reference with an id is found by the id alone. Its spelling must be its
-- binder's, because a dump prints the two by their spellings and ids and
-- would otherwise print them as two binders. Whether the spelling would find
-- some other binder is not checked: no pass after the lowering finds a
-- binder with an id by its spelling, so a copy may sit under a binder it
-- shares a spelling with.
fun resolve(env : CEnv, name : String, id : Int, where : Option Span) -> Bound {
    let found = match lookupC(env, name, id) {
        Some(found) -> found
        None -> fail("'" + name + "' is not in scope", where)
    }
    if found.name != name {
        fail("'" + name + "' has the id of the binder '" + found.name + "'", where)
    }
    -- Protects SsaLower's rule that a reference with no id is to evidence or
    -- to a top-level binding: it looks such a reference up among the
    -- evidence, never among the locals with ids. Checked only on the program
    -- the backend is handed, since the lowering and the specializer write
    -- such references to locals, and `Turkey.Opt` gives them their binders'
    -- ids.
    match env.ids {
        ScopedIds -> if id == noId && found.id != noId
                && Option.isSome(local(env, BySpelling(name))) {
            fail("'" + name + "' has no id, but refers to a local binder that has one",
                 where)
        }
        UniqueIds -> {}
    }
    found
}

-- The binder a scope inside the binding being checked has filed under
-- `key`, if any. A top-level binder is in `outer` and is not one.
fun local(e : CEnv, key : BinderKey) -> Option Bound = match Map.get(e.inScope, key) {
    Some(found) -> found
    None -> None
}

fun checkBind(ck : Checker, b : CBind, env : CEnv) -> Unit {
    let want = if b.mutable && isRef(b.ty) { refElem(b.ty) } else { b.ty }
    let saved = ck.equations
    let savedFams = ck.fams
    ck.equations = Vec.append(saved, b.equations)
    ck.fams = famsOf(ck.classes, ck.equations)
    var got = check(ck, b.value, env, None)
    if b.mutable && isRef(b.ty) {
        got = if isRef(got) { refElem(got) } else { got }
    }
    -- Compared *under* the binding's own equations, which is the only place they
    -- hold. Checking answers a reduced type, so a body checked with
    -- `Elem a ~ Int` in scope hands back `Int` -- and comparing that against an
    -- unreduced `Elem a` outside the scope asks the two sides to agree on a
    -- rewrite only one of them was allowed to make.
    if !agrees(ck, want, got) {
        mismatch(ck, want, got, b.span, "the binding '" + b.name + "'")
    }
    ck.equations = saved
    ck.fams = savedFams
}

-- -- expressions --------------------------------------------------------------------

-- The type this node must have, compared against the one it claims.
--
-- `joins` is the join scope this subterm is in, and it defaults to *empty*: a
-- rule that descends without saying anything descends out of tail position,
-- which is the common case and the safe one. The rules with tail positions pass
-- their own scope down explicitly.
fun check(ck : Checker, e : Core, env : CEnv,
          joins : Option Joins) -> Ty.Type {
    let outer = ck.joins
    ck.joins = match joins {
        Some(j) -> j
        None -> ck.noJoins
    }
    let got = rule(ck, e, env)
    ck.joins = outer
    if !agrees(ck, e.ty, got) { mismatch(ck, e.ty, got, e.span, describe(e)) }
    -- The *derived* type, not the claimed one. They agree or `mismatch` has
    -- already objected -- but "agree" is deliberately slack about variables, so
    -- a node claiming a bare variable would otherwise hand its parent a variable
    -- to reason from, and a parent that cannot tell what it is looking at checks
    -- nothing. Deriving is the whole method.
    --
    -- Reduced, too, and for the same reason: a parameter declared
    -- `Cursor (Array a)` is an `ArrayCursor`, and a parent asking it for a field
    -- has to be looking at the type rather than at the family that names it.
    Ty.prune(reduce(ck, got))
}

-- The join scope a named subterm inherits. The IR decides, so this rule and join
-- discovery are reading one statement of the discipline rather than two.
-- Anything not named there gets nothing, which is why a rule that simply forgets
-- to ask is safe: forgetting rejects jumps, it does not admit them.
fun tail(ck : Checker, e : Core, field : String) -> Option Joins =
    if Array.contains(tailFieldNames(e.kind), field) { Some(ck.joins) } else { None }

fun rule(ck : Checker, e : Core, env : CEnv) -> Ty.Type = match e.kind {
    -- Trivial forms: they are their own evidence.
    CLit(_) -> e.ty
    CUnit -> e.ty
    CPrim(_) -> e.ty
    CCon(name) -> checkCon(ck, e, name)
    CVar(name, id) -> checkVar(ck, e, name, id, env)
    CTuple(elems) -> TTuple(Array.map(elems, check(ck, _, env, None)))
    CArray(elems) -> {
        if len(elems) == 0 { return e.ty }
        let first = check(ck, elems[0], env, None)
        for var i = 1; i < len(elems); i = i + 1 {
            expect(ck, first, check(ck, elems[i], env, None), e.span,
                   "element " + Int.toString(i + 1) + " of the array")
        }
        Ty.rawArrayOf(first)
    }
    CTyApp(fn, args) -> checkTyApp(ck, e, fn, args, env)
    CSlot(target, index) -> checkSlot(ck, e, target, index, env)
    CProject(target, index) -> checkProject(ck, e, target, index, env)
    CDict(cls, slots) -> checkDict(ck, e, cls, slots, env)
    CLam(params, body, _) -> {
        let mark = enter(env)
        for p in params { bind(ck, env, p.name, p.id, [], p.ty, e.span) }
        let got = TFun(Array.map(params, _.ty), check(ck, body, env, None))
        leave(env, mark)
        got
    }
    CApp(fn, args) -> checkApp(ck, e, fn, args, env)
    CTyLam(_, body) -> check(ck, body, env, None)
    CLet(name, id, bound, value, body, binders) -> {
        let v = check(ck, value, env, None)
        if !agrees(ck, bound, v) {
            mismatch(ck, bound, v, e.span, "the binding '" + name + "'")
        }
        let mark = enter(env)
        bind(ck, env, name, id, binders, bound, e.span)
        let got = check(ck, body, env, tail(ck, e, "body"))
        leave(env, mark)
        got
    }
    CLetRec(binds, body) -> {
        let mark = enter(env)
        for b in binds { bind(ck, env, b.name, b.id, b.binders, b.ty, e.span) }
        for b in binds { checkBind(ck, b, env) }
        let got = check(ck, body, env, tail(ck, e, "body"))
        leave(env, mark)
        got
    }
    CRef(value) -> refOf(check(ck, value, env, None))
    CDeref(target) -> {
        let t = check(ck, target, env, None)
        if !isRef(t) {
            fail(Ty.show(t) + " is not a reference cell", e.span)
        }
        refElem(t)
    }
    CAssign(target, value) -> {
        let v = check(ck, value, env, None)
        let t = check(ck, target, env, None)
        let want = if isRef(t) { refElem(t) } else { t }
        expect(ck, want, v, e.span, "the assigned value")
        Ty.tUnit()
    }
    CIndex(target, index) -> {
        let t = Ty.prune(check(ck, target, env, None))
        expect(ck, Ty.tInt(), check(ck, index, env, None), e.span, "an index")
        let (h, _) = Ty.spine(t)
        match h {
            TVar(_) -> e.ty
            TBottom -> e.ty
            _ -> fail(Ty.show(t) + " is not indexable", e.span)
        }
    }
    CIf(cond, then, otherwise) -> {
        expect(ck, Ty.tBool(), check(ck, cond, env, None), e.span, "a condition")
        let t = check(ck, then, env, tail(ck, e, "then"))
        match otherwise {
            None -> e.ty
            Some(o) -> joinTypes(t, check(ck, o, env, tail(ck, e, "otherwise")))
        }
    }
    CMatch(scrutinee, alts) -> {
        let joins = tail(ck, e, "alts")
        let s = check(ck, scrutinee, env, None)
        var result : Option Ty.Type = None
        for alt in alts {
            let mark = enter(env)
            refuseNestedEvidence(env, alt.alt, e.span)
            for (name, id, ty) in pattern(ck, alt.alt, s, e.span) {
                bind(ck, env, name, id, [], ty, e.span)
            }
            let opened = openArm(ck, env, alt.alt, e.span)
            let got = check(ck, alt.body, env, joins)
            for uid in opened { let _ = Set.remove(ck.opened, uid) }
            leave(env, mark)
            refuseEscape(alt.alt, got, e.span)
            result = match result {
                None -> Some(got)
                Some(had) -> Some(joinTypes(had, got))
            }
        }
        match result {
            None -> e.ty
            Some(t) -> t
        }
    }
    CJoin(name, id, params, body, rest, recursive) ->
        checkJoin(ck, e, name, id, params, body, rest, recursive, env)
    CJump(name, id, args) -> checkJump(ck, e, name, id, args, env)
}

-- A constructor as Core applies it: one dictionary per predicate of an
-- existential's context, then its fields.
fun constructorScheme(ck : Checker, info : ConInfo) -> Scheme {
    if len(info.scheme.preds) == 0 { return info.scheme }
    match info.scheme.body {
        TFun(params, ret) -> Scheme {
            quantified = info.scheme.quantified,
            body = TFun(Array.append(Array.map(info.scheme.preds,
                fun(pr) = dictType(ck, pr.name, pr.args[0])), params), ret),
            preds = [],
        }
        _ -> info.scheme
    }
}

-- Raises an internal error if `alt` opens evidence spelled like a local
-- binder in scope, on the program the backend is handed. Evidence has no id,
-- so `bind`'s check by id does not reach it. Protects SsaLower's rule that
-- evidence, which it files by spelling, is never bound inside the scope of
-- a binder of its spelling. Before `Turkey.Opt` gives each evidence binder a
-- spelling of its own, every opening of one class spells its evidence alike.
fun refuseNestedEvidence(env : CEnv, alt : Alt, where : Option Span) -> Unit {
    match (env.ids, openingOf(alt)) {
        (ScopedIds, Some(o)) -> for d in o.evidence {
            if Option.isSome(local(env, BySpelling(d))) {
                fail("the evidence '" + d + "' is bound inside the scope of a "
                     + "binder spelled alike", where)
            }
        }
        _ -> {}
    }
}

-- Returns the uids of the constants `alt` opens, now open around its body.
-- With `UniqueIds`, raises an internal error if an arm around it opened one
-- already. Copying an arm gives its constants fresh uids, as it gives its
-- binders fresh ids; a copy nested in its original that kept them would open
-- one constant twice, and the backend gives a constant the layout of the
-- innermost arm that opened it.
fun openArm(ck : Checker, env : CEnv, alt : Alt, where : Option Span) -> Vec Int {
    let out = []
    match (env.ids, alt) {
        (UniqueIds, ACon(name, _, Some(o))) -> for c in o.skolems {
            if Set.contains(ck.opened, c.uid) {
                fail("'" + name + "' opens '" + c.name + "' inside an arm that "
                     + "opened the same constant", where)
            }
            Set.add(ck.opened, c.uid)
            Vec.push(out, c.uid)
        }
        _ -> {}
    }
    out
}

-- An arm's type may not mention a constant its own pattern opened: the constant
-- stands for a type chosen at each packing.
fun refuseEscape(alt : Alt, got : Ty.Type, where : Option Span) -> Unit {
    match alt {
        ACon(name, _, Some(o)) -> refuseOpened(name, o, got, where)
        _ -> {}
    }
}

fun refuseOpened(name : String, o : Opening, got : Ty.Type, where : Option Span) -> Unit {
    let opened = Set.new()
    for s in o.skolems { Set.add(opened, s.uid) }
    for s in Ty.skolemsOf([got]) {
        if Set.contains(opened, s.uid) {
            fail("the type of this arm, " + Ty.show(got) + ", mentions '"
                 + s.name + "', which only exists inside the pattern '"
                 + name + "' that opened it", where)
        }
    }
}

fun checkCon(ck : Checker, e : Core, name : String) -> Ty.Type {
    let info = match Map.get(ck.decls.constructors, name) {
        Some(i) -> i
        None -> fail("unknown constructor '" + name + "'", e.span)
    }
    -- A nullary constructor stands alone rather than being applied, so what it
    -- is *worth* is the result rather than the function -- `None` is an
    -- `Option a`, not a `fun() -> Option a`.
    let scheme = constructorScheme(ck, info)
    var declared = scheme.body
    match declared {
        TFun(params, ret) -> if info.arity + len(info.scheme.preds) == 0
                && len(params) == 0 {
            declared = ret
        }
        _ -> {}
    }
    if !instanceOf(scheme, e.ty) && !compatible(declared, reduce(ck, e.ty)) {
        fail("'" + name + "' is not usable at " + Ty.show(e.ty)
             + "; it is declared " + Ty.show(declared), e.span)
    }
    e.ty
}

fun checkVar(ck : Checker, e : Core, name : String, id : Int, env : CEnv) -> Ty.Type {
    -- Not every name is in the Core environment: builtins arrive through the
    -- type environment the driver seeds this with, and a dictionary parameter is
    -- bound by the lambda that takes it. A name that reaches here unknown is a
    -- real hole, so say which name.
    let Bound { binders = binders, ty = ty, .. } = resolve(env, name, id, e.span)
    if len(binders) > 0 {
        -- A polymorphic name used with no type application: legitimate only
        -- under a type application, which does not check its operand this way.
        -- Reaching here means the application went missing.
        fail("'" + name + "' is polymorphic in "
             + String.join(Array.map(binders, \Ty.show(TVar(_))), " ")
             + " and is used without a type application", e.span)
    }
    ty
}

-- A type application: one argument per binder, then substitute.
--
-- The operand is not checked the ordinary way. Nothing else in this IR is
-- polymorphic, so the operand is a name, a primitive or a method projection, and its
-- polymorphic type comes from where it was bound rather than from its own type
-- -- which is why a variable refuses to be used polymorphically anywhere else.
fun checkTyApp(ck : Checker, e : Core, fn : Core, args : Array Ty.Type,
               env : CEnv) -> Ty.Type {
    let (binders, poly) = polymorphic(ck, fn, env)
    if len(binders) != len(args) {
        fail("type application has " + Int.toString(len(args))
             + " arguments for " + Int.toString(len(binders)) + " binders",
             e.span)
    }
    let mapping = Map.new()
    for var i = 0; i < len(binders); i = i + 1 {
        Map.put(mapping, binders[i].id, args[i])
    }
    Decls.substitute(poly, mapping)
}

-- The binders and body of whatever is being type-applied.
fun polymorphic(ck : Checker, fn : Core,
                env : CEnv) -> (Vec VarCell, Ty.Type) = match fn.kind {
    CVar(name, id) -> {
        let found = resolve(env, name, id, fn.span)
        (found.binders, found.ty)
    }
    CSlot(target, index) -> methodScheme(ck, fn, check(ck, target, env, None), index)
    CPrim(p) -> {
        let scheme = PrimTypes.scheme(p)
        (scheme.quantified, scheme.body)
    }
    _ -> fail("this cannot be type-applied", fn.span)
}

-- A method projected from a dictionary, as a polymorphic thing.
--
-- This is where a wrong dictionary stops being possible: the class comes from
-- the *dictionary's own type*, so a `Monoid` dictionary cannot answer a
-- `Semigroup` projection, and the method's remaining binders are its own
-- scheme's less the class variable the dictionary just fixed.
fun methodScheme(ck : Checker, e : Core, dictTy : Ty.Type,
                 index : Int) -> (Vec VarCell, Ty.Type) {
    let (cls, head) = dictParts(ck, dictTy, e.span)
    let m = match slotOf(ck, cls, index, e.span) {
        MethodSlot(name) -> methodNamed(ck, cls, name, e.span)
        KeyedSlot(name, _) -> methodNamed(ck, cls, name, e.span)
        SuperSlot(sup) -> fail("slot " + Int.toString(index) + " of a '" + cls
                               + "' dictionary is its '" + sup
                               + "' superclass, not a method", e.span)
    }
    let binders = Vec.new(4)
    for q in m.scheme.quantified {
        if q.id != m.classVar.id { Vec.push(binders, q) }
    }
    (binders, methodType(ck, m, head))
}

-- A method's type as it sits in a dictionary, at one head.
--
-- Derived here rather than read off the term, and derived the same way the
-- lowering derives it -- which is the point of a checker: two independent
-- computations of one type, compared. A method's own context is per call, so
-- those dictionaries are the field's parameters and not the dictionary's.
fun methodType(ck : Checker, m : MethodInfo, head : Ty.Type) -> Ty.Type {
    let mapping = Map.new()
    Map.put(mapping, m.classVar.id, head)
    let ty = Decls.substitute(m.scheme.body, mapping)
    let own = Classes.methodDicts(m)
    if len(own) == 0 { return ty }
    TFun(Array.map(own, fun(p) =
        dictType(ck, p.name, Decls.substitute(p.args[0], mapping))), ty)
}

-- Read `%Dict.C t` back as the class `C` and the type `t`.
fun dictParts(ck : Checker, ty : Ty.Type, where : Option Span) -> (String, Ty.Type) {
    let cls = match Cr.dictClass(ty) {
        Some(c) -> c
        None -> fail(Ty.show(ty) + " is not a dictionary", where)
    }
    if !Map.contains(ck.classes.classes, cls) {
        fail("no such class '" + cls + "'", where)
    }
    let (_, args) = Ty.spine(Ty.prune(ty))
    (cls, args[0])
}

-- What slot `index` of a `cls` dictionary holds.
fun slotOf(ck : Checker, cls : String, index : Int, where : Option Span) -> Slot =
    match Classes.slotAt(ck.classes, cls, index) {
        Some(slot) -> slot
        None -> fail("a '" + cls + "' dictionary has no slot " + Int.toString(index),
                     where)
    }

fun methodNamed(ck : Checker, cls : String, name : String,
                where : Option Span) -> MethodInfo =
    match Map.get(classNamed(ck, cls, where).methods, name) {
        Some(m) -> m
        None -> fail("class '" + cls + "' has no method '" + name + "'", where)
    }

-- A superclass or a method, by what the class declares at that slot. Which
-- class is decided by the *target's type*, so a `Monoid` dictionary cannot
-- answer for a `Semigroup` slot.
fun checkSlot(ck : Checker, e : Core, target : Core, index : Int,
              env : CEnv) -> Ty.Type {
    let t = check(ck, target, env, None)
    let (cls, head) = dictParts(ck, t, e.span)
    match slotOf(ck, cls, index, e.span) {
        SuperSlot(sup) -> return dictType(ck, sup, head)
        _ -> {}
    }
    let (binders, body) = methodScheme(ck, e, t, index)
    if len(binders) > 0 {
        fail("method '" + Classes.slotName(ck.classes, cls, index) + "' is polymorphic in "
             + String.join(Array.map(binders, \Ty.show(TVar(_))), " ")
             + " and is used without a type application", e.span)
    }
    body
}

fun checkProject(ck : Checker, e : Core, target : Core, index : Int,
                 env : CEnv) -> Ty.Type {
    let t = reduce(ck, Ty.prune(check(ck, target, env, None)))
    match t {
        TVar(_) -> return e.ty
        TFam(_, _, _) -> return e.ty
        TBottom -> return e.ty
        _ -> {}
    }
    let chosen = match t {
        TTuple(elems) -> if index < len(elems) { Some(elems[index]) } else { None }
        _ -> Decls.payloadType(ck.decls, t, index)
    }
    match chosen {
        Some(elem) -> elem
        None -> fail("invalid projection ." + Int.toString(index) + " from "
                     + Ty.show(t), e.span)
    }
}

fun isDict(ty : Ty.Type) -> Bool = Cr.isDictionary(ty)

fun dictType(ck : Checker, cls : String, arg : Ty.Type) -> Ty.Type {
    let info = classNamed(ck, cls, None)
    TApp(Ty.tcon(Cr.dictName(cls), KFun(Classes.classKind(info), KStar),
                 Ty.noScope), arg, KStar)
}

-- Every slot of a dictionary, against what the class declares there. A slot
-- missing is as much an error as a wrong one: a dictionary with a hole in it
-- is a crash waiting at whichever call reads the hole.
fun checkDict(ck : Checker, e : Core, cls : String, slots : Array Core,
              env : CEnv) -> Ty.Type {
    let (named, head) = dictParts(ck, e.ty, e.span)
    if named != cls {
        fail("a '" + cls + "' dictionary has the type of a '" + named + "' one", e.span)
    }
    let declared = Classes.dictSlots(ck.classes, cls)
    if len(slots) != len(declared) {
        fail("the '" + cls + "' dictionary for " + Ty.show(head) + " has "
             + Int.toString(len(slots)) + " slots, where the class has "
             + Int.toString(len(declared)), e.span)
    }
    for var i = 0; i < len(slots); i = i + 1 {
        let want = match declared[i] {
            SuperSlot(sup) -> dictType(ck, sup, head)
            MethodSlot(name) -> methodType(ck, methodNamed(ck, cls, name, e.span), head)
            KeyedSlot(name, _) -> methodType(ck, methodNamed(ck, cls, name, e.span), head)
        }
        let got = check(ck, slots[i], env, None)
        if !agrees(ck, want, got) {
            mismatch(ck, want, got, e.span, "the '" + Classes.slotName(ck.classes, cls, i)
                     + "' of a '" + cls + "' dictionary")
        }
    }
    e.ty
}

fun checkApp(ck : Checker, e : Core, fn : Core, args : Array Core,
             env : CEnv) -> Ty.Type {
    let fnTy = check(ck, fn, env, None)
    let argTys = Array.map(args, check(ck, _, env, None))
    match Ty.prune(fnTy) {
        TBottom -> e.ty
        TFun(params, ret) -> {
            if len(params) != len(argTys) {
                fail("a function of " + Int.toString(len(params))
                     + " parameters applied to " + Int.toString(len(argTys))
                     + " arguments", e.span)
            }
            for var i = 0; i < len(params); i = i + 1 {
                if !agrees(ck, params[i], argTys[i]) {
                    mismatch(ck, params[i], argTys[i], e.span,
                             "argument " + Int.toString(i + 1))
                }
            }
            ret
        }
        _ -> fail(Ty.show(fnTy) + " is not a function", e.span)
    }
}

-- `join j(params) = body in rest`.
--
-- The join's result type is the node's own, and both halves are checked against
-- it: a jump replaces the value of this whole expression, so the body answers
-- what the rest answers or the label would not be one.
--
-- The name is in scope for the rest always, and for the body only if the join
-- says it is recursive -- which is what stops a non-recursive join being a loop
-- nobody declared.
fun checkJoin(ck : Checker, e : Core, name : String, id : Int, params : Array CParam,
              body : Core, rest : Core, recursive : Bool,
              env : CEnv) -> Ty.Type {
    let joins = ck.joins
    let innerJoins = Map.new()
    for (k, v) in Map.entries(joins) { Map.put(innerJoins, k, v) }
    let j = JoinPoint { name = name, id = id, params = params, ty = e.ty }
    if id != noId {
        if let Some(outer) = Map.get(joins, ById(id)) {
            fail("the join point '" + name + "' is bound inside the scope of '"
                 + outer.name + "', which has the same id", e.span)
        }
    }
    Map.put(innerJoins, BySpelling(name), j)
    if id != noId { Map.put(innerJoins, ById(id), j) }
    noteBound(ck, env, name, id)
    let mark = enter(env)
    for p in params { bind(ck, env, p.name, p.id, [], p.ty, e.span) }
    let bodyTy = check(ck, body, env,
                       if recursive { Some(innerJoins) } else { Some(joins) })
    leave(env, mark)
    if !agrees(ck, e.ty, bodyTy) {
        mismatch(ck, e.ty, bodyTy, e.span, "the join point '" + name + "'")
    }
    joinTypes(bodyTy, check(ck, rest, env, Some(innerJoins)))
}

-- `jump j(args)`.
--
-- Reaching here at all is the tail-position check: the join scope is empty
-- everywhere but in a tail position, so a jump anywhere else fails to find its
-- name. The message says so, since the two ways to fail -- no such join, and not
-- in tail position -- are worth telling apart.
fun checkJump(ck : Checker, e : Core, name : String, id : Int, args : Vec Core,
              env : CEnv) -> Ty.Type {
    let found = Map.get(ck.joins, keyOf(name, id))
    let argTys = Array.map(args, check(ck, _, env, None))
    let params = match found {
        Some(j) -> {
            if j.name != name {
                fail("a jump to '" + name + "' has the id of the join point '"
                     + j.name + "'", e.span)
            }
            j.params
        }
        None -> fail("'" + name + "' is not a join point in scope here; a jump "
                     + "must be in tail position of the join that binds it",
                     e.span)
    }
    if len(params) != len(argTys) {
        fail("a jump to '" + name + "' passes " + Int.toString(len(argTys))
             + " arguments for " + Int.toString(len(params)) + " parameters",
             e.span)
    }
    for var i = 0; i < len(params); i = i + 1 {
        if !agrees(ck, params[i].ty, argTys[i]) {
            mismatch(ck, params[i].ty, argTys[i], e.span,
                     "argument " + Int.toString(i + 1) + " of the jump")
        }
    }
    match Ty.prune(e.ty) {
        TBottom -> {}
        _ -> fail("a jump to '" + name + "' claims " + Ty.show(e.ty)
                  + "; it never yields to its context, so it is bottom", e.span)
    }
    e.ty
}

-- -- patterns, derived rather than read ----------------------------------------------

-- What an arm binds, worked out from what it is matched against.
--
-- Reduced first, and here rather than at the call sites: a scrutinee may be
-- `Item a`, and whether its constructors are `Op`'s is exactly what the equality
-- in scope decides. Matching against an unreduced family would reject a program
-- the checker had been told about.
fun pattern(ck : Checker, alt : Alt, scrutinee : Ty.Type,
            where : Option Span) -> Vec (String, Int, Ty.Type) {
    let target = Ty.prune(reduce(ck, scrutinee))
    match alt {
        AAny(binder) -> {
            let out = []
            if let Some((name, id)) = binder { Vec.push(out, (name, id, target)) }
            out
        }
        ALit(_) -> []
        ATuple(elems) -> match target {
            TTuple(tys) -> {
                if len(elems) != len(tys) {
                    fail("a tuple of " + Int.toString(len(elems))
                         + " matched against " + Ty.show(target), where)
                }
                bindAll(elems, tys)
            }
            TVar(_) -> freshBinders(alt)
            TBottom -> freshBinders(alt)
            _ -> fail("a tuple pattern against " + Ty.show(target), where)
        }
        ACon(name, fields, opening) -> conPattern(ck, alt, name, fields, opening, target, where)
    }
}

fun bindAll(binders : Array (Option (String, Int)),
           tys : Array Ty.Type) -> Vec (String, Int, Ty.Type) {
    let out = []
    for var i = 0; i < len(binders) && i < len(tys); i = i + 1 {
        if let Some((name, id)) = binders[i] { Vec.push(out, (name, id, tys[i])) }
    }
    out
}

fun conPattern(ck : Checker, alt : Alt, name : String, fields : Array (Option (String, Int)),
               opening : Option Opening, target : Ty.Type,
               where : Option Span) -> Vec (String, Int, Ty.Type) {
    let info = match Map.get(ck.decls.constructors, name) {
        Some(i) -> i
        None -> fail("unknown constructor '" + name + "'", where)
    }
    match target {
        TVar(_) -> return freshBinders(alt)
        TBottom -> return freshBinders(alt)
        _ -> {}
    }
    let (h, _) = Ty.spine(target)
    let headName = match h {
        TCon(c) -> c.name
        _ -> fail("'" + name + "' is a constructor of '" + info.tycon
                  + "', matched against " + Ty.show(target), where)
    }
    if headName != info.tycon {
        fail("'" + name + "' is a constructor of '" + info.tycon
             + "', matched against " + Ty.show(target), where)
    }
    let mapping = headMapping(info.scheme, target)
    -- The hidden variables are the pattern's rigid constants and nothing the
    -- scrutinee says; the dictionaries arrive under the names the pattern gives
    -- them.
    let carriedTypes = []
    if len(info.exists) > 0 {
        let o = match opening {
            Some(o) -> o
            None -> fail("'" + name + "' is existential, and this pattern does "
                         + "not open it", where)
        }
        if len(o.skolems) != len(info.exists)
                || len(o.evidence) != len(info.scheme.preds) {
            fail("'" + name + "' is existential, and this pattern does not open it",
                 where)
        }
        for var i = 0; i < len(info.exists); i = i + 1 {
            Map.put(mapping, info.exists[i].id, TCon(o.skolems[i]))
        }
        for var i = 0; i < len(info.scheme.preds); i = i + 1 {
            let pr = info.scheme.preds[i]
            Vec.push(carriedTypes, (o.evidence[i],
                dictType(ck, pr.name, Decls.substitute(pr.args[0], mapping))))
        }
    }
    let params = match info.scheme.body {
        TFun(ps, _) -> ps
        _ -> []
    }
    let fieldTypes = Array.map(params, Decls.substitute(_, mapping))
    if len(fields) != len(fieldTypes) {
        fail("'" + name + "' takes " + Int.toString(len(fieldTypes))
             + " arguments, matched with " + Int.toString(len(fields)), where)
    }
    let out = bindAll(fields, fieldTypes)
    -- The dictionaries an opening binds have no ids.
    for (n, t) in carriedTypes { Vec.push(out, (n, noId, t)) }
    out
}

fun freshBinders(alt : Alt) -> Vec (String, Int, Ty.Type) {
    let out = []
    let add = fun(binder) = if let Some((name, id)) = binder {
        Vec.push(out, (name, id, freshType()))
    }
    match alt {
        ACon(_, fields, opening) -> {
            if let Some(o) = opening {
                for d in o.evidence { Vec.push(out, (d, noId, freshType())) }
            }
            for f in fields { add(f) }
        }
        ATuple(elems) -> for f in elems { add(f) }
        ALit(_) -> {}
        AAny(binder) -> add(binder)
    }
    out
}

-- -- comparison ---------------------------------------------------------------------

-- Compare, after reducing both sides' families throughout.
--
-- A class declares `iter` as `fun(a) -> Cursor a`, and at `Array a` that is
-- `Cursor (Array a)` -- which is `ArrayCursor`, the type the body was inferred
-- at. The two are one type and only one of them is reduced, so reducing is part
-- of comparing rather than something the lowering was supposed to have done.
fun expect(ck : Checker, want : Ty.Type, got : Ty.Type, where : Option Span,
           what : String) -> Unit {
    if !agrees(ck, want, got) { mismatch(ck, want, got, where, what) }
}

-- `expect` in two halves, for a caller whose description has to be built: it
-- runs once per node, and a message is only needed when one fails.
fun agrees(ck : Checker, want : Ty.Type, got : Ty.Type) -> Bool =
    compatible(reduce(ck, want), reduce(ck, got))

fun mismatch(ck : Checker, want : Ty.Type, got : Ty.Type, where : Option Span,
             what : String) -> a =
    fail(what + " should be " + Ty.show(reduce(ck, want)) + " but is "
         + Ty.show(reduce(ck, got)), where)

-- A type with no family application in it is already reduced, and most are:
-- deciding that allocates nothing, where `reduceDeep` rebuilds every node.
fun reduce(ck : Checker, ty : Ty.Type) -> Ty.Type =
    if familyFree(ty) { ty } else { Typed.reduceDeep(ty, Some(ck.fams)) }

fun familyFree(ty : Ty.Type) -> Bool = match Ty.prune(ty) {
    TFam(_, _, _) -> False
    TApp(fn, arg, _) -> familyFree(fn) && familyFree(arg)
    TFun(params, ret) -> {
        for p in params {
            if !familyFree(p) { return False }
        }
        familyFree(ret)
    }
    TTuple(elems) -> {
        for t in elems {
            if !familyFree(t) { return False }
        }
        True
    }
    _ -> True
}

-- The binding's equalities first, then the instances.
--
-- The order is the solver's, and copied deliberately. A given equality is a
-- reduction rule for the family it names, and it has to be consulted first
-- because a family over a rigid variable never reduces through the instance
-- table at all.
fun famsOf(classes : ClassTable,
           equations : Vec (Ty.Type, Ty.Type)) -> Ty.Families = Ty.Families {
    reduce = fun(t) = {
        for (left, right) in equations {
            -- A rule from a family application to itself is no rule. Skipped
            -- rather than returned, so the instance table still gets its turn:
            -- returning it would leave `Field.tag Auto` unreduced next to the
            -- `Int` it is, and stop the comparison that needs them equal.
            if Ty.sameType(left, t) && !Ty.sameType(right, t) {
                return Some(right)
            }
        }
        match t {
            TFam(name, arg, _) -> Classes.reduceFam(classes, name, arg)
            _ -> None
        }
    },
    defer = fun(_, _, _, _) = {},
}

-- Whether `ty` is an instantiation of a scheme. One-way: the scheme's variables
-- may be bound, the type's may not.
fun instanceOf(s : Scheme, ty : Ty.Type) -> Bool =
    Classes.matches(s.body, Ty.prune(ty)) || compatible(s.body, ty)

-- Whether two types may stand for each other in a Core term.
--
-- Structural, with the two slacknesses named above: bottom absorbs, and a
-- variable on either side binds rather than fails. Binding is per-comparison and
-- unrecorded, which is deliberate -- this is a check that a term is well-typed,
-- not an inference that decides what its variables are.
fun compatible(want : Ty.Type, got : Ty.Type) -> Bool {
    let w = Ty.prune(want)
    let g = Ty.prune(got)
    match w {
        TBottom -> return True
        TVar(_) -> return True
        _ -> {}
    }
    match g {
        TBottom -> return True
        TVar(_) -> return True
        _ -> {}
    }
    if Ty.sameType(w, g) { return True }
    match (w, g) {
        (TFun(wp, wr), TFun(gp, gr)) -> {
            if len(wp) != len(gp) { return False }
            for var i = 0; i < len(wp); i = i + 1 {
                if !compatible(wp[i], gp[i]) { return False }
            }
            compatible(wr, gr)
        }
        (TTuple(we), TTuple(ge)) -> {
            if len(we) != len(ge) { return False }
            for var i = 0; i < len(we); i = i + 1 {
                if !compatible(we[i], ge[i]) { return False }
            }
            True
        }
        (TApp(wf, wa, _), TApp(gf, ga, _)) ->
            compatible(wf, gf) && compatible(wa, ga)
        -- Two stuck families. Neither reduced, so what is left to compare is the
        -- family and its argument -- and the arguments are variables the binder
        -- made rigid, which the rule above already lets match.
        (TFam(wn, wa, _), TFam(gn, ga, _)) -> wn == gn && compatible(wa, ga)
        _ -> False
    }
}

-- -- helpers ------------------------------------------------------------------------

-- The type of two branches. Bottom is the one that yields.
fun joinTypes(a : Ty.Type, b : Ty.Type) -> Ty.Type = match Ty.prune(a) {
    TBottom -> b
    _ -> a
}

fun freshType() -> Ty.Type = TVar(Ty.freshVar(0))

fun classNamed(ck : Checker, name : String, where : Option Span) -> ClassInfo =
    match Map.get(ck.classes.classes, name) {
        Some(i) -> i
        None -> fail("no such class '" + name + "'", where)
    }

-- Bind a constructor's own variables to the type it was used at.
--
-- By matching its declared *result* against the target, not by zipping its
-- quantified variables against the target's arguments. The two are not the same
-- list: a scheme's variables are in the order the scheme was built in, which for
-- `Ret(r) : Flow a b r` puts `r` first. Zipping would have bound `a` where `r`
-- belongs -- and did, until the checker said so.
fun headMapping(s : Scheme, target : Ty.Type) -> Map Int Ty.Type {
    let result = match s.body {
        TFun(_, ret) -> ret
        _ -> s.body
    }
    match Classes.match_(result, Ty.prune(target)) {
        Some(mapping) -> mapping
        -- The target is not an instance of the result -- a variable somewhere,
        -- or a bottom. Nothing can be derived, and the caller's own checks
        -- report it.
        None -> Map.new()
    }
}

-- A node, said in a way a reader can find in the term. "CVar" names the rule
-- that failed; "the variable 'x'" names the thing that is wrong, which is what
-- someone chasing a mis-lowering needs.
fun describe(e : Core) -> String = match e.kind {
    CVar(name, _) -> "the variable '" + name + "'"
    CSlot(_, index) -> "the dictionary slot " + Int.toString(index)
    CProject(_, index) -> "the projection '." + Int.toString(index) + "'"
    CCon(name) -> "the constructor '" + name + "'"
    CPrim(prim) -> "the builtin '" + Prims.name(prim) + "'"
    CLet(name, _, _, _, _, _) -> "the body of 'let " + name + "'"
    CApp(_, _) -> "the result of an application"
    CTyApp(_, _) -> "the result of a type application"
    _ -> "this term"
}

-- A Core term that does not typecheck.
--
-- This is never the author's fault. Their program was accepted by inference; if
-- the term it lowered to does not check, the lowering or the elaboration is
-- wrong. So it says so, and says which node.
fun fail(message : String, where : Option Span) -> a = match where {
    None -> Diag.fail(Diag.whole("internal error", message), "")
    Some(s) -> Diag.fail(Diag.at("internal error", message, s), s.file)
}
