export (
    ConInfo(..), isRecord,
    TyconInfo(..), isPlainRecord, isMutable,
    FamilyInfo(..),
    ForeignInfo(..),
    DeclTable(..), newDeclTable,
    head, registerAll, settleKinds,
    star, toType, instantiateCon, con, recordFields, varFields, fieldSpan,
    existentialFields,
    fieldType, projectionTypes, payloadType, payloadTypes, hasIdentity, isRecordCon,
    substitute, newtypes, erasedPayload, conFieldTypes, conFieldTypesOpened,
    variantCount, Compact(..), compactShape, compactOf, enumSize, enumIndex,
    FlatDecl(..), flatCandidates, flatDecl, mayBeFlat, showDeclarations,
)

-- Type and constructor declarations, resolved into semantic types
-- (`turkey/decls.py`).
--
-- The bridge between what the author wrote (`Turkey.Ast`'s type syntax) and
-- what inference manipulates (`Turkey.Types`). It holds the program's type
-- constructors, its value constructors, and the translation of type syntax --
-- including alias expansion, which is transparent: an alias is its expansion
-- everywhere, and never a type of its own.

import Data.Set as Set
import Turkey.Ast (..)
import Turkey.Deps as Deps
import Turkey.Diag as Diag
import Turkey.Source (Span(..))
import Turkey.Ssa as Ssa
import Turkey.Types as Ty
-- The *constructors* of the semantic type, without the name itself: in this
-- file `Type` is the syntax the author wrote (`Turkey.Ast`) and `Ty.Type` is
-- what inference manipulates, and translating between them is the whole job.
import Turkey.Types (Kind(..), VarCell(..), Scheme(..),
                     TVar, TCon, ConCell(..), TApp, TFam, TFun, TTuple,
                     TSet, TBottom)

-- One value constructor: its fields by position, which is how its object
-- holds them. Names are an addition some constructors make to that, and change
-- nothing about the positions: `fields` is `None` for the positional form.
type ConInfo = ConInfo {
    name   : String,
    tycon  : String,
    fields : Option (Array String),
    -- Whether each position may be assigned, parallel to the scheme's
    -- arguments: a field declared `var`.
    mutable : Array Bool,
    -- Where each field's name is declared, parallel to `fields`.
    fieldSpans : Vec Span,
    arity  : Int,
    -- Always `forall params. fun(args...) -> tycon params`. An existential's
    -- context is the scheme's `preds`.
    scheme : Scheme,
    -- An existential constructor's hidden variables: the scheme's variables
    -- that do not reach its result.
    exists : Vec VarCell,
    -- The names the bracket wrote for them, which an opened pattern's rigid
    -- constants are named after.
    existsNames : Vec String,
    -- Each field's type as the declaration wrote it, for a diagnostic to
    -- quote: `Map k v` rather than what the alias stands for.
    written : Vec Type,
}

fun isRecord(c : ConInfo) -> Bool = Option.isSome(c.fields)

type TyconInfo = TyconInfo {
    name      : String,
    params    : Vec String,
    variants  : Vec ConInfo,
    isAlias   : Bool,
    aliasBody : Option Type,
    span      : Option Span,
    kind      : Kind,
    -- The declaration's derive list, its class names resolved. Empty for an
    -- alias, which may not have one, and for a built-in type.
    derives   : Vec Derive,
}

-- One variant carrying a record payload, and not existential: the types whose
-- fields are read with `.`, and the only ones that may declare a field `var`.
-- An existential's fields cannot be assigned, since a write would have to know
-- the hidden type.
fun isPlainRecord(t : TyconInfo) -> Bool =
    len(t.variants) == 1 && isRecord(t.variants[0])
        && len(t.variants[0].exists) == 0

-- Whether some position of the constructor may be assigned.
fun hasMutable(c : ConInfo) -> Bool = Array.contains(c.mutable, True)

-- Whether a value of the type can change after it is built: some field is
-- `var`. A type without one is immutable, records included.
fun isMutable(t : TyconInfo) -> Bool {
    for c in t.variants { if hasMutable(c) { return True } }
    False
}

-- Whether `name` constructs a record: its fields are named.
fun isRecordCon(t : DeclTable, name : String) -> Bool = match con(t, name) {
    Some(info) -> isRecord(info)
    None -> False
}

-- Whether a build with constructor `name` is an object rather than a value:
-- some position of it can be assigned, so two builds from equal fields can be
-- told apart by assigning through one. Such a build may not be copied, rebuilt
-- from its fields, or matched through in place of the object it makes. However
-- it was written -- `Counter(0)` makes an object exactly as `Counter { n = 0 }`
-- does.
fun hasIdentity(t : DeclTable, name : String) -> Bool = match con(t, name) {
    Some(info) -> hasMutable(info)
    None -> False
}

-- An associated type family, as the type language sees it.
--
-- Families are declared inside classes, but they are *type* names, so they are
-- resolved here alongside constructors and aliases -- one place decides what a
-- name in type position means. Both kinds start undecided and are narrowed by
-- use, exactly as a class variable's is: `argKind` is the owning class's
-- parameter kind, and `resKind` is what the family produces.
type FamilyInfo = FamilyInfo {
    name    : String,
    cls     : String,
    argKind : Kind,
    resKind : Kind,
    span    : Option Span,
}

-- What a `foreign` declaration says, once its types are resolved.
--
-- The same three facts a `Prim.` entry carries -- a C symbol, what it takes and
-- what it answers -- which is the point of the declaration form: it is an entry
-- in that table written in source rather than in the compiler.
type ForeignInfo = ForeignInfo {
    name   : String,
    symbol : String,
    params : Array Ty.Type,
    -- How many of `params` are C's named parameters; the rest are variadic
    -- arguments. All of them for a definition, which cannot be variadic.
    fixed  : Int,
    ret    : Ty.Type,
    span   : Option Span,
}

type DeclTable = DeclTable {
    tycons       : Map String TyconInfo,
    constructors : Map String ConInfo,
    -- One head per name, so a constructor's kind cannot be recorded twice and
    -- disagree with itself. Unification compares names, but everything that
    -- reads a kind reads it off the head.
    heads        : Map String Ty.Type,
    -- Filled in by the class table, before any signature is resolved, since a
    -- method's type may mention a family of a class declared further down.
    families     : Map String FamilyInfo,
    -- Short name -> the qualified name that claimed it first. Two modules may
    -- each declare a `Node`; this is what notices, so that both print qualified
    -- rather than both printing `Node`. It is also what the
    -- class and family namespaces are checked against, since a class name is
    -- global and unqualified.
    shorts       : Map String String,
    -- Registration order, for anything that has to walk the table the way it
    -- was built. A `Map` here is insertion-ordered, but the primitives and
    -- `Prim.Array` are in it before any module is read.
    order        : Vec String,
    -- Every `foreign` declaration in the program, by the name it was bound
    -- under. Written by `Turkey.Infer.bindForeigns` and read by both
    -- backends, which is why it is here: the declaration table is the one
    -- thing threaded from the front end all the way down, and a call site
    -- needs the symbol and the result's representation at the moment the
    -- instruction is emitted.
    foreigns     : Map String ForeignInfo,
    -- Every `foreign` definition, by the function's name: the same facts, in
    -- the other direction. Written by
    -- `Turkey.Infer.checkDefinitions`; read by `Turkey.Mono`, which may not
    -- drop one, and by the backends, which export each under its symbol.
    definitions  : Map String ForeignInfo,
    -- The binder ids of every `fun` and `foreign` declaration in the program.
    -- Written by `Turkey.Infer` as it binds each one, which is before any
    -- body that can name it is generated, even from another module; read by
    -- the diagnostic for an assignment to one.
    functions    : Set.Set Int,
    -- `newtypes`, computed once the declarations are all in.
    var newtypeNames : Option (Set.Set String),
    -- `flatCandidates`, likewise.
    var flatNames : Option (Map String FlatDecl),
    -- The layout of each candidate without parameters, which is the same
    -- wherever it is asked for. Filled by `Turkey.Layout.share` before anything
    -- reads it in parallel, and only read after.
    groundLayouts : Map String Ssa.Layout,
    -- Existential constructor -> key name -> index: the keys each is packed at
    -- anywhere in the program, numbered. Filled by `Turkey.Layout.share`, which
    -- says why every packed key is in it, and only read after.
    packings : Map String (Map String Int),
    -- Existential constructors whose contexts name classes, until the class
    -- table has the classes to check them against.
    var uncheckedContexts : Vec (ConInfo, ConDecl),
    -- The aliases reported as recursive. One has no expansion, so every use
    -- of it translates to bottom.
    recursiveAliases : Set.Set String,
}

fun newDeclTable() -> DeclTable {
    Ty.clearQualified()
    Ty.clearOpened()
    let t = DeclTable {
        tycons = Map.new(), constructors = Map.new(), heads = Map.new(),
        families = Map.new(), shorts = Map.new(), order = Vec.new(16),
        foreigns = Map.new(), definitions = Map.new(), functions = Set.new(),
        newtypeNames = None, flatNames = None, groundLayouts = Map.new(),
        packings = Map.new(), uncheckedContexts = [], recursiveAliases = Set.new(),
    }
    for name in Ty.primitives() {
        Map.put(t.heads, name, Ty.tcon(name, KStar, Ty.noScope))
        Map.put(t.tycons, name, TyconInfo {
            name = name, params = [], variants = [],
            isAlias = False, aliasBody = None, span = None, kind = KStar, derives = [],
        })
        Map.put(t.shorts, name, name)
        Vec.push(t.order, name)
    }
    let rawKind = KFun(KStar, KStar)
    Map.put(t.tycons, "Prim.Array", TyconInfo {
        name = "Prim.Array", params = ["a"], variants = [],
        isAlias = False, aliasBody = None, span = None, kind = rawKind, derives = [],
    })
    Map.put(t.heads, "Prim.Array", Ty.tcon("Prim.Array", rawKind, Ty.noScope))
    Vec.push(t.order, "Prim.Array")
    Map.put(t.tycons, "Prim.Ptr", TyconInfo {
        name = "Prim.Ptr", params = [], variants = [],
        isAlias = False, aliasBody = None, span = None, kind = KStar, derives = [],
    })
    Map.put(t.heads, "Prim.Ptr", Ty.tcon("Prim.Ptr", KStar, Ty.noScope))
    Vec.push(t.order, "Prim.Ptr")
    Map.put(t.tycons, "Prim.Atomic", TyconInfo {
        name = "Prim.Atomic", params = [], variants = [],
        isAlias = False, aliasBody = None, span = None, kind = KStar, derives = [],
    })
    Map.put(t.heads, "Prim.Atomic", Ty.tAtomic())
    Vec.push(t.order, "Prim.Atomic")
    t
}

fun head(t : DeclTable, name : String) -> Ty.Type = match Map.get(t.heads, name) {
    Some(h) -> h
    None -> bug("unknown type '" + name + "'", None)
}

-- -- registration -------------------------------------------------------------------

-- Whether a declaration gives a primitive its name: `type Int = Prim.Int`, or
-- `type Unit = ()`, which is how the library puts the primitives in modules.
-- Only the library can write the first kind, since only it can spell `Prim.`.
-- Any other declaration of a primitive's name would make that name mean two
-- types.
fun namesPrimitive(d : TypeDecl) -> Bool {
    let short = Ty.shortName(d.name)
    if len(d.params) != 0 { return False }
    match d.alias {
        Some(te) -> match te.kind {
            TECon(target, args) -> target == short && len(args) == 0
            TETuple(elems) -> short == "Unit" && len(elems) == 0
            _ -> False
        }
        None -> False
    }
}

-- Declare every type before resolving any, so they may refer to each other in
-- any order.
fun registerAll(t : DeclTable, decls : Vec TypeDecl) -> Unit {
    -- A declaration whose variables were reported below is still registered,
    -- so its uses elsewhere find it, but its constructors are not translated:
    -- translating them assumes every variable is declared.
    let invalid = Set.new()
    for d in decls {
        let params = Set.new()
        for p in d.params { Set.add(params, p) }
        let groups = Vec.new(2)
        match d.alias {
            Some(body) -> Vec.push(groups, (Set.new(), [body]))
            None -> {}
        }
        match d.variants {
            Some(variants) -> for c in variants {
                -- A bracket's variables are this variant's alone, and none of
                -- them may be a parameter.
                let hidden = hiddenVariables(c)
                for name in hidden {
                    if Set.contains(params, name) {
                        Set.add(invalid, d.name)
                        report("'" + name + "' is a parameter of type '" + d.name
                               + "', so the bracket of '" + c.name
                               + "' cannot hide it", Some(c.span))
                    }
                }
                let distinct = Set.new()
                for b in c.binders {
                    if Set.contains(distinct, b) {
                        Set.add(invalid, d.name)
                        report("'" + b + "' appears twice in the bracket of '"
                               + c.name + "'", Some(c.span))
                    }
                    Set.add(distinct, b)
                }
                let hiddenSet = Set.new()
                for name in hidden { Set.add(hiddenSet, name) }
                Vec.push(groups, (hiddenSet, conTypes(c)))
            }
            None -> {}
        }
        for (hiddenSet, types) in groups {
            for te in types {
                for v in typeVariables(te) {
                    match v.kind {
                        TEVar(name) -> if !Set.contains(params, name)
                                && !Set.contains(hiddenSet, name) {
                            Set.add(invalid, d.name)
                            report("type variable '" + name + "' is not declared by "
                                   + "type '" + d.name + "'", Some(v.span))
                        }
                        _ -> {}
                    }
                }
            }
        }
    }
    -- A declaration reported as a duplicate is left out of the passes below,
    -- so its constructors are not reported again as duplicates of the first's.
    let kept : Vec TypeDecl = []
    for d in decls {
        let short = Ty.shortName(d.name)
        if Ty.isPrimitive(short) && !namesPrimitive(d) {
            report("cannot redefine the built-in type '" + short + "'", Some(d.span))
        }
        if Map.contains(t.tycons, d.name) {
            report("type '" + d.name + "' is declared more than once", Some(d.span))
            continue
        }
        Vec.push(kept, d)
        if Option.isSome(d.alias) && len(d.derives) > 0 {
            report("'" + short + "' is a type alias, and an alias cannot derive "
                   + "classes; derive them where the type it names is declared",
                   Some(d.derives[0].span))
        }
        -- Every declaration is given its kind *skeleton* up front -- one arrow
        -- per parameter, over kind variables. Arity is syntactic, so the
        -- skeleton is exact and only the parameters' own kinds are left to
        -- discover; that is why mutual recursion needs no dependency pass here,
        -- unlike the value level. Kinds are not polymorphic, so there is
        -- nothing to generalize between one declaration and the next.
        let kind = Ty.kindArrow(len(d.params), KStar)
        Map.put(t.tycons, d.name, TyconInfo {
            name = d.name, params = d.params, variants = Vec.new(2),
            isAlias = Option.isSome(d.alias), aliasBody = d.alias,
            span = Some(d.span), kind = kind,
            derives = if Option.isSome(d.alias) { [] } else { d.derives },
        })
        Map.put(t.heads, d.name, Ty.tcon(d.name, kind, Ty.noScope))
        Vec.push(t.order, d.name)
        match Map.get(t.shorts, short) {
            Some(claimed) -> if claimed != d.name {
                -- Two modules declare this short name. Neither may keep it.
                Ty.qualify(claimed)
                Ty.qualify(d.name)
            }
            None -> Map.put(t.shorts, short, d.name)
        }
    }
    -- Cycles first: a constructor field or an alias body that mentions a
    -- recursive alias would otherwise expand it for ever.
    for d in kept {
        if Option.isSome(d.alias) && !Set.contains(t.recursiveAliases, d.name) {
            let _ = checkAliasAcyclic(t, d.name, d.name, Set.new())
        }
    }
    for d in kept {
        if Option.isNone(d.alias) && !Set.contains(invalid, d.name) { resolveVariants(t, d) }
    }
    for d in kept {
        if Option.isSome(d.alias) {
            checkAliasHead(t, d)
            if !Set.contains(t.recursiveAliases, d.name) {
                kindCheckAlias(t, tyconOf(t, d.name))
            }
        }
    }
    settleKinds(t)
}

-- `type Shape = Circle Float` reads as an alias for an unknown type `Circle`,
-- since a constructor's payload would be parenthesized; it is usually a
-- constructor written without its parentheses, so the refusal says how.
fun checkAliasHead(t : DeclTable, d : TypeDecl) -> Unit = match d.alias {
    Some(te) -> match te.kind {
        TECon(name, args) -> {
            if len(args) != 0 && !Map.contains(t.tycons, name)
                    && !Map.contains(t.families, name) {
                report("unknown type '" + name + "'; to declare a constructor, "
                       + "write '" + name + "(...)'", Some(te.span))
            }
        }
        _ -> {}
    }
    None -> {}
}

fun tyconOf(t : DeclTable, name : String) -> TyconInfo = match Map.get(t.tycons, name) {
    Some(info) -> info
    None -> bug("unknown type '" + name + "'", None)
}

-- The declaration's parameters as variables carrying the kinds its own kind
-- assigns them, so applying one in the body constrains the header.
fun paramVars(info : TyconInfo, level : Int) -> Map String Ty.Type {
    let out = Map.new()
    var k = info.kind
    for p in info.params {
        match Ty.kprune(k) {
            KFun(arg, res) -> {
                Map.put(out, p, TVar(Ty.newVar(level, arg)))
                k = res
            }
            _ -> bug("type '" + info.name + "' has fewer arrows than parameters",
                      info.span)
        }
    }
    out
}

-- Resolve an alias body once, for its kinds alone.
--
-- Aliases are expanded at each use rather than stored, so nothing else would
-- ever look at the body with the header's parameters in scope -- and
-- `type Id f a = f a` would leave `f` defaulted to `*`.
--
-- The body must classify values. An alias has to be saturated where it is used,
-- so an alias *to* an unapplied constructor could never be written down, and
-- rejecting it here says so where the mistake is.
fun kindCheckAlias(t : DeclTable, info : TyconInfo) -> Unit = match info.aliasBody {
    None -> {}
    Some(body) -> discard(star(t, body, paramVars(info, 1), fun() = Ty.freshVar(1)))
}

-- Haskell 98's defaulting rule: a kind still undecided is `*`.
--
-- Kinds are first-order here -- no polymorphism, no `forall k` -- so a variable
-- left over after the declarations have been read is one nothing constrained,
-- and `*` is the only choice that keeps the type usable.
fun settleKinds(t : DeclTable) -> Unit {
    for (_, info) in Map.entries(t.tycons) { discard(Ty.defaultKind(info.kind)) }
    for (_, c) in Map.entries(t.constructors) {
        for v in c.scheme.quantified { discard(Ty.defaultKind(v.kind)) }
    }
}

fun resolveVariants(t : DeclTable, decl : TypeDecl) -> Unit {
    let info = tyconOf(t, decl.name)
    -- The type's own parameters become variables shared by every variant, so
    -- `Some a` and `None` both land in `Option a`.
    let tyvars = paramVars(info, 1)
    let args = Array.map(decl.params, Map.getOr(tyvars, _, TBottom))
    let result = Ty.applyTo(head(t, decl.name), args, Some(decl.span))

    match decl.variants {
        None -> {}
        Some(variants) -> for c in variants {
            match Map.get(t.constructors, c.name) {
                Some(other) -> report("constructor '" + c.name + "' is already "
                    + "declared by type '" + other.tycon + "'", Some(c.span))
                None -> {}
            }
            let names = match c.fields {
                Some(fs) -> Some(Array.map(fs, firstOfPair))
                None -> None
            }
            -- The bracket's variables are this variant's alone.
            let local = Map.new()
            for (k, v) in Map.entries(tyvars) { Map.put(local, k, v) }
            let hidden = Vec.new(2)
            for name in hiddenVariables(c) {
                let cell = Ty.freshVar(1)
                Map.put(local, name, TVar(cell))
                Vec.push(hidden, cell)
            }
            let argTypes = match c.fields {
                Some(fs) -> Array.map(fs, fun((_, te)) = star(t, te, local, undeclared))
                None -> Array.map(c.args, star(t, _, local, undeclared))
            }
            -- Class names are checked, and kinds compared, once the classes
            -- exist: `Turkey.Classes.checkConstructorContexts`.
            let context = Vec.new(len(c.context))
            for p in c.context {
                match p.kind {
                    PClass(name, argTe) -> Vec.push(context,
                        Ty.pred(name, [toType(t, argTe, local, undeclared)]))
                    _ -> {}
                }
            }
            let s = Ty.generalize(TFun(argTypes, result), 0, context)
            for cell in hidden {
                var present = False
                for q in s.quantified {
                    if q.id == cell.id { present = True }
                }
                if !present { Vec.push(s.quantified, cell) }
            }
            checkVars(decl, c, variants)
            let mutable = match names {
                Some(ns) -> Array.map(ns, Vec.contains(c.vars, _))
                None -> Array.map(argTypes, fun(_) = False)
            }
            let cinfo = ConInfo {
                name = c.name, tycon = decl.name, fields = names,
                mutable = mutable, fieldSpans = c.fieldSpans,
                arity = len(argTypes), scheme = s, exists = hidden,
                existsNames = hiddenVariables(c), written = conTypes(c),
            }
            if len(c.context) > 0 { Vec.push(t.uncheckedContexts, (cinfo, c)) }
            Vec.push(info.variants, cinfo)
            Map.put(t.constructors, c.name, cinfo)
        }
    }
}

-- `var` only where an assignment could name the field. `x.f = v` names a
-- field of whatever `x` is, so in a type with several constructors it would
-- name a field the value may not have; and an existential record's field has a
-- type that only an opening can name.
fun checkVars(decl : TypeDecl, c : ConDecl, variants : Vec ConDecl) -> Unit {
    if len(c.vars) == 0 { return {} }
    let at = Some(firstVarSpan(c))
    if len(variants) > 1 {
        return report("field '" + c.vars[0] + "' cannot be 'var': '" + decl.name
                      + "' has more than one constructor", at)
    }
    if len(hiddenVariables(c)) > 0 {
        report("field '" + c.vars[0] + "' cannot be 'var': '" + c.name
               + "' is existential", at)
    }
}

fun firstVarSpan(c : ConDecl) -> Span {
    if let Some(fs) = c.fields {
        for var i = 0; i < len(fs); i = i + 1 {
            if fs[i].0 == c.vars[0] { return c.fieldSpans[i] }
        }
    }
    c.span
}

fun firstOfPair(p : (String, Type)) -> String {
    let (name, _) = p
    name
}

-- A type alias may not be recursive: it is expanded, not unfolded, so a
-- recursive one has no normal form to expand to.
--
-- Returns whether `root` is recursive. If so, reports it, and adds every alias
-- on the cycle to `t.recursiveAliases`, so a cycle through several is
-- reported once.
fun checkAliasAcyclic(t : DeclTable, root : String, name : String,
                      seen : Set.Set String) -> Bool {
    match Map.get(t.tycons, name) {
        None -> return False
        Some(info) -> {
            if !info.isAlias || Set.contains(seen, name) { return False }
            let inner = Set.new()
            for s in Set.elements(seen) { Set.add(inner, s) }
            Set.add(inner, name)
            for referenced in referencedTycons(info.aliasBody) {
                if referenced == root {
                    report("type alias '" + root + "' is recursive", tyconOf(t, root).span)
                    for s in Set.elements(inner) { Set.add(t.recursiveAliases, s) }
                    return True
                }
                if checkAliasAcyclic(t, root, referenced, inner) { return True }
            }
            False
        }
    }
}

-- -- translation --------------------------------------------------------------------

-- `toType`, where a type that classifies values is required.
--
-- Every annotation and every constructor field is such a position: `x : Array`
-- names a constructor, not a type, and nothing can have it. This is the check
-- that used to be an arity comparison, moved to the places that actually need
-- saturation -- `toType` itself no longer does, because a partially applied
-- constructor is exactly what a higher-kinded argument is made of.
fun star(t : DeclTable, te : Type, tyvars : Map String Ty.Type,
         fresh : Ty.Fresh) -> Ty.Type {
    let out = toType(t, te, tyvars, fresh)
    if !Ty.unifyKinds(Ty.kindOf(out), KStar) {
        report("'" + Ty.show(out) + "' has kind " + Ty.showKind(Ty.kindOf(out))
               + ", but a type of kind * is needed here", Some(te.span))
    }
    out
}

-- Translate type syntax into a semantic type.
--
-- `tyvars` maps annotation type-variable names to the types they stand for --
-- unification variables while a type is being inferred, and rigid skolem
-- constants while a body is being checked against a signature -- and is shared
-- across an entire function, so the `a` in a parameter and the `a` in a body
-- annotation are the same variable.
fun toType(t : DeclTable, te : Type, tyvars : Map String Ty.Type,
           fresh : Ty.Fresh) -> Ty.Type = match te.kind {
    TEVar(name) -> match Map.get(tyvars, name) {
        Some(found) -> found
        None -> {
            let made = TVar(fresh())
            Map.put(tyvars, name, made)
            made
        }
    }
    -- `()` is the unit type, as `()` is the unit value: the tuple of nothing.
    TETuple(elems) -> if len(elems) == 0 { Ty.tUnit() }
                      else { TTuple(Array.map(elems, toType(t, _, tyvars, fresh))) }
    TEFun(params, ret) -> TFun(
        Array.map(params, toType(t, _, tyvars, fresh)),
        toType(t, ret, tyvars, fresh))
    TEApp(fn, args) -> Ty.applyTo(
        toType(t, fn, tyvars, fresh),
        Array.map(args, toType(t, _, tyvars, fresh)),
        Some(te.span))
    TECon(name, args) -> {
        if Map.contains(t.families, name) {
            return family(t, te, name, args, tyvars, fresh)
        }
        -- A type reported here, or a recursive alias, is bottom. Bottom unifies
        -- with anything, and the kind and shape checks skip it.
        if Set.contains(t.recursiveAliases, name) { return TBottom }
        let info = match Map.get(t.tycons, name) {
            Some(i) -> i
            None -> {
                report("unknown type '" + name + "'", Some(te.span))
                return TBottom
            }
        }
        let resolved = Array.map(args, toType(t, _, tyvars, fresh))
        if info.isAlias {
            -- Aliases are transparent: expand rather than build a constructor.
            -- They must be *saturated* first. An alias is the one head that is
            -- not rigid, so a partially applied one would make `f a ~ g b`
            -- decomposition unsound -- and it is why type-level lambdas are out.
            -- Arguments beyond its parameters apply to the expansion, as a
            -- family's do; an expansion has kind `*`, so that is a kind error
            -- naming what the alias stands for, `Int Bool` saying `Int`.
            if len(resolved) < len(info.params) {
                report("type alias '" + name + "' needs "
                       + arguments(len(info.params)) + " but has "
                       + Int.toString(len(resolved)) + "; an alias "
                       + "cannot be partially applied", Some(te.span))
                return TBottom
            }
            let substitution = Map.new()
            for var i = 0; i < len(info.params); i = i + 1 {
                Map.put(substitution, info.params[i], resolved[i])
            }
            let expanded = expandAlias(t, info, substitution, fresh)
            if len(resolved) == len(info.params) { return expanded }
            Ty.applyTo(expanded, Array.slice(resolved, len(info.params), len(resolved)),
                       Some(te.span))
        } else {
            Ty.applyTo(head(t, name), resolved, Some(te.span))
        }
    }
}

-- `Elem c` -- a family application, which is not an application.
--
-- A family is saturated where it is written, for the same reason an alias is:
-- it is the one head that is not rigid, and `unify` decomposes an application
-- pointwise. Any further arguments *are* an ordinary application, of whatever
-- the family returns.
fun family(t : DeclTable, te : Type, name : String, args : Vec Type,
           tyvars : Map String Ty.Type, fresh : Ty.Fresh) -> Ty.Type {
    let fam = match Map.get(t.families, name) {
        Some(f) -> f
        None -> bug("unknown type family '" + name + "'", Some(te.span))
    }
    if len(args) == 0 {
        report("'" + name + "' is an associated type of class '" + fam.cls
               + "' and must be applied to a type", Some(te.span))
        return TBottom
    }
    let resolved = Array.map(args, toType(t, _, tyvars, fresh))
    if !Ty.isBottom(resolved[0]) && !Ty.unifyKinds(Ty.kindOf(resolved[0]), fam.argKind) {
        report("'" + Ty.show(resolved[0]) + "' has kind "
               + Ty.showKind(Ty.kindOf(resolved[0])) + ", but '" + name
               + "' expects an argument of kind " + Ty.showKind(fam.argKind),
               Some(te.span))
    }
    Ty.applyTo(TFam(name, resolved[0], fam.resKind),
               Array.slice(resolved, 1, len(resolved)), Some(te.span))
}

fun arguments(n : Int) -> String =
    if n == 1 { "1 argument" } else { Int.toString(n) + " arguments" }

fun expandAlias(t : DeclTable, info : TyconInfo, substitution : Map String Ty.Type,
                fresh : Ty.Fresh) -> Ty.Type =
    -- Bind the parameters to the arguments before converting the body, so that
    -- converting it never calls `fresh` for a parameter. A constructor payload
    -- is converted with a `fresh` that panics, because a payload may not
    -- introduce variables.
    match info.aliasBody {
        Some(b) -> toType(t, b, substitution, fresh)
        None -> bug("type alias '" + info.name + "' has no body", info.span)
    }

-- -- constructor helpers ------------------------------------------------------------

fun instantiateCon(t : DeclTable, name : String, fresh : Ty.Fresh,
                   where : Option Span) -> Ty.Type =
    match Map.get(t.constructors, name) {
        Some(info) -> Ty.instantiate(info.scheme, fresh)
        None -> {
            report("unknown constructor '" + name + "'", where)
            TBottom
        }
    }

fun con(t : DeclTable, name : String) -> Option ConInfo = Map.get(t.constructors, name)

-- -- record field lookup ------------------------------------------------------------

-- The named type's field names, or `None` if it is not a plain record.
fun recordFields(t : DeclTable, name : String) -> Option (Array String) =
    match Map.get(t.tycons, name) {
        None -> None
        Some(info) -> if isPlainRecord(info) { info.variants[0].fields } else { None }
    }

-- The named type's `var` fields, or `None` if it is not a plain record.
fun varFields(t : DeclTable, name : String) -> Option (Vec String) =
    match Map.get(t.tycons, name) {
        None -> None
        Some(info) -> if isPlainRecord(info) {
            let c = info.variants[0]
            let out = Vec.new(len(c.mutable))
            match c.fields {
                Some(names) -> for var i = 0; i < len(names); i = i + 1 {
                    if c.mutable[i] { Vec.push(out, names[i]) }
                }
                None -> {}
            }
            Some(out)
        } else {
            None
        }
    }

-- Where a plain record's field is declared.
fun fieldSpan(t : DeclTable, name : String, label : String) -> Option Span =
    match Map.get(t.tycons, name) {
        Some(info) -> if isPlainRecord(info) {
            let c = info.variants[0]
            match c.fields {
                Some(names) -> match Array.indexOf(names, label) {
                    Some(i) -> if i < len(c.fieldSpans) { Some(c.fieldSpans[i]) } else { None }
                    None -> None
                }
                None -> None
            }
        } else {
            None
        }
        None -> None
    }

-- The field names of a one-variant existential record, or None.
--
-- `recordFields` answers None for one of these, because an existential record
-- is not a plain record: assigning a field would let a hidden variable out,
-- and reading one has no type to read it at. But "not a single-variant record
-- type" is then the wrong thing to say, since it *is* one -- which is exactly
-- why it has a field worth asking about.
fun existentialFields(t : DeclTable, name : String) -> Option (Array String) =
    match Map.get(t.tycons, name) {
        None -> None
        Some(info) -> if len(info.variants) == 1
                         && len(info.variants[0].exists) > 0 {
            -- Already an `Option`: `None` is the positional form, which has no
            -- field to have been asked about in the first place.
            info.variants[0].fields
        } else {
            None
        }
    }

-- The type of `receiver.label`, for a receiver already resolved.
--
-- The receiver's arguments *are* the constructor's parameters, so substituting
-- them directly is exact. Instantiating the constructor's scheme and unifying
-- its result with the receiver -- which is what `HasField` solving would
-- otherwise do -- gives the same type but introduces fresh variables first, and
-- unification would then impose their level on the receiver's. Solving happens
-- after generation, at whatever level the solver has reached rather than the
-- one the field access was written at, so that level is not ours to impose.
fun fieldType(t : DeclTable, receiver : Ty.Type, label : String) -> Ty.Type {
    let (h, args) = Ty.spine(receiver)
    let name = match h {
        TCon(c) -> c.name
        _ -> bug("a field was read from something that is not a record", None)
    }
    let c = tyconOf(t, name).variants[0]
    match c.scheme.body {
        TFun(params, ret) -> {
            let mapping = paramMapping(ret, args)
            let index = match c.fields {
                Some(fs) -> match Array.indexOf(fs, label) {
                    Some(i) -> i
                    None -> bug("'" + name + "' has no field '" + label + "'", None)
                }
                None -> bug("'" + name + "' is not a record", None)
            }
            substitute(params[index], mapping)
        }
        _ -> bug("constructor '" + c.name + "' is not a function", None)
    }
}

-- The type names whose one constructor is not there at run time.
--
-- `type Vec a = Vec(VecStorage a)` gives its payload a name and a `match`
-- to get back out of, and nothing else: one variant, one field, and no way to
-- tell the wrapper from what it wraps. There is no function identity in Turkey
-- and no reflection, so a value of it *is* its payload, and the allocation is a
-- cost with no observable effect. Whether the field has a name changes none of
-- that: `type Meters = Meters { value : Float }` is erased as `Meters(Float)`
-- is.
--
-- An existential constructor is excluded too: its value is a packing, holding
-- the layouts of the types it hides and any dictionaries beside the field, and
-- its payload's type is a variable that means nothing outside an opening.
--
-- A field that can be assigned is excluded, and this is the reason there is a
-- rule rather than a check for one variant and one field: assigning through
-- two names for one box is exactly the identity that erasure would take away.
--
-- Recursion is excluded because it is what erasure cannot terminate on. A
-- wrapper is erased into its payload, so `type Loop = Loop(Loop)` has no
-- representation at all -- and the cycle need not be direct, since `A(B)`,
-- `B(C)`, `C(A)` is the same thing spread over three declarations. An edge is
-- drawn only where the payload's *head* is another candidate. A payload of
-- `Option B` is a variant type, whose layout may depend on `B`'s; where that
-- leads back to the newtype, `Turkey.Layout`'s unfolding finds the cycle and
-- holds the types on it boxed. One member of each cycle keeps its box -- the
-- first by name, as `Turkey.Opt`'s loop breaker picks one -- which is enough to
-- make the rest terminate.
fun newtypes(t : DeclTable) -> Set.Set String {
    match t.newtypeNames {
        Some(found) -> return found
        None -> {}
    }
    let candidates = Set.new()
    for (name, info) in Map.entries(t.tycons) {
        if len(info.variants) == 1 && !hasMutable(info.variants[0])
                && info.variants[0].arity == 1
                && len(info.variants[0].exists) == 0 {
            Set.add(candidates, name)
        }
    }
    let graph = Map.new()
    for name in Set.elements(candidates) {
        let deps = Set.new()
        match Ty.prune(t.tycons[name].variants[0].scheme.body) {
            TFun(params, _) -> if len(params) == 1 {
                let (h, _) = Ty.spine(params[0])
                match h {
                    TCon(c) -> if Set.contains(candidates, c.name) {
                        Set.add(deps, c.name)
                    }
                    _ -> {}
                }
            }
            _ -> {}
        }
        Map.put(graph, name, deps)
    }
    for component in Deps.sccs(graph) {
        let first = component[0]
        let successors = Map.getOr(graph, first, Set.new())
        if len(component) > 1 || Set.contains(successors, first) {
            discard(Set.remove(candidates, first))
        }
    }
    t.newtypeNames = Some(candidates)
    candidates
}

-- What `Turkey.Layout` needs of a declared type that may be flat, read once.
type FlatDecl = FlatDecl {
    -- The type's parameters, in order, by variable: what an application's
    -- arguments are substituted for.
    params : Array Int,
    -- Its constructors, in declaration order, and each one's field types.
    names  : Array String,
    fields : Array (Array Ty.Type),
    -- The payload constructor's index, if the type is a compact sum.
    compact : Option Int,
}

-- Returns whether a value of the declared type `tycon` may be held other than
-- as a pointer to an object of its own: a newtype's as its payload, and a
-- flat candidate's as its fields' slots where its layout allows.
fun mayBeFlat(t : DeclTable, tycon : String) -> Bool =
    Set.contains(newtypes(t), tycon) || Option.isSome(flatDecl(t, tycon))

-- Returns the facts about `tycon` if it is a candidate (`flatCandidates`).
fun flatDecl(t : DeclTable, tycon : String) -> Option FlatDecl =
    Map.get(flatCandidates(t), tycon)

-- Returns the declared types whose values may be held as their fields'
-- slots rather than as a pointer to an object: `Turkey.Layout.flatOf` decides
-- per instantiation, and considers only these. Computed once and cached; the
-- first call must not race another, so `Turkey.Layout.share` makes it before
-- anything runs in parallel.
--
-- A candidate has a constructor with a field, is neither an enumeration nor a
-- newtype, which have their own representations, and is immutable and not
-- existential: a copy of its value cannot be told from the original, which is
-- what lets its slots be copied freely. And it is not recursive: no type its
-- fields mention, at any depth of declarations, mentions it back. A recursive
-- type has values of every size, which slots cannot hold.
fun flatCandidates(t : DeclTable) -> Map String FlatDecl {
    match t.flatNames {
        Some(found) -> return found
        None -> {}
    }
    let erased = newtypes(t)
    let graph = Map.new()
    for (name, info) in Map.entries(t.tycons) {
        let deps = Set.new()
        for v in info.variants {
            match Ty.prune(v.scheme.body) {
                TFun(params, _) -> for p in params { mentionedInto(p, deps) }
                _ -> {}
            }
        }
        Map.put(graph, name, deps)
    }
    let recursive = Set.new()
    for component in Deps.sccs(graph) {
        let first = component[0]
        if len(component) > 1 || Set.contains(Map.getOr(graph, first, Set.new()), first) {
            for name in component { Set.add(recursive, name) }
        }
    }
    let out = Map.new()
    for (name, info) in Map.entries(t.tycons) {
        var carries = False
        var hidden = False
        for v in info.variants {
            if v.arity > 0 { carries = True }
            if len(v.exists) > 0 { hidden = True }
        }
        if carries && !hidden && !isMutable(info) && !Set.contains(erased, name)
                && !Set.contains(recursive, name) {
            Map.put(out, name, flatDeclOf(t, info))
        }
    }
    t.flatNames = Some(out)
    out
}

fun flatDeclOf(t : DeclTable, info : TyconInfo) -> FlatDecl {
    let params = match Ty.prune(info.variants[0].scheme.body) {
        TFun(_, ret) -> {
            let (_, args) = Ty.spine(ret)
            let ids = []
            for a in args {
                match Ty.prune(a) {
                    TVar(cell) -> Vec.push(ids, cell.id)
                    _ -> Vec.push(ids, -1)
                }
            }
            Vec.toArray(ids)
        }
        _ -> []
    }
    let fields = Array.map(Vec.toArray(info.variants), fun(v) = match Ty.prune(v.scheme.body) {
        TFun(ps, _) -> ps
        _ -> []
    })
    let names = Array.map(Vec.toArray(info.variants), _.name)
    let compact = match compactShape(t, info.name) {
        Some(c) -> Array.indexOf(names, c.payload)
        None -> None
    }
    FlatDecl { params = params, names = names, fields = fields, compact = compact }
}

-- Add every declared type constructor `ty` mentions to `out`.
fun mentionedInto(ty : Ty.Type, out : Set.Set String) -> Unit = match Ty.prune(ty) {
    TCon(c) -> Set.add(out, c.name)
    TApp(fn, arg, _) -> {
        mentionedInto(fn, out)
        mentionedInto(arg, out)
    }
    TFam(_, arg, _) -> mentionedInto(arg, out)
    TFun(params, ret) -> {
        for p in params { mentionedInto(p, out) }
        mentionedInto(ret, out)
    }
    TTuple(elems) -> for e in elems { mentionedInto(e, out) }
    _ -> {}
}

-- What a value of `receiver` really is, if its wrapper is erased.
fun erasedPayload(t : DeclTable, receiver : Ty.Type) -> Option Ty.Type {
    let (h, _) = Ty.spine(receiver)
    match h {
        TCon(c) -> if !Set.contains(newtypes(t), c.name) { return None }
        _ -> return None
    }
    payloadType(t, receiver, 0)
}

-- The field types of one *named* constructor, at a receiver already resolved.
--
-- `projectionTypes` answers the same question for the single-variant
-- positional case, where the constructor need not be named. A pattern names
-- one, and a multi-variant type has several, so the variant is a parameter
-- here rather than `variants[0]`. The substitution is the same one and for
-- the same reason: the constructor result's arguments *are* its type's
-- parameters, so pairing them with the receiver's is exact, where
-- instantiating and unifying would introduce fresh variables first.
-- `conFieldTypes`, with an existential's hidden variables bound to the rigid
-- constants the pattern opened.
fun conFieldTypesOpened(t : DeclTable, receiver : Ty.Type, name : String,
                        skolems : Array Ty.Type) -> Option (Array Ty.Type) {
    let (_, args) = Ty.spine(receiver)
    match Map.get(t.constructors, name) {
        None -> None
        Some(info) -> match info.scheme.body {
            TFun(params, ret) -> {
                let mapping = paramMapping(ret, args)
                for var i = 0; i < len(info.exists) && i < len(skolems); i = i + 1 {
                    Map.put(mapping, info.exists[i].id, skolems[i])
                }
                Some(Array.map(params, substitute(_, mapping)))
            }
            _ -> Some([])
        }
    }
}

fun conFieldTypes(t : DeclTable, receiver : Ty.Type,
                  name : String) -> Option (Array Ty.Type) {
    let (_, args) = Ty.spine(receiver)
    match Map.get(t.constructors, name) {
        None -> None
        Some(info) -> match info.scheme.body {
            TFun(params, ret) -> {
                let mapping = paramMapping(ret, args)
                Some(Array.map(params, substitute(_, mapping)))
            }
            _ -> Some([])
        }
    }
}

-- A sum whose constructors are nullary but for one, and that one positional
-- with a single field: `Option a`, `Data.Map`'s `Entry`. Where memory holds that
-- field at a traced pointer, a value of the sum is one word -- see
-- `Turkey.SsaLower`'s compact sums -- and elsewhere it is flat or an ordinary
-- object (`Turkey.Layout.flatOf`). Which a value is depends on the
-- instantiation, so code that builds or tests one at a type variable needs
-- that variable's layout.
--
-- Existential and record constructors disqualify a sum: a packed value carries
-- its layout codes, and a record has identity if a field is a `var`.
type Compact = Compact {
    -- In declaration order: a nullary's word is its index here.
    nullaries : Vec String,
    payload   : String,
}

-- The compact shape of the declared type `tycon`, if it has one. Fewer than
-- 4096 nullaries, which is the range of words a pointer never takes.
fun compactShape(t : DeclTable, tycon : String) -> Option Compact {
    let info = match Map.get(t.tycons, tycon) {
        Some(i) -> i
        None -> return None
    }
    let nullaries = []
    let carrying = []
    for v in info.variants {
        if isRecord(v) || len(v.exists) > 0 { return None }
        if v.arity == 0 { Vec.push(nullaries, v.name) }
        else if v.arity == 1 { Vec.push(carrying, v.name) }
        else { return None }
    }
    if len(nullaries) == 0 || len(nullaries) >= 4096 || len(carrying) != 1 {
        return None
    }
    Some(Compact { nullaries = nullaries, payload = carrying[0] })
}

-- How many constructors the declared type `tycon` has, if it is an
-- enumeration: a sum of at least one constructor, every one of them
-- positional, nullary and not existential. Type parameters do not matter, since
-- nothing of theirs is stored.
--
-- A value of an enumeration is its constructor's index in declaration order,
-- held untraced at the narrowest width that holds every index
-- (`Turkey.Layout.layoutOf`), and nothing is allocated for it. `Bool` is one by
-- this rule and no other: `False | True`, so one bit, `False` 0 and `True` 1.
fun enumSize(t : DeclTable, tycon : String) -> Option Int {
    let info = match Map.get(t.tycons, tycon) {
        Some(i) -> i
        None -> return None
    }
    if len(info.variants) == 0 { return None }
    for v in info.variants {
        if isRecord(v) || len(v.exists) > 0 || v.arity != 0 { return None }
    }
    Some(len(info.variants))
}

-- The index of the constructor `name`, if its type is an enumeration.
fun enumIndex(t : DeclTable, name : String) -> Option Int {
    let info = match Map.get(t.constructors, name) {
        Some(i) -> i
        None -> return None
    }
    if Option.isNone(enumSize(t, info.tycon)) { return None }
    let variants = match Map.get(t.tycons, info.tycon) {
        Some(tycon) -> tycon.variants
        None -> return None
    }
    for var i = 0; i < len(variants); i = i + 1 {
        if variants[i].name == name { return Some(i) }
    }
    None
}

-- The compact shape of the type the constructor `name` belongs to.
fun compactOf(t : DeclTable, name : String) -> Option Compact =
    match Map.get(t.constructors, name) {
        Some(info) -> compactShape(t, info.tycon)
        None -> None
    }

-- How many variants the constructor's type has. One means there is nothing to
-- distinguish and a pattern needs no tag test.
fun variantCount(t : DeclTable, name : String) -> Int =
    match Map.get(t.constructors, name) {
        None -> 0
        Some(info) -> match Map.get(t.tycons, info.tycon) {
            None -> 0
            Some(tycon) -> len(tycon.variants)
        }
    }

-- The element types `.0`, `.1`, ... may read from a single-variant type: its
-- payload, unless its fields are named, which a program reads by name.
fun projectionTypes(t : DeclTable, receiver : Ty.Type) -> Option (Array Ty.Type) {
    let (h, _) = Ty.spine(receiver)
    match h {
        TCon(c) -> match Map.get(t.tycons, c.name) {
            Some(info) -> if len(info.variants) == 1 && isRecord(info.variants[0]) {
                return None
            }
            None -> return None
        }
        _ -> return None
    }
    payloadTypes(t, receiver)
}

-- The field types of a single-variant type's one constructor at `receiver`,
-- by position, whether its fields are named or not: what a position in its
-- object holds.
fun payloadTypes(t : DeclTable, receiver : Ty.Type) -> Option (Array Ty.Type) {
    let (h, args) = Ty.spine(receiver)
    match h {
        TCon(c) -> match Map.get(t.tycons, c.name) {
            None -> None
            Some(info) -> {
                if len(info.variants) != 1 { return None }
                match info.variants[0].scheme.body {
                    TFun(params, ret) -> {
                        let mapping = paramMapping(ret, args)
                        Some(Array.map(params, substitute(_, mapping)))
                    }
                    _ -> None
                }
            }
        }
        _ -> None
    }
}

-- One position of `payloadTypes`, without substituting into the others.
fun payloadType(t : DeclTable, receiver : Ty.Type, index : Int) -> Option Ty.Type {
    let (h, args) = Ty.spine(receiver)
    let info = match h {
        TCon(c) -> Map.get(t.tycons, c.name)?
        _ -> return None
    }
    if len(info.variants) != 1 { return None }
    match info.variants[0].scheme.body {
        TFun(params, ret) -> if index < len(params) {
            Some(substitute(params[index], paramMapping(ret, args)))
        } else {
            None
        }
        _ -> None
    }
}

-- The constructor result's spine arguments are its type's parameters, in order,
-- so pairing them with the receiver's arguments is the substitution.
fun paramMapping(ret : Ty.Type, args : Array Ty.Type) -> Map Int Ty.Type {
    let (_, params) = Ty.spine(ret)
    let mapping = Map.new()
    var i = 0
    while i < len(params) && i < len(args) {
        match params[i] {
            TVar(cell) -> Map.put(mapping, cell.id, args[i])
            _ -> {}
        }
        i = i + 1
    }
    mapping
}

fun substitute(t : Ty.Type, mapping : Map Int Ty.Type) -> Ty.Type = match Ty.prune(t) {
    TVar(cell) -> Map.getOr(mapping, cell.id, TVar(cell))
    TApp(fn, arg, k) -> TApp(substitute(fn, mapping), substitute(arg, mapping), k)
    TFam(name, arg, k) -> TFam(name, substitute(arg, mapping), k)
    TFun(params, ret) -> TFun(Array.map(params, substitute(_, mapping)),
                              substitute(ret, mapping))
    TTuple(elems) -> TTuple(Array.map(elems, substitute(_, mapping)))
    _ -> Ty.prune(t)
}

-- -- walks over type syntax ---------------------------------------------------------

fun referencedTycons(te : Option Type) -> Vec String {
    let out = Vec.new(4)
    match te {
        Some(t) -> referencedInto(t, out)
        None -> {}
    }
    out
}

fun referencedInto(te : Type, out : Vec String) -> Unit = match te.kind {
    TECon(name, args) -> {
        Vec.push(out, name)
        for a in args { referencedInto(a, out) }
    }
    TEApp(fn, args) -> {
        referencedInto(fn, out)
        for a in args { referencedInto(a, out) }
    }
    TETuple(elems) -> for e in elems { referencedInto(e, out) }
    TEFun(params, ret) -> {
        for p in params { referencedInto(p, out) }
        referencedInto(ret, out)
    }
    TEVar(_) -> {}
}

-- The variables a constructor's bracket binds, in a fixed order: its bare
-- variables as written, then those its class predicates mention, first
-- occurrence first.
fun hiddenVariables(c : ConDecl) -> Vec String {
    let out = Vec.new(2)
    let seen = Set.new()
    for b in c.binders {
        if !Set.contains(seen, b) {
            Set.add(seen, b)
            Vec.push(out, b)
        }
    }
    for p in c.context {
        match p.kind {
            PClass(_, argTe) -> for v in typeVariables(argTe) {
                match v.kind {
                    TEVar(name) -> if !Set.contains(seen, name) {
                        Set.add(seen, name)
                        Vec.push(out, name)
                    }
                    _ -> {}
                }
            }
            _ -> {}
        }
    }
    out
}

fun conTypes(c : ConDecl) -> Vec Type = match c.fields {
    Some(fs) -> Vec.map(fs, _.1)
    None -> c.args
}

fun typeVariables(te : Type) -> Vec Type {
    let out = Vec.new(4)
    typeVariablesInto(te, out)
    out
}

fun typeVariablesInto(te : Type, out : Vec Type) -> Unit = match te.kind {
    TEVar(_) -> Vec.push(out, te)
    TETuple(elems) -> for e in elems { typeVariablesInto(e, out) }
    TEFun(params, ret) -> {
        for p in params { typeVariablesInto(p, out) }
        typeVariablesInto(ret, out)
    }
    TEApp(fn, args) -> {
        typeVariablesInto(fn, out)
        for a in args { typeVariablesInto(a, out) }
    }
    TECon(_, args) -> for a in args { typeVariablesInto(a, out) }
}

-- A constructor field mentioning a variable the header did not declare is
-- caught before any of this runs, so reaching here is a bug rather than a
-- program's mistake.
fun undeclared() -> VarCell =
    bug("type declaration validation missed an undeclared variable", None)

-- Reports a type error and returns, for a check that can skip what it was
-- checking and carry on. Registration goes on past an error so that every
-- declaration reports, and the generator stops once it is done.
fun report(message : String, where : Option Span) -> Unit = match where {
    None -> Diag.report(Diag.whole("type error", message))
    Some(s) -> Diag.report(Diag.at("type error", message, s))
}

-- A check only a compiler bug can fail, so it is not reported as the
-- program's fault.
fun bug(message : String, where : Option Span) -> a = match where {
    None -> Diag.fail(Diag.whole("internal error", message), "")
    Some(s) -> Diag.fail(Diag.at("internal error", message, s), s.file)
}

fun discard(x : a) -> Unit = {}

-- -- the dump -----------------------------------------------------------------------

-- The declaration table, one line per entity, in registration order. The
-- milestone's diff target: it is where a kind, a generalization and the
-- qualified-name rule all become something two implementations can disagree
-- about in writing.
fun showDeclarations(t : DeclTable) -> String {
    let b = String.builder()
    for name in t.order {
        let info = tyconOf(t, name)
        String.push(b, "type " + name)
        for p in info.params { String.push(b, " " + p) }
        String.push(b, " :: " + Ty.showKind(info.kind))
        if info.isAlias { String.push(b, " = alias") }
        String.push(b, "\n")
        for c in info.variants {
            String.push(b, "  con " + c.name + "/" + Int.toString(c.arity))
            match c.fields {
                Some(fs) -> String.push(b, " {" + String.join(fs, ", ") + "}")
                None -> {}
            }
            String.push(b, " : " + Ty.showScheme(c.scheme) + "\n")
        }
    }
    String.build(b)
}
