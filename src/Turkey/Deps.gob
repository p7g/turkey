export (references, sccs, components)

--- Dependency analysis over trees.
---
--- Two entry points: the binders a statement references, and Tarjan's
--- strongly-connected components emitted dependencies-first. Between them they
--- decide what a binding group is, which is what generalization is quantified
--- over.

import Data.Set as Set
import Turkey.Ast (..)
import Turkey.Binders as Binders

-- -- references ---------------------------------------------------------------------

--- Returns the ids of the binders `s` references, as the side table `t`
--- records them: every `EVar` and every method reference resolution wrote.
--- A binder `s` binds and also references is included, which is how a caller
--- tells a recursive definition. A binder bound inside `s` may be included
--- too: its id names no binder outside `s`, so a caller that looks ids up
--- among the binders it cares about needs no scoping to discard it. An `EVar`
--- left for inference to report has no id and is skipped.
fun references(t : Binders.Table, s : Stmt) -> Set.Set Int {
    let out = Set.new()
    for child in children(ChStmt(s)) { collect(t, child, out) }
    out
}

fun collect(t : Binders.Table, c : Child, out : Set.Set Int) -> Unit {
    if let ChExpr(e) = c {
        if let EVar(_, _) = e.kind {
            if let Some(id) = Map.get(t.refs, e.id) { Set.add(out, id) }
        }
        for ref in Binders.methodRefs(e) { collect(t, ChExpr(ref), out) }
    }
    for child in children(c) { collect(t, child, out) }
}

-- -- strongly-connected components --------------------------------------------------

type Frame = Frame {
    node   : String,
    succs  : Array String,
    var at : Int,
}

type Tarjan = Tarjan {
    indexOf     : Map String Int,
    lowlink     : Map String Int,
    onStack     : Map String Bool,
    stack       : Vec String,
    successors  : fun(String) -> Array String,
    emit        : fun(Vec String) -> Unit,
    var counter : Int,
}

--- The strongly-connected components of `graph`, which maps a name to the names
--- it depends on. Edges to names that are not keys of `graph` are ignored.
--- Components come out dependencies-first: if A depends on B, B is emitted
--- first. Names within a component are sorted, and so are the successors of
--- each node, because the order components come out in is the order bindings
--- are checked and then evaluated -- it has to be a property of the program
--- rather than of the host's iteration order.
fun sccs(graph : Map String (Set.Set String)) -> Vec (Vec String) {
    let result = Vec.new(8)
    let starts = Vec.new(len(graph))
    for (start, _) in Map.entries(graph) { Vec.push(starts, start) }
    components(Vec.toArray(starts), successors(graph, _),
               fun(component) = Vec.push(result, Vec.sort(component)))
    result
}

--- Tarjan's algorithm, iterative, over a graph found as it is walked.
---
--- The walk starts from each of `starts` not yet reached, in order, and follows
--- a node's successors in the order `successors` lists them. `successors` is
--- asked once for each node, when the walk first reaches it, so a caller can
--- discover the graph -- read the node -- right then. `emit` is called with
--- each component as soon as it is finished, dependencies first, its nodes in
--- the order the walk reached them; every component it depends on has been
--- emitted already, and none after it has been reached yet.
fun components(starts : Array String, successors : fun(String) -> Array String,
               emit : fun(Vec String) -> Unit) -> Unit {
    -- Iterative because the graph can be as deep as a module has bindings. A
    -- frame carries its successor list and how far it has got, since there is
    -- no way to suspend a `for` loop and resume it.
    let t = Tarjan {
        indexOf = Map.new(), lowlink = Map.new(), onStack = Map.new(),
        stack = Vec.new(8), successors = successors, emit = emit, counter = 0,
    }
    for start in starts {
        if !Map.contains(t.indexOf, start) { visit(t, start) }
    }
}

fun visit(t : Tarjan, start : String) -> Unit {
    let work = Vec.new(8)
    Vec.push(work, enter(t, start))
    while len(work) > 0 {
        let frame = work[len(work) - 1]
        var descended = False
        while frame.at < len(frame.succs) && !descended {
            let succ = frame.succs[frame.at]
            frame.at = frame.at + 1
            if !Map.contains(t.indexOf, succ) {
                Vec.push(work, enter(t, succ))
                descended = True
            } else if Map.getOr(t.onStack, succ, False) {
                let seen = Map.getOr(t.indexOf, succ, 0)
                if seen < Map.getOr(t.lowlink, frame.node, 0) {
                    Map.put(t.lowlink, frame.node, seen)
                }
            }
        }
        if !descended {
            discard(Vec.pop(work))
            close(t, frame.node)
            if len(work) > 0 {
                let parent = work[len(work) - 1].node
                let mine = Map.getOr(t.lowlink, frame.node, 0)
                if mine < Map.getOr(t.lowlink, parent, 0) {
                    Map.put(t.lowlink, parent, mine)
                }
            }
        }
    }
}

-- Number a node, then ask for its successors.
fun enter(t : Tarjan, name : String) -> Frame {
    Map.put(t.indexOf, name, t.counter)
    Map.put(t.lowlink, name, t.counter)
    t.counter = t.counter + 1
    Vec.push(t.stack, name)
    Map.put(t.onStack, name, True)
    Frame { node = name, succs = t.successors(name), at = 0 }
}

fun close(t : Tarjan, node : String) -> Unit {
    if Map.getOr(t.lowlink, node, 0) != Map.getOr(t.indexOf, node, 0) { return {} }
    let component = Vec.new(2)
    var going = True
    while going {
        match Vec.pop(t.stack) {
            None -> { going = False }
            Some(w) -> {
                Map.put(t.onStack, w, False)
                Vec.push(component, w)
                if w == node { going = False }
            }
        }
    }
    t.emit(Vec.reverse(component))
}

fun successors(graph : Map String (Set.Set String), name : String) -> Array String =
    match Map.get(graph, name) {
        Some(s) -> Array.filter(Array.sort(Set.elements(s)), Map.contains(graph, _))
        None -> []
    }

fun discard(x : a) -> Unit = {}
