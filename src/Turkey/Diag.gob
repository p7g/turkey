export (
    Diag(..), Severity(..), at, whole, warningAt, render, fail, short, compiling,
    report, beginUnit, endUnit, beginMuted, endMuted, beginHeld, endHeld, hasErrors, errorCount, stopOnErrors,
    stopCollecting,
)

--- A diagnostic is a value.
---
--- Turkey has no exceptions, so a stage cannot stop part way through a unit of
--- work and unwind to the next one. Instead a site that finds an error
--- `report`s it and carries on with a harmless answer, and the driver decides,
--- at the end of each stage, whether to go on (`stopOnErrors`). `fail` is the
--- older way, and stays for the sites that cannot carry on: it prints what has
--- been reported, renders its own diagnostic and exits.
---
--- One rendering, `file:line:col: stage: message`, and every diagnostic uses it.

import System.Env as Env
import System.IO as IO
import Turkey.Source (Span(..), generated, isGenerated, outermost, showSpan)

--- An `Error` stops the compile at the end of the stage that reports it. A
--- `Warning` is printed and stops nothing.
type Severity = Error | Warning

type Diag = Diag {
    stage    : String,
    message  : String,
    span     : Option Span,
    severity : Severity,
}

--- Both constructors shorten the message here rather than leaving it to the
--- raising site, so that every diagnostic is shortened and not only the ones
--- whose author remembered to. A site that forgets says `Main#Named` to someone
--- who wrote `Named`.
---
--- Both also name the outermost call inlined code came through, because a
--- diagnostic is about the function the code runs in, and the callee's own
--- text is in another function and perhaps another file.
fun at(stage : String, message : String, where : Span) -> Diag = Diag {
    stage = stage, message = short(message), span = placed(where), severity = Error,
}

--- A diagnostic about a whole file rather than a place in it: a file that cannot
--- be read has no line to point at.
fun whole(stage : String, message : String) -> Diag =
    Diag { stage = stage, message = short(message), span = None, severity = Error }

fun warningAt(message : String, where : Span) -> Diag = Diag {
    stage = "warning", message = short(message), span = placed(where), severity = Warning,
}

-- Returns where a diagnostic at `where` points. A generated span points at no
-- text, so a diagnostic there is about the whole file, rather than printed at
-- `<generated>:0:0`, a place no reader can open. Generated code inlined into
-- a caller still points at the call.
fun placed(where : Span) -> Option Span {
    let s = outermost(where)
    if isGenerated(s) { None } else { Some(s) }
}

fun render(d : Diag, filename : String) -> String = match d.span {
    None -> filename + ": " + d.stage + ": " + d.message
    Some(where) ->
        where.file + ":" + showSpan(where) + ": " + d.stage + ": " + d.message
}

-- The file the driver was asked to compile, for a diagnostic that has no span
-- and whose raiser did not know the file either -- an import cycle, a missing
-- module. Such a diagnostic is rendered where it is raised, so without this it
-- would print `: type error: ...` with nothing before the colon.
var entryFile = ""

fun compiling(path : String) -> Unit {
    entryFile = path
}

-- -- the collector --------------------------------------------------------------------
--
-- One for the process, as `entryFile` is. That is safe because it collects
-- only while the front end runs, and the front end runs on one thread. The
-- driver calls `stopCollecting` once the program is checked: the stages after
-- it run on workers, and a site they share with the front end that reports an
-- error then ends the compile, as `fail` does, instead of leaving it in a
-- collector nothing would print.

-- What has been reported and not yet printed, in the order it was reported.
var collected : Vec Diag = []

-- Whether an error has been reported, and how many have been kept.
var errorSeen = False
var errorsKept = 0

-- Whether `report` collects, or ends the compile on an error.
var collecting = True

-- How many muted stretches are open (`beginMuted`).
var muted = 0

-- The errors `report` holds back instead of recording, while `beginHeld` is
-- in force, for a caller to report later or not at all.
var held : Option (Vec Diag) = None

-- How deep the current unit is, and whether it has reported an error. Only the
-- outermost unit counts.
var unitDepth = 0
var unitFailed = False

--- Records `d`, to be printed by the next `stopOnErrors` or `fail`. After
--- `stopCollecting`, an error ends the compile at once instead.
---
--- Inside a unit that has already reported an error, a further error is
--- dropped: the unit is abandoned in all but name, and what it reports after
--- its first error is most often that error seen again from another use.
fun report(d : Diag) -> Unit {
    if muted > 0 { return }
    if let Some(errors) = held {
        if let Error = d.severity { Vec.push(errors, d) }
        return
    }
    if let Error = d.severity {
        if !collecting { fail(d, "") }
        if unitFailed { return }
        if unitDepth > 0 { unitFailed = True }
        errorSeen = True
        errorsKept = errorsKept + 1
    }
    Vec.push(collected, d)
}

--- Starts a unit: the stretch of work whose errors after the first are dropped.
fun beginUnit() -> Unit {
    if unitDepth == 0 { unitFailed = False }
    unitDepth = unitDepth + 1
}

--- Ends the unit `beginUnit` started, and returns whether it reported an error.
fun endUnit() -> Bool {
    unitDepth = unitDepth - 1
    let failed = unitFailed
    if unitDepth == 0 { unitFailed = False }
    failed
}

--- Starts a stretch whose diagnostics are dropped until the matching
--- `endMuted`: code that can never run, or a solve whose outcome its caller
--- reports in its own words. Stretches nest.
fun beginMuted() -> Unit {
    muted = muted + 1
}

--- Ends the stretch `beginMuted` started.
fun endMuted() -> Unit {
    muted = muted - 1
}

--- Starts a stretch whose errors are held back rather than reported, until
--- the matching `endHeld`, and whose warnings are dropped. Stretches do not
--- nest.
fun beginHeld() -> Unit {
    held = Some([])
}

--- Ends the stretch `beginHeld` started, and returns the errors it held back.
fun endHeld() -> Vec Diag {
    let out = match held {
        Some(errors) -> errors
        None -> []
    }
    held = None
    out
}

--- Returns whether an error has been reported.
fun hasErrors() -> Bool = errorSeen

--- Returns how many errors `report` has kept.
fun errorCount() -> Int = errorsKept

--- Makes `report` end the compile on an error from now on, as `fail` does.
fun stopCollecting() -> Unit {
    collecting = False
}

--- Prints what has been reported, in source order, to stderr. Exits with status
--- 1 if any of it was an error, and returns otherwise.
fun stopOnErrors() -> Unit {
    printCollected()
    if errorSeen { Env.exit(1) }
}

fun printCollected() -> Unit {
    -- Sorted by place, and stably, so two reports at one place keep their order.
    let ordered = Vec.sortByKey(collected, fun(d) = match d.span {
        Some(s) -> (s.file, (s.line, s.col))
        None -> ("", (0, 0))
    })
    for d in ordered { let _ = IO.writeText(IO.stderr(), render(d, entryFile) + "\n") }
    Vec.clear(collected)
}

--- Prints what has been reported, then `d`, and exits.
---
--- `d` is left out when an error has already been reported in the current
--- unit, as `report` would leave it out. So is an internal error once any
--- error has been reported: the stage went on past that error with a harmless
--- answer in its place, and we assume a check that fails afterwards is failing
--- on that answer, not on a bug of its own.
---
--- Diverges, so it may be used where a value is expected.
fun fail(d : Diag, filename : String) -> a {
    printCollected()
    let cascade = unitFailed || (errorSeen && d.stage == "internal error")
    if !cascade {
        let name = if filename == "" || filename == generated().file { entryFile }
                   else { filename }
        let _ = IO.writeText(IO.stderr(), render(d, name) + "\n")
    }
    Env.exit(1)
}

--- A message with every internal name written the way the author wrote it.
---
--- `Module#name` is what module resolution calls a top-level binding. No
--- diagnostic should say it: the author wrote `f`, not `Main#f`, and which
--- module a name came from is not news to them. The rule is to drop any run
--- matching `[A-Za-z_][A-Za-z0-9_.]*#`, scanned by hand for want of a regex
--- engine.
fun short(text : String) -> String {
    let out = String.builder()
    -- The run of characters that could be the prefix of an internal name, held
    -- back until the next one says whether a `#` follows.
    let pending = Vec.new(16)
    for c in String.codePoints(text) {
        if c == '#' && len(pending) > 0 {
            -- The run was a module qualification. Drop it and the `#` with it.
            Vec.clear(pending)
        } else if len(pending) > 0 && isNameRest(c) {
            Vec.push(pending, c)
        } else {
            flush(out, pending)
            if isNameStart(c) { Vec.push(pending, c) }
            else { String.push(out, Char.toString(c)) }
        }
    }
    flush(out, pending)
    String.build(out)
}

fun flush(out : String.Builder, pending : Vec Char) -> Unit {
    if len(pending) == 0 { return {} }
    String.push(out, String.fromCodePoints(pending))
    Vec.clear(pending)
}

fun isNameStart(c : Char) -> Bool = Char.isAsciiAlpha(c) || c == '_'

fun isNameRest(c : Char) -> Bool =
    Char.isAsciiAlphanumeric(c) || c == '_' || c == '.'

