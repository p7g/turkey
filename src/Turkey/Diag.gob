module Turkey.Diag (Diag(..), at, whole, render, fail, short, compiling)

-- A diagnostic is a value.
--
-- Turkey has no exceptions, so a stage that cannot continue answers with a
-- record rather than raising. `fail` is the one exception, deliberately: it
-- renders and exits, which keeps the lexer from threading a result type through
-- every character for an error that ends the compile anyway.
--
-- One rendering, `file:line:col: stage: message`, and every diagnostic uses it.

import System.Env as Env
import System.IO as IO
import Turkey.Source (Span, showSpan)

type Diag = Diag {
    stage   : String,
    message : String,
    span    : Option Span,
}

-- Both constructors shorten the message here rather than leaving it to the
-- raising site, so that every diagnostic is shortened and not only the ones
-- whose author remembered to. A site that forgets says `Main#Named` to someone
-- who wrote `Named`.
fun at(stage : String, message : String, where : Span) -> Diag =
    Diag { stage = stage, message = short(message), span = Some(where) }

-- A diagnostic about a whole file rather than a place in it: a file that cannot
-- be read has no line to point at.
fun whole(stage : String, message : String) -> Diag =
    Diag { stage = stage, message = short(message), span = None }

fun render(d : Diag, filename : String) -> String = match d.span {
    None -> filename + ": " + d.stage + ": " + d.message
    Some(where) ->
        where.file + ":" + showSpan(where) + ": " + d.stage + ": " + d.message
}

-- The file the driver was asked to compile, for a diagnostic that has no span
-- and whose raiser did not know the file either -- an import cycle, a missing
-- module. Such a diagnostic is rendered where it is raised, so without this it
-- would print `: type error: ...` with nothing before the colon.
var entryFile = ""

fun compiling(path : String) -> Unit {
    entryFile = path
}

-- Diverges, so it may be used where a value is expected.
fun fail(d : Diag, filename : String) -> a {
    let name = if filename == "" { entryFile } else { filename }
    IO.stderr(render(d, name) + "\n")
    Env.exit(1)
}

-- A message with every internal name written the way the author wrote it.
--
-- `Module#name` is what module resolution calls a top-level binding. No
-- diagnostic should say it: the author wrote `f`, not `Main#f`, and which
-- module a name came from is not news to them. The rule is to drop any run
-- matching `[A-Za-z_][A-Za-z0-9_.]*#`, scanned by hand for want of a regex
-- engine.
fun short(text : String) -> String {
    let out = String.builder()
    -- The run of characters that could be the prefix of an internal name, held
    -- back until the next one says whether a `#` follows.
    let pending = Array.new(16)
    for c in String.codePoints(text) {
        if c == '#' && len(pending) > 0 {
            -- The run was a module qualification. Drop it and the `#` with it.
            Array.clear(pending)
        } else if len(pending) > 0 && isNameRest(c) {
            Array.push(pending, c)
        } else {
            flush(out, pending)
            if isNameStart(c) { Array.push(pending, c) }
            else { String.push(out, Char.toString(c)) }
        }
    }
    flush(out, pending)
    String.build(out)
}

fun flush(out : String.Builder, pending : Array Char) -> Unit {
    if len(pending) == 0 { return {} }
    String.push(out, String.fromCodePoints(pending))
    Array.clear(pending)
}

fun isNameStart(c : Char) -> Bool = Char.isAsciiAlpha(c) || c == '_'

fun isNameRest(c : Char) -> Bool =
    Char.isAsciiAlphanumeric(c) || c == '_' || c == '.'

