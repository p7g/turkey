export (Run(..), isDoc, runs, targets, firstDeclLine, moduleRun, text)

-- Doc comments: which comments document something, and what.
--
-- A doc comment is a line comment that begins with exactly `---` and then a
-- space or the end of the line. So a `----` rule or a `-- -- section --`
-- header is an ordinary comment, and a block comment never documents
-- anything. Doc comments on consecutive lines, each standing alone on its
-- line, are one run, and a run documents what starts on the line directly
-- after it: a top-level declaration, an instance, a class's method or
-- associated type, or a constructor or record field. The module's own
-- comment is the first run before its first declaration that is not directly
-- above that declaration.
--
-- Any other doc comment documents nothing. It is an ordinary comment, and
-- nothing reports it.

import Data.Set as Set
import Turkey.Ast (Type as _, Pred as _, ..)
import Turkey.Source as Source
import Turkey.Source (Span(..))
import Turkey.Token (Comment(..))

-- Doc comments on consecutive lines, each alone on its line; or a single doc
-- comment that follows code on its line, which is `trailing`.
type Run = Run {
    span     : Span,
    comments : Vec Comment,
    trailing : Bool,
}

-- Returns whether `c` is a doc comment.
fun isDoc(c : Comment) -> Bool {
    if c.block { return False }
    match String.stripPrefix(c.text, "---") {
        Some(rest) -> String.isEmpty(String.trimEnd(rest)) || String.startsWith(rest, " ")
        None -> False
    }
}

-- Returns the doc comments among `comments`, the comments of the file whose
-- text is `source`, grouped into runs in source order. Reads `source` only
-- when there is a doc comment.
fun runs(comments : Vec Comment, source : String) -> Vec Run {
    let docs = Vec.filter(comments, isDoc)
    if len(docs) == 0 { return [] }
    let lines = String.lines(source)
    let out = []
    for c in docs {
        let alone = standsAlone(c, lines)
        let extends = match Vec.last(out) {
            Some(r) -> alone && !r.trailing && r.span.endLine == c.span.line - 1
            None -> False
        }
        if extends {
            let r = out[len(out) - 1]
            Vec.push(r.comments, c)
            out[len(out) - 1] = Run { span = Source.through(r.span, c.span),
                                      comments = r.comments, trailing = False }
        } else {
            Vec.push(out, Run { span = c.span, comments = [c], trailing = !alone })
        }
    }
    out
}

-- Whether only spaces come before `c` on its line. A line comment runs to
-- the end of its line, so nothing comes after it.
fun standsAlone(c : Comment, lines : Vec String) -> Bool {
    let line = if c.span.line <= len(lines) { lines[c.span.line - 1] } else { "" }
    var i = 1
    for ch in String.codePoints(line) {
        if i >= c.span.col { break }
        if ch != ' ' && ch != '\t' { return False }
        i = i + 1
    }
    True
}

-- Returns the run's text: each comment without `---` and one space after it.
fun text(r : Run) -> String {
    let lines = []
    for c in r.comments {
        let body = Option.unwrapOr(String.stripPrefix(c.text, "---"), c.text)
        Vec.push(lines, String.trimEnd(Option.unwrapOr(String.stripPrefix(body, " "), body)))
    }
    String.join(lines, "\n")
}

-- Returns the lines a run may end directly above: where each top-level
-- declaration, class method and associated type, constructor and record
-- field the program writes begins.
fun targets(program : Program) -> Set.Set Int {
    let out = Set.new()
    let add = fun(s : Span) {
        if !Source.isGenerated(s) && !Source.isEmpty(s) { Set.add(out, s.line) }
    }
    for d in program.decls {
        match d {
            DStmt(s) -> add(s.span)
            DType(td) -> {
                add(td.span)
                for c in Option.unwrapOr(td.variants, []) {
                    add(c.span)
                    for f in c.fieldSpans { add(f) }
                }
            }
            DClass(c) -> {
                add(c.span)
                for m in c.methods { add(m.span) }
                for f in c.families { add(f.span) }
            }
            DInstance(i) -> add(i.span)
            DForeign(f) -> add(f.span)
            DInfix(op) -> add(op.span)
        }
    }
    out
}

-- Returns the line the program's first declaration begins on, leaving out
-- any the compiler wrote.
fun firstDeclLine(program : Program) -> Option Int {
    var first = None
    for d in program.decls {
        let s = match d {
            DStmt(st) -> st.span
            DType(td) -> td.span
            DClass(c) -> c.span
            DInstance(i) -> i.span
            DForeign(f) -> f.span
            DInfix(op) -> op.span
        }
        if Source.isGenerated(s) || Source.isEmpty(s) { continue }
        first = match first {
            Some(line) -> Some(if s.line < line { s.line } else { line })
            None -> Some(s.line)
        }
    }
    first
}

-- Returns the module's comment: the first run that ends before `first`, the
-- line of the first declaration, and is not directly above it or any other
-- of `targets`.
fun moduleRun(all : Vec Run, targets : Set.Set Int, first : Option Int) -> Option Run {
    for r in all {
        if r.trailing || Set.contains(targets, r.span.endLine + 1) { continue }
        let before = match first {
            Some(line) -> r.span.endLine < line
            None -> True
        }
        return if before { Some(r) } else { None }
    }
    None
}
