export (objectFile)

-- An assembled arm64 module as an ELF relocatable object (`ET_REL`), which
-- the system linker links as it would the assembler's.
--
-- The file is a header, the sections' bytes, a relocation section for each
-- section that has relocations, the symbol table and its strings, the section
-- names, and last the section headers.
--
-- **Symbols.** Every named symbol defined here is in the table -- exported
-- ones as global, the rest as local -- so that `nm` and `perf` name every
-- function. A temporary label never is: a relocation that refers to one
-- refers instead to its section's symbol, with the label's offset in the
-- section as the addend, which an ELF relocation carries in the record. So
-- does an offset from one debug section into another, whatever its target:
-- the linker joins each debug section's pieces from every object, and the
-- offset has to move with its piece.
--
-- The panic messages and the string literals are two sections that are both
-- called `.rodata`; the linker gathers input sections by name, so they end up
-- in one output section as they would from one input section. Neither is
-- marked mergeable: a panic message is the program's own text and may contain
-- a zero byte.

import Turkey.Asm as Asm
import Turkey.Asm (Symbol, SymbolKind(..))
import Turkey.Assembler (Object(..), Relocation(..), Use(..), Definition(..), SectionData(..))
import Turkey.Arm64.Encode (Fixup(..))

let headerSize = 64
let sectionHeaderSize = 64
let symbolSize = 24
let relocationSize = 24

-- Section types and flags.
let progbits = 1
let symtab = 2
let strtab = 3
let rela = 4
let allocated = 0x2
let writable = 0x1
let executable = 0x4
let infoLink = 0x40

fun names(kind : Asm.Section) -> (String, Int) = match kind {
    Asm.Text -> (".text", allocated + executable)
    Asm.CStrings -> (".rodata", allocated)
    Asm.Constants -> (".rodata", allocated)
    Asm.Data -> (".data", allocated + writable)
    -- Writable while the dynamic linker relocates it, as the assembly's
    -- `.data.rel.ro` is.
    Asm.Relocated -> (".data.rel.ro", allocated + writable)
    -- Not allocated: nothing loads debug information.
    Asm.DebugAbbrev -> (".debug_abbrev", 0)
    Asm.DebugInfo -> (".debug_info", 0)
    Asm.DebugStr -> (".debug_str", 0)
    Asm.DebugLine -> (".debug_line", 0)
    Asm.DebugLineStr -> (".debug_line_str", 0)
    Asm.DebugAddr -> (".debug_addr", 0)
    Asm.DebugRnglists -> (".debug_rnglists", 0)
    Asm.DebugLoclists -> (".debug_loclists", 0)
    Asm.EhFrame -> (".eh_frame", allocated)
    Asm.CompactUnwind -> error("internal error: ELF has no compact unwind section")
}

-- One section header: name, type, flags, offset in the file, size, link,
-- info, alignment and entry size.
type Header = Header {
    name : String, kind : Int, flags : Int, offset : Int, size : Int, link : Int,
    info : Int, align : Int, entry : Int,
}

-- A symbol table entry.
type Entry = Entry { name : String, info : Int, section : Int, value : Int }

fun objectFile(obj : Object Fixup) -> Vec Byte {
    let sections = obj.sections
    let count = len(sections)
    let out = []
    pad(out, headerSize)
    let headers = []
    Vec.push(headers, Header { name = "", kind = 0, flags = 0, offset = 0, size = 0, link = 0,
                               info = 0, align = 0, entry = 0 })
    for s in sections {
        let (name, flags) = names(s.kind)
        let align = 1 << s.align
        pad(out, alignUp(len(out), align))
        Vec.push(headers, Header { name = name, kind = progbits, flags = flags,
                                   offset = len(out), size = len(s.bytes), link = 0,
                                   info = 0, align = align, entry = 0 })
        for b in s.bytes { Vec.push(out, b) }
    }
    -- Content section `k` is header `k + 1`. The relocation sections follow,
    -- then the stack note, then the symbol table and its strings; their
    -- indices are fixed before any of them is written, since each names
    -- another.
    var relocated = 0
    for s in sections { if len(s.relocations) > 0 { relocated = relocated + 1 } }
    let stackNote = count + 1 + relocated
    let symbolTable = stackNote + 1
    let stringTable = symbolTable + 1
    let (entries, locals) = symbols(obj)
    let indices = Map.new()
    for var k = 0; k < len(entries); k = k + 1 {
        if entries[k].name != "" { Map.put(indices, entries[k].name, k) }
    }
    let definitions = Map.new()
    for d in obj.defined { Map.put(definitions, Asm.spell(d.symbol), d) }
    for var k = 0; k < count; k = k + 1 {
        let s = sections[k]
        if len(s.relocations) > 0 {
            pad(out, alignUp(len(out), 8))
            let at = len(out)
            for r in s.relocations {
                let (symbol, addend) = match (r.use, r.target.kind,
                                              Map.get(definitions, Asm.spell(r.target))) {
                    -- A section's symbol is entry `section + 1`, after the
                    -- empty first entry.
                    (Offset32, _, Some(d)) -> (d.section + 1, d.offset)
                    (_, Temporary, Some(d)) -> (d.section + 1, d.offset)
                    _ -> (Map.getOr(indices, r.target.name, 0), 0)
                }
                le(out, 8, r.offset)
                le(out, 8, symbol << 32 | relocationKind(r.use))
                le(out, 8, addend)
            }
            let (name, _) = names(s.kind)
            Vec.push(headers, Header { name = ".rela" + name, kind = rela, flags = infoLink,
                                       offset = at, size = len(out) - at, link = symbolTable,
                                       info = k + 1, align = 8, entry = relocationSize })
        }
    }
    -- No executable stack, which the linker otherwise assumes of an object
    -- that does not say.
    Vec.push(headers, Header { name = ".note.GNU-stack", kind = progbits, flags = 0,
                               offset = len(out), size = 0, link = 0, info = 0, align = 1,
                               entry = 0 })
    let strings = []
    Vec.push(strings, Byte.truncate(0))
    let nameAt = Vec.map(entries, fun(e) = if e.name == "" { 0 } else { intern(strings, e.name) })
    pad(out, alignUp(len(out), 8))
    let symbolsAt = len(out)
    for var k = 0; k < len(entries); k = k + 1 {
        let e = entries[k]
        le(out, 4, nameAt[k])
        le(out, 1, e.info)
        le(out, 1, 0)
        le(out, 2, e.section)
        le(out, 8, e.value)
        le(out, 8, 0)
    }
    Vec.push(headers, Header { name = ".symtab", kind = symtab, flags = 0, offset = symbolsAt,
                               size = len(out) - symbolsAt, link = stringTable, info = locals,
                               align = 8, entry = symbolSize })
    Vec.push(headers, Header { name = ".strtab", kind = strtab, flags = 0, offset = len(out),
                               size = len(strings), link = 0, info = 0, align = 1, entry = 0 })
    for b in strings { Vec.push(out, b) }
    let sectionNames = []
    Vec.push(sectionNames, Byte.truncate(0))
    let headerNames = Vec.map(headers, fun(h) = if h.name == "" { 0 }
                                                  else { intern(sectionNames, h.name) })
    let shstrtabName = intern(sectionNames, ".shstrtab")
    Vec.push(headers, Header { name = ".shstrtab", kind = strtab, flags = 0, offset = len(out),
                               size = len(sectionNames), link = 0, info = 0, align = 1,
                               entry = 0 })
    Vec.push(headerNames, shstrtabName)
    for b in sectionNames { Vec.push(out, b) }
    pad(out, alignUp(len(out), 8))
    let headersAt = len(out)
    for var k = 0; k < len(headers); k = k + 1 {
        let h = headers[k]
        le(out, 4, headerNames[k])
        le(out, 4, h.kind)
        le(out, 8, h.flags)
        le(out, 8, 0)
        le(out, 8, h.offset)
        le(out, 8, h.size)
        le(out, 4, h.link)
        le(out, 4, h.info)
        le(out, 8, h.align)
        le(out, 8, h.entry)
    }
    -- Elf64_Ehdr: 64-bit, little-endian, current version, a relocatable
    -- object for AArch64, with no program headers.
    let header = []
    for b in [0x7F, 0x45, 0x4C, 0x46, 2, 1, 1, 0] { le(header, 1, b) }
    le(header, 8, 0)
    le(header, 2, 1)
    le(header, 2, 183)
    le(header, 4, 1)
    le(header, 8, 0)
    le(header, 8, 0)
    le(header, 8, headersAt)
    le(header, 4, 0)
    le(header, 2, headerSize)
    le(header, 2, 0)
    le(header, 2, 0)
    le(header, 2, sectionHeaderSize)
    le(header, 2, len(headers))
    le(header, 2, len(headers) - 1)
    for var k = 0; k < headerSize; k = k + 1 { out[k] = header[k] }
    out
}

-- The symbol table, and how many of its entries are local: the empty entry,
-- a symbol for each content section, the local named symbols, then the
-- exported and the undefined ones.
fun symbols(obj : Object Fixup) -> (Vec Entry, Int) {
    let entries = []
    Vec.push(entries, Entry { name = "", info = 0, section = 0, value = 0 })
    for var k = 0; k < len(obj.sections); k = k + 1 {
        Vec.push(entries, Entry { name = "", info = 3, section = k + 1, value = 0 })
    }
    let globals = []
    for d in obj.defined {
        if let Named = d.symbol.kind {
            let kind = if d.function { 2 } else { 0 }
            if d.exported {
                Vec.push(globals, Entry { name = d.symbol.name, info = 0x10 + kind,
                                          section = d.section + 1, value = d.offset })
            } else {
                Vec.push(entries, Entry { name = d.symbol.name, info = kind,
                                          section = d.section + 1, value = d.offset })
            }
        }
    }
    let locals = len(entries)
    for e in globals { Vec.push(entries, e) }
    for sym in obj.undefined {
        Vec.push(entries, Entry { name = sym.name, info = 0x10, section = 0, value = 0 })
    }
    (entries, locals)
}

-- AArch64's relocation types.
fun relocationKind(use : Use Fixup) -> Int = match use {
    Address64 -> 257
    Offset32 -> 258
    Relative64 -> 260
    Relative32 -> 261
    Code(Call26(_)) -> 283
    Code(Jump26(_)) -> 282
    Code(Branch19(_)) -> 280
    Code(Page21(_)) -> 275
    Code(AddOffset12(_)) -> 277
    Code(PageOffset12(_, scale)) -> match scale {
        0 -> 278
        1 -> 284
        2 -> 285
        3 -> 286
        _ -> 299
    }
}

-- `text` appended to a string table, answering its offset there.
fun intern(table : Vec Byte, text : String) -> Int {
    let at = len(table)
    for b in String.bytes(text) { Vec.push(table, b) }
    Vec.push(table, Byte.truncate(0))
    at
}

fun alignUp(n : Int, to : Int) -> Int = (n + to - 1) / to * to

fun le(out : Vec Byte, width : Int, n : Int) -> Unit {
    let at = len(out)
    for var k = 0; k < width; k = k + 1 { Vec.push(out, Byte.truncate(0)) }
    Byte.putLE(out, at, width, n)
}

-- Zeros up to file offset `to`.
fun pad(out : Vec Byte, to : Int) -> Unit {
    while len(out) < to { Vec.push(out, Byte.truncate(0)) }
}
