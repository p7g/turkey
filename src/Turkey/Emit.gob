export (
    emitFunc, emitMessages, emitData, emitEntry, emitFrameTable, emitDefinitions,
    emitSwapStack, emitStackStart, emitWorkerStart, functionEnd,
)

-- One allocated function as arm64 code: a stream of instructions, labels and
-- data (`Turkey.Stream`), which the assembly printer and the encoder both read.
--
-- **Nothing here rewrites anything.** Selection built the instructions, the
-- allocator chose the registers and `Turkey.Frame` placed the slots; this
-- prints what those three decided. That is the same division regalloc2 draws
-- and for the same reason -- a pass that does not mutate its input is one
-- whose input can still be printed, verified and re-run -- and it is why the
-- printer can be an ordinary `Show` instance rather than a second emitter.
--
-- What is added rather than printed is what has no instruction until now:
--
-- * the prologue and epilogue, from the layout;
-- * the moves a block parameter becomes, as a parallel copy on the edge;
-- * the branch a terminator becomes, and the fallthrough that lets one edge
--   cost nothing -- including the one place this reads two instructions as
--   one: a `cset` that ends a block and feeds only its `branch` is the
--   branch's condition, and the pair prints as a `b.cond`.
--
-- `as` is the oracle. Every instruction here is a value the printer spells and
-- the encoder encodes, and the system assembler, given the spelling, either
-- agrees with the encoding or refuses the text.

import Data.Map as Map
import Turkey.Arm64 as A
import Turkey.Arm64 (Reg(..), Bank(..), Mem(..), Inst(..), AllocArg(..))
import Turkey.Asm as Asm
import Turkey.Frame as Frame
import Turkey.Position as Position
import Turkey.Regalloc as Regalloc
import Turkey.Runtime as Rt
import Turkey.Sites as Sites
import Turkey.Ssa as Ssa
import Turkey.Ssa (Value(..), BlockId(..), Term(..), Func(..), Block(..), Rep(..),
                   RepClass(..))
import Turkey.SsaLower as SsaLower
import Turkey.SsaLower (Module(..))
import Turkey.Stream (Item(..), Cfi(..))

-- The items emitted so far, and the source position the next instruction
-- takes (`Turkey.Position`).
--
-- Positions: the prologue takes the declaration's; each instruction what it
-- was selected with, whatever it expands into here, its slow path after the
-- function included; a terminator its block's `termAt`, with the edge's
-- copies and a return's moves as no stepping target; the zero exit and every
-- runtime stub, 0.
--
-- With `rows`, an instruction whose position is not 0 and differs from the
-- last row's starts a row of the line table (`Loc`), and so does the first
-- one after the prologue, which marks where the body begins. `row` is the
-- last row's position, -1 before the first. The rows are items of no size,
-- placed only here and read by no pass, so the instructions are the same
-- with them and without.
type Code = Code {
    items            : Vec (Item Inst),
    var at           : Int,
    rows             : Bool,
    var row          : Int,
    var prologueDone : Bool,
    -- The format, which decides the shape of the frame rules (`cfi`).
    dialect          : Asm.Dialect,
}

fun code(items : Vec (Item Inst), rows : Bool, d : Asm.Dialect) -> Code =
    Code { items = items, at = 0, rows = rows, row = -1, prologueDone = False, dialect = d }

-- `x16` and `x17` are the allocator's reserved scratch (`Turkey.Regalloc`'s
-- `gpPool`), which is what makes them safe here: a large offset, a frame too
-- big for an immediate, and the cycle in a parallel copy each need a register
-- no value holds. `d31` is the vector file's, for a cycle of doubles.
let scratch = Physical(Gp, 16)
let fpScratch = Physical(Fp, 31)

-- The largest byte offset a scaled unsigned immediate reaches on a 64-bit
-- load or store. Past it the offset goes into `scratch` and the access uses
-- the register form.
let widestOffset = 32760

-- The largest `add` immediate without a shift, which is how a frame slot's
-- address is formed.
let widestAddend = 4095

-- The largest immediate `add` and `sub` take without a shift.
let widestImmediate = 4095

fun emit(b : Code, item : Item Inst) -> Unit = Vec.push(b.items, item)

fun instruction(b : Code, op : A.Arm) -> Unit {
    -- Position 0 continues the last row.
    if b.rows && b.at != 0 && (b.at != b.row || b.prologueDone) {
        emit(b, Loc(b.at, b.prologueDone))
        b.row = b.at
        b.prologueDone = False
    }
    emit(b, Instruction(Inst { op = op, at = b.at }))
}

-- The label after function `tag`'s last instruction, with `rows`.
fun functionEnd(d : Asm.Dialect, tag : Int) -> Asm.Symbol =
    Asm.localLabel(d, "f" + Int.toString(tag) + "end")

-- Function `tag`, with a line table row at each change of position if `rows`.
fun emitFunc(asm : Asm.Asm, f : Func Inst, a : Regalloc.Allocation,
             l : Frame.Layout, tag : Int, rows : Bool, out : Vec (Item Inst)) -> Unit {
    let b = code(out, rows, asm.dialect)
    let d = asm.dialect
    function(b, Asm.symbolFor(d, f.name))
    cfi(b, StartProc)
    -- A function the compiler made has no position. A row with no line
    -- starts it, or the last row of whatever came before would cover it.
    if rows && f.at == 0 { emit(b, Loc(0, False)) }
    b.at = f.at
    prologue(b, l)
    b.prologueDone = rows
    -- Reverse postorder, so a block's most likely successor is the next block
    -- and its edge costs no instruction at all. A block that is only the exit
    -- is not placed: its edges go to the exit itself.
    let exits = exitBlocks(f)
    let order = Vec.filter(Ssa.reversePostorder(f), fun(at) = !exits[Ssa.blockId(at)])
    let reads = useCounts(f)
    let edges = atEdges(f, reads)
    let cold = Cold { text = code([], rows, d), count = 0 }
    for var k = 0; k < len(order); k = k + 1 {
        let at = Ssa.blockId(order[k])
        let next = if k + 1 < len(order) { Ssa.blockId(order[k + 1]) } else { -1 }
        emit(b, Label(blockLabel(d, tag, at)))
        let block = f.blocks[at]
        match fused(block, reads) {
            Some((c, yes, no)) -> {
                emitInsts(b, cold, d, f, a, l, tag, edges, at, block.insts, len(block.insts) - 1)
                b.at = block.termAt
                conditional(b, d, tag, exits, c, yes, no, next)
            }
            None -> {
                emitInsts(b, cold, d, f, a, l, tag, edges, at, block.insts, len(block.insts))
                if !endsInTailCall(block) {
                    b.at = block.termAt
                    emitTerm(b, d, f, a, l, tag, edges, exits, block.term, next)
                }
            }
        }
    }
    for item in cold.text.items { emit(b, item) }
    if leaves(f) {
        b.at = 0
        emit(b, Label(exitLabel(d, tag)))
        zero(b, f)
        epilogue(b, l)
    }
    cfi(b, EndProc)
    if rows { emit(b, Label(functionEnd(d, tag))) }
}

-- -- the zero exit -----------------------------------------------------------

-- Every path that leaves a function without a value -- an `Unreachable`, which
-- is how selection ends a panic, and an allocation stub whose call panicked --
-- returns a zero in each of the function's result registers through one exit
-- after the function's cold code. They are most of a function's ways out, and
-- none is hot, so each costs a branch instead of an epilogue. `Ret` does not
-- come here: see `emitTerm`.
fun exitLabel(d : Asm.Dialect, tag : Int) -> Asm.Symbol =
    Asm.localLabel(d, "e" + Int.toString(tag))

-- Whether anything in `f` branches to its exit.
fun leaves(f : Func Inst) -> Bool {
    for block in f.blocks {
        if unreachable(block.term) && !endsInTailCall(block) { return True }
        for i in block.insts {
            if Option.isSome(A.allocationOf(i.op))
               || Option.isSome(A.arrayAllocationOf(i.op)) {
                return True
            }
        }
    }
    False
}

-- For each block, whether it is nothing but `Unreachable`, as a panic
-- propagated from a callee is: then an edge into it can go straight to the
-- exit. Never the entry, which the prologue falls into.
fun exitBlocks(f : Func Inst) -> Array Bool {
    let out = Array.filled(len(f.blocks), False)
    for var at = 0; at < len(f.blocks); at = at + 1 {
        let block = f.blocks[at]
        out[at] = at != Ssa.blockId(f.entry) && len(block.insts) == 0
                  && unreachable(block.term)
    }
    out
}

fun unreachable(t : Term) -> Bool = match t {
    Unreachable -> True
    _ -> False
}

-- Where an edge to `block` lands.
fun edgeTo(d : Asm.Dialect, tag : Int, exits : Array Bool, block : BlockId) -> Asm.Symbol =
    if exits[Ssa.blockId(block)] { exitLabel(d, tag) }
    else { blockLabel(d, tag, Ssa.blockId(block)) }

-- The first `upTo` instructions of block `at`.
--
-- An `Allocate` takes the safepoint map directly after it, if there is one:
-- that position is its stub's call, so the label goes into the stub. One that
-- nothing is live across has no map, and the next map belongs to something
-- else.
fun emitInsts(b : Code, cold : Cold, d : Asm.Dialect, f : Func Inst,
              a : Regalloc.Allocation, l : Frame.Layout, tag : Int,
              edges : Array (Option A.Arm), at : Int, insts : Vec Inst,
              upTo : Int) -> Unit {
    for var n = 0; n < upTo; n = n + 1 {
        -- Skip a definition the jump computes, rather than filtering the block
        -- beforehand, so that `n` stays the instruction's index in its block:
        -- `Frame.stubAt` names an allocation by that index.
        if definedAtEdge(insts[n], edges) { continue }
        b.at = insts[n].at
        cold.text.at = insts[n].at
        let op = insts[n].op
        match A.pollOf(op) {
            Some((pb, pn)) -> {
                poll(b, cold, d, l, tag, pb, pn)
                continue
            }
            None -> {}
        }
        if Option.isNone(A.allocationOf(op)) && Option.isNone(A.arrayAllocationOf(op)) {
            emitInst(b, d, f, a, l, tag, insts[n])
            continue
        }
        let save = Frame.stubAt(l, at, n)
        var label = None
        if n + 1 < upTo {
            match A.safepointOf(insts[n + 1].op) {
                Some((sb, sn)) -> {
                    label = Some(safepointLabel(d, tag, sb, sn))
                    n = n + 1
                }
                None -> {}
            }
        }
        match A.allocationOf(op) {
            Some((dest, allocation)) ->
                allocate(b, cold, d, f, l, tag, coloured(f, a, dest), allocation, save,
                         label)
            None -> {}
        }
        match A.arrayAllocationOf(op) {
            Some((dest, length, fill, allocation)) ->
                allocateArray(b, cold, d, f, l, tag, coloured(f, a, dest),
                              coloured(f, a, length), coloured(f, a, fill), allocation,
                              save, label)
            None -> {}
        }
    }
}

-- The code a function keeps after its blocks: the slow paths of its
-- allocations, out of the way of the fast ones.
type Cold = Cold { text : Code, var count : Int }

-- The labels of allocation `n` in function `tag`: its stub (`"s"`) and the
-- return to the fast path (`"r"`).
fun allocationLabel(d : Asm.Dialect, tag : Int, n : Int, which : String) -> Asm.Symbol =
    Asm.localLabel(d, "a" + Int.toString(tag) + which + Int.toString(n))

-- How many times each value is read, terminators included.
fun useCounts(f : Func Inst) -> Array Int {
    let out = Array.filled(len(f.reps), 0)
    for block in f.blocks {
        for i in block.insts {
            Ssa.eachUse(i, fun(v) { out[Ssa.valueId(v)] = out[Ssa.valueId(v)] + 1 })
        }
        for v in Ssa.termUses(block.term) {
            out[Ssa.valueId(v)] = out[Ssa.valueId(v)] + 1
        }
    }
    out
}

-- For each value, its definition if a jump computes it into a block
-- parameter's register and it is not computed where it is defined: a value
-- `A.rematerializable` defines whose one read is a jump's argument. Its
-- definition is one instruction that reads no register, so writing it into
-- the parameter's register on the edge costs what the copy's `mov` would
-- have, and leaves out the definition the `mov` would have copied.
fun atEdges(f : Func Inst, reads : Array Int) -> Array (Option A.Arm) {
    let out : Array (Option A.Arm) = Array.filled(len(f.reps), None)
    let passed = Array.filled(len(f.reps), False)
    for block in f.blocks {
        match block.term {
            Jump(_, args) -> for v in args {
                if reads[Ssa.valueId(v)] == 1 { passed[Ssa.valueId(v)] = True }
            }
            _ -> {}
        }
    }
    for block in f.blocks {
        for i in block.insts {
            if A.rematerializable(i.op) {
                Ssa.eachDef(i, fun(v) {
                    if passed[Ssa.valueId(v)] { out[Ssa.valueId(v)] = Some(i.op) }
                })
            }
        }
    }
    out
}

-- Whether a jump computes what `i` defines instead (`atEdges`).
fun definedAtEdge(i : Inst, edges : Array (Option A.Arm)) -> Bool =
    Ssa.anyDef(i, fun(v) = Option.isSome(edges[Ssa.valueId(v)]))

-- A block ending `cset %c, cond; branch %c` where nothing else reads `%c`:
-- the branch can read the flags itself. Only when the `cset` is the last
-- instruction, so that nothing between it and the branch -- a spill, a
-- reload -- could have needed the bit in a register or changed the flags.
fun fused(block : Block Inst, reads : Array Int) -> Option (A.Cond, BlockId, BlockId) {
    match block.term {
        Branch(c, yes, no) -> {
            if len(block.insts) == 0 || reads[Ssa.valueId(c)] != 1 { return None }
            match A.csetOf(block.insts[len(block.insts) - 1].op) {
                Some((n, cond)) -> if n == Ssa.valueId(c) { Some((cond, yes, no)) }
                                   else { None }
                None -> None
            }
        }
        _ -> None
    }
}

-- `b.cond` to one arm, falling through to the other where it is next.
fun conditional(b : Code, d : Asm.Dialect, tag : Int, exits : Array Bool, c : A.Cond,
                yes : BlockId, no : BlockId, next : Int) -> Unit {
    if Ssa.blockId(yes) == next {
        instruction(b, A.BCond(A.invert(c), edgeTo(d, tag, exits, no)))
    } else {
        instruction(b, A.BCond(c, edgeTo(d, tag, exits, yes)))
        if Ssa.blockId(no) != next {
            instruction(b, A.B(edgeTo(d, tag, exits, no)))
        }
    }
}

-- A global function's label, and what the format wants said about it first.
fun function(b : Code, symbol : Asm.Symbol) -> Unit {
    emit(b, Global(symbol))
    emit(b, FunctionType(symbol))
    emit(b, Align(2))
    emit(b, Label(symbol))
}

-- The return address of the call at this safepoint: the label goes directly
-- after the `bl`, which is where selection put the `SafepointMap` mark.
fun safepointLabel(d : Asm.Dialect, tag : Int, block : Int, index : Int) -> Asm.Symbol =
    Asm.localLabel(d, "sp" + Int.toString(tag) + "b" + Int.toString(block)
                      + "i" + Int.toString(index))

fun blockLabel(d : Asm.Dialect, tag : Int, block : Int) -> Asm.Symbol =
    Asm.localLabel(d, "f" + Int.toString(tag) + "b" + Int.toString(block))

-- -- the frame ---------------------------------------------------------------

-- The frame record is pushed, `x29` pointed at it, and the rest of the frame
-- claimed below; after that nothing moves `sp`: every slot is addressed from
-- it, and the outgoing arguments sit at the bottom where a call can reach them
-- without touching it.
--
-- The push is a pre-indexed `stp` because the record is at the top of the
-- frame (`Frame.verifyFrame` checks it), and a pair's signed seven-bit offset
-- reaches only 504 bytes up from `sp`: frames are often bigger than that.
fun prologue(b : Code, l : Frame.Layout) -> Unit {
    instruction(b, A.StpPre(A.fp, A.lr, A.sp, -16))
    exactly(b, [DefCfaOffset(16), SavedAt(fpColumn, -16), SavedAt(lrColumn, -8)])
    instruction(b, A.AddImm(A.fp, A.sp, 0, A.W64))
    exactly(b, [DefCfa(fpColumn, 16)])
    adjust(b, l.size - 16, False)
    saves(b, l, True)
    frameMode(b, l.pairs)
}

-- The prologue undone, and the return.
fun epilogue(b : Code, l : Frame.Layout) -> Unit {
    unwind(b, l)
    instruction(b, A.Ret)
    exactly(b, [RestoreState])
}

-- The prologue undone: the callee-saved registers, `sp` and the frame record
-- as the caller left them. `sp` comes back from `x29`, which is one
-- instruction whatever the frame's size, and is left out when the record is
-- all the frame there is. Writes no argument register and no scratch, which
-- is what lets a tail call unwind between its arguments and its branch.
--
-- The body's frame rules are remembered before it, and the caller puts them
-- back after its last instruction (`exactly`), for the code that follows.
fun unwind(b : Code, l : Frame.Layout) -> Unit {
    exactly(b, [RememberState])
    saves(b, l, False)
    if l.size > 16 { instruction(b, A.AddImm(A.sp, A.fp, 0, A.W64)) }
    instruction(b, A.LdpPost(A.fp, A.lr, A.sp, 16))
    exactly(b, [DefCfa(spColumn, 0), Restored(fpColumn), Restored(lrColumn)])
}

-- A tail call: the frame comes down with the arguments already in their
-- registers, and the branch goes to the callee with this function's return
-- address still in `x30`, so the callee answers this function's caller.
--
-- An indirect target goes into `scratch` first. The allocator may have given
-- it a callee-saved register, which unwinding restores, and `scratch` is
-- never allocated.
fun tailCall(b : Code, f : Func Inst, a : Regalloc.Allocation, l : Frame.Layout,
             target : Either Asm.Symbol Reg) -> Unit = match target {
    Left(sym) -> {
        unwind(b, l)
        instruction(b, A.B(sym))
        exactly(b, [RestoreState])
    }
    Right(through) -> {
        let r = coloured(f, a, through)
        if !A.sameRegister(r, scratch) { instruction(b, A.Mov(scratch, r, A.W64)) }
        unwind(b, l)
        instruction(b, A.Br(scratch))
        exactly(b, [RestoreState])
    }
}

-- Whether a block ends in a tail call, after which it has nothing to emit:
-- selection leaves such a block's terminator `Unreachable`, and the branch to
-- the zero exit would be dead code.
fun endsInTailCall(block : Block Inst) -> Bool {
    if len(block.insts) == 0 { return False }
    Option.isSome(A.tailCallOf(block.insts[len(block.insts) - 1].op))
}

-- The callee-saved registers the colouring actually used, saved on the way in
-- and restored on the way out, a pair to an instruction (`Frame.savedPairs`).
--
-- They are addressed from `x29`, not `sp`. The area sits directly below the
-- frame record and holds at most nine pairs, so it is never more than 144
-- bytes below `x29`, which a pair's offset reaches whatever the frame's size;
-- from `sp` it would be as far up as the frame is big.
--
-- The order is compact unwind's frame mode: the pairs present, packed down
-- from `x29 - 8`, each with its lower register at the higher address, so
-- `stp x20, x19, [x29, #-16]` and then `stp x22, x21, [x29, #-32]`. That is
-- the only layout an unwinder can read from one 32-bit encoding per
-- function; any other needs a DWARF description of the function.
--
-- `x27`/`x28` is stored whole, for that shape, and only `x27` comes back:
-- `x28` is the running worker (`A.worker`), which a coroutine resumed on
-- another thread must not see restored to the first thread's.
fun saves(b : Code, l : Frame.Layout, saving : Bool) -> Unit {
    for var k = 0; k < len(l.pairs); k = k + 1 {
        let (bank, first) = l.pairs[k]
        let at = -16 * (k + 1)
        let low = Physical(bank, first)
        let high = Physical(bank, first + 1)
        if saving {
            instruction(b, A.Stp(high, low, A.fp, at))
            exactly(b, [SavedAt(column(low), at - 8)])
            if !A.sameRegister(high, A.worker) {
                exactly(b, [SavedAt(column(high), at - 16)])
            }
        } else if A.sameRegister(high, A.worker) {
            instruction(b, A.Ldr(low, Offset(A.fp, at + 8), A.W64))
            exactly(b, [Restored(column(low))])
        } else {
            instruction(b, A.Ldp(high, low, A.fp, at))
            exactly(b, [Restored(column(low)), Restored(column(high))])
        }
    }
}

-- -- the frame rules ---------------------------------------------------------

-- Each function is described from a `StartProc` to an `EndProc`, in one of
-- two shapes, by format.
--
-- **Mach-O: one block (`frameMode`)** after the prologue's last save: the CFA
-- at `x29 + 16`, the frame record below it, and the saved pairs below that.
-- That is the form an assembler encodes as compact unwind's frame mode, one
-- word for the whole function. Rules that change from one instruction to the
-- next have no compact encoding and need a DWARF description instead, which
-- every function would then carry. The block is wrong inside the prologue
-- and the epilogues, since frame mode does not look at the pc; a debugger
-- stopped there reads the instructions of the frame it stopped in.
--
-- **ELF: exact at every instruction (`exactly`)**, since `.eh_frame` is the
-- only description there is. The CFA moves from `sp` to `x29` in the
-- prologue; each epilogue remembers the body's rules, undoes them load by
-- load, and puts them back after its last instruction for the code that
-- follows it. `x28`, the worker, is never described as saved: a frame never
-- restores it, so its caller's value is the one it holds.
fun cfi(b : Code, rule : Cfi) -> Unit = emit(b, Cfi(rule))

-- The rules, on ELF.
fun exactly(b : Code, rules : Array Cfi) -> Unit = match b.dialect {
    Asm.Elf -> for rule in rules { cfi(b, rule) }
    Asm.MachO -> {}
}

-- On Mach-O, the block frame mode encodes: the frame record at `x29`, and
-- the pairs below it in the order `saves` stores them. Each pair is a bank
-- and its lower register, as `Frame.savedPairs` gives it.
fun frameMode(b : Code, pairs : Vec (Bank, Int)) -> Unit = match b.dialect {
    Asm.MachO -> {
        cfi(b, DefCfa(fpColumn, 16))
        cfi(b, SavedAt(lrColumn, -8))
        cfi(b, SavedAt(fpColumn, -16))
        for var k = 0; k < len(pairs); k = k + 1 {
            let (bank, first) = pairs[k]
            cfi(b, SavedAt(column(Physical(bank, first)), -16 * k - 24))
            cfi(b, SavedAt(column(Physical(bank, first + 1)), -16 * k - 32))
        }
    }
    Asm.Elf -> {}
}

-- DWARF's number for a register.
fun column(r : Reg) -> Int = match r {
    Physical(Gp, n) -> n
    Physical(Fp, n) -> 64 + n
    Virtual(n) -> error("internal error: frame rules for the unallocated register %"
                        + Int.toString(n))
}

let fpColumn = 29
let lrColumn = 30
let spColumn = 31

-- `sp` up by `size` when `up`, down otherwise.
fun adjust(b : Code, size : Int, up : Bool) -> Unit {
    if size == 0 { return }
    if size <= widestImmediate {
        instruction(b, if up { A.AddImm(A.sp, A.sp, size, A.W64) }
                       else { A.SubImm(A.sp, A.sp, size, A.W64) })
    } else {
        instruction(b, A.MovConst(scratch, size))
        instruction(b, if up { A.AddExt(A.sp, A.sp, scratch) }
                       else { A.SubExt(A.sp, A.sp, scratch) })
    }
}

-- -- instructions ------------------------------------------------------------

fun emitInst(b : Code, d : Asm.Dialect, f : Func Inst,
             a : Regalloc.Allocation, l : Frame.Layout, tag : Int,
             i : Inst) -> Unit {
    -- A safepoint is not an instruction: it is the *position* after the call,
    -- which is the return address the collector will look up. So it becomes a
    -- label, and `Turkey.Frame`'s entry for the same (block, index) names it.
    match A.safepointOf(i.op) {
        Some((sb, sn)) -> {
            emit(b, Label(safepointLabel(d, tag, sb, sn)))
            return
        }
        None -> {}
    }
    match A.tailCallOf(i.op) {
        Some(target) -> {
            tailCall(b, f, a, l, target)
            return
        }
        None -> {}
    }
    -- A slot whose offset is too wide is the one case that needs an extra
    -- instruction, so it is settled before the rewrite rather than inside it.
    let wide = wideSlot(l, i.op)
    match wide {
        Some(offset) -> instruction(b, A.MovConst(scratch, offset))
        None -> {}
    }
    let op = A.rewrite(i.op, coloured(f, a, _),
                       placed(l, _, wide))
    -- A move into the register the value already holds is what a taken hint
    -- looks like from here: the parameter the caller put in `x0` was coloured
    -- `x0`, so `mov x0, x0` is the convention being satisfied by doing nothing.
    if !A.redundantMove(op) { instruction(b, op) }
}

-- -- allocation -------------------------------------------------------------

-- An `Allocate`'s fast path, in line: take the lowest free slot of the size
-- class's cursor and answer it, for the caller to write the object's header
-- into. The cursor's layout is `Turkey.Runtime`'s, and the cursor is the
-- running worker's, a fixed distance into its record (`A.worker`).
--
-- Only the destination and the two scratch registers are written, which is
-- what lets the allocator see one instruction: the destination holds each
-- intermediate in turn, so no other value is disturbed. An empty cursor
-- branches to its stub, after the function, which keeps `save` across its
-- call.
fun allocate(b : Code, cold : Cold, d : Asm.Dialect, f : Func Inst,
             l : Frame.Layout, tag : Int, dest : Reg, al : A.Allocation,
             save : Frame.CallSave, safepoint : Option Asm.Symbol) -> Unit {
    let n = cold.count
    cold.count = n + 1
    let cursor = scratch
    let word = Physical(Gp, 17)
    instruction(b, A.AddImm(cursor, A.worker,
                            Rt.workerCursors + Rt.cursorBytes * al.sizeClass, A.W64))
    instruction(b, A.Ldr(word, Offset(cursor, Rt.cursorFree), A.W64))
    instruction(b, A.Cbz(word, allocationLabel(d, tag, n, "s"), A.W64))
    -- The lowest set bit, cleared from the word that is stored back; then
    -- its position, which arm64 counts as the leading zeros of the reversal.
    instruction(b, A.Sub(dest, A.xzr, word, A.W64))
    instruction(b, A.And(dest, word, dest, A.W64))
    instruction(b, A.Eor(word, word, dest, A.W64))
    instruction(b, A.Str(word, Offset(cursor, Rt.cursorFree), A.W64))
    instruction(b, A.Rbit(dest, dest))
    instruction(b, A.Clz(dest, dest))
    instruction(b, A.Ldr(word, Offset(cursor, Rt.cursorBase), A.W64))
    instruction(b, A.MovConst(cursor, al.slotBytes))
    instruction(b, A.Mul(dest, dest, cursor, A.W64))
    instruction(b, A.Add(dest, dest, word, A.W64))
    if al.sizes {
        sizeEntry(b, dest, cursor, word)
        instruction(b, A.MovConst(word, al.size))
        instruction(b, A.Str(word, Offset(cursor, 0), A.W64))
    }
    emit(b, Label(allocationLabel(d, tag, n, "r")))
    stub(cold.text, d, f, l, tag, n, dest, al, save, safepoint)
}

-- Into `entry`, the address of the word in its region's size table that
-- records the size of the object at `object`, for the heap verifier
-- (`Rt.regionSizes`). Writes `entry` and `spare` and nothing else.
fun sizeEntry(b : Code, object : Reg, entry : Reg, spare : Reg) -> Unit {
    instruction(b, A.LsrImm(spare, object, Rt.regionShift, A.W64))
    instruction(b, A.LslImm(spare, spare, Rt.regionShift, A.W64))
    instruction(b, A.Ldr(entry, Offset(spare, Rt.regionSizes), A.W64))
    instruction(b, A.Sub(spare, object, spare, A.W64))
    instruction(b, A.Add(entry, entry, spare, A.W64))
}

-- An `AllocateArray`'s fast path: the size class from the runtime's table by
-- the array's size, then the same take as `allocate`, the array's header,
-- and the elements filled. A length past what the table covers -- or
-- negative, which compares as a huge unsigned number -- goes to the stub, and
-- so the runtime's allocator decides what to do with it.
--
-- `dest` is written before `length` and `fill` are last read, which the
-- allocator knows (`A.writesBeforeReading`), so it holds neither.
fun allocateArray(b : Code, cold : Cold, d : Asm.Dialect, f : Func Inst,
                  l : Frame.Layout, tag : Int, dest : Reg, length : Reg, fill : Reg,
                  al : A.ArrayAllocation, save : Frame.CallSave,
                  safepoint : Option Asm.Symbol) -> Unit {
    let n = cold.count
    cold.count = n + 1
    let slow = allocationLabel(d, tag, n, "s")
    let back = allocationLabel(d, tag, n, "r")
    let top = allocationLabel(d, tag, n, "l")
    let cursor = scratch
    let word = Physical(Gp, 17)
    let shift = match al.width {
        1 -> 0
        4 -> 2
        _ -> 3
    }
    instruction(b, A.MovConst(cursor, (Rt.fastBytes - Rt.arrayElements) / al.width + 1))
    instruction(b, A.Cmp(length, cursor, A.W64))
    instruction(b, A.BCond(A.Hs, slow))
    -- The class, from the array's size: the header, the length and the
    -- elements.
    instruction(b, A.LslImm(word, length, shift, A.W64))
    instruction(b, A.AddImm(word, word, Rt.arrayElements + Rt.classStep, A.W64))
    instruction(b, A.LsrImm(word, word, Rt.classShift, A.W64))
    instruction(b, A.Adrp(cursor, al.classes))
    instruction(b, A.Ldr(cursor, PageOffset(cursor, al.classes), A.W64))
    instruction(b, A.Ldrb(word, Indexed(cursor, word)))
    instruction(b, A.LslImm(word, word, 6, A.W64))
    instruction(b, A.Add(cursor, A.worker, word, A.W64))
    instruction(b, A.AddImm(cursor, cursor, Rt.workerCursors, A.W64))
    instruction(b, A.Ldr(word, Offset(cursor, Rt.cursorFree), A.W64))
    instruction(b, A.Cbz(word, slow, A.W64))
    instruction(b, A.Sub(dest, A.xzr, word, A.W64))
    instruction(b, A.And(dest, word, dest, A.W64))
    instruction(b, A.Eor(word, word, dest, A.W64))
    instruction(b, A.Str(word, Offset(cursor, Rt.cursorFree), A.W64))
    instruction(b, A.Rbit(dest, dest))
    instruction(b, A.Clz(dest, dest))
    instruction(b, A.Ldr(word, Offset(cursor, Rt.cursorBase), A.W64))
    instruction(b, A.Ldr(cursor, Offset(cursor, Rt.cursorSlot), A.W64))
    instruction(b, A.Mul(dest, dest, cursor, A.W64))
    instruction(b, A.Add(dest, dest, word, A.W64))
    if al.sizes {
        sizeEntry(b, dest, cursor, word)
        instruction(b, A.LslImm(word, length, shift, A.W64))
        instruction(b, A.AddImm(word, word, Rt.arrayElements, A.W64))
        instruction(b, A.Str(word, Offset(cursor, 0), A.W64))
    }
    -- The header, young, with the element's layout code, and the length.
    instruction(b, A.MovConst(cursor, Rt.headerWord(Rt.arrayKind, al.layout, 0)))
    instruction(b, A.Str(cursor, Offset(dest, 0), A.W64))
    instruction(b, A.Str(length, Offset(dest, 8), A.W64))
    -- Every element, including an array of pointers to nothing, which the
    -- collector may walk before anything else is stored. `fill` is the
    -- element's pattern repeated across a word (`Select.fillPattern`), so
    -- the elements are stored in whole words: the first on its own, then
    -- pairs from the last down. When the words are even in number, the
    -- last pair stores the first word again, which costs one store and
    -- saves a test.
    --
    -- The last word may run past the last element, and stays inside the
    -- slot: every size class is a multiple of 8 bytes and the class is
    -- chosen by the array's size rounded up to 8, so the slot holds the
    -- header and the elements rounded up to a word.
    --
    -- `cursor` starts 8 below the last pair, at the elements' bytes rounded
    -- up to a word less one word, so that the pair is stored at `cursor + 8`
    -- and the loop runs while `cursor` is above `dest`: it stops at `dest`
    -- for an odd count of words and at `dest - 8` for an even one.
    instruction(b, A.Cbz(length, back, A.W64))
    instruction(b, A.Str(fill, Offset(dest, Rt.arrayElements), A.W64))
    instruction(b, A.SubImm(cursor, length, 1, A.W64))
    if shift < 3 { instruction(b, A.LsrImm(cursor, cursor, 3 - shift, A.W64)) }
    instruction(b, A.LslImm(cursor, cursor, 3, A.W64))
    instruction(b, A.Add(cursor, dest, cursor, A.W64))
    instruction(b, A.Cmp(cursor, dest, A.W64))
    instruction(b, A.BCond(A.Ls, back))
    emit(b, Label(top))
    instruction(b, A.Stp(fill, fill, cursor, 8))
    instruction(b, A.SubImm(cursor, cursor, 16, A.W64))
    instruction(b, A.Cmp(cursor, dest, A.W64))
    instruction(b, A.BCond(A.Hi, top))
    emit(b, Label(back))
    -- The stub: the length and the fill into the first two argument
    -- registers, without either overwriting the other, and without a move
    -- for one the allocator already put there. Saving first leaves both
    -- where the allocator put them.
    let text = cold.text
    emit(text, Label(slow))
    keep(text, save, True)
    let x1 = A.argRegs[1]
    if A.sameRegister(fill, A.x0) && A.sameRegister(length, x1) {
        instruction(text, A.Mov(scratch, fill, A.W64))
        instruction(text, A.Mov(A.x0, length, A.W64))
        instruction(text, A.Mov(x1, scratch, A.W64))
    } else if A.sameRegister(fill, A.x0) {
        argument(text, x1, fill)
        argument(text, A.x0, length)
    } else {
        argument(text, A.x0, length)
        argument(text, x1, fill)
    }
    instruction(text, A.MovConst(A.argRegs[2], al.width))
    instruction(text, A.MovConst(A.argRegs[3], al.layout))
    returnFromStub(text, d, f, l, tag, n, dest, al.slow, save, safepoint)
}

-- `mov d, s`, left out when `s` is `d`, as `emitInst` leaves out a taken hint.
fun argument(b : Code, d : Reg, s : Reg) -> Unit {
    let op = A.Mov(d, s, A.W64)
    if !A.redundantMove(op) { instruction(b, op) }
}

-- A loop's poll (`Turkey.Polls`): a test of the worker's stop word on the
-- loop's path, and, off it, the call the stop asks for.
--
-- The register allocator was told nothing happens here, so the slow path
-- keeps everything it disturbs: the live values in registers the call
-- clobbers (`Frame.pollAt`) are pushed below the frame and popped after. `sp`
-- moves, which the frame's own slots never see: the roots are in their slots
-- from their definitions on, and the collector finds them from `x29`. The
-- label after the call is the poll's frame-table entry.
fun poll(b : Code, cold : Cold, d : Asm.Dialect, l : Frame.Layout, tag : Int,
         pb : Int, pn : Int) -> Unit {
    let n = cold.count
    cold.count = n + 1
    let slow = allocationLabel(d, tag, n, "s")
    let back = allocationLabel(d, tag, n, "r")
    instruction(b, A.Ldr(scratch, Offset(A.worker, Rt.workerStop), A.W64))
    instruction(b, A.Cbnz(scratch, slow, A.W64))
    emit(b, Label(back))
    let text = cold.text
    emit(text, Label(slow))
    let save = Frame.pollAt(l, pb, pn)
    keep(text, save, True)
    instruction(text, A.Bl(Asm.turkeyEntry(d, "turkey_poll"), A.Standard))
    emit(text, Label(safepointLabel(d, tag, pb, pn)))
    keep(text, save, False)
    instruction(text, A.B(back))
}

-- The registers a slow path keeps across its call, pushed below the frame
-- when `saving` and popped otherwise.
fun keep(b : Code, save : Frame.CallSave, saving : Bool) -> Unit {
    if saving { adjust(b, keptBytes(save), False) }
    for var k = 0; k < len(save.kept); k = k + 1 {
        instruction(b, if saving { A.Str(save.kept[k], Offset(A.sp, 8 * k), A.W64) }
                       else { A.Ldr(save.kept[k], Offset(A.sp, 8 * k), A.W64) })
    }
    if !saving { adjust(b, keptBytes(save), True) }
}

-- The save area alone popped, its registers left as the call left them.
fun dropKept(b : Code, save : Frame.CallSave) -> Unit = adjust(b, keptBytes(save), True)

-- The save area's size, a multiple of 16 so that `sp` stays aligned.
fun keptBytes(save : Frame.CallSave) -> Int = (8 * len(save.kept) + 15) / 16 * 16

-- An allocation's slow path, after the function: the runtime's allocator with
-- its constant arguments, the label the frame table names its return address
-- by, the panic test every call gets, and back.
--
-- The register allocator was told the allocation destroys no allocatable
-- register but its destination (`A.callClobbers`), so the stub keeps the live
-- values in registers the call clobbers, as a poll does.
fun stub(b : Code, d : Asm.Dialect, f : Func Inst, l : Frame.Layout,
         tag : Int, n : Int, dest : Reg, al : A.Allocation, save : Frame.CallSave,
         safepoint : Option Asm.Symbol) -> Unit {
    emit(b, Label(allocationLabel(d, tag, n, "s")))
    keep(b, save, True)
    var k = 0
    for arg in al.args {
        let r = A.argRegs[k]
        match arg {
            Constant(0) -> instruction(b, A.Mov(r, A.xzr, A.W64))
            Constant(value) -> instruction(b, A.MovConst(r, value))
            AddressOf(sym) -> symbolInto(b, r, sym)
        }
        k = k + 1
    }
    returnFromStub(b, d, f, l, tag, n, dest, al.slow, save, safepoint)
}

-- The call that ends a stub, its frame-table label, the panic test every call
-- gets, and the way back with the result in `dest` and `save` restored.
--
-- The result goes into `dest` before the restores, because one of them may be
-- into `x0`. A panic leaves through the function's zero exit, which needs only
-- the callee-saved registers back; a stub that pushed a save area pops it
-- without reading it first, since the exit's epilogue expects `sp` where the
-- body left it.
fun returnFromStub(b : Code, d : Asm.Dialect, f : Func Inst, l : Frame.Layout,
                   tag : Int, n : Int, dest : Reg, slow : Asm.Symbol,
                   save : Frame.CallSave, safepoint : Option Asm.Symbol) -> Unit {
    let pushed = keptBytes(save) > 0
    let failed = if pushed { allocationLabel(d, tag, n, "p") } else { exitLabel(d, tag) }
    instruction(b, A.Bl(slow, A.Standard))
    match safepoint {
        Some(label) -> emit(b, Label(label))
        None -> {}
    }
    instruction(b, A.Ldr(scratch, Offset(A.worker, 0), A.W32))
    instruction(b, A.Cbnz(scratch, failed, A.W32))
    if !A.sameRegister(dest, A.x0) { instruction(b, A.Mov(dest, A.x0, A.W64)) }
    keep(b, save, False)
    instruction(b, A.B(allocationLabel(d, tag, n, "r")))
    if pushed {
        emit(b, Label(failed))
        dropKept(b, save)
        instruction(b, A.B(exitLabel(d, tag)))
    }
}

-- Where the allocator put a value. A physical register is already itself --
-- selection pins the argument registers, and the emitter's own additions are
-- physical from the start.
fun coloured(f : Func Inst, a : Regalloc.Allocation, r : Reg) -> Reg = match r {
    Virtual(n) -> Physical(A.bankOf(f.reps[n]), a.colouring.of_[n])
    Physical(bank, n) -> Physical(bank, n)
}

fun placed(l : Frame.Layout, m : Mem, wide : Option Int) -> Mem =
    match Frame.offsetOf(l, m) {
        Some(offset) -> match wide {
            Some(_) -> Indexed(A.sp, scratch)
            None -> Offset(A.sp, offset)
        }
        None -> m
    }

fun wideSlot(l : Frame.Layout, op : A.Arm) -> Option Int = match A.memOf(op) {
    Some(m) -> match Frame.offsetOf(l, m) {
        Some(offset) -> {
            let widest = if A.isFrameAddress(op) { widestAddend } else { widestOffset }
            if offset > widest { Some(offset) } else { None }
        }
        None -> None
    }
    None -> None
}

-- -- terminators -------------------------------------------------------------

fun emitTerm(b : Code, d : Asm.Dialect, f : Func Inst,
             a : Regalloc.Allocation, l : Frame.Layout, tag : Int,
             edges : Array (Option A.Arm), exits : Array Bool, t : Term,
             next : Int) -> Unit =
    match t {
        -- The result into the register the convention answers in, then the
        -- frame comes down. Every return does its own epilogue, unlike the
        -- zero exits: a return is the hot way out, and a shared epilogue would
        -- cost it a branch to save the restores.
        -- Several results go in at once, as a jump's arguments do: one
        -- may be in the register another answers in.
        Ret(vs) -> {
            let dsts = Vec.fromArray(A.resultRegs(f.results))
            let srcs = Vec.map(vs, fun(v) = coloured(f, a, A.reg(v)))
            let at = b.at
            b.at = Position.notStmt(at)
            parallelMove(b, dsts, srcs)
            b.at = at
            epilogue(b, l)
        }
        -- An edge into an exit block passes nothing, since nothing reads it.
        Jump(target, args) -> if exits[Ssa.blockId(target)] {
            instruction(b, A.B(exitLabel(d, tag)))
        } else {
            let params = Ssa.blockAt(f, target).params
            let at = b.at
            b.at = Position.notStmt(at)
            copies(b, f, a, edges, params, args)
            -- After the copies, which may still read the registers these
            -- write, and which have finished with the scratch register a
            -- wide frame address takes.
            for var i = 0; i < len(params) && i < len(args); i = i + 1 {
                match edges[Ssa.valueId(args[i])] {
                    Some(op) -> emitInst(b, d, f, a, l, tag, Inst {
                        op = A.rewrite(op, fun(r) = renamed(r, args[i], params[i]),
                                       fun(m) = m),
                        at = b.at,
                    })
                    None -> {}
                }
            }
            b.at = at
            if Ssa.blockId(target) != next {
                instruction(b, A.B(blockLabel(d, tag, Ssa.blockId(target))))
            }
        }
        -- `cbnz` on the bit the comparison materialized. Whichever arm is the
        -- next block falls through; if neither is, both get a branch.
        Branch(c, yes, no) -> {
            let bit = coloured(f, a, A.reg(c))
            if Ssa.blockId(yes) == next {
                instruction(b, A.Cbz(bit, edgeTo(d, tag, exits, no), A.W32))
            } else {
                instruction(b, A.Cbnz(bit, edgeTo(d, tag, exits, yes), A.W32))
                if Ssa.blockId(no) != next {
                    instruction(b, A.B(edgeTo(d, tag, exits, no)))
                }
            }
        }
        -- Selection turns a panic into a call and an `Unreachable`, so one
        -- here is a selection bug rather than a shape to emit. `brk` says so
        -- at run time instead of falling into the next function.
        Panic(_) -> instruction(b, A.Brk(1))
        -- Selection turns a switch into comparisons, for the same reason.
        Switch(_, _, _) -> instruction(b, A.Brk(1))
        -- Not a trap: this is reached after a panic, or where the lowering
        -- proved no value arrives, and the zero a panic returns is the same
        -- claim made unexploitably.
        Unreachable -> instruction(b, A.B(exitLabel(d, tag)))
    }

-- Every result register zero, for a way out that answers nothing: null in a
-- traced one, which the collector skips. A double's zero is `fmov d0, xzr`:
-- `mov d0, xzr` is not an instruction.
fun zero(b : Code, f : Func Inst) -> Unit {
    for r in A.resultRegs(f.results) {
        match r {
            Physical(Fp, _) -> instruction(b, A.FMovIn(r, A.xzr))
            _ -> instruction(b, A.Mov(r, A.xzr, A.W64))
        }
    }
}

-- -- parallel copies ---------------------------------------------------------

-- A jump's arguments into its target's parameters, all at once.
--
-- They are simultaneous: `jump b1(%2, %1)` into parameters that happen to hold
-- the other's register is a swap, and doing the moves in order would write one
-- before reading it. So a move whose destination nothing else still needs to
-- read goes first, and when no such move is left the remainder is a cycle,
-- which one temporary breaks.
--
-- This is the one place the block-parameter design costs an algorithm, and it
-- is the same one every allocator that shuffles registers at a merge writes.
--
-- An argument the jump computes itself (`atEdges`) is no move's source, and
-- is left to the caller.
fun copies(b : Code, f : Func Inst, a : Regalloc.Allocation, edges : Array (Option A.Arm),
           params : Vec Value, args : Vec Value) -> Unit {
    let dsts : Vec Reg = []
    let srcs : Vec Reg = []
    for var i = 0; i < len(params) && i < len(args); i = i + 1 {
        if Option.isSome(edges[Ssa.valueId(args[i])]) { continue }
        let d = coloured(f, a, A.reg(params[i]))
        let s = coloured(f, a, A.reg(args[i]))
        Vec.push(dsts, d)
        Vec.push(srcs, s)
    }
    parallelMove(b, dsts, srcs)
}

-- Each of `srcs` into the register at the same index of `dsts`, all at once.
-- A pair already in one register needs no move.
fun parallelMove(b : Code, allDsts : Vec Reg, allSrcs : Vec Reg) -> Unit {
    let dsts : Vec Reg = []
    let srcs : Vec Reg = []
    for var i = 0; i < len(allDsts) && i < len(allSrcs); i = i + 1 {
        if !sameReg(allDsts[i], allSrcs[i]) {
            Vec.push(dsts, allDsts[i])
            Vec.push(srcs, allSrcs[i])
        }
    }
    let done = Array.filled(len(dsts), False)
    var left = len(dsts)
    while left > 0 {
        var moved = False
        for var i = 0; i < len(dsts); i = i + 1 {
            if !done[i] && !isSource(dsts[i], srcs, done) {
                move(b, dsts[i], srcs[i])
                done[i] = True
                left = left - 1
                moved = True
            }
        }
        if !moved {
            -- Every remaining destination is somebody's source: a cycle. Park
            -- *one* of them in the scratch register and the rest unwinds --
            -- parking each in turn writes the same register twice and loses
            -- the first, which is what the first version of this did.
            var parked = False
            for var i = 0; i < len(dsts); i = i + 1 {
                if !done[i] && !parked {
                    parked = True
                    let from = srcs[i]
                    let park = match from {
                        Physical(Fp, _) -> fpScratch
                        _ -> scratch
                    }
                    move(b, park, from)
                    for var k = 0; k < len(srcs); k = k + 1 {
                        if !done[k] && sameReg(srcs[k], from) {
                            srcs[k] = park
                        }
                    }
                }
            }
        }
    }
}

-- `r`, naming `to` where it named `from`.
fun renamed(r : Reg, from : Value, to : Value) -> Reg = match r {
    Virtual(n) -> if n == Ssa.valueId(from) { A.reg(to) } else { r }
    Physical(_, _) -> r
}

fun isSource(r : Reg, srcs : Vec Reg, done : Array Bool) -> Bool {
    for var i = 0; i < len(srcs); i = i + 1 {
        if !done[i] && sameReg(srcs[i], r) { return True }
    }
    False
}

fun sameReg(a : Reg, b : Reg) -> Bool = A.sameRegister(a, b)

-- A move between two registers of the same file, or across the files, which
-- `fmov` does without converting.
fun move(b : Code, d : Reg, s : Reg) -> Unit = match (d, s) {
    (Physical(Gp, _), Physical(Gp, _)) -> instruction(b, A.Mov(d, s, A.W64))
    (Physical(Fp, _), Physical(Fp, _)) -> instruction(b, A.FMov(d, s))
    (Physical(Gp, _), Physical(Fp, _)) -> instruction(b, A.FMovOut(d, s))
    (Physical(Fp, _), Physical(Gp, _)) -> instruction(b, A.FMovIn(d, s))
    _ -> emit(b, Comment("an unallocated register reached a parallel copy"))
}


-- -- data --------------------------------------------------------------------

-- The panic messages, which are the only data the functions name *locally*.
--
-- A local symbol -- one that never reaches the symbol table -- has
-- to be defined in the file that mentions it, which is what makes this part of
-- the function slice rather than of the module slice to come: without it the
-- assembler refuses the whole file. The globals and the root array are named
-- with ordinary symbols, so they can stay undefined until they are emitted.
--
-- `turkey_panic` takes a C string (`lib/Turkey/Process.gob`), so each one
-- ends in a zero.
fun emitMessages(asm : Asm.Asm, out : Vec (Item Inst)) -> Unit {
    let b = code(out, False, asm.dialect)
    let ordered = byIndex(asm.messages)
    if len(ordered) == 0 { return }
    emit(b, Section(Asm.CStrings))
    for var i = 0; i < len(ordered); i = i + 1 {
        emit(b, Label(Asm.messageName(asm.dialect, ordered[i])))
        emit(b, CString(ordered[i]))
    }
}

-- -- the module's data -------------------------------------------------------

-- What a function is not: the static object behind each string literal, the
-- storage behind each global, and the permanent root array that holds the
-- traced globals.
--
-- Every name and every slot here was decided by `Turkey.Asm` before selection
-- ran, which is what lets `ConstString` name literal *n* long before anything
-- defined it.
fun emitData(m : Module, asm : Asm.Asm, sites : Int, out : Vec (Item Inst)) -> Unit {
    let b = code(out, False, asm.dialect)
    emitLiterals(asm, b)
    emit(b, Section(Asm.Data))
    -- A build that counts allocations (`Turkey.Sites`): the number of sites,
    -- then a counter for each.
    if sites > 0 {
        emit(b, Align(3))
        emit(b, Label(Asm.runtimeFor(asm.dialect, "turkey_alloc_sites")))
        emit(b, Word(sites))
        emit(b, Space(8 * sites))
        emit(b, Label(Asm.localLabel(asm.dialect, "alloc_sites_file")))
        emit(b, Bytes(Sites.counterFile))
        emit(b, CString(""))
    }
    -- An untraced global is a word of ordinary storage. A traced one is a slot
    -- of the root array instead -- storing to it and rooting it are the same
    -- store -- so this defines nothing for it.
    for (name, r) in m.globals {
        match Asm.globalSlot(asm, name) {
            Some(_) -> {}
            None -> {
                emit(b, Align(3))
                emit(b, Label(Asm.globalSymbol(asm.dialect, name)))
                emit(b, Word(0))
            }
        }
    }
    emit(b, Align(3))
    emit(b, Label(Asm.rootsSymbol(asm.dialect)))
    -- At least one word even when the module roots nothing: the entry sequence
    -- hands this address to `turkey_root_enter`, which refuses a null one, and
    -- a symbol with no storage is a symbol that may land on top of the next.
    let bytes = if asm.roots > 0 { 8 * asm.roots } else { 8 }
    emit(b, Space(bytes))
    emit(b, Align(3))
    emit(b, Label(Asm.globalsFrame(asm.dialect)))
    -- The `RootFrame` covering it: previous, function_name, count, values,
    -- live. Five words, in the layout `lib/Turkey/Heap.gob` reads.
    emit(b, Space(40))
    -- Defined by every program, and visible to C: `Turkey.Runtime.processState`.
    let processState = Asm.runtimeFor(asm.dialect, Rt.processState)
    emit(b, Global(processState))
    emit(b, Align(3))
    emit(b, Label(processState))
    emit(b, Space(Rt.processStateBytes))
}

-- Each literal as a static object: a byte array laid out as
-- `turkey_string_new` lays one out -- header, length, bytes -- so that a
-- `String` a literal reads as is the same as one built at run time. They are
-- contiguous, between `Asm.staticStart` and `Asm.staticEnd`, which is the
-- range the entry sequence registers with the collector.
--
-- In writable data rather than read-only: an `Array Byte` can be cast from a
-- `String`, and a write through it would fault in read-only memory.
--
-- Not the section the panic messages go in, where a format has one of its own
-- for NUL-terminated C strings: and a Turkey string is bytes and a length: it may
-- contain a zero byte, and there is no terminator to write.
fun emitLiterals(asm : Asm.Asm, b : Code) -> Unit {
    let ordered = byIndex(asm.literals)
    if len(ordered) == 0 { return }
    emit(b, Section(Asm.Data))
    emit(b, Align(3))
    emit(b, Label(Asm.staticStart(asm.dialect)))
    let header = Rt.staticHeaderWord(Rt.arrayKind, Rt.layoutCode(Ssa.untraced(I8)), 0)
    for var i = 0; i < len(ordered); i = i + 1 {
        emit(b, Align(3))
        emit(b, Label(Asm.literalName(asm.dialect, i)))
        emit(b, Word(header))
        emit(b, Word(byteLength(ordered[i])))
        emit(b, Bytes(ordered[i]))
    }
    emit(b, Align(3))
    emit(b, Label(Asm.staticEnd(asm.dialect)))
}

-- A `text -> index` interning table as an array in index order.
fun byIndex(table : Map.Map String Int) -> Vec String {
    let out : Vec String = []
    for _ in Map.entries(table) { Vec.push(out, "") }
    for (text, index) in Map.entries(table) { out[index] = text }
    out
}

-- -- the entry sequence ------------------------------------------------------

-- `turkey_swap_stack(from, to)`, the code `Prim.swapStack` calls: park the
-- running stack on the stack record in `x0` and resume the one in `x1`.
--
-- Parking pushes a frame record, the caller's `x29` and the return address
-- the `bl` left in `x30`, and stores its address in `from`'s parked word.
-- That record has exactly the shape a call leaves, so the collector's walk
-- of a parked stack starts there and finds the caller's roots through the
-- frame table entry of the return address, as at any call site; and resuming
-- is the same steps the other way round, ending in a `ret` to the return
-- address the other stack parked with.
--
-- Its frame rules are exact at every instruction on both formats, and so on
-- Mach-O they are a DWARF description rather than a compact encoding. The
-- CFA is `sp + 16` from the record's stores to its loads, across the switch
-- of `sp` as well: the record parked on the other stack has the same shape,
-- so a stop just after the switch shows the stack being resumed.
--
-- It saves no register but the record: the call preserves none
-- (`A.PreservesNone`), so the caller has already put everything it needs
-- after the call in its frame. The worker's running stack changes here and
-- nowhere else, between the two stacks, so nothing that can collect ever sees
-- it name the wrong one. `x16` and `x17` are the scratch registers, which the allocator
-- never hands out.
fun emitSwapStack(asm : Asm.Asm, out : Vec (Item Inst)) -> Unit {
    let b = code(out, False, asm.dialect)
    let d = asm.dialect
    let x1 = Physical(Gp, 1)
    let x16 = Physical(Gp, 16)
    emit(b, Section(Asm.Text))
    function(b, Asm.runtimeFor(d, Rt.swapStackSymbol))
    cfi(b, StartProc)
    instruction(b, A.SubImm(A.sp, A.sp, 16, A.W64))
    cfi(b, DefCfaOffset(16))
    instruction(b, A.Str(A.fp, Offset(A.sp, 0), A.W64))
    cfi(b, SavedAt(fpColumn, -16))
    instruction(b, A.Str(A.lr, Offset(A.sp, 8), A.W64))
    cfi(b, SavedAt(lrColumn, -8))
    instruction(b, A.AddImm(x16, A.sp, 0, A.W64))
    instruction(b, A.Str(x16, Offset(A.x0, Rt.stackParked), A.W64))
    instruction(b, A.Str(x1, Offset(A.worker, Rt.workerRunningStack), A.W64))
    instruction(b, A.Ldr(x16, Offset(x1, Rt.stackParked), A.W64))
    instruction(b, A.Str(A.xzr, Offset(x1, Rt.stackParked), A.W64))
    instruction(b, A.AddImm(A.sp, x16, 0, A.W64))
    instruction(b, A.Ldr(A.fp, Offset(A.sp, 0), A.W64))
    cfi(b, Restored(fpColumn))
    instruction(b, A.Ldr(A.lr, Offset(A.sp, 8), A.W64))
    cfi(b, Restored(lrColumn))
    instruction(b, A.AddImm(A.sp, A.sp, 16, A.W64))
    cfi(b, DefCfaOffset(0))
    instruction(b, A.Ret)
    cfi(b, EndProc)
}

-- `turkey_stack_start`, where a new coroutine stack's first switch lands:
-- `Turkey.Stack.new` parks the stack with a return into here, `x29` at
-- the stack's outermost frame record and `sp` at a word naming the stack's
-- own record.
--
-- It calls `Turkey.Coroutine#start` as a direct call is made, with no
-- environment, and when that returns -- the body finished, or a panic
-- unwound to the bottom of the stack -- switches to the stack that resumed
-- this one, for the last time: nothing resumes a stack whose body has
-- returned, and the `brk` says so if something does. `sp` is where it was on
-- the way in, since the callee restores it, so the word is still there.
--
-- It is the outermost frame of the coroutine's stack, and its frame rules say
-- so: an unwinder stops here, at the coroutine's base, as the collector's walk
-- does, and not at whatever resumed it. On ELF the return address is
-- undefined, the convention for an outermost frame. On Mach-O frame mode
-- describes the record `x29` already points at, whose return address is 0.
fun emitStackStart(asm : Asm.Asm, out : Vec (Item Inst)) -> Unit {
    let b = code(out, False, asm.dialect)
    let d = asm.dialect
    let x1 = Physical(Gp, 1)
    emit(b, Section(Asm.Text))
    function(b, Asm.runtimeFor(d, Rt.stackStartSymbol))
    cfi(b, StartProc)
    match d {
        Asm.Elf -> cfi(b, Undefined(lrColumn))
        Asm.MachO -> frameMode(b, [])
    }
    instruction(b, A.Mov(A.x0, A.xzr, A.W64))
    instruction(b, A.Bl(Asm.symbolFor(d, Rt.coroutineStart), A.Standard))
    instruction(b, A.Ldr(A.x0, Offset(A.sp, 0), A.W64))
    instruction(b, A.Ldr(x1, Offset(A.x0, Rt.stackResumedBy), A.W64))
    call(b, d, Rt.swapStackSymbol)
    instruction(b, A.Brk(1))
    cfi(b, EndProc)
}

-- `turkey_worker_start(record)`, a worker thread's start routine for
-- `pthread_create`: the worker's record in `x28`, then its Turkey code
-- (`Turkey.Runtime.workerRun`), called as a direct call is made, with no
-- environment. That returns only when a panic unwound it, which
-- `turkey_worker_ended` hands to the main worker, through its Turkey entry so
-- that `x28` is still this worker's. A full frame record, so that the worker's
-- stack has an outermost one, and `x28` saved, since C keeps it.
fun emitWorkerStart(asm : Asm.Asm, out : Vec (Item Inst)) -> Unit {
    let b = code(out, False, asm.dialect)
    let d = asm.dialect
    emit(b, Section(Asm.Text))
    function(b, Asm.runtimeFor(d, Rt.workerStartSymbol))
    cfi(b, StartProc)
    frameFromC(b)
    instruction(b, A.Mov(A.worker, A.x0, A.W64))
    instruction(b, A.Mov(A.x0, A.xzr, A.W64))
    instruction(b, A.Bl(Asm.symbolFor(d, Rt.workerRun), A.Standard))
    instruction(b, A.Bl(Asm.turkeyEntry(d, "turkey_worker_ended"), A.Standard))
    instruction(b, A.Mov(A.x0, A.xzr, A.W64))
    returnToC(b)
    cfi(b, EndProc)
}

-- What has to happen before the program's own code, and `main`.
--
-- Giblet globals are computed before root registration and allocation. Then
-- the root array is registered, literals are interned into it, and the
-- ordinary initializer runs before main. Its values may use those literals.
--
-- `Turkey.Entry` wraps the lot -- argument handling, the panic report and the
-- final collection are written once, in Turkey, rather than emitted here in two
-- backends -- and reaches this by its C symbol. `turkey_entry_returned`, at the
-- end, parks the program's ending where the entry's own code will not unwind
-- on it.
fun emitEntry(asm : Asm.Asm, m : Module, main : String, sites : Int,
              out : Vec (Item Inst)) -> Unit {
    let b = code(out, False, asm.dialect)
    let d = asm.dialect
    emit(b, Section(Asm.Text))
    function(b, Asm.entrySymbol(d))
    cfi(b, StartProc)
    -- A frame of its own, because everything below is a call. Thirty-two
    -- bytes: the record, and the alignment Apple requires.
    record(b, 32)
    frameMode(b, [])
    instruction(b, A.Bl(Asm.symbolFor(d, m.early), A.Standard))
    symbolInto(b, A.x0, Asm.runtimeFor(d, Rt.processState))
    instruction(b, A.Ldr(A.x0, Offset(A.x0, 0), A.W64))
    instruction(b, A.Cbnz(A.x0, Asm.localLabel(d, "entry_done"), A.W64))

    -- The outer bound of every walk of the program's own stack is this frame:
    -- every frame the program makes on it is below it, and its own roots are
    -- the globals frame's, not a table entry's. Recorded after early
    -- initialization, which is what sets up the state the bound is stored in.
    -- A coroutine's stack has a bound of its own (`Turkey.Stack.new`).
    instruction(b, A.Mov(A.x0, Physical(Gp, 29), A.W64))
    call(b, d, "turkey_entry_stack_set")

    -- The permanent frame, before anything allocates. It is never left: every
    -- traced global is live for the whole run, so the mask is all ones and
    -- this frame sits at the bottom of the chain until the process exits.
    symbolInto(b, A.x0, Asm.globalsFrame(d))
    symbolInto(b, Physical(Gp, 1), Asm.rootsSymbol(d))
    instruction(b, A.MovConst(Physical(Gp, 2), asm.roots))
    symbolInto(b, Physical(Gp, 3), Asm.messageSymbol(asm, "<globals>"))
    call(b, d, "turkey_root_enter")
    symbolInto(b, A.x0, Asm.globalsFrame(d))
    -- Not `mov x1, #-1`: `movn` is the instruction that spells it, and going
    -- through the assembler's alias would be one more thing to be wrong about.
    instruction(b, A.MovN(Physical(Gp, 1), 0))
    instruction(b, A.Str(Physical(Gp, 1), Offset(A.x0, 32), A.W64))

    -- The frame table, before anything allocates: a collection that cannot
    -- read the table sees no frame's roots at all.
    symbolInto(b, A.x0, Asm.frameTableSymbol(d))
    call(b, d, "turkey_frame_table_register")

    -- The literals' static objects, before any code that can read one runs.
    -- After early initialization, which sets the collector's range to empty;
    -- giblet code uses no literal.
    if len(asm.literals) > 0 {
        symbolInto(b, A.x0, Asm.staticStart(d))
        symbolInto(b, Physical(Gp, 1), Asm.staticEnd(d))
        call(b, d, "turkey_static_register")
    }

    instruction(b, A.Bl(Asm.symbolFor(d, m.initial), A.Standard))
    -- `main` takes the closure environment every Turkey function takes, and
    -- has none.
    instruction(b, A.Mov(A.x0, A.xzr, A.W64))
    instruction(b, A.Bl(Asm.symbolFor(d, main), A.Standard))
    emit(b, Label(Asm.localLabel(d, "entry_done")))
    if sites > 0 { writeSites(b, d, sites) }
    call(b, d, "turkey_entry_returned")
    unrecord(b, 32)
    cfi(b, EndProc)

    -- Early initialization, for a C caller that runs the program's Turkey
    -- code without running the program: the runtime's own C tests. It takes
    -- no environment, and comes in from C as a `foreign` definition does.
    function(b, Asm.runtimeFor(d, "turkey_giblets_initialize"))
    cfi(b, StartProc)
    enterFromC(b, d)
    instruction(b, A.Bl(Asm.symbolFor(d, m.early), A.Standard))
    returnToC(b)
    cfi(b, EndProc)

    -- `main` itself: `Turkey.Entry`'s, reached by its C symbol. `argv` is
    -- already in `x1`, and `argc` in `w0`, widened to the `Int` a foreign
    -- definition takes: AAPCS64 leaves the upper half of an `int` undefined.
    function(b, Asm.runtimeFor(d, "main"))
    cfi(b, StartProc)
    record(b, 16)
    frameMode(b, [])
    instruction(b, A.Sxtw(A.x0, A.x0))
    call(b, d, "turkey_main")
    unrecord(b, 16)
    cfi(b, EndProc)
}

-- A frame of `size` bytes with its record at the top, made with `sp` moved
-- once and then the record stored, as code that C calls makes it.
fun record(b : Code, size : Int) -> Unit {
    instruction(b, A.SubImm(A.sp, A.sp, size, A.W64))
    exactly(b, [DefCfaOffset(size)])
    instruction(b, A.Str(A.fp, Offset(A.sp, size - 16), A.W64))
    exactly(b, [SavedAt(fpColumn, -16)])
    instruction(b, A.Str(A.lr, Offset(A.sp, size - 8), A.W64))
    exactly(b, [SavedAt(lrColumn, -8)])
    instruction(b, A.AddImm(A.fp, A.sp, size - 16, A.W64))
    exactly(b, [DefCfa(fpColumn, 16)])
}

-- `record` undone, and the return.
fun unrecord(b : Code, size : Int) -> Unit {
    instruction(b, A.Ldr(A.fp, Offset(A.sp, size - 16), A.W64))
    exactly(b, [DefCfa(spColumn, size), Restored(fpColumn)])
    instruction(b, A.Ldr(A.lr, Offset(A.sp, size - 8), A.W64))
    exactly(b, [Restored(lrColumn)])
    instruction(b, A.AddImm(A.sp, A.sp, size, A.W64))
    exactly(b, [DefCfaOffset(0)])
    instruction(b, A.Ret)
}

-- The counters to `Sites.counterFile`, before the program's ending is
-- reported: `creat`, which is not variadic as `open` is, then one `write`.
fun writeSites(b : Code, d : Asm.Dialect, sites : Int) -> Unit {
    symbolInto(b, A.x0, Asm.localLabel(d, "alloc_sites_file"))
    instruction(b, A.MovConst(Physical(Gp, 1), 420))
    call(b, d, "creat")
    instruction(b, A.Sxtw(A.x0, A.x0))
    symbolInto(b, Physical(Gp, 1), Asm.runtimeFor(d, "turkey_alloc_sites"))
    instruction(b, A.MovConst(Physical(Gp, 2), 8 * (sites + 1)))
    call(b, d, "write")
}

-- The C-callable face of each `foreign` definition.
--
-- The body takes the environment every Turkey function takes, in `x0`, and C
-- passes its first argument there. So the general arguments move up one
-- register and `x0` becomes the null environment. Floating-point arguments are
-- in `d0`-`d7` either way and do not move. Seven general arguments at most,
-- which the front end checks, since the eighth register is the environment's.
--
-- And the body expects the running worker in `x28` (`A.worker`), which C does
-- not keep: to C, `x28` is a callee-saved register like any other. So the face
-- saves the caller's, sets the worker's, calls the body and puts the caller's
-- back. With one worker, the worker is the process state every program
-- defines; with several, it is the calling thread's.
--
-- That takes a frame, and it has to be a full frame record. When generated
-- code calls a face, the return address into it is what the collector looks
-- up to find that caller's roots, and the walk only reads return addresses
-- out of `x29` records: one saved anywhere else would hide the caller's roots
-- from every collection the body makes. The face's own return address, into
-- the body's caller, is in its record; the body's record, whose return
-- address is in the face and has no frame-table entry, is passed over.
--
-- Generated code calls the runtime's definitions too -- the allocation slow
-- paths, the write barrier, a poll -- and there `x28` is already the running
-- worker, which on another thread is not the one the face would set. So each
-- definition has a second entry for Turkey callers (`Asm.turkeyEntry`), which
-- moves the arguments the same way and branches to the body, leaving `x28`
-- and making no frame: the body's frame record then holds its Turkey
-- caller's return address, as at any call.
fun emitDefinitions(m : Module, asm : Asm.Asm, out : Vec (Item Inst)) -> Unit {
    let b = code(out, False, asm.dialect)
    for (sym, name) in m.definitions {
        for f in m.functions {
            if f.name == name {
                var general = 0
                for var i = 1; i < len(f.params); i = i + 1 {
                    match Ssa.repOf(f, f.params[i]).class_ {
                        F64 -> {}
                        _ -> { general = general + 1 }
                    }
                }
                function(b, Asm.runtimeFor(asm.dialect, sym))
                cfi(b, StartProc)
                enterFromC(b, asm.dialect)
                shiftArguments(b, general)
                instruction(b, A.Bl(Asm.symbolFor(asm.dialect, name), A.Standard))
                returnToC(b)
                cfi(b, EndProc)
                -- No frame, and so no rules: the return address is in `x30`
                -- throughout.
                emit(b, Label(Asm.turkeyEntry(asm.dialect, sym)))
                cfi(b, StartProc)
                shiftArguments(b, general)
                instruction(b, A.B(Asm.symbolFor(asm.dialect, name)))
                cfi(b, EndProc)
            }
        }
    }
}

-- C's arguments, in `x0` up, moved up one register to make way for the null
-- environment a Turkey function takes in `x0`.
fun shiftArguments(b : Code, general : Int) -> Unit {
    for var k = general; k > 0; k = k - 1 {
        instruction(b, A.Mov(Physical(Gp, k), Physical(Gp, k - 1), A.W64))
    }
    instruction(b, A.Mov(A.x0, A.xzr, A.W64))
}

-- The way into Turkey code from C, and back: a frame record, the caller's
-- `x28` saved and the worker's set (`emitDefinitions` says why both). Leaves
-- every argument register as it found it.
fun enterFromC(b : Code, d : Asm.Dialect) -> Unit {
    frameFromC(b)
    symbolInto(b, A.worker, Asm.runtimeFor(d, Rt.processState))
}

-- The frame record, and the caller's `x28` below it, stored with `x27` as a
-- pair: `x27` at `x29 - 8` and `x28` at `x29 - 16` is the shape compact
-- unwind's frame mode describes for the pair (`saves`). Only `x28` comes back
-- (`returnToC`); `x27` is one the body preserves.
fun frameFromC(b : Code) -> Unit {
    record(b, 32)
    instruction(b, A.Stp(A.worker, Physical(Gp, 27), A.sp, 0))
    exactly(b, [SavedAt(column(A.worker), -32)])
    frameMode(b, [(Gp, 27)])
}

fun returnToC(b : Code) -> Unit {
    instruction(b, A.Ldr(A.worker, Offset(A.sp, 0), A.W64))
    exactly(b, [Restored(column(A.worker))])
    unrecord(b, 32)
}

-- A symbol's address, in a register: the page, then the offset within it.
-- The same pair `Turkey.Select.address` emits, for code the emitter writes
-- itself rather than code selection chose.
fun symbolInto(b : Code, r : Reg, sym : Asm.Symbol) -> Unit {
    instruction(b, A.Adrp(r, sym))
    instruction(b, A.AddLo(r, r, sym))
}

fun call(b : Code, d : Asm.Dialect, name : String) -> Unit =
    instruction(b, A.Bl(Asm.runtimeFor(d, name), A.Standard))

-- A store through a register base, with the offset in `scratch` when the
-- immediate does not reach. `boot` interns thousands of literals, so the root
-- array is past 32,760 bytes long before the corpus is.
fun storeAt(b : Code, r : Reg, base : Reg, offset : Int) -> Unit {
    if offset <= widestOffset {
        instruction(b, A.Str(r, Offset(base, offset), A.W64))
        return
    }
    instruction(b, A.MovConst(scratch, offset))
    instruction(b, A.Str(r, Indexed(base, scratch), A.W64))
}

-- A string's length in bytes, which is what `turkey_string_new` is given.
-- Counted rather than measured: `String.bytes` answers a `Bytes`, which has no
-- `len`.
fun byteLength(text : String) -> Int {
    var n = 0
    for _ in String.bytes(text) { n = n + 1 }
    n
}

-- -- the frame table ---------------------------------------------------------

-- Every safepoint's live roots, keyed by return address.
--
-- The emitter cannot sort this: the addresses do not exist until the linker
-- has run, and all it can write is a word naming the label, for the linker to
-- relocate. So the runtime owns the lookup structure, which is OCaml's
-- division and the one LLVM states outright -- the compiler's format is for
-- getting the facts across, not for being queried.
--
-- The offsets are from `x29`, signed, and `Turkey.Frame.layout` has been
-- computing them since phase 4.
fun emitFrameTable(asm : Asm.Asm, layouts : Vec (Int, Frame.Layout),
                   out : Vec (Item Inst)) -> Unit {
    let b = code(out, False, asm.dialect)
    let d = asm.dialect
    emit(b, Section(Asm.Relocated))
    emit(b, Align(3))
    emit(b, Global(Asm.frameTableSymbol(d)))
    emit(b, Label(Asm.frameTableSymbol(d)))
    var n = 0
    for (_, l) in layouts { n = n + len(l.maps) }
    emit(b, Word(n))
    for (tag, l) in layouts {
        for m in l.maps {
            emit(b, WordOf(safepointLabel(d, tag, m.block, m.index)))
            emit(b, Word(len(m.offsets)))
            for o in m.offsets { emit(b, Word(o)) }
        }
    }
}
