export (run)

-- Reading out the evidence the solver produced, once solving is over.
--
-- The solver fills a hole for each wanted class predicate as it discharges it
-- (`Turkey.Solved.Hole`), so the evidence for a use is already decided: here
-- the holes are read out into the immutable `Classes.Evidence` the lowering
-- translates, as GHC zonks its mutable evidence bindings into immutable ones.
-- Nothing here resolves a predicate, consults a given or reduces a family.
--
-- The one derivation left is an instance's superclass dictionaries, which no
-- use asks for: `Classes.prove` builds them from the instance's context, the
-- same entailment `Classes.checkInstance` accepted the instance with.

import Turkey.Ast (InstanceDecl(..))
import Turkey.Classes as Classes
import Turkey.Classes (ClassTable(..), ClassInfo(..), InstInfo(..),
                       InstancePlan(..), Evidence(..))
import Turkey.Decls as Decls
import Turkey.Diag as Diag
import Turkey.Prelude as P
import Turkey.Solved (Use(..), Hole(..), Proof(..), dictName)
import Turkey.Source (Span(..))
import Turkey.Types as Ty
import Turkey.Types (Pred(..), TBottom)

fun run(classes : ClassTable, uses : Vec Use) -> Unit {
    completeInstances(classes)
    for u in uses {
        u.method = Classes.method(classes, u.name)
        let evidence = Vec.new(len(u.holes))
        for var i = 0; i < len(u.holes); i = i + 1 {
            Vec.push(evidence, readOut(u.holes[i], fun() = u.preds[i], u.span))
        }
        u.evidence = evidence
    }
}

-- Returns the evidence in `hole`, with every hole below it read out too.
-- `wanted` returns the predicate the hole is for, for the internal error an
-- empty hole is.
fun readOut(hole : Hole, wanted : fun() -> Pred, where : Option Span) -> Evidence =
    match hole.proof {
        Some(ByGiven(name, path, given)) -> FromDict(name, path, Some(given))
        Some(ByInstance(inst, mapping, holes)) -> FromInstance(inst, mapping,
            Array.init(len(holes), fun(i) = readOut(holes[i],
                fun() = Classes.contextAt(inst, mapping)[i], where)))
        Some(ByNothing(cls)) -> Absent(cls)
        Some(Same(other)) -> readOut(other, wanted, where)
        -- Solving finished without an error, so it discharged every wanted.
        None -> oops("no evidence for '" + Ty.showPred(wanted()) + "', which solving "
                     + "had already accepted", where)
    }

-- Fill in each instance's superclass dictionaries and default methods.
--
-- A default body is elaborated once, by the generator, and shared by every
-- instance that does not override it -- the class's own dictionary name is
-- rebound per instance when the dictionary is built, which is the whole of what
-- makes one body serve them all.
fun completeInstances(classes : ClassTable) -> Unit {
    for (_, insts) in Map.entries(classes.instances) {
        for inst in insts {
            if Classes.isGenerated(inst.cls) {
                -- A generated field accessor has no superclasses and no
                -- written body: the lowering builds `get` and `set` out of the
                -- primitive `CProject` the class is the interface to. There is
                -- nothing here to complete.
                inst.plan = Some(Classes.newInstancePlan(Vec.new(1)))
                continue
            }
            match inst.plan {
                None -> if inst.cls == P.typedClass {
                    -- A derived `Typed` instance never passed through the
                    -- generator, so nothing has given it a plan. Its context is
                    -- its head's parameters -- `Typed (Map k v)` wants `Typed k`
                    -- and `Typed v` -- so the dictionary is a function of those,
                    -- named the way the generator names them. There is no body
                    -- to complete either: the lowering writes `typeRep` out of
                    -- the head's own name, which is the one thing the surface
                    -- language could not have said.
                    let params = Vec.new(len(inst.context))
                    for q in inst.context { Vec.push(params, dictName(q.name)) }
                    inst.plan = Some(Classes.newInstancePlan(params))
                    continue
                }
                Some(_) -> {}
            }
            let info = match Map.get(classes.classes, inst.cls) {
                Some(i) -> i
                None -> oops("unknown class '" + inst.cls + "'", None)
            }
            let plan = match inst.plan {
                Some(p) -> p
                None -> oops("instance '" + inst.cls
                             + "' was never given a plan", Some(inst.decl.span))
            }
            let givens = Vec.new(len(plan.params))
            for var i = 0; i < len(plan.params) && i < len(inst.context); i = i + 1 {
                Vec.push(givens, (plan.params[i], inst.context[i]))
            }
            for sup in info.supers {
                let demand = Ty.pred(sup.name, [inst.head])
                match Classes.prove(classes, givens, demand) {
                    Some(ev) -> Map.put(plan.supers, sup.name, ev)
                    -- `checkInstance` refused the instance, and with it the
                    -- program, if its context does not imply this.
                    None -> oops("no evidence for '" + Ty.showPred(demand) + "'",
                                 Some(inst.decl.span))
                }
            }
            for (name, _) in Map.entries(info.methods) {
                if !Map.contains(plan.methods, name) {
                    match Map.get(info.defaults, name) {
                        Some(impl) -> Map.put(plan.methods, name, impl)
                        None -> {}
                    }
                }
            }
        }
    }
}

-- Every check here is one that only a compiler bug can fail: solving has
-- already accepted the program.
fun oops(message : String, where : Option Span) -> a = match where {
    None -> Diag.fail(Diag.whole("internal error", message), "")
    Some(s) -> Diag.fail(Diag.at("internal error", message, s), s.file)
}
