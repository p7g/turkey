export (Witness(..), check, checkPattern, covers, reach, render)

--- Pattern-matching exhaustiveness checking.
---
--- Maranget's usefulness algorithm ("Warnings for pattern matching", JFP 2007) in
--- its witness-producing form, so a warning can name a value the match does not
--- handle rather than merely saying one exists.
---
--- A non-exhaustive match is an error, and so is a refutable binding pattern.
--- The check runs after inference, when every scrutinee type is known.

import Turkey.Ast (..)
import Turkey.Ast as Ast
import Turkey.Decls as Decls
import Turkey.Diag as Diag
import Turkey.Decls (DeclTable(..), ConInfo(..), TyconInfo(..))
import Turkey.Types as Ty
import Turkey.Types (TVar, TCon, TApp, TFam, TFun, TTuple)

--- The shapes the algorithm understands. Not the surface patterns: a record
--- pattern is reordered into declaration order and filled out with wildcards, so
--- that every row for a constructor has the same width.
type Witness
	= WWild
	| WCon(String, Array Witness)
	| WTuple(Array Witness)
	| WLit(Ast.Lit)
	--- Alternatives. Only ever in a row of the matrix, never in a witness
	--- `witness` returns: `expandOrs` splits a row on one before its first
	--- column is looked at.
	| WOr(Array Witness)

fun normalize(p : Pat, decls : DeclTable) -> Witness = normalizeWith(p, decls, noChoices)

let noChoices : Map Int (Vec Int) = Map.new()

-- `normalize`, except that an alternatives pattern whose id `chosen` holds
-- keeps only the alternatives at the indices it gives, which are never none.
fun normalizeWith(p : Pat, decls : DeclTable, chosen : Map Int (Vec Int)) -> Witness =
	match p.kind {
		PVar(_)                          -> WWild
		PWild                            -> WWild
		PAnnot(inner, _) | PParen(inner) -> normalizeWith(inner, decls, chosen)
		POr(alts) -> match Map.get(chosen, p.id) {
			Some(kept) -> if len(kept) == 1 {
				normalizeWith(alts[kept[0]], decls, chosen)
			} else {
				WOr(Array.map(kept, \normalizeWith(alts[_], decls, chosen)))
			}
			None -> WOr(Array.map(alts, normalizeWith(_, decls, chosen)))
		}
		PLit(l, _)       -> WLit(l)
		PTuple(elems)    -> WTuple(Array.map(elems, normalizeWith(_, decls, chosen)))
		PCon(name, args) -> WCon(name, Array.map(args, normalizeWith(_, decls, chosen)))
		PRecord(name, fields, _) -> {
			-- Reorder the fields into declaration order and fill in the ones the
			-- pattern left out, so every row for a constructor has the same width.
			let supplied = Map.new()
			for (label, sub) in fields { Map.put(supplied, label, sub) }
			let args = match Decls.con(decls, name) {
				Some(info) -> match info.fields {
					Some(names) -> Array.map(names, fun(n) = match Map.get(supplied, n) {
						Some(sub) -> normalizeWith(sub, decls, chosen)
						None      -> WWild
					})
					None -> []
				}
				None -> []
			}
			WCon(name, args)
		}
	}

-- The head constructor a pattern tests for, compared by `sameKey`. Encoding it
-- as a string would mean parsing it back out, which is how a key stops being a
-- key.
type Key
	= KNone
	| KCon(String)
	| KTuple(Int)
	| KLit(String, String)

fun keyOf(w : Witness) -> Key = match w {
	WWild         -> KNone
	WCon(name, _) -> KCon(name)
	WTuple(elems) -> KTuple(len(elems))
	WLit(l)       -> KLit(Ast.litKind(l), litText(l))
	WOr(_)        -> oops("keyOf: alternatives that were not expanded")
}

fun sameKey(a : Key, b : Key) -> Bool = match (a, b) {
	(KNone, KNone)               -> True
	(KCon(x), KCon(y))           -> x == y
	(KTuple(x), KTuple(y))       -> x == y
	(KLit(k1, v1), KLit(k2, v2)) -> k1 == k2 && v1 == v2
	_                            -> False
}

fun isNone(k : Key) -> Bool = match k {
	KNone -> True
	_     -> False
}

fun holdsKey(keys : Vec Key, wanted : Key) -> Bool {
	for k in keys {
		if sameKey(k, wanted) { return True }
	}
	False
}

fun litText(l : Ast.Lit) -> String = match l {
	LInt(n)    -> Int.toString(n)
	LFloat(f)  -> Float.toString(f)
	LString(s) -> s
	LChar(c)   -> Char.toString(c)
}

-- -- type-directed signature information --------------------------------------------

-- Every head constructor of a type, or `None` when there are too many. `Int`,
-- `String` and friends have unboundedly many values, so a column of them is only
-- covered by a wildcard.
fun signature(decls : DeclTable, t : Ty.Type) -> Option (Array Key) {
	if let TTuple(elems) = Ty.prune(t) {
		return Some([KTuple(len(elems))])
	}
	match Ty.headCon(t) {
		None -> None
		Some(name) -> match Map.get(decls.tycons, name) {
			None -> None
			Some(info) -> {
				if len(info.variants) == 0 { return None }
				-- `Bool` needs no special case: it is `type Bool = False | True`
				-- in the Prelude, so its two variants come out of this table
				-- like any other type's.
				Some(Array.map(info.variants, \KCon(_.name)))
			}
		}
	}
}

-- The column types produced by specializing a column of this type on this key.
fun subTypes(decls : DeclTable, key : Key, t : Ty.Type) -> Array Ty.Type =
	match key {
		KTuple(_) -> match Ty.prune(t) {
			TTuple(elems) -> elems
			_             -> []
		}
		KLit(_, _) -> []
		KNone      -> []
		KCon(name) -> {
			-- Exhaustiveness runs after solving, so these variables belong to no
			-- pool: they exist only to carry the constructor's field types into
			-- the unification below, and are discarded with it. They are
			-- unranked because the scrutinee's type may mention a signature's
			-- skolems, which keep their rank.
			match Decls.instantiateCon(decls, name, fun() = Ty.freshVar(Ty.unranked), None) {
				TFun(params, ret) -> {
					-- The pattern already type-checked, so this only propagates
					-- the scrutinee's arguments into the field types.
					Ty.unify(ret, t, None, "", None)
					params
				}
				_ -> []
			}
		}
	}

fun keyArity(decls : DeclTable, key : Key, t : Ty.Type) -> Int = match key {
	KTuple(n)  -> n
	KLit(_, _) -> 0
	KNone      -> 0
	KCon(name) -> match Decls.con(decls, name) {
		Some(info) -> info.arity
		None       -> 0
	}
}

fun rebuild(key : Key, args : Array Witness) -> Witness = match key {
	KTuple(_)     -> WTuple(args)
	KLit(kind, _) -> WWild
	KNone         -> WWild
	KCon(name)    -> WCon(name, args)
}

-- -- the algorithm ------------------------------------------------------------------

-- A row of patterns no row of the matrix covers, or `None` if it is exhaustive.
fun witness(
	decls : DeclTable,
	matrix : Vec (Array Witness),
	types : Array Ty.Type,
) -> Option (Array Witness) {
	if len(types) == 0 {
		return if len(matrix) > 0 { None } else { Some([]) }
	}
	let matrix = expandOrs(matrix)
	let headType = types[0]
	let restTypes = Array.slice(types, 1, len(types))
	let used = Vec.new(4)
	for row in matrix {
		let k = keyOf(row[0])
		if !isNone(k) && !holdsKey(used, k) { Vec.push(used, k) }
	}
	let sig = signature(decls, headType)

	if let Some(keys) = sig {
		var complete = True
		for k in keys {
			if !holdsKey(used, k) { complete = False }
		}
		if complete {
			-- The match is exhaustive only if it is exhaustive under every
			-- constructor.
			for k in keys {
				let (specialized, argTypes) = specialize(decls, matrix, k, headType)
				if let Some(found) = witness(
					decls,
					specialized,
					Array.append(argTypes, restTypes),
				) {
					let width = len(argTypes)
					let built = rebuild(k, Array.slice(found, 0, width))
					return Some(
						Array.append([built], Array.slice(found, width, len(found))),
					)
				}
			}
			return None
		}
	}

	-- Incomplete: a value built from a constructor nobody tested reaches the
	-- default matrix, so recurse there and report one of the missing heads.
	let default_ = Vec.new(len(matrix))
	for row in matrix {
		if isNone(keyOf(row[0])) {
			Vec.push(default_, Array.slice(row, 1, len(row)))
		}
	}
	match witness(decls, default_, restTypes) {
		None -> None
		Some(found) -> {
			let missing = match sig {
				None -> WWild
				Some(keys) -> {
					var chosen = WWild
					var picked = False
					for k in keys {
						if !holdsKey(used, k) && !picked {
							picked = True
							chosen = rebuild(k, wilds(keyArity(decls, k, headType)))
						}
					}
					chosen
				}
			}
			Some(Array.append([missing], found))
		}
	}
}

fun wilds(n : Int) -> Array Witness = Array.filled(n, WWild)

-- Whether some value matches `row` and no row of `matrix`: Maranget's
-- usefulness, U(P, q), over the same specialization `witness` uses.
fun useful(
	decls : DeclTable,
	matrix : Vec (Array Witness),
	row : Array Witness,
	types : Array Ty.Type,
) -> Bool {
	if len(types) == 0 { return len(matrix) == 0 }
	let matrix = expandOrs(matrix)
	let headType = types[0]
	let restTypes = Array.slice(types, 1, len(types))
	let rest = Array.slice(row, 1, len(row))
	match row[0] {
		WOr(alts) -> Iter.any(
			alts,
			fun(alt) = useful(decls, matrix, Array.append([alt], rest), types),
		)
		WWild -> {
			let used = Vec.new(4)
			for r in matrix {
				let k = keyOf(r[0])
				if !isNone(k) && !holdsKey(used, k) { Vec.push(used, k) }
			}
			-- A wildcard reaches a value the matrix misses under some
			-- constructor when the matrix tests every one, and otherwise
			-- exactly when it does after the rows that test none.
			if let Some(keys) = signature(decls, headType) {
				if Iter.all(keys, holdsKey(used, _)) {
					return Iter.any(keys, fun(k) {
						let (specialized, argTypes) = specialize(decls, matrix, k, headType)
						useful(
							decls,
							specialized,
							Array.append(wilds(len(argTypes)), rest),
							Array.append(argTypes, restTypes),
						)
					})
				}
			}
			let default_ = Vec.new(len(matrix))
			for r in matrix {
				if isNone(keyOf(r[0])) { Vec.push(default_, Array.slice(r, 1, len(r))) }
			}
			useful(decls, default_, rest, restTypes)
		}
		head -> {
			let (specialized, argTypes) = specialize(decls, matrix, keyOf(head), headType)
			let args = match head {
				WCon(_, a)    -> a
				WTuple(elems) -> elems
				_             -> []
			}
			useful(decls, specialized, Array.append(args, rest), Array.append(argTypes, restTypes))
		}
	}
}

-- `matrix` with each row whose first pattern is alternatives replaced by one
-- row per alternative, in order: a row `(p | q) rest` covers what `p rest` and
-- `q rest` cover together. Only the first column is split, so alternatives
-- deeper in a row are split when specialization brings them to the front,
-- and only along the paths that reach them.
fun expandOrs(matrix : Vec (Array Witness)) -> Vec (Array Witness) {
	let out = Vec.new(len(matrix))
	for row in matrix { pushExpanded(out, row[0], Array.slice(row, 1, len(row))) }
	out
}

fun pushExpanded(out : Vec (Array Witness), head : Witness, rest : Array Witness) -> Unit =
	match head {
		WOr(alts) -> for alt in alts { pushExpanded(out, alt, rest) }
		_         -> Vec.push(out, Array.append([head], rest))
	}

fun specialize(decls : DeclTable, matrix : Vec (Array Witness), key : Key, headType : Ty.Type) -> (
	Vec (Array Witness),
	Array Ty.Type,
) {
	let argTypes = subTypes(decls, key, headType)
	let width = len(argTypes)
	let rows = Vec.new(len(matrix))
	for row in matrix {
		let h = row[0]
		let rest = Array.slice(row, 1, len(row))
		let k = keyOf(h)
		if isNone(k) {
			Vec.push(rows, Array.append(wilds(width), rest))
		} else if sameKey(k, key) {
			let args = match h {
				WCon(_, a)    -> a
				WTuple(elems) -> elems
				_             -> []
			}
			Vec.push(rows, Array.append(args, rest))
		}
	}
	(rows, argTypes)
}

-- -- reporting ----------------------------------------------------------------------

--- The witness a match fails to handle, rendered, or `None` when it is
--- exhaustive.
fun check(decls : DeclTable, arms : Vec Arm, scrutinee : Ty.Type) -> Option String {
	let matrix = Vec.new(8)
	for arm in arms {
		-- An arm with a guard may decline any value its patterns match, so it
		-- covers none of them.
		if len(arm.guards) == 0 {
			for p in arm.patterns { Vec.push(matrix, [normalize(p, decls)]) }
		}
	}
	match witness(decls, matrix, [scrutinee]) {
		None        -> None
		Some(found) -> Some(render(found[0]))
	}
}

--- A value one binding pattern does not match, or `None` when it is irrefutable:
--- the one-row case of `check`.
fun checkPattern(decls : DeclTable, p : Pat, scrutinee : Ty.Type) -> Option String {
	match witness(decls, [[normalize(p, decls)]], [scrutinee]) {
		None        -> None
		Some(found) -> Some(render(found[0]))
	}
}

--- Returns whether `patterns`, as alternatives, together match every value of
--- `scrutinee`.
fun covers(decls : DeclTable, patterns : Vec Pat, scrutinee : Ty.Type) -> Bool {
	let row = [WOr(Array.map(patterns, normalize(_, decls)))]
	!useful(decls, [row], [WWild], [scrutinee])
}

--- Returns, for each of `arms` of a `match` on `scrutinee`, in order, whether
--- some value reaches the arm, and if one does, the alternatives in its
--- patterns that no value reaches: an alternative at the top of the arm that
--- the arms and alternatives before it already match, or one nested inside a
--- pattern that its earlier siblings already match. An arm with a guard is
--- reached or not like any other, and stops no value from reaching a later
--- arm, since its guard may decline any value its patterns match.
fun reach(decls : DeclTable, arms : Vec Arm, scrutinee : Ty.Type) -> Vec (Bool, Vec Pat) {
	let types = [scrutinee]
	let rows = Vec.new(8)
	let out = Vec.new(len(arms))
	for arm in arms {
		let reached = Iter.any(
			arm.patterns,
			fun(p) = useful(decls, rows, [normalize(p, decls)], types),
		)
		let dead = []
		if reached {
			let before = Vec.slice(rows, 0, len(rows))
			for p in arm.patterns {
				let row = [normalize(p, decls)]
				if useful(decls, before, row, types) {
					deadAlternatives(decls, p, p, before, Map.new(), types, dead)
				} else {
					Vec.push(dead, p)
				}
				Vec.push(before, row)
			}
		}
		Vec.push(out, (reached, dead))
		if len(arm.guards) == 0 {
			for p in arm.patterns { Vec.push(rows, [normalize(p, decls)]) }
		}
	}
	out
}

-- Adds to `dead` each alternative inside `at`, a part of the arm pattern
-- `whole`, that no value reaches past `before`, with each alternatives pattern
-- around `at` narrowed to the one alternative `chosen` holds for it.
--
-- An alternative is reached when a value matches it and none of the patterns
-- tried first: the rows before, and `whole` with this alternative's earlier
-- siblings in its place, under the same narrowing. Inside an alternative no
-- value reaches, nothing is reported again.
fun deadAlternatives(
	decls : DeclTable,
	whole : Pat,
	at : Pat,
	before : Vec (Array Witness),
	chosen : Map Int (Vec Int),
	types : Array Ty.Type,
	dead : Vec Pat,
) -> Unit {
	match at.kind {
		POr(alts) -> for var i = 0; i < len(alts); i = i + 1 {
			let tried = Vec.slice(before, 0, len(before))
			if i > 0 {
				let earlier = []
				for j in Int.range(0, i) { Vec.push(earlier, j) }
				Vec.push(tried, [normalizeWith(whole, decls, choosing(chosen, at.id, earlier))])
			}
			let narrowed = choosing(chosen, at.id, [i])
			if useful(decls, tried, [normalizeWith(whole, decls, narrowed)], types) {
				deadAlternatives(decls, whole, alts[i], before, narrowed, types, dead)
			} else {
				Vec.push(dead, alts[i])
			}
		}
		PAnnot(inner, _) | PParen(inner) -> deadAlternatives(
			decls,
			whole,
			inner,
			before,
			chosen,
			types,
			dead,
		)
		PTuple(parts) | PCon(_, parts) -> for part in parts {
			deadAlternatives(decls, whole, part, before, chosen, types, dead)
		}
		PRecord(_, fields, _) -> for (_, part) in fields {
			deadAlternatives(decls, whole, part, before, chosen, types, dead)
		}
		PVar(_) | PWild | PLit(_, _) -> {}
	}
}

-- `chosen`, with `kept` for the alternatives pattern `id`.
fun choosing(chosen : Map Int (Vec Int), id : Int, kept : Vec Int) -> Map Int (Vec Int) {
	let out = Map.new()
	for (k, v) in Map.entries(chosen) { Map.put(out, k, v) }
	Map.put(out, id, kept)
	out
}

fun render(w : Witness) -> String = match w {
	WWild -> "_"
	-- Unreachable in practice: a literal key never appears in a signature, so a
	-- witness is never rebuilt from one. Printed through the language's own
	-- literal spelling regardless, so a witness always reads as something the
	-- author could have written.
	WLit(l)       -> litText(l)
	WOr(alts)     -> String.join(Array.map(alts, render), " | ")
	WTuple(elems) -> "(" + String.join(Array.map(elems, render), ", ") + ")"
	-- A witness is shown the way the author would write it, so the constructor
	-- loses the module qualification resolution gave it.
	WCon(name, args) -> {
		let short = Ty.shortName(name)
		if len(args) == 0 {
			short
		}
		-- The paren form is self-delimiting, so a nested witness needs no extra
		-- grouping: `Some(Some(_))`, not `Some (Some _)`.
		else {
			short + "(" + String.join(Array.map(args, render), ", ") + ")"
		}
	}
}

fun oops(message : String) -> a = Diag.fail(Diag.whole("internal error", message), "")
