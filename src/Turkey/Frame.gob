module Turkey.Frame (
    Layout(..), SafepointMap(..), PollSave(..), layout, offsetOf, verifyFrame, pollAt,
)

-- A function's frame, laid out after register allocation.
--
-- **A description, not code.** What comes out is where each region of the
-- frame is and how big the whole is; the emitter prints the prologue, the
-- epilogue and the frame-table entries from it. Everything that needs an
-- instruction the allocator must see -- the parameter moves, the root stores
-- before a safepoint, the outgoing stack arguments -- was emitted by
-- selection, which is why this pass has nothing to insert.
--
-- The frame, from the top, with every offset positive from `sp` and `sp` fixed
-- for the whole body:
--
--     sp + size + 8k    incoming stack argument k (the caller's outgoing area)
--     recordAt          the frame record: saved x29, then x30; x29 points here
--     savesAt           callee-saved registers the colouring used, in pairs
--     rootsAt           root slots, one per rooted value (`Turkey.Roots`)
--     spillsAt          spill slots, one per spilled untraced value
--     objectsAt         objects built in the frame (`Turkey.Escape`), each
--                       at the payload layout a heap object has, after a
--                       header whose first word is zero
--     (padding)         to the 16-byte alignment Apple requires
--     sp + 8k           outgoing stack argument k
--
-- The outgoing area is preallocated, as in Go and Cranelift and unlike QBE's
-- per-call `sp` adjustment, because every slot above is addressed from `sp` and
-- an `sp` that moved around each call would move all of them.
--
-- **Frame tables.** For each call that may collect, the fp-relative offsets of
-- the root slots live across it, and of the traced fields of every frame
-- object live across it. The collector walks `x29` frame records and
-- looks up each return address; nothing is registered at run time, which is
-- the 13% the survey measured the shadow stack costing.

import Data.Map as Map
import Turkey.Arm64 as A
import Turkey.Arm64 (Bank(..), Mem(..), Reg(..))
import Turkey.Regalloc as Regalloc
import Turkey.Roots as Roots
import Turkey.Ssa as Ssa
import Turkey.Ssa (BlockId(..))

-- One frame-table entry: the low IR safepoint the call came from, and the
-- offsets from `x29` of the root slots live across it.
type SafepointMap = SafepointMap { block : Int, index : Int, offsets : Vec Int }

-- What a loop's poll does on its slow path (`Turkey.Emit.poll`): the
-- registers it keeps across its call -- the live values in registers a call
-- clobbers -- and the live roots that are in registers, each with its root
-- slot's offset from `sp`. A root the allocator spilled is in its root slot
-- already, since a spilled value's slot is its root slot when it has one.
type PollSave = PollSave { kept : Vec Reg, roots : Vec (Reg, Int) }

type Layout = Layout {
    size     : Int,
    recordAt : Int,
    savesAt  : Int,
    savedGp  : Vec Int,
    savedFp  : Vec Int,
    rootsAt  : Int,
    roots    : Int,
    spillsAt : Int,
    spills   : Int,
    objectsAt : Int,
    -- Each frame object's first byte, from `objectsAt`, and the region's size.
    objectStarts : Vec Int,
    objectBytes : Int,
    -- Bytes, not slots.
    outgoing : Int,
    maps     : Vec SafepointMap,
    -- Each poll's, by `pollKey`.
    polls    : Map.Map Int PollSave,
}

fun pollKey(b : Int, n : Int) -> Int = Int.or(Int.shl(b, 32), n)

fun pollAt(l : Layout, b : Int, n : Int) -> PollSave = match Map.get(l.polls, pollKey(b, n)) {
    Some(p) -> p
    None -> PollSave { kept = [], roots = [] }
}

fun layout(a : Regalloc.Allocation, frame : Roots.Frame) -> Layout {
    let f = a.func
    let (savedGp, savedFp) = calleeSaved(a)
    var outgoing = 0
    for block in f.blocks {
        for i in block.insts {
            match A.memOf(i.op) {
                Some(m) -> match m {
                    OutgoingArg(k) -> if 8 * (k + 1) > outgoing {
                        outgoing = 8 * (k + 1)
                    }
                    _ -> {}
                }
                None -> {}
            }
        }
    }
    let roots = Roots.slotCount(frame)
    let spills = a.spills.spillSlots
    -- Each object has a heap header's room in front of it, and selection
    -- zeroes the header's first word: the generation word, which the write
    -- barrier reads from a store's target before it knows whether the target
    -- is in the heap or in a frame. A callee storing through a parameter is
    -- compiled once for both. Zero reads as young, and a young target needs
    -- nothing remembered. The collector never reads it: frame objects are
    -- roots.
    let objectStarts = []
    var objectBytes = 0
    for o in frame.objects {
        Vec.push(objectStarts, objectBytes + objectHeader)
        objectBytes = objectBytes + objectHeader + 8 * o.words
    }
    let saves = 8 * even(len(savedGp)) + 8 * even(len(savedFp))
    let raw = outgoing + objectBytes + 8 * spills + 8 * roots + saves + 16
    let size = (raw + 15) / 16 * 16
    let objectsAt = outgoing + (size - raw)
    let spillsAt = objectsAt + objectBytes
    let rootsAt = spillsAt + 8 * spills
    let savesAt = rootsAt + 8 * roots
    let recordAt = savesAt + saves
    let l = Layout {
        size = size, recordAt = recordAt, savesAt = savesAt,
        savedGp = savedGp, savedFp = savedFp, rootsAt = rootsAt, roots = roots,
        spillsAt = spillsAt, spills = spills, objectsAt = objectsAt,
        objectStarts = objectStarts, objectBytes = objectBytes,
        outgoing = outgoing, maps = [], polls = Map.new(),
    }
    for block in f.blocks {
        for i in block.insts {
            let mark = match A.safepointOf(i.op) {
                Some(at) -> Some(at)
                None -> A.pollOf(i.op)
            }
            match mark {
                Some((b, n)) -> {
                    let offsets = []
                    for (slot, _) in Roots.liveAt(frame, b, n) {
                        Vec.push(offsets, rootsAt + 8 * slot - recordAt)
                    }
                    for k in Roots.objectsAt(frame, b, n) {
                        for field in frame.objects[k].traced {
                            Vec.push(offsets, objectsAt + objectStarts[k] + 24
                                                + 8 * field - recordAt)
                        }
                    }
                    Vec.push(l.maps, SafepointMap { block = b, index = n,
                                                      offsets = offsets })
                }
                None -> {}
            }
        }
    }
    placePolls(l, a, frame)
    l
}

-- What each poll keeps and stores, from the liveness of the allocated code:
-- the values live after the poll are the ones its call must not lose.
fun placePolls(l : Layout, a : Regalloc.Allocation, frame : Roots.Frame) -> Unit {
    let f = a.func
    for var bi = 0; bi < len(f.blocks); bi = bi + 1 {
        let insts = f.blocks[bi].insts
        var after : Array (Array Int) = []
        for var k = 0; k < len(insts); k = k + 1 {
            match A.pollOf(insts[k].op) {
                Some((b, n)) -> {
                    if len(after) == 0 {
                        after = Ssa.liveAfter(f, BlockId(bi), a.liveOut[bi])
                    }
                    Map.put(l.polls, pollKey(b, n), pollSave(l, a, frame, b, n, after[k]))
                }
                None -> {}
            }
        }
    }
}

fun pollSave(l : Layout, a : Regalloc.Allocation, frame : Roots.Frame, b : Int, n : Int,
             live : Array Int) -> PollSave {
    let kept = []
    for id in live {
        match inRegister(a, id) {
            Some(Physical(bank, number)) ->
                if Int.and(A.calleeSavedMask(bank), Int.shl(1, number)) == 0 {
                    Vec.push(kept, Physical(bank, number))
                }
            _ -> {}
        }
    }
    let roots = []
    for (slot, id) in Roots.liveAt(frame, b, n) {
        if sortedContains(live, id) {
            match inRegister(a, id) {
                Some(r) -> Vec.push(roots, (r, l.rootsAt + 8 * slot))
                None -> {}
            }
        }
    }
    PollSave { kept = kept, roots = roots }
}

-- Whether `id` is in `ids`, which ascend (`Ssa.liveAfter`).
fun sortedContains(ids : Array Int, id : Int) -> Bool {
    var low = 0
    var high = len(ids)
    while low < high {
        let middle = (low + high) / 2
        if ids[middle] < id { low = middle + 1 } else { high = middle }
    }
    low < len(ids) && ids[low] == id
}

-- The register value `id` was coloured into, if it lives in one.
fun inRegister(a : Regalloc.Allocation, id : Int) -> Option Reg {
    let colour = a.colouring.of_[id]
    if colour < 0 || Map.contains(a.spills.slots, id) { return None }
    Some(Physical(A.bankOf(a.func.reps[id]), colour))
}

fun even(n : Int) -> Int = n + n % 2

-- A heap header's size, before a frame object's payload.
let objectHeader : Int = 24

-- The callee-saved registers this function must save, in each file,
-- ascending: the ones some value was coloured into, and the ones a call in it
-- clobbers. `x19`-`x28` and `d8`-`d15`; only the low 64 bits of a `d` are
-- preserved, which is all a double has.
--
-- The second half is not covered by the first. A call whose convention lets
-- the callee destroy `x19` (`A.PreservesNone`) leaves whatever the callee put
-- there in a function that may never have coloured anything into `x19` --
-- and that function's own caller expects its `x19` back.
fun calleeSaved(a : Regalloc.Allocation) -> (Vec Int, Vec Int) {
    var gp = 0
    var fp = 0
    let of_ = a.colouring.of_
    for var id = 0; id < len(of_); id = id + 1 {
        let r = of_[id]
        if r >= 0 {
            match A.bankOf(a.func.reps[id]) {
                Gp -> { gp = Int.or(gp, Int.shl(1, r)) }
                Fp -> { fp = Int.or(fp, Int.shl(1, r)) }
            }
        }
    }
    for block in a.func.blocks {
        for i in block.insts {
            gp = Int.or(gp, A.callClobbers(i.op, Gp))
            fp = Int.or(fp, A.callClobbers(i.op, Fp))
        }
    }
    (registersIn(Int.and(gp, A.calleeSavedMask(Gp))),
     registersIn(Int.and(fp, A.calleeSavedMask(Fp))))
}

-- The register numbers in `mask`, ascending.
fun registersIn(mask : Int) -> Vec Int {
    let out = []
    for var r = 0; r < 32; r = r + 1 {
        if Int.and(Int.shr(mask, r), 1) != 0 { Vec.push(out, r) }
    }
    out
}

-- Where a frame slot is, from `sp`. `None` for memory that is not a frame slot.
--
-- Every constructor is named, and a wildcard would be wrong here rather than
-- merely loose. `Mem` holds the symbolic slots and the real addressing modes
-- in one type, so the only thing that says a symbolic slot has been resolved
-- is that this function resolved it. Under `_ -> None` a slot kind added later
-- compiles clean, answers `None`, and is emitted as though it were already an
-- address -- which assembles, links, and reads the wrong word. `verifyFrame`
-- would not catch it either: it range-checks the kinds it knows.
fun offsetOf(l : Layout, m : Mem) -> Option Int = match m {
    RootSlot(i) -> Some(l.rootsAt + 8 * i)
    SpillSlot(i) -> Some(l.spillsAt + 8 * i)
    ObjectSlot(n, k) -> Some(l.objectsAt + l.objectStarts[n] + k)
    OutgoingArg(k) -> Some(8 * k)
    IncomingArg(k) -> Some(l.size + 8 * k)
    Offset(_, _) -> None
    Indexed(_, _) -> None
    PageOffset(_, _) -> None
}

-- Whether the layout is a frame, and the frame tables tell the truth.
--
-- A wrong offset here assembles, links and runs, and reads or writes some
-- other slot -- and a wrong frame-table entry is worse: the collector frees
-- something live, or reads a stale slot as a pointer, and only a collection at
-- that exact call finds out. So both are checked where they are made.
fun verifyFrame(a : Regalloc.Allocation, frame : Roots.Frame,
                l : Layout) -> Vec String {
    let out : Vec String = []
    let f = a.func
    if l.size % 16 != 0 {
        Vec.push(out, "the frame is " + Int.toString(l.size)
                        + " bytes, not a multiple of 16")
    }
    if l.recordAt + 16 != l.size {
        Vec.push(out, "the frame record is not at the top of the frame")
    }
    if l.outgoing > l.objectsAt || l.objectsAt + l.objectBytes != l.spillsAt
       || l.spillsAt + 8 * l.spills != l.rootsAt
       || l.rootsAt + 8 * l.roots != l.savesAt {
        Vec.push(out, "the frame's regions overlap or leave a gap")
    }
    -- Reserved registers: the scratch pair, the platform register, the frame
    -- record's two. The colourer's pool excludes them; this is the check that
    -- it still does.
    let of_ = a.colouring.of_
    for var id = 0; id < len(of_); id = id + 1 {
        let r = of_[id]
        match A.bankOf(f.reps[id]) {
            Gp -> if r == 16 || r == 17 || r == 18 || r == 29 || r == 30 {
                Vec.push(out, "value %" + Int.toString(id)
                                + " is coloured into reserved x" + Int.toString(r))
            }
            Fp -> {}
        }
    }
    for var b = 0; b < len(f.blocks); b = b + 1 {
        let insts = f.blocks[b].insts
        for var n = 0; n < len(insts); n = n + 1 {
            match A.memOf(insts[n].op) {
                Some(m) -> checkSlot(out, l, m, b, n)
                None -> {}
            }
            match A.safepointOf(insts[n].op) {
                Some((lb, ln)) -> checkMap(out, a, frame, insts, b, n, lb, ln)
                None -> {}
            }
        }
    }
    out
}

fun checkSlot(out : Vec String, l : Layout, m : Mem, b : Int, n : Int) -> Unit {
    let within = match m {
        RootSlot(i) -> i >= 0 && i < l.roots
        SpillSlot(i) -> i >= 0 && i < l.spills
        -- The payload, or the header's generation word.
        ObjectSlot(n, k) -> n >= 0 && n < len(l.objectStarts)
                            && (k >= 0 || k == -objectHeader)
                            && l.objectStarts[n] + k
                               < (if n + 1 < len(l.objectStarts) {
                                      l.objectStarts[n + 1] - objectHeader
                                  } else { l.objectBytes })
        OutgoingArg(k) -> k >= 0 && 8 * (k + 1) <= l.outgoing
        IncomingArg(k) -> k >= 0
        -- Named rather than a wildcard, for the reason `offsetOf` gives: a
        -- slot kind added later would default to "inside the frame", which is
        -- the answer that keeps this verifier quiet about it.
        Offset(_, _) -> True
        Indexed(_, _) -> True
        PageOffset(_, _) -> True
    }
    if !within {
        Vec.push(out, show(m) + " at b" + Int.toString(b) + " instruction "
                        + Int.toString(n) + " is outside the frame")
    }
}

-- A frame-table entry is true if the call before it is a call, and every root
-- it lists holds its value by then: stored in this block before the call, or
-- spilled into that slot at its definition, which dominates every use.
fun checkMap(out : Vec String, a : Regalloc.Allocation, frame : Roots.Frame,
             insts : Vec A.Inst, b : Int, n : Int, lb : Int, ln : Int) -> Unit {
    let at = "b" + Int.toString(b) + " instruction " + Int.toString(n)
    if n == 0 || !A.isCall(insts[n - 1]) {
        Vec.push(out, "the safepoint map at " + at + " does not follow a call")
    }
    for (slot, id) in Roots.liveAt(frame, lb, ln) {
        let want = show(RootSlot(slot))
        var stored = match Map.get(a.spills.slots, id) {
            Some(m) -> show(m) == want
            None -> False
        }
        for var k = 0; k < n; k = k + 1 {
            match A.slotStore(insts[k].op) {
                Some((_, m)) -> if show(m) == want { stored = True }
                None -> {}
            }
        }
        if !stored {
            Vec.push(out, "root slot " + Int.toString(slot) + " (%"
                            + Int.toString(id) + ") is in the map at " + at
                            + " but nothing stores it first")
        }
    }
}
