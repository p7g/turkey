export (
    Generator(..), newGenerator, generate, bindMethods, checkExhaustiveness,
)

-- Constraint generation.
--
-- This walks the tree and *builds* a constraint. It decides nothing: it never
-- unifies, never generalizes, and never looks a name up in a type environment.
-- That is what makes it order-independent -- there is no partially-solved
-- substitution for a traversal decision to depend on, because there is no
-- substitution here at all.
--
-- What it does keep is everything genuinely syntactic: which binder each
-- occurrence means, which resolution recorded in the binder table, and which
-- binders may be assigned, since `cannot assign to 'x'` is a property of the
-- binding form; bottom, which is produced syntactically by `return`, `break` and
-- `continue` and never discovered by solving; annotation type variables, scoped
-- to the enclosing function so the `a` in a signature and the `a` in a body
-- annotation are one variable; and field access, which emits a demand and hands
-- back its result whether or not the receiver is known.
--
-- Which instance a method call means is *not* decided here. Each occurrence is
-- marked with a `Use` for the solver to fill in later, because the answer
-- depends on what solving decides the name's predicates are about.
--
-- Variables invented here have no rank: generation has no idea what binder depth
-- it is under, which is the point. Each is recorded in the enclosing frame and
-- becomes part of an existential, and the solver stamps the rank when it
-- arrives.

import Data.Set as Set
import Turkey.Ast (Pred as _, ..)
-- `Pred` below is the semantic predicate; the syntactic one a context is
-- written as is `Ast.Pred`.
import Turkey.Ast as Ast
import Turkey.Binders as Binders
import Turkey.Classes as Classes
import Turkey.Classes (ClassTable(..), ClassInfo(..), InstInfo(..),
                       MethodInfo(..), MethodImpl(..), InstancePlan(..),
                       Skolems(..))
import Turkey.Constraints as C
import Turkey.Constraints (Constraint(..), Instantiates(..), Binding(..), Env(..),
                           PredCell(..), LetCell(..))
import Turkey.Decls as Decls
import Turkey.Decls (DeclTable(..), ConInfo(..), TyconInfo(..), ForeignInfo(..))
import Turkey.Deps as Deps
import Turkey.Inert as Inert
import Turkey.Diag as Diag
import Turkey.Exhaustive as Exhaustive
import Turkey.Prelude as P
import Turkey.Solved (Abstraction(..), Use(..), newAbstraction, newUse, newHole, dictName)
import Turkey.Source (Span(..), showSpan)
import Turkey.Typed as Typed
import Turkey.Typed (TypeTable(..))
import Turkey.Types as Ty
import Turkey.Types (VarCell(..), ConCell(..), Scheme(..), Pred(..),
                     TVar, TCon, TApp, TFam, TFun, TTuple,
                     TSet, TBottom)

-- Which literals get a set rather than a type. A string or a char has exactly
-- one type and is emitted as one; only the numeric kinds are open.
fun isNumericKind(kind : String) -> Bool = kind == "Int" || kind == "Float"

fun literalType(kind : String) -> Ty.Type = match kind {
    "Int" -> Ty.tInt()
    "Float" -> Ty.tFloat()
    "String" -> Ty.tString()
    _ -> Ty.tChar()
}

-- What is left of the operator table after every operator that names a value
-- became a class method. These two are not, and for a reason no class can
-- express: `&&` and `||` short-circuit, which no function call does.
fun binaryOp(op : String) -> Option (Ty.Type, Ty.Type, Ty.Type) = match op {
    "&&" -> Some((Ty.tBool(), Ty.tBool(), Ty.tBool()))
    "||" -> Some((Ty.tBool(), Ty.tBool(), Ty.tBool()))
    _ -> None
}

fun unaryOp(op : String) -> Option (Ty.Type, Ty.Type) = match op {
    "!" -> Some((Ty.tBool(), Ty.tBool()))
    _ -> None
}

type LoopCtx = LoopCtx {
    -- loop | while | for
    kind         : String,
    var result   : Ty.Type,
}

-- One existential under construction: the variables and constraints so far.
type Frame = Frame {
    vars  : Vec VarCell,
    parts : Vec Constraint,
}

type Generator = Generator {
    decls       : DeclTable,
    -- Every expression's type, kept for the lowering rather than dropped once
    -- the constraint is built. Shared across modules the way the declaration
    -- table is: one program, one table.
    types       : TypeTable,
    classes     : ClassTable,
    env         : Env,
    frames      : Vec Frame,
    -- Which binder each occurrence means, and what each binder is.
    binders     : Binders.Table,
    -- The binders that are function parameters. A parameter may be assigned
    -- although it is not a `var`.
    parameters  : Set.Set Int,
    fnStack       : Vec Ty.Type,
    var loopStack : Vec LoopCtx,
    tyvarScopes   : Vec (Map String Ty.Type),
    -- Exhaustiveness runs after solving, when scrutinee types are known. Each
    -- site keeps the scopes the solver had open there (`siteScopes`).
    matchSites  : Vec (Expr, Ty.Type, Use),
    -- And irrefutability: every pattern that binds with no second arm to fall
    -- to.
    -- A binding pattern, the type it binds, and what a refutable one should
    -- be rewritten as.
    binderSites : Vec (Pat, Ty.Type, String, Use),
    -- And every expression whose value is thrown away, recorded after it is
    -- generated, since whether a value is discarded is a property of where the
    -- expression sits rather than of the expression.
    discardSites : Vec Expr,
    -- See `Program.letElses`.
    letElses : Vec LetElse,
    -- Every block's statements, for the unreachable-code warning, which needs
    -- solved types to tell which calls return.
    blocks   : Vec (Vec Stmt),
    -- The ids of the nodes generation types bottom whatever they are: every
    -- `else` block of a `let ... else`, and the calls in its tail positions.
    bottoms  : Set.Set Int,
    -- What a partially annotated `fun`'s header wrote, by declaration id: its
    -- variables and its context.
    partialHeaders : Map Int (Vec (String, Ty.Type), Vec Ty.Pred),
    -- What the patterns being matched have opened: one list
    -- per `match` arm or function whose patterns may open an existential, and
    -- `None` for a binding that may not.
    openings : Vec (Option (Vec (Array (String, Pred), Vec ConCell))),
}

fun newGenerator(decls : DeclTable, builtins : Env, classes : ClassTable,
                 types : TypeTable, binders : Binders.Table) -> Generator {
    Typed.observe(types, classes)
    Generator {
        decls = decls, types = types, classes = classes,
        env = builtins, frames = [Frame { vars = Vec.new(8), parts = Vec.new(8) }],
        binders = binders, parameters = Set.new(), fnStack = Vec.new(4),
        loopStack = Vec.new(4), tyvarScopes = [Map.new()],
        matchSites = Vec.new(8),
        binderSites = Vec.new(8), discardSites = Vec.new(8), letElses = [],
        blocks = Vec.new(64), bottoms = Set.new(),
        partialHeaders = Map.new(), openings = Vec.new(4),
    }
}

-- -- building ----------------------------------------------------------------------

-- A variable with no rank yet, recorded in the enclosing existential.
fun fresh(g : Generator) -> Ty.Type {
    let v = Ty.freshVar(0)
    Vec.push(g.frames[len(g.frames) - 1].vars, v)
    TVar(v)
}

fun emit(g : Generator, c : Constraint) -> Unit =
    Vec.push(g.frames[len(g.frames) - 1].parts, c)

fun eq(g : Generator, a : Ty.Type, b : Ty.Type, where : Option Span,
       context : String) -> Unit = emit(g, CEq(a, b, where, context))

fun push(g : Generator) -> Unit =
    Vec.push(g.frames, Frame { vars = Vec.new(8), parts = Vec.new(8) })

fun pop(g : Generator) -> Constraint = match Vec.pop(g.frames) {
    Some(f) -> CExists(f.vars, CAnd(f.parts))
    None -> CAnd([])
}

-- Equate two types and answer the one that survives.
--
-- Bottom is absorbed by whatever it meets, so a bare equation cannot tell the
-- caller which type it ends up with. Every place two branches must agree goes
-- through this instead. It can be decided during generation -- with no solving
-- at all -- because bottom is produced *syntactically*, and unification never
-- binds a variable to it. So a type is bottom here or never will be.
fun join(g : Generator, a : Ty.Type, b : Ty.Type, where : Option Span,
         context : String) -> Ty.Type {
    match a {
        TBottom -> return b
        _ -> {}
    }
    match b {
        TBottom -> return a
        _ -> {}
    }
    eq(g, a, b, where, context)
    a
}

-- -- binders -----------------------------------------------------------------------

-- Returns the binder the `EVar` node `e`, spelled `name`, means. When
-- resolution found no binder for it, reports the name as undefined at `where`
-- and returns `C.noBinder`.
fun referent(g : Generator, e : Expr, name : String, where : Span) -> Int =
    match Map.get(g.binders.refs, e.id) {
        Some(id) -> id
        None -> if Map.contains(g.binders.unresolved, e.id) {
            Ty.typeError("'" + name + "' is not defined", Some(where))
            C.noBinder
        } else {
            bug("no binder was recorded for '" + name + "'", Some(where))
        }
    }

-- Returns the binder the binding occurrence `nodeId` binds.
fun boundAt(g : Generator, nodeId : Int, name : String, where : Span) -> Int =
    match Map.get(g.binders.refs, nodeId) {
        Some(id) -> id
        None -> bug("no binder was recorded for '" + name + "'", Some(where))
    }

-- Returns each name `bound` maps, with the binder `pats` bind it to and its
-- type, in `bound`'s order. Each name must be bound once among `pats`.
fun bindersIn(g : Generator, pats : Vec Pat, where : Span,
              bound : Map String Ty.Type) -> Vec (Int, String, Ty.Type) {
    let ids = Map.new()
    for pat in pats {
        for v in varPatterns(pat) {
            if let PVar(name) = v.kind {
                Map.put(ids, name, boundAt(g, v.id, name, v.span))
            }
        }
    }
    let out = Vec.new(len(ids))
    for (name, ty) in Map.entries(bound) {
        match Map.get(ids, name) {
            Some(id) -> Vec.push(out, (id, name, ty))
            None -> bug("'" + name + "' is bound by no pattern here", Some(where))
        }
    }
    out
}

fun assignable(g : Generator, id : Int) -> Bool =
    Binders.binderAt(g.binders, id).mutable || Set.contains(g.parameters, id)

-- Reports the type error for an assignment at `where` to the binder `id`,
-- which cannot be assigned.
fun notAssignable(g : Generator, id : Int, where : Span) -> Unit {
    let b = Binders.binderAt(g.binders, id)
    let prefix = "cannot assign to '" + b.name + "': "
    if let Binders.Method = b.kind {
        Ty.typeError(prefix + "it is a class method", Some(where))
    } else if Set.contains(g.decls.functions, id) {
        Ty.typeError(prefix + "it is a function", Some(where))
    } else {
        Ty.typeError(prefix + "it was bound with 'let'; declare it with 'var' to make "
                     + "it reassignable", Some(where))
    }
}

-- Translate an annotation, resolving its type variables in the innermost
-- function's scope.
fun typeOf(g : Generator, te : Type) -> Ty.Type =
    Decls.star(g.decls, te, g.tyvarScopes[len(g.tyvarScopes) - 1],
               fun() = freshCell(g))

fun freshCell(g : Generator) -> VarCell {
    let v = Ty.freshVar(0)
    Vec.push(g.frames[len(g.frames) - 1].vars, v)
    v
}

-- -- the program -------------------------------------------------------------------

-- Build the constraint of a component of modules -- modules that import each
-- other, or one module that imports none of its importers -- and their
-- evaluation order. Each module comes with its name, which owns its classes
-- and instances for the orphan rule. Everything else is already qualified by
-- module, so the component's declarations are generated as one program: its
-- types declared together, and its bindings grouped by what they use whichever
-- module they are in.
--
-- The evaluator reuses that order, so a binding is always initialized before
-- anything that reads it. The constraint has the same shape: one binder per
-- binding group, in that order. They follow one another rather than nest,
-- because a top-level binder's names outlive it: the solver also writes them
-- to its top-level environment, which every later group looks names up
-- through. So the constraint is as deep as one group, not as deep as the
-- module is long.
fun generate(g : Generator, modules : Vec (String, Program)) -> (Vec Stmt, Constraint) {
    let typeDecls = Vec.new(8)
    let classDecls = Vec.new(4)
    let instDecls = Vec.new(4)
    let ownedClasses = Vec.new(4)
    let ownedInstances = Vec.new(4)
    let foreigns = Vec.new(4)
    let items = Vec.new(16)
    for (owner, program) in modules {
        for le in program.letElses {
            -- One that falls through even if every call in it never returns
            -- is reported now, before solving. Desugaring may have rewritten
            -- the block into a value that is no longer bottom, and solving
            -- would report that as a mismatch between the arms instead.
            if completes(le.completion, fun(_) = False) { fallsThrough(le) }
            Vec.push(g.letElses, le)
            Set.add(g.bottoms, le.block.id)
            for call in le.tailCalls { Set.add(g.bottoms, call.id) }
        }
        for d in program.decls {
            match d {
                DType(t) -> Vec.push(typeDecls, t)
                DClass(c) -> {
                    Vec.push(classDecls, c)
                    Vec.push(ownedClasses, (c, owner))
                }
                DInstance(i) -> {
                    Vec.push(instDecls, i)
                    Vec.push(ownedInstances, (i, owner))
                }
                DStmt(s) -> Vec.push(items, s)
                DForeign(f) -> Vec.push(foreigns, f)
                DInfix(_) -> {}
            }
        }
    }
    Decls.registerAll(g.decls, typeDecls)
    Classes.registerAll(g.classes, ownedClasses, ownedInstances)
    -- A declaration that failed to register leaves a gap in the tables that
    -- every use of it would report again, so nothing is generated past one.
    if Diag.hasErrors() { return ([], CAnd([])) }
    bindMethods(g)
    bindForeigns(g, foreigns)
    checkDefinitions(g, items)

    -- The graph is keyed by item, not by bound name: a single binding may
    -- introduce several names, and keying by name would split one item across
    -- two components and infer -- and evaluate -- its right-hand side twice.
    let namesFor = Map.new()
    let byKey = Map.new()
    for var i = 0; i < len(items); i = i + 1 {
        let key = "item" + Int.toString(i)
        Map.put(namesFor, key, itemNames(items[i]))
        Map.put(byKey, key, items[i])
    }
    let owner = Map.new()
    let ownerOf = Map.new()
    for var i = 0; i < len(items); i = i + 1 {
        let key = "item" + Int.toString(i)
        for id in itemBinders(g, items[i]) { Map.put(ownerOf, id, key) }
        for name in Map.getOr(namesFor, key, []) {
            if Map.contains(owner, name) {
                Ty.typeError("'" + name + "' is declared more than once",
                             Some(items[i].span))
            }
            if Map.contains(g.decls.foreigns, name) {
                Ty.typeError("'" + name + "' is already defined by a foreign "
                             + "declaration; rename one of them", Some(items[i].span))
            }
            match Map.get(g.classes.owner, name) {
                Some(cls) -> Ty.typeError("'" + name + "' is already defined as a "
                    + "method of class '" + cls + "'; rename one of them",
                    Some(items[i].span))
                None -> {}
            }
            Map.put(owner, name, key)
        }
    }

    let graph = Map.new()
    for var i = 0; i < len(items); i = i + 1 {
        let edges = Set.new()
        for id in Set.elements(Deps.references(g.binders, items[i])) {
            match Map.get(ownerOf, id) {
                Some(key) -> Set.add(edges, key)
                None -> {}
            }
        }
        Map.put(graph, "item" + Int.toString(i), edges)
    }

    let groups = Vec.new(8)
    let ordered = Vec.new(16)
    for component in Deps.sccs(graph) {
        let group = Vec.new(len(component))
        let boundNames = Vec.new(4)
        for key in component {
            match Map.get(byKey, key) {
                Some(item) -> Vec.push(group, item)
                None -> {}
            }
            for n in Map.getOr(namesFor, key, []) {
                Vec.push(boundNames, n)
            }
        }
        -- A group reported as cyclic is not generated: the rest of the
        -- generator takes a recursive group to be all functions.
        if !checkGroupRecursion(group, Vec.sort(boundNames), component, graph) {
            Vec.push(groups, group)
        }
        for item in group { Vec.push(ordered, item) }
    }

    -- Each group is a unit of diagnostics, as it is when solved: one wrong
    -- record field is reported once, not again as a missing one.
    for group in groups {
        Diag.beginUnit()
        bindTopGroup(g, group)
        let _ = Diag.endUnit()
    }
    -- Method bodies come after every group, so that they may call any
    -- top-level binding. Nothing calls *them* by name, so their position is
    -- otherwise free.
    genMethodBodies(g, classDecls, instDecls)
    (ordered, pop(g))
}

fun itemNames(item : Stmt) -> Vec String = match item.kind {
    SFun(d) -> [d.name]
    SLet(pat, _) -> Vec.sort(patternVars(pat))
    SVar(pat, _) -> Vec.sort(patternVars(pat))
    _ -> []
}

-- Returns the binders a top-level item binds.
fun itemBinders(g : Generator, item : Stmt) -> Vec Int = match item.kind {
    SFun(d) -> [boundAt(g, d.id, d.name, d.span)]
    SLet(pat, _) | SVar(pat, _) -> {
        let out = Vec.new(2)
        for v in varPatterns(pat) {
            if let PVar(name) = v.kind { Vec.push(out, boundAt(g, v.id, name, v.span)) }
        }
        out
    }
    _ -> []
}

fun checkGroupRecursion(group : Vec Stmt, boundNames : Vec String,
                        component : Vec String,
                        graph : Map String (Set.Set String)) -> Bool {
    var recursive = len(component) > 1
    for k in component {
        if Set.contains(Map.getOr(graph, k, Set.new()), k) { recursive = True }
    }
    if !recursive { return False }
    for item in group {
        match item.kind {
            SFun(_) -> {}
            _ -> {
                Ty.typeError("cyclic definition: "
                    + String.join(Array.map(boundNames, fun(n) = "'" + n + "'"), ", ")
                    + " depend on each other, but only functions can be "
                    + "mutually recursive", Some(group[0].span))
                return True
            }
        }
    }
    False
}

-- Put every class method in scope, under the scheme its class gives it, and
-- each declared C symbol in the environment, monomorphically.
--
-- A foreign declaration states its type in full and has no body, so there is
-- nothing to infer and nothing to generalize: it goes straight into the
-- environment the way a `Prim.` builtin does, which is exactly what it is.
--
-- That also keeps it out of the binding groups. A group exists to decide what
-- a set of mutually recursive definitions is; a declaration with no definition
-- has nothing to contribute to one.
fun bindForeigns(g : Generator, decls : Vec ForeignDecl) -> Unit {
    for d in decls {
        if Map.contains(g.decls.foreigns, d.name) {
            Ty.typeError("'" + d.name + "' is declared more than once", Some(d.span))
        }
        let params = Array.map(d.params, fun(param) = match param.kind {
            PAnnot(_, te) -> foreignType(g, te, d.name)
            -- The parser builds every one of these, so this cannot
            -- happen; saying so beats a silent wrong type.
            _ -> bug("a foreign parameter must state its type",
                     Some(param.span))
        })
        let ret = foreignType(g, d.ret, d.name)
        checkForeignArity(d.name, d.span, params)
        for (_, other) in Map.entries(g.decls.definitions) {
            if other.symbol == d.symbol { symbolClaimed(d.symbol, other, d.span) }
        }
        Map.put(g.decls.foreigns, d.name, ForeignInfo {
            name = d.name, symbol = d.symbol, params = params, fixed = d.fixed,
            ret = ret, span = Some(d.span),
        })
        let id = boundAt(g, d.id, d.name, d.span)
        Set.add(g.decls.functions, id)
        C.define(g.env, id, d.name, Binding {
            scheme = Ty.mono(TFun(params, ret)), mutable = False,
        })
    }
}

-- Record each `foreign` definition's C signature.
--
-- The body is typed below like any `fun`'s, against the same annotations. What
-- is checked here is what makes it callable from C: every type is one of the
-- seven that cross, the arguments fit the registers, and no other definition or
-- declaration in the program claims the symbol -- which the linker would
-- otherwise report, later and less clearly.
fun checkDefinitions(g : Generator, items : Vec Stmt) -> Unit {
    for item in items {
        if let SFun(d) = item.kind {
            if let Some(symbol) = d.symbol {
                let written = Binders.nameAt(g.binders, d.id, d.span)
                let params = Array.map(d.params, fun(param) = match param.kind {
                    PAnnot(_, te) -> foreignType(g, te, written)
                    _ -> bug("a foreign parameter must state its type",
                             Some(param.span))
                })
                let ret = match d.ret {
                    Some(te) -> foreignType(g, te, written)
                    None -> bug("a foreign definition must state its result type",
                                Some(d.span))
                }
                checkForeignArity(written, d.span, params)
                var general = 0
                for p in params {
                    if !Ty.sameType(p, Ty.tFloat()) { general = general + 1 }
                }
                let limit = Ty.foreignArgLimit()
                if general >= limit {
                    Ty.typeError("'" + written + "' has " + Int.toString(general)
                                 + " non-'Float' parameters, but a foreign definition "
                                 + "can have at most " + Int.toString(limit - 1),
                                 Some(d.span))
                }
                for (_, other) in Map.entries(g.decls.foreigns) {
                    if other.symbol == symbol { symbolClaimed(symbol, other, d.span) }
                }
                for (_, other) in Map.entries(g.decls.definitions) {
                    if other.symbol == symbol { symbolClaimed(symbol, other, d.span) }
                }
                Map.put(g.decls.definitions, d.name, ForeignInfo {
                    name = d.name, symbol = symbol, params = params,
                    fixed = len(params), ret = ret, span = Some(d.span),
                })
            }
        }
    }
}

fun symbolClaimed(symbol : String, other : ForeignInfo, span : Span) -> Unit =
    Ty.typeError("the C symbol '" + symbol + "' is already declared or defined by '"
                 + Ty.shortName(other.name) + "'; a C symbol can be declared or defined "
                 + "only once", Some(span))

-- One argument or result type, checked against what can cross.
--
-- Nothing is marshalled. A `String` does not cross, and a caller that wants a
-- `char *` copies one into raw memory itself -- which is `withCString` in
-- Haskell and `C.CString` in Go, and is needed only for path arguments, since
-- everything else a POSIX call takes is a pointer and a length.
fun foreignType(g : Generator, te : Type, who : String) -> Ty.Type {
    let ty = Ty.prune(Decls.star(g.decls, te, Map.new(),
                                 fun() = freshCell(g)))
    match ty {
        TCon(cell) -> if Ty.isForeignType(cell.name) { return ty }
        -- Already reported as a wrong type.
        TBottom -> return ty
        _ -> {}
    }
    Ty.typeError("'" + Ty.show(ty) + "' cannot appear in the foreign signature of '"
                 + who + "'; use one of " + Ty.foreignTypes(), Some(te.span))
    ty
}

-- At most eight arguments per register file, variadic ones included.
--
-- AAPCS64's rules for named arguments past the registers are not implemented:
-- `Turkey.Select` puts those in its own outgoing stack slots, which a C
-- function would not read the same way. A runtime entry point that overflowed
-- was a compiler bug and stopped the function; a *declaration* is written by
-- someone, so it is rejected here, saying which file filled up rather than
-- which instruction could not be selected.
--
-- Variadic arguments count, though Darwin passes every one of them on the
-- stack, because arm64 Linux passes them as it passes named ones, in the
-- registers left over. A declaration is checked the same whichever target is
-- chosen, so it is held to the rule both targets can call.
fun checkForeignArity(name : String, span : Span, params : Array Ty.Type) -> Unit {
    var general = 0
    var vector = 0
    for p in params {
        if Ty.sameType(p, Ty.tFloat()) { vector = vector + 1 }
        else { general = general + 1 }
    }
    let limit = Ty.foreignArgLimit()
    for (count, which) in [(general, "non-'Float'"), (vector, "'Float'")] {
        if count > limit {
            Ty.typeError("'" + name + "' has " + Int.toString(count) + " " + which
                         + " parameters, but a foreign function can have at most "
                         + Int.toString(limit), Some(span))
        }
    }
}

fun bindMethods(g : Generator) -> Unit {
    for (_, info) in Map.entries(g.classes.classes) {
        for (_, m) in Map.entries(info.methods) {
            let alreadyOwned = Map.contains(g.classes.owner, m.name)
            if Option.isSome(C.lookup_(g.env, m.name)) {
                -- Already bound by an earlier module: a class method is global
                -- and unqualified, so every module sees the same one. Binding it
                -- again is a no-op, not a collision.
                if !alreadyOwned {
                    Ty.typeError("the class method '" + m.name + "' has the same name as "
                                 + "an existing function; rename one of them",
                                 Some(m.decl.span))
                }
            } else {
                let id = match (Binders.named(g.binders, m.name), info.span) {
                    (Some(id), _) -> id
                    -- A generated class has no declaration, so its methods
                    -- have no binders.
                    (None, None) -> C.noBinder
                    (None, Some(_)) -> bug("the class method '" + m.name
                                           + "' has no binder", Some(m.decl.span))
                }
                C.define(g.env, id, m.name, Binding { scheme = m.scheme, mutable = False })
            }
        }
    }
}

-- Check every defaulted class method and every instance method.
--
-- Each is checked against the type its *class* states, with everything the
-- declaration does not fix made rigid. That is the whole difference between
-- checking a method and inferring a function: a method has a type to live up to,
-- and a fresh unification variable would let a body that is less general than
-- the signature pass by narrowing the signature to fit.
fun genMethodBodies(g : Generator, classDecls : Vec ClassDecl,
                    instDecls : Vec InstanceDecl) -> Unit {
    for decl in classDecls {
        let info = classNamed(g, decl.name)
        for (_, m) in Map.entries(info.methods) {
            match m.decl.body {
                None -> {}
                Some(_) -> {
                    let sk = Classes.newSkolems()
                    discard(Classes.skolemBind(sk, info.cvar, info.param))
                    -- One elaboration of a default serves every instance: its own
                    -- class dictionary arrives under a name each instance rebinds
                    -- as its dictionary is built.
                    Diag.beginUnit()
                    Map.put(info.defaults, m.name, checkMethod(g, m, sk,
                        [], [],
                        "the default definition of '" + m.name + "'", None, None))
                    let _ = Diag.endUnit()
                }
            }
        }
    }
    for decl in instDecls {
        let inst = instanceFor(g, decl)
        let info = classNamed(g, decl.cls)
        let params = Vec.new(len(inst.context))
        for q in inst.context { Vec.push(params, dictName(q.name)) }
        let plan = Classes.newInstancePlan(params)
        inst.plan = Some(plan)
        -- The instance's own dictionary and its context are named once and
        -- shared by every method, because that is how they are bound: once, when
        -- the dictionary is built.
        let selfName = dictName(decl.cls)
        for methodDecl in decl.methods {
            let m = match Map.get(info.methods, methodDecl.name) {
                Some(x) -> x
                None -> bug("'" + methodDecl.name + "' is not a method of '"
                            + decl.cls + "'", Some(methodDecl.span))
            }
            let sk = Classes.newSkolems()
            for v in Ty.varsOf([inst.head]) {
                discard(Classes.skolemBind(sk, v,
                    Map.getOr(inst.names, v.id, "a")))
            }
            -- The class variable is not made rigid: the instance fixes it.
            Map.put(sk.mapping, m.classVar.id, Classes.skolemApply(sk, inst.head))
            let context = Array.map(inst.context, fun(q) =
                Ty.pred(q.name, [Classes.skolemApply(sk, q.args[0])]))
            Diag.beginUnit()
            Map.put(plan.methods, methodDecl.name, checkMethod(g, m, sk, context,
                plan.params, "instance '" + decl.cls + " " + Ty.show(inst.head)
                + "'", Some(methodDecl), Some(selfName)))
            let _ = Diag.endUnit()
        }
    }
}

fun instanceFor(g : Generator, decl : InstanceDecl) -> InstInfo {
    for inst in Map.getOr(g.classes.instances, decl.cls, []) {
        if inst.decl.span.line == decl.span.line
           && inst.decl.span.col == decl.span.col
           && inst.decl.span.file == decl.span.file { return inst }
    }
    bug("no registered instance for this declaration", Some(decl.span))
}

fun classNamed(g : Generator, name : String) -> ClassInfo =
    match Map.get(g.classes.classes, name) {
        Some(i) -> i
        None -> bug("unknown class '" + name + "'", None)
    }

fun checkMethod(g : Generator, m : MethodInfo, sk : Skolems,
                context : Array Pred, contextNames : Vec String,
                what : String, override : Option FunDecl,
                selfNameIn : Option String) -> MethodImpl {
    for v in m.scheme.quantified {
        if !Map.contains(sk.mapping, v.id) {
            discard(Classes.skolemBind(sk, v, Map.getOr(m.names, v.id, "a")))
        }
    }
    let expected = Classes.skolemApply(sk, m.scheme.body)
    -- A method's scheme states its class's predicate first, then its own
    -- context. The two are given to the body for different reasons and arrive by
    -- different routes: the first is the dictionary the body belongs to, the
    -- rest are parameters of every call.
    let own = Vec.new(len(m.scheme.preds))
    for var i = 1; i < len(m.scheme.preds); i = i + 1 {
        Vec.push(own, Classes.skolemApplyPred(sk, m.scheme.preds[i]))
    }
    let selfName = match selfNameIn {
        Some(n) -> n
        None -> dictName(m.cls)
    }
    -- An equality in that context is a given too, and not a parameter: it has
    -- no evidence, so only the class predicates are named as dictionaries
    -- (`Classes.methodDicts`), as a checked signature does.
    let names = Array.map(own, \dictName(_.name))
    let params = Vec.new(len(own))
    for var i = 0; i < len(own); i = i + 1 {
        if own[i].name != Ty.equals { Vec.push(params, names[i]) }
    }
    let givens = Vec.new(4)
    Vec.push(givens, (selfName, Classes.skolemApplyPred(sk, m.scheme.preds[0])))
    for var i = 0; i < len(own); i = i + 1 {
        Vec.push(givens, (names[i], own[i]))
    }
    for var i = 0; i < len(context) && i < len(contextNames); i = i + 1 {
        Vec.push(givens, (contextNames[i], context[i]))
    }

    let decl = match override {
        Some(d) -> d
        None -> m.decl
    }
    -- The method's own name, unqualified: messages name its class apart.
    let method = Binders.nameAt(g.binders, decl.id, decl.span)
    push(g)
    -- Check the body against the expected type rather than inferring it and
    -- comparing afterwards. Each parameter is bound at its class-declared type
    -- and the body meets the declared result, so the givens apply to them from
    -- the first constraint on. Inferred, an unannotated parameter would be a
    -- variable until a final equation, and a field read through it, or a
    -- family over it, would wait on that equation.
    let inferred = genFunction(g, decl.params, decl.ret, decl.body, decl.span,
        decl.context, None, -1, Some((expected, "the result type of '" + method
                                      + "' that class '" + m.cls + "' declares")))
    -- With the arity right, `genFunction` has already equated the two types
    -- part by part, so this equation fails only on the arity, and reports it.
    -- It is a constraint rather than an error raised here, because an error
    -- raised while generating ends the check before the errors of other units
    -- are collected.
    eq(g, inferred, expected, Some(decl.span),
       "the type of '" + method + "' that class '" + m.cls + "' declares")
    let defn = pop(g)
    -- A binder for the rank, not for the polymorphism: the expected type is
    -- rigid, so nothing generalizes. What the rank buys is that a predicate the
    -- body raised is settled here, against the assumptions, instead of escaping
    -- to the end of the program.
    -- A unit of diagnostics, as a top-level group is.
    -- No context at this site wrote these: the class's signature grants them
    -- to every override.
    emit(g, CUnit(CAssume(Vec.map(givens, fun((n, p)) = (n, p, None)), CLet(LetCell {
        binds = [(C.noBinder, "%" + what + "." + m.name, expected)], defn = defn,
        body = CAnd([]), span = Some(decl.span), topLevel = False,
        dicts = None, skolems = sk.made, rigid = [],
    }))))
    -- Only the constants this scope actually *made*. The mapping also holds the
    -- class variable, whose entry is the instance head rather than a skolem, and
    -- inverting that one would turn every real `Option` in the body back into a
    -- variable.
    let made = Set.new()
    for con in sk.made { Set.add(made, con.name) }
    let skolems = Map.new()
    for (k, v) in Map.entries(sk.mapping) {
        match v {
            TCon(c) -> if Set.contains(made, c.name) { Map.put(skolems, k, v) }
            _ -> {}
        }
    }
    MethodImpl { decl = decl, selfName = selfName, dictParams = params,
                 skolems = skolems }
}

-- -- signatures --------------------------------------------------------------------

-- The type a `fun` states outright, or `None` if it states none.
--
-- A signature is *complete* or it is nothing: every parameter annotated and a
-- return type written. The all-or-nothing rule is not a limitation of the
-- machinery but the point of it -- a half-stated type has no scheme for a
-- recursive call to instantiate, and a reader can tell by eye which functions
-- are checked and which are inferred.
--
-- The quantified variables are read off the annotation scope rather than found
-- by generalization, because generalizing is a *solving* step and nothing here
-- has a rank yet.
fun declaredScheme(g : Generator,
                   decl : FunDecl) -> Option (Scheme, Map String Ty.Type) {
    match decl.body {
        None -> return None
        Some(_) -> {}
    }
    let ret = match decl.ret {
        None -> return None
        Some(r) -> r
    }
    let annots = Vec.new(len(decl.params))
    for p in decl.params {
        match p.kind {
            PAnnot(_, te) -> Vec.push(annots, te)
            _ -> return None
        }
    }
    let tyvars = Map.new()
    let params = Array.map(annots, fun(a) =
        Decls.star(g.decls, a, tyvars, fun() = freshCell(g)))
    let retType = Decls.star(g.decls, ret, tyvars, fun() = freshCell(g))
    let preds = Classes.resolveContext(g.classes, decl.context, tyvars,
                                       Some(fun() = freshCell(g)))
    let quantified = Vec.new(4)
    for (_, v) in Map.entries(tyvars) {
        match v {
            TVar(cell) -> Vec.push(quantified, cell)
            _ -> {}
        }
    }
    let body = TFun(params, retType)
    -- The ambiguity test the inference path applies at generalization, run here
    -- instead, where it is purely syntactic: a written context that constrains a
    -- variable the type does not reach can never be decided by a use site,
    -- because there is nothing at a use site to decide it with.
    let cells = Array.map(preds, fun(p) =
        PredCell { pred = p, span = Some(decl.span), context = "read", hole = newHole() })
    let ids = C.reach(cells, [body])
    -- Blamed in the names the signature wrote, not in the letters printing would
    -- invent: the whole point of a declared type is that it is the programmer's
    -- text, so a complaint about it should quote that text.
    let written = Ty.namer("")
    for (name, v) in Map.entries(tyvars) {
        match v {
            TVar(cell) -> Map.put(written.names, cell.id, name)
            _ -> {}
        }
    }
    for var i = 0; i < len(preds) && i < len(decl.context); i = i + 1 {
        var touches = False
        for v in Ty.varsOf(preds[i].args) {
            if Set.contains(ids, v.id) { touches = True }
        }
        if !touches {
            Ty.typeError("'" + Ty.showPredWith(preds[i], written) + "' constrains a type "
                         + "variable that the declared type of '" + decl.name + "' does "
                         + "not mention; remove it from the context",
                         Some(decl.context[i].span))
        }
    }
    Some((Ty.scheme(quantified, body, preds), tyvars))
}

-- Check a body against the type its `fun` declared.
--
-- The same procedure as a method's, for the same reason: a stated type has to be
-- lived up to, and a fresh unification variable would let a body that is *less*
-- general than the signature pass by narrowing the signature to fit.
fun checkSignature(g : Generator, decl : FunDecl, s : Scheme,
                   tyvars : Map String Ty.Type) -> Constraint {
    let sk = Classes.newSkolems()
    let rigid = Map.new()
    for (name, v) in Map.entries(tyvars) {
        match v {
            TVar(cell) -> Map.put(rigid, name, Classes.skolemBind(sk, cell, name))
            _ -> {}
        }
    }
    let expected = Classes.skolemApply(sk, s.body)
    -- *Every* declared predicate is a fact the body may use, so every one becomes
    -- a given -- an equality included, since reduction reads the assumptions for
    -- the rewrite that makes `Item s` become `Op`. Only a class predicate arrives
    -- as a *dictionary*, though; the erased kinds are facts the body never asks
    -- for evidence of.
    let givens = Vec.new(len(s.preds))
    for p in s.preds {
        Vec.push(givens, (dictName(p.name), Classes.skolemApplyPred(sk, p)))
    }
    let passedNames = Vec.new(4)
    let passedPreds = Vec.new(4)
    for var i = 0; i < len(s.preds); i = i + 1 {
        if Classes.isClass(g.classes, s.preds[i].name) {
            let (n, _) = givens[i]
            Vec.push(passedNames, n)
            Vec.push(passedPreds, s.preds[i])
        }
    }
    let dicts = newAbstraction()
    dicts.params = passedNames
    dicts.preds = passedPreds
    -- The scheme is the signature itself. A top-level declaration's is also in
    -- the environment, but a local one's is defined into a scope popped once
    -- the enclosing body is solved, and this is where the lowering finds it.
    Map.put(dicts.schemes, decl.name, s)
    -- Which constant stands for which of the signature's variables: this body's
    -- recorded types name the constants, and the scheme names the variables.
    for (_, v) in Map.entries(tyvars) {
        match v {
            TVar(cell) -> match Map.get(sk.mapping, cell.id) {
                Some(con) -> Map.put(dicts.skolems, cell.id, con)
                None -> {}
            }
            _ -> {}
        }
    }
    Map.put(g.types.abstractions, decl.id, dicts)

    push(g)
    let inferred = genFunction(g, decl.params, decl.ret, decl.body, decl.span,
                               decl.context, Some(rigid), -1, None)
    eq(g, inferred, expected, Some(decl.span),
       "the declared type of '" + decl.name + "'")
    let defn = pop(g)
    let written = Vec.new(len(givens))
    for var i = 0; i < len(givens); i = i + 1 {
        let (n, p) = givens[i]
        let at = if i < len(decl.context) { Some(decl.context[i].span) } else { None }
        Vec.push(written, (n, p, at))
    }
    CAssume(written, CLet(LetCell {
        binds = [(C.noBinder, "%sig." + decl.name, expected)], defn = defn,
        body = CAnd([]), span = Some(decl.span), topLevel = False,
        dicts = None, skolems = sk.made, rigid = [],
    }))
}

-- Returns a record the solver fills with the scopes open at this point, for
-- a check that runs after solving.
fun siteScopes(g : Generator) -> Use {
    -- A use with no predicates: the solver records its scopes as it does any
    -- use's, and evidence finds nothing to resolve in it. No node holds it, so
    -- the lowering never reads it.
    let u = newUse("%site", None, None, None)
    emit(g, CUse(u))
    u
}

-- Returns the solved type `ty`, reduced through the instances and rewritten
-- by the equalities of the scopes `site` recorded: the givens of the
-- signatures around it, and those the bindings around it retained.
fun resolveUnder(g : Generator, ty : Ty.Type, site : Use) -> Ty.Type {
    -- Both kinds matter: a scrutinee may be `Item s` under a given `Item s ~
    -- Op`, or under a binding that matched it against `Op`'s constructors and
    -- so retained the same equality as a wanted.
    let t = Typed.resolve(g.types, ty)
    let equalities = Vec.new(2)
    for sc in site.scopes {
        for (_, p) in sc.givens {
            if p.name == Ty.equals { Vec.push(equalities, p) }
        }
    }
    if len(equalities) == 0 { return t }
    let (inert, _) = Inert.extend(Inert.empty(g.classes),
                                  Array.map(Vec.toArray(equalities), Inert.given))
    let out = Inert.rewrite(inert, t)
    Inert.close(inert)
    out
}

-- A non-exhaustive match is an error, and so is a refutable binding pattern.
-- Runs after solving, since it needs the scrutinee types resolved.
fun checkExhaustiveness(g : Generator) -> Unit {
    for (site, scrutinee, scopes) in g.matchSites {
        let arms = match site.kind {
            EMatch(_, a) -> a
            _ -> []
        }
        -- Normalized, not merely pruned: the element of a `for ... in` loop is
        -- `Item xs`, and a family names a type only once it has reduced.
        match Exhaustive.check(g.decls, arms, resolveUnder(g, scrutinee, scopes)) {
            None -> {}
            Some(missing) -> {
                -- A bare `_` witness means the scrutinee's type has too many
                -- values to name one -- an `Int`, say -- so there is nothing
                -- useful to quote.
                let detail = if missing == "_" { "it needs a catch-all arm" }
                             else { "'" + missing + "' is not handled" }
                -- An error rather than a warning: a match that falls off the
                -- end has no value to produce, and there is no exception to
                -- raise in its place.
                Ty.typeError("this match is not exhaustive; " + detail,
                             Some(site.span))
            }
        }
    }
    -- Refutable binding patterns, after every match.
    for (pat, bound, fix, scopes) in g.binderSites {
        match Exhaustive.checkPattern(g.decls, pat, resolveUnder(g, bound, scopes)) {
            None -> {}
            Some(missing) -> {
                let detail = if missing == "_" { "every value" }
                             else { "'" + missing + "'" }
                Ty.typeError("this pattern does not match " + detail + "; " + fix,
                             Some(pat.span))
            }
        }
    }
    for le in g.letElses {
        if completes(le.completion, Typed.canReturn(g.types, _)) { fallsThrough(le) }
    }
    -- One warning for each run of unreachable statements, at its first, in
    -- the order they appear in the source. Blocks are recorded outermost
    -- first, so a block nested in another is visited after it.
    let unreachable = Vec.new(4)
    for stmts in g.blocks {
        for var i = 0; i + 1 < len(stmts); i = i + 1 {
            if !completes(stmtCompletion(stmts[i]), Typed.canReturn(g.types, _)) {
                Vec.push(unreachable, stmts[i + 1].span)
                break
            }
        }
    }
    for at in unreachable {
        Diag.report(Diag.warningAt("this statement is unreachable, since the one "
                                   + "before it cannot complete; remove it", at))
    }
    -- A value computed and thrown away is an error unless there is no value.
    for x in g.discardSites {
        let ty = Typed.of_(g.types, x)
        let unit = match ty {
            TCon(c) -> c.name == "Unit"
            _ -> False
        }
        if !unit && completes(completion(x), Typed.canReturn(g.types, _)) {
            Ty.typeError("this expression's value has type '" + Ty.show(ty)
                         + "' and is discarded; use it, or write 'let _ = ...'",
                         Some(x.span))
        }
    }
}

-- Reports that a `let ... else` block can fall through. It does so past its
-- last statement, so that is where the report points.
fun fallsThrough(le : LetElse) -> Unit {
    let at = match le.block.kind {
        EBlock(stmts) -> if len(stmts) > 0 { stmts[len(stmts) - 1].span }
                         else { le.block.span }
        _ -> le.block.span
    }
    Ty.typeError("this 'else' block can fall through; it must end in 'return', "
                 + "'break', 'continue' or a call that never returns", Some(at))
}

-- A block whose value nobody reads -- a loop body, a one-armed `if` -- discards
-- its last statement's value.
fun discardsLast(g : Generator, body : Expr) -> Unit = match body.kind {
    EBlock(stmts) -> if len(stmts) > 0 {
        match stmts[len(stmts) - 1].kind {
            SExpr(x) -> Vec.push(g.discardSites, x)
            _ -> {}
        }
    }
    _ -> {}
}

-- -- binders -----------------------------------------------------------------------

-- Generate a local binding group, scoping it over whatever `rest` generates.
--
-- `rest` is a callback rather than a list of statements because the scope of a
-- `let` is not always "the remaining statements" -- a C-style `for`'s
-- initializer scopes over the condition and step too.
fun bindGroup(g : Generator, group : Vec Stmt, rest : fun() -> a) -> a {
    let binder = groupBinder(g, group)
    push(g)
    let out = rest()
    let body = pop(g)
    emit(g, binder(body, False))
    out
}

-- Generate a top-level binding group. Its binder scopes over nothing: the
-- solver keeps a top-level binder's binding past its end, where every group
-- generated after it sees it.
fun bindTopGroup(g : Generator, group : Vec Stmt) -> Unit {
    let binder = groupBinder(g, group)
    emit(g, binder(CAnd([]), True))
}

-- Generate a group's definition. Answers the binder that scopes what it binds
-- over a body -- the only place a binder is built, so the only place that has
-- to get its shape right.
fun groupBinder(g : Generator, group : Vec Stmt) -> fun(Constraint, Bool) -> Constraint {
    let (binds, defn, generalizes, sigs) = buildDefinition(g, group)
    -- What each `fun` in the group was bound at. A generalizing group's schemes
    -- are recorded by the solver, which is the only place they exist; this covers
    -- the group that does not generalize, whose names are monomorphic.
    let boundTypes = Map.new()
    for (id, _, t) in binds { Map.put(boundTypes, id, t) }
    for (id, _, s) in sigs { Map.put(boundTypes, id, s.body) }
    for item in group {
        match item.kind {
            SFun(d) -> match Map.get(boundTypes, boundAt(g, d.id, d.name, d.span)) {
                Some(t) -> Typed.recordDecl(g.types, d.id, t)
                None -> {}
            }
            _ -> {}
        }
    }

    fun(body, top) = binderOf(g, group, binds, defn, generalizes, sigs, body, top)
}

fun binderOf(g : Generator, group : Vec Stmt, binds : Vec (Int, String, Ty.Type),
             written : Constraint, generalizes : Bool, sigs : Vec (Int, String, Scheme),
             body : Constraint, top : Bool) -> Constraint {
    -- A top-level group is a unit of diagnostics: one wrong expression in it
    -- is reported once, not once for each use that disagrees with it.
    let defn = if top { CUnit(written) } else { written }
    var node = CAnd([])
    if len(binds) == 0 {
        -- Every member states its own type, so there is nothing left to
        -- generalize and no rank to push for.
        node = CAnd([defn, body])
    } else if generalizes {
        -- One abstraction for the group, hung on each declaration in it so the
        -- evaluator can find it, and handed to the binder so the solver can fill
        -- it in when it decides what the schemes retain. A member with a
        -- signature is not in the group's binds and got its own abstraction.
        let dicts = newAbstraction()
        let ids = Set.new()
        for (id, _, _) in binds { Set.add(ids, id) }
        for item in group {
            match item.kind {
                SFun(d) -> if Set.contains(ids, boundAt(g, d.id, d.name, d.span)) {
                    Map.put(g.types.abstractions, d.id, dicts)
                }
                _ -> Map.put(g.types.abstractions, item.id, dicts)
            }
        }
        -- The partial annotations among the group's members, for the solver
        -- to hold to their headers when it generalizes.
        let rigid = []
        for item in group {
            match item.kind {
                SFun(d) -> match Map.get(g.partialHeaders, d.id) {
                    Some((header, written)) ->
                        Vec.push(rigid, (Binders.nameAt(g.binders, d.id, d.span), d.span,
                                         header, written))
                    None -> {}
                }
                _ -> {}
            }
        }
        node = CLet(LetCell {
            binds = binds, defn = defn, body = body, span = Some(group[0].span),
            topLevel = top, dicts = Some(dicts), skolems = [],
            rigid = rigid,
        })
    } else {
        -- No generalization means no new rank, so the definition is solved right
        -- here and only the names are scoped. Nothing needs its rank lowered
        -- afterwards, because nothing ever raised it.
        node = CAnd([defn, CDef(binds, body, top)])
    }
    -- The declared schemes scope over the whole group *and* over the body, which
    -- is what makes a recursive occurrence an instantiation.
    if len(sigs) > 0 { node = CBind(sigs, node, top) }
    node
}

-- The binders a group binds, the definition's constraint, whether it
-- generalizes, and the binders whose signatures state their schemes.
fun buildDefinition(g : Generator, group : Vec Stmt)
        -> (Vec (Int, String, Ty.Type), Constraint, Bool, Vec (Int, String, Scheme)) {
    var allFuns = True
    for item in group {
        match item.kind {
            SFun(_) -> {}
            _ -> { allFuns = False }
        }
    }
    if allFuns {
        let decls = Vec.new(len(group))
        for item in group {
            match item.kind {
                SFun(d) -> Vec.push(decls, d)
                _ -> {}
            }
        }
        let (binds, defn, sigs) = buildFunGroup(g, decls)
        -- A `fun` is syntactically a value, so the value restriction never blocks
        -- generalization here. What can is a declaration saying it does not want
        -- generalizing -- which no program can say, and only a lifted loop's
        -- helper does.
        var mono = False
        for d in decls {
            if d.monomorphic { mono = True }
        }
        return (binds, defn, !mono, sigs)
    }
    let stmt = group[0]
    match stmt.kind {
        SLet(pat, value) -> letDefinition(g, pat, value, False)
        SVar(pat, value) -> letDefinition(g, pat, value, True)
        _ -> bug("only functions may share a binding group", Some(stmt.span))
    }
}

fun letDefinition(g : Generator, pat : Pat, value : Expr, isVar : Bool)
        -> (Vec (Int, String, Ty.Type), Constraint, Bool, Vec (Int, String, Scheme)) {
    push(g)
    let t = genExpr(g, value)
    Vec.push(g.openings, None)
    let bound = matchPattern(g, pat, t)
    discard(Vec.pop(g.openings))
    Vec.push(g.binderSites, (pat, t, "add an 'else' block, or use 'if let' or 'match'",
                             siteScopes(g)))
    let binds = bindersIn(g, [pat], pat.span, bound)
    let defn = pop(g)
    -- Only a `let` bound to a syntactic value generalizes.
    let generalizes = !isVar && isNonexpansive(g, value)
    (binds, defn, generalizes, [])
}

-- One strongly-connected group at a time.
--
-- A group splits by whether a member states its own type. An inferred member's
-- placeholder is bound *monomorphically* inside the definition, which is what
-- keeps polymorphic recursion out of inference, where it is undecidable; the
-- enclosing binder generalizes it only once every body has been solved. A member
-- with a signature is bound to that signature by the `CBind` wrapped around the
-- whole group, so a recursive use of it instantiates instead.
fun buildFunGroup(g : Generator, decls : Vec FunDecl)
        -> (Vec (Int, String, Ty.Type), Constraint, Vec (Int, String, Scheme)) {
    let sigs = Vec.new(4)
    let checks = Vec.new(4)
    let inferred = Vec.new(4)
    for decl in decls {
        Set.add(g.decls.functions, boundAt(g, decl.id, decl.name, decl.span))
        match declaredScheme(g, decl) {
            None -> Vec.push(inferred, decl)
            Some((s, tyvars)) -> {
                Vec.push(sigs, (boundAt(g, decl.id, decl.name, decl.span), decl.name, s))
                Vec.push(checks, (decl, s, tyvars))
            }
        }
    }

    push(g)
    let binds = Vec.new(len(inferred))
    for decl in inferred {
        Vec.push(binds, (boundAt(g, decl.id, decl.name, decl.span), decl.name, fresh(g)))
    }
    push(g)
    for (decl, s, tyvars) in checks {
        emit(g, checkSignature(g, decl, s, tyvars))
    }
    for var i = 0; i < len(inferred); i = i + 1 {
        let decl = inferred[i]
        let (_, _, placeholder) = binds[i]
        eq(g, placeholder,
           genFunction(g, decl.params, decl.ret, decl.body, decl.span,
                       decl.context, None, decl.id, None),
           Some(decl.span), "the definition of '" + Binders.nameAt(g.binders, decl.id, decl.span)
                            + "'")
    }
    let inner = pop(g)
    emit(g, CDef(binds, inner, False))
    (binds, pop(g), sigs)
}

-- A function's own constraint. Parameters bind monomorphically.
--
-- No rank is pushed: a lambda is not a generalization point, so its parameters
-- live at whatever rank the enclosing binder established.
--
-- `rigid` is the annotation scope to work in, and passing one is what
-- distinguishes checking from inferring. It maps each name the signature
-- quantifies to a skolem constant, so every annotation in the body reads the
-- *same* rigid type the signature promised -- and, since the context is then a
-- fact rather than an obligation, it is not emitted here.
-- `key` is the declaration's id when the caller wants a partial annotation's
-- header recorded (an inferred member of a binding group), and -1 otherwise.
-- `expected` is the function type the body is checked against, if the caller
-- has one, and the reason a mismatch with its result type is reported in. Its
-- parameter types are used in place of fresh variables, and so is its result
-- type unless a parameter pattern opens an existential. A type of a different
-- arity is ignored here, and the caller reports the mismatch.
fun genFunction(g : Generator, params : Vec Pat, retAnnot : Option Type,
                bodyExpr : Option Expr, where : Span, context : Vec Ast.Pred,
                rigid : Option (Map String Ty.Type), key : Int,
                expected : Option (Ty.Type, String)) -> Ty.Type {
    let scope = Map.new()
    match rigid {
        Some(r) -> for (n, t) in Map.entries(r) { Map.put(scope, n, t) }
        None -> {}
    }
    Vec.push(g.tyvarScopes, scope)
    push(g)

    let (expectedParams, expectedRet) = match expected {
        Some((TFun(ps, r), why)) -> if len(ps) == len(params) {
            (Some(ps), Some((r, why)))
        } else {
            (None, None)
        }
        _ -> (None, None)
    }
    let binds = Map.new()
    Vec.push(g.openings, Some(Vec.new(2)))
    let paramTypes = Array.init(len(params), fun(i) {
        let param = params[i]
        let tv = match expectedParams {
            Some(ps) -> ps[i]
            None -> fresh(g)
        }
        mergeInto(binds, matchPattern(g, param, tv), param.span)
        Vec.push(g.binderSites, (param, tv,
            "name the parameter and 'match' on it in the body", siteScopes(g)))
        tv
    })
    let openings = popOpenings(g)

    -- A constant a parameter pattern opens must not reach the result. Give the
    -- result a fresh variable from outside the opened scope in that case, and
    -- equate it with the declared result type only after the body, so the
    -- body's equation with the variable reports the escape. Equating the body
    -- with a rigid result first would report a plain mismatch with the hidden
    -- type instead. The cost is that such a body is generated without its
    -- result type known.
    let opens = len(openings) > 0
    let (ret, bodyWhy) = match expectedRet {
        Some((r, why)) -> if opens { (fresh(g), "the function body") } else { (r, why) }
        None -> (fresh(g), "the function body")
    }
    if !opens {
        match retAnnot {
            Some(r) -> eq(g, ret, typeOf(g, r), Some(where), "the return type annotation")
            None -> {}
        }
    }

    -- On the inference path a declared context is emitted as an ordinary demand
    -- rather than attached to the scheme by hand. It then travels the same road
    -- as one the body raised. Asking for a context is not the same as being
    -- granted one, and a `fun` with an incomplete annotation has no signature to
    -- be granted anything by. A complete one does, and there the context has
    -- already become a given, so re-emitting it would demand of the body exactly
    -- what the caller has been made to promise.
    match rigid {
        None -> {
            let written = Classes.resolveContext(g.classes, context,
                g.tyvarScopes[len(g.tyvarScopes) - 1], Some(fun() = freshCell(g)))
            for p in written {
                emit(g, C.cpredOf(p, Some(where), "the context this function declares"))
            }
            -- The header has been read and the body has not, so the scope holds
            -- exactly the variables the header wrote.
            if key >= 0 {
                let header = Vec.new(4)
                for (n, t) in Map.entries(g.tyvarScopes[len(g.tyvarScopes) - 1]) {
                    match t {
                        TVar(_) -> Vec.push(header, (n, t))
                        _ -> {}
                    }
                }
                if len(header) > 0 { Map.put(g.partialHeaders, key, (header, written)) }
            }
        }
        Some(_) -> {}
    }

    -- Parameters are reassignable. They bind monomorphically, so the value
    -- restriction that makes a `var` binding special has nothing to say about
    -- them; reassigning one rebinds this local slot and does not write through
    -- to the caller.
    let bindList = bindersIn(g, params, where, binds)
    for (id, _, _) in bindList { Set.add(g.parameters, id) }
    push(g)
    Vec.push(g.fnStack, ret)
    -- `break` cannot cross a function.
    let loops = g.loopStack
    g.loopStack = Vec.new(4)
    let bodyType = match bodyExpr {
        Some(b) -> genExpr(g, b)
        None -> Ty.tUnit()
    }
    g.loopStack = loops
    discard(Vec.pop(g.fnStack))
    -- A body of type bottom leaves `ret` to be fixed by the `return`s.
    eq(g, ret, bodyType, Some(where), bodyWhy)
    let inner = pop(g)

    -- A parameter that opened an existential scopes its rigid constants over
    -- the body and its `return`s; `ret` was made outside, so neither can hand
    -- one back.
    let defined = CDef(bindList, inner, False)
    if opens {
        emit(g, openedConstraint(openings, defined, Some(where)))
        match retAnnot {
            Some(r) -> eq(g, ret, typeOf(g, r), Some(where), "the return type annotation")
            None -> {}
        }
        match expectedRet {
            Some((r, why)) -> eq(g, r, ret, Some(where), why)
            None -> {}
        }
    } else {
        emit(g, defined)
    }
    emit(g, pop(g))
    discard(Vec.pop(g.tyvarScopes))
    TFun(paramTypes, ret)
}

-- -- patterns ----------------------------------------------------------------------

-- Constrain a pattern against the type it scrutinizes, and name its binders.
-- Binding them is the caller's job, since only the caller knows whether they are
-- monomorphic.
fun matchPattern(g : Generator, pat : Pat, t : Ty.Type) -> Map String Ty.Type {
    let out = matchPatternInner(g, pat, t)
    -- Kept for the lowering, which needs a pattern binder's type wherever a
    -- binder becomes a reference cell. The Core checker derives these
    -- independently from the scrutinee, so recording them here is a second
    -- opinion rather than the only one.
    Typed.recordPattern(g.types, pat, out)
    out
}

fun matchPatternInner(g : Generator, pat : Pat, t : Ty.Type) -> Map String Ty.Type =
    match pat.kind {
        PWild -> Map.new()
        PVar(name) -> {
            let out = Map.new()
            Map.put(out, name, t)
            out
        }
        PLit(l) -> {
            let kind = litKind(l)
            if isNumericKind(kind) {
                eq(g, t, numeric(g, kind, l, Some(pat.span), "a literal pattern"),
                   Some(pat.span), "a literal pattern")
            } else {
                eq(g, t, literalType(kind), Some(pat.span), "a literal pattern")
            }
            Map.new()
        }
        PAnnot(inner, te) -> {
            let what = match inner.kind {
                PVar(name) -> "the annotation on '" + name + "'"
                _ -> "a type annotation"
            }
            eq(g, t, typeOf(g, te), Some(pat.span), what)
            matchPattern(g, inner, t)
        }
        -- An alternative cannot open an existential: which constants it hides
        -- would depend on which alternative matched.
        POr(alts) -> {
            let before = openedSoFar(g)
            let out = alternatives(g, alts, t)
            if openedSoFar(g) > before {
                Ty.typeError("a pattern with alternatives cannot match an existential "
                             + "constructor; match it in an arm of its own", Some(pat.span))
            }
            out
        }
        PTuple(elems) -> {
            let types = Array.map(elems, fun(_) = fresh(g))
            eq(g, t, TTuple(types), Some(pat.span), "a tuple pattern")
            let out = Map.new()
            for var i = 0; i < len(elems); i = i + 1 {
                mergeInto(out, matchPattern(g, elems[i], types[i]), pat.span)
            }
            out
        }
        -- A record variant matches positionally too: the constructor's parameters
        -- are in declaration order for both forms, so nothing here cares which
        -- form declared it. Only the record form may omit fields, which is why
        -- the arity check stays unconditional.
        PCon(name, args) -> match openedCon(g, pat, name) {
            TFun(conParams, conRet) -> {
                if len(args) != len(conParams) {
                    Ty.typeError("constructor '" + name + "' takes "
                                 + Int.toString(len(conParams)) + " argument(s), but the "
                                 + "pattern supplies " + Int.toString(len(args)),
                                 Some(pat.span))
                    return Map.new()
                }
                eq(g, t, conRet, Some(pat.span), "the pattern '" + name + "'")
                let out = Map.new()
                for var i = 0; i < len(args); i = i + 1 {
                    mergeInto(out, matchPattern(g, args[i], conParams[i]), pat.span)
                }
                out
            }
            _ -> Map.new()
        }
        PRecord(name, fields, rest) -> match openedCon(g, pat, name) {
            TFun(conParams, conRet) -> {
                let info = match Decls.con(g.decls, name) {
                    Some(i) -> i
                    None -> bug("unknown constructor '" + name + "'", Some(pat.span))
                }
                let names = match info.fields {
                    Some(ns) -> ns
                    None -> {
                        Ty.typeError("constructor '" + name + "' has positional "
                                     + "arguments, not fields; write '" + name
                                     + "(...)'", Some(pat.span))
                        return Map.new()
                    }
                }
                eq(g, t, conRet, Some(pat.span), "the pattern '" + name + "'")
                let out = Map.new()
                for (label, sub) in fields {
                    match Array.indexOf(names, label) {
                        None -> Ty.typeError("'" + name + "' has no field '" + label + "'",
                                             Some(pat.span))
                        Some(index) -> mergeInto(out,
                            matchPattern(g, sub, conParams[index]), pat.span)
                    }
                }
                -- Every field named, or a trailing `..`: a pattern that claims
                -- to cover the record must break when a field is added to it.
                if !rest {
                    let named = Vec.new(len(fields))
                    for (label, _) in fields { Vec.push(named, label) }
                    for n in names {
                        if !Vec.contains(named, n) {
                            Ty.typeError("the pattern '" + Ty.shortName(name) + "' does not mention field '"
                                         + n + "'; name it, or write '..' to ignore the rest",
                                         Some(pat.span))
                        }
                    }
                }
                out
            }
            _ -> Map.new()
        }
    }

fun mergeInto(into : Map String Ty.Type, new : Map String Ty.Type,
              where : Span) -> Unit {
    for (name, ty) in Map.entries(new) {
        if Map.contains(into, name) {
            Ty.typeError("'" + name + "' is bound twice in the same pattern", Some(where))
        }
        Map.put(into, name, ty)
    }
}

-- -- statements --------------------------------------------------------------------

-- A block's value is its last statement's, and a declaration contributes Unit.
-- A binder scopes over the statements that follow it, so it is
-- generated as a binder *around* them rather than as one more statement.
--
-- A statement that cannot complete makes the block bottom, and lowering stops
-- there. The statements after it are still generated, so that what is wrong
-- with them is still reported.
--
-- `stmtStops` walks the whole statement, and a statement nested in this one
-- is walked again by its own block, so the cost grows with the depth of
-- nesting. Caching an answer per node would cost a table for a walk that is
-- already linear at each level.
fun genSequence(g : Generator, stmts : Vec Stmt, from : Int) -> Ty.Type {
    if from >= len(stmts) { return Ty.tUnit() }
    let stmt = stmts[from]
    let ty = match stmt.kind {
        SLet(_, _) -> bindGroup(g, [stmt], fun() = genSequence(g, stmts, from + 1))
        SVar(_, _) -> bindGroup(g, [stmt], fun() = genSequence(g, stmts, from + 1))
        SFun(_) -> bindGroup(g, [stmt], fun() = genSequence(g, stmts, from + 1))
        _ -> {
            let value = genStmt(g, stmt)
            if from + 1 < len(stmts) {
                if let SExpr(x) = stmt.kind { Vec.push(g.discardSites, x) }
                genSequence(g, stmts, from + 1)
            } else { value }
        }
    }
    if stmtStops(stmt) { TBottom } else { ty }
}

-- A statement that binds nothing. Binders go through `bindGroup`.
fun genStmt(g : Generator, stmt : Stmt) -> Ty.Type = match stmt.kind {
    SExpr(e) -> genExpr(g, e)
    SAssign(target, value) -> {
        genAssign(g, stmt.span, target, value)
        Ty.tUnit()
    }
    _ -> bug("a binder reached the statement generator", Some(stmt.span))
}

fun genAssign(g : Generator, where : Span, target : Expr, value : Expr) -> Unit =
    match target.kind {
        EVar(name, _) -> {
            let id = referent(g, target, name, where)
            if id != C.noBinder && !assignable(g, id) { notAssignable(g, id, where) }
            eq(g, use(g, name, id, Some(where), None), genExpr(g, value), Some(where),
               "the assignment to '" + name + "'")
        }
        EField(_, _) -> {
            let fieldType = genField(g, target, True)
            eq(g, fieldType, genExpr(g, value), Some(where), "the assigned value")
        }
        EIndex(arr, index, _, _) -> {
            let element = fresh(g)
            eq(g, genExpr(g, arr), Ty.arrayOf(element), Some(where),
               "an indexed assignment")
            eq(g, genExpr(g, index), Ty.tInt(), Some(where), "an array index")
            eq(g, element, genExpr(g, value), Some(where), "the assigned value")
        }
        _ -> bug("the parser should have rejected this assignment target",
                 Some(where))
    }

-- -- expressions -------------------------------------------------------------------

fun genExpr(g : Generator, e : Expr) -> Ty.Type {
    var ty = genExprKind(g, e)
    -- An `else` block is bottom, like a `return`, and is checked once types
    -- are solved not to fall through. Answering its real type would report a
    -- block that falls through as a mismatch between the arms instead.
    --
    -- So is a call in its tail positions, for the block that desugaring
    -- rewrote into a value and so is no longer here to be bottom. That call's
    -- result would otherwise unify with the type of the names the `let` binds,
    -- and the check could no longer see that the callee never returns. It is
    -- sound because the check passes only if each such call never returns or
    -- is never reached.
    if Set.contains(g.bottoms, e.id) { ty = TBottom }
    -- One place, so no case can forget. What is recorded is the variable itself,
    -- not a snapshot of it: solving fills it in later.
    Typed.record(g.types, e, ty)
    ty
}

-- `name <= t` for a fresh `t`. No lookup: that is the solver's job.
--
-- A `Use` rides along when there is an occurrence to attach it to, so that
-- the solver has somewhere to put the evidence this site turns out to need.
-- What that is cannot be known here -- it depends on what the solver decides the
-- name's predicates are about -- which is why the site is marked rather than
-- resolved.
fun use(g : Generator, name : String, id : Int, where : Option Span,
        node : Option Expr) -> Ty.Type {
    -- A name `referent` reported as undefined.
    if id == C.noBinder { return TBottom }
    let t = fresh(g)
    let marker = match node {
        Some(n) -> {
            let u = newUse(name, Some(id), where, None)
            Map.put(g.types.uses, n.id, u)
            Some(u)
        }
        None -> None
    }
    emit(g, CInstance(name, t, where, marker, OfBinder(id)))
    t
}

-- A fresh variable, plus the set of types a numeric literal could have.
--
-- A numeric literal is not given a type here. Which type it has is a decision,
-- and decisions belong to the solver -- the set is all the syntax actually
-- determines. `1` is not an `Int` that a later rule might widen; it is a numeral
-- whose set happens to contain `Int`.
fun numeric(g : Generator, kind : String, l : Lit, where : Option Span,
            context : String) -> Ty.Type {
    let t = fresh(g)
    let names = if kind == "Int" {
        match l {
            LInt(v) -> Ty.intLiteralSet(v)
            _ -> Ty.floatLiteralSet()
        }
    } else { Ty.floatLiteralSet() }
    emit(g, C.cpredOf(Ty.pred(C.oneOf, [t, TSet(names)]), where, context))
    t
}

-- Like a numeral, an array literal does not decide its own container: it is
-- one of a closed set, decided by use and defaulted to `Array`. The demand is
-- `OneOf t {Array, Vec} e` over the literal's whole type `t`, with its element
-- `e` beside the set, so that a use which is no container at all is reported
-- against the literal -- `an array literal cannot have type 'Int'` -- rather
-- than as a mismatch with an undecided container applied to the element.
--
-- A set of one is that type outright, with no demand, so a mismatch is
-- reported as the plain equation with `Array` that it is.
fun arrayLiteralType(g : Generator, e : Expr, element : Ty.Type) -> Ty.Type {
    let set = Ty.arrayLiteralSet(Map.contains(g.decls.tycons, _))
    if len(set) == 1 { return Ty.arrayOf(element) }
    let t = fresh(g)
    emit(g, C.cpredOf(Ty.pred(C.oneOf, [t, TSet(set), element]), Some(e.span),
                      "an array literal"))
    t
}

fun genExprKind(g : Generator, e : Expr) -> Ty.Type = match e.kind {
    ELit(l) -> {
        let kind = litKind(l)
        if isNumericKind(kind) {
            numeric(g, kind, l, Some(e.span), "a numeric literal")
        }
        else { literalType(kind) }
    }
    EUnit -> Ty.tUnit()
    EVar(name, _) -> use(g, name, referent(g, e, name, e.span), Some(e.span), Some(e))
    ECon(name) -> match conType(g, e, name) {
        -- A nullary constructor is a value; anything else is a function.
        TFun(params, ret) -> if len(params) == 0 { ret } else { TFun(params, ret) }
        other -> other
    }
    ETuple(elems) -> TTuple(Array.map(elems, genExpr(g, _)))
    EArray(elems) -> {
        var element = fresh(g)
        for item in elems {
            element = join(g, element, genExpr(g, item), Some(item.span),
                           "an array literal")
        }
        arrayLiteralType(g, e, element)
    }
    ERecord(conName, fields) -> genRecord(g, e, conName, fields)
    ELambda(params, ret, body) ->
        genFunction(g, params, ret, Some(body), e.span, [], None, -1, None)
    ECall(fn, args) -> {
        let fnType = genExpr(g, fn)
        let argTypes = Array.map(args, genExpr(g, _))
        let result = fresh(g)
        eq(g, fnType, TFun(argTypes, result), Some(e.span), callContext(args))
        result
    }
    EIndex(arr, index, _, _) -> {
        let element = fresh(g)
        eq(g, genExpr(g, arr), Ty.arrayOf(element), Some(e.span), "the indexed value")
        eq(g, genExpr(g, index), Ty.tInt(), Some(index.span), "an array index")
        element
    }
    EField(_, _) -> genField(g, e, False)
    EProject(obj, index) -> {
        let receiver = genExpr(g, obj)
        let cls = Classes.projectionClass(index)
        discard(Classes.ensureGenerated(g.classes, cls))
        emit(g, C.cpredOf(Ty.pred(cls, [receiver]), Some(e.span), "read"))
        let fam = Classes.projectionFamily(index)
        TFam(fam, receiver, familyResult(g, fam))
    }
    EUnary(op, operand, fn) -> match fn {
        Some(f) -> genOperator(g, f, [operand], op, e.span)
        None -> match unaryOp(op) {
            Some((want, result)) -> {
                eq(g, genExpr(g, operand), want, Some(e.span),
                   "the operand of '" + op + "'")
                result
            }
            None -> bug("no rule for unary '" + op + "'", Some(e.span))
        }
    }
    EBinary(op, left, right, fn) -> match fn {
        Some(f) -> genOperator(g, f, [left, right], op, e.span)
        None -> match binaryOp(op) {
            Some((wantLeft, wantRight, result)) -> {
                eq(g, genExpr(g, left), wantLeft, Some(left.span),
                   "the left operand of '" + op + "'")
                eq(g, genExpr(g, right), wantRight, Some(right.span),
                   "the right operand of '" + op + "'")
                result
            }
            None -> bug("no rule for binary '" + op + "'", Some(e.span))
        }
    }
    EChain(_, _) -> bug("an operator chain survived resolution", Some(e.span))
    EAnnot(inner, te) -> {
        let annotated = typeOf(g, te)
        join(g, genExpr(g, inner), annotated, Some(e.span), "a type annotation")
    }
    EBlock(stmts) -> {
        Vec.push(g.blocks, stmts)
        genSequence(g, stmts, 0)
    }
    EIf(cond, then, otherwise) -> {
        eq(g, genExpr(g, cond), Ty.tBool(), Some(cond.span), "an 'if' condition")
        let thenType = genExpr(g, then)
        match otherwise {
            -- A statement-style `if` has no value.
            None -> {
                discardsLast(g, then)
                Ty.tUnit()
            }
            Some(o) -> join(g, thenType, genExpr(g, o), Some(e.span),
                            "the branches of an 'if'")
        }
    }
    EWhile(cond, body) -> {
        eq(g, genExpr(g, cond), Ty.tBool(), Some(cond.span), "a 'while' condition")
        Vec.push(g.loopStack, LoopCtx {
            kind = "while", result = Ty.tUnit(),
        })
        discard(genExpr(g, body))
        discardsLast(g, body)
        discard(Vec.pop(g.loopStack))
        Ty.tUnit()
    }
    EForIn(pat, iterable, body, iterFn, nextFn) ->
        genForIn(g, e, pat, iterable, body, iterFn, nextFn)
    EForC(init, cond, step, body) -> {
        let rest = fun() = {
            eq(g, genExpr(g, cond), Ty.tBool(), Some(cond.span), "a 'for' condition")
            Vec.push(g.loopStack, LoopCtx {
                kind = "for", result = Ty.tUnit(),
            })
            discard(genExpr(g, body))
            discardsLast(g, body)
            match step {
                Some(s) -> discard(genStmt(g, s))
                None -> {}
            }
            discard(Vec.pop(g.loopStack))
            Ty.tUnit()
        }
        match init {
            -- The initializer's scope is the condition, body and step -- not a
            -- list of following statements, which is why `bindGroup` takes a
            -- callback.
            Some(s) -> match s.kind {
                SLet(_, _) -> bindGroup(g, [s], rest)
                SVar(_, _) -> bindGroup(g, [s], rest)
                _ -> {
                    discard(genStmt(g, s))
                    rest()
                }
            }
            None -> rest()
        }
    }
    ELoop(body) -> {
        let ctx = LoopCtx { kind = "loop", result = fresh(g) }
        Vec.push(g.loopStack, ctx)
        discard(genExpr(g, body))
        discardsLast(g, body)
        discard(Vec.pop(g.loopStack))
        -- A `loop` never falls through, so its value comes only from its
        -- breaks. With no break it can reach, it never produces one.
        if breaksOut(body) { ctx.result } else { TBottom }
    }
    EMatch(scrutinee, arms) -> genMatch(g, e, scrutinee, arms)
    EReturn(value) -> {
        if len(g.fnStack) == 0 {
            Ty.typeError("'return' cannot appear outside a function", Some(e.span))
            return TBottom
        }
        let t = match value {
            Some(v) -> genExpr(g, v)
            None -> Ty.tUnit()
        }
        eq(g, g.fnStack[len(g.fnStack) - 1], t, Some(e.span), "a 'return'")
        TBottom
    }
    EBreak(value) -> {
        if len(g.loopStack) == 0 {
            Ty.typeError("'break' cannot appear outside a loop", Some(e.span))
            return TBottom
        }
        let ctx = g.loopStack[len(g.loopStack) - 1]
        match value {
            None -> eq(g, ctx.result, Ty.tUnit(), Some(e.span),
                       "a valueless 'break'")
            Some(v) -> if ctx.kind != "loop" {
                Ty.typeError("'break' cannot carry a value out of a '" + ctx.kind
                             + "' loop; remove the value, or use 'loop'", Some(e.span))
            } else {
                ctx.result = join(g, ctx.result, genExpr(g, v), Some(e.span),
                                  "a 'break'")
            }
        }
        TBottom
    }
    EContinue -> {
        if len(g.loopStack) == 0 {
            Ty.typeError("'continue' cannot appear outside a loop", Some(e.span))
        }
        TBottom
    }
    EQuestion(_, _) -> bug("'?' survived desugaring", Some(e.span))
    EDo(_) -> bug("'do' survived desugaring", Some(e.span))
}

-- A constructor's type at a use: an existential with a context is used like a
-- constrained function, so its predicates are wanted here and the `Use` its node
-- carries is where the solver puts the evidence for them.
fun conType(g : Generator, e : Expr, name : String) -> Ty.Type {
    let info = match Decls.con(g.decls, name) {
        Some(i) -> i
        None -> return Decls.instantiateCon(g.decls, name, fun() = freshCell(g),
                                            Some(e.span))
    }
    if len(info.scheme.preds) == 0 {
        return Decls.instantiateCon(g.decls, name, fun() = freshCell(g),
                                    Some(e.span))
    }
    let params = Array.init(info.arity, fun(_) = fresh(g))
    let con = TFun(params, fresh(g))
    let u = newUse(name, None, Some(e.span), None)
    Map.put(g.types.uses, e.id, u)
    emit(g, CInstance(name, con, Some(e.span), Some(u), OfScheme(info.scheme)))
    con
}

-- A constructor pattern's type, opening the constructor if it is existential.
-- Each hidden variable becomes a rigid constant named for the
-- one the bracket wrote, and each predicate a given under a fresh dictionary
-- name; both are recorded on the pattern, for Core, and on the enclosing arm or
-- function, which is what scopes them.
fun openedCon(g : Generator, pat : Pat, name : String) -> Ty.Type {
    let info = match Decls.con(g.decls, name) {
        Some(i) -> i
        None -> return Decls.instantiateCon(g.decls, name, fun() = freshCell(g),
                                            Some(pat.span))
    }
    if len(info.exists) == 0 {
        return Decls.instantiateCon(g.decls, name, fun() = freshCell(g),
                                    Some(pat.span))
    }
    let top = if len(g.openings) == 0 { None } else {
        g.openings[len(g.openings) - 1]
    }
    let pending = match top {
        Some(list) -> list
        None -> {
            Ty.typeError("the existential constructor '" + name + "' cannot be "
                + "matched by a 'let', 'var' or 'for' pattern; match it in a "
                + "'match' arm or a function parameter", Some(pat.span))
            return TBottom
        }
    }
    -- One `Skolems` per pattern, but the names have to be unique across the
    -- whole opening scope, not just this pattern: every opening in an arm or a
    -- parameter list shares the rank that `openedConstraint` stamps them with.
    -- `unify` tells two rigid constants apart by `uid`, but a diagnostic names
    -- one by its name, and `Layout.matchTypes` compares name and rank. Two
    -- patterns that both write `a` would otherwise print, and match, as one
    -- type.
    let sk = Classes.newSkolems()
    for (_, earlier) in pending {
        for made in earlier { Set.add(sk.used, made.name) }
    }
    let mapping = Map.new()
    for q in info.scheme.quantified { Map.put(mapping, q.id, fresh(g)) }
    for var i = 0; i < len(info.exists) && i < len(info.existsNames); i = i + 1 {
        Map.put(mapping, info.exists[i].id,
                Classes.skolemBind(sk, info.exists[i], info.existsNames[i]))
    }
    for made in sk.made { Ty.markOpened(made.uid, name) }
    let con = Decls.substitute(info.scheme.body, mapping)
    let givens = Array.map(info.scheme.preds, fun(p) = (dictName(p.name), Ty.pred(p.name,
        Array.map(p.args, Decls.substitute(_, mapping)))))
    pat.opening = Some(Opening {
        evidence = Array.map(givens, _.0), skolems = sk.made,
    })
    Vec.push(pending, (givens, sk.made))
    con
}

-- `inner`, under what its patterns opened: one rank for the rigid constants to
-- live at, and the carried instances as givens -- the shape `checkSignature`
-- builds for a declared type, with a pattern as the second source of
-- assumptions.
fun openedConstraint(openings : Vec (Array (String, Pred), Vec ConCell),
                     inner : Constraint, where : Option Span) -> Constraint {
    let givens = Vec.new(2)
    let skolems = Vec.new(2)
    for (gs, made) in openings {
        for (n, p) in gs { Vec.push(givens, (n, p, None)) }
        for s in made { Vec.push(skolems, s) }
    }
    CAssume(givens, CLet(LetCell {
        binds = [(C.noBinder, "%opened", Ty.tUnit())], defn = inner,
        body = CAnd([]), span = where, topLevel = False,
        dicts = None, skolems = skolems, rigid = [],
    }))
}

-- Returns how many existentials the innermost arm or parameter list has
-- opened so far.
fun openedSoFar(g : Generator) -> Int = match Vec.last(g.openings) {
    Some(Some(list)) -> len(list)
    _ -> 0
}

fun popOpenings(g : Generator) -> Vec (Array (String, Pred), Vec ConCell) =
    match Vec.pop(g.openings) {
        Some(Some(list)) -> list
        _ -> []
    }

fun genRecord(g : Generator, e : Expr, conName : String,
              fields : Vec (String, Expr)) -> Ty.Type =
    match conType(g, e, conName) {
        TFun(conParams, conRet) -> {
            let info = match Decls.con(g.decls, conName) {
                Some(i) -> i
                None -> bug("unknown constructor '" + conName + "'", Some(e.span))
            }
            let names = match info.fields {
                Some(ns) -> ns
                None -> {
                    Ty.typeError("constructor '" + conName + "' takes positional "
                                 + "arguments; write '" + conName + "(...)'",
                                 Some(e.span))
                    return TBottom
                }
            }
            let given = Array.map(fields, fun(f) = {
                let (label, _) = f
                label
            })
            for f in given {
                if !Array.contains(names, f) {
                    Ty.typeError("'" + conName + "' has no field '" + f + "'", Some(e.span))
                }
            }
            let missing = Vec.new(2)
            for n in names {
                if !Array.contains(given, n) { Vec.push(missing, n) }
            }
            if len(missing) > 0 {
                let noun = if len(missing) == 1 { "field " } else { "fields " }
                Ty.typeError("'" + conName + "' is missing " + noun
                             + String.join(Vec.map(missing, fun(n) = "'" + n + "'"), ", "),
                             Some(e.span))
            }
            let seen = Set.new()
            for f in given {
                if Set.contains(seen, f) {
                    Ty.typeError("field '" + f + "' is initialized twice in '" + conName
                                 + "'", Some(e.span))
                }
                Set.add(seen, f)
            }
            -- Fields evaluate left to right, so check them in that order.
            for (label, value) in fields {
                match Array.indexOf(names, label) {
                    Some(index) -> eq(g, conParams[index], genExpr(g, value),
                        Some(value.span),
                        "field '" + label + "' of '" + conName + "'")
                    None -> {}
                }
            }
            conRet
        }
        other -> other
    }

-- The result kind of a generated family, which `ensureGenerated` declared.
fun familyResult(g : Generator, fam : String) -> Ty.Kind =
    match Map.get(g.classes.decls.families, fam) {
        Some(info) -> info.resKind
        None -> bug("'" + fam + "' was not declared", None)
    }

-- Emit `%HasField.f r` for `r.f` and hand back `%Field.f r`. An assignment to
-- `r.f` emits `%SetField.f r` beside it, which only a `var` field satisfies.
--
-- Nothing is decided here. If the receiver turns out to be known the solver
-- finds the generated instance and the family reduces to the declared field
-- type; if not, the predicate waits, and may end up travelling in a scheme.
-- Pruning the receiver and demanding a record on the spot would instead make
-- `a.length` mean different things depending on how much of the program the
-- walk had already seen.
--
-- The site keeps a `Use` of the same predicates, in that order: the reader's,
-- then the setter's. Where the receiver stays polymorphic, the lowering has no
-- record type to find the field in, and reads or writes it through the
-- accessors these predicates' dictionaries carry.
--
-- The result is a *family application* rather than a fresh variable, and that
-- is what retires `improve`'s hand-written functional dependency: two reads of
-- `r.f` used to be two unrelated variables that an improvement rule had to
-- equate, and are now the same type expression, which ordinary unification
-- equates for free.
fun genField(g : Generator, e : Expr, assigning : Bool) -> Ty.Type =
    match e.kind {
        EField(obj, name) -> {
            let receiver = genExpr(g, obj)
            let cls = Classes.fieldClass(name)
            discard(Classes.ensureGenerated(g.classes, cls))
            let u = newUse(cls, None, Some(e.span), None)
            let reads = Ty.pred(cls, [receiver])
            let readHole = newHole()
            Vec.push(u.preds, reads)
            Vec.push(u.holes, readHole)
            emit(g, C.cpredInto(reads, readHole, Some(e.span),
                if assigning { "assign to" } else { "read" }))
            if assigning {
                let setter = Classes.setterClass(name)
                discard(Classes.ensureGenerated(g.classes, setter))
                let writes = Ty.pred(setter, [receiver])
                let writeHole = newHole()
                Vec.push(u.preds, writes)
                Vec.push(u.holes, writeHole)
                emit(g, C.cpredInto(writes, writeHole, Some(e.span), "assign to"))
            }
            Map.put(g.types.uses, e.id, u)
            emit(g, CUse(u))
            let fam = Classes.fieldFamily(name)
            TFam(fam, receiver, familyResult(g, fam))
        }
        _ -> bug("not a field access", Some(e.span))
    }

-- An operator is a call to the method it desugars to.
--
-- Nothing here knows that `add` is special. The method's own scheme --
-- `[Add a] fun(a, a) -> a` -- is what makes both operands agree and what raises
-- the class predicate, so an operator on a user's own type needs no case
-- anywhere: it needs an instance.
fun genOperator(g : Generator, fn : Expr, operands : Array Expr, op : String,
                where : Span) -> Ty.Type {
    let m = genExpr(g, fn)
    let args = Array.map(operands, genExpr(g, _))
    let result = fresh(g)
    var what = if len(args) > 1 { "the operands of '" + op + "'" }
               else { "the operand of '" + op + "'" }
    -- A bare `_` makes a function of the call around it and no further, so
    -- `show(_) + "!"` adds a function to a string, and the mismatch is here.
    for operand in operands {
        if Ast.isShorthand(operand) {
            what = what + ", where '_' means '" + Ast.sketch(operand) + "'"
            break
        }
    }
    eq(g, m, TFun(args, result), Some(where), what)
    result
}

-- `for x in xs` walks a cursor, and `x` is `Item xs`.
--
-- `iter` makes the cursor and `next` advances it; both are generated as ordinary
-- uses, so the loop demands `Iterator` the same way any call does and
-- elaboration hands it a dictionary with no case of its own. Both the cursor and
-- the element are family applications, and are left to reduce like every other
-- one.
fun genForIn(g : Generator, e : Expr, pat : Pat, iterable : Expr, body : Expr,
             iterFn : Option Expr, nextFn : Option Expr) -> Ty.Type {
    let sequence = genExpr(g, iterable)
    let cursor = fresh(g)
    let element = fresh(g)
    let where = "the sequence of a 'for ... in' loop"
    let iter = match iterFn {
        Some(f) -> f
        None -> bug("this 'for' loop has no 'iter' in scope", Some(e.span))
    }
    let next = match nextFn {
        Some(f) -> f
        None -> bug("this 'for' loop has no 'next' in scope", Some(e.span))
    }
    eq(g, genExpr(g, iter), TFun([sequence], cursor), Some(iterable.span), where)
    eq(g, genExpr(g, next),
       TFun([sequence, cursor],
            Ty.applyTo(Decls.head(g.decls, P.optionType), [element], None)),
       Some(iterable.span), where)
    -- `x` is a fresh immutable binding each iteration.
    Vec.push(g.openings, None)
    let binds = matchPattern(g, pat, element)
    discard(Vec.pop(g.openings))
    Vec.push(g.binderSites, (pat, element,
        "name the element and 'match' on it in the loop body", siteScopes(g)))
    push(g)
    Vec.push(g.loopStack, LoopCtx {
        kind = "for", result = Ty.tUnit(),
    })
    discard(genExpr(g, body))
    discardsLast(g, body)
    discard(Vec.pop(g.loopStack))
    let inner = pop(g)
    emit(g, CDef(bindersIn(g, [pat], pat.span, binds), inner, False))
    Ty.tUnit()
}

fun genMatch(g : Generator, e : Expr, scrutinee : Expr,
             arms : Vec Arm) -> Ty.Type {
    let scrutineeType = genExpr(g, scrutinee)
    Vec.push(g.matchSites, (e, scrutineeType, siteScopes(g)))
    var result = TBottom
    for arm in arms {
        Vec.push(g.openings, Some(Vec.new(2)))
        let bindings = alternatives(g, arm.patterns, scrutineeType)
        let openings = popOpenings(g)
        if len(openings) > 0 && len(arm.patterns) > 1 {
            Ty.typeError("an arm with alternatives cannot match an existential "
                         + "constructor; give it an arm of its own", Some(arm.span))
        }
        -- The arm's value is joined with the others *inside* the rank its
        -- patterns opened, so a type it hides cannot leave through it: the
        -- variable standing for the result is made out here, older than the
        -- rigid constants.
        let answer = if len(openings) > 0 { Some(fresh(g)) } else { None }
        push(g)
        let guardBindings = guards(g, arm.guards)
        var body = genExpr(g, arm.body)
        closeGuards(g, guardBindings)
        match answer {
            Some(ans) -> match body {
                TBottom -> {}
                _ -> {
                    eq(g, ans, body, Some(arm.span), "the arms of a 'match'")
                    body = ans
                }
            }
            None -> {}
        }
        let armC = pop(g)
        -- The alternatives bind one set of binders between them, so the
        -- first's are all of them.
        let defined = CDef(bindersIn(g, [arm.patterns[0]], arm.span, bindings), armC,
                           False)
        if len(openings) > 0 {
            emit(g, openedConstraint(openings, defined, Some(arm.span)))
        } else {
            emit(g, defined)
        }
        result = join(g, result, body, Some(arm.span), "the arms of a 'match'")
    }
    result
}

-- Returns what the patterns of one arm or one `let` guard bind, each matched
-- against `ty`. Reports a type error unless every pattern binds the names the
-- first one does, at the same types.
fun alternatives(g : Generator, patterns : Vec Pat, ty : Ty.Type) -> Map String Ty.Type {
    let bindings = matchPattern(g, patterns[0], ty)
    for var i = 1; i < len(patterns); i = i + 1 {
        let alt = patterns[i]
        let other = matchPattern(g, alt, ty)
        match unshared(other, bindings) {
            Some((name, True)) -> Ty.typeError("this alternative binds '" + name
                + "' and the first does not; every alternative must bind "
                + "the same variables", Some(alt.span))
            Some((name, False)) -> Ty.typeError("this alternative does not bind '"
                + name + "' and the first does; every alternative must "
                + "bind the same variables", Some(alt.span))
            None -> {}
        }
        for (name, t) in Map.entries(other) {
            eq(g, Map.getOr(bindings, name, t), t, Some(alt.span),
               "the binding '" + name + "'")
        }
    }
    bindings
}

-- Generates an arm's guards, in order, and returns the binders each `let`
-- guard binds, with their types. A test is a `Bool`. A `let` guard's binders
-- are in scope for the guards after it and the arm's body; `closeGuards`
-- binds them around those, given what this returns.
--
-- Refuse an existential in a `let` guard: its rigid constants would have to
-- scope over the guards after it and the body, inside the arm's own rank.
fun guards(g : Generator, gs : Vec Guard) -> Vec (Vec (Int, String, Ty.Type)) {
    let opened = []
    for guard in gs {
        match guard {
            GTest(test) ->
                eq(g, genExpr(g, test), Ty.tBool(), Some(test.span), "a condition")
            GLet(patterns, value) -> {
                let ty = genExpr(g, value)
                Vec.push(g.openings, None)
                let bindings = alternatives(g, patterns, ty)
                discard(Vec.pop(g.openings))
                push(g)
                -- The alternatives bind one set of binders between them, so
                -- the first's are all of them.
                Vec.push(opened, bindersIn(g, [patterns[0]], value.span, bindings))
            }
        }
    }
    opened
}

-- Closes the frames `guards` opened, innermost first, binding what each bound.
fun closeGuards(g : Generator, opened : Vec (Vec (Int, String, Ty.Type))) -> Unit {
    for var i = len(opened) - 1; i >= 0; i = i - 1 {
        let inner = pop(g)
        emit(g, CDef(opened[i], inner, False))
    }
}

-- Returns a name that exactly one of `alt` and `first` binds, paired with
-- whether `alt` is the one that binds it, or `None` if they bind the same
-- names. The first such name in sorted order is returned.
fun unshared(alt : Map String Ty.Type,
             first : Map String Ty.Type) -> Option (String, Bool) {
    for k in Array.sort(Map.keys(alt) + Map.keys(first)) {
        let inAlt = Map.contains(alt, k)
        if inAlt != Map.contains(first, k) { return Some((k, inAlt)) }
    }
    None
}

-- -- the value restriction ---------------------------------------------------------

-- Only a syntactic value may be generalized.
fun isNonexpansive(g : Generator, e : Expr) -> Bool = match e.kind {
    ELit(_) -> True
    EUnit -> True
    EVar(_, _) -> True
    ELambda(_, _, _) -> True
    ECon(_) -> True
    EAnnot(inner, _) -> isNonexpansive(g, inner)
    ETuple(elems) -> {
        for x in elems {
            if !isNonexpansive(g, x) { return False }
        }
        True
    }
    -- `C(v1, ..., vn)` for an immutable constructor is still a value.
    ECall(fn, args) -> match fn.kind {
        ECon(name) -> {
            if !immutableCon(g, name) { return False }
            for a in args {
                if !isNonexpansive(g, a) { return False }
            }
            True
        }
        _ -> False
    }
    ERecord(conName, fields) -> {
        if !immutableCon(g, conName) { return False }
        for (_, v) in fields {
            if !isNonexpansive(g, v) { return False }
        }
        True
    }
    _ -> False
}

fun immutableCon(g : Generator, name : String) -> Bool = match Decls.con(g.decls, name) {
    None -> False
    Some(info) -> match Map.get(g.decls.tycons, info.tycon) {
        Some(t) -> !Decls.isMutable(t)
        None -> False
    }
}

-- What a call's mismatch is reported in. When an argument is a function made by
-- `_`, or a call around one, the context also shows that function: a `_` whose
-- extent was not what its author meant surfaces as a mismatch at exactly such
-- a call, and the extent is the thing the message has to show.
fun callContext(args : Vec Expr) -> String = match shorthandIn(args, 2) {
    Some(l) -> "a function call, where '_' means '" + Ast.sketch(l) + "'"
    None -> "a function call"
}

fun shorthandIn(args : Vec Expr, depth : Int) -> Option Expr {
    for a in args {
        if Ast.isShorthand(a) { return Some(a) }
    }
    if depth > 1 {
        for a in args {
            match a.kind {
                ECall(_, inner) -> match shorthandIn(inner, depth - 1) {
                    Some(l) -> { return Some(l) }
                    None -> {}
                }
                _ -> {}
            }
        }
    }
    None
}

-- Reports a check that only a compiler bug can fail.
fun bug(message : String, where : Option Span) -> a = match where {
    None -> Diag.fail(Diag.whole("internal error", message), "")
    Some(s) -> Diag.fail(Diag.at("internal error", message, s), s.file)
}

fun discard(x : a) -> Unit = {}
