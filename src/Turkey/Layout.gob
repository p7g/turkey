export (
    Flat(..), layoutOf, flatOf, unfolds, storedRep, flatLimit, share, packedKeyParts,
    packingIndex, packingCount, isOpened, skolemKey, unknownLayouts,
)

-- One compiled body per distinct *layout* of the type arguments: the pass that
-- makes unboxing total.
--
-- Monomorphization specializes a binding per distinct tuple of type arguments,
-- and it is partial **by decision**: the language admits polymorphic recursion,
-- so the set of types a binding is used at can be infinite -- `fun depth(x : a,
-- n : Int)` recursing at `Pair a` asks for `Pair Int`, `Pair (Pair Int)`, and
-- so on without end -- and it is capped. Past the cap a call site keeps its
-- `CTyApp` and calls a body that is still generic.
--
-- This pass is the same specialization keyed on the *layout* of each type
-- argument rather than on the type, and it needs no cap for the reason the cap
-- existed. **The keys a binding can be copied at are finite, whatever the
-- program.** A key is one layout per atom, and a layout is a sequence of at
-- most `flatLimit` slots drawn from seven representations, so there are
-- finitely many: a type whose slots would be more is boxed, and a boxed type's
-- layout is one `ptr` whatever is inside it. The chain that diverged under a
-- type key collapses: `f[a]` calling `f[(a, a)]` at `a = Int` asks for layouts
-- of 1, 2 and 4 `i64` slots, then for `(a, a)` boxed, one `ptr`, and from
-- there for 2 and 4 `ptr` slots and `ptr` again, which is a key it has. A
-- component that takes no slot cannot nest without end either, because a
-- layout is its slots and nothing else: `((), ())` is `unit`, as `()` is. So
-- the worklist below terminates on any program.
--
-- **Every generic body is copied, and no generic body is compiled.** The
-- invariant the backend relies on is that the layout of every type a body
-- holds, passes, stores or calls with is known where the body is compiled.
-- Two pieces of code then agree on a value's layout because each computes it
-- from the same ground type. A body compiled without that knowledge would have
-- to hold its values at some uniform representation, and nothing converts a
-- value between that and the real one when it crosses by any route but a
-- direct call: a field, an array element, a closure's parameters -- and a
-- dictionary's methods are closures compiled at their instance's layouts.
-- Predicting which generic bodies use none of those routes is the trap: every
-- prediction written so far missed one.
--
-- **The copies stay polymorphic.** A copy is *not* the body with a type
-- substituted into it. Substituting one would be a lie: `Data.Vec#push` at
-- layout `ptr` is called with `Vec String` and with `Vec (Option Int)`
-- alike, and there is no type to write that both of those check against. So the
-- copy keeps the original's scheme -- its call sites type-check unchanged, and
-- `Turkey.Coretc` checks it exactly as it checked the original -- and carries
-- the one extra fact it is compiled under: `CBind.layouts`.
--
-- **What a key covers: the atoms.** `CBind.layouts` maps an *atom* to its
-- layout, keyed by `Ty.typeKey`. An atom is a type whose layout the body cannot
-- work out from its parts: an abstracted variable of kind `*`; an application
-- whose head is an abstracted variable, `f a`, whose layout is its payload's
-- when `f` is a newtype; a family application stuck on one, `Item t`, which is
-- `Int` for one `t` of layout `ptr` and `String` for another; and a constant an
-- existential arm opened. A binding's key is the layouts of its atoms, which
-- its call sites compute by substituting their type arguments and reducing:
-- `Item (Array Int)` is `i64`. The set of atoms is closed over calls, so a
-- caller's key covers what it needs to key its callees.
--
-- **Which copy runs is unobservable, and must stay so.** Nothing at run time
-- is type-directed except through a dictionary, and coherence means the same
-- instance is selected whichever copy a call lands in. So this pass and
-- `Turkey.Mono` change speed and never meaning.

import System.Parallel as Parallel
import Data.Set as Set
import Turkey.Core (..)
import Turkey.Ast (Opening(..), Lit(..))
import Turkey.Core (Core(..), CoreKind(..), CAlt(..), CBind(..), CProgram(..),
                    CParam(..), Alt(..), Mapper(..), mapKind, namesOf, openingOf,
                    abstractionBinders, isDictionary, dictClass)
import Turkey.Classes as Classes
import Turkey.Classes (ClassTable(..), ClassInfo(..), MethodInfo(..), Slot(..))
import Turkey.Coretc as Coretc
import Turkey.Decls as Decls
import Turkey.Decls (DeclTable(..), ConInfo(..))
import Turkey.Diag as Diag
import Turkey.Prims as Prims
import Turkey.Source (Span(..))
import Turkey.Ssa as Ssa
import Turkey.Ssa (Layout(..), Rep(..), RepClass(..))
import Turkey.Opt as Opt
import Turkey.Typed as Typed
import Turkey.Types as Ty
import Turkey.Types (Kind(..), VarCell(..), ConCell(..), TVar, TCon, TApp, TFam,
                     TFun, TTuple, TSet, TBottom)

-- The layouts a type can have. Each is one slot, except `unit_`, which has
-- none.
let unit_ = Layout { slots = [] }
let i1 = one(Ssa.untraced(I1))
let i8 = one(Ssa.untraced(I8))
let i32 = one(Ssa.untraced(I32))
let i64 = one(Ssa.untraced(I64))
let f64 = one(Ssa.untraced(F64))
let ptr = one(Ssa.traced(Ptr))
-- A raw machine address: pointer-shaped, and not traced. It is the one layout
-- a traced pointer cannot stand for, which is why it is its own layout rather
-- than folded into `ptr`.
let addr = one(Ssa.untraced(Ptr))

fun one(slot : Rep) -> Layout = Layout { slots = [slot] }

-- How many atoms one binding's key may have. Only polymorphic recursion
-- through a family can grow the set without bound -- `f[t]` calling
-- `f[Item t]` needs `Item (Item t)`, and so on -- and that program is refused
-- here rather than looped on.
let maxAtoms = 64

-- The key an opened constant is recorded under in a layouts map.
fun skolemKey(c : ConCell) -> String = Ty.typeKey(TCon(c))

-- Whether `t` is an atom: a type whose layout is whatever the key says.
fun isAtom(t : Ty.Type) -> Bool = match t {
    TVar(_) -> True
    TCon(c) -> c.uid != 0
    TFam(_, _, _) -> True
    TApp(_, _, _) -> match Ty.spine(t) {
        (TVar(_), _) -> True
        _ -> False
    }
    _ -> False
}

fun isStar(k : Kind) -> Bool = match Ty.kprune(k) {
    KFun(_, _) -> False
    _ -> True
}

-- The most slots a flat value may have. Past it, a value is held as a pointer
-- to an object, as every value of a type that is not flat is.
let flatLimit = 4

-- How a value of a flat type is held: its slots, and which of them hold each
-- field of each constructor.
--
-- A product (a tuple, or a type with one constructor) is its fields' slots in
-- field order, a flat field's own slots spliced in. A sum has a tag slot
-- first, holding the index of the value's constructor among its type's, and
-- then the slots its constructors' fields need, merged by representation: the
-- n-th slot of one representation in one constructor's fields is the n-th slot
-- of that representation in the sum, whatever the constructor. So no slot is
-- traced under one tag and untraced under another, and a slot a constructor
-- does not use holds zero, which for a traced slot is a null the collector
-- skips.
type Flat = Flat {
    slots  : Array Rep,
    -- A sum's constructors, in declaration order; empty for a product.
    names  : Array String,
    -- Per constructor (one, for a product), per field, the slots holding it.
    fields : Array (Array (Array Int)),
}

-- The order a sum's merged slots come in, after its tag.
let slotOrder = [
    Ssa.traced(Ptr), Ssa.untraced(Ptr), Ssa.untraced(I64), Ssa.untraced(F64),
    Ssa.untraced(I32), Ssa.untraced(I8), Ssa.untraced(I1),
]

-- Returns the representation a memory position holds a value of this layout
-- at: a field, an array element, a cell, a global. A layout of one slot is
-- held as that slot, and one of none as `unit`. A layout of several slots is
-- held as a traced pointer to an object of those slots, built when the value
-- is stored. This is a function of the layout alone, so a position's writer
-- and its reader agree on it whichever copy of a body each is in.
fun storedRep(l : Layout) -> Rep = match len(l.slots) {
    0 -> Ssa.untraced(Unit)
    1 -> l.slots[0]
    _ -> Ssa.traced(Ptr)
}

-- The layout a value of `ty` is held at, or `None` if that is not known.
--
-- `layouts` is the binding's `layouts`, with the constants of any existential
-- arm around the question added. An atom not in it has no layout, and this
-- says so.
--
-- Partial on purpose, and the backend treats `None` as a compiler bug. There is
-- no uniform representation to fall back on: a guess would be a value that one
-- side holds boxed and the other reads raw.
fun layoutOf(decls : DeclTable, ty : Ty.Type,
             layouts : Map String Layout) -> Option Layout =
    if !unfolds(decls, ty) { unfold(decls, ty, layouts, lookup) }
    else { unfolded(fun(u) = unfold(decls, ty, layouts, u)) }

-- Returns where the fields of a value of `ty` are among its slots, if the type
-- is a tuple or declared type held flat at these layouts, and `None` if it is
-- not or its layout is not known. The slots are `layoutOf`'s.
fun flatOf(decls : DeclTable, ty : Ty.Type,
           layouts : Map String Layout) -> Option Flat =
    unfolded(fun(u) = flatIn(decls, ty, layouts, u))

-- Returns whether finding the layout of `ty` unfolds a declaration: whether
-- `ty` is a tuple, or a newtype or a possibly flat type applied. The layout of
-- any other type is a lookup, cheaper than remembering it.
fun unfolds(decls : DeclTable, ty : Ty.Type) -> Bool = match Ty.prune(ty) {
    TTuple(_) -> True
    TCon(c) -> unfoldsName(decls, c.name)
    TApp(fn, _, _) -> match headOf(fn) {
        TCon(c) -> unfoldsName(decls, c.name)
        _ -> False
    }
    _ -> False
}

-- The head of an application's spine, found without building the spine.
fun headOf(ty : Ty.Type) -> Ty.Type = match Ty.prune(ty) {
    TApp(fn, _, _) -> headOf(fn)
    other -> other
}

fun unfoldsName(decls : DeclTable, name : String) -> Bool =
    Set.contains(Decls.newtypes(decls), name) || Option.isSome(Decls.flatDecl(decls, name))

-- `f` of a quick unfolding, or of a careful one if the quick one gave up.
--
-- The quick one does not name the types it unfolds, which costs a string per
-- type: a type is on a cycle only if its unfolding never ends, so one that ends
-- within `quickDepth` is on none. Past it, the unfolding is redone keeping the
-- names, which finds any cycle.
fun unfolded(f : fun(Unfolding) -> a) -> a {
    let quick = Unfolding { keys = None, depth = 0, cut = noCut, deep = False }
    let found = f(quick)
    if !quick.deep { return found }
    f(Unfolding { keys = Some([]), depth = 0, cut = noCut, deep = False })
}

-- The types being unfolded, outermost first, and the depth of the outermost
-- one a type inside it was found to mention again.
--
-- A declaration that mentions itself is never flat (`Decls.flatCandidates`),
-- but a type can still reach itself through its arguments: with
-- `type B = B(A)` and `type A = A(Option B)`, both newtypes, unfolding
-- `Option B` asks for `B`, which is `Option B` again. Every type on such a cycle
-- is held boxed. That is a property of the type and not of where the question
-- started, so every frame from the revisited one inward answers boxed, however
-- the cycle was entered.
--
-- `keys` is `None` for the quick unfolding, which only counts its depth and
-- gives up past `quickDepth`, setting `deep`.
type Unfolding = Unfolding {
    keys     : Option (Vec String),
    var depth : Int,
    var cut  : Int,
    var deep : Bool,
}

-- No depth is this deep: the cut when no cycle is open.
let noCut = 1000000000

-- What `unfold` is given for a type that does not unfold (`unfolds`): it is
-- never entered, so never changed, and every thread can share it.
let lookup = Unfolding { keys = None, depth = 0, cut = noCut, deep = False }

-- Deeper than the nesting of newtypes and flat types in any type a program
-- writes.
let quickDepth = 32

-- Enters `t`, returning its depth, or -1 if it is already being unfolded or
-- the quick unfolding has given up.
fun enter(u : Unfolding, t : Ty.Type) -> Int = match u.keys {
    None -> {
        if u.depth >= quickDepth {
            u.deep = True
            return -1
        }
        u.depth = u.depth + 1
        u.depth - 1
    }
    Some(keys) -> {
        let key = Ty.typeKey(t)
        for var i = 0; i < len(keys); i = i + 1 {
            if keys[i] == key {
                if i < u.cut { u.cut = i }
                return -1
            }
        }
        Vec.push(keys, key)
        len(keys) - 1
    }
}

-- Leaves the type entered at `depth`, returning whether it is on a cycle.
fun leave(u : Unfolding, depth : Int) -> Bool = match u.keys {
    None -> {
        u.depth = depth
        False
    }
    Some(keys) -> {
        discard(Vec.pop(keys))
        let cyclic = u.cut <= depth
        if u.cut >= depth { u.cut = noCut }
        cyclic
    }
}

fun unfold(decls : DeclTable, ty : Ty.Type, layouts : Map String Layout,
           u : Unfolding) -> Option Layout {
    if u.deep { return Some(ptr) }
    let t = Ty.prune(ty)
    match t {
        TBottom -> return Some(unit_)
        _ -> {}
    }
    if isAtom(t) { return Map.get(layouts, Ty.typeKey(t)) }
    match t {
        TFun(_, _) -> Some(ptr)
        TTuple(elems) -> {
            let found = Vec.new(len(elems))
            for x in elems {
                let l = unfold(decls, x, layouts, u)?
                Vec.push(found, l.slots)
            }
            Some(Layout { slots = productSlots(Vec.toArray(found)) })
        }
        TCon(c) -> named(decls, t, c.name, [], layouts, u)
        TApp(_, _, _) -> {
            let (h, args) = Ty.spine(t)
            match h {
                TCon(c) -> named(decls, t, c.name, args, layouts, u)
                _ -> Some(ptr)
            }
        }
        -- A `TSet` is the one that can arrive: a numeric literal whose type was
        -- still a *decision*. Defaulting settles it at generalization and the
        -- type table's own check is that it did, so one here is a hole in that
        -- rather than a type wanting a representation.
        _ -> oops("no layout for the type '" + Ty.show(t) + "'")
    }
}

-- The layout of `t`, a declared type applied to `args`: a primitive's, an
-- enumeration's index at the narrowest width that holds its largest
-- (`Decls.enumSize`), a newtype's payload's, the slots of a flat type, and
-- anything else a pointer to its object. One constructor has nothing to hold.
fun named(decls : DeclTable, t : Ty.Type, name : String, args : Array Ty.Type,
          layouts : Map String Layout, u : Unfolding) -> Option Layout {
    if len(args) == 0 {
        match name {
            "Int" -> return Some(i64)
            "Byte" -> return Some(i8)
            "Char" -> return Some(i32)
            "Float" -> return Some(f64)
            "Unit" -> return Some(unit_)
            "Prim.Ptr" -> return Some(addr)
            _ -> {}
        }
    }
    -- A newtype is its payload, so its representation is its payload's. See
    -- `Decls.newtypes`, which is also where the recursion that would make this
    -- loop is excluded.
    if Set.contains(Decls.newtypes(decls), name) {
        match Decls.payloadType(decls, t, 0) {
            Some(payload) -> {
                let depth = enter(u, t)
                if depth < 0 { return Some(ptr) }
                let found = unfold(decls, payload, layouts, u)
                discard(leave(u, depth))
                return found
            }
            None -> {}
        }
    }
    match Decls.enumSize(decls, name) {
        Some(n) -> return Some(indexLayout(n))
        None -> {}
    }
    let fd = match Decls.flatDecl(decls, name) {
        Some(found) -> found
        None -> return Some(ptr)
    }
    if len(fd.params) == 0 {
        match Map.get(decls.groundLayouts, name) {
            Some(found) -> return Some(found)
            None -> {}
        }
    }
    match fieldsOf(decls, t, fd, args, layouts, u)? {
        Some(fields) -> Some(Layout { slots = declaredSlots(fd, fields) })
        None -> Some(ptr)
    }
}

-- The slots of each field of each constructor of `t`, an application of the
-- candidate `fd` to `args`: `None` if one is not known, and `Some(None)` if
-- `t` is on a cycle, and so boxed.
fun fieldsOf(decls : DeclTable, t : Ty.Type, fd : Decls.FlatDecl,
             args : Array Ty.Type, layouts : Map String Layout,
             u : Unfolding) -> Option (Option (Array (Array (Array Rep)))) {
    let depth = enter(u, t)
    if depth < 0 { return Some(None) }
    let mapping = Map.new()
    for var i = 0; i < len(fd.params) && i < len(args); i = i + 1 {
        if fd.params[i] >= 0 { Map.put(mapping, fd.params[i], args[i]) }
    }
    var known = True
    let found = Array.map(fd.fields, fun(types) = Array.map(types, fun(x) =
        match unfold(decls, Decls.substitute(x, mapping), layouts, u) {
            Some(l) -> l.slots
            None -> {
                known = False
                []
            }
        }))
    let cyclic = leave(u, depth)
    if !known { return None }
    if cyclic { return Some(None) }
    Some(Some(found))
}

-- The slots of a value of the candidate `fd` whose fields have these slots, or
-- one pointer if it is held boxed.
fun declaredSlots(fd : Decls.FlatDecl, fields : Array (Array (Array Rep))) -> Array Rep {
    if len(fields) == 1 { return productSlots(fields[0]) }
    if boxedCompact(fd, fields) { return ptr.slots }
    sumSlots(fields)
}

-- Whether a sum of nullaries and one constructor with one field is one word
-- (`Turkey.SsaLower`'s compact sums): when memory holds that field at a
-- pointer. A payload of several slots is such a field, held in memory as a
-- pointer to its slots, so `Some(x)` of an `x` read from memory is that
-- pointer, where a flat sum would take `x` apart and box it again to return
-- it.
fun boxedCompact(fd : Decls.FlatDecl, fields : Array (Array (Array Rep))) -> Bool =
    match fd.compact {
        Some(k) -> len(fields[k]) == 1
                   && storedRep(Layout { slots = fields[k][0] }) == Ssa.traced(Ptr)
        None -> False
    }

-- The slots of a product of fields of these slots, or one pointer if there are
-- more than `flatLimit`.
fun productSlots(fields : Array (Array Rep)) -> Array Rep {
    let slots = []
    for f in fields { for r in f { Vec.push(slots, r) } }
    if len(slots) > flatLimit { ptr.slots } else { Vec.toArray(slots) }
}

-- The slots of a sum whose constructors have fields of these slots, or one
-- pointer if there are more than `flatLimit`.
fun sumSlots(fields : Array (Array (Array Rep))) -> Array Rep =
    Option.unwrapOr(sumFits(fields), ptr.slots)

-- The slots of a sum whose constructors have fields of these slots, if there
-- are at most `flatLimit`: the tag, then for each representation in
-- `slotOrder`, as many slots as any one constructor needs.
fun sumFits(fields : Array (Array (Array Rep))) -> Option (Array Rep) {
    let most = Array.filled(len(slotOrder), 0)
    let count = Array.filled(len(slotOrder), 0)
    for con in fields {
        for var k = 0; k < len(count); k = k + 1 { count[k] = 0 }
        for f in con {
            for r in f {
                let k = orderOf(r)
                count[k] = count[k] + 1
            }
        }
        for var k = 0; k < len(most); k = k + 1 {
            if count[k] > most[k] { most[k] = count[k] }
        }
    }
    var total = len(indexLayout(len(fields)).slots)
    for m in most { total = total + m }
    if total > flatLimit { return None }
    let slots = []
    for r in indexLayout(len(fields)).slots { Vec.push(slots, r) }
    for var k = 0; k < len(slotOrder); k = k + 1 {
        for var n = 0; n < most[k]; n = n + 1 { Vec.push(slots, slotOrder[k]) }
    }
    Some(Vec.toArray(slots))
}

fun flatIn(decls : DeclTable, ty : Ty.Type, layouts : Map String Layout,
           u : Unfolding) -> Option Flat {
    let t = Ty.prune(ty)
    if isAtom(t) { return None }
    match t {
        TTuple(elems) -> {
            let found = Vec.new(len(elems))
            for x in elems {
                let l = unfold(decls, x, layouts, u)?
                Vec.push(found, l.slots)
            }
            let fields = Vec.toArray(found)
            if totalSlots(fields) > flatLimit { None } else { Some(productFlat(fields)) }
        }
        TCon(_) -> declaredFlat(decls, t, [], layouts, u)
        TApp(_, _, _) -> {
            let (h, args) = Ty.spine(t)
            match h {
                TCon(_) -> declaredFlat(decls, t, args, layouts, u)
                _ -> None
            }
        }
        _ -> None
    }
}

fun declaredFlat(decls : DeclTable, t : Ty.Type, args : Array Ty.Type,
                 layouts : Map String Layout, u : Unfolding) -> Option Flat {
    let name = match Ty.spine(t) {
        (TCon(c), _) -> c.name
        _ -> return None
    }
    let fd = Decls.flatDecl(decls, name)?
    let fields = match fieldsOf(decls, t, fd, args, layouts, u)? {
        Some(found) -> found
        None -> return None
    }
    if len(fields) == 1 {
        if totalSlots(fields[0]) > flatLimit { return None }
        return Some(productFlat(fields[0]))
    }
    if boxedCompact(fd, fields) { return None }
    let slots = sumFits(fields)?
    Some(sumFlat(fd.names, slots, fields))
}

fun totalSlots(fields : Array (Array Rep)) -> Int {
    var n = 0
    for f in fields { n = n + len(f) }
    n
}

-- The `Flat` of a product of fields of these slots.
fun productFlat(fields : Array (Array Rep)) -> Flat {
    let slots = []
    let where_ = Array.map(fields, fun(f) = Array.map(f, fun(r) {
        Vec.push(slots, r)
        len(slots) - 1
    }))
    Flat { slots = Vec.toArray(slots), names = [], fields = [where_] }
}

-- The `Flat` of a sum of constructors `names` with fields of these slots, its
-- slots being `slots`, as `sumSlots` lays them out.
fun sumFlat(names : Array String, slots : Array Rep,
            fields : Array (Array (Array Rep))) -> Flat {
    let tag = len(indexLayout(len(names)).slots)
    -- The first of `slots` of each representation in `slotOrder`.
    let first = Array.filled(len(slotOrder), len(slots))
    for var i = len(slots) - 1; i >= tag; i = i - 1 { first[orderOf(slots[i])] = i }
    let where_ = Array.map(fields, fun(con) {
        let used = Array.filled(len(slotOrder), 0)
        Array.map(con, fun(f) = Array.map(f, fun(r) {
            let k = orderOf(r)
            let at = first[k] + used[k]
            used[k] = used[k] + 1
            at
        }))
    })
    Flat { slots = slots, names = names, fields = where_ }
}

fun orderOf(r : Rep) -> Int = match Array.indexOf(slotOrder, r) {
    Some(k) -> k
    None -> oops("a slot held at " + show(r))
}

-- The layout of an index below `n`: none for one value, a bit for two, and
-- otherwise the narrowest width that holds the largest.
fun indexLayout(n : Int) -> Layout =
    if n == 1 { unit_ } else if n == 2 { i1 } else if n <= 256 { i8 } else { i32 }

-- -- atoms --------------------------------------------------------------------------

-- Every type a term mentions: each node's own, a parameter's, a `let`'s, a type
-- application's arguments, and a local binding's.
fun eachType(e : Core, visit : fun(Ty.Type) -> Unit) -> Unit {
    visit(e.ty)
    discard(mapKind(e.kind, Mapper {
        expr = fun(x) = {
            eachType(x, visit)
            x
        },
        type_ = fun(t) = {
            visit(t)
            t
        },
        bind = fun(b) = {
            visit(b.ty)
            eachType(b.value, visit)
            b
        },
    }))
}

-- The atoms inside `ty` that belong to a scope binding `owned`.
--
-- A variable atom belongs to the scope that binds it. An application atom
-- belongs to a scope when it mentions one of that scope's variables and every
-- variable it mentions is in `visible`: the scope's own and those of the scopes
-- around it. One mentioning a variable bound further in is that inner scope's,
-- and one mentioning an opened constant is the arm's.
--
-- The walk does not look inside an atom: `Item (Pair a)` needs its own layout,
-- and nothing about `Pair a`'s.
fun atomsInto(ty : Ty.Type, owned : Set.Set Int, visible : Set.Set Int,
              out : Vec Ty.Type, seen : Set.Set String) -> Unit {
    let t = Ty.prune(ty)
    if isAtom(t) {
        let take = match t {
            TVar(cell) -> Set.contains(owned, cell.id) && isStar(cell.kind)
            TCon(_) -> False
            _ -> {
                var mine = False
                var inside = len(Ty.skolemsOf([t])) == 0
                for v in Ty.varsOf([t]) {
                    if Set.contains(owned, v.id) { mine = True }
                    if !Set.contains(visible, v.id) { inside = False }
                }
                mine && inside
            }
        }
        let k = Ty.typeKey(t)
        if take && !Set.contains(seen, k) {
            Set.add(seen, k)
            Vec.push(out, t)
        }
        return {}
    }
    match t {
        TApp(fn, arg, _) -> {
            atomsInto(fn, owned, visible, out, seen)
            atomsInto(arg, owned, visible, out, seen)
        }
        TFun(params, ret) -> {
            for p in params { atomsInto(p, owned, visible, out, seen) }
            atomsInto(ret, owned, visible, out, seen)
        }
        TTuple(elems) -> for x in elems { atomsInto(x, owned, visible, out, seen) }
        _ -> {}
    }
}

-- The atoms of a generic binding, in key order: its variables of kind `*` as it
-- binds them, then its application atoms in `typeKey` order.
--
-- `extra` are application atoms its callees need, from `closeAtoms`.
fun atomsOf(ty : Ty.Type, value : Core, binders : Vec VarCell,
            visible : Set.Set Int, extra : Vec Ty.Type) -> Vec Ty.Type {
    let owned = Set.new()
    for v in binders { Set.add(owned, v.id) }
    let all = Set.new()
    for v in Set.elements(visible) { Set.add(all, v) }
    for v in binders { Set.add(all, v.id) }
    let found = Vec.new(4)
    let seen = Set.new()
    atomsInto(ty, owned, all, found, seen)
    eachType(value, \atomsInto(_, owned, all, found, seen))
    for t in extra { atomsInto(t, owned, all, found, seen) }
    let out = Vec.new(len(found))
    for v in binders {
        if isStar(v.kind) { Vec.push(out, TVar(v)) }
    }
    let apps = Vec.new(len(found))
    for t in found {
        match t {
            TVar(_) -> {}
            _ -> Vec.push(apps, (Ty.typeKey(t), t))
        }
    }
    for (_, t) in Vec.sortBy(apps, fun(x, y) = Array.threeWay(x.0, y.0)) {
        Vec.push(out, t)
    }
    out
}

-- Every `CTyApp` of a top-level name anywhere inside a term.
fun applications(e : Core, out : Vec (String, Array Ty.Type)) -> Unit {
    match e.kind {
        CTyApp(fn, args) -> match fn.kind {
            CVar(n) -> Vec.push(out, (n, args))
            _ -> {}
        }
        _ -> {}
    }
    discard(mapKind(e.kind, Mapper {
        expr = fun(x) = {
            applications(x, out)
            x
        },
        type_ = fun(t) = t,
        bind = fun(b) = {
            applications(b.value, out)
            b
        },
    }))
}

-- The atoms of every generic top-level binding, closed over calls.
--
-- A callee's application atom, at the caller's type arguments and reduced, is
-- a type the caller has to know the layout of to key the call: `firstOr`'s
-- `Item t` at `t = Array a` is `a`, which the caller has anyway, but at
-- `t = Wrap a` it may be `Elem a`, which the caller mentions nowhere. So each
-- one is added to the caller's atoms, until nothing changes.
fun closeAtoms(binds : Map String CBind, generic : Set.Set String,
               fams : Map String (Option Ty.Families)) -> Map String (Vec Ty.Type) {
    let extra = Map.new()
    let atoms = Map.new()
    for name in Set.elements(generic) {
        Map.put(extra, name, [])
    }
    var grew = True
    while grew {
        grew = False
        for name in Array.sort(Set.elements(generic)) {
            let b = binds[name]
            Map.put(atoms, name, atomsOf(b.ty, b.value, abstractionBinders(b),
                                         Set.new(), extra[name]))
        }
        for name in Array.sort(Set.elements(generic)) {
            let b = binds[name]
            let owned = Set.new()
            for v in abstractionBinders(b) { Set.add(owned, v.id) }
            let have = Set.new()
            for t in atoms[name] { Set.add(have, Ty.typeKey(t)) }
            let uses = Vec.new(4)
            applications(b.value, uses)
            for (callee, args) in uses {
                if !Set.contains(generic, callee) { continue }
                let binders = abstractionBinders(binds[callee])
                if len(binders) != len(args) { continue }
                let mapping = Map.new()
                for var i = 0; i < len(binders); i = i + 1 {
                    Map.put(mapping, binders[i].id, args[i])
                }
                for atom in atoms[callee] {
                    match atom {
                        TVar(_) -> continue
                        _ -> {}
                    }
                    let t = Typed.reduceDeep(Decls.substitute(atom, mapping),
                                             fams[name])
                    let found = Vec.new(2)
                    atomsInto(t, owned, owned, found, Set.new())
                    for a in found {
                        let k = Ty.typeKey(a)
                        if !Set.contains(have, k) {
                            Set.add(have, k)
                            Vec.push(extra[name], a)
                            grew = True
                        }
                    }
                }
            }
            if len(extra[name]) > maxAtoms {
                oops("the layouts '" + name + "' needs to know do not stop "
                     + "growing: it recurses through a type family at an ever "
                     + "larger type, as '" + Ty.show(extra[name][0]) + "' shows")
            }
        }
    }
    atoms
}

-- The layouts of `atoms` at one call, under the caller's `layouts`; or the
-- first atom whose layout the caller cannot know.
fun keyAt(s : Sharer, atoms : Vec Ty.Type, binders : Vec VarCell,
          args : Array Ty.Type, fams : Option Ty.Families,
          layouts : Map String Layout) -> Either Ty.Type (Vec Layout) {
    let mapping = Map.new()
    for var i = 0; i < len(binders) && i < len(args); i = i + 1 {
        Map.put(mapping, binders[i].id, args[i])
    }
    let out = Vec.new(len(atoms))
    for atom in atoms {
        let t = Typed.reduceDeep(Decls.substitute(atom, mapping), fams)
        match layoutOf(s.decls, t, layouts) {
            Some(l) -> Vec.push(out, l)
            None -> return Left(t)
        }
    }
    Right(out)
}

-- The layout of every type in a binding that nothing binds.
--
-- Inference leaves a variable free when nothing constrains it: `bounds` calls
-- `outOfBounds`, which returns any type, in a branch whose value is discarded,
-- and that type is decided by nothing. No value of such a type can be observed
-- -- it comes only from something that diverges or from an empty array -- so
-- any fixed layout is correct as long as it is the same everywhere, and `unit`
-- is the one that neither reads nor traces a word. `own` says whether the
-- binding's own variables are keyed, as a copy's are, or free, as `main`'s are.
fun defaultsInto(b : CBind, layouts : Map String Layout,
                 own : Bool) -> Unit {
    let bound = Set.new()
    if own { for v in abstractionBinders(b) { Set.add(bound, v.id) } }
    bindersInto(b.value, bound)
    let visit = fun(t : Ty.Type) = freeAtomsInto(t, bound, layouts)
    visit(b.ty)
    eachType(b.value, visit)
}

-- Every variable a term binds: a generalized local's, and a type abstraction's.
fun bindersInto(e : Core, out : Set.Set Int) -> Unit {
    match e.kind {
        CTyLam(vs, _) -> for v in vs { Set.add(out, v.id) }
        CLet(_, _, _, _, vs) -> for v in vs { Set.add(out, v.id) }
        _ -> {}
    }
    discard(mapKind(e.kind, Mapper {
        expr = fun(x) = {
            bindersInto(x, out)
            x
        },
        type_ = fun(t) = t,
        bind = fun(b) = {
            for v in b.binders { Set.add(out, v.id) }
            bindersInto(b.value, out)
            b
        },
    }))
}

fun freeAtomsInto(ty : Ty.Type, bound : Set.Set Int,
                  layouts : Map String Layout) -> Unit {
    let t = Ty.prune(ty)
    if isAtom(t) {
        match t {
            TCon(_) -> return {}
            _ -> {}
        }
        if len(Ty.skolemsOf([t])) > 0 { return {} }
        for v in Ty.varsOf([t]) {
            if Set.contains(bound, v.id) { return {} }
        }
        let k = Ty.typeKey(t)
        if !Map.contains(layouts, k) { Map.put(layouts, k, unit_) }
        return {}
    }
    match t {
        TApp(fn, arg, _) -> {
            freeAtomsInto(fn, bound, layouts)
            freeAtomsInto(arg, bound, layouts)
        }
        TFun(params, ret) -> {
            for p in params { freeAtomsInto(p, bound, layouts) }
            freeAtomsInto(ret, bound, layouts)
        }
        TTuple(elems) -> for x in elems { freeAtomsInto(x, bound, layouts) }
        _ -> {}
    }
}

-- -- the pass -----------------------------------------------------------------------

type Sharer = Sharer {
    decls   : DeclTable,
    classes : ClassTable,
    binds   : Map String CBind,
    -- Every top-level binding that abstracts a type: all of them are copied.
    generic : Set.Set String,
    atoms   : Map String (Vec Ty.Type),
    -- Each binding's families, with the equations it was checked under.
    fams    : Map String (Option Ty.Families),
    -- Which keys each existential constructor is packed at, as far as the
    -- runs before this one found; an opened arm is copied for those alone.
    packed  : Packed,
    -- "original|key" -> the name built for it.
    done    : Map String String,
    -- original -> the copies, in request order.
    made    : Map String (Vec CBind),
    queue   : Vec (String, String, Vec Layout),
    used    : Set.Set String,
    -- The keys of a method's own variables that some call through an unknown
    -- dictionary uses: `keys` as this run was started with, so every dictionary
    -- gets a slot for each; `asked` as this run's calls found them. See
    -- `Classes.KeyedSlot`.
    keys    : Keys,
    asked   : Keys,
}

-- Class -> method -> layout key -> the key's layouts, one per atom of the
-- method's own variables.
type Keys = Map String (Map String (Map String (Vec Layout)))

-- Where a term is being rewritten.
--
-- `chain` is the binding's layouts, then one map per existential arm around the
-- term, each the one before plus the constants that arm opened. The first is
-- what becomes the binding's `layouts`, and the backend rebuilds the others from
-- the arms' patterns. A local copy's atoms go into every map on the chain: into
-- the first so the backend sees them, and into the rest so the rewrite does.
--
-- `locals` are the generalized bindings in scope, innermost last.
type Scope = Scope {
    owner  : String,
    chain  : Array (Map String Layout),
    locals : Vec (Map String Local),
}

-- A generalized binding inside a body, and its copies.
type Local = Local {
    name      : String,
    ty        : Ty.Type,
    value     : Core,
    binders   : Vec VarCell,
    atoms     : Vec Ty.Type,
    -- A copy's original, for the fields `CLetRec` keeps on a binding.
    bind      : Option CBind,
    -- key -> the copy's name.
    done      : Map String String,
    -- The copies requested and not yet built: name, renaming, fresh binders.
    var queue : Vec (String, Map Int Ty.Type, Vec VarCell),
    built     : Vec (String, Ty.Type, Core, Vec VarCell, Map Int Ty.Type),
}

fun current(sc : Scope) -> Map String Layout = sc.chain[len(sc.chain) - 1]

fun famsFor(s : Sharer, sc : Scope) -> Option Ty.Families =
    Map.getOr(s.fams, sc.owner, None)

-- The program with every generic binding replaced by one copy per layout its
-- callers need.
--
-- Repeated while a constructor that some arm opens is found packed at a key
-- its arms were not copied for. An opened arm is copied for the keys in its
-- constructor's table and no others (`openingKeys`), and every table starts
-- empty, so the first run copies no opened arm. Each later run copies the arms
-- for what the runs before it found packed, and an arm copied for a new key can
-- pack a key of its own: an arm that opens `C(x)` and packs `C((x, x))` packs
-- `C` at twice the slots it opened it at. The tables only grow, and they
-- are finite: a key is one layout per hidden variable, and a layout is at most
-- `flatLimit` slots, since a type with more is boxed and held at one `ptr`.
--
-- And again while calls through unknown dictionaries ask for method keys the
-- dictionaries were not built with: a dictionary's fields are decided before
-- the calls that read them are found, and a keyed field's body can make calls
-- of its own. The keys only grow, and there are finitely many.
fun share(program : CProgram, decls : DeclTable, classes : ClassTable,
          main : String) -> CProgram {
    -- Computed here, before `unknownLayouts` and the backend ask for layouts in
    -- parallel, since these are cached in `decls`.
    for (name, fd) in Map.entries(Decls.flatCandidates(decls)) {
        if len(fd.params) == 0 {
            match layoutOf(decls, Decls.head(decls, name), Map.new()) {
                Some(found) -> Map.put(decls.groundLayouts, name, found)
                None -> {}
            }
        }
    }
    let opened = openedConstructors(program)
    let packed = Map.new()
    for con in Set.elements(opened) { Map.put(packed, con, Map.new()) }
    let keys = Map.new()
    loop {
        publish(classes, keys)
        loop {
            let (out, asked) = shareOnce(program, decls, classes, main, packed, keys)
            -- A program that opens nothing has no table to fill: skip the walk.
            if len(Map.keys(packed)) > 0 && mergePacked(packed, packedLayouts(out, decls, packed)) {
                continue
            }
            if mergeKeys(keys, asked) { break }
            numberPackings(decls, packed)
            return out
        }
    }
}

-- Constructor -> key name -> the key's layouts, in the order they were found.
-- One entry for each constructor some arm opens, and none for any other: a
-- value of a constructor nothing opens is never asked which key it was packed
-- at, so it has no table.
type Packed = Map String (Map String (Vec Layout))

-- Add `more` to `into`, answering whether anything was new.
fun mergePacked(into : Packed, more : Packed) -> Bool {
    var grew = False
    for (con, found) in Map.entries(more) {
        let have = into[con]
        for (k, parts) in Map.entries(found) {
            if !Map.contains(have, k) {
                Map.put(have, k, parts)
                grew = True
            }
        }
    }
    grew
}

-- Record each constructor's table in `decls.packings`, numbering its keys in
-- the order they were found.
--
-- **The tables are whole-program: every key an opened constructor is packed at
-- anywhere is in its table.** `share` numbers them after its last run, whose
-- packings were all merged in, and that run's program is the one the backend
-- lowers. Every arm in it was copied for a key some run found packed. So a
-- pack site and an opener look a key up in the same table: the index a packed
-- value stores is the index the opened arm's copy compares it against.
fun numberPackings(decls : DeclTable, packed : Packed) -> Unit {
    for (con, found) in Map.entries(packed) {
        let numbered = Map.new()
        var i = 0
        for k in Map.keys(found) {
            Map.put(numbered, k, i)
            i = i + 1
        }
        Map.put(decls.packings, con, numbered)
    }
}

-- The index of `parts` in the table of keys `name` is packed at: what a packed
-- value stores for its hidden variables. `None` if nothing packs `name` there.
fun packingIndex(decls : DeclTable, name : String, parts : Vec Layout) -> Option Int =
    match Map.get(decls.packings, name) {
        Some(numbered) -> Map.get(numbered, Ssa.keyName(parts))
        None -> None
    }

-- Whether some arm opens `name`. A value of a constructor nothing opens is
-- never asked which key it was packed at, and has no table.
fun isOpened(decls : DeclTable, name : String) -> Bool = Map.contains(decls.packings, name)

-- How many keys `name` is packed at in the whole program.
fun packingCount(decls : DeclTable, name : String) -> Int =
    match Map.get(decls.packings, name) {
        Some(numbered) -> len(Map.keys(numbered))
        None -> 0
    }

-- Add `more` to `into`, answering whether anything was new.
fun mergeKeys(into : Keys, more : Keys) -> Bool {
    var grew = False
    for (cls, methods) in Map.entries(more) {
        let ofClass = Map.getOr(into, cls, Map.new())
        Map.put(into, cls, ofClass)
        for (method, found) in Map.entries(methods) {
            let have = Map.getOr(ofClass, method, Map.new())
            Map.put(ofClass, method, have)
            for (k, parts) in Map.entries(found) {
                if !Map.contains(have, k) {
                    Map.put(have, k, parts)
                    grew = True
                }
            }
        }
    }
    grew
}

-- Make `keys` the keyed slots of every class's dictionaries: for each method
-- in slot order, its keys in sorted order. Before each run, so that the run
-- builds dictionaries with, and reads them through, the slots it was started
-- with. The last run's are the ones that stay.
fun publish(classes : ClassTable, keys : Keys) -> Unit {
    for (cls, methods) in Map.entries(keys) {
        Map.put(classes.keyed, cls, [])
        let order = Vec.new(4)
        for slot in Classes.dictSlots(classes, cls) {
            match slot {
                MethodSlot(m) -> match Map.get(methods, m) {
                    Some(found) -> for k in Array.sort(Map.keys(found)) {
                        Vec.push(order, (m, k))
                    }
                    None -> {}
                }
                _ -> {}
            }
        }
        Map.put(classes.keyed, cls, order)
    }
}

-- Every constructor some arm in `program` opens.
fun openedConstructors(program : CProgram) -> Set.Set String {
    let found = Set.new()
    for b in Vec.append(program.dicts, program.binds) {
        opensInto(b.value, found)
    }
    found
}

fun opensInto(e : Core, found : Set.Set String) -> Unit {
    match e.kind {
        CMatch(_, alts) -> for alt in alts {
            match alt.alt {
                ACon(name, _, Some(_)) -> Set.add(found, name)
                _ -> {}
            }
        }
        _ -> {}
    }
    discard(mapKind(e.kind, Mapper {
        expr = fun(x) = {
            opensInto(x, found)
            x
        },
        type_ = fun(t) = t,
        bind = fun(b) = {
            opensInto(b.value, found)
            b
        },
    }))
}

fun shareOnce(program : CProgram, decls : DeclTable, classes : ClassTable,
              main : String, packed : Packed,
              keys : Keys) -> (CProgram, Keys) {
    let binds = Map.new()
    let generic = Set.new()
    let fams = Map.new()
    for b in Vec.append(program.dicts, program.binds) {
        Map.put(binds, b.name, b)
        -- `main` is called by the entry, at no types, and never by the
        -- program: a `main` that generalized -- one ending in `exit`, whose
        -- result is any type -- is a root with its variables as free as any.
        if len(abstractionBinders(b)) > 0 && b.name != main {
            Set.add(generic, b.name)
        }
        Map.put(fams, b.name, Some(Coretc.famsOf(classes, b.equations)))
    }
    let used = Set.new()
    for (name, _) in Map.entries(binds) { Set.add(used, name) }
    let s = Sharer {
        decls = decls, classes = classes, binds = binds, generic = generic,
        atoms = closeAtoms(binds, generic, fams), fams = fams, packed = packed,
        done = Map.new(), made = Map.new(), queue = Vec.new(8), used = used,
        keys = keys, asked = Map.new(),
    }

    let rewritten = Map.new()
    for (name, b) in Map.entries(binds) {
        if !Set.contains(generic, name) {
            let layouts = Map.new()
            for (k, l) in Map.entries(b.layouts) { Map.put(layouts, k, l) }
            defaultsInto(b, layouts, False)
            let value = rewrite(s, b.value, Scope {
                owner = name, chain = [layouts], locals = Vec.new(2),
            })
            let out = withValue(b, value)
            out.layouts = layouts
            Map.put(rewritten, name, out)
        }
    }
    -- A cursor rather than a removal, because the queue is first-in-first-out
    -- and grows while it is drained: building a copy requests the copies that
    -- copy calls for.
    var at = 0
    while at < len(s.queue) {
        let (name, original, parts) = s.queue[at]
        at = at + 1
        let copy = build(s, name, original, parts)
        match Map.get(s.made, original) {
            Some(found) -> Vec.push(found, copy)
            None -> Map.put(s.made, original, [copy])
        }
    }

    let kept = reachable(s, rewritten)
    let dicts = Vec.new(len(program.dicts))
    let rest = Vec.new(len(program.binds))
    for b in program.dicts { emit(s, kept, rewritten, b, dicts) }
    for b in program.binds { emit(s, kept, rewritten, b, rest) }
    (CProgram { dicts = dicts, binds = rest }, s.asked)
}

fun emit(s : Sharer, kept : Set.Set String, rewritten : Map String CBind,
         b : CBind, out : Vec CBind) -> Unit {
    -- Beside the original and ahead of it, as `Turkey.Mono` places its
    -- specializations, and for the same reason: a copy depends on no more than
    -- the original does, and top-level bindings are evaluated in this order.
    for copy in Map.getOr(s.made, b.name, []) { Vec.push(out, copy) }
    if Set.contains(kept, b.name) {
        Vec.push(out, Map.getOr(rewritten, b.name, b))
    }
}

-- The names still worth emitting: every ground binding, every copy, and what
-- they name.
--
-- A generic original is emitted only if something names it without a type
-- application, which nothing should; `unknownLayouts` then refuses it. Once
-- every call has gone to a copy it is dead, and leaving it is not harmless: it
-- names the other originals, so one that survives keeps the rest alive.
--
-- A fixed point rather than one pass, since dropping one can orphan the next.
fun reachable(s : Sharer, rewritten : Map String CBind) -> Set.Set String {
    let made = Map.new()
    for (_, copies) in Map.entries(s.made) {
        for c in copies { Map.put(made, c.name, c) }
    }
    let live = Set.new()
    for (name, _) in Map.entries(s.binds) {
        if !Set.contains(s.generic, name) { Set.add(live, name) }
    }
    for (name, _) in Map.entries(made) { Set.add(live, name) }
    var grew = True
    while grew {
        grew = False
        for name in Array.sort(Set.elements(live)) {
            let b = match Map.get(made, name) {
                Some(found) -> found
                None -> match Map.get(rewritten, name) {
                    Some(found) -> found
                    None -> match Map.get(s.binds, name) {
                        Some(found) -> found
                        None -> continue
                    }
                }
            }
            for used in Set.elements(namesOf(b.value)) {
                if Map.contains(s.binds, used) && !Set.contains(live, used) {
                    Set.add(live, used)
                    grew = True
                }
            }
        }
    }
    live
}

fun request(s : Sharer, name : String, parts : Vec Layout) -> String {
    let k = Ssa.keyName(parts)
    let slot = name + "|" + k
    match Map.get(s.done, slot) {
        Some(found) -> return found
        None -> {}
    }
    var made = name + "@[" + k + "]"
    while Set.contains(s.used, made) { made = made + "~" }
    Set.add(s.used, made)
    -- Recorded before the body is built, which is what makes a recursive
    -- binding terminate: the copy's own call to itself, at its own layouts,
    -- finds this entry rather than asking for another copy.
    Map.put(s.done, slot, made)
    Vec.push(s.queue, (made, name, parts))
    made
}

fun build(s : Sharer, made : String, original : String,
          parts : Vec Layout) -> CBind {
    let b = s.binds[original]
    let layouts = Map.new()
    let atoms = s.atoms[original]
    for var i = 0; i < len(atoms) && i < len(parts); i = i + 1 {
        Map.put(layouts, Ty.typeKey(atoms[i]), parts[i])
    }
    defaultsInto(b, layouts, True)
    let copy = withValue(b, rewrite(s, b.value, Scope {
        owner = original, chain = [layouts], locals = Vec.new(2),
    }))
    copy.name = made
    copy.layouts = layouts
    copy
}

fun withValue(b : CBind, value : Core) -> CBind = CBind {
    name = b.name, ty = b.ty, binders = b.binders, value = value,
    span = b.span, mutable = b.mutable, module_ = b.module_,
    equations = b.equations, layouts = b.layouts,
}

-- Every call to a generic binding, pointed at the copy it means, and every
-- generalized local binding replaced by its copies.
fun rewrite(s : Sharer, e : Core, sc : Scope) -> Core {
    match e.kind {
        CTyApp(fn, args) -> match fn.kind {
            -- A type abstraction applied on the spot, as reading a method out of
            -- a known dictionary leaves it: reduced here, so that what it
            -- abstracts is a call keyed at these types rather than a value
            -- polymorphic in them.
            CTyLam(vs, body) -> if len(vs) == len(args) {
                let mapping = Map.new()
                for var i = 0; i < len(vs); i = i + 1 {
                    Map.put(mapping, vs[i].id, args[i])
                }
                return rewrite(s, Opt.instantiateTypes(body, mapping), sc)
            }
            CSlot(target, index) -> if len(args) > 0 && isDictionary(target.ty) {
                return dynamicCall(s, e, fn, target, index, args, sc)
            }
            CVar(n) -> match localNamed(sc, n) {
                Some(local) -> return mkCore(e.ty, e.span, CTyApp(
                    mkCore(fn.ty, fn.span, CVar(requestLocal(s, sc, local, args, e))),
                    args))
                None -> if Set.contains(s.generic, n) {
                    return mkCore(e.ty, e.span, CTyApp(
                        mkCore(fn.ty, fn.span, CVar(requestAt(s, sc, n, args, e))),
                        args))
                }
            }
            _ -> {}
        }
        CMatch(scrutinee, alts) -> return openArms(s, e, scrutinee, alts, sc)
        -- A dictionary's field that is a method polymorphic in its own
        -- variables: see `methodStub`.
        CDict(cls, slots) -> return dictionarySlots(s, e, cls, slots, sc)
        -- Anywhere else, a type abstraction whose variables no key gave a
        -- layout is one nothing applies to a type -- `(/\a. f)(d)`, as
        -- instantiating a method leaves it -- so its variables are as free as
        -- `defaultsInto`'s, and get the same layout.
        CTyLam(vs, body) -> defaultAtoms(unknownBinders(vs, sc), body.ty, sc)
        CLetRec(binds, body) -> {
            var any = False
            for b in binds {
                if len(abstractionBinders(b)) > 0 { any = True }
            }
            if any { return localRec(s, e, binds, body, sc) }
        }
        CLet(name, bound, value, body, binders) -> {
            let all = Vec.append(binders, spineBinders(value))
            if len(all) > 0 {
                return localLet(s, e, name, bound, value, body, binders, all, sc)
            }
        }
        _ -> {}
    }
    mkCore(e.ty, e.span, mapKind(e.kind, Mapper {
        expr = fun(x) = rewrite(s, x, sc),
        type_ = fun(t) = t,
        bind = fun(b) = withValue(b, rewrite(s, b.value, sc)),
    }))
}

-- The copy of top-level `n` a call at `args` means.
fun requestAt(s : Sharer, sc : Scope, n : String, args : Array Ty.Type,
              at : Core) -> String {
    let binders = abstractionBinders(s.binds[n])
    -- Positional, so a binding that states its `forall` in two places at once
    -- has to be applied to both at one site.
    if len(args) != len(binders) {
        oopsAt("a type application of '" + n + "' to "
               + Int.toString(len(args)) + " types, where it binds "
               + Int.toString(len(binders)), at)
    }
    match keyAt(s, s.atoms[n], binders, args, famsFor(s, sc), current(sc)) {
        Right(parts) -> request(s, n, parts)
        Left(t) -> oopsAt("no layout for '" + Ty.show(t) + "' at a call to '"
                          + n + "' from '" + sc.owner + "'", at)
    }
}

-- -- methods polymorphic in their own variables --------------------------------------

-- A method's own variables: the ones its scheme quantifies besides the class's.
fun ownVars(m : MethodInfo) -> Vec VarCell =
    Vec.filter(m.scheme.quantified, \_.id != m.classVar.id)

-- The atoms of a method's own variables, in key order: the variables of kind
-- `*`, then the applications over them alone in its declared type.
fun methodAtoms(m : MethodInfo) -> Vec Ty.Type {
    let own = ownVars(m)
    let owned = Set.new()
    for v in own { Set.add(owned, v.id) }
    let found = Vec.new(2)
    atomsInto(m.scheme.body, owned, owned, found, Set.new())
    let out = Vec.new(len(own))
    for v in own {
        if isStar(v.kind) { Vec.push(out, TVar(v)) }
    }
    let apps = Vec.new(len(found))
    for t in found {
        match t {
            TVar(_) -> {}
            _ -> Vec.push(apps, (Ty.typeKey(t), t))
        }
    }
    for (_, t) in Vec.sortBy(apps, fun(x, y) = Array.threeWay(x.0, y.0)) {
        Vec.push(out, t)
    }
    out
}

-- The method slot `index` of a `cls` dictionary holds, if it holds one.
fun methodAt(s : Sharer, cls : String, index : Int) -> Option (String, MethodInfo) {
    let name = match Classes.slotAt(s.classes, cls, index) {
        Some(MethodSlot(m)) -> m
        _ -> return None
    }
    match Map.get(s.classes.classes, cls) {
        Some(info) -> match Map.get(info.methods, name) {
            Some(m) -> Some((name, m))
            None -> None
        }
        None -> None
    }
}

-- A method polymorphic in its own variables, called through a dictionary this
-- body does not know. The dictionary holds the method once per layout key of
-- those variables that any such call asks for (`dictionarySlots`); this call
-- reads the slot for its own key, computed here, where the layouts are known.
fun dynamicCall(s : Sharer, e : Core, fn : Core, target : Core, index : Int,
                args : Array Ty.Type, sc : Scope) -> Core {
    let cls = match dictClass(target.ty) {
        Some(c) -> c
        None -> oopsAt("a method read from something that is not a dictionary", e)
    }
    let found = match methodAt(s, cls, index) {
        Some(f) -> f
        None -> oopsAt("slot " + Int.toString(index) + " of a '" + cls
                       + "' dictionary is not a method", e)
    }
    let (method, m) = found
    let own = ownVars(m)
    if len(own) != len(args) {
        oopsAt("the method '" + method + "' applied to " + Int.toString(len(args))
               + " types, where it binds " + Int.toString(len(own)), e)
    }
    let parts = match keyAt(s, methodAtoms(m), own, args, famsFor(s, sc),
                            current(sc)) {
        Right(ps) -> ps
        Left(t) -> oopsAt("no layout for '" + Ty.show(t) + "' at a call to the "
                          + "method '" + method + "' from '" + sc.owner + "'", e)
    }
    let k = Ssa.keyName(parts)
    let ofClass = Map.getOr(s.asked, cls, Map.new())
    Map.put(s.asked, cls, ofClass)
    let found = Map.getOr(ofClass, method, Map.new())
    Map.put(ofClass, method, found)
    Map.put(found, k, parts)
    -- A key this run was not started with has no slot yet. The run is then not
    -- the last, and what it makes of this call is thrown away (`share`).
    let slot = match Classes.keyedSlot(s.classes, cls, method, k) {
        Some(i) -> i
        None -> index
    }
    mkCore(e.ty, e.span, CTyApp(mkCore(fn.ty, fn.span,
        CSlot(rewrite(s, target, sc), slot)), args))
}

-- A dictionary's slots. A slot holding a method polymorphic in its own
-- variables is compiled once per key some call asks for, in the keyed slots
-- `publish` declared; the slot itself becomes `methodStub`, since no call
-- reads it. Every dictionary of a class has every keyed slot of the class: one
-- whose method is not compiled per key holds the same value in each.
fun dictionarySlots(s : Sharer, e : Core, cls : String, slots : Array Core,
                    sc : Scope) -> Core {
    let head = match Ty.spine(Ty.prune(e.ty)) {
        (_, args) -> if len(args) == 1 { args[0] } else { e.ty }
    }
    let out = Vec.new(len(slots))
    -- method -> key -> the copy compiled for it.
    let copies = Map.new()
    -- method -> the one value every key of it shares.
    let shared = Map.new()
    for var i = 0; i < len(slots); i = i + 1 {
        let value = slots[i]
        let found = match methodAt(s, cls, i) {
            Some(f) -> f
            None -> {
                Vec.push(out, rewrite(s, value, sc))
                continue
            }
        }
        let (name, m) = found
        let (stated, inner) = match value.kind {
            CTyLam(vs, body) -> (Some(vs), body)
            _ -> (None, value)
        }
        let vs = match fieldVars(m, head, inner) {
            Some(found) -> found
            None -> []
        }
        if len(vs) == 0 || len(unknownBinders(vs, sc)) == 0 {
            let made = rewrite(s, value, sc)
            Vec.push(out, made)
            Map.put(shared, name, made)
            continue
        }
        Vec.push(out, methodStub(value, stated, vs, inner, sc))
        let own = ownVars(m)
        let atoms = methodAtoms(m)
        let made = Map.new()
        Map.put(copies, name, made)
        let asked = Map.getOr(Map.getOr(s.keys, cls, Map.new()), name, Map.new())
        for k in Array.sort(Map.keys(asked)) {
            let parts = asked[k]
            let fresh = Vec.map(vs, fun(v) = Ty.newVar(v.level, v.kind))
            let renaming = Map.new()
            let toFresh = Map.new()
            for var j = 0; j < len(vs) && j < len(own); j = j + 1 {
                Map.put(renaming, vs[j].id, TVar(fresh[j]))
                Map.put(toFresh, own[j].id, TVar(fresh[j]))
            }
            for var j = 0; j < len(atoms) && j < len(parts); j = j + 1 {
                let key = Ty.typeKey(Decls.substitute(atoms[j], toFresh))
                for layouts in sc.chain { Map.put(layouts, key, parts[j]) }
            }
            let copied = Opt.instantiateTypes(inner, renaming)
            let v = match stated {
                Some(_) -> mkCore(Decls.substitute(value.ty, renaming), value.span,
                                  CTyLam(fresh, copied))
                None -> copied
            }
            Map.put(made, k, rewrite(s, v, sc))
        }
    }
    for (method, k) in Map.getOr(s.classes.keyed, cls, []) {
        let filled = match Map.get(copies, method) {
            Some(made) -> Map.get(made, k)
            None -> Map.get(shared, method)
        }
        match filled {
            Some(v) -> Vec.push(out, v)
            None -> oopsAt("no value for the '" + method + "' slot at key " + k
                           + " of a '" + cls + "' dictionary", e)
        }
    }
    mkCore(e.ty, e.span, CDict(cls, Vec.toArray(out)))
}

-- The variables a dictionary field's value has where its method's own are, in
-- the method's order, or `None` if the field is not polymorphic in them.
--
-- Read by matching the method's type at this dictionary's head against the
-- value's: a field states its own quantification as a type abstraction or
-- leaves it as variables its value is free in, and the matching finds either.
fun fieldVars(m : MethodInfo, head : Ty.Type, inner : Core) -> Option (Vec VarCell) {
    let mapping = Map.new()
    Map.put(mapping, m.classVar.id, head)
    let want = Decls.substitute(m.scheme.body, mapping)
    let got = if len(Classes.methodDicts(m)) == 0 { Ty.prune(inner.ty) } else {
        match Ty.prune(inner.ty) {
            TFun(_, r) -> Ty.prune(r)
            other -> other
        }
    }
    let found = Map.new()
    if !matchTypes(want, got, found) { return None }
    let out = Vec.new(2)
    for v in ownVars(m) {
        match Map.get(found, v.id) {
            Some(t) -> match Ty.prune(t) {
                TVar(cell) -> Vec.push(out, cell)
                _ -> return None
            }
            None -> return None
        }
    }
    Some(out)
}

-- The variables of kind `*` among `vs` that the scope has no layout for.
fun unknownBinders(vs : Vec VarCell, sc : Scope) -> Vec VarCell =
    Vec.filter(vs, fun(v) =
        isStar(v.kind) && !Map.contains(current(sc), Ty.typeKey(TVar(v))))

-- `unit` for every atom of `ty` over `vs`, in every map on the chain.
fun defaultAtoms(vs : Vec VarCell, ty : Ty.Type, sc : Scope) -> Unit {
    if len(vs) == 0 { return {} }
    let owned = Set.new()
    for v in vs { Set.add(owned, v.id) }
    let visible = Set.new()
    for v in Ty.varsOf([ty]) { Set.add(visible, v.id) }
    let atoms = Vec.new(4)
    atomsInto(ty, owned, visible, atoms, Set.new())
    for v in vs { Vec.push(atoms, TVar(v)) }
    for t in atoms {
        for layouts in sc.chain {
            let k = Ty.typeKey(t)
            if !Map.contains(layouts, k) { Map.put(layouts, k, unit_) }
        }
    }
}

-- What a dictionary field holding a method polymorphic in its own variables
-- becomes: a function that panics.
--
-- The field is one closure, and a closure is compiled at one set of layouts,
-- while the method's own variables are instantiated afresh at each use. A use
-- through a *known* dictionary does not read the field -- it is a direct call to
-- the hoisted method, and keyed like any other -- and a use through an unknown
-- one reads the keyed slot for its key (`dynamicCall`), so nothing calls
-- this. Its atoms are given `unit`, which is as good as any layout for
-- parameters nothing reads.
fun methodStub(e : Core, stated : Option (Vec VarCell), vs : Vec VarCell,
               body : Core, sc : Scope) -> Core {
    defaultAtoms(vs, body.ty, sc)
    let (params, result) = match Ty.prune(body.ty) {
        TFun(ps, r) -> (ps, r)
        _ -> oopsAt("a type abstraction in '" + sc.owner + "' that is not a "
                    + "method and whose layouts are not known", e)
    }
    let names = Array.init(len(params), fun(i) {
        CParam { name = "%unused" + Int.toString(i),
                                   ty = params[i] }
    })
    let message = mkCore(Ty.tString(), e.span, CLit(LString(
        "internal error: a dictionary method was called at layouts it was not "
        + "compiled for")))
    let fail = mkCore(result, e.span, CApp(
        mkCore(TFun([Ty.tString()], result), e.span, CPrim(Prims.Error)), [message]))
    let stub = mkCore(body.ty, e.span, CLam(names, fail, "%stub"))
    match stated {
        Some(bs) -> mkCore(e.ty, e.span, CTyLam(bs, stub))
        None -> stub
    }
}

-- The binders a value states in a `CTyLam` on its spine.
fun spineBinders(value : Core) -> Vec VarCell {
    let out = Vec.new(2)
    var e = value
    loop {
        match e.kind {
            CLam(_, body, _) -> { e = body }
            CTyLam(vs, body) -> {
                for v in vs { Vec.push(out, v) }
                e = body
            }
            _ -> break
        }
    }
    out
}

fun localNamed(sc : Scope, name : String) -> Option Local {
    for var i = len(sc.locals) - 1; i >= 0; i = i - 1 {
        match Map.get(sc.locals[i], name) {
            Some(found) -> return Some(found)
            None -> {}
        }
    }
    None
}

-- The variables bound around a term, by the owner and every local scope: what
-- a local binding's application atom may mention besides its own.
fun visibleIn(s : Sharer, sc : Scope) -> Set.Set Int {
    let out = Set.new()
    match Map.get(s.binds, sc.owner) {
        Some(b) -> for v in abstractionBinders(b) { Set.add(out, v.id) }
        None -> {}
    }
    for scope in sc.locals {
        for (_, local) in Map.entries(scope) {
            for v in local.binders { Set.add(out, v.id) }
        }
    }
    out
}

fun newLocal(s : Sharer, sc : Scope, name : String, ty : Ty.Type, value : Core,
             binders : Vec VarCell, bind : Option CBind) -> Local = Local {
    name = name, ty = ty, value = value, binders = binders,
    atoms = atomsOf(ty, value, binders, visibleIn(s, sc), []),
    bind = bind, done = Map.new(), queue = Vec.new(2), built = Vec.new(2),
}

-- The copy of a local binding a use at `args` means.
--
-- A local copy is the local binding with fresh binders, so that its atoms can go
-- into the owner's one layouts map beside every other copy's: two copies of one
-- local at two layouts are two sets of variables, not one set at two layouts.
fun requestLocal(s : Sharer, sc : Scope, local : Local, args : Array Ty.Type,
                 at : Core) -> String {
    if len(args) != len(local.binders) {
        oopsAt("a type application of the local '" + local.name + "' to "
               + Int.toString(len(args)) + " types, where it binds "
               + Int.toString(len(local.binders)), at)
    }
    let parts = match keyAt(s, local.atoms, local.binders, args, famsFor(s, sc),
                            current(sc)) {
        Right(ps) -> ps
        Left(t) -> oopsAt("no layout for '" + Ty.show(t) + "' at a use of the "
                          + "local '" + local.name + "' in '" + sc.owner + "'", at)
    }
    let k = Ssa.keyName(parts)
    match Map.get(local.done, k) {
        Some(found) -> return found
        None -> {}
    }
    let made = local.name + "@[" + k + "]"
    let renaming = Map.new()
    let fresh = Vec.new(len(local.binders))
    for v in local.binders {
        let w = Ty.newVar(v.level, v.kind)
        Vec.push(fresh, w)
        Map.put(renaming, v.id, TVar(w))
    }
    for var i = 0; i < len(local.atoms) && i < len(parts); i = i + 1 {
        let key = Ty.typeKey(Decls.substitute(local.atoms[i], renaming))
        for layouts in sc.chain { Map.put(layouts, key, parts[i]) }
    }
    Map.put(local.done, k, made)
    Vec.push(local.queue, (made, renaming, fresh))
    made
}

-- Build every copy requested of these locals, including the ones requested
-- while building the others.
fun drainLocals(s : Sharer, locals : Vec Local, sc : Scope) -> Unit {
    var going = True
    while going {
        going = False
        for local in locals {
            while len(local.queue) > 0 {
                going = True
                let batch = local.queue
                local.queue = Vec.new(2)
                for (made, renaming, fresh) in batch {
                    let value = rewrite(s, renamedSpine(
                        Opt.instantiateTypes(local.value, renaming), renaming), sc)
                    Vec.push(local.built, (made, Decls.substitute(local.ty, renaming),
                                             value, fresh, renaming))
                }
            }
        }
    }
}

-- A group of local functions some of which generalized: the ones that did are
-- replaced by their copies, and dropped if nothing uses them.
fun localRec(s : Sharer, e : Core, binds : Vec CBind, body : Core,
             sc : Scope) -> Core {
    let scope = Map.new()
    let locals = Vec.new(len(binds))
    Vec.push(sc.locals, scope)
    for b in binds {
        let binders = abstractionBinders(b)
        if len(binders) > 0 {
            let local = newLocal(s, sc, b.name, b.ty, b.value, binders, Some(b))
            Map.put(scope, b.name, local)
            Vec.push(locals, local)
        }
    }
    let rest = rewrite(s, body, sc)
    let out = Vec.new(len(binds))
    for b in binds {
        if len(abstractionBinders(b)) == 0 {
            Vec.push(out, withValue(b, rewrite(s, b.value, sc)))
        }
    }
    drainLocals(s, locals, sc)
    discard(Vec.pop(sc.locals))
    for local in locals {
        let original = match local.bind {
            Some(b) -> b
            None -> continue
        }
        for (made, ty, value, fresh, renaming) in local.built {
            -- The original states its binders in `binders`, on the spine, or
            -- both; the copy states them where it did, renamed.
            let own = Vec.new(len(original.binders))
            for v in original.binders {
                match Map.get(renaming, v.id) {
                    Some(TVar(w)) -> Vec.push(own, w)
                    _ -> Vec.push(own, v)
                }
            }
            let copy = CBind {
                name = made, ty = ty, binders = own, value = value,
                span = original.span, mutable = original.mutable,
                module_ = original.module_,
                equations = Vec.map(original.equations, fun(pair) = {
                    let (l, r) = pair
                    (Decls.substitute(l, renaming), Decls.substitute(r, renaming))
                }),
                layouts = original.layouts,
            }
            Vec.push(out, copy)
        }
    }
    if len(out) == 0 { return rest }
    mkCore(e.ty, e.span, CLetRec(out, rest))
}

-- A `let` that generalized: its copies, each bound around the body, and not the
-- original.
fun localLet(s : Sharer, e : Core, name : String, bound : Ty.Type, value : Core,
             body : Core, stated : Vec VarCell, binders : Vec VarCell,
             sc : Scope) -> Core {
    let local = newLocal(s, sc, name, bound, value, binders, None)
    let scope = Map.new()
    Map.put(scope, name, local)
    Vec.push(sc.locals, scope)
    let rest = rewrite(s, body, sc)
    discard(Vec.pop(sc.locals))
    -- The value cannot name the binding it defines, so its copies are built
    -- with the binding out of scope.
    drainLocals(s, [local], sc)
    var out = rest
    for var i = len(local.built) - 1; i >= 0; i = i - 1 {
        let (made, ty, v, _, renaming) = local.built[i]
        let own = Vec.new(len(stated))
        for b in stated {
            match Map.get(renaming, b.id) {
                Some(TVar(w)) -> Vec.push(own, w)
                _ -> Vec.push(own, b)
            }
        }
        out = mkCore(e.ty, e.span, CLet(made, ty, v, out, own))
    }
    out
}

-- A copied value's own `CTyLam` binders, renamed as its types were.
fun renamedSpine(e : Core, renaming : Map Int Ty.Type) -> Core = match e.kind {
    CLam(params, body, name) ->
        mkCore(e.ty, e.span, CLam(params, renamedSpine(body, renaming), name))
    CTyLam(vs, body) -> mkCore(e.ty, e.span, CTyLam(Vec.map(vs, fun(v) =
        match Map.get(renaming, v.id) {
            Some(TVar(w)) -> w
            _ -> v
        }), renamedSpine(body, renaming)))
    _ -> e
}

-- -- the check ----------------------------------------------------------------------

-- Every type in the program whose layout its binding cannot know, as
-- "binding: type". Empty is what the backend requires.
--
-- Only types of kind `*` classify values; a constructor like `f` in `Functor f`
-- has no layout and needs none. The walk does not look inside an atom, for the
-- reason `atomsInto` does not.
fun unknownLayouts(program : CProgram, decls : DeclTable) -> Vec String {
    let each = Parallel.map(Vec.append(program.dicts, program.binds), unknownOf(decls, _))
    let out = []
    for found in each { for k in found { Vec.push(out, k) } }
    out
}

fun unknownOf(decls : DeclTable, b : CBind) -> Vec String {
    let out = []
    let seen = Set.new()
    let report = fun(t : Ty.Type, layouts : Map String Layout,
                     known : Map String (Option Ty.Type)) = {
        match unknownIn(decls, t, layouts, known) {
            Some(bad) -> {
                let k = Ty.show(bad)
                if !Set.contains(seen, k) {
                    Set.add(seen, k)
                    Vec.push(out, b.name + ": " + k)
                }
            }
            None -> {}
        }
    }
    let known = Map.new()
    report(b.ty, b.layouts, known)
    unknownInto(b.value, b.layouts, known, report)
    out
}

-- `known` holds the answer for each type already asked about under these
-- layouts, by its `Ty.typeKey`: a body mentions the same types at most of its
-- nodes, and a flat type's layout takes its fields' to find.
fun unknownIn(decls : DeclTable, ty : Ty.Type, layouts : Map String Layout,
              known : Map String (Option Ty.Type)) -> Option Ty.Type {
    let t = Ty.prune(ty)
    if !isStar(Ty.kindOf(t)) { return None }
    if !unfolds(decls, t) { return unknownUncached(decls, t, layouts, known) }
    let key = Ty.typeKey(t)
    match Map.get(known, key) {
        Some(found) -> return found
        None -> {}
    }
    let found = unknownUncached(decls, t, layouts, known)
    Map.put(known, key, found)
    found
}

fun unknownUncached(decls : DeclTable, t : Ty.Type, layouts : Map String Layout,
                    known : Map String (Option Ty.Type)) -> Option Ty.Type {
    match layoutOf(decls, t, layouts) {
        None -> return Some(t)
        Some(_) -> {}
    }
    if isAtom(t) { return None }
    let parts = match t {
        TApp(fn, arg, _) -> [fn, arg]
        TFun(params, ret) -> Array.append(params, [ret])
        TTuple(elems) -> elems
        _ -> []
    }
    for p in parts {
        match unknownIn(decls, p, layouts, known) {
            Some(bad) -> return Some(bad)
            None -> {}
        }
    }
    None
}

fun unknownInto(e : Core, layouts : Map String Layout,
                known : Map String (Option Ty.Type),
                report : fun(Ty.Type, Map String Layout,
                             Map String (Option Ty.Type)) -> Unit) -> Unit {
    report(e.ty, layouts, known)
    match e.kind {
        CMatch(scrutinee, alts) -> {
            unknownInto(scrutinee, layouts, known, report)
            for alt in alts {
                let inner = Map.new()
                for (k, l) in Map.entries(layouts) { Map.put(inner, k, l) }
                match openingOf(alt.alt) {
                    Some(o) -> match o.layouts {
                        Some(ls) -> for var j = 0; j < len(o.skolems) && j < len(ls);
                                        j = j + 1 {
                            Map.put(inner, skolemKey(o.skolems[j]), ls[j])
                        }
                        None -> {}
                    }
                    None -> {}
                }
                unknownInto(alt.body, inner, Map.new(), report)
            }
            return {}
        }
        _ -> {}
    }
    discard(mapKind(e.kind, Mapper {
        expr = fun(x) = {
            unknownInto(x, layouts, known, report)
            x
        },
        type_ = fun(t) = {
            report(t, layouts, known)
            t
        },
        bind = fun(b) = {
            report(b.ty, layouts, known)
            unknownInto(b.value, layouts, known, report)
            b
        },
    }))
}

-- -- existentials -------------------------------------------------------------------

fun openArms(s : Sharer, e : Core, scrutinee : Core, alts : Vec CAlt,
             sc : Scope) -> Core {
    let abstracted = current(sc)
    let out = Vec.new(len(alts))
    for alt in alts {
        match alt.alt {
            ACon(name, fields, Some(o)) -> if Option.isNone(o.layouts) {
                for parts in openingKeys(s, scrutinee, name, abstracted) {
                    let copy = ACon(name, fields, Some(Opening {
                        evidence = o.evidence, skolems = o.skolems,
                        layouts = Some(parts),
                    }))
                    Vec.push(out, CAlt { alt = copy,
                                           body = rewrite(s, alt.body, inArm(sc, copy)) })
                }
                continue
            }
            _ -> {}
        }
        Vec.push(out, CAlt { alt = alt.alt, body = rewrite(s, alt.body, inArm(sc, alt.alt)) })
    }
    mkCore(e.ty, e.span, CMatch(rewrite(s, scrutinee, sc), out))
}

-- The keys an arm opening `name` is copied for: the ones `name` is packed at,
-- as far as the runs so far found -- unless the value being opened is a
-- packing right here, in which case it is the one key that packing stores.
-- None, for a constructor nothing packs: no value reaches the arm.
fun openingKeys(s : Sharer, scrutinee : Core, name : String,
                abstracted : Map String Layout) -> Vec (Vec Layout) {
    match knownKey(s, scrutinee, name, abstracted) {
        Some(parts) -> return [parts]
        None -> {}
    }
    match Map.get(s.packed, name) {
        Some(found) -> Vec.fromArray(Map.values(found))
        None -> []
    }
}

-- The scope inside an arm: the layouts around it, and the constants it opens
-- at the layouts it records.
fun inArm(sc : Scope, alt : Alt) -> Scope {
    let inner = Map.new()
    for (k, l) in Map.entries(current(sc)) { Map.put(inner, k, l) }
    match openingOf(alt) {
        Some(o) -> match o.layouts {
            Some(ls) -> for var j = 0; j < len(o.skolems) && j < len(ls);
                            j = j + 1 {
                Map.put(inner, skolemKey(o.skolems[j]), ls[j])
            }
            None -> {}
        }
        None -> {}
    }
    Scope { owner = sc.owner, chain = Array.append(sc.chain, [inner]),
            locals = sc.locals }
}

-- The layouts an opening must be for, when what it opens is a packing written
-- right here -- `match C(d, xs) { C(ys) -> ... }`, which is what an inlined
-- opener leaves behind.
fun knownKey(s : Sharer, scrutinee : Core, opened : String,
             abstracted : Map String Layout) -> Option (Vec Layout) {
    match scrutinee.kind {
        CApp(fn, args) -> match fn.kind {
            CCon(name) -> {
                if name != opened { return None }
                match Decls.con(s.decls, name) {
                    Some(info) -> if len(info.exists) > 0 {
                        return packedKeyParts(s.decls, info, args, abstracted)
                    }
                    None -> {}
                }
                None
            }
            _ -> None
        }
        _ -> None
    }
}

fun declaredFields(info : ConInfo) -> Array Ty.Type = match info.scheme.body {
    TFun(params, _) -> params
    _ -> []
}

-- The key one packing is at -- one layout per hidden variable, which the
-- packed value records as its index in the constructor's table -- or `None` if
-- the layouts are not knowable here. Matched one way, so no type is changed.
fun packedKeyParts(decls : DeclTable, info : ConInfo, args : Array Core,
                   abstracted : Map String Layout) -> Option (Vec Layout) {
    let found = Map.new()
    let declared = declaredFields(info)
    let carried = len(info.scheme.preds)
    for var i = 0; i < len(declared) && carried + i < len(args); i = i + 1 {
        discard(matchTypes(declared[i], Ty.prune(args[carried + i].ty), found))
    }
    let out = Vec.new(len(info.exists))
    for v in info.exists {
        match Map.get(found, v.id) {
            None -> return None
            Some(packedTy) -> match layoutOf(decls, packedTy, abstracted) {
                Some(l) -> Vec.push(out, l)
                None -> return None
            }
        }
    }
    Some(out)
}

-- One-way matching: bind the pattern type's variables to what the target has.
fun matchTypes(pattern : Ty.Type, target : Ty.Type,
               out : Map Int Ty.Type) -> Bool = match Ty.prune(pattern) {
    TVar(cell) -> match Map.get(out, cell.id) {
        Some(had) -> Ty.sameType(had, target)
        None -> {
            Map.put(out, cell.id, target)
            True
        }
    }
    TCon(c) -> match target {
        TCon(d) -> c.name == d.name && c.level == d.level
        _ -> False
    }
    TApp(pf, pa, _) -> match target {
        TApp(tf, ta, _) -> matchTypes(pf, tf, out) && matchTypes(pa, ta, out)
        _ -> False
    }
    TFam(pn, pa, _) -> match target {
        TFam(tn, ta, _) -> pn == tn && matchTypes(pa, ta, out)
        _ -> False
    }
    TFun(pp, pr) -> match target {
        TFun(tp, tr) -> {
            if len(pp) != len(tp) { return False }
            for var i = 0; i < len(pp); i = i + 1 {
                if !matchTypes(pp[i], tp[i], out) { return False }
            }
            matchTypes(pr, tr, out)
        }
        _ -> False
    }
    TTuple(pe) -> match target {
        TTuple(te) -> {
            if len(pe) != len(te) { return False }
            for var i = 0; i < len(pe); i = i + 1 {
                if !matchTypes(pe[i], te[i], out) { return False }
            }
            True
        }
        _ -> False
    }
    _ -> False
}

-- For each constructor in `tables`, the keys `program` packs it at.
--
-- Every packing is in a body compiled at known layouts -- a copy, or an arm
-- copied for one key -- so each stores a key this finds. One it cannot know is
-- a bug in the copying.
fun packedLayouts(program : CProgram, decls : DeclTable, tables : Packed) -> Packed {
    let out = Map.new()
    for con in Map.keys(tables) { Map.put(out, con, Map.new()) }
    for b in Vec.append(program.dicts, program.binds) {
        packingsInto(decls, b.value, b.layouts, out)
    }
    out
}

-- Add each packing in `e` of a constructor `out` has a table for.
fun packingsInto(decls : DeclTable, e : Core, abstracted : Map String Layout,
                 out : Packed) -> Unit {
    match e.kind {
        CMatch(scrutinee, alts) -> {
            packingsInto(decls, scrutinee, abstracted, out)
            for alt in alts {
                let inner = Map.new()
                for (id_, layout) in Map.entries(abstracted) {
                    Map.put(inner, id_, layout)
                }
                match openingOf(alt.alt) {
                    Some(o) -> match o.layouts {
                        Some(ls) -> for var j = 0; j < len(o.skolems) && j < len(ls);
                                        j = j + 1 {
                            Map.put(inner, skolemKey(o.skolems[j]), ls[j])
                        }
                        None -> {}
                    }
                    None -> {}
                }
                packingsInto(decls, alt.body, inner, out)
            }
            return {}
        }
        CApp(fn, args) -> match fn.kind {
            CCon(name) -> match (Map.get(out, name), Decls.con(decls, name)) {
                (Some(have), Some(info)) -> match packedKeyParts(decls, info, args, abstracted) {
                    Some(parts) -> {
                        let k = Ssa.keyName(parts)
                        if !Map.contains(have, k) { Map.put(have, k, parts) }
                    }
                    None -> oopsAt("packing '" + name
                                   + "' at layouts that are not knowable here", e)
                }
                _ -> {}
            }
            _ -> {}
        }
        _ -> {}
    }
    discard(mapKind(e.kind, Mapper {
        expr = fun(x) = {
            packingsInto(decls, x, abstracted, out)
            x
        },
        type_ = fun(t) = t,
        bind = fun(b) = {
            packingsInto(decls, b.value, b.layouts, out)
            b
        },
    }))
}

fun oops(message : String) -> a =
    Diag.fail(Diag.whole("internal error", message), "")

fun oopsAt(message : String, at : Core) -> a = match at.span {
    None -> oops(message)
    Some(where) -> Diag.fail(Diag.at("internal error", message, where), where.file)
}

fun discard(x : a) -> Unit = {}
