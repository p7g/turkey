module Turkey.Lexer (tokenize, tokenizeRaw, applyNewlineRule)

-- The tokenizer, in two passes.
--
-- `tokenizeRaw` emits a NEWLINE for every line break; `applyNewlineRule` then
-- decides which of them terminate a production. Keeping the two apart is what
-- makes the subtlest part of the lexical structure testable on its own.
--
-- Identifiers and numerals are ASCII: `[a-z_]` starts a name and `[0-9]` a
-- numeral, so a Greek letter or a Devanagari digit starts neither. The rules
-- for numerals are under "numbers" below.

import Turkey.Diag as Diag
import Turkey.Source (Source(..), Span, span)
import Turkey.Token (Kind(..), Token(..), Value(..), isOp)

type Lexer = Lexer {
    src      : String,
    file     : String,
    var at   : String.Index,
    var line : Int,
    var col  : Int,
}

-- -- tables -------------------------------------------------------------------------
--
-- Built once, at load time. A function returning a literal would rebuild its
-- array on every call, which for `keywords` means once per identifier.

let keywords = [
    "type", "class", "instance", "fun", "let", "var", "match", "if", "else",
    "while", "for", "in", "loop", "return", "break", "continue", "module",
    "import", "export", "as", "hiding", "do", "foreign",
]

-- Longest match first: `<=` must beat `<` and `->` must beat `-`. `?` is a
-- postfix operator and no two-character operator begins with one, so it sits
-- with the singles.
let operators = [
    "==", "!=", "<=", ">=", "->", "&&", "||", "..",
    "=", "<", ">", "+", "-", "*", "/", "%", "!", ":", ",", ".", "|", "~", "?",
    "\\",
    "{", "}", "(", ")", "[", "]",
]

-- The keywords that can start a sibling production, for the newline rule below.
let starters = [
    "let", "var", "fun", "type", "class", "instance", "if", "match",
    "while", "for", "loop", "return", "break", "continue", "module",
    "import", "do", "foreign",
]

-- -- character helpers -----------------------------------------------------------

fun peek(lx : Lexer) -> Option Char = String.decode(lx.src, lx.at)

-- Stepping is O(n) in the offset rather than O(1), which costs nothing here: no
-- caller looks further than two characters ahead.
fun peekAt(lx : Lexer, ahead : Int) -> Option Char {
    var here = lx.at
    var left = ahead
    while left > 0 {
        match String.step(lx.src, here) {
            None -> { return None }
            Some(p) -> { here = p.1 }
        }
        left = left - 1
    }
    String.decode(lx.src, here)
}

fun atEnd(lx : Lexer) -> Bool = String.atEnd(lx.src, lx.at)

-- One code point, keeping the line and column in step. A column counts code
-- points, so it is what a reader would count in their editor.
fun bump(lx : Lexer) -> Unit {
    match String.step(lx.src, lx.at) {
        None -> {}
        Some(p) -> {
            lx.at = p.1
            if p.0 == '\n' {
                lx.line = lx.line + 1
                lx.col = 1
            } else {
                lx.col = lx.col + 1
            }
        }
    }
}

fun bumpBy(lx : Lexer, count : Int) -> Unit {
    for var i = 0; i < count; i = i + 1 { bump(lx) }
}

fun here(lx : Lexer) -> Span = span(lx.file, lx.line, lx.col)

fun oops(lx : Lexer, message : String, where : Span) -> a =
    Diag.fail(Diag.at("lex error", message, where), lx.file)

-- Does the source read `needle` at `start`? The needles are one and two
-- characters long, so this is a comparison and not a search.
fun matchesAt(src : String, start : String.Index, needle : String) -> Bool {
    var here = start
    for wanted in String.codePoints(needle) {
        match String.step(src, here) {
            None -> { return False }
            Some(p) -> {
                if p.0 != wanted { return False }
                here = p.1
            }
        }
    }
    True
}

fun charIs(c : Option Char, wanted : Char) -> Bool = match c {
    Some(found) -> found == wanted
    None -> False
}

fun charIsSign(c : Option Char) -> Bool = match c {
    Some(found) -> found == '+' || found == '-'
    None -> False
}

-- -- pass one ----------------------------------------------------------------------

fun tokenizeRaw(source : Source) -> Vec Token {
    let lx = Lexer {
        src = source.text,
        file = source.name,
        at = String.start(source.text),
        line = 1,
        col = 1,
    }
    let tokens = Vec.new(64)
    loop {
        skipInlineTrivia(lx)
        if atEnd(lx) { break }
        let start = here(lx)
        match peek(lx) {
            None -> { break }
            Some(c) -> { Vec.push(tokens, lexOne(lx, start, c, tokens)) }
        }
    }
    Vec.push(tokens, plain(KEof, VText(""), here(lx)))
    tokens
}

fun lexOne(lx : Lexer, start : Span, c : Char, tokens : Vec Token) -> Token {
    if c == '\n' {
        bump(lx)
        plain(KNewline, VText("\n"), start)
    } else if c == ';' {
        bump(lx)
        Token { kind = KNewline, value = VText(";"), span = start, forced = True }
    } else if Char.isDigit(c) {
        lexNumber(lx, start, afterDot(tokens))
    } else if c == '"' {
        lexString(lx, start)
    } else if c == '\'' {
        lexChar(lx, start)
    } else if Char.isAsciiAlpha(c) || c == '_' {
        lexWord(lx, start)
    } else {
        lexOperator(lx, start, c)
    }
}

fun afterDot(tokens : Vec Token) -> Bool = match Vec.last(tokens) {
    None -> False
    Some(t) -> isOp(t.kind, ".")
}

fun plain(kind : Kind, value : Value, where : Span) -> Token =
    Token { kind = kind, value = value, span = where, forced = False }

-- Spaces, tabs, carriage returns and comments -- but never a newline, which is
-- a token.
fun skipInlineTrivia(lx : Lexer) -> Unit {
    loop {
        if atEnd(lx) { break }
        match peek(lx) {
            None -> { break }
            Some(c) -> {
                if c == ' ' || c == '\t' || c == '\r' {
                    bump(lx)
                } else if c == '-' && charIs(peekAt(lx, 1), '-') {
                    while !atEnd(lx) {
                        if charIs(peek(lx), '\n') { break }
                        bump(lx)
                    }
                } else if c == '{' && charIs(peekAt(lx, 1), '-') {
                    skipBlockComment(lx)
                } else {
                    break
                }
            }
        }
    }
}

-- Nested, so `{- {- -} -}` is one comment.
fun skipBlockComment(lx : Lexer) -> Unit {
    let start = here(lx)
    var depth = 0
    loop {
        if atEnd(lx) { oops(lx, "unterminated block comment", start) }
        if charIs(peek(lx), '{') && charIs(peekAt(lx, 1), '-') {
            bumpBy(lx, 2)
            depth = depth + 1
        } else if charIs(peek(lx), '-') && charIs(peekAt(lx, 1), '}') {
            bumpBy(lx, 2)
            depth = depth - 1
            if depth == 0 { break }
        } else {
            bump(lx)
        }
    }
}

-- -- numbers -----------------------------------------------------------------------
--
-- A numeral is `0x`, `0o` or `0b` and digits of that base, or decimal digits
-- that may go on into a FLOAT. Every run of digits may be broken up by single
-- `_`s, each between two digits. A literal's value is the number it spells,
-- whatever the base: a literal's type is chosen from its value, so a hex
-- literal past `Int`'s range cannot be read as a 64-bit pattern without also
-- becoming a small number that can be a `Float`.
--
-- A numeral may not run straight into a letter, a digit or a `_`. Otherwise
-- a token split would decide what `12abc`, `0b102` or `1_` means, and no
-- reading of any of them is what the writer meant; each is an error instead.
-- For the same reason a decimal numeral other than `0` does not start with a
-- zero: `010` is neither ten nor C's eight.

fun lexNumber(lx : Lexer, start : Span, afterDot : Bool) -> Token {
    if afterDot { return lexSelector(lx, start) }
    let from = lx.at
    if charIs(peek(lx), '0') {
        match radixOf(peekAt(lx, 1)) {
            Some(radix) -> { return lexRadix(lx, start, from, radix) }
            None -> {}
        }
    }
    digitRun(lx, 10)
    let text = String.slice(lx.src, from, lx.at)
    if String.startsWith(text, "0") && text != "0" {
        oops(lx, "leading zeros are not allowed in '" + text
                 + "' (octal is written 0o)", start)
    }
    -- A `.` only continues the number when a digit follows, so `1.foo` stays
    -- an INT and a field access, and `0..n` a range.
    if (charIs(peek(lx), '.') && isDigitIn(peekAt(lx, 1), 10)) || isExponentMark(peek(lx)) {
        return lexFloat(lx, start, from)
    }
    endOfNumeral(lx, start, 10)
    intToken(lx, start, from, text, 10)
}

fun lexRadix(lx : Lexer, start : Span, from : String.Index, radix : Int) -> Token {
    bumpBy(lx, 2)
    let digitsFrom = lx.at
    if !isDigitIn(peek(lx), radix) {
        let prefix = String.slice(lx.src, from, lx.at)
        oops(lx, radixName(radix) + " literal needs a digit after '" + prefix + "'", start)
    }
    digitRun(lx, radix)
    endOfNumeral(lx, start, radix)
    intToken(lx, start, from, String.slice(lx.src, digitsFrom, lx.at), radix)
}

-- After a projection `.`, digits are a selector: an index into a tuple, so
-- decimal and nothing else. A following `.` must not fold the selector and
-- its successor into one FLOAT either: `x.0.1` is two chained projections.
fun lexSelector(lx : Lexer, start : Span) -> Token {
    let from = lx.at
    while isDigitIn(peek(lx), 10) { bump(lx) }
    let text = String.slice(lx.src, from, lx.at)
    if (String.startsWith(text, "0") && text != "0") || gluedOn(peek(lx)) {
        oops(lx, "a tuple selector is a plain decimal index such as .0 or .1", start)
    }
    intToken(lx, start, from, text, 10)
}

-- `digits` is the numeral without its prefix, `from` where the whole of it
-- starts, which is what an error quotes.
fun intToken(lx : Lexer, start : Span, from : String.Index, digits : String,
             radix : Int) -> Token = match valueIn(digits, radix) {
    Some(n) -> plain(KInt, VInt(n), start)
    -- `Int` is 64-bit, so a literal past its range is a compile error
    -- rather than something that wraps or widens.
    None -> oops(lx, "integer literal out of range: "
                     + String.slice(lx.src, from, lx.at), start)
}

-- Entered at the `.` of a fraction or at the `e` of an exponent. An exponent
-- is what lets `show` on a large `Float` produce something that lexes back.
fun lexFloat(lx : Lexer, start : Span, from : String.Index) -> Token {
    if charIs(peek(lx), '.') {
        bump(lx)
        digitRun(lx, 10)
    }
    if isExponentMark(peek(lx)) {
        bump(lx)
        if charIsSign(peek(lx)) { bump(lx) }
        if !isDigitIn(peek(lx), 10) {
            oops(lx, "exponent needs digits in '"
                     + String.slice(lx.src, from, lx.at) + "'", start)
        }
        digitRun(lx, 10)
    }
    endOfNumeral(lx, start, 10)
    let text = String.slice(lx.src, from, lx.at)
    match Float.parse(String.replace(text, "_", "")) {
        Some(x) -> plain(KFloat, VFloat(x), start)
        None -> oops(lx, "malformed floating-point literal " + text, start)
    }
}

-- Digits of `radix`, each pair perhaps split by one `_`. The caller has seen
-- the first digit. A `_` with no digit after it is left for `endOfNumeral`.
fun digitRun(lx : Lexer, radix : Int) -> Unit {
    loop {
        if isDigitIn(peek(lx), radix) {
            bump(lx)
        } else if charIs(peek(lx), '_') && isDigitIn(peekAt(lx, 1), radix) {
            bumpBy(lx, 2)
        } else {
            break
        }
    }
}

fun endOfNumeral(lx : Lexer, start : Span, radix : Int) -> Unit = match peek(lx) {
    None -> {}
    Some(c) -> {
        if c == '_' {
            oops(lx, "a '_' in a number must sit between two digits", start)
        } else if Char.isDigit(c) {
            oops(lx, "invalid digit '" + Char.toString(c) + "' in "
                     + radixName(radix) + " literal", start)
        } else if gluedOn(peek(lx)) {
            oops(lx, "a number cannot be followed directly by '"
                     + Char.toString(c) + "'", start)
        }
    }
}

fun gluedOn(c : Option Char) -> Bool = match c {
    Some(found) -> Char.isAsciiAlphanumeric(found) || found == '_'
    None -> False
}

fun radixOf(c : Option Char) -> Option Int = match c {
    Some('x') -> Some(16)
    Some('o') -> Some(8)
    Some('b') -> Some(2)
    _ -> None
}

fun radixName(radix : Int) -> String = match radix {
    16 -> "hexadecimal"
    8 -> "octal"
    2 -> "binary"
    _ -> "decimal"
}

fun isExponentMark(c : Option Char) -> Bool = charIs(c, 'e') || charIs(c, 'E')

fun isDigitIn(c : Option Char, radix : Int) -> Bool = match c {
    None -> False
    Some(found) -> match digitValue(found) {
        Some(d) -> d < radix
        None -> False
    }
}

-- The value of `digits` in `radix`, skipping `_`s, or None past `Int`'s range.
fun valueIn(digits : String, radix : Int) -> Option Int {
    var total = 0
    for c in String.codePoints(digits) {
        match digitValue(c) {
            None -> {}
            Some(d) -> {
                if total > (Int.maxValue() - d) / radix { return None }
                total = total * radix + d
            }
        }
    }
    Some(total)
}

-- A digit's value in any base up to sixteen. 48 is '0', 87 is 'a' - 10, and
-- 55 is 'A' - 10.
fun digitValue(c : Char) -> Option Int {
    let code = Char.toInt(c)
    if code >= 48 && code <= 57 {
        Some(code - 48)
    } else if code >= 97 && code <= 102 {
        Some(code - 87)
    } else if code >= 65 && code <= 70 {
        Some(code - 55)
    } else {
        None
    }
}

-- -- strings and characters ----------------------------------------------------------

fun lexString(lx : Lexer, start : Span) -> Token {
    bump(lx)
    let b = String.builder()
    loop {
        match peek(lx) {
            None -> { oops(lx, "unterminated string literal", start) }
            Some(c) -> {
                if c == '\n' { oops(lx, "newline in string literal", start) }
                if c == '"' {
                    bump(lx)
                    break
                }
                if c == '\\' {
                    String.push(b, Char.toString(lexEscape(lx)))
                } else {
                    String.push(b, Char.toString(c))
                    bump(lx)
                }
            }
        }
    }
    plain(KString, VText(String.build(b)), start)
}

fun lexChar(lx : Lexer, start : Span) -> Token {
    bump(lx)
    var value = '?'
    match peek(lx) {
        None -> { oops(lx, "unterminated character literal", start) }
        Some(c) -> {
            if c == '\\' {
                value = lexEscape(lx)
            } else {
                value = c
                bump(lx)
            }
        }
    }
    if !charIs(peek(lx), '\'') {
        oops(lx, "character literal must contain exactly one character", start)
    }
    bump(lx)
    plain(KChar, VChar(value), start)
}

-- One escape, as a single Unicode scalar value.
--
-- `\u{H...H}` takes one to six hex digits: four cannot reach past the BMP, so
-- `"\u{1F600}"` would otherwise be unwritable. There is no `\xNN`, and an
-- escape may not name a surrogate -- together those two rules are what make "a
-- string literal is well-formed UTF-8" true by construction.
fun lexEscape(lx : Lexer) -> Char {
    let start = here(lx)
    bump(lx)
    var c = '?'
    match peek(lx) {
        None -> { oops(lx, "unterminated escape sequence", start) }
        Some(found) -> { c = found }
    }
    bump(lx)
    match c {
        'u' -> lexUnicodeEscape(lx, start)
        'n' -> '\n'
        't' -> '\t'
        'r' -> '\r'
        '0' -> '\0'
        '\\' -> '\\'
        '"' -> '"'
        '\'' -> '\''
        _ -> oops(lx, "unknown escape sequence '\\" + Char.toString(c) + "'", start)
    }
}

let malformedUnicodeEscape =
    "\\u escape must be written \\u{...}, with one to six hex digits in the braces"

fun lexUnicodeEscape(lx : Lexer, start : Span) -> Char {
    if !charIs(peek(lx), '{') { oops(lx, malformedUnicodeEscape, start) }
    bump(lx)
    let from = lx.at
    var count = 0
    while isDigitIn(peek(lx), 16) {
        bump(lx)
        count = count + 1
    }
    if count < 1 || count > 6 || !charIs(peek(lx), '}') {
        oops(lx, malformedUnicodeEscape, start)
    }
    let digits = String.slice(lx.src, from, lx.at)
    bump(lx)
    let code = Option.expect(valueIn(digits, 16), "six hex digits fit an Int")
    match Char.fromInt(code) {
        Some(c) -> c
        None -> oops(lx, "\\u{" + digits + "} is not a Unicode scalar value: "
                         + notScalarBecause(code), start)
    }
}

fun notScalarBecause(code : Int) -> String =
    if code <= 0xDFFF {
        "the surrogates D800..DFFF are not characters, and a string may not contain one"
    } else {
        "values above 10FFFF are not characters, and a string may not contain one"
    }

-- -- words and operators --------------------------------------------------------------

fun lexWord(lx : Lexer, start : Span) -> Token {
    let from = lx.at
    loop {
        match peek(lx) {
            None -> { break }
            Some(c) -> {
                if Char.isAsciiAlphanumeric(c) || c == '_' || c == '\'' {
                    bump(lx)
                } else {
                    break
                }
            }
        }
    }
    let text = String.slice(lx.src, from, lx.at)
    if Array.contains(keywords, text) {
        plain(KWord(text), VText(text), start)
    } else if startsUpper(text) {
        -- The leading character decides: `_` and lowercase are variables,
        -- uppercase are type and value constructors.
        plain(KConid, VText(text), start)
    } else {
        plain(KIdent, VText(text), start)
    }
}

fun startsUpper(text : String) -> Bool =
    match String.decode(text, String.start(text)) {
        None -> False
        Some(c) -> Char.isAsciiUpper(c)
    }

fun lexOperator(lx : Lexer, start : Span, c : Char) -> Token {
    for op in operators {
        if matchesAt(lx.src, lx.at, op) {
            bumpBy(lx, String.codePointCount(op))
            return plain(KOp(op), VText(op), start)
        }
    }
    oops(lx, "unexpected character '" + Char.toString(c) + "'", start)
}

-- -- pass two: the newline rule ----------------------------------------------------
--
-- A newline survives iff the token before it can end a production and the one
-- after it can start a sibling. A newline from `;` always survives.
--
-- Bracket nesting is a *stack* and not a counter, because `(` and `{` disagree
-- about whether a line break matters and either can contain the other. Inside
-- `(` or `[` a break is wrapping, so it goes; inside `{` it separates block
-- statements and match arms, so it stays. Only the innermost bracket decides --
-- otherwise the `{ }` in `f(match x { ... })` would inherit the call's
-- suppression and its arms would run together.

fun applyNewlineRule(tokens : Vec Token) -> Vec Token {
    let out = Vec.new(len(tokens))
    let stack = Vec.new(8)
    var i = 0
    while i < len(tokens) {
        let tok = tokens[i]
        match tok.kind {
            KNewline -> {
                -- Collapse a run of blank lines into one decision.
                var runEnd = i
                var forced = False
                while runEnd < len(tokens) {
                    match tokens[runEnd].kind {
                        KNewline -> {
                            forced = forced || tokens[runEnd].forced
                            runEnd = runEnd + 1
                        }
                        _ -> { break }
                    }
                }
                if keepNewline(out, tokens, runEnd, forced, stack) {
                    Vec.push(out, Token {
                        kind = KNewline,
                        value = tokens[i].value,
                        span = tokens[i].span,
                        forced = forced,
                    })
                }
                i = runEnd
            }
            _ -> {
                if isOpen(tok.kind) {
                    Vec.push(stack, tok.kind)
                } else if isClose(tok.kind) && len(stack) > 0 {
                    let _ = Vec.pop(stack)
                }
                Vec.push(out, tok)
                i = i + 1
            }
        }
    }
    out
}

fun keepNewline(out : Vec Token, tokens : Vec Token, runEnd : Int,
                forced : Bool, stack : Vec Kind) -> Bool {
    -- Never lead or trail the stream with a separator.
    match Vec.last(out) {
        None -> { return False }
        Some(_) -> {}
    }
    match Vec.at(tokens, runEnd) {
        None -> False
        Some(after) -> keepBefore(Vec.last(out), after, forced, stack)
    }
}

fun keepBefore(prev : Option Token, after : Token, forced : Bool,
               stack : Vec Kind) -> Bool {
    match after.kind {
        KEof -> { return False }
        _ -> {}
    }
    if forced { return True }
    match Vec.last(stack) {
        None -> {}
        Some(open) -> {
            if isOp(open, "(") || isOp(open, "[") { return False }
        }
    }
    match prev {
        None -> False
        Some(before) -> canEnd(before.kind) && canStart(after.kind)
    }
}

fun isOpen(k : Kind) -> Bool = isOp(k, "(") || isOp(k, "[") || isOp(k, "{")

fun isClose(k : Kind) -> Bool = isOp(k, ")") || isOp(k, "]") || isOp(k, "}")

fun isLiteral(k : Kind) -> Bool = match k {
    KInt -> True
    KFloat -> True
    KString -> True
    KChar -> True
    _ -> False
}

-- The preceding condition of the newline rule: tokens that can legally end a
-- production. `break`, `continue` and bare `return` are here because a
-- statement ending in one still has to be terminable by a newline, and `?`
-- because it is a *postfix* operator -- `let x = f()?` is a complete statement
-- whose last token is the `?`.
fun canEnd(k : Kind) -> Bool {
    if isLiteral(k) { return True }
    match k {
        KIdent -> True
        KConid -> True
        KWord(word) -> match word {
            "break" | "continue" | "return" -> True
            _ -> False
        }
        KOp(op) -> match op {
            ")" | "]" | "}" | "?" -> True
            _ -> False
        }
        _ -> False
    }
}

-- The following condition of the newline rule: tokens that can legally start a
-- sibling production. `else` and `|` are deliberately absent. That is what lets
-- `} else` stay one expression, and what lets a match arm's alternative
-- patterns be split across lines -- the newline before the `|` disappears.
fun canStart(k : Kind) -> Bool {
    if isLiteral(k) { return True }
    match k {
        KIdent -> True
        KConid -> True
        KWord(word) -> Array.contains(starters, word)
        KOp(op) -> match op {
            -- `..`, so a record pattern's rest can sit on its own line. `\`
            -- is only ever prefix, so a line may begin with one -- a block
            -- whose value is a `\` function ends in exactly that line.
            "(" | "[" | "{" | "-" | "!" | ".." | "\\" -> True
            _ -> False
        }
        _ -> False
    }
}

fun tokenize(source : Source) -> Vec Token = applyNewlineRule(tokenizeRaw(source))
