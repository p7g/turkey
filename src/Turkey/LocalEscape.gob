export (analyze)

-- Non-escaping references and records can become local SSA values. The
-- answer is by binder id. A binding copied by `Turkey.Layout` binds one id in
-- each copy, and the answer is conservative across them: if one escapes,
-- every copy keeps heap identity. Any mention inside a closure keeps heap
-- identity.
--
-- A mention is charged to the binder with its id. No binder is bound inside
-- the scope of another with its id, so that is the binder it means, and the
-- scan needs no scope. A mention of a binder that is neither a reference nor
-- a record -- a parameter, a pattern variable, a top-level binding -- is
-- charged to an id that is never a candidate.
import Data.Set as Set
import Turkey.Core as Core
import Turkey.Core (Core(..), CoreKind(..), Mapper(..))
import Turkey.Decls as Decls
import Turkey.Decls (DeclTable)
import Turkey.Types as Ty

type Scan = Scan {
    decls : DeclTable,
    refs : Set.Set Int,
    records : Set.Set Int,
    escapedRefs : Set.Set Int,
    escapedRecords : Set.Set Int,
}

-- Returns the ids of the `let`s of `body` whose reference cell, and of those
-- whose record or dictionary, nothing lets escape.
fun analyze(decls : DeclTable, body : Core) -> (Set.Set Int, Set.Set Int) {
    let s = Scan { decls = decls, refs = Set.new(), records = Set.new(),
                   escapedRefs = Set.new(), escapedRecords = Set.new() }
    walk(s, body, False)
    let refs = Set.new()
    let records = Set.new()
    for id in s.refs {
        if !Set.contains(s.escapedRefs, id) { Set.add(refs, id) }
    }
    for id in s.records {
        if !Set.contains(s.escapedRecords, id) { Set.add(records, id) }
    }
    (refs, records)
}

-- A mention of `id` that is not one of the uses a local keeps: what it
-- refers to escapes, if it is a reference or a record at all.
fun escapes(s : Scan, id : Int, refs : Bool, records : Bool) -> Unit {
    if refs { Set.add(s.escapedRefs, id) }
    if records { Set.add(s.escapedRecords, id) }
}

-- A field of `target` read or written where `target` is a variable: the one
-- use a local record keeps, outside a closure. Whether that was the case.
fun fieldOf(s : Scan, target : Core, closed : Bool) -> Bool = match target.kind {
    CVar(_, id) -> {
        escapes(s, id, True, closed)
        True
    }
    _ -> False
}

-- A `let` of a record: a candidate, unless it is already seen to escape, or
-- its id is bound twice, in two copies.
fun record(s : Scan, id : Int, closed : Bool, binders : Vec Ty.VarCell) -> Unit {
    if closed || len(binders) > 0 || Set.contains(s.records, id) {
        Set.add(s.escapedRecords, id)
    }
    Set.add(s.records, id)
}

fun walk(s : Scan, e : Core, closed : Bool) -> Unit {
    match e.kind {
        CLet(_, id, _, bound, body, binders) -> {
            match bound.kind {
                CRef(_) -> {
                    if closed || len(binders) > 0 { Set.add(s.escapedRefs, id) }
                    Set.add(s.refs, id)
                }
                CDict(_, _) -> record(s, id, closed, binders)
                CApp(fn, _) -> match fn.kind {
                    CCon(con) -> if Decls.isRecordCon(s.decls, con) {
                        record(s, id, closed, binders)
                    }
                    _ -> {}
                }
                _ -> {}
            }
            walk(s, bound, closed)
            walk(s, body, closed)
            return
        }
        CLam(_, body, _) -> {
            walk(s, body, True)
            return
        }
        CVar(_, id) -> {
            escapes(s, id, True, True)
            return
        }
        CDeref(target) -> match target.kind {
            CVar(_, id) -> {
                escapes(s, id, closed, True)
                return
            }
            _ -> {}
        }
        CAssign(target, assigned) -> match target.kind {
            CVar(_, id) -> {
                escapes(s, id, closed, True)
                walk(s, assigned, closed)
                return
            }
            _ -> {}
        }
        CSlot(target, _) -> if fieldOf(s, target, closed) { return }
        CProject(target, _) -> if fieldOf(s, target, closed) { return }
        _ -> {}
    }
    let _ = Core.mapKind(e.kind, Mapper {
        expr = fun(x) = { walk(s, x, closed); x },
        type_ = fun(t) = t,
        bind = fun(b) = { walk(s, Core.bindValue(b), closed); b },
    })
}
