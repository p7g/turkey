module Turkey.LowIr (
    BinOp(..), CmpOp(..), Conv(..), Callee(..), Op(..), Low(..), AddressOf(..),
    low, effectsOf, opUses, mapUses, opResultRep, checkReps, checkCalls, showOpName,
    Allocation(..), summarize, allocatingOp,
    Builder(..), builder, into, emit, effect, terminate, block, param,
)

-- The virtual instruction set: what `Turkey.Ssa`'s graph is instantiated with
-- before instruction selection.
--
-- Three decisions, and the first is what the instruction type is parameterized
-- for.
--
-- **Operands live in the opcode.** `Bin(Add, x, y)` rather than an opcode and
-- a separate operand list. LLVM and Cranelift keep operands beside the opcode
-- because walking a per-variant operand list uniformly is awkward in C++ and
-- Rust; a `match` makes it natural here, and the arity of every instruction
-- becomes a fact the *type checker* enforces. A verifier that would otherwise
-- have to check "does this opcode have the right number of operands" has
-- nothing left to check, which is a whole class of malformed IR that cannot be
-- built.
--
-- **An opcode is a constructor where a pass must match on it, and a symbol is
-- a string where none does.** Arithmetic, comparison and the heap operations
-- are constructors, because instruction selection is a match over them and
-- must be exhaustive. A call to a runtime function is opaque -- no pass asks
-- *which* runtime function, only that it is one -- so the symbol is a string
-- and the instruction set does not grow a constructor per primitive. That is
-- the line, and it is what keeps this set at two dozen rather than the
-- hundreds Go's `Op` has.
--
-- **The level is the runtime's ABI.** `ObjectGet(p, 3)` and not an address
-- computation, because that is one-to-one with what `turkey_runtime.h`
-- provides and with what the collector understands; the offsets are described
-- by an object's metadata and are not the IR's to invent. Going lower would
-- expose arithmetic no optimization here needs and would put the heap layout
-- in two places. Instruction selection expands these; that is its job.

import Data.Map as Map
import Turkey.Source (Span)
import Turkey.Ssa as Ssa
import Turkey.Ssa (Value(..), BlockId(..), Rep(..), RepClass(..),
                   Effects(..), Inst(..), Term(..), Block(..), Func(..))

-- `AddWrap`, `SubWrap` and `MulWrap` are the same machine instruction as
-- `Add`, `Sub` and `Mul` and a different *opcode*, because what differs is
-- whether overflow panics -- `Prim.intAdd` traps and `Prim.intAddWrapping`
-- does not. Encoding that as a flag on `Bin` would make
-- it something a pass can forget to read; as a constructor, a pass that has
-- not been taught the difference fails to compile.
--
-- It also makes `effectsOf` truthful, which is what an optimizer will read: a
-- wrapping add is pure and deletable when unused, and a checked one is not.
type BinOp = Add | Sub | Mul | Div | Rem | And | Or | Xor | Shl | Shr | ShrU
           | AddWrap | SubWrap | MulWrap

-- Signed comparison. `Ne`, `Le` and `Gt` are here rather than desugared to a
-- negation because a machine has them and instruction selection would only
-- have to put them back.
type CmpOp = Eq | Ne | Lt | Le | Gt | Ge

type Conv
    = IntToFloat | FloatToInt
    -- Between integer widths. The target width is the result's `Rep`, so the
    -- constructor only has to say whether the value is sign-extended.
    | Widen | Narrow
    -- Between `ptr` and `ptr*`: the same machine value with a different
    -- obligation on the collector. A no-op at run time, and not a no-op to the
    -- verifier, which is the point of `Rep` carrying both facts.
    | Retag
    -- Between an untraced `ptr` and `i64`. Also the same machine value, and
    -- also not a no-op to the verifier -- but for the other reason: an
    -- address and an integer are the same bits at different *classes*, where
    -- `Retag` is one class at two trace bits. Pointer arithmetic is the only
    -- producer, and it is the pair rather than arithmetic-on-pointers because
    -- `Bin` requires both operands at one representation.
    | PtrToInt | IntToPtr

type Callee
    -- A Turkey function, by its mangled symbol.
    = Direct(String)
    -- A runtime entry point. Opaque: nothing matches on which one.
    | Runtime(String)
    -- A C symbol a `foreign` declaration named. Separate from
    -- `Runtime` because the two are resolved differently: a runtime entry
    -- point is looked up in `Turkey.Runtime`'s fixed table, and this one is
    -- already the symbol -- what the program declared is what the linker is
    -- asked for. No signature travels with it: every argument carries a `Rep`
    -- and the result carries the destination's, so the one consumer that needs
    -- a full signature -- LLVM's `declare` line -- reads it off a call site.
    | Foreign(String)
    -- Through a closure value.
    | Indirect(Value)

-- An address the linker or the machine decides, for giblet code that cannot
-- hold what it stands for (SPEC-DELTAS 74). Each is an untraced `Ptr`.
type AddressOf
    -- A literal's bytes, NUL-terminated, in read-only data: `Prim.cString`.
    = CBytes(String)
    -- A `foreign` definition's C symbol: `Prim.codeAddress`.
    | CodeOf(String)
    -- This function's frame pointer: `Prim.frameAddress`.
    | ThisFrame

type Op
    = ConstInt(Int)
    | ConstFloat(Float)
    | ConstString(String)
    | ConstUnit
    | Address(AddressOf)
    | Bin(BinOp, Value, Value)
    | Cmp(CmpOp, Value, Value)
    | Neg(Value)
    | Not(Value)
    | Convert(Conv, Value)
    -- The uniform representation, for a value whose type is a variable.
    | Box(Value)
    | Unbox(Value)
    -- A heap object: `kind` and `tag` as the runtime understands them,
    -- `count` fields, and the field metadata -- three bits of representation
    -- per field, which is what the collector scans by and what says how wide
    -- each field is. See `Turkey.SsaLower.metadata`.
    | ObjectNew(Int, Int, Int, Int)
    | ObjectGet(Value, Int)
    | ObjectSet(Value, Int, Value)
    | ObjectTag(Value)
    -- Length, initial element, and the element's representation. The class
    -- decides the stride -- `Array Byte` is packed because of this and not by
    -- name -- and the trace bit decides whether the collector walks the
    -- elements. A `RepClass` here was enough only while every `Ptr` was
    -- traced: it made `Array Ptr` and `Array String` the same array to the
    -- collector.
    | ArrayNew(Value, Value, Rep)
    | ArrayGet(Value, Value)
    | ArraySet(Value, Value, Value)
    | ArrayLength(Value)
    -- Raw memory: base, a *byte* offset, and the class to access at.
    --
    -- Instructions and not runtime calls, which is the whole point. A `Call`
    -- is `everything()` below and a safepoint in `Turkey.Roots`, so a load
    -- routed through one would store every live root before every read of a
    -- struct field -- and could never appear in a giblet, which is the
    -- subset the collector itself is written in.
    --
    -- Byte offsets rather than element-scaled, so that one rule covers these
    -- and `ptrAdd`, and because arm64's `Indexed` addressing is unscaled --
    -- `ArrayGet` has to emit an `Lsl` first and these do not.
    | PtrLoad(Value, Value, RepClass)
    | PtrStore(Value, Value, Value, RepClass)
    -- A `var`'s cell.
    | CellNew(Value)
    | CellLoad(Value)
    | CellStore(Value, Value)
    -- A single closure shell over `code`. The capture count distinguishes
    -- capture-free closures that LLVM interns. Its environment is allocated
    -- separately and installed with ObjectSet, so it is an ordinary SSA root
    -- across the shell allocation. The shell traces only its second slot.
    | ClosureNew(String, Int)
    | ClosureCapture(Value, Int, Value)
    | Call(Callee, Array Value)
    | GlobalLoad(String)
    | GlobalStore(String, Value)
    -- A mutable local. With function-wide SSA these are only what is genuinely
    -- mutable, not everything that crosses an edge.
    | SlotLoad(Int)
    | SlotStore(Int, Value)

-- An instruction is an operation and the value it defines.
--
-- Every instruction defines exactly one value, and an effectful one defines a
-- `unit`. Uniform is cheaper than an `Option` here in both senses: no
-- allocation to ask what an instruction defines, and no case to forget.
type Low = Low {
    result : Value,
    op     : Op,
}

fun low(result : Value, op : Op) -> Low = Low { result = result, op = op }

-- -- building ------------------------------------------------------------------------

-- A cursor into one block of one function.
--
-- The side table `Ssa.Func` keeps -- a value's representation, indexed by its
-- id -- is not optional, and this is what makes it invisible. A value cannot
-- be made without being given a representation, and there is no way to append
-- an instruction that does not go through here, so the table cannot fall out
-- of step with the instructions.
--
-- The alternative is a self-describing value, `Value { id, rep }`, which is
-- what LLVM and Go have -- and both can, because a value there is a *pointer*
-- to one shared object. Turkey records have reference semantics and no
-- identity, so a value carrying its own representation would be
-- *copied* at every mention, and two mentions of one value would be two
-- records that agree only by convention. That is an inconsistent state made
-- representable, to avoid a table. It would also cost: `Value` is a newtype
-- and erases to a machine word, so `uses` answers a packed array of integers
-- rather than an array of pointers, in the hottest query a backend has.
--
-- Cranelift reaches the same shape from the same constraint: a `Value` is an
-- index and `DataFlowGraph::value_type` is the lookup.
type Builder = Builder {
    func : Ssa.Func Low,
    at   : Ssa.BlockId,
    -- The source construct being lowered, which the lowering keeps current;
    -- recorded against every instruction that may allocate, and every string
    -- literal, since those are what the giblets check names (`Func.origins`).
    span : Option Span,
}

fun builder(f : Ssa.Func Low, at : Ssa.BlockId) -> Builder =
    Builder { func = f, at = at, span = None }

fun isConstString(op : Op) -> Bool = match op {
    ConstString(_) -> True
    _ -> False
}

-- Move the cursor. Blocks are built in whatever order the lowering finds
-- them, so this is ordinary rather than exceptional.
fun into(b : Builder, at : Ssa.BlockId) -> Unit { b.at = at }

-- Append an operation and answer the value it defines.
--
-- The representation is given rather than derived, because for `ObjectGet`,
-- `ArrayGet`, `Call`, `SlotLoad` and `Unbox` only the caller knows it. Where
-- the opcode *does* determine it, `checkReps` says so afterwards -- which is
-- the right division: the builder is for convenience and the verifier is for
-- truth, and a builder that panicked here would be a second opinion about
-- what an opcode means.
fun emit(b : Builder, op : Op, r : Rep) -> Value {
    let v = Ssa.freshValue(b.func, r)
    Array.push(Ssa.blockAt(b.func, b.at).insts, low(v, op))
    if effectsOf(op).allocates || isConstString(op) {
        match b.span {
            Some(s) -> Map.put(b.func.origins, Ssa.valueId(v), s)
            None -> {}
        }
    }
    v
}

-- An operation evaluated for its effect. The value it defines is a `unit`
-- nothing reads, which is what keeps every instruction defining exactly one.
fun effect(b : Builder, op : Op) -> Unit {
    let _ = emit(b, op, Ssa.untraced(Unit))
}

fun terminate(b : Builder, t : Ssa.Term) -> Unit {
    Ssa.blockAt(b.func, b.at).term = t
}

-- A new empty block, and its id.
fun block(b : Builder) -> Ssa.BlockId {
    let id = len(b.func.blocks)
    Array.push(b.func.blocks, Ssa.newBlock())
    Ssa.BlockId(id)
}

-- A parameter of a block, which is where a phi would be.
fun param(b : Builder, at : Ssa.BlockId, r : Rep) -> Value {
    let v = Ssa.freshValue(b.func, r)
    Array.push(Ssa.blockAt(b.func, at).params, v)
    v
}

-- What each operation may do. The verifier does not read this; the
-- optimizations and, eventually, the register allocator's stack maps do.
fun effectsOf(op : Op) -> Effects = match op {
    ConstInt(_) -> empty()
    ConstFloat(_) -> empty()
    -- A string literal is interned by the runtime rather than allocated per
    -- evaluation, so it is not a safepoint.
    ConstString(_) -> empty()
    ConstUnit -> empty()
    Address(_) -> empty()
    -- Trapping, not pure: `add`, `sub`, `mul` and `neg` panic on overflow and
    -- `div` and `rem` panic at zero, so an unused one may
    -- not be deleted. The bitwise and shift operations do not trap, and
    -- saying so is what lets dead code among them go.
    Bin(o, _, _) -> match o {
        Add -> Ssa.traps()
        Sub -> Ssa.traps()
        Mul -> Ssa.traps()
        Div -> Ssa.traps()
        Rem -> Ssa.traps()
        _ -> empty()
    }
    Cmp(_, _, _) -> empty()
    Neg(_) -> Ssa.traps()
    Not(_) -> empty()
    Convert(_, _) -> empty()
    Box(_) -> Ssa.allocates()
    Unbox(_) -> Ssa.reads_()
    ObjectNew(_, _, _, _) -> Ssa.allocates()
    ObjectGet(_, _) -> Ssa.reads_()
    ObjectSet(_, _, _) -> Ssa.writes()
    ObjectTag(_) -> Ssa.reads_()
    ArrayNew(_, _, _) -> Ssa.allocates()
    -- Reads *and* traps: an index out of range panics.
    ArrayGet(_, _) -> combine(Ssa.reads_(), Ssa.traps())
    ArraySet(_, _, _) -> combine(Ssa.writes(), Ssa.traps())
    ArrayLength(_) -> Ssa.reads_()
    -- Reads and writes, and deliberately *not* `traps`. An access off the end
    -- of a block is undefined and not checked, so claiming it can trap would
    -- make a dead load undeletable to buy a guarantee that is not being made.
    PtrLoad(_, _, _) -> Ssa.reads_()
    PtrStore(_, _, _, _) -> Ssa.writes()
    CellNew(_) -> Ssa.allocates()
    CellLoad(_) -> Ssa.reads_()
    CellStore(_, _) -> Ssa.writes()
    -- Only the shell allocates here. Its environment is a separate value
    -- whose later use keeps it rooted across this safepoint.
    ClosureNew(_, _) -> Ssa.allocates()
    ClosureCapture(_, _, _) -> Ssa.writes()
    -- A call may do anything the callee does, which is everything. Knowing
    -- better per callee takes the whole program, which one instruction does
    -- not have; `summarize` below is that, for allocation, over the module.
    Call(_, _) -> everything()
    GlobalLoad(_) -> Ssa.reads_()
    GlobalStore(_, _) -> Ssa.writes()
    SlotLoad(_) -> Ssa.reads_()
    SlotStore(_, _) -> Ssa.writes()
}

fun everything() -> Effects = Effects {
    reads = True, writes = True, allocates = True, traps = True,
    diverges = False,
}

-- The values an operation reads.
--
-- One `match`, and adding an operation is a compile error here -- which is
-- the whole reason the opcode is a constructor and not a string.
fun opUses(op : Op) -> Array Value = match op {
    ConstInt(_) -> []
    ConstFloat(_) -> []
    ConstString(_) -> []
    ConstUnit -> []
    Address(_) -> []
    Bin(_, a, b) -> [a, b]
    Cmp(_, a, b) -> [a, b]
    Neg(a) -> [a]
    Not(a) -> [a]
    Convert(_, a) -> [a]
    Box(a) -> [a]
    Unbox(a) -> [a]
    ObjectNew(_, _, _, _) -> []
    ObjectGet(a, _) -> [a]
    ObjectSet(a, _, b) -> [a, b]
    ObjectTag(a) -> [a]
    ArrayNew(a, b, _) -> [a, b]
    PtrLoad(a, b, _) -> [a, b]
    PtrStore(a, b, c, _) -> [a, b, c]
    ArrayGet(a, b) -> [a, b]
    ArraySet(a, b, c) -> [a, b, c]
    ArrayLength(a) -> [a]
    CellNew(a) -> [a]
    CellLoad(a) -> [a]
    CellStore(a, b) -> [a, b]
    ClosureNew(_, _) -> []
    ClosureCapture(a, _, b) -> [a, b]
    Call(callee, args) -> {
        let out : Array Value = []
        match callee {
            Indirect(f) -> Array.push(out, f)
            _ -> {}
        }
        for a in args { Array.push(out, a) }
        out
    }
    GlobalLoad(_) -> []
    GlobalStore(_, a) -> [a]
    SlotLoad(_) -> []
    SlotStore(_, a) -> [a]
}

-- Rewrite operands without changing the instruction or its result.
fun mapUses(op : Op, f : fun(Value) -> Value) -> Op = match op {
    ConstInt(a) -> ConstInt(a)
    ConstFloat(a) -> ConstFloat(a)
    ConstString(a) -> ConstString(a)
    ConstUnit -> ConstUnit
    Address(a) -> Address(a)
    Bin(a, b, c) -> Bin(a, f(b), f(c))
    Cmp(a, b, c) -> Cmp(a, f(b), f(c))
    Neg(a) -> Neg(f(a))
    Not(a) -> Not(f(a))
    Convert(a, b) -> Convert(a, f(b))
    Box(a) -> Box(f(a))
    Unbox(a) -> Unbox(f(a))
    ObjectNew(a, b, c, d) -> ObjectNew(a, b, c, d)
    ObjectGet(a, b) -> ObjectGet(f(a), b)
    ObjectSet(a, b, c) -> ObjectSet(f(a), b, f(c))
    ObjectTag(a) -> ObjectTag(f(a))
    ArrayNew(a, b, c) -> ArrayNew(f(a), f(b), c)
    PtrLoad(a, b, c) -> PtrLoad(f(a), f(b), c)
    PtrStore(a, b, c, d) -> PtrStore(f(a), f(b), f(c), d)
    ArrayGet(a, b) -> ArrayGet(f(a), f(b))
    ArraySet(a, b, c) -> ArraySet(f(a), f(b), f(c))
    ArrayLength(a) -> ArrayLength(f(a))
    CellNew(a) -> CellNew(f(a))
    CellLoad(a) -> CellLoad(f(a))
    CellStore(a, b) -> CellStore(f(a), f(b))
    ClosureNew(a, b) -> ClosureNew(a, b)
    ClosureCapture(a, b, c) -> ClosureCapture(f(a), b, f(c))
    Call(a, b) -> Call(mapCallee(a, f), Array.map(b, f))
    GlobalLoad(a) -> GlobalLoad(a)
    GlobalStore(a, b) -> GlobalStore(a, f(b))
    SlotLoad(a) -> SlotLoad(a)
    SlotStore(a, b) -> SlotStore(a, f(b))
}

fun mapCallee(c : Callee, f : fun(Value) -> Value) -> Callee = match c {
    Indirect(v) -> Indirect(f(v))
    _ -> c
}

instance Inst Low {
    fun uses(i) = opUses(i.op)
    fun defs(i) = [i.result]
    fun effects(i) = effectsOf(i.op)
}

-- The representation an operation's result must have, where the operation
-- decides it. `None` means the operation is representation-polymorphic and the
-- result's declared representation stands: `ObjectGet` answers whatever the
-- field holds, and only the object's own layout knows that.
--
-- Arity is not checked here and cannot be: it is enforced by the constructor.
fun opResultRep(op : Op) -> Option Rep = match op {
    ConstFloat(_) -> Some(Ssa.untraced(F64))
    ConstString(_) -> Some(Ssa.traced(Ptr))
    ConstUnit -> Some(Ssa.untraced(Unit))
    Address(_) -> Some(Ssa.untraced(Ptr))
    Cmp(_, _, _) -> Some(Ssa.untraced(I1))
    Box(_) -> Some(Ssa.traced(Ptr))
    ObjectNew(_, _, _, _) -> Some(Ssa.traced(Ptr))
    ObjectTag(_) -> Some(Ssa.untraced(I32))
    ArrayNew(_, _, _) -> Some(Ssa.traced(Ptr))
    -- Untraced is not a default here. A pointer read out of raw memory is an
    -- address with no header, so answering `traced` would hand the collector
    -- one to follow.
    PtrLoad(_, _, c) -> Some(Ssa.untraced(c))
    PtrStore(_, _, _, _) -> Some(Ssa.untraced(Unit))
    ArrayLength(_) -> Some(Ssa.untraced(I64))
    CellNew(_) -> Some(Ssa.traced(Ptr))
    ClosureNew(_, _) -> Some(Ssa.traced(Ptr))
    ObjectSet(_, _, _) -> Some(Ssa.untraced(Unit))
    ArraySet(_, _, _) -> Some(Ssa.untraced(Unit))
    CellStore(_, _) -> Some(Ssa.untraced(Unit))
    ClosureCapture(_, _, _) -> Some(Ssa.untraced(Unit))
    GlobalStore(_, _) -> Some(Ssa.untraced(Unit))
    SlotStore(_, _) -> Some(Ssa.untraced(Unit))
    _ -> None
}

-- The representation checks the constructor cannot make.
--
-- Answers complaints rather than failing, the way `Ssa.verify` does, and is
-- meant to be composed with it: the generic verifier owns dominance and the
-- shape of the graph, and this owns what an operation requires of its
-- operands. Keeping them apart is what stops the generic layer from
-- accumulating target knowledge.
fun checkReps(f : Ssa.Func Low, i : Low) -> Array String {
    let out = []
    match opResultRep(i.op) {
        Some(want) -> if Ssa.repOf(f, i.result) != want {
            Array.push(out, "result is " + show(Ssa.repOf(f, i.result))
                            + " where " + show(want) + " was required")
        }
        None -> {}
    }
    match i.op {
        Bin(_, a, b) -> sameRep(f, out, a, b, "the operands of a binary operation")
        Cmp(_, a, b) -> sameRep(f, out, a, b, "the operands of a comparison")
        Not(a) -> wantClass(f, out, a, I1, "the operand of a logical not")
        ArrayGet(_, index) -> wantClass(f, out, index, I64, "an array index")
        ArraySet(_, index, _) -> wantClass(f, out, index, I64, "an array index")
        ArrayNew(length, _, _) -> wantClass(f, out, length, I64, "an array length")
        Unbox(a) -> wantClass(f, out, a, Ptr, "the operand of an unbox")
        -- A machine has no integer constant of floating type, so an integer
        -- literal at `f64` has to have become a float before it gets here.
        ConstInt(_) -> if Ssa.repOf(f, i.result).class_ == F64 {
            Array.push(out, "an integer constant is held at f64")
        }
        ClosureCapture(c, _, _) ->
            wantClass(f, out, c, Ptr, "the target of a closure capture")
        -- An address and an integer are the same bits, so nothing at run time
        -- distinguishes a wrong pairing here. And a *traced* pointer turned
        -- into an integer is a root the collector stops seeing, so the trace
        -- bit is checked and not only the class.
        -- The safety property of raw memory, and it is statically checkable
        -- right here: a *traced* pointer may not be stored through one. The
        -- block has no header and is not scanned, so the collector would
        -- never see the reference and would free what it points at.
        PtrStore(base, off, stored, c) -> {
            wantClass(f, out, base, Ptr, "the base of a raw store")
            wantClass(f, out, off, I64, "a raw offset")
            wantClass(f, out, stored, c, "the value of a raw store")
            if Ssa.repOf(f, stored).traced {
                Array.push(out, "a traced pointer is stored through a raw pointer")
            }
        }
        PtrLoad(base, off, _) -> {
            wantClass(f, out, base, Ptr, "the base of a raw load")
            wantClass(f, out, off, I64, "a raw offset")
        }
        Convert(PtrToInt, a) -> {
            wantClass(f, out, a, Ptr, "the operand of a pointer-to-integer")
            if Ssa.repOf(f, a).traced {
                Array.push(out, "a traced pointer is converted to an integer")
            }
        }
        Convert(IntToPtr, a) -> {
            wantClass(f, out, a, I64, "the operand of an integer-to-pointer")
            if Ssa.repOf(f, i.result).traced {
                Array.push(out, "an integer is converted to a traced pointer")
            }
        }
        Call(callee, _) -> match callee {
            Indirect(fn) -> wantClass(f, out, fn, Ptr, "an indirect callee")
            _ -> {}
        }
        _ -> {}
    }
    out
}

-- What one function's instructions require of *another* function.
--
-- `Ssa.verify` is per function, and everything closure conversion introduces
-- crosses that boundary: a lifted function taking three parameters and an
-- indirect call passing two are both perfectly well formed graphs, and a
-- `ClosureNew` naming a symbol nobody emitted is invisible. So is a direct
-- call whose arguments disagree with the callee's signature, which is the one
-- thing the signature table exists to prevent and therefore the one thing
-- worth checking rather than trusting.
--
-- Answers complaints rather than failing, the way `Ssa.verify` and
-- `checkReps` do, and is composed with them: that layer owns the shape of one
-- graph, this one owns agreement between graphs.
fun checkCalls(functions : Array (Ssa.Func Low)) -> Array String {
    let out = []
    let known = Map.new()
    for f in functions { Map.put(known, f.name, f) }
    for f in functions {
        for block in f.blocks {
            for i in block.insts {
                match i.op {
                    Call(Direct(name), args) -> match Map.get(known, name) {
                        Some(callee) -> {
                            if len(args) != len(callee.params) {
                                Array.push(out, f.name + ": calls @" + name
                                    + " with " + Int.toString(len(args))
                                    + " arguments where it takes "
                                    + Int.toString(len(callee.params)))
                            } else {
                                for var n = 0; n < len(args); n = n + 1 {
                                    if Ssa.repOf(f, args[n])
                                            != Ssa.repOf(callee,
                                                         callee.params[n]) {
                                        Array.push(out, f.name + ": passes "
                                            + show(Ssa.repOf(f, args[n]))
                                            + " to @" + name + " parameter "
                                            + Int.toString(n) + ", which is "
                                            + show(Ssa.repOf(callee,
                                                   callee.params[n])))
                                    }
                                }
                            }
                            if Ssa.repOf(f, i.result) != callee.result {
                                Array.push(out, f.name + ": reads "
                                    + show(Ssa.repOf(f, i.result))
                                    + " from @" + name + ", which answers "
                                    + show(callee.result))
                            }
                        }
                        None -> Array.push(out, f.name + ": calls @" + name
                                                + ", which is not a function here")
                    }
                    ClosureNew(code, n) -> match Map.get(known, code) {
                        -- A closure's code is called at the uniform
                        -- representation with the environment first, so its
                        -- arity is one more than the lambda's.
                        Some(callee) -> if len(callee.params) < 1 {
                            Array.push(out, f.name + ": closes over @" + code
                                            + ", which takes no environment")
                        }
                        None -> Array.push(out, f.name + ": closes over @"
                                                + code + ", which does not exist")
                    }
                    _ -> {}
                }
            }
        }
    }
    out
}

-- -- which functions may allocate ---------------------------------------------

-- Why a function may allocate: an instruction of its own, or a call to one
-- that may.
type Allocation
    = Allocates(String, Int)
    | CallsAllocating(String, Int)

-- What an instruction allocates by itself, if anything.
--
-- A direct call is left to `summarize`, which knows the callee. The rest of the
-- calls are decided here, each for its own reason:
--
-- * **through a closure or a dictionary**: the target is not known, so it
--   may be anything. A giblet that makes one of these calls is refused, and a
--   method call the optimizer devirtualized is judged on its callee instead;
-- * **foreign**: raw calls introduce no managed values. The allocator giblet's
--   heap-allocation bridge is a trusted exception: it may collect, but its
--   operands and result are untraced. Generated allocation opcodes retain the
--   safepoint and rooting contract around that boundary;
-- * **the runtime**: allocating unless it is on the short list below.
fun allocatingOp(op : Op) -> Option String = match op {
    Call(Direct(_), _) -> None
    Call(Foreign(_), _) -> None
    Call(Indirect(_), _) -> Some("calls through a closure or a dictionary")
    Call(Runtime(name), _) ->
        if nonAllocatingRuntime(name) { None }
        else { Some("calls the runtime's " + name) }
    -- Said the way the source would say it, since the reader of this wrote
    -- source: which construct lowered to the allocation is the question.
    Box(_) -> Some("boxes a value to pass it where the type is not known")
    ObjectNew(_, _, _, _) ->
        Some("builds an object -- a constructor, tuple, record or dictionary")
    ArrayNew(_, _, _) -> Some("builds an array")
    CellNew(_) -> Some("makes a cell for a variable a closure captured")
    ClosureNew(_, _) -> Some("makes a closure")
    _ -> if effectsOf(op).allocates { Some("allocates (" + showOpName(op) + ")") }
         else { None }
}

-- The runtime entry points that make nothing. Listed rather than defaulted:
-- a new entry point is assumed to allocate until someone says otherwise.
fun nonAllocatingRuntime(name : String) -> Bool = name == "Prim.exit"

-- Every function that may allocate, and why; a function not in the answer
-- does not.
--
-- A worklist over the reverse call graph rather than a fixpoint over the
-- whole module: each function that allocates by itself is found once, and the
-- fact runs up the callers from there, so the pass is linear in the module
-- where a naive iteration is linear per round. A call to a function that is
-- not in the module -- one the lowering skipped -- is taken to allocate,
-- because nothing says it does not.
fun summarize(functions : Array (Ssa.Func Low)) -> Map String Allocation {
    let out = Map.new()
    let known = Map.new()
    for f in functions { Map.put(known, f.name, ()) }
    let callers = Map.new()
    let work = []
    for f in functions {
        for block in f.blocks {
            for i in block.insts {
                match i.op {
                    Call(Direct(name), _) -> {
                        if !Map.contains(known, name) {
                            mark(out, work, f.name,
                                 Allocates("calls @" + name + ", which did not lower",
                                           Ssa.valueId(i.result)))
                        }
                        let site = (f.name, Ssa.valueId(i.result))
                        match Map.get(callers, name) {
                            Some(those) -> Array.push(those, site)
                            None -> Map.put(callers, name, [site])
                        }
                    }
                    op -> match allocatingOp(op) {
                        Some(what) -> {
                            let id = Ssa.valueId(i.result)
                            mark(out, work, f.name,
                                 Allocates(Map.getOr(f.reasons, id, what), id))
                        }
                        None -> {}
                    }
                }
            }
        }
    }
    for var k = 0; k < len(work); k = k + 1 {
        match Map.get(callers, work[k]) {
            Some(those) -> for (caller, site) in those {
                mark(out, work, caller, CallsAllocating(work[k], site))
            }
            None -> {}
        }
    }
    out
}

-- The first reason found is the one kept, so the chain a diagnostic prints
-- is a shortest one from the function to an allocation.
fun mark(out : Map String Allocation, work : Array String, name : String,
         why : Allocation) -> Unit {
    if !Map.contains(out, name) {
        Map.put(out, name, why)
        Array.push(work, name)
    }
}

fun sameRep(f : Ssa.Func Low, out : Array String, a : Value, b : Value,
            what : String) -> Unit {
    if Ssa.repOf(f, a) != Ssa.repOf(f, b) {
        Array.push(out, what + " are " + show(Ssa.repOf(f, a)) + " and "
                        + show(Ssa.repOf(f, b)))
    }
}

fun wantClass(f : Ssa.Func Low, out : Array String, v : Value, c : RepClass,
              what : String) -> Unit {
    if Ssa.repOf(f, v).class_ != c {
        Array.push(out, what + " is " + show(Ssa.repOf(f, v)))
    }
}

-- The name of an operation, for reporting what a pass cannot handle yet.
--
-- Not `show`, which prints the operands too and would make a histogram of
-- unhandled opcodes one row per occurrence instead of one row per opcode.
fun showOpName(op : Op) -> String = match op {
    ConstInt(_) -> "const.int"
    ConstFloat(_) -> "const.float"
    ConstString(_) -> "const.string"
    ConstUnit -> "const.unit"
    Address(CBytes(_)) -> "address.cstring"
    Address(CodeOf(_)) -> "address.code"
    Address(ThisFrame) -> "address.frame"
    Bin(o, _, _) -> show(o)
    Cmp(o, _, _) -> show(o)
    Neg(_) -> "neg"
    Not(_) -> "not"
    Convert(c, _) -> show(c)
    Box(_) -> "box"
    Unbox(_) -> "unbox"
    ObjectNew(_, _, _, _) -> "object.new"
    ObjectGet(_, _) -> "object.get"
    ObjectSet(_, _, _) -> "object.set"
    ObjectTag(_) -> "object.tag"
    ArrayNew(_, _, _) -> "array.new"
    PtrLoad(_, _, _) -> "ptr.load"
    PtrStore(_, _, _, _) -> "ptr.store"
    ArrayGet(_, _) -> "array.get"
    ArraySet(_, _, _) -> "array.set"
    ArrayLength(_) -> "array.length"
    CellNew(_) -> "cell.new"
    CellLoad(_) -> "cell.load"
    CellStore(_, _) -> "cell.store"
    ClosureNew(_, _) -> "closure.new"
    ClosureCapture(_, _, _) -> "closure.capture"
    Call(callee, _) -> match callee {
        Direct(_) -> "call.direct"
        Runtime(_) -> "call.runtime"
        Foreign(_) -> "call.foreign"
        Indirect(_) -> "call.indirect"
    }
    GlobalLoad(_) -> "global.load"
    GlobalStore(_, _) -> "global.store"
    SlotLoad(_) -> "slot.load"
    SlotStore(_, _) -> "slot.store"
}

-- -- printing -----------------------------------------------------------------------

instance Show Low {
    fun show(i) = "%" + Int.toString(Ssa.valueId(i.result)) + " = " + show(i.op)
}

fun v(x : Value) -> String = "%" + Int.toString(Ssa.valueId(x))

instance Show Op {
  fun show(op) = match op {
    ConstInt(n) -> "const " + Int.toString(n)
    ConstFloat(x) -> "const " + Float.toString(x)
    ConstString(s) -> "const \"" + s + "\""
    ConstUnit -> "const ()"
    Address(CBytes(s)) -> "address cstring \"" + s + "\""
    Address(CodeOf(s)) -> "address code " + s
    Address(ThisFrame) -> "address frame"
    Bin(o, a, b) -> show(o) + " " + v(a) + ", " + v(b)
    Cmp(o, a, b) -> show(o) + " " + v(a) + ", " + v(b)
    Neg(a) -> "neg " + v(a)
    Not(a) -> "not " + v(a)
    Convert(c, a) -> show(c) + " " + v(a)
    Box(a) -> "box " + v(a)
    Unbox(a) -> "unbox " + v(a)
    ObjectNew(kind, tag, count, bitmap) ->
        "object.new kind=" + Int.toString(kind) + " tag=" + Int.toString(tag)
        + " count=" + Int.toString(count) + " bitmap=" + Int.toString(bitmap)
    ObjectGet(a, i) -> "object.get " + v(a) + ", " + Int.toString(i)
    ObjectSet(a, i, b) -> "object.set " + v(a) + ", " + Int.toString(i) + ", " + v(b)
    ObjectTag(a) -> "object.tag " + v(a)
    ArrayNew(n, init, c) ->
        "array.new " + v(n) + ", " + v(init) + ", " + show(c)
    PtrLoad(a, off, c) ->
        "ptr.load " + v(a) + ", " + v(off) + ", " + show(c)
    PtrStore(a, off, x, c) ->
        "ptr.store " + v(a) + ", " + v(off) + ", " + v(x) + ", " + show(c)
    ArrayGet(a, i) -> "array.get " + v(a) + ", " + v(i)
    ArraySet(a, i, x) -> "array.set " + v(a) + ", " + v(i) + ", " + v(x)
    ArrayLength(a) -> "array.length " + v(a)
    CellNew(a) -> "cell.new " + v(a)
    CellLoad(a) -> "cell.load " + v(a)
    CellStore(a, b) -> "cell.store " + v(a) + ", " + v(b)
    ClosureNew(code, n) ->
        "closure.new @" + code + ", " + Int.toString(n)
    ClosureCapture(a, i, b) ->
        "closure.capture " + v(a) + ", " + Int.toString(i) + ", " + v(b)
    Call(callee, args) -> {
        let b = String.builder()
        String.push(b, "call " + show(callee))
        for a in args { String.push(b, " " + v(a)) }
        String.build(b)
    }
    GlobalLoad(name) -> "global.load $" + name
    GlobalStore(name, a) -> "global.store $" + name + ", " + v(a)
    SlotLoad(i) -> "slot.load " + Int.toString(i)
    SlotStore(i, a) -> "slot.store " + Int.toString(i) + ", " + v(a)
  }
}

instance Show Callee {
  fun show(c) = match c {
    Direct(name) -> "@" + name
    Runtime(name) -> "%" + name
    Foreign(name) -> "&" + name
    Indirect(f) -> v(f)
  }
}

instance Show BinOp {
  fun show(o) = match o {
    Add -> "add"
    Sub -> "sub"
    Mul -> "mul"
    Div -> "div"
    Rem -> "rem"
    And -> "and"
    Or -> "or"
    Xor -> "xor"
    Shl -> "shl"
    Shr -> "shr"
    ShrU -> "shru"
    -- Spelled apart from the checked forms, because a dump that printed them
    -- the same would hide the one difference that matters about them.
    AddWrap -> "add.wrap"
    SubWrap -> "sub.wrap"
    MulWrap -> "mul.wrap"
  }
}

instance Show CmpOp {
  fun show(o) = match o {
    Eq -> "eq"
    Ne -> "ne"
    Lt -> "lt"
    Le -> "le"
    Gt -> "gt"
    Ge -> "ge"
  }
}

instance Show Conv {
  fun show(c) = match c {
    IntToFloat -> "itof"
    FloatToInt -> "ftoi"
    Widen -> "widen"
    Narrow -> "narrow"
    Retag -> "retag"
    PtrToInt -> "ptrtoint"
    IntToPtr -> "inttoptr"
  }
}

