export (Lowerer(..), newLowerer, program)

-- Surface tree plus what solving decided, down to `Turkey.Core`.
--
-- This is the pass that makes the elaboration a *tree*. Everything it needs was
-- already computed and is currently scattered across three side tables and the
-- instance table: which dictionaries an occurrence needs and which types it
-- instantiated its scheme at; the leading dictionary parameters a binding group
-- gained; an instance's methods, superclass evidence and context; and every
-- expression's type. None of that is rediscovered here. What changes is that it
-- stops being an agreement between the elaborator and the evaluator, and becomes
-- syntax that `Turkey.Coretc` can reject.
--
-- ## The three translations that carry the milestone
--
-- **A class becomes a record type.** `class C a` with methods and superclasses
-- gives `%Dict.C a`, with a field per method and a `%super.S` per superclass. It
-- is opaque -- `%` is illegal in an identifier -- and it exists so that a
-- dictionary has a type to be wrong about.
--
-- **An instance becomes a top-level binding** of that type, named
-- `%inst.C.Con`, which is unique because instances are coherent. A derived
-- `Typed` instance whose head is not of kind `*` adds its count of arguments,
-- `%inst.Typed.Either/1`, since `Either a` and `Either a b` are both instances
-- over `Either`. An instance
-- with a context becomes a *function* from dictionaries to a dictionary, which
-- is what `instance [Show a] Show (Array a)` always meant.
--
-- **Evidence becomes a term.** A dictionary in scope is a variable and a chain
-- of superclass projections; an instance's is a variable applied to the evidence
-- for its own context. The evidence language does not survive this pass, which
-- is the point: it was a second, unchecked term language.
--
-- ## What a use site becomes
--
-- A use of a polymorphic name is a type application and then a value
-- application:
--
--     f : forall a. %Dict.Show a -> fun(a) -> String
--     f(x)  ==>  (f[Int])(%d.Show.Int)(x)
--
-- in that order, and the order is not a convention this pass invents -- it is
-- the order the two were abstracted in. A method use is the same with the
-- function reached by projection instead of by name.
--
-- ## Loops and transfers stop existing
--
-- `while`, `loop`, the C-style `for` and `for ... in` are four constructs in the
-- surface language and none in Core, and `return`, `break` and `continue`, which
-- named their target by where they sat, become jumps that name it. Core holds no
-- node for any of the seven, which is what makes a term that names its target by
-- position unrepresentable rather than merely absent.

import Data.Set as Set
import Turkey.Ast (Pred as _, ..)
import Turkey.Ast as Ast
import Turkey.Binders as Binders
import Turkey.Binders (Kind(..), Origin(..))
import Turkey.Classes as Classes
import Turkey.Classes (ClassTable(..), ClassInfo(..), InstInfo(..),
                       InstancePlan(..), MethodInfo(..), MethodImpl(..),
                       Evidence(..), Slot(..))
import Turkey.Constraints as C
import Turkey.Constraints (Env(..), Binding(..))
import Turkey.Core (..)
import Turkey.Core as Cr
import Turkey.Decls as Decls
import Turkey.Decls (DeclTable(..), ConInfo(..))
import Turkey.Diag as Diag
import Turkey.Inert as Inert
import Turkey.Match as Match
import Turkey.Prelude as P
import Turkey.Prims as Prims
import Turkey.Build as Build
import Turkey.Target as Target
import Turkey.Solved (Scope(..), Abstraction(..), Use(..))
import Turkey.Source (Span(..), span as sourceSpan)
import Turkey.Typed as Typed
import Turkey.Typed (TypeTable(..))
import Turkey.Types as Ty
import Turkey.Types (Kind(..), VarCell(..), ConCell(..), Scheme(..), Pred(..),
                     TVar, TCon, TApp, TFam, TFun, TTuple, TBottom)

-- -- naming -------------------------------------------------------------------------

-- An instance's dictionary, whose methods are named after it with `#`. A
-- method's display form (`Turkey.Demangle`) is `Class(Type).method`, and a
-- default's `Class.<default>.method`.
fun instName(inst : InstInfo) -> String {
    let name = "%inst." + inst.cls + "." + Classes.instCon(inst)
    if inst.cls == P.typedClass { name + Classes.typedSuffix(inst.head) } else { name }
}

fun defaultName(cls : String, method : String) -> String =
    "%default." + cls + "." + method

-- -- scope --------------------------------------------------------------------------

-- What this pass knows about the binders in scope, keyed by binder id.
--
-- Keyed by id rather than by spelling, so a binder shadows by construction: a
-- binder that reuses a spelling has an id of its own, and finds no entry the
-- binder it shadows left behind. Every binder form -- a parameter, a pattern,
-- a match arm, a `for`, a `let` or a local `fun` -- gets this without a rule of
-- its own.
--
-- A scope holds only what was bound in it, and defers every other binder to
-- `parent`, so making one costs nothing however much is in scope. A child sees
-- what its ancestors record after it was made, which cannot change an answer:
-- a binder is recorded where it is bound, and a mention of it is lowered after
-- that.
type Scope = Scope {
    parent   : Option Scope,
    -- The binders that are held in reference cells, each with the binder of
    -- its cell: a mention of one reads the cell.
    --
    -- A `var` is one, and its binding is the cell itself. So is a parameter or
    -- a pattern variable that something assigns -- they are reassignable, but
    -- one nothing writes is indistinguishable from a `let`, and making a cell
    -- for it anyway would put an indirection on every argument of every
    -- function for no observable gain. Its cell is a binder of its own, bound
    -- around the body to a cell holding its value.
    cells    : Map Int (String, Int),
    -- What each local binding in scope abstracts over. A *recursive*
    -- occurrence needs this and nothing else does: inference binds a name
    -- monomorphically inside its own definition, so a self-call records no
    -- type arguments -- correctly, there is nothing yet to record. System F
    -- still wants the application, at the binding's own variables.
    binders  : Map Int (Vec VarCell),
    -- The equalities each local function in scope takes coercions for, at its
    -- own variables, for the same recursive occurrences.
    equalities : Map Int (Vec (Ty.Type, Ty.Type)),
    -- Where a `return`, a `break` and a `continue` written here jump to. Each is
    -- a join, or absent where writing that transfer would have been a compile
    -- error anyway. This is what replaces "the transfer names its target by
    -- where it sits": the scope chain already knows where it sits.
    var ret  : Option (String, Int),
    var brk  : Option (String, Int),
    var cont : Option (String, Int),
}

fun newScope() -> Scope = Scope {
    parent = None, cells = Map.new(), binders = Map.new(), equalities = Map.new(),
    ret = None, brk = None, cont = None,
}

-- Returns a scope nested in `s`, with the same transfer targets. Takes
-- constant time.
fun childScope(s : Scope) -> Scope = Scope {
    parent = Some(s), cells = Map.new(), binders = Map.new(), equalities = Map.new(),
    ret = s.ret, brk = s.brk, cont = s.cont,
}

-- Returns the cell holding the binder `id`, if one does. Takes time
-- proportional to the depth of `s`.
fun cellOf(s : Scope, id : Int) -> Option (String, Int) =
    match Map.get(s.cells, id) {
        Some(cell) -> Some(cell)
        None -> match s.parent {
            Some(outer) -> cellOf(outer, id)
            None -> None
        }
    }

-- Returns what the local binder `id` abstracts over, or `None` if it is not
-- a local in scope. Takes time proportional to the depth of `s`.
fun localBinders(s : Scope, id : Int) -> Option (Vec VarCell) =
    match Map.get(s.binders, id) {
        Some(binders) -> Some(binders)
        None -> match s.parent {
            Some(outer) -> localBinders(outer, id)
            None -> None
        }
    }

-- Returns the equalities the local function `id` takes coercions for, or
-- `None` if it is not a local function in scope. Takes time proportional to
-- the depth of `s`.
fun localEqualities(s : Scope, id : Int) -> Option (Vec (Ty.Type, Ty.Type)) =
    match Map.get(s.equalities, id) {
        Some(found) -> Some(found)
        None -> match s.parent {
            Some(outer) -> localEqualities(outer, id)
            None -> None
        }
    }

-- -- the lowerer --------------------------------------------------------------------

type Lowerer = Lowerer {
    decls        : DeclTable,
    classes      : ClassTable,
    env          : Env,
    types        : TypeTable,
    -- While a method body is being lowered: which rigid constant in it stands
    -- for which quantified variable. Empty everywhere else, because nothing else
    -- is checked against skolems.
    var rigid    : Map String VarCell,
    -- Surface expressions already lowered, and what they lowered to. Only
    -- A-normalization puts anything here, and only for as long as it takes to
    -- rebuild one node around its operands.
    placeholders : Map Int Core,
    var counter  : Int,
    -- Which constructors `Prim.targetOs` and `Prim.targetArch` stand for.
    target       : Target.Target,
    -- And the build primitives (`Turkey.Build`).
    build        : Build.Build,
    -- Which binder each binding occurrence and reference means, and where the
    -- binders this pass invents are minted.
    binders      : Binders.Table,
    -- The owner the binders this pass invents go to, and the span they are
    -- recorded at: the top-level declaration being lowered.
    var owner    : Int,
    var site     : Span,
    -- While source this pass has already lowered is lowered again: the copy
    -- each binder bound in it gets, by the binder `binders` records. Empty
    -- elsewhere. See `copiesOf`.
    var copies   : Map Int Int,
    -- The dictionaries in scope, by the spelling inference gave each, and the
    -- id of each one's binder. See `withDicts`.
    dicts        : Map String Int,
    -- What each pattern that opens an existential binds, by the pattern's
    -- node, from when `openPattern` mints it until `Turkey.Match` reads it.
    opened       : Map Int Opened,
}

fun newLowerer(decls : DeclTable, classes : ClassTable, env : Env,
               types : TypeTable, target : Target.Target,
               build : Build.Build, binders : Binders.Table) -> Lowerer = Lowerer {
    decls = decls, classes = classes, env = env, types = types, target = target,
    build = build, binders = binders,
    rigid = Map.new(), placeholders = Map.new(), counter = 0,
    owner = 0, site = sourceSpan("", 0, 0),
    copies = Map.new(), dicts = Map.new(), opened = Map.new(),
}

-- A binder this pass invents: its spelling, and its id.
--
-- The spelling is `%`, the hint and a counter. `%` cannot start a source
-- identifier, and the counter is one per program, so no two spellings this
-- function returns are alike. Other binders may share one: `Turkey.Desugar`
-- counts its own `%seq` and `%k` from zero in each module, and the accessor
-- and `Typed` dictionaries spell `%r`, `%v` and `%p` with no counter. Only
-- the id tells those apart. The id is minted in the current owner.
fun freshName(l : Lowerer, hint : String) -> (String, Int) {
    let n = l.counter
    l.counter = l.counter + 1
    let name = "%" + hint + Int.toString(n)
    (name, mint(l, name))
}

-- Returns the id of a new binder spelled `name`, in the current owner.
fun mint(l : Lowerer, name : String) -> Int =
    Binders.fresh(l.binders, l.owner, name, Local, Generated(Some(l.site)))

-- Returns the id of a new binder spelled `name` that copies the binder `id`,
-- in the current owner: the cell that holds a reassigned binder, or the local
-- copy of a top-level one.
fun copyOf(l : Lowerer, name : String, id : Int) -> Int =
    Binders.fresh(l.binders, l.owner, name, Local, CopyOf(id))

-- Makes the declaration `nodeId` the owner binders are minted in, with
-- `where` as their span, and returns the owner and span it replaces. A
-- declaration `Turkey.Resolve` registered no owner for gets a new one, in
-- `moduleName` and named by `hint`.
fun enter(l : Lowerer, nodeId : Int, moduleName : String, hint : String,
          where : Span) -> (Int, Span) {
    let saved = (l.owner, l.site)
    l.owner = match Map.get(l.binders.declarationOwners, nodeId) {
        Some(o) -> o
        None -> Binders.owner(l.binders, moduleName, hint)
    }
    l.site = where
    saved
}

-- Makes a new owner the one binders are minted in, for a binding no
-- declaration states, and returns the owner and span it replaces.
fun enterNew(l : Lowerer, moduleName : String, hint : String,
             where : Span) -> (Int, Span) {
    let saved = (l.owner, l.site)
    l.owner = Binders.owner(l.binders, moduleName, hint)
    l.site = where
    saved
}

fun leave(l : Lowerer, saved : (Int, Span)) -> Unit {
    let (o, where) = saved
    l.owner = o
    l.site = where
}

-- Returns the binder the node `nodeId`, spelled `name`, binds or means: the
-- one `binders` records, or its copy while `copies` has one. Resolution and
-- desugaring record one for every binding occurrence and every reference
-- inference accepted, so a missing one is a compiler bug.
fun binderOf(l : Lowerer, nodeId : Int, name : String, where : Option Span) -> Int =
    match Map.get(l.binders.refs, nodeId) {
        Some(id) -> Map.getOr(l.copies, id, id)
        None -> oops("no binder was recorded for '" + name + "'", where)
    }

-- Returns `l.copies` with a new copy of each binder in `bound`, for lowering
-- the source that binds them once more.
--
-- Some source is lowered more than once: an arm's body once per alternative
-- of its pattern, and the rest of an arm once per alternative of a `let`
-- guard. No binder may be bound twice in a program, so every lowering after
-- the first binds copies, and the references in it mean the copies. A binder
-- that an enclosing lowering already copied is copied afresh.
fun copiesOf(l : Lowerer, bound : Vec Int) -> Map Int Int {
    let out = Map.new()
    for (id, copy) in Map.entries(l.copies) { Map.put(out, id, copy) }
    let made = Set.new()
    for id in bound {
        if !Set.contains(made, id) {
            Set.add(made, id)
            Map.put(out, id, copyOf(l, Binders.binderAt(l.binders, id).name, id))
        }
    }
    out
}

-- Returns `lower()`, run with `copies` in place of `l.copies`.
fun under(l : Lowerer, copies : Map Int Int, lower : fun() -> a) -> a {
    let saved = l.copies
    l.copies = copies
    let out = lower()
    l.copies = saved
    out
}

-- -- dictionaries in scope ----------------------------------------------------------

-- Inference names each dictionary a term takes or opens -- a function's
-- context, an instance's, a method's own, the instance's own dictionary
-- inside one of its methods, an existential's evidence -- and the evidence it
-- records for a use refers to a dictionary by that name. No two places in the
-- source share a name, but one name may still have several binders: this
-- pass lowers some source more than once (see `copiesOf`), and every member
-- of a group of functions binds the group's one context. So each place that
-- binds dictionaries mints a binder for each, in the current owner, before it
-- lowers the scope they are bound over, and a reference in that scope means
-- the innermost binder of its name.

-- Returns a new binder, in the current owner, for each dictionary in `names`:
-- its spelling and its id.
fun mintDicts(l : Lowerer, names : Array String) -> Array (String, Int) =
    Array.map(names, fun(name) = (name, mint(l, name)))

-- Returns `lower()`, run with the dictionaries `bound` in scope.
fun withDicts(l : Lowerer, bound : Array (String, Int), lower : fun() -> a) -> a {
    let saved = Array.map(bound, fun((name, _)) = (name, Map.get(l.dicts, name)))
    for (name, id) in bound { Map.put(l.dicts, name, id) }
    let out = lower()
    for var i = len(saved) - 1; i >= 0; i = i - 1 {
        match saved[i] {
            (name, Some(id)) -> Map.put(l.dicts, name, id)
            (name, None) -> discard(Map.delete(l.dicts, name))
        }
    }
    out
}

-- Returns the reference to the dictionary in scope that inference named
-- `name`. Raises an internal error when none is.
fun dictRef(l : Lowerer, name : String, where : Option Span) -> Ref =
    match Map.get(l.dicts, name) {
        Some(id) -> ById(id)
        None -> oops("the dictionary '" + name + "' is not in scope", where)
    }

-- Mints the evidence binders of every existential `pat` opens, records what
-- each opening pattern binds for `Turkey.Match` to read (`openedBy`), and
-- returns the binders, to be brought into scope over the code the pattern
-- guards.
fun openPattern(l : Lowerer, pat : Pat) -> Array (String, Int) {
    let out = []
    for p in openingPatterns(pat) {
        if let Some(o) = p.opening {
            let bound = mintDicts(l, o.evidence)
            Map.put(l.opened, p.id, Opened { evidence = bound, skolems = o.skolems,
                                             layouts = None })
            for b in bound { Vec.push(out, b) }
        }
    }
    Vec.toArray(out)
}

-- What the pattern `p`, which opens an existential, binds at its latest
-- lowering. Forgets it: `Turkey.Match` reads it once, when it builds the arm.
fun openedBy(l : Lowerer, p : Pat) -> Opened = match Map.get(l.opened, p.id) {
    Some(o) -> {
        discard(Map.delete(l.opened, p.id))
        o
    }
    None -> oops("an existential pattern was compiled before it was opened", Some(p.span))
}

-- Every node of `p` that opens an existential, outermost first. An
-- alternative cannot open one, so only the first of each `POr` is searched,
-- as `varPatterns` searches it.
fun openingPatterns(p : Pat) -> Vec Pat {
    let out = []
    openingPatternsInto(p, out)
    out
}

fun openingPatternsInto(p : Pat, out : Vec Pat) -> Unit {
    if Option.isSome(p.opening) { Vec.push(out, p) }
    match p.kind {
        PVar(_) | PWild | PLit(_) -> {}
        PCon(_, args) -> for a in args { openingPatternsInto(a, out) }
        PRecord(_, fields, _) -> for (_, sub) in fields { openingPatternsInto(sub, out) }
        PTuple(elems) -> for e in elems { openingPatternsInto(e, out) }
        PAnnot(inner, _) -> openingPatternsInto(inner, out)
        POr(alts) -> openingPatternsInto(alts[0], out)
    }
}

fun patternBinder(l : Lowerer, p : Pat) -> Int =
    binderOf(l, p.id, varName(p), Some(p.span))

fun node(ty : Ty.Type, where : Option Span, k : CoreKind) -> Core =
    mkCore(ty, where, k)

-- A parameter this pass invents.
fun freshParam(l : Lowerer, hint : String, ty : Ty.Type) -> CParam {
    let (name, id) = freshName(l, hint)
    CParam { name = name, id = id, ty = ty }
}

-- Returns the reference to the binder spelled `name` with the id `id`: by the
-- id for a local binder, and by the spelling for any other, which the passes
-- after this one find by name.
fun refAt(l : Lowerer, name : String, id : Int) -> Ref {
    if id == noId { return BySpelling(name) }
    match Binders.binderAt(l.binders, id).kind {
        Local -> ById(id)
        _ -> BySpelling(name)
    }
}

-- A mention of the parameter `p`.
fun paramVar(p : CParam, where : Option Span) -> Core = forwarded(p, where)

-- A `match`, with its patterns compiled into ones that do not nest; see
-- `Turkey.Match`.
fun matched(l : Lowerer, scrutinee : Core, arms : Vec (Pat, Core), ty : Ty.Type,
            where : Option Span) -> Core =
    matchedAs(l, patternBinder(l, _), scrutinee, arms, ty, where)

-- The same, with `binderOf` choosing the id each pattern variable binds.
fun matchedAs(l : Lowerer, binderOf : fun(Pat) -> Int, scrutinee : Core,
              arms : Vec (Pat, Core), ty : Ty.Type, where : Option Span) -> Core =
    compiled(l, binderOf, scrutinee,
             Vec.map(arms, fun((pat, body)) = (pat, Match.Taken(body))), ty, where)

-- The arms of one `match`, each pattern with the code it runs, and the id
-- each pattern variable binds, by the variable's node.
--
-- The ids are taken when an arm is added rather than when the `match` is
-- compiled, because `l.copies` is what decides them, and it differs from one
-- alternative of an arm to the next.
type Arms = Arms {
    alts    : Vec (Pat, Match.Body),
    binders : Map Int Int,
}

fun newArms() -> Arms = Arms { alts = Vec.new(4), binders = Map.new() }

fun addArm(l : Lowerer, arms : Arms, pat : Pat, body : Match.Body) -> Unit {
    Vec.push(arms.alts, (pat, body))
    for v in varPatterns(pat) { Map.put(arms.binders, v.id, patternBinder(l, v)) }
}

-- The same, with arms that may run guards.
fun matchedArms(l : Lowerer, scrutinee : Core, arms : Arms, ty : Ty.Type,
                where : Option Span) -> Core =
    compiled(l, fun(p) = match Map.get(arms.binders, p.id) {
        Some(id) -> id
        None -> patternBinder(l, p)
    }, scrutinee, arms.alts, ty, where)

fun compiled(l : Lowerer, binderOf : fun(Pat) -> Int, scrutinee : Core,
             arms : Vec (Pat, Match.Body), ty : Ty.Type, where : Option Span) -> Core =
    Match.compile(Match.Matcher {
        decls = l.decls,
        reduce = fun(t) = resolved(l, t),
        fresh = freshName(l, _),
        binderOf = binderOf,
        opened = openedBy(l, _),
    }, scrutinee, arms, ty, where)

-- A placeholder for a type this pass fills in a moment later.
fun unknown() -> Ty.Type = TVar(Ty.freshVar(0))

fun unitType() -> Ty.Type = Ty.tUnit()

-- -- the program --------------------------------------------------------------------

fun program(l : Lowerer, ordered : Vec Stmt) -> CProgram {
    let out = CProgram { dicts = Vec.new(16), binds = Vec.new(32) }
    for (name, info) in Map.entries(l.classes.classes) {
        for (method, impl) in Map.entries(info.defaults) {
            Vec.push(out.dicts, defaultMethod(l, name, method, impl))
        }
    }
    for (_, insts) in Map.entries(l.classes.instances) {
        for inst in insts { Vec.push(out.dicts, instanceBind(l, inst)) }
    }
    let scope = newScope()
    for stmt in ordered {
        let owner = Binders.declarationOwner(l.binders, stmt.id, stmt.span)
        let module_ = l.binders.owners[owner].moduleName
        let saved = enter(l, stmt.id, module_, "%top", stmt.span)
        for b in top(l, stmt, scope, module_) { Vec.push(out.binds, b) }
        leave(l, saved)
    }
    out
}

fun newBind(module_ : String, name : String, id : Int, ty : Ty.Type,
            binders : Vec VarCell, value : Core, where : Option Span) -> CBind = CBind {
    name = name, id = id, ty = ty, binders = binders, value = value, span = where,
    mutable = False, module_ = module_, layouts = Map.new(),
}

-- One top-level statement. Only bindings occur here.
fun top(l : Lowerer, stmt : Stmt, scope : Scope, owner : String)
        -> Vec CBind = match stmt.kind {
    SFun(decl) -> [funBind(l, decl, scope)]
    SLet(pat, value) -> letBinds(l, stmt, pat, value, False, scope, owner)
    SVar(pat, value) -> letBinds(l, stmt, pat, value, True, scope, owner)
    -- A bare expression at the top level: evaluated for effect, so it is a
    -- binding nothing reads, which is what a `let` already means.
    SExpr(e) -> {
        let value = expr(l, e, scope)
        let (name, id) = freshName(l, "top")
        [newBind(owner, owner + "#" + name, id, value.ty, [], value, Some(stmt.span))]
    }
    _ -> oops("unhandled top-level statement", Some(stmt.span))
}

fun funBind(l : Lowerer, decl : FunDecl, scope : Scope) -> CBind {
    let s = schemeOf(l, decl.name)
    let binders = match s {
        Some(sc) -> sc.quantified
        None -> []
    }
    let ty = match s {
        Some(sc) -> sc.body
        None -> funType(l, decl)
    }
    let dicts = abstractionOf(l, decl.id)
    let equalities = equalitiesOf(s)
    let id = binderOf(l, decl.id, decl.name, Some(decl.span))
    newBind(Binders.binderAt(l.binders, id).moduleName, decl.name, id,
            abstracted(l, ty, dicts, equalities), binders,
            function(l, decl, ty, scope, None, None, equalities), Some(decl.span))
}

-- A binding's type as Core sees it: evidence first.
--
-- The scheme says `[Show a] fun(a) -> Unit`, with the context to one side of the
-- type. In Core there is no "to one side" -- a dictionary is an argument, so it
-- is in the type, and so is a coercion for each equality. Every use site is
-- already built to match: a type application, and then an application to the
-- dictionaries and the coercions.
fun abstracted(l : Lowerer, ty : Ty.Type, dicts : Option Abstraction,
               equalities : Vec (Ty.Type, Ty.Type)) -> Ty.Type {
    let evidence = Vec.new(4)
    match dicts {
        None -> {}
        Some(a) -> if len(a.params) > 0 {
            for p in a.preds { Vec.push(evidence, predType(l, p)) }
        }
    }
    for (left, right) in equalities { Vec.push(evidence, coercionOf(left, right)) }
    if len(evidence) == 0 { ty } else { TFun(Vec.toArray(evidence), ty) }
}

-- A top-level `let` or `var`, possibly binding several names.
--
-- A destructuring binding becomes one binding of the whole value and one
-- projection per name, rather than a pattern at the top level: Core has no
-- statements, so there is nowhere for a multi-name binder to live.
fun letBinds(l : Lowerer, stmt : Stmt, pat : Pat, value : Expr, mutable : Bool,
             scope : Scope, owner : String) -> Vec CBind {
    let bare = unannot(pat)
    match bare.kind {
        PVar(name) -> {
            let id = patternBinder(l, bare)
            let s = schemeOf(l, name)
            let binders = match s {
                Some(sc) -> sc.quantified
                None -> []
            }
            var body = abstract(l, abstractionOf(l, stmt.id), equalitiesOf(s),
                                fun() = expr(l, value, scope))
            if mutable {
                Map.put(scope.cells, id, (name, id))
                body = node(refOf(body.ty), Some(stmt.span), CRef(body))
            }
            let b = newBind(owner, name, id, body.ty, binders, body, Some(stmt.span))
            b.mutable = mutable
            return [b]
        }
        _ -> {}
    }
    let lowered = expr(l, value, scope)
    let (holderName, holderId) = freshName(l, "bound")
    let holder = owner + "#" + holderName
    let out = [newBind(owner, holder, holderId, lowered.ty, [], lowered, Some(stmt.span))]
    -- Each name is its own top-level binding, which projects it out of the
    -- whole value with a one-armed match. The match binds a local copy of
    -- every name, which shadows the top-level binder it is a copy of.
    let vars = Vec.sortByKey(varPatterns(pat), varName)
    for v in vars {
        let name = varName(v)
        let id = patternBinder(l, v)
        let nty = nameType(l, name)
        let copies = Map.new()
        for other in vars {
            Map.put(copies, other.id, copyOf(l, varName(other), patternBinder(l, other)))
        }
        let picked = matchedAs(l, fun(p) = Map.getOr(copies, p.id, noId),
            node(lowered.ty, Some(stmt.span), CVar(BySpelling(holder))),
            [(pat, node(nty, Some(stmt.span), CVar(refAt(l, name, Map.getOr(copies, v.id, noId)))))],
            nty, Some(stmt.span))
        Vec.push(out, newBind(owner, name, id, picked.ty, [], picked, Some(stmt.span)))
    }
    out
}

-- -- classes and instances ----------------------------------------------------------

fun dictType(l : Lowerer, cls : String, arg : Ty.Type) -> Ty.Type {
    let info = classNamed(l, cls)
    TApp(Ty.tcon(Cr.dictName(cls), KFun(Classes.classKind(info), KStar),
                 Ty.noScope), arg, KStar)
}

-- One instance dictionary, as a top-level binding.
--
-- With a context it is a function: `instance [Show a] Show (Array a)` takes the
-- `Show a` dictionary and answers the `Show (Array a)` one. That is what it
-- always meant; the evaluator built it lazily and memoised on identity, and here
-- it is an ordinary binding.
fun instanceBind(l : Lowerer, inst : InstInfo) -> CBind {
    let saved = enterNew(l, inst.module_, instName(inst), inst.decl.span)
    let b = instanceBindIn(l, inst)
    leave(l, saved)
    b
}

fun instanceBindIn(l : Lowerer, inst : InstInfo) -> CBind {
    let plan = match inst.plan {
        Some(p) -> p
        None -> oops("instance has no plan", Some(inst.decl.span))
    }
    let result = dictType(l, inst.cls, inst.head)
    if Classes.isGenerated(inst.cls) { return accessors(l, inst, result) }
    let bound = contextParams(l, inst, plan)
    if inst.cls == P.typedClass { return typeRepDict(l, inst, result, bound) }
    let givens = instanceGivens(l, inst, plan)
    let record = withDicts(l, bound, fun() = dictionary(l, inst.cls, result,
                                                      Some(inst.decl.span), fun(slot) =
        match slot {
            SuperSlot(sup) -> match Map.get(plan.supers, sup) {
                Some(ev) -> evidence(l, ev, dictType(l, sup, inst.head), givens)
                None -> oops("no evidence for the superclass '" + sup + "'",
                             Some(inst.decl.span))
            }
            -- Proved at the head when the instance was declared, and checked
            -- again by Coretc under the context's dictionaries.
            EqualitySlot(k) -> {
                let info = classNamed(l, inst.cls)
                let e = Classes.equalityAt(info, info.equalities[k], inst.head)
                Cr.coercion(e.args[0], e.args[1], Some(inst.decl.span))
            }
            MethodSlot(name) -> match Map.get(plan.methods, name) {
                Some(impl) -> if refutedAt(l, inst, name) { unreachable(l, inst, name) }
                              else { methodBody(l, inst, name, impl, plan.params) }
                None -> oops("no body for the method '" + name + "'",
                             Some(inst.decl.span))
            }
            KeyedSlot(_, _) -> oops("a keyed slot before layouts are shared",
                                    Some(inst.decl.span))
        }))
    let value = overContext(l, inst, bound, record, result)
    newBind(inst.module_, instName(inst), noId, value.ty, instanceBinders(inst),
            value, Some(inst.decl.span))
}

-- Returns whether the method `name`'s own equalities can never hold together
-- at the instance's head with those the instance's context grants, tested
-- jointly as the solver tests the givens its override is checked under. Such a method can never be called at that head,
-- since every call has to supply the evidence for its equalities. Its body may
-- also be ill-typed there, since it was checked under equalities that are
-- false, so it is not lowered at all.
fun refutedAt(l : Lowerer, inst : InstInfo, name : String) -> Bool {
    let own = methodEqualitiesAt(methodOf(l, inst.cls, name, Some(inst.decl.span)), inst.head)
    if len(own) == 0 { return False }
    -- With what the instance's context grants, which the override is checked
    -- under too: its equalities, and its class predicates' equality
    -- superclasses.
    let context = Inert.granted(l.classes,
                                Vec.toArray(Vec.map(Classes.contextPreds(inst), Inert.given)))
    for g in context { Vec.push(own, (g.pred.args[0], g.pred.args[1])) }
    Inert.refutes(l.classes, own)
}

-- The method `name` as a slot of the instance's dictionary that can never be
-- called: a function of its evidence that panics.
fun unreachable(l : Lowerer, inst : InstInfo, name : String) -> Core {
    let mi = methodOf(l, inst.cls, name, Some(inst.decl.span))
    let span = Some(inst.decl.span)
    let lam = match methodType(l, mi, inst.head) {
        TFun(evidence, rest) -> {
            let params = Array.map(evidence, fun(t) = CParam { name = "%e", id = mint(l, "%e"), ty = t })
            let message = "the method '" + Classes.surfaceMember(name) + "' cannot be called at "
                          + Ty.show(inst.head)
            let failed = node(rest, span, CApp(
                node(TFun([Ty.tString()], rest), span, CTyApp(
                    node(unknown(), span, CVar(BySpelling(P.error))), [rest])),
                [node(Ty.tString(), span, CLit(LString(message)))]))
            node(TFun(evidence, rest), span, CLam(params, failed, instName(inst) + "." + name))
        }
        _ -> oops("a method with equalities takes no evidence", span)
    }
    methodAbstraction(mi, lam, span)
}

fun methodOf(l : Lowerer, cls : String, name : String, where : Option Span) -> MethodInfo =
    match Map.get(classNamed(l, cls).methods, name) {
        Some(m) -> m
        None -> oops("unknown method '" + name + "'", where)
    }

-- The dictionary of a generated field or projection class.
--
-- Written here in Core rather than in the surface language, and it has to be:
-- `fun get(r) = r.cap` is itself a field access, so it would demand the very
-- predicate it is the evidence for and regress. `CProject` at the field's
-- position is the primitive and the class is its interface -- the same
-- relation `Prim.intAdd` has to `class Add`.
--
-- No context, so the dictionary is a bare record rather than a function of one.
-- That is what lets the devirtualizer hoist these accessors and the inliner
-- collapse them: wherever specialization reaches, a field access ends up the
-- same `CProject` a field access on a known record lowers to.
-- The dictionary of a derived `Typed` instance.
--
-- Written in Core for the same reason `accessors` is: the surface language
-- cannot say it. `typeRep` answers the constructor's *qualified* name, which
-- is unique across modules and which no Turkey expression can ask for, and the
-- arguments' reps come from the dictionaries this instance was handed -- so a
-- rep is built the same way a type is, by application.
--
-- The `Proxy` argument carries nothing and is ignored. It exists so a call can
-- say which instance it means, since the answer depends on the type and not on
-- any value of it.
fun typeRepDict(l : Lowerer, inst : InstInfo, result : Ty.Type,
               bound : Array (String, Int)) -> CBind {
    let span = Some(inst.decl.span)
    let repTy = Decls.head(l.decls, P.typeRepCon)
    let (head, _) = Ty.spine(inst.head)
    let name = match head {
        TCon(c) -> c.name
        TTuple(elems) -> "Tuple" + Int.toString(len(elems))
        _ -> oops("a derived 'Typed' instance has no constructor", span)
    }
    let elems = Array.init(len(bound), fun(i) {
        let pred = inst.context[i]
        let argument = pred.args[0]
        let proxyTy = proxyOf(l, argument)
        let dictTy = dictType(l, pred.name, argument)
        let method = node(TFun([proxyTy], repTy), span,
                          CSlot(node(dictTy, span, CVar(ById(bound[i].1))),
                                slotFor(l, P.typedClass, typeRepMethod(l), span)))
        node(repTy, span, CApp(method, [node(proxyTy, span, CCon(P.proxyCon))]))
    })
    let arrayTy = Ty.rawArrayOf(repTy)
    let made = node(repTy, span, CApp(
        node(TFun([Ty.tString(), arrayTy], repTy), span, CCon(P.typeRepCon)),
        [node(Ty.tString(), span, CLit(LString(name))),
         node(arrayTy, span, CArray(elems))]))
    let ownProxy = proxyOf(l, inst.head)
    let body = node(TFun([ownProxy], repTy), span,
                    CLam([CParam { name = "%p", id = mint(l, "%p"), ty = ownProxy }], made,
                         instName(inst) + "#typeRep"))
    let record = dictionary(l, inst.cls, result, span, fun(_) = body)
    let value = overContext(l, inst, bound, record, result)
    let b = newBind(inst.module_, instName(inst), noId, value.ty, instanceBinders(inst),
                    value, span)
    b
}

-- Returns `Proxy t`, for a `t` of any kind.
--
-- Built as a `TApp`, as `dictType` builds a dictionary's type, and not through
-- `Ty.applyTo`: `Proxy` has kind `* -> *`, and a derived `Typed` instance's
-- head or context argument may be a constructor of any kind, `Option` in
-- `Typed (T Option)`. `Coretc` checks no kinds, and the layout of `Proxy t`
-- does not depend on `t`, so the badly kinded `Proxy Option` is harmless past
-- here.
fun proxyOf(l : Lowerer, t : Ty.Type) -> Ty.Type =
    TApp(Decls.head(l.decls, P.proxyCon), t, KStar)

-- The binders of an instance's context, one for each dictionary it takes,
-- under the names the plan gave them.
fun contextParams(l : Lowerer, inst : InstInfo, plan : InstancePlan)
        -> Array (String, Int) =
    mintDicts(l, Array.init(fewer(len(plan.params), len(inst.context)),
                            fun(i) = plan.params[i]))

-- An instance's dictionary `record`, of type `result`, as a function of its
-- context: the dictionaries `bound`, then a coercion for each equality. It is
-- `record` itself for an instance with no context.
fun overContext(l : Lowerer, inst : InstInfo, bound : Array (String, Int), record : Core,
                result : Ty.Type) -> Core {
    if len(bound) == 0 && len(inst.equalities) == 0 { return record }
    let dicts = Array.init(len(bound), fun(i) {
        let p = inst.context[i]
        let (name, id) = bound[i]
        CParam { name = name, id = id, ty = dictType(l, p.name, p.args[0]) }
    })
    let coercions = Array.map(Vec.toArray(instanceEqualities(inst)), fun((left, right)) =
        CParam { name = "%co", id = mint(l, "%co"), ty = coercionOf(left, right) })
    let params = Array.append(dicts, coercions)
    node(TFun(Array.map(params, _.ty), result), Some(inst.decl.span),
         CLam(params, record, instName(inst)))
}

-- The equalities of an instance's context, over its head's variables: what
-- its coercion parameters grant.
fun instanceEqualities(inst : InstInfo) -> Vec (Ty.Type, Ty.Type) =
    Vec.map(inst.equalities, fun(p) = (p.args[0], p.args[1]))

fun accessors(l : Lowerer, inst : InstInfo, result : Ty.Type) -> CBind {
    let span = Some(inst.decl.span)
    let target = CParam { name = "%r", id = mint(l, "%r"), ty = inst.head }
    let receiver = node(inst.head, span, CVar(refAt(l, target.name, target.id)))
    -- One method, so one slot: `get` or `set`.
    let method = match Classes.setterLabel(inst.cls) {
        Some(name) -> {
            let held = Decls.fieldType(l.decls, inst.head, name)
            let written = CParam { name = "%v", id = mint(l, "%v"), ty = held }
            let slot = node(held, span, accessedField(l, receiver, name, span))
            node(TFun([inst.head, held], Ty.tUnit()), span,
                CLam([target, written],
                     node(Ty.tUnit(), span,
                          CAssign(slot, node(held, span, CVar(refAt(l, written.name, written.id))))),
                     instName(inst) + "#set"))
        }
        None -> {
            var held = Ty.tUnit()
            for (_, ty) in Map.entries(inst.families) { held = ty }
            let read = match Classes.generatedLabel(inst.cls) {
                Some(name) -> node(held, span, accessedField(l, receiver, name, span))
                None -> match Classes.generatedIndex(inst.cls) {
                    Some(index) -> node(held, span, CProject(receiver, index))
                    None -> oops("'" + inst.cls + "' is not a generated class", span)
                }
            }
            node(TFun([inst.head], held), span,
                 CLam([target], read, instName(inst) + "#get"))
        }
    }
    let record = dictionary(l, inst.cls, result, span, fun(_) = method)
    let b = newBind(inst.module_, instName(inst), noId, result, instanceBinders(inst),
                    record, span)
    b
}

-- The field an accessor reads or writes: a position, since a generated
-- instance's head is the record type that declares the field.
fun accessedField(l : Lowerer, receiver : Core, label : String,
                  span : Option Span) -> CoreKind =
    match fieldPosition(l, receiver.ty, label) {
        Some(i) -> CProject(receiver, i)
        None -> oops("'" + Ty.show(receiver.ty) + "' has no field '" + label + "'",
                     span)
    }

-- A `cls` dictionary, each slot filled by `fill`.
fun dictionary(l : Lowerer, cls : String, ty : Ty.Type, span : Option Span,
               fill : fun(Slot) -> Core) -> Core =
    node(ty, span, CDict(cls, Array.map(Classes.dictSlots(l.classes, cls), fill)))

-- Where a `cls` dictionary holds `method`, by its qualified name.
fun slotFor(l : Lowerer, cls : String, method : String, span : Option Span) -> Int =
    match Classes.methodSlot(l.classes, cls, method) {
        Some(i) -> i
        None -> oops("class '" + cls + "' has no method '" + method + "'", span)
    }

-- The qualified name of `Typed`'s one method.
fun typeRepMethod(l : Lowerer) -> String =
    match Classes.memberNamed(Map.keys(classNamed(l, P.typedClass).methods), "typeRep") {
        Some(name) -> name
        None -> oops("'" + P.typedClass + "' has no method 'typeRep'", None)
    }

-- The instance's own variables, in the order its binding abstracts them. Read
-- off the head, which is the only place they appear, and used by both the
-- definition and every reference so the two cannot disagree.
fun instanceBinders(inst : InstInfo) -> Vec VarCell = Ty.varsOf([inst.head])

-- The instance's own dictionary, as seen from inside one of its methods: applied
-- to its own binders and to its own context, which is what makes the reference
-- well-typed rather than merely well-named.
fun selfDict(l : Lowerer, inst : InstInfo, params : Vec String) -> Core {
    let result = dictType(l, inst.cls, inst.head)
    var fn = node(unknown(), Some(inst.decl.span), CVar(BySpelling(instName(inst))))
    let binders = instanceBinders(inst)
    if len(binders) > 0 {
        fn = node(unknown(), Some(inst.decl.span),
                  CTyApp(fn, Array.map(binders, TVar)))
    }
    if len(inst.context) == 0 && len(inst.equalities) == 0 {
        fn.ty = result
        return fn
    }
    let count = fewer(len(params), len(inst.context))
    let dicts = Array.init(count, fun(i) {
        node(predType(l, inst.context[i]), Some(inst.decl.span),
             CVar(dictRef(l, params[i], Some(inst.decl.span))))
    })
    -- Fresh coercions rather than the instance's parameters, since nothing
    -- refers to a coercion parameter.
    let coercions = Array.map(Vec.toArray(instanceEqualities(inst)), fun((left, right)) =
        coercion(left, right, Some(inst.decl.span)))
    let args = Array.append(dicts, coercions)
    fn.ty = TFun(Array.map(args, _.ty), result)
    node(result, Some(inst.decl.span), CApp(fn, args))
}

-- A method's type as it sits in a dictionary, at one head.
--
-- A method with its own context takes those dictionaries and coercions per
-- *call* rather than per instance, so they are parameters of the field, not of
-- the dictionary that holds it.
fun methodType(l : Lowerer, info : MethodInfo, head : Ty.Type) -> Ty.Type {
    let mapping = Map.new()
    Map.put(mapping, info.classVar.id, head)
    let ty = Decls.substitute(info.scheme.body, mapping)
    let own = Classes.methodEvidence(info)
    if len(own) == 0 { return ty }
    TFun(Array.map(own, fun(p) = if p.name == Ty.equals {
        coercionOf(Decls.substitute(p.args[0], mapping), Decls.substitute(p.args[1], mapping))
    } else {
        dictType(l, p.name, Decls.substitute(p.args[0], mapping))
    }), ty)
}

-- The method's own equalities, with the class variable at `head`.
fun methodEqualitiesAt(info : MethodInfo, head : Ty.Type) -> Vec (Ty.Type, Ty.Type) {
    let mapping = Map.new()
    Map.put(mapping, info.classVar.id, head)
    Vec.map(Classes.methodEqualities(info), fun(p) =
        (Decls.substitute(p.args[0], mapping), Decls.substitute(p.args[1], mapping)))
}

-- A class's default method, lowered once, for every instance to share.
--
-- It has to be once. The generator checks a default body a single time, against
-- the *class* variable, so the types recorded in it are about that variable and
-- not about any instance. Copying the body into each dictionary would put `a`
-- where `Int` belongs.
--
-- So it is what it always was: a function of the dictionary it belongs to,
-- polymorphic in the class variable. The body already uses a name for that
-- dictionary, so it becomes the parameter.
fun defaultMethod(l : Lowerer, cls : String, name : String,
                  impl : MethodImpl) -> CBind {
    let info = classNamed(l, cls)
    let mi = match Map.get(info.methods, name) {
        Some(m) -> m
        None -> oops("unknown method '" + name + "'", Some(impl.decl.span))
    }
    let cvar = mi.classVar
    let selfTy = dictType(l, cls, TVar(cvar))
    let owned = enter(l, impl.decl.id, info.module_, defaultName(cls, name),
                      impl.decl.span)
    let saved = setSkolems(l, impl, mi, [cvar])
    let self = mint(l, impl.selfName)
    var body = withDicts(l, [(impl.selfName, self)], fun() =
        function(l, impl.decl, mi.scheme.body, newScope(), Some(impl.dictParams),
                 Some(Classes.methodDicts(mi)), methodEqualitiesAt(mi, TVar(cvar))))
    l.rigid = saved
    leave(l, owned)
    body = methodAbstraction(mi, body, Some(impl.decl.span))
    let lam = node(TFun([selfTy], body.ty), Some(impl.decl.span),
        CLam([CParam { name = impl.selfName, id = self, ty = selfTy }], body,
             defaultName(cls, name)))
    newBind(info.module_, defaultName(cls, name), noId, lam.ty, [cvar], lam,
            Some(impl.decl.span))
}

-- One method body, as a lambda inside its dictionary.
--
-- The self name is the dictionary the body belongs to, bound so that a method
-- may call another of its own class without anything being passed -- which is
-- what makes a *default* method work at all. In Core it is a `let` around the
-- body rather than a name the evaluator arranges to have in scope.
fun methodBody(l : Lowerer, inst : InstInfo, name : String, impl : MethodImpl,
               params : Vec String) -> Core {
    let info = classNamed(l, inst.cls)
    let mi = match Map.get(info.methods, name) {
        Some(m) -> m
        None -> oops("unknown method '" + name + "'", Some(impl.decl.span))
    }
    let head = inst.head
    if isDefaultOf(info, name, impl) {
        -- Not this instance's body: the class's, shared. Applied at this head
        -- and to this dictionary.
        let own = selfDict(l, inst, params)
        let result = methodType(l, mi, head)
        let fn = node(TFun([own.ty], result), Some(impl.decl.span),
            CTyApp(node(unknown(), Some(impl.decl.span),
                        CVar(BySpelling(defaultName(inst.cls, name)))), [head]))
        let called = node(result, Some(impl.decl.span), CApp(fn, [own]))
        -- Eta-expanded, for the same reason the self dictionary goes under the
        -- lambda: the argument is the dictionary this field belongs to, so
        -- evaluating the application while the record is being built would build
        -- it again, for ever. Under a lambda it waits until the method is called.
        return eta(l, called, result, Some(impl.decl.span))
    }
    let mapping = Map.new()
    Map.put(mapping, mi.classVar.id, head)
    let ty = Decls.substitute(mi.scheme.body, mapping)
    let owned = enter(l, impl.decl.id, inst.module_,
                      instName(inst) + "." + name, impl.decl.span)
    let saved = setSkolems(l, impl, mi, Ty.varsOf([inst.head]))
    let self = if impl.selfName != "" { [(impl.selfName, mint(l, impl.selfName))] } else { [] }
    var body = withDicts(l, self, fun() =
        function(l, impl.decl, ty, newScope(), Some(impl.dictParams),
                 Some(Classes.methodDicts(mi)), methodEqualitiesAt(mi, head)))
    l.rigid = saved
    leave(l, owned)
    for (selfName, selfId) in self {
        body = bindSelf(l, inst, params, selfName, selfId, body, Some(impl.decl.span))
    }
    methodAbstraction(mi, body, Some(impl.decl.span))
}

-- Whether this implementation is the class's shared default rather than the
-- instance's own body. A default is registered under the class and reused, so
-- the two are the same declaration, compared by node id.
fun isDefaultOf(info : ClassInfo, name : String, impl : MethodImpl) -> Bool =
    match Map.get(info.defaults, name) {
        Some(other) -> other.decl.id == impl.decl.id
        None -> False
    }

-- `f` as `fun(x, ...) { f(x, ...) }`, to defer evaluating `f`.
-- The dictionaries a use of an existential constructor packs;
-- empty for every other constructor.
fun carried(l : Lowerer, e : Expr) -> Array Core = match Map.get(l.types.uses, e.id) {
    None -> []
    Some(u) -> {
        if len(u.evidence) == 0 { return [] }
        let givens = givensOf(l, u)
        let count = fewer(len(u.evidence), len(u.preds))
        Array.init(count, fun(i) = evidence(l, u.evidence[i], predType(l, u.preds[i]), givens))
    }
}

-- The dictionaries a field access reads or writes through, when its receiver
-- is polymorphic: the reader's, then the setter's if it assigns. `None` where
-- the evidence is an instance, which means the receiver's type is known here
-- and the field is selected directly.
--
-- Both are given or neither is: the two predicates are about one receiver, and
-- a receiver is either quantified over or it is not.
fun passedAccessors(l : Lowerer, e : Expr) -> Option (Array Core) {
    let u = Map.get(l.types.uses, e.id)?
    if len(u.evidence) == 0 { return None }
    match u.evidence[0] {
        FromDict(_, _, _) -> {}
        _ -> return None
    }
    let givens = givensOf(l, u)
    let count = fewer(len(u.evidence), len(u.preds))
    Some(Array.init(count, fun(i) = evidence(l, u.evidence[i], predType(l, u.preds[i]), givens)))
}

-- The constructor as Core applies it: dictionaries, then fields.
fun packing(dicts : Array Core, fnTy : Ty.Type, name : String,
            where : Option Span) -> Core {
    let dictTypes = Array.map(dicts, _.ty)
    match Ty.prune(fnTy) {
        TFun(params, ret) ->
            node(TFun(Array.append(dictTypes, params), ret), where, CCon(name))
        other -> node(TFun(dictTypes, other), where, CCon(name))
    }
}

-- A constructor named rather than applied. An existential with a context
-- carries the dictionaries its use was elaborated with, so the function it
-- stands for applies them ahead of the fields.
fun conValue(l : Lowerer, e : Expr, name : String, ty : Ty.Type,
             where : Option Span) -> Core {
    let dicts = carried(l, e)
    if len(dicts) == 0 { return eta(l, node(ty, where, CCon(name)), ty, where) }
    match Ty.prune(ty) {
        TFun(params, ret) -> {
            let ps = Array.map(params, freshParam(l, "eta", _))
            let args = Array.map(ps, paramVar(_, where))
            node(TFun(params, ret), where, CLam(ps, node(ret, where,
                CApp(packing(dicts, ty, name, where), Array.append(dicts, args))),
                "<anonymous>"))
        }
        other -> node(other, where, CApp(packing(dicts, other, name, where), dicts))
    }
}

-- `C { f = x, g = y }` for an existential `C`, as the positional application
-- every backend packs. The fields are evaluated in the order they were written
-- and bound to fresh names first, then passed in declaration order.
fun existentialRecord(l : Lowerer, e : Expr, info : ConInfo, con : String,
                      fields : Vec (String, Expr), ty : Ty.Type,
                      where : Option Span, scope : Scope) -> Core {
    let values = Map.new()
    for (n, v) in fields { Map.put(values, n, expr(l, v, scope)) }
    let held = Map.new()
    for (n, _) in fields { Map.put(held, n, freshName(l, "field")) }
    let dicts = carried(l, e)
    let names = match info.fields {
        Some(ns) -> ns
        None -> []
    }
    let ordered = Array.map(names, fun(n) {
        let v = match Map.get(values, n) {
            Some(x) -> x
            None -> oops("the field '" + n + "' vanished", where)
        }
        let (name, id) = Map.getOr(held, n, (n, noId))
        node(v.ty, where, CVar(refAt(l, name, id)))
    })
    let fnTy = TFun(Array.map(ordered, _.ty), ty)
    var out = node(ty, where, CApp(packing(dicts, fnTy, con, where),
                                   Array.append(dicts, ordered)))
    for var i = len(fields) - 1; i >= 0; i = i - 1 {
        let (n, _) = fields[i]
        let v = match Map.get(values, n) {
            Some(x) -> x
            None -> oops("the field '" + n + "' vanished", where)
        }
        let (name, id) = Map.getOr(held, n, (n, noId))
        out = node(ty, where, CLet(name, id, v.ty, v, out, []))
    }
    out
}

-- A record literal: the application of its constructor to its fields, in
-- declaration order, which is the object's layout.
--
-- The fields are evaluated in the order they were written, so where that is
-- not declaration order, each is bound first, in written order, and the
-- constructor is applied to the bindings.
fun recordLiteral(l : Lowerer, con : String, fields : Array (String, Core),
                  ty : Ty.Type, where : Option Span) -> Core {
    let declared = match Decls.con(l.decls, con) {
        Some(ConInfo { fields = Some(names), .. }) -> names
        _ -> oops("'" + con + "' is not a record constructor", where)
    }
    var inOrder = len(fields) == len(declared)
    for var i = 0; i < len(fields) && i < len(declared); i = i + 1 {
        if fields[i].0 != declared[i] { inOrder = False }
    }
    if inOrder { return applyCon(con, Array.map(fields, _.1), ty, where) }
    let held = Map.new()
    for (n, v) in fields { Map.put(held, n, (freshName(l, "field"), v)) }
    let built = Array.map(declared, fun(n) {
        let ((name, id), v) = match Map.get(held, n) {
            Some(found) -> found
            None -> oops("the field '" + n + "' vanished", where)
        }
        node(v.ty, where, CVar(refAt(l, name, id)))
    })
    var out = applyCon(con, built, ty, where)
    for var i = len(fields) - 1; i >= 0; i = i - 1 {
        let ((name, id), v) = held[fields[i].0]
        out = node(ty, where, CLet(name, id, v.ty, v, out, []))
    }
    out
}

-- A saturated constructor application.
fun applyCon(con : String, args : Array Core, ty : Ty.Type,
             where : Option Span) -> Core =
    node(ty, where, CApp(node(TFun(Array.map(args, _.ty), ty), where, CCon(con)),
                         args))

-- The position of the field `label` in `receiver`, whose type is known here:
-- a field of a receiver whose type is not is read through its evidence
-- (`passedAccessors`). A receiver of type `!` never yields a value, so any
-- position reads it.
fun knownPosition(l : Lowerer, receiver : Core, label : String,
                  where : Option Span) -> Int {
    match Ty.prune(receiver.ty) {
        TBottom -> return 0
        _ -> {}
    }
    match fieldPosition(l, receiver.ty, label) {
        Some(i) -> i
        None -> oops("'" + Ty.show(receiver.ty) + "' has no field '" + label + "'",
                     where)
    }
}

-- The slot of the generated accessor `which` in `dict`, a field class's
-- dictionary.
fun accessorSlot(l : Lowerer, dict : Core, which : String,
                 where : Option Span) -> Int {
    let cls = match dictClass(dict.ty) {
        Some(c) -> c
        None -> oops("a field accessor read from something that is not a dictionary",
                     where)
    }
    slotFor(l, cls, Classes.accessor(cls, which), where)
}

-- The position of the field `label` in the record type `ty`, where `ty`'s
-- head is known to be a record type.
fun fieldPosition(l : Lowerer, ty : Ty.Type, label : String) -> Option Int {
    let (h, _) = Ty.spine(Ty.prune(ty))
    match h {
        TCon(c) -> Array.indexOf(Decls.recordFields(l.decls, c.name)?, label)
        _ -> None
    }
}

--
-- Through a layer of coercions alone, it goes on to the function that layer
-- answers, as `bindSelf` places a method's own dictionary: a slot that is a
-- lambda over the method's own parameters is one that specialization and the
-- optimizer see a call through, where one that answers a function leaves a
-- closure called at each call.
fun eta(l : Lowerer, called : Core, result : Ty.Type, where : Option Span) -> Core =
    match Ty.prune(result) {
        TFun(params, ret) -> {
            let ps = Array.map(params, freshParam(l, "eta", _))
            let args = Array.map(ps, paramVar(_, where))
            let applied = node(ret, where, CApp(called, args))
            let body = if onlyCoercions(ps) { eta(l, applied, ret, where) } else { applied }
            node(TFun(params, ret), where, CLam(ps, body, "<anonymous>"))
        }
        _ -> called
    }

-- Returns whether `ps` are parameters only of coercions, which a lambda over
-- them is erased with.
fun onlyCoercions(ps : Array CParam) -> Bool =
    len(ps) > 0 && Iterator.all(ps, fun(p) = isCoercion(p.ty))

-- Bind the instance's own dictionary *inside* the method's lambda.
--
-- Inside, not around it, and that placement is the difference between a program
-- that runs and one that does not. `instance [Show a] Show (Array a)` names
-- itself, so a binding evaluated while the dictionary is being built would build
-- the dictionary again, for ever. Under the lambda it is evaluated when the
-- method is *called*, by which time the dictionary exists.
fun bindSelf(l : Lowerer, inst : InstInfo, params : Vec String, name : String, id : Int,
             body : Core, where : Option Span) -> Core {
    -- Under the method's own parameters, not under a lambda over coercions
    -- alone. Erasure would eta-expand that lambda through the method's, which
    -- would build a closure, besides the dictionary, at every call.
    match body.kind {
        CLam(ps, inner, lamName) -> if onlyCoercions(ps) {
            return node(body.ty, body.span, CLam(ps,
                bindSelf(l, inst, params, name, id, inner, where), lamName))
        }
        _ -> {}
    }
    let own = selfDict(l, inst, params)
    match body.kind {
        CLam(ps, inner, lamName) -> node(body.ty, body.span, CLam(ps,
            node(inner.ty, where, CLet(name, id, own.ty, own, inner, [])),
            lamName))
        _ -> node(body.ty, where,
                  CLet(name, id, own.ty, own, body, []))
    }
}

-- A method is polymorphic in its *own* variables, and the dictionary that holds
-- it does not fix those -- only the class variable. `map` in a `Functor
-- (Either l)` dictionary is still `forall a b`, so the field is a type
-- abstraction and every use of it a type application.
fun methodAbstraction(info : MethodInfo, body : Core, where : Option Span) -> Core {
    let binders = Vec.new(4)
    for q in info.scheme.quantified {
        if q.id != info.classVar.id { Vec.push(binders, q) }
    }
    if len(binders) == 0 { return body }
    node(body.ty, where, CTyLam(binders, body))
}

-- Set the constant-to-variable map for one method body, and answer what it was.
fun setSkolems(l : Lowerer, impl : MethodImpl, info : MethodInfo,
               headVars : Vec VarCell) -> Map String VarCell {
    let byId = Map.new()
    for v in headVars { Map.put(byId, v.id, v) }
    for q in info.scheme.quantified { Map.put(byId, q.id, q) }
    let rigid = Map.new()
    for (varId, con) in Map.entries(impl.skolems) {
        match (Map.get(byId, varId), con) {
            (Some(v), TCon(c)) -> Map.put(rigid, c.name, v)
            _ -> {}
        }
    }
    let saved = l.rigid
    l.rigid = rigid
    saved
}

-- -- evidence -----------------------------------------------------------------------

-- One evidence tree, as a term. This is the milestone in one function.
fun evidence(l : Lowerer, ev : Evidence, want : Ty.Type,
             givens : Map String Ty.Type) -> Core = match ev {
    FromDict(name, path, p) -> {
        -- Every node of the chain gets its real type, not just the last. A
        -- superclass constrains the class variable itself, so every dictionary
        -- along the path is *about the same type* and differs only in its class
        -- -- which the path names. Leaving the middle for the checker to guess
        -- was the same mistake in miniature as leaving the whole elaboration
        -- unchecked: it made the checker believe a term instead of reading it.
        let head = dictArg(want)
        let start = match Map.get(givens, name) {
            Some(t) -> t
            None -> match p {
                Some(pred) -> predType(l, pred)
                None -> want
            }
        }
        var out = node(start, None, CVar(dictRef(l, name, None)))
        var cls = match dictClass(start) {
            Some(c) -> c
            None -> oops("'" + name + "' is not a dictionary", None)
        }
        for var i = 0; i < len(path); i = i + 1 {
            let at = if i == len(path) - 1 { want }
                     else { dictType(l, path[i], head) }
            let index = match Classes.superSlot(l.classes, cls, path[i]) {
                Some(found) -> found
                None -> oops("'" + path[i] + "' is not a superclass of '" + cls + "'",
                             None)
            }
            out = node(at, None, CSlot(out, index))
            cls = path[i]
        }
        out
    }
    FromInstance(inst, mapping, args) -> instanceRef(l, inst, mapping, args)
    -- The predicate's argument is bottom: there is no value here, so there is no
    -- dictionary to find. `error` diverges and so has whatever type its context
    -- wants.
    Absent(name) -> node(want, None, CApp(
        node(TFun([Ty.tString()], want), None, CVar(BySpelling(P.error))),
        [node(Ty.tString(), None, CLit(LString("no evidence for " + name)))]))
}

-- A reference to an instance's dictionary, at the match `mapping` the solver
-- selected it by, applied to the evidence for its own context.
fun instanceRef(l : Lowerer, inst : InstInfo, matched : Map Int Ty.Type,
                args : Array Evidence) -> Core {
    -- The types the match recorded are read now that solving is over.
    let mapping = Map.new()
    for (id, t) in Map.entries(matched) { Map.put(mapping, id, resolved(l, t)) }
    let head = Decls.substitute(inst.head, mapping)
    let binders = instanceBinders(inst)
    let typeArgs = Array.map(binders, fun(b) = Map.getOr(mapping, b.id, TVar(b)))
    let result = dictType(l, inst.cls, head)
    var fn = node(unknown(), None, CVar(BySpelling(instName(inst))))
    if len(typeArgs) > 0 {
        fn = node(unknown(), None, CTyApp(fn, typeArgs))
    }
    if len(args) == 0 && len(inst.equalities) == 0 {
        fn.ty = result
        return fn
    }
    let count = fewer(len(args), len(inst.context))
    let dicts = Array.init(count, fun(i) {
        let p = inst.context[i]
        let want = Decls.substitute(p.args[0], mapping)
        -- No givens: an instance's context arrives as its own parameters, which
        -- `instanceGivens` supplies where those are in scope.
        evidence(l, args[i], dictType(l, p.name, want), Map.new())
    })
    -- The solver proved each equality at this match, and a coercion carries
    -- nothing but its type.
    let coercions = Array.map(Classes.equalitiesAt(inst, mapping), fun(q) =
        coercion(q.args[0], q.args[1], None))
    let argTerms = Array.append(dicts, coercions)
    fn.ty = TFun(Array.map(argTerms, _.ty), result)
    node(result, None, CApp(fn, argTerms))
}

-- The dictionary variables in scope at a use, and their types. Recorded by the
-- solver as it descended, and needed here because a dictionary reference names a
-- variable and a path but not the class the variable's own dictionary has.
fun givensOf(l : Lowerer, u : Use) -> Map String Ty.Type {
    let out = Map.new()
    for sc in u.scopes {
        for (name, p) in sc.givens {
            if Classes.isClass(l.classes, p.name) {
                Map.put(out, name, predType(l, p))
            }
        }
    }
    out
}

-- The dictionaries an instance's own methods have in scope: its context's, under
-- the names the plan gave them.
fun instanceGivens(l : Lowerer, inst : InstInfo,
                   plan : InstancePlan) -> Map String Ty.Type {
    let out = Map.new()
    for var i = 0; i < len(plan.params) && i < len(inst.context); i = i + 1 {
        let p = inst.context[i]
        Map.put(out, plan.params[i], dictType(l, p.name, p.args[0]))
    }
    out
}

fun predType(l : Lowerer, p : Pred) -> Ty.Type =
    dictType(l, p.name, resolved(l, p.args[0]))

-- A type from the solver's own records, read the way a node's type is read:
-- reduced, and back in terms of variables rather than skolems.
fun resolved(l : Lowerer, t : Ty.Type) -> Ty.Type =
    rigidly(l, Typed.resolve(l.types, t))

-- The type a dictionary type classifies: the `t` of `%Dict.C t`.
fun dictArg(t : Ty.Type) -> Ty.Type = match Ty.prune(t) {
    TApp(_, arg, _) -> arg
    _ -> oops("not a dictionary type: " + Ty.show(t), None)
}

-- -- functions ---------------------------------------------------------------------

fun funType(l : Lowerer, decl : FunDecl) -> Ty.Type = match decl.body {
    Some(b) -> typeOfExpr(l, b)
    None -> oops("a function with no body reached the lowering",
                 Some(decl.span))
}

-- A `fun` declaration, as a lambda -- possibly under one over its
-- dictionaries and the coercions for `equalities`.
fun function(l : Lowerer, decl : FunDecl, ty : Ty.Type, scope : Scope,
             dictParams : Option (Vec String), preds : Option (Vec Pred),
             equalities : Vec (Ty.Type, Ty.Type)) -> Core {
    let body = match decl.body {
        Some(b) -> b
        None -> oops("a function with no body reached the lowering",
                     Some(decl.span))
    }
    let dicts = abstractionOf(l, decl.id)
    var params = dictParams
    var ps = preds
    match dicts {
        Some(a) -> if Option.isNone(dictParams) && len(a.params) > 0 {
            params = Some(a.params)
            ps = Some(a.preds)
        }
        None -> {}
    }
    let bound = dictBinders(l, Option.unwrapOr(params, []), Option.unwrapOr(ps, []))
    let inner = withDicts(l, bound, fun() {
        let saved = signatureSkolems(l, dicts, ty)
        let made = lambdaOf(l, decl.params, body, ty, Some(decl.span), scope, decl.name)
        l.rigid = saved
        made
    })
    wrapDicts(l, inner, bound, Option.unwrapOr(ps, []), equalities, Some(decl.span))
}

-- The constant-to-variable map for a signature-checked body.
--
-- A method body sets this elsewhere; this is the other case, a `fun` whose own
-- declared type was checked against skolems. If the declaration has no signature
-- there is nothing rigid in it and the map is left exactly as it was -- which
-- matters: a *method* declared inside an instance has no signature of its own,
-- so this path finds nothing to say, and must not thereby erase what the
-- instance said.
fun signatureSkolems(l : Lowerer, dicts : Option Abstraction,
                     ty : Ty.Type) -> Map String VarCell {
    let saved = l.rigid
    match dicts {
        None -> return saved
        Some(a) -> {
            if len(Map.keys(a.skolems)) == 0 { return saved }
            let byId = Map.new()
            for v in Ty.varsOf([ty]) { Map.put(byId, v.id, v) }
            let rigid = Map.new()
            for (varId, con) in Map.entries(a.skolems) {
                match (Map.get(byId, varId), con) {
                    (Some(v), TCon(c)) -> Map.put(rigid, c.name, v)
                    _ -> {}
                }
            }
            l.rigid = rigid
            saved
        }
    }
}

-- Returns the binders of a lambda over the dictionaries `names`, one for
-- each of `preds`.
fun dictBinders(l : Lowerer, names : Vec String, preds : Vec Pred) -> Array (String, Int) =
    mintDicts(l, Array.init(fewer(len(names), len(preds)), fun(i) = names[i]))

-- `inner` under a lambda over the dictionaries `bound`, at `preds`, and then a
-- coercion for each of `equalities`, or `inner` itself when there are none.
-- Nothing refers to a coercion parameter: what it grants is in scope for the
-- lambda's body.
fun wrapDicts(l : Lowerer, inner : Core, bound : Array (String, Int), preds : Vec Pred,
              equalities : Vec (Ty.Type, Ty.Type), where : Option Span) -> Core {
    if len(bound) == 0 && len(equalities) == 0 { return inner }
    let dicts = Array.init(len(bound), fun(i) {
        let (name, id) = bound[i]
        CParam { name = name, id = id, ty = dictType(l, preds[i].name, preds[i].args[0]) }
    })
    let coercions = Array.map(Vec.toArray(equalities), fun((left, right)) =
        CParam { name = "%co", id = mint(l, "%co"), ty = coercionOf(left, right) })
    let cparams = Array.append(dicts, coercions)
    node(TFun(Array.map(cparams, _.ty), inner.ty), where,
         CLam(cparams, inner, "<anonymous>"))
}

-- Returns `lower()` under a lambda over the dictionaries `dicts` takes, which
-- are in scope while it runs, and the coercions for `equalities`.
fun abstract(l : Lowerer, dicts : Option Abstraction, equalities : Vec (Ty.Type, Ty.Type),
             lower : fun() -> Core) -> Core {
    let (bound, preds) = match dicts {
        None -> ([], [])
        Some(a) -> (dictBinders(l, a.params, a.preds), a.preds)
    }
    let value = withDicts(l, bound, lower)
    wrapDicts(l, value, bound, preds, equalities, value.span)
}

-- Parameters come from the function's *type*, not from the patterns.
--
-- A parameter is a pattern, and a pattern binds no type of its own that anything
-- recorded. The function type has one entry per parameter and is recorded, so
-- that is where the types come from -- and a parameter that is not a plain name
-- becomes a fresh binder plus a `match`, which is what it always meant.
fun lambdaOf(l : Lowerer, params : Vec Pat, body : Expr, ty : Ty.Type,
             where : Option Span, scope : Scope, name : String) -> Core {
    let (fnParams, fnRet) = match Ty.prune(ty) {
        TFun(ps, r) -> (ps, r)
        _ -> oops("a function whose type is not one: " + Ty.show(ty), where)
    }
    let inner = childScope(scope)
    let matches = Vec.new(2)
    let assigned = assignedIn(l, ChExpr(body))
    let cells = Vec.new(2)
    let count = fewer(len(params), len(fnParams))
    let cparams = Array.init(count, fun(i) {
        let bare = unannot(params[i])
        let pty = fnParams[i]
        match bare.kind {
            PVar(pname) -> {
                let id = patternBinder(l, bare)
                if Set.contains(assigned, id) { Vec.push(cells, (pname, id, pty)) }
                CParam { name = pname, id = id, ty = pty }
            }
            PWild -> freshParam(l, "wild", pty)
            _ -> {
                let holder = freshParam(l, "param", pty)
                Vec.push(matches, (holder, bare))
                holder
            }
        }
    })
    -- A destructured parameter's binders are reassignable too, so any the body
    -- writes become cells, exactly as a named parameter's would. Collected
    -- across every pattern first, because the body is lowered once, inside all
    -- of them.
    let patternCells = Vec.new(2)
    for (_, pat) in matches {
        for (pname, id, pty) in patternBinders(l, pat) {
            if Set.contains(assigned, id) { Vec.push(patternCells, (pname, id, pty)) }
        }
    }
    let wrapped = Vec.append(cells, patternCells)
    let cellIds = Array.map(wrapped, fun((pname, id, _)) = copyOf(l, pname, id))
    for var i = 0; i < len(wrapped); i = i + 1 {
        let (pname, id, _) = wrapped[i]
        Map.put(inner.cells, id, (pname, cellIds[i]))
    }
    -- A lambda is its own function: the `return` in it is this one's, and the
    -- `break` in it cannot be an enclosing loop's, because a closure outlives the
    -- frame that bound that loop's join. So all three targets start again here,
    -- and `return` gets one exactly where the body has a `return` to use it.
    inner.ret = None
    inner.brk = None
    inner.cont = None
    -- The evidence a destructured parameter opens is in scope over the body,
    -- as its variables are.
    let evidence = []
    for (_, pat) in matches {
        for b in openPattern(l, pat) { Vec.push(evidence, b) }
    }
    var joined : Option ((String, Int), CParam) = None
    var out = node(TBottom, where, CUnit)
    if holdsReturn(ChExpr(body)) {
        let ret = freshName(l, "ret")
        joined = Some((ret, freshParam(l, "rv", fnRet)))
        inner.ret = Some(ret)
        out = withDicts(l, Vec.toArray(evidence), fun() = conv(l, body, inner, Some(ret)))
    } else {
        out = withDicts(l, Vec.toArray(evidence), fun() = expr(l, body, inner))
    }
    -- Each cell holds its binder's value, and is bound inside the binder: a
    -- destructured parameter's cells inside the match that binds it, a named
    -- parameter's inside the lambda.
    for var i = len(wrapped) - 1; i >= len(cells); i = i - 1 {
        out = cellAround(wrapped[i], cellIds[i], out, where)
    }
    for var i = len(matches) - 1; i >= 0; i = i - 1 {
        let (holder, pat) = matches[i]
        out = matched(l, paramVar(holder, where), [(pat, out)], out.ty, where)
    }
    for var i = len(cells) - 1; i >= 0; i = i - 1 {
        out = cellAround(wrapped[i], cellIds[i], out, where)
    }
    match joined {
        Some(((retName, retId), value)) -> {
            out = node(fnRet, where, CJoin(retName, retId, [value],
                paramVar(value, where), out, False))
        }
        None -> {}
    }
    node(TFun(fnParams, fnRet), where, CLam(cparams, out, name))
}

-- -- expressions -------------------------------------------------------------------

-- One expression, as a term whose value is the value of the whole.
--
-- Three answers, in the order they are asked for. A node A-normalization has
-- already lowered stands for what it lowered to. A node holding a loop or a
-- transfer goes to `conv`, which is the only thing that knows how to give those
-- a value. Everything else is the ordinary walk.
fun expr(l : Lowerer, e : Expr, scope : Scope) -> Core {
    match Map.get(l.placeholders, e.id) {
        Some(held) -> return held
        None -> {}
    }
    if special(ChExpr(e)) { return conv(l, e, scope, None) }
    dispatch(l, e, scope)
}

fun typeOfExpr(l : Lowerer, e : Expr) -> Ty.Type = rigidly(l, Typed.of_(l.types, e))

-- A type read out of a method body, back in terms of variables.
--
-- Outside a method body this is the identity. Inside one it undoes the
-- skolemization the generator applied: the instance's own variable comes back,
-- so the body agrees with the dictionary that holds it.
fun rigidly(l : Lowerer, t : Ty.Type) -> Ty.Type {
    if len(Map.keys(l.rigid)) == 0 { return t }
    unskolem(t, l.rigid)
}

-- Replace the rigid constants of a method body with their variables.
--
-- Substitution cannot do this: it maps variables to types, and here it is
-- constants that have to go. A skolem is a constructor whose name is the one the
-- declaration wrote, which is what makes the map keyable by name.
fun unskolem(t : Ty.Type, rigid : Map String VarCell) -> Ty.Type =
    match Ty.prune(t) {
        TCon(c) -> match Map.get(rigid, c.name) {
            Some(v) -> TVar(v)
            None -> Ty.prune(t)
        }
        TApp(fn, arg, k) -> TApp(unskolem(fn, rigid), unskolem(arg, rigid), k)
        TFam(name, arg, k) -> TFam(name, unskolem(arg, rigid), k)
        TFun(params, ret) -> TFun(Array.map(params, unskolem(_, rigid)),
                                  unskolem(ret, rigid))
        TTuple(elems) -> TTuple(Array.map(elems, unskolem(_, rigid)))
        _ -> Ty.prune(t)
    }

fun dispatch(l : Lowerer, e : Expr, scope : Scope) -> Core {
    let ty = typeOfExpr(l, e)
    let where = Some(e.span)
    match e.kind {
        ELit(lit) -> node(ty, where, CLit(lit))
        EUnit -> node(ty, where, CUnit)
        -- Constructor values are ordinary functions in Core. Kept in
        -- elaboration, so every pass after it sees the lambda.
        ECon(name) -> conValue(l, e, name, ty, where)
        EVar(_, _) -> var_(l, e, scope)
        ETuple(elems) -> node(ty, where,
            CTuple(Array.map(elems, expr(l, _, scope))))
        EArray(elems) -> arrayLiteral(l, e, ty, elems, scope)
        ERecord(con, fields) -> {
            match Decls.con(l.decls, con) {
                Some(info) -> if len(info.exists) > 0 {
                    return existentialRecord(l, e, info, con, fields, ty, where,
                                             scope)
                }
                None -> {}
            }
            let out = Array.map(fields, fun((n, v)) = (n, expr(l, v, scope)))
            recordLiteral(l, con, out, ty, where)
        }
        EField(obj, name) -> {
            let target = expr(l, obj, scope)
            match passedAccessors(l, e) {
                Some(dicts) -> node(ty, where, CApp(
                    node(TFun([target.ty], ty), where,
                         CSlot(dicts[0], accessorSlot(l, dicts[0], "get", where))),
                    [target]))
                None -> node(ty, where, CProject(target, knownPosition(l, target, name, where)))
            }
        }
        EProject(obj, index) -> node(ty, where,
            CProject(expr(l, obj, scope), index))
        EIndex(arr, index, _, _) -> node(ty, where,
            CIndex(expr(l, arr, scope), expr(l, index, scope)))
        ELambda(params, _, body) ->
            lambdaOf(l, params, body, ty, where, scope, "<anonymous>")
        ECall(fn, args) -> {
            let supplied = Array.map(args, expr(l, _, scope))
            var callee = fn
            loop {
                match callee.kind {
                    EAnnot(inner, _) -> { callee = inner }
                    _ -> break
                }
            }
            match callee.kind {
                -- A saturated constructor already has the allocation shape;
                -- expanding it would build a lambda only to apply it again.
                ECon(name) -> {
                    let dicts = carried(l, callee)
                    if len(dicts) > 0 {
                        node(ty, where, CApp(
                            packing(dicts, typeOfExpr(l, callee), name,
                                    Some(callee.span)),
                            Array.append(dicts, supplied)))
                    } else {
                        node(ty, where, CApp(
                            node(typeOfExpr(l, callee), Some(callee.span),
                                 CCon(name)),
                            supplied))
                    }
                }
                _ -> node(ty, where, CApp(expr(l, fn, scope), supplied))
            }
        }
        -- An annotation constrained inference and has nothing left to say.
        EAnnot(inner, _) -> expr(l, inner, scope)
        EUnary(_, operand, fn) -> {
            let lowered = expr(l, operand, scope)
            match fn {
                -- `!x`, which is not a method.
                None -> node(ty, where, CApp(
                    node(TFun([Ty.tBool()], Ty.tBool()), where,
                         CPrim(Prims.Not)), [lowered]))
                Some(f) -> node(ty, where, CApp(var_(l, f, scope), [lowered]))
            }
        }
        EBinary(op, left, right, fn) -> binary(l, e, ty, op, left, right, fn, scope)
        EIf(cond, then, otherwise) -> node(ty, where, CIf(
            expr(l, cond, scope), expr(l, then, scope),
            match otherwise {
                Some(o) -> Some(expr(l, o, scope))
                None -> None
            }))
        EMatch(scrutinee, arms) -> matchedArms(l, expr(l, scrutinee, scope),
            armBodies(l, arms, ty, scope, fun(body, inner) = expr(l, body, inner)),
            ty, where)
        EBlock(stmts) -> block(l, stmts, ty, where, childScope(scope))
        _ -> oops("cannot lower this expression", where)
    }
}

fun arrayLiteral(l : Lowerer, e : Expr, public : Ty.Type, elems : Vec Expr,
                 scope : Scope) -> Core {
    let where = Some(e.span)
    let (_, args) = Ty.spine(public)
    let element = if len(args) == 1 { args[0] } else { TBottom }
    let raw = node(Ty.rawArrayOf(element), where,
        CArray(Array.map(elems, expr(l, _, scope))))
    -- Inference has chosen the container. An `Array` is the raw array under
    -- its constructor; a `Vec` is the raw array as the storage of a
    -- `VecStorage` record, with its length, under `Vec`.
    match Ty.headCon(public) {
        Some("Data.Vec#Vec") -> {
            let storageName = "Data.Vec#VecStorage"
            let length = node(Ty.tInt(), where, CLit(LInt(len(elems))))
            let storageTy = Ty.applyTo(Decls.head(l.decls, storageName), [element],
                                       where)
            let storage = recordLiteral(l, storageName,
                [("storage", raw), ("length", length)], storageTy, where)
            let constructor = node(TFun([storageTy], public), where,
                                   CCon("Data.Vec#Vec"))
            node(public, where, CApp(constructor, [storage]))
        }
        _ -> {
            let constructor = node(TFun([raw.ty], public), where,
                                   CCon("Data.Array#Array"))
            node(public, where, CApp(constructor, [raw]))
        }
    }
}

fun binary(l : Lowerer, e : Expr, ty : Ty.Type, op : String, left : Expr,
           right : Expr, fn : Option Expr, scope : Scope) -> Core {
    let where = Some(e.span)
    if op == "&&" || op == "||" {
        -- These two short-circuit, so they are the `if` they already mean. The
        -- left operand is bound first because it is both the test and, when it
        -- decides the answer, the answer.
        let lo = expr(l, left, scope)
        let ro = expr(l, right, scope)
        let (name, id) = freshName(l, "b")
        let held = node(lo.ty, where, CVar(refAt(l, name, id)))
        let branch = if op == "&&" {
            node(ty, where, CIf(held, ro, Some(held)))
        } else {
            node(ty, where, CIf(held, held, Some(ro)))
        }
        return node(ty, where, CLet(name, id, lo.ty, lo, branch, []))
    }
    match fn {
        Some(f) -> node(ty, where, CApp(var_(l, f, scope),
            [expr(l, left, scope), expr(l, right, scope)]))
        None -> oops("operator '" + op + "' has no method", where)
    }
}

-- The constructor a builtin the compile fixes stands for in this compile.
fun chosen(l : Lowerer, c : Prims.Choice, where : Option Span) -> String = match c {
    Prims.TargetOs -> targetConstructor(l, l.target.os, where)
    Prims.TargetArch -> targetConstructor(l, l.target.arch, where)
    Prims.GcVerify -> Build.boolean(l.build.gcVerify)
    Prims.GcStats -> Build.boolean(l.build.gcStats)
}

fun targetConstructor(l : Lowerer, short : String, where : Option Span) -> String {
    let con = P.internal(P.targetName, short)
    if !Map.contains(l.decls.constructors, con) {
        oops("the target '" + l.target.spelling + "' needs '" + con
             + "', which lib/Target.gob does not declare", where)
    }
    con
}

-- A name: possibly a projection, possibly applied to types and dictionaries.
--
-- The three steps are in the order they were abstracted in, which is the only
-- order that typechecks: select or name the value, apply its type arguments,
-- then apply its dictionaries.
fun var_(l : Lowerer, e : Expr, scope : Scope) -> Core {
    let name = match e.kind {
        EVar(n, _) -> n
        _ -> oops("not a variable", Some(e.span))
    }
    let result = typeOfExpr(l, e)
    let where = Some(e.span)
    let id = binderOf(l, e.id, name, where)
    let u = Map.get(l.types.uses, e.id)
    let plain = match u {
        None -> True
        Some(x) -> len(x.evidence) == 0 && len(x.typeArgs) == 0
    }
    if plain {
        match cellOf(scope, id) {
            Some((cell, cellId)) -> return node(result, where,
                CDeref(node(refOf(result), where, CVar(refAt(l, cell, cellId)))))
            None -> {}
        }
        let binders = bindersOf(l, id, name, scope)
        if len(binders) > 0 {
            -- A recursive occurrence: monomorphic to inference, still a type
            -- application here, at the binding's own variables, and applied to
            -- the coercions it takes at them.
            let applied = CTyApp(node(unknown(), where, CVar(refAt(l, name, id))),
                                 Array.map(binders, TVar))
            let own = ownCoercions(l, id, name, scope, where)
            if len(own) == 0 { return node(result, where, applied) }
            return node(result, where, CApp(
                node(TFun(Array.map(own, _.ty), result), where, applied), own))
        }
        return match Prims.parse(name) {
            Some(Prims.Fixed(c)) -> node(result, where, CCon(chosen(l, c, where)))
            Some(Prims.Machine(p)) -> node(result, where, CPrim(p))
            None -> node(result, where, CVar(refAt(l, name, id)))
        }
    }
    let use = match u {
        Some(x) -> x
        None -> oops("a use vanished", where)
    }
    let givens = givensOf(l, use)
    let count = fewer(len(use.evidence), len(use.preds))
    var dicts = Array.init(count, fun(i) = evidence(l, use.evidence[i], predType(l, use.preds[i]),
                                                    givens))
    var coercions = Array.map(Vec.toArray(use.equalities), fun(p) =
        coercion(resolved(l, p.args[0]), resolved(l, p.args[1]), where))
    var typeArgs = Array.map(use.typeArgs, resolved(l, _))
    -- A polymorphic primitive, applied to its type arguments below. A `Fixed`
    -- one is monomorphic and took the path above.
    var base = node(unknown(), where, match Prims.parse(name) {
        Some(Prims.Machine(p)) -> CPrim(p)
        Some(Prims.Fixed(_)) | None -> CVar(refAt(l, name, id))
    })
    match use.method {
        Some(mi) -> {
            -- The class's own dictionary is the first predicate, by the
            -- convention the method's scheme sets up; the method is a field of
            -- it and the rest, if any, are the method's own context.
            base = node(unknown(), where,
                        CSlot(dicts[0], slotFor(l, mi.cls, mi.name, where)))
            dicts = Array.slice(dicts, 1, len(dicts))
            -- And the class variable is *already* fixed, by the dictionary the
            -- method was projected from. It is one of the method scheme's
            -- quantified variables, so it is one of the recorded type arguments
            -- -- but applying it here would fix it a second time, which is the
            -- same variable bound twice and no longer a type application.
            typeArgs = withoutClassVar(mi, typeArgs)
        }
        None -> if len(typeArgs) == 0 {
            -- A recursive or mutually recursive occurrence: the group is bound
            -- monomorphically while its own bodies are checked, so nothing was
            -- recorded, and the application is at the group's own variables. It
            -- does carry dictionaries -- the solver patched those in -- which is
            -- why the test cannot be "no evidence either". Its coercions are
            -- the group's own too, at its own variables.
            typeArgs = Array.map(bindersOf(l, id, name, scope), TVar)
            coercions = ownCoercions(l, id, name, scope, where)
        }
    }
    dicts = Array.append(dicts, coercions)
    let afterTypes = if len(dicts) > 0 {
        TFun(Array.map(dicts, _.ty), result)
    } else { result }
    if len(typeArgs) > 0 {
        base.ty = unknown()
        base = node(afterTypes, where, CTyApp(base, typeArgs))
    } else {
        base.ty = afterTypes
    }
    if len(dicts) > 0 { node(result, where, CApp(base, dicts)) } else { base }
}

-- The coercions an occurrence of the binder `id`, spelled `name`, inside its
-- own definition passes: one for each equality the binding takes, at its own
-- variables. Inference bound the name monomorphically there, so the
-- occurrence demanded none.
fun ownCoercions(l : Lowerer, id : Int, name : String, scope : Scope,
                 where : Option Span) -> Array Core {
    let equalities = match localEqualities(scope, id) {
        Some(found) -> found
        None -> equalitiesOf(schemeOf(l, name))
    }
    Array.map(Vec.toArray(equalities), fun((left, right)) = coercion(left, right, where))
}

-- A method's type arguments, less the one its dictionary already fixed. They are
-- in the scheme's quantified order, so the class variable's position in that
-- list is the position to drop.
fun withoutClassVar(mi : MethodInfo, typeArgs : Array Ty.Type) -> Array Ty.Type {
    let quantified = mi.scheme.quantified
    if len(typeArgs) != len(quantified) { return typeArgs }
    var at = -1
    for var i = 0; i < len(quantified); i = i + 1 {
        if quantified[i].id == mi.classVar.id { at = i }
    }
    if at < 0 { return typeArgs }
    Array.init(len(typeArgs) - 1, fun(i) = if i < at { typeArgs[i] } else { typeArgs[i + 1] })
}

fun oops(message : String, where : Option Span) -> a = match where {
    None -> Diag.fail(Diag.whole("internal error", message), "")
    Some(s) -> Diag.fail(Diag.at("internal error", message, s), s.file)
}

fun discard(x : a) -> Unit = {}

-- How many of a pair of arrays walked in step there are.
fun fewer(a : Int, b : Int) -> Int = if a < b { a } else { b }

-- -- loops and transfers, as join points ---------------------------------------------
--
-- The shape. Every function whose body contains a `return` is wrapped in a join:
--
--     fun(x) { join %ret(%rv) = %rv in <body, every return a jump to %ret> }
--
-- and every loop becomes one recursive join and, when nothing is already waiting
-- for the loop's value, one more for what follows it:
--
--     join %af(%v) = <what follows>
--     in join rec %lp() = <one iteration, ending in a jump to %lp or %af>
--        in jump %lp()
--
-- `break` jumps to the after-join and `continue` to the loop's -- or, for a
-- C-style `for`, to a third join holding the step, since `continue` there runs
-- the step before the test. A loop in a statement position is already a `let`
-- binding it, so the after-join is that continuation and the common case adds
-- one join rather than two.

-- An expression, lowered so that its value reaches `k`.
--
-- `k` is a join name, or `None` meaning "the value of this term is the value of
-- the term it stands in". Every rule below either produces a value in place or
-- ends in a jump, which is what makes the result satisfy the tail-position rule
-- without any rule having to check it.
fun conv(l : Lowerer, e : Expr, scope : Scope, k : Option (String, Int)) -> Core {
    match Map.get(l.placeholders, e.id) {
        Some(held) -> return finish(l, held, k)
        None -> {}
    }
    if !special(ChExpr(e)) { return finish(l, dispatch(l, e, scope), k) }
    let where = Some(e.span)
    match e.kind {
        EAnnot(inner, _) -> conv(l, inner, scope, k)
        EReturn(value) -> transfer(l, scope.ret, value, where, scope,
                                   "a 'return' outside a function")
        EBreak(value) -> transfer(l, scope.brk, value, where, scope,
                                  "a 'break' outside a loop")
        EContinue -> match scope.cont {
            None -> oops("a 'continue' outside a loop", where)
            Some((target, targetId)) -> node(TBottom, where, CJump(refTo(target, targetId), []))
        }
        EBlock(stmts) -> convBlock(l, stmts, typeOfExpr(l, e), where,
                                   childScope(scope), k)
        EIf(cond, then, otherwise) -> convIf(l, e, cond, then, otherwise, scope, k)
        EMatch(scrutinee, arms) -> convMatch(l, e, scrutinee, arms, scope, k)
        EBinary(op, left, right, _) -> if op == "&&" || op == "||" {
            convShortCircuit(l, e, op, left, right, scope, k)
        } else { anf(l, e, scope, k) }
        EWhile(_, _) -> lowerLoop(l, e, scope, k)
        ELoop(_) -> lowerLoop(l, e, scope, k)
        EForC(_, _, _, _) -> lowerLoop(l, e, scope, k)
        EForIn(_, _, _, _, _) -> lowerLoop(l, e, scope, k)
        _ -> anf(l, e, scope, k)
    }
}

fun finish(l : Lowerer, value : Core, k : Option (String, Int)) -> Core = match k {
    None -> value
    Some((target, id)) -> node(TBottom, value.span, CJump(refTo(target, id), [value]))
}

-- `return e` and `break e`, which carry a value where `continue` does not. A
-- bare one carries unit, which is what the value of the thing it leaves already
-- was.
fun transfer(l : Lowerer, target : Option (String, Int), value : Option Expr,
             where : Option Span, scope : Scope, complaint : String) -> Core {
    let (name, id) = match target {
        Some(t) -> t
        None -> oops(complaint, where)
    }
    match value {
        None -> node(TBottom, where,
                     CJump(refTo(name, id), [node(unitType(), where, CUnit)]))
        Some(v) -> conv(l, v, scope, Some((name, id)))
    }
}

-- An `if` whose branches are the interesting part.
--
-- A jump goes in each branch and `k` is a *name*, so the continuation is shared
-- rather than copied -- which is the property join points exist for.
--
-- An `if` with no `else` still has to reach `k` when it takes the branch that is
-- not written: `if c { return None }` in a statement position falls through with
-- unit, and a fall-through is exactly what this promises not to leave. So the
-- missing arm is supplied -- but only where a jump is actually owed.
fun convIf(l : Lowerer, e : Expr, cond : Expr, then : Expr,
           otherwise : Option Expr, scope : Scope, k : Option (String, Int)) -> Core {
    let ty = typeOfExpr(l, e)
    let where = Some(e.span)
    scrutinized(l, cond, ty, where, scope, fun(c) = {
        let thenC = conv(l, then, scope, k)
        let elseC = match otherwise {
            Some(o) -> Some(conv(l, o, scope, k))
            None -> match k {
                Some(_) -> Some(finish(l, node(unitType(), where, CUnit), k))
                None -> None
            }
        }
        node(ty, where, CIf(c, thenC, elseC))
    })
}

fun convMatch(l : Lowerer, e : Expr, scrutinee : Expr, arms : Vec Arm,
              scope : Scope, k : Option (String, Int)) -> Core {
    let ty = typeOfExpr(l, e)
    let where = Some(e.span)
    scrutinized(l, scrutinee, ty, where, scope, fun(s) = matchedArms(l, s,
        armBodies(l, arms, ty, scope, fun(body, inner) = conv(l, body, inner, k)),
        ty, where))
}

-- Returns each arm's code for each of its patterns, with `lower` lowering a
-- body in a scope. `ty` is the type of the `match`.
fun armBodies(l : Lowerer, arms : Vec Arm, ty : Ty.Type, scope : Scope,
              lower : fun(Expr, Scope) -> Core) -> Arms {
    let out = newArms()
    for arm in arms {
        let where = Some(arm.span)
        for var k = 0; k < len(arm.patterns); k = k + 1 {
            let pat = arm.patterns[k]
            let copies = if k == 0 { l.copies } else {
                let bound = []
                Binders.boundIn(l.binders, ChArm(arm), bound)
                copiesOf(l, bound)
            }
            let evidence = openPattern(l, pat)
            -- A guarded body is lowered when the `match` is compiled, after
            -- this loop, so it puts its copies and evidence back in place
            -- itself.
            let body = if len(arm.guards) == 0 {
                Match.Taken(under(l, copies, fun() = withDicts(l, evidence, fun() =
                    celled(l, pat, ChArm(arm), lower(arm.body, _), childScope(scope),
                           where))))
            } else {
                Match.Guarded(fun(fail) = under(l, copies, fun() = withDicts(l, evidence,
                    fun() = celled(l, pat, ChArm(arm), guarded(l, arm, 0, ty, _, lower, fail),
                                   childScope(scope), where))))
            }
            under(l, copies, fun() = addArm(l, out, pat, body))
        }
    }
    out
}

-- Returns code that runs guards `i` onwards of `arm` and then its body, and
-- jumps to `fail` when a guard does not hold.
--
-- A `let` guard is a `match` of its own, whose last arm is that jump. The
-- guards after it, and the body, are lowered once per pattern of that guard,
-- as an arm's body is lowered once per pattern of the arm.
fun guarded(l : Lowerer, arm : Arm, i : Int, ty : Ty.Type, scope : Scope,
            lower : fun(Expr, Scope) -> Core, fail : (String, Int)) -> Core {
    if i == len(arm.guards) { return lower(arm.body, scope) }
    let g = arm.guards[i]
    let where = Some(guardExpr(g).span)
    let failing = jumpTo(fail, where)
    match g {
        GTest(test) -> scrutinized(l, test, ty, where, scope, fun(c) =
            node(ty, where, CIf(c, guarded(l, arm, i + 1, ty, scope, lower, fail),
                                Some(failing))))
        GLet(patterns, value) -> scrutinized(l, value, ty, where, scope, fun(v) = {
            let alts = newArms()
            for var k = 0; k < len(patterns); k = k + 1 {
                let pat = patterns[k]
                let copies = if k == 0 { l.copies } else { copiesOf(l, boundFrom(l, arm, i)) }
                under(l, copies, fun() = addArm(l, alts, pat, Match.Taken(celled(l, pat,
                    ChArm(arm), guarded(l, arm, i + 1, ty, _, lower, fail),
                    childScope(scope), where))))
            }
            let other = Pat { id = patterns[0].id, span = patterns[0].span,
                              kind = PWild, opening = None }
            addArm(l, alts, other, Match.Taken(failing))
            matchedArms(l, v, alts, ty, where)
        })
    }
}

-- Returns the binders that the patterns of guard `i` of `arm` bind, and the
-- guards after it, and the arm's body: what an alternative of that guard
-- lowers again.
fun boundFrom(l : Lowerer, arm : Arm, i : Int) -> Vec Int {
    let out = []
    if let GLet(patterns, _) = arm.guards[i] {
        for p in patterns { Binders.boundByPattern(l.binders, p, out) }
    }
    for var j = i + 1; j < len(arm.guards); j = j + 1 {
        match arm.guards[j] {
            GTest(test) -> Binders.boundIn(l.binders, ChExpr(test), out)
            GLet(patterns, value) -> {
                for p in patterns { Binders.boundByPattern(l.binders, p, out) }
                Binders.boundIn(l.binders, ChExpr(value), out)
            }
        }
    }
    Binders.boundIn(l.binders, ChExpr(arm.body), out)
    out
}

-- A branch whose *scrutinee* may itself hold a transfer, which has to run before
-- the branch is taken and so becomes a join of its own.
fun scrutinized(l : Lowerer, e : Expr, ty : Ty.Type, where : Option Span,
                scope : Scope, build : fun(Core) -> Core) -> Core {
    if !special(ChExpr(e)) { return build(expr(l, e, scope)) }
    let (name, id) = freshName(l, "on")
    let value = freshParam(l, "sv", typeOfExpr(l, e))
    node(ty, where, CJoin(name, id, [value],
        build(paramVar(value, where)),
        conv(l, e, scope, Some((name, id))), False))
}

-- `&&` and `||`, whose right operand a transfer must not escape past. The `if`
-- they already mean, with the branches converted, so that a `break` on the right
-- of an `&&` is taken only when the left was true.
fun convShortCircuit(l : Lowerer, e : Expr, op : String, left : Expr,
                     right : Expr, scope : Scope, k : Option (String, Int)) -> Core {
    let ty = typeOfExpr(l, e)
    let where = Some(e.span)
    let (name, id) = freshName(l, "b")
    scrutinized(l, left, ty, where, scope, fun(lo) = {
        let held = node(lo.ty, where, CVar(refAt(l, name, id)))
        let ro = conv(l, right, scope, k)
        let kept = finish(l, held, k)
        let branch = if op == "&&" {
            node(ty, where, CIf(held, ro, Some(kept)))
        } else {
            node(ty, where, CIf(held, kept, Some(ro)))
        }
        node(ty, where, CLet(name, id, lo.ty, lo, branch, []))
    })
}

-- A node whose *operands* hold a transfer: `push(ops, match c {...})`.
--
-- What makes it awkward is evaluation order: hoisting the `match` out and
-- leaving `ops` in place would evaluate `ops` after it, and evaluation is strict
-- and left to right. So every operand up to and including the last special one
-- is bound, in order, each to a join whose body is the next -- which is A-normal
-- form, arrived at because the order has to be preserved rather than because the
-- form is desirable. Operands after the last special one are left where they
-- are: nothing has moved past them.
--
-- The node itself is then lowered by its ordinary rule, with the bound operands
-- standing for what they were bound to. That is what the placeholders are: the
-- ordinary rule neither knows nor needs to know that one of its arguments
-- arrived as a jump.
fun anf(l : Lowerer, e : Expr, scope : Scope, k : Option (String, Int)) -> Core {
    let where = Some(e.span)
    let kids = match operands(e) {
        Some(cs) -> cs
        None -> oops("a control transfer inside this expression", where)
    }
    var last = 0 - 1
    for var i = 0; i < len(kids); i = i + 1 {
        if special(ChExpr(kids[i])) { last = i }
    }
    if last < 0 {
        oops("a control transfer inside this expression", where)
    }
    let bound = Vec.slice(kids, 0, last + 1)
    let joins = Array.map(bound, fun(child) =
        (freshName(l, "arg"), freshParam(l, "av", typeOfExpr(l, child))))
    for var i = 0; i < len(bound); i = i + 1 {
        let (_, value) = joins[i]
        Map.put(l.placeholders, bound[i].id, paramVar(value, where))
    }
    var made = finish(l, dispatch(l, e, scope), k)
    for child in bound { discard(Map.delete(l.placeholders, child.id)) }
    let ty = typeOfExpr(l, e)
    for var i = len(bound) - 1; i >= 0; i = i - 1 {
        let ((name, id), value) = joins[i]
        made = node(ty, where, CJoin(name, id, [value], made,
            conv(l, bound[i], scope, Some((name, id))), False))
    }
    made
}

-- -- the four loop forms ------------------------------------------------------------

-- Any of the four, as a recursive join and the jumps into it.
--
-- One recursive join for the iteration and, when there is nothing already
-- waiting for the loop's value, one more for what follows it. Then the four
-- forms differ only in what one iteration is.
fun lowerLoop(l : Lowerer, e : Expr, scope : Scope, k : Option (String, Int)) -> Core {
    let ty = typeOfExpr(l, e)
    let where = Some(e.span)
    var after = k
    var wrapper : Option CParam = None
    match after {
        None -> {
            let made = freshName(l, "af")
            after = Some(made)
            wrapper = Some(freshParam(l, "av", ty))
        }
        Some(_) -> {}
    }
    let (afterName, afterId) = match after {
        Some(n) -> n
        None -> ("", noId)
    }
    let (name, id) = freshName(l, "lp")
    let inner = childScope(scope)
    inner.brk = after
    let (pending, body) = iteration(l, e, inner, (name, id), (afterName, afterId))

    var made = node(TBottom, where, CJoin(name, id, [], body,
        node(TBottom, where, CJump(refTo(name, id), [])), True))
    for var i = len(pending) - 1; i >= 0; i = i - 1 {
        let (bname, bid, bty, value) = pending[i]
        made = node(TBottom, where, CLet(bname, bid, bty, value, made, []))
    }
    match wrapper {
        None -> made
        Some(w) -> node(ty, where, CJoin(afterName, afterId, [w],
            paramVar(w, where), made, False))
    }
}

-- One turn of the loop, and whatever bindings stand outside it.
--
-- `while c { b }` *is* `if c { b; continue } else { break }`, and saying so here
-- leaves one rule to be right about instead of four. The scope already carries
-- the `break` target; what each form decides is where its `continue` goes and
-- what runs before the test.
fun iteration(l : Lowerer, e : Expr, scope : Scope, name : (String, Int),
              after : (String, Int)) -> (Vec (String, Int, Ty.Type, Core), Core) {
    let where = Some(e.span)
    let (afterName, afterId) = after
    let stop = node(TBottom, where,
                    CJump(refTo(afterName, afterId), [node(unitType(), where, CUnit)]))
    match e.kind {
        ELoop(body) -> {
            scope.cont = Some(name)
            ([], seqThen(l, body, childScope(scope), jumpTo(name, where)))
        }
        EWhile(cond, body) -> {
            scope.cont = Some(name)
            let c = expr(l, cond, scope)
            let b = seqThen(l, body, childScope(scope), jumpTo(name, where))
            ([], node(TBottom, where, CIf(c, b, Some(stop))))
        }
        EForC(init, cond, step, body) ->
            forC(l, e, init, cond, step, body, scope, name, stop)
        EForIn(pat, iterable, body, iterFn, nextFn) ->
            forIn(l, e, pat, iterable, body, iterFn, nextFn, scope, name, stop)
        _ -> oops("not a loop", where)
    }
}

-- The C-style `for`, whose `continue` runs the step before the test.
--
-- So the step is a join of its own, and every `continue` this loop owns -- the
-- written ones and the one that falls off the end of the body -- names that
-- rather than the loop's. Which is the whole of the difference between this and
-- a `while`, and the reason nothing has to be duplicated at each `continue`.
--
-- The init and the step are lowered in the loop's own scope, not in a child of
-- it: `for var i = 0` binds `i` over the condition, the step and the body alike.
fun forC(l : Lowerer, e : Expr, init : Option Stmt, cond : Expr,
         step : Option Stmt, body : Expr, scope : Scope, name : (String, Int),
         stop : Core) -> (Vec (String, Int, Ty.Type, Core), Core) {
    let where = Some(e.span)
    let pending = Vec.new(2)
    match init {
        Some(s) -> {
            let lowered = stmtValue(l, s, scope)
            match lowered.kind {
                CLet(n, id, bound, value, _, _) -> Vec.push(pending, (n, id, bound, value))
                _ -> {
                    let (n, id) = freshName(l, "seq")
                    Vec.push(pending, (n, id, lowered.ty, lowered))
                }
            }
        }
        None -> {}
    }
    let c = expr(l, cond, scope)
    var stepJoin : Option ((String, Int), Core) = None
    match step {
        Some(s) -> {
            let lowered = stmtValue(l, s, scope)
            -- A statement's value is a `let` whose body is a placeholder,
            -- because a `for`'s init and step bind over the *loop* rather than
            -- over a body of their own. The init's binding is hoisted out above
            -- the loop join; what runs each turn is the step's value.
            let value = match lowered.kind {
                CLet(_, _, _, v, _, _) -> v
                _ -> lowered
            }
            stepJoin = Some((freshName(l, "st"), value))
        }
        None -> {}
    }
    scope.cont = match stepJoin {
        Some((joined, _)) -> Some(joined)
        None -> Some(name)
    }
    let contName = match scope.cont {
        Some(n) -> n
        None -> name
    }
    var made = node(TBottom, where, CIf(c,
        seqThen(l, body, childScope(scope), jumpTo(contName, where)),
        Some(stop)))
    match stepJoin {
        Some(((joined, joinedId), value)) -> {
            let (seq, seqId) = freshName(l, "seq")
            let ran = node(TBottom, where, CLet(seq, seqId, value.ty,
                value, jumpTo(name, where), []))
            made = node(TBottom, where,
                        CJoin(joined, joinedId, [], ran, made, False))
        }
        None -> {}
    }
    (pending, made)
}

-- `for p in seq`, with the cursor made explicit.
--
-- The two calls already carry the `Iterator`
-- dictionary -- that is why they are ordinary uses on the node rather than
-- something this has to find -- so what is added here is the cursor binding and
-- the `Option` match that reads what `next` answers.
--
-- Done here rather than after monomorphization, which is the point of doing it
-- at all: the Core checker runs on this pass's output, so the cursor and the
-- match are checked rather than taken on trust.
fun forIn(l : Lowerer, e : Expr, pat : Pat, iterable : Expr, body : Expr,
          iterFn : Option Expr, nextFn : Option Expr, scope : Scope,
          name : (String, Int), stop : Core) -> (Vec (String, Int, Ty.Type, Core), Core) {
    let where = Some(e.span)
    let seqCore = expr(l, iterable, scope)
    let iterCore = match iterFn {
        Some(f) -> var_(l, f, scope)
        None -> oops("a 'for' with no 'iter'", where)
    }
    let nextCore = match nextFn {
        Some(f) -> var_(l, f, scope)
        None -> oops("a 'for' with no 'next'", where)
    }
    let (cursorTy, optionTy) = match Ty.prune(nextCore.ty) {
        TFun(ps, r) -> if len(ps) == 2 { (ps[1], r) } else {
            oops("a 'for' whose `next` is not a cursor step", where)
        }
        _ -> oops("a 'for' whose `next` is not a cursor step", where)
    }
    let (some, none) = optionParts(l, optionTy, where)

    let (seqName, seqId) = freshName(l, "sq")
    let (curName, curId) = freshName(l, "cu")
    let pending = [
        (seqName, seqId, seqCore.ty, seqCore),
        (curName, curId, cursorTy, node(cursorTy, where, CApp(iterCore,
            [node(seqCore.ty, where, CVar(refAt(l, seqName, seqId)))]))),
    ]
    let step = node(optionTy, where, CApp(nextCore,
        [node(seqCore.ty, where, CVar(refAt(l, seqName, seqId))),
         node(cursorTy, where, CVar(refAt(l, curName, curId)))]))
    scope.cont = Some(name)
    let b = seqThen(l, body, childScope(scope), jumpTo(name, where))
    (pending, matched(l, step, [
        (mkPat(e, PCon(none, [])), stop),
        (mkPat(e, PCon(some, [pat])), b),
    ], TBottom, where))
}

-- A jump to the join `target`, carrying nothing.
fun jumpTo(target : (String, Int), where : Option Span) -> Core {
    let (name, id) = target
    node(TBottom, where, CJump(refTo(name, id), []))
}

fun mkPat(e : Expr, k : PatKind) -> Pat =
    Pat { id = freshNodeId(), span = e.span, kind = k, opening = None }

-- The `Option` constructors, found from the type `next` answers.
--
-- By the type rather than by name: the Prelude's `Option` is an ordinary
-- declaration under an ordinary qualified name, and a pass that spelled that
-- name out would be one more thing to keep in agreement with it.
fun optionParts(l : Lowerer, ty : Ty.Type, where : Option Span) -> (String, String) {
    let (h, args) = Ty.spine(Ty.prune(ty))
    let headName = match h {
        TCon(c) -> if len(args) == 0 {
            oops("a 'for' whose `next` answers no Option", where)
        } else { c.name }
        _ -> oops("a 'for' whose `next` answers no Option", where)
    }
    let some = Vec.new(2)
    let none = Vec.new(2)
    for (cname, info) in Map.entries(l.decls.constructors) {
        if info.tycon == headName {
            if info.arity == 1 { Vec.push(some, cname) }
            if info.arity == 0 { Vec.push(none, cname) }
        }
    }
    if len(some) != 1 || len(none) != 1 {
        oops("'" + headName + "' is not shaped like an Option", where)
    }
    (some[0], none[0])
}

-- `e; after` -- `e` run for its effect, and then `after`.
--
-- A loop body is this: it is run, its value is discarded, and what follows is
-- the jump that goes round again. When the body itself holds a transfer the
-- discarding has to be a join, since a `let` has nowhere for a jump to land.
fun seqThen(l : Lowerer, e : Expr, scope : Scope, after : Core) -> Core {
    let where = Some(e.span)
    if !special(ChExpr(e)) {
        let value = expr(l, e, scope)
        return discarded(l, value, after, where)
    }
    let (name, id) = freshName(l, "bind")
    let value = freshParam(l, "bv", typeOfExpr(l, e))
    node(after.ty, where, CJoin(name, id, [value], after,
        conv(l, e, scope, Some((name, id))), False))
}

-- `value`, run for its effect, and then `after`: a binding nothing reads.
fun discarded(l : Lowerer, value : Core, after : Core, where : Option Span) -> Core {
    let (name, id) = freshName(l, "seq")
    node(after.ty, where, CLet(name, id, value.ty, value, after, []))
}

-- -- statements, in the presence of a transfer ---------------------------------------

-- A statement sequence one of whose statements holds a transfer. The same shape
-- as an ordinary block, with the value of the last statement reaching `k` and
-- every earlier one still a binding around what follows it.
fun convBlock(l : Lowerer, stmts : Vec Stmt, ty : Ty.Type, where : Option Span,
              scope : Scope, k : Option (String, Int)) -> Core =
    convBlockFrom(l, stmts, 0, ty, where, scope, k)

fun convBlockFrom(l : Lowerer, stmts : Vec Stmt, from : Int, ty : Ty.Type,
                  where : Option Span, scope : Scope, k : Option (String, Int)) -> Core {
    if from >= len(stmts) { return finish(l, node(ty, where, CUnit), k) }
    let head = stmts[from]
    -- What follows a statement that cannot complete is unreachable, so
    -- nothing after it is lowered. See `stops`.
    if from == len(stmts) - 1 || stops(l, head) {
        match head.kind {
            SExpr(e) -> return conv(l, e, scope, k)
            _ -> return convBind(l, head,
                fun() = finish(l, node(ty, where, CUnit), k), ty, where, scope)
        }
    }
    match head.kind {
        SFun(_) -> {
            var last = from
            while last + 1 < len(stmts) && isFun(stmts[last + 1]) {
                last = last + 1
            }
            let group = Vec.slice(stmts, from, last + 1)
            let binds = localFuns(l, group, scope, where)
            node(ty, where, CLetRec(binds,
                convBlockFrom(l, stmts, last + 1, ty, where, scope, k)))
        }
        _ -> convBind(l, head,
            fun() = convBlockFrom(l, stmts, from + 1, ty, where, scope, k),
            ty, where, scope)
    }
}

-- Whether `s` cannot complete normally, with calls decided by their types.
--
-- Inference typed the block bottom when `s` stops whatever its calls do, so
-- a block cut short here is never asked for a value. Where `s` stops only
-- because a call never returns, the call's result type is a variable nothing
-- constrains, which fits whatever type the block has.
fun stops(l : Lowerer, s : Stmt) -> Bool =
    !completes(stmtCompletion(s), Typed.canReturn(l.types, _))

fun isFun(s : Stmt) -> Bool = match s.kind {
    SFun(_) -> True
    _ -> False
}

-- One statement, as a binding around everything after it.
--
-- When the value being bound holds a transfer that leaves it -- a `return` in a
-- branch of an `if` that is being bound -- the binding becomes a join: the value
-- runs first and jumps to it, and the join's body is the rest. Which is exactly
-- what a `let` already means, said in a form a jump can land in.
fun convBind(l : Lowerer, stmt : Stmt, rest : fun() -> Core, ty : Ty.Type,
             where : Option Span, scope : Scope) -> Core {
    let at = Some(stmt.span)
    match stmt.kind {
        SFun(_) -> return node(ty, at, CLetRec(localFuns(l, [stmt], scope, at), rest()))
        _ -> {}
    }
    let source = match stmt.kind {
        SLet(_, v) -> Some(v)
        SVar(_, v) -> Some(v)
        SAssign(_, v) -> Some(v)
        SExpr(e) -> Some(e)
        _ -> None
    }
    let transfers = match source {
        Some(s) -> special(ChExpr(s))
        None -> False
    }
    if !transfers { return bind(l, stmt, rest, ty, where, scope) }
    let src = match source {
        Some(s) -> s
        None -> oops("a statement with no value transferred", at)
    }
    let held = typeOfExpr(l, src)
    match stmt.kind {
        SLet(pat, _) ->
            convBindName(l, stmt, pat, src, held, False, rest, ty, at, scope)
        SVar(pat, _) ->
            convBindName(l, stmt, pat, src, held, True, rest, ty, at, scope)
        _ -> {
            let (name, id) = freshName(l, "bind")
            let value = freshParam(l, "bv", held)
            Map.put(l.placeholders, src.id, paramVar(value, at))
            let made = match stmt.kind {
                SAssign(target, assigned) -> assign(l, stmt, target, assigned, scope)
                _ -> expr(l, src, scope)
            }
            discard(Map.delete(l.placeholders, src.id))
            let after = discarded(l, made, rest(), at)
            node(ty, at, CJoin(name, id, [value],
                after, conv(l, src, scope, Some((name, id))), False))
        }
    }
}

fun convBindName(l : Lowerer, stmt : Stmt, pat : Pat, src : Expr, held : Ty.Type,
                 mutable : Bool, rest : fun() -> Core, ty : Ty.Type,
                 at : Option Span, scope : Scope) -> Core {
    let bare = unannot(pat)
    if len(letBinders(l, stmt, pat)) > 0 {
        oops("a control transfer under a polymorphic 'let'", at)
    }
    let (joined, joinedId) = freshName(l, "bind")
    let param = freshParam(l, "bv", held)
    let heldVar = paramVar(param, at)
    -- The value is converted *before* the rest, because the rest is lowered
    -- under whatever this binding did to the scope -- a `var` becomes a cell,
    -- and every mention of it after this point has to be a read of that cell.
    let value = conv(l, src, scope, Some((joined, joinedId)))
    let body = match bare.kind {
        PVar(name) -> {
            let id = patternBinder(l, bare)
            if mutable {
                Map.put(scope.cells, id, (name, id))
                let cell = node(refOf(held), at, CRef(heldVar))
                node(ty, at, CLet(name, id, cell.ty, cell, rest(), []))
            } else {
                node(ty, at, CLet(name, id, held, heldVar, rest(), []))
            }
        }
        PWild -> rest()
        -- A destructuring binding is a one-armed match, as in `bindPattern`.
        _ -> {
            let inner = if mutable { varCells(l, pat, rest, scope, at) } else { rest() }
            matched(l, heldVar, [(bare, inner)], ty, at)
        }
    }
    node(ty, at, CJoin(joined, joinedId, [param], body, value, False))
}

-- -- statements, which Core does not have --------------------------------------------

-- A statement sequence, as nested `let`s.
--
-- The value of a block is its last statement's, and every earlier one is a
-- binding -- of the name it introduces, or of a name nothing reads. `{ }` is
-- `()`.
fun block(l : Lowerer, stmts : Vec Stmt, ty : Ty.Type, where : Option Span,
          scope : Scope) -> Core = blockFrom(l, stmts, 0, ty, where, scope)

fun blockFrom(l : Lowerer, stmts : Vec Stmt, from : Int, ty : Ty.Type,
              where : Option Span, scope : Scope) -> Core {
    if from >= len(stmts) { return node(ty, where, CUnit) }
    let head = stmts[from]
    -- What follows a statement that cannot complete is unreachable, so
    -- nothing after it is lowered. See `stops`.
    if from == len(stmts) - 1 || stops(l, head) { return tail(l, head, ty, where, scope) }
    match head.kind {
        -- A local `fun` may recurse and may call its siblings, so it binds as a
        -- group even when the group has one member.
        SFun(_) -> {
            var last = from
            while last + 1 < len(stmts) && isFun(stmts[last + 1]) {
                last = last + 1
            }
            let group = Vec.slice(stmts, from, last + 1)
            let binds = localFuns(l, group, scope, where)
            node(ty, where, CLetRec(binds,
                blockFrom(l, stmts, last + 1, ty, where, scope)))
        }
        -- The rest of the block is lowered *by* `bind` rather than before it,
        -- and that ordering is load-bearing: a `var` becomes a reference cell,
        -- and every mention of it after the binding has to become a read of that
        -- cell. Lowering the rest first would lower those mentions while the
        -- name was still an ordinary one.
        _ -> bind(l, head, fun() = blockFrom(l, stmts, from + 1, ty, where, scope),
                  ty, where, scope)
    }
}

-- A group of local `fun`s, each statement one of them.
--
-- Every member's binders are registered before any body is lowered, so a
-- member calling itself or a sibling finds the group's binders.
fun localFuns(l : Lowerer, group : Vec Stmt, scope : Scope,
              where : Option Span) -> Vec CBind {
    let decls = Vec.map(group, fun(stmt) = match stmt.kind {
        SFun(d) -> d
        _ -> oops("a statement among a group of functions", where)
    })
    for d in decls {
        let id = binderOf(l, d.id, d.name, Some(d.span))
        Map.put(scope.binders, id, funBinders(l, d))
        Map.put(scope.equalities, id, resolvedEqualities(l, localScheme(l, d)))
    }
    Vec.map(decls, localFun(l, _, scope))
}

fun funBinders(l : Lowerer, decl : FunDecl) -> Vec VarCell =
    match localScheme(l, decl) {
        Some(s) -> s.quantified
        None -> []
    }

-- A `fun` bound inside a body, with whatever it generalized over.
--
-- Its scheme is not in the environment -- a local binding's is defined into a
-- scope the solver pops -- so it comes from the group's own abstraction, which
-- is where the solver recorded it, and failing that from the type the generator
-- bound it at.
fun localFun(l : Lowerer, decl : FunDecl, scope : Scope) -> CBind {
    let s = localScheme(l, decl)
    let (fnTy, binders) = match s {
        -- `resolved`, not a bare resolve: inside a signature-checked body the
        -- local was inferred against that signature's skolems, and a constant
        -- `k` left in its type survives specialization.
        Some(sc) -> (resolved(l, sc.body), sc.quantified)
        None -> (rigidly(l, declType(l, decl)), [])
    }
    let dicts = abstractionOf(l, decl.id)
    let equalities = resolvedEqualities(l, s)
    let id = binderOf(l, decl.id, decl.name, Some(decl.span))
    newBind(Binders.binderAt(l.binders, id).moduleName, decl.name, id,
            abstracted(l, fnTy, dicts, equalities), binders,
            function(l, decl, fnTy, scope, None, None, equalities), Some(decl.span))
}

fun localScheme(l : Lowerer, decl : FunDecl) -> Option Scheme =
    match abstractionOf(l, decl.id) {
        None -> None
        Some(a) -> Map.get(a.schemes, decl.name)
    }

fun declType(l : Lowerer, decl : FunDecl) -> Ty.Type =
    match Typed.ofDecl(l.types, decl.id) {
        Some(t) -> t
        None -> match schemeOf(l, decl.name) {
            Some(s) -> Typed.resolve(l.types, s.body)
            None -> oops("'" + decl.name + "' has no type", Some(decl.span))
        }
    }

-- The last statement of a block, whose value is the block's.
fun tail(l : Lowerer, stmt : Stmt, ty : Ty.Type, where : Option Span,
         scope : Scope) -> Core = match stmt.kind {
    SExpr(e) -> expr(l, e, scope)
    _ -> bind(l, stmt, fun() = node(ty, where, CUnit), ty, where, scope)
}

-- One non-final statement, as a `let` around everything after it.
--
-- `rest` is a thunk, not a term: what a statement binds may change how the
-- statements after it lower, and a `var` does.
fun bind(l : Lowerer, stmt : Stmt, rest : fun() -> Core, ty : Ty.Type,
         where : Option Span, scope : Scope) -> Core {
    let at = Some(stmt.span)
    match stmt.kind {
        SExpr(e) -> {
            let value = expr(l, e, scope)
            discarded(l, value, rest(), at)
        }
        SLet(pat, value) -> bindPattern(l, stmt, pat, value, False, rest, scope)
        SVar(pat, value) -> bindPattern(l, stmt, pat, value, True, rest, scope)
        SAssign(target, value) -> {
            let lowered = assign(l, stmt, target, value, scope)
            discarded(l, lowered, rest(), at)
        }
        SFun(_) -> node(ty, at, CLetRec(localFuns(l, [stmt], scope, at), rest()))
    }
}

fun bindPattern(l : Lowerer, stmt : Stmt, pat : Pat, source : Expr,
                mutable : Bool, rest : fun() -> Core, scope : Scope) -> Core {
    let at = Some(stmt.span)
    let value = abstract(l, abstractionOf(l, stmt.id), resolvedEqualities(l, letScheme(l, stmt, pat)),
                         fun() = expr(l, source, scope))
    let bare = unannot(pat)
    let binders = letBinders(l, stmt, pat)
    match bare.kind {
        PVar(name) -> {
            let id = patternBinder(l, bare)
            Map.put(scope.binders, id, binders)
            if mutable {
                Map.put(scope.cells, id, (name, id))
                let cell = node(refOf(value.ty), at, CRef(value))
                let body = rest()
                node(body.ty, at, CLet(name, id, cell.ty, cell, body, binders))
            } else {
                let body = rest()
                node(body.ty, at, CLet(name, id, value.ty, value, body, binders))
            }
        }
        PWild -> discarded(l, value, rest(), at)
        -- A destructuring binding is a one-armed match, which is what it is.
        _ -> {
            let body = if mutable { varCells(l, pat, rest, scope, at) } else { rest() }
            matched(l, value, [(bare, body)], body.ty, at)
        }
    }
}

-- Lower `rest` with every name `pat` binds as a cell, for a `var` that
-- destructures: any of them can be assigned in the statements that follow,
-- which `rest` lowers under `scope`.
fun varCells(l : Lowerer, pat : Pat, rest : fun() -> Core, scope : Scope,
             where : Option Span) -> Core {
    let bound = patternBinders(l, pat)
    let cells = Array.map(bound, fun((name, id, _)) = copyOf(l, name, id))
    for var i = 0; i < len(bound); i = i + 1 {
        let (name, id, _) = bound[i]
        Map.put(scope.cells, id, (name, cells[i]))
    }
    cellsAround(bound, cells, rest(), where)
}

-- Lowers the code a pattern's binders scope over, making a cell of any binder
-- that `within` assigns.
--
-- A pattern binder is reassignable like any other: reassigning a destructured
-- parameter rebinds the local name and nothing else, because patterns bind, they
-- do not alias. A cell is exactly that, and nothing more.
fun celled(l : Lowerer, pat : Pat, within : Child, lower : fun(Scope) -> Core,
           scope : Scope, where : Option Span) -> Core {
    let written = assignedIn(l, within)
    let here = Vec.filter(patternBinders(l, pat), fun((_, id, _)) = Set.contains(written, id))
    if len(here) == 0 { return lower(scope) }
    let inner = childScope(scope)
    let cells = Array.map(here, fun((name, id, _)) = copyOf(l, name, id))
    for var i = 0; i < len(here); i = i + 1 {
        let (name, id, _) = here[i]
        Map.put(inner.cells, id, (name, cells[i]))
    }
    cellsAround(here, cells, lower(inner), where)
}

-- The binders a pattern binds, sorted by spelling: each one's spelling, id
-- and type.
fun patternBinders(l : Lowerer, pat : Pat) -> Vec (String, Int, Ty.Type) {
    let types = Typed.ofPattern(l.types, pat)
    Vec.map(Vec.sortByKey(varPatterns(pat), varName), fun(v) {
        let name = varName(v)
        (name, patternBinder(l, v), rigidly(l, Map.getOr(types, name, TBottom)))
    })
}

-- Wrap `body` in the cell `cells[i]` for each binder `bound[i]`, holding the
-- binder's value.
fun cellsAround(bound : Vec (String, Int, Ty.Type), cells : Array Int, body : Core,
                where : Option Span) -> Core {
    var out = body
    for var i = len(bound) - 1; i >= 0; i = i - 1 {
        out = cellAround(bound[i], cells[i], out, where)
    }
    out
}

-- Wrap `body` in the cell `cell` for the binder `bound`, holding its value.
fun cellAround(bound : (String, Int, Ty.Type), cell : Int, body : Core,
               where : Option Span) -> Core {
    let (name, id, ty) = bound
    node(body.ty, where, CLet(name, cell, refOf(ty),
        node(refOf(ty), where, CRef(node(ty, where, CVar(refTo(name, id))))),
        body, []))
}

-- What a local `let` generalized over, if it generalized.
fun letBinders(l : Lowerer, stmt : Stmt, pat : Pat) -> Vec VarCell = match letScheme(l, stmt, pat) {
    Some(s) -> s.quantified
    None -> []
}

-- The scheme a local `let` of one name generalized to, or `None`.
fun letScheme(l : Lowerer, stmt : Stmt, pat : Pat) -> Option Scheme {
    let name = match unannot(pat).kind {
        PVar(n) -> n
        _ -> return None
    }
    let a = abstractionOf(l, stmt.id)?
    Map.get(a.schemes, name)
}

-- A statement in a position that wants an expression: a C-style `for`'s init and
-- step, which are statements in the grammar.
fun stmtValue(l : Lowerer, stmt : Stmt, scope : Scope) -> Core {
    let at = Some(stmt.span)
    match stmt.kind {
        SExpr(e) -> expr(l, e, scope)
        SAssign(target, value) -> assign(l, stmt, target, value, scope)
        -- `for var i = 0; ...`: the binding is the init, and its scope is the
        -- loop, so it is expressed as the cell it already is.
        SLet(pat, source) -> forInit(l, stmt, pat, source, False, scope)
        SVar(pat, source) -> forInit(l, stmt, pat, source, True, scope)
        _ -> oops("unhandled for-statement", at)
    }
}

fun forInit(l : Lowerer, stmt : Stmt, pat : Pat, source : Expr, mutable : Bool,
            scope : Scope) -> Core {
    let at = Some(stmt.span)
    let bare = unannot(pat)
    let name = match bare.kind {
        PVar(n) -> n
        _ -> oops("a 'for' initializer must bind one name", at)
    }
    let id = patternBinder(l, bare)
    var value = expr(l, source, scope)
    if mutable {
        Map.put(scope.cells, id, (name, id))
        value = node(refOf(value.ty), at, CRef(value))
    }
    node(value.ty, at, CLet(name, id, value.ty, value,
                            node(value.ty, at, CVar(refAt(l, name, id))), []))
}

fun assign(l : Lowerer, stmt : Stmt, target : Expr, source : Expr,
           scope : Scope) -> Core {
    let at = Some(stmt.span)
    let value = expr(l, source, scope)
    let unit = unitType()
    match target.kind {
        EVar(name, _) -> {
            let id = binderOf(l, target.id, name, Some(target.span))
            let (cell, cellId) = Option.unwrapOr(cellOf(scope, id), (name, id))
            node(unit, at, CAssign(
                node(refOf(value.ty), Some(target.span), CVar(refAt(l, cell, cellId))), value))
        }
        EField(obj, name) -> {
            let o = expr(l, obj, scope)
            match passedAccessors(l, target) {
                Some(dicts) -> if len(dicts) == 2 {
                    return node(unit, at, CApp(
                        node(TFun([o.ty, value.ty], unit), Some(target.span),
                             CSlot(dicts[1], accessorSlot(l, dicts[1], "set", Some(target.span)))),
                        [o, value]))
                }
                None -> {}
            }
            let slot = CProject(o, knownPosition(l, o, name, Some(target.span)))
            node(unit, at, CAssign(node(value.ty, Some(target.span), slot), value))
        }
        EIndex(arr, index, _, _) -> {
            let a = expr(l, arr, scope)
            node(unit, at, CAssign(node(value.ty, Some(target.span),
                CIndex(a, expr(l, index, scope))), value))
        }
        _ -> oops("the parser should have rejected this target", at)
    }
}

-- -- looking things up --------------------------------------------------------------

-- The equalities a scheme's context states, in order: the coercions a binding
-- of it takes.
fun equalitiesOf(s : Option Scheme) -> Vec (Ty.Type, Ty.Type) = match s {
    None -> []
    Some(sc) -> {
        let out = Vec.new(2)
        for p in sc.preds {
            if p.name == Ty.equals && len(p.args) == 2 {
                Vec.push(out, (p.args[0], p.args[1]))
            }
        }
        out
    }
}

-- The equalities of a local binding's scheme, read as the binding's own type
-- is: from the solver's records, in terms of variables rather than skolems.
fun resolvedEqualities(l : Lowerer, s : Option Scheme) -> Vec (Ty.Type, Ty.Type) =
    Vec.map(equalitiesOf(s), fun((left, right)) = (resolved(l, left), resolved(l, right)))

-- What the binder `id`, spelled `name`, abstracts over, local bindings
-- before top-level ones.
fun bindersOf(l : Lowerer, id : Int, name : String, scope : Scope) -> Vec VarCell =
    match localBinders(scope, id) {
        Some(local) -> local
        None -> match schemeOf(l, name) {
            Some(s) -> s.quantified
            None -> []
        }
    }

fun schemeOf(l : Lowerer, name : String) -> Option Scheme =
    match C.lookup_(l.env, name) {
        Some(b) -> Some(b.scheme)
        None -> None
    }

fun nameType(l : Lowerer, name : String) -> Ty.Type = match schemeOf(l, name) {
    Some(s) -> Typed.resolve(l.types, s.body)
    None -> oops("'" + name + "' has no type", None)
}

fun abstractionOf(l : Lowerer, id : Int) -> Option Abstraction =
    Map.get(l.types.abstractions, id)

fun classNamed(l : Lowerer, name : String) -> ClassInfo =
    match Map.get(l.classes.classes, name) {
        Some(i) -> i
        None -> oops("unknown class '" + name + "'", None)
    }

-- The spelling a variable pattern binds.
fun varName(p : Pat) -> String = match p.kind {
    PVar(name) -> name
    _ -> oops("a binder from a pattern that is not a variable", Some(p.span))
}

fun unannot(p : Pat) -> Pat {
    var out = p
    var going = True
    while going {
        match out.kind {
            PAnnot(inner, _) -> { out = inner }
            _ -> { going = False }
        }
    }
    out
}

-- -- the questions asked about a subtree ---------------------------------------------
--
-- A lambda and a local `fun` are their own functions: the `return` in one is
-- that one's, and it travels with it. Every question about what a body
-- *contains* stops there for that reason, so the stopping is written once.

fun stopsHere(c : Child) -> Bool = match c {
    ChExpr(e) -> match e.kind {
        ELambda(_, _, _) -> True
        _ -> False
    }
    ChStmt(s) -> match s.kind {
        SFun(_) -> True
        _ -> False
    }
    _ -> False
}

-- Whether a term holds a loop or a transfer outside any nested function. The
-- question `conv` exists to answer: a term for which this is false has nothing
-- in it that a join point is needed for.
fun special(c : Child) -> Bool {
    match c {
        ChExpr(e) -> match e.kind {
            EWhile(_, _) -> return True
            ELoop(_) -> return True
            EForC(_, _, _, _) -> return True
            EForIn(_, _, _, _, _) -> return True
            EReturn(_) -> return True
            EBreak(_) -> return True
            EContinue -> return True
            _ -> {}
        }
        _ -> {}
    }
    if stopsHere(c) { return False }
    for ch in children(c) {
        if special(ch) { return True }
    }
    False
}

-- Whether a function body needs a return join at all.
fun holdsReturn(c : Child) -> Bool {
    match c {
        ChExpr(e) -> match e.kind {
            EReturn(_) -> return True
            _ -> {}
        }
        _ -> {}
    }
    if stopsHere(c) { return False }
    for ch in children(c) {
        if holdsReturn(ch) { return True }
    }
    False
}

-- Every binder assigned anywhere under a node, nested functions included, by
-- id.
--
-- Nested ones are the whole point: a closure that writes a captured `var` writes
-- through to it, so what decides whether a binding is a cell is whether
-- *anything* reachable from here writes it -- not whether this body does.
fun assignedIn(l : Lowerer, c : Child) -> Set.Set Int {
    let out = Set.new()
    assignedInto(l, c, out)
    out
}

fun assignedInto(l : Lowerer, c : Child, out : Set.Set Int) -> Unit {
    match c {
        ChStmt(s) -> match s.kind {
            SAssign(target, _) -> match target.kind {
                EVar(name, _) -> Set.add(out, binderOf(l, target.id, name, Some(target.span)))
                _ -> {}
            }
            _ -> {}
        }
        _ -> {}
    }
    for ch in children(c) { assignedInto(l, ch, out) }
}

-- The subterms of a node that are evaluated, in the order they are evaluated.
--
-- Taken from what this pass lowers each node to, which is not the same as the
-- field order. A node absent from this table cannot be A-normalized, and a
-- transfer inside one is declined rather than guessed at -- including `&&` and
-- `||`, whose right operand is not unconditionally evaluated.
fun operands(e : Expr) -> Option (Vec Expr) = match e.kind {
    ECall(fn, args) -> Some(Vec.append([fn], args))
    ETuple(elems) -> Some(elems)
    EArray(elems) -> Some(elems)
    ERecord(_, fields) -> Some(Vec.map(fields, fun(f) = {
        let (_, v) = f
        v
    }))
    EIndex(arr, index, _, _) -> Some([arr, index])
    EField(obj, _) -> Some([obj])
    EProject(obj, _) -> Some([obj])
    EUnary(_, operand, _) -> Some([operand])
    EBinary(op, left, right, _) ->
        if op == "&&" || op == "||" { None } else { Some([left, right]) }
    _ -> None
}
