export (objectFile, sectionNames)

--- An assembled arm64 module as a Mach-O relocatable object (`MH_OBJECT`),
--- which the system linker links as it would the assembler's.
---
--- The file is a header, four load commands, the sections' bytes, each
--- section's relocations, the symbol table and its strings, in that order.
--- One unnamed segment holds every section, at addresses that start from zero
--- and only matter within the object: a defined symbol's value is its address
--- there, and the linker moves sections and symbols together.
---
--- **Symbols.** Every named symbol defined here is in the table -- exported
--- ones as external, the rest as local -- so that `nm`, a profiler and a crash
--- report name every function. A temporary label is in it only if a page
--- relocation refers to it, since an arm64 page relocation must name a symbol;
--- such a label gets a local symbol spelled as the assembly spells it. Page
--- relocations reach only data labels. An eight-byte word that holds a
--- temporary label's address relocates against the label's section instead,
--- with the label's address in the object stored in the word. That keeps the
--- labels in `__text` out of the table: the linker records every symbol in
--- `__text` as a function start, and a profiler ends a function at the next
--- start, so a symbol on a label inside a function would cut it in two. The
--- frame table names its return addresses by their distance from the entry,
--- which `Turkey.Assembler` fixes, so they reach no relocation at all. The
--- symbol table is ordered locals, then exported, then undefined, as
--- `LC_DYSYMTAB` describes it, and the last two by name.
---
--- **Debug sections.** An address in a debug section relocates against its
--- target's section, a named symbol's as well as a temporary label's, with the
--- address in the object stored in the field: a debugger reads the DWARF in
--- an object without applying relocations, so the field must already hold
--- the address. An offset from one debug section into another is never
--- relocated at all. ld64 does not link debug sections; it leaves them in the
--- object and points the executable's debug map at it, so an offset in the
--- object is the offset a debugger reads.
---
--- **Unwind sections.** A compact unwind entry's function address is a word
--- like any other, against `__text` for the label at the function's start.
--- An address in `__eh_frame` is relative to its own field, which Mach-O
--- spells as a pair: a `SUBTRACTOR` naming a local symbol at the start of
--- `__eh_frame`, then an `UNSIGNED` naming the function, with the field
--- holding minus its offset in the section. Both halves must name a symbol,
--- so that section symbol is in the table too, and it is not in `__text`.

import Data.Set as Set
import Turkey.Asm as Asm
import Turkey.Asm (Symbol, SymbolKind(..))
import Turkey.Assembler as Assembler
import Turkey.Assembler (Object(..), Relocation(..), Use(..), Definition(..), SectionData(..))
import Turkey.Arm64.Encode (Fixup(..))

let headerSize = 32
let segmentSize = 72
let sectionHeaderSize = 80
let buildVersionSize = 24
let symtabSize = 24
let dysymtabSize = 80

-- The oldest macOS the runtime runs on: it sleeps on
-- `os_sync_wait_on_address`, which is 14.4's.
let minimumOS = 0x000E0400

--- Each section's segment and section names, and its flags: code is marked as
--- instructions, and the panic messages as C string literals, which lets the
--- linker merge identical ones.
fun sectionNames(kind : Asm.Section) -> (String, String, Int) = match kind {
    Asm.Text -> ("__TEXT", "__text", 0x80000400)
    Asm.CStrings -> ("__TEXT", "__cstring", 0x2)
    Asm.Constants -> ("__TEXT", "__const", 0)
    Asm.Data -> ("__DATA", "__data", 0)
    -- `S_ATTR_DEBUG`: the linker leaves these out of the image and records
    -- the object in the debug map instead.
    Asm.DebugAbbrev -> ("__DWARF", "__debug_abbrev", 0x02000000)
    Asm.DebugInfo -> ("__DWARF", "__debug_info", 0x02000000)
    Asm.DebugStr -> ("__DWARF", "__debug_str", 0x02000000)
    Asm.DebugLine -> ("__DWARF", "__debug_line", 0x02000000)
    Asm.DebugLineStr -> ("__DWARF", "__debug_line_str", 0x02000000)
    Asm.DebugAddr -> ("__DWARF", "__debug_addr", 0x02000000)
    Asm.DebugRnglists -> ("__DWARF", "__debug_rnglists", 0x02000000)
    Asm.DebugLoclists -> ("__DWARF", "__debug_loclists", 0x02000000)
    Asm.DebugGdbScripts -> error("internal error: Mach-O has no gdb scripts section")
    -- The linker reads both and builds the image's `__unwind_info` from
    -- them: the compact entries as debug information it does not copy, and
    -- `__eh_frame` as coalesced, live support for the functions it
    -- describes.
    Asm.CompactUnwind -> ("__LD", "__compact_unwind", 0x02000000)
    Asm.EhFrame -> ("__TEXT", "__eh_frame", 0x6800000B)
}

-- A symbol's place in the table and what goes in its entry.
type Entry = Entry { name : String, kind : Int, section : Int, value : Int }

fun objectFile(obj : Object Fixup) -> Vec Byte {
    let sections = obj.sections
    let count = len(sections)
    -- Section addresses, each aligned, from zero.
    let addresses = Array.filled(count, 0)
    var size = 0
    for var k = 0; k < count; k = k + 1 {
        size = alignUp(size, 1 << sections[k].align)
        addresses[k] = size
        size = size + len(sections[k].bytes)
    }
    let commands = segmentSize + sectionHeaderSize * count + buildVersionSize + symtabSize
                   + dysymtabSize
    let contents = headerSize + commands
    -- Relocations after the contents, each section's together.
    let relocations = Array.map(sections, fun(s) = Vec.filter(s.relocations, relocated))
    let entryCounts = Array.map(relocations, fun(rs) {
        var n = 0
        for r in rs { n = n + entries(r) }
        n
    })
    let relocationsAt = Array.filled(count, 0)
    var at = alignUp(contents + size, 8)
    for var k = 0; k < count; k = k + 1 {
        relocationsAt[k] = at
        at = at + 8 * entryCounts[k]
    }
    let (entries, locals, exported) = symbols(obj, addresses)
    let indices = Map.new()
    for var k = 0; k < len(entries); k = k + 1 { Map.put(indices, entries[k].name, k) }
    let strings = []
    Vec.push(strings, Byte.truncate(0))
    let nameAt = Vec.map(entries, fun(e) {
        let offset = len(strings)
        for b in String.bytes(e.name) { Vec.push(strings, b) }
        Vec.push(strings, Byte.truncate(0))
        offset
    })
    while len(strings) % 8 != 0 { Vec.push(strings, Byte.truncate(0)) }
    let symbolsAt = alignUp(at, 8)
    let stringsAt = symbolsAt + 16 * len(entries)

    let out = []
    -- mach_header_64: arm64, an object, no flags.
    le(out, 4, 0xFEEDFACF)
    le(out, 4, 0x0100000C)
    le(out, 4, 0)
    le(out, 4, 1)
    le(out, 4, 4)
    le(out, 4, commands)
    le(out, 4, 0)
    le(out, 4, 0)
    -- LC_SEGMENT_64, unnamed, readable, writable and executable as an
    -- object's always is; the linker gives each output segment its own.
    le(out, 4, 0x19)
    le(out, 4, segmentSize + sectionHeaderSize * count)
    name16(out, "")
    le(out, 8, 0)
    le(out, 8, size)
    le(out, 8, contents)
    le(out, 8, size)
    le(out, 4, 7)
    le(out, 4, 7)
    le(out, 4, count)
    le(out, 4, 0)
    for var k = 0; k < count; k = k + 1 {
        let s = sections[k]
        let (segment, section, flags) = sectionNames(s.kind)
        name16(out, section)
        name16(out, segment)
        le(out, 8, addresses[k])
        le(out, 8, len(s.bytes))
        le(out, 4, contents + addresses[k])
        le(out, 4, s.align)
        le(out, 4, if entryCounts[k] == 0 { 0 } else { relocationsAt[k] })
        le(out, 4, entryCounts[k])
        le(out, 4, flags)
        le(out, 4, 0)
        le(out, 4, 0)
        le(out, 4, 0)
    }
    -- LC_BUILD_VERSION: macOS, no SDK, no tools.
    le(out, 4, 0x32)
    le(out, 4, buildVersionSize)
    le(out, 4, 1)
    le(out, 4, minimumOS)
    le(out, 4, 0)
    le(out, 4, 0)
    -- LC_SYMTAB
    le(out, 4, 0x2)
    le(out, 4, symtabSize)
    le(out, 4, symbolsAt)
    le(out, 4, len(entries))
    le(out, 4, stringsAt)
    le(out, 4, len(strings))
    -- LC_DYSYMTAB: the three runs of the symbol table, and nothing else.
    le(out, 4, 0xB)
    le(out, 4, dysymtabSize)
    le(out, 4, 0)
    le(out, 4, locals)
    le(out, 4, locals)
    le(out, 4, exported)
    le(out, 4, locals + exported)
    le(out, 4, len(entries) - locals - exported)
    for var k = 0; k < 12; k = k + 1 { le(out, 4, 0) }

    for var k = 0; k < count; k = k + 1 {
        pad(out, contents + addresses[k])
        extend(out, sections[k].bytes)
    }
    let definitions = Map.new()
    for d in obj.defined { Map.put(definitions, Asm.spell(d.symbol), d) }
    for var k = 0; k < count; k = k + 1 {
        for r in sections[k].relocations {
            if let Offset32 = r.use {
                match Map.get(definitions, Asm.spell(r.target)) {
                    Some(d) -> Byte.putLE(out, contents + addresses[k] + r.offset, 4, d.offset)
                    None -> error("internal error: the section offset of "
                                  + Asm.spell(r.target) + " has no definition")
                }
            }
        }
    }
    pad(out, relocationsAt[0])
    for var k = 0; k < count; k = k + 1 {
        for r in relocations[k] {
            if let Relative64 = r.use {
                -- The field's offset from the section symbol, negated, is
                -- the addend.
                Byte.putLE(out, contents + addresses[k] + r.offset, 8, -r.offset)
                le(out, 4, r.offset)
                le(out, 4, Map.getOr(indices, sectionSymbol(k), 0) | 1 << 27 | 3 << 25
                           | 1 << 28)
                le(out, 4, r.offset)
                le(out, 4, Map.getOr(indices, symbolName(r.target), 0) | 1 << 27 | 3 << 25)
                continue
            }
            let (kind, pcrel, length) = relocationKind(r.use)
            -- The symbol's index with the extern bit, or the section's
            -- ordinal without it.
            let target = match (sectionRelative(sections[k].kind, r),
                                Map.get(definitions, Asm.spell(r.target))) {
                (True, Some(d)) -> {
                    -- Store the label's address as the implicit addend.
                    Byte.putLE(out, contents + addresses[k] + r.offset, 8,
                               addresses[d.section] + d.offset)
                    d.section + 1
                }
                _ -> Map.getOr(indices, symbolName(r.target), 0) | 1 << 27
            }
            le(out, 4, r.offset)
            le(out, 4, target | pcrel << 24 | length << 25 | kind << 28)
        }
    }
    pad(out, symbolsAt)
    for var k = 0; k < len(entries); k = k + 1 {
        let e = entries[k]
        le(out, 4, nameAt[k])
        le(out, 1, e.kind)
        le(out, 1, e.section)
        le(out, 2, 0)
        le(out, 8, e.value)
    }
    extend(out, strings)
    out
}

-- The symbol table, and how many of its entries are local and how many
-- exported.
fun symbols(obj : Object Fixup, addresses : Array Int) -> (Vec Entry, Int, Int) {
    let referenced = Set.new()
    for s in obj.sections {
        for r in s.relocations {
            if relocated(r) && !sectionRelative(s.kind, r) {
                Set.add(referenced, Asm.spell(r.target))
            }
        }
    }
    let locals = []
    let exported = []
    for var k = 0; k < len(obj.sections); k = k + 1 {
        if Iter.any(obj.sections[k].relocations, fun(r) = isRelative64(r.use)) {
            Vec.push(locals, Entry { name = sectionSymbol(k), kind = 0xE, section = k + 1,
                                     value = addresses[k] })
        }
    }
    for d in obj.defined {
        let e = Entry { name = symbolName(d.symbol), kind = 0xE, section = d.section + 1,
                        value = addresses[d.section] + d.offset }
        match d.symbol.kind {
            Named -> if d.exported {
                Vec.push(exported, Entry { name = e.name, kind = 0xF, section = e.section,
                                           value = e.value })
            } else {
                Vec.push(locals, e)
            }
            Temporary -> if Set.contains(referenced, Asm.spell(d.symbol)) {
                Vec.push(locals, e)
            }
        }
    }
    let undefined = Vec.map(obj.undefined, fun(sym) =
        Entry { name = symbolName(sym), kind = 0x1, section = 0, value = 0 })
    let byName = fun(a : Entry, b : Entry) = Array.threeWay(a.name, b.name)
    let entries = []
    for e in locals { Vec.push(entries, e) }
    for e in Vec.sortBy(exported, byName) { Vec.push(entries, e) }
    for e in Vec.sortBy(undefined, byName) { Vec.push(entries, e) }
    (entries, len(locals), len(exported))
}

-- Whether a field gets a relocation entry: every one but an offset, which is
-- written into the field instead.
fun relocated(r : Relocation Fixup) -> Bool = match r.use {
    Offset32 -> False
    Address64 | Code(_) | Relative32 | Relative64 -> True
}

-- How many entries a relocation takes: two for an address relative to its
-- field, the `SUBTRACTOR` and the `UNSIGNED`.
fun entries(r : Relocation Fixup) -> Int = if isRelative64(r.use) { 2 } else { 1 }

fun isRelative64(use : Use Fixup) -> Bool = match use {
    Relative64 -> True
    _ -> False
}

-- The local symbol at the start of section `k`, which a `SUBTRACTOR` there
-- names.
fun sectionSymbol(k : Int) -> String = "ltmp" + Int.toString(k)

-- Whether a relocation in a section of kind `holder` names its target's
-- section rather than a symbol: an eight-byte word that holds a temporary
-- label's address, or any address in a debug section.
fun sectionRelative(holder : Asm.Section, r : Relocation Fixup) -> Bool =
    match (r.use, r.target.kind) {
        (Address64, Temporary) -> True
        (Address64, Named) -> debug(holder)
        _ -> False
    }

fun debug(kind : Asm.Section) -> Bool = match kind {
    Asm.DebugAbbrev | Asm.DebugInfo | Asm.DebugStr | Asm.DebugLine | Asm.DebugLineStr
        | Asm.DebugAddr | Asm.DebugRnglists | Asm.DebugLoclists | Asm.DebugGdbScripts -> True
    Asm.Text | Asm.CStrings | Asm.Constants | Asm.Data | Asm.CompactUnwind
        | Asm.EhFrame -> False
}

-- A symbol's name in the table: a named symbol's own, and a temporary
-- label's as the assembly spells it.
fun symbolName(sym : Symbol) -> String = match sym.kind {
    Named -> sym.name
    Temporary -> Asm.spell(sym)
}

-- The relocation's type, whether it is relative to the instruction, and its
-- size as a power of two.
fun relocationKind(use : Use Fixup) -> (Int, Int, Int) = match use {
    Address64 -> (0, 0, 3)
    Offset32 -> error("internal error: a section offset is never relocated")
    Relative64 -> error("internal error: a relative address is a pair of relocations")
    Relative32 -> error("internal error: a four-byte relative address on Mach-O")
    Code(Jump26(_)) | Code(Call26(_)) -> (2, 1, 2)
    Code(Page21(_)) -> (3, 1, 2)
    Code(PageOffset12(_, _)) | Code(AddOffset12(_)) -> (4, 0, 2)
    -- Mach-O has no relocation for a conditional branch, so its target has to
    -- be in its own function.
    Code(Branch19(sym)) ->
        error("internal error: a conditional branch to " + Asm.spell(sym)
              + ", outside its section")
}

fun alignUp(n : Int, to : Int) -> Int = (n + to - 1) / to * to

fun le(out : Vec Byte, width : Int, n : Int) -> Unit {
    let at = len(out)
    for var k = 0; k < width; k = k + 1 { Vec.push(out, Byte.truncate(0)) }
    Byte.putLE(out, at, width, n)
}

-- A name in a fixed 16-byte field, padded with zeros.
fun name16(out : Vec Byte, text : String) -> Unit {
    var n = 0
    for b in String.bytes(text) {
        Vec.push(out, b)
        n = n + 1
    }
    for var k = n; k < 16; k = k + 1 { Vec.push(out, Byte.truncate(0)) }
}

fun extend(out : Vec Byte, bytes : Vec Byte) -> Unit {
    for b in bytes { Vec.push(out, b) }
}

-- Zeros up to file offset `to`.
fun pad(out : Vec Byte, to : Int) -> Unit {
    while len(out) < to { Vec.push(out, Byte.truncate(0)) }
}
