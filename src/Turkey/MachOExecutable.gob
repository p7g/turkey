export (executableFile)

-- An assembled arm64 module as a Mach-O executable (`MH_EXECUTE`), signed
-- and ready to run, linked against libSystem and the libraries its imports
-- come from.
--
-- **Layout.** Five segments, each a whole number of 16KB pages, the arm64
-- page size: `__PAGEZERO`, the unmapped first 4GB that catches a null
-- pointer; `__TEXT`, holding the header and load commands, then the code,
-- the import stubs, the C strings and the constants; `__DATA_CONST`, holding
-- the global offset table, one word per import, which the loader fills in
-- and then makes read-only; `__DATA`; and `__LINKEDIT`, holding what the
-- loader and the tools read: the bind opcodes, the symbol table, the
-- indirect symbol table, its strings, and last the code signature, which
-- covers every byte before it. The file is laid out as the image is, so a
-- segment's file offset is its address less `__TEXT`'s.
--
-- **Every field is filled in here** (`Turkey.Image`), at the addresses this
-- layout gives. The image has no rebases: the loaded sections hold no
-- absolute address. A call to an imported function goes to a stub of three
-- instructions, `adrp x16, slot@PAGE; ldr x16, [x16, slot@PAGEOFF]; br x16`,
-- which jumps through that function's slot in the offset table, so that a
-- call needs one word per import bound and no code patched. The loader
-- fills the slots in from classic bind opcodes
-- (`LC_DYLD_INFO_ONLY`) rather than chained fixups: a handful of binds needs
-- no more, and every arm64 macOS reads them.
--
-- **What is left out.** The debug sections, and the unwind sections, which
-- an unwinder reads only through an `__unwind_info` this does not build.
-- The runtime finds frames by their frame pointers and the frame table, and
-- needs neither.
--
-- **Symbols.** Every named symbol defined in the module is in the table, so
-- that `nm`, a profiler and a crash report name every function; the
-- module's exported ones as external, the rest as local. A temporary label
-- never is: with every field filled in, nothing refers to one by symbol.
-- Each import is an undefined symbol bound to the library it comes from, by
-- that library's ordinal: libSystem is the first library loaded, and the
-- others follow it by install name, one `LC_LOAD_DYLIB` each, and only if
-- something is imported from them. The order is locals, then exported, then
-- undefined, the last two by name, the undefined ones by library first, as
-- `LC_DYSYMTAB` describes it.
--
-- **Deterministic.** Nothing in the file depends on the time or the path it
-- is written to, and nothing on the host but the install names `dylibOf`
-- gives, which the caller reads from the host's libraries: the signature's
-- identifier is the caller's, from the program's own name. `LC_UUID`, which
-- the loader requires, is taken from a SHA-256 of the rest of the file, and
-- the signature is ad hoc, with no timestamp (`Turkey.CodeSignature`). So one module always writes
-- the same bytes, which is what lets the compiler's fixed point compare
-- executables.

import Hash.SHA256 as SHA256
import Turkey.Asm as Asm
import Turkey.Asm (Symbol, SymbolKind(..))
import Turkey.Arm64.Encode as Encode
import Turkey.Arm64.Encode (Fixup)
import Turkey.Assembler (Object(..), SectionData(..))
import Turkey.CodeSignature as CodeSignature
import Turkey.Executable (stubSize, stubs, check, copy, alignUp)
import Turkey.Image as Image

let base = 0x100000000
let page = 0x4000

let headerSize = 32
let segmentSize = 72
let sectionSize = 80
-- The load commands besides one `LC_LOAD_DYLIB` per library.
let fixedCommands = 13
-- The sections in `__TEXT`: `__text`, `__stubs`, `__cstring`, `__const`.
let textSections = 4
-- The segments, `__DATA_CONST` and `__DATA` with a section each; then
-- `LC_DYLD_INFO_ONLY`, `LC_SYMTAB`, `LC_DYSYMTAB`, `LC_LOAD_DYLINKER`,
-- `LC_UUID`, `LC_BUILD_VERSION`, `LC_MAIN` and `LC_CODE_SIGNATURE`.
let fixedCommandsSize = segmentSize + segmentSize + textSections * sectionSize
                        + 2 * (segmentSize + sectionSize) + segmentSize
                        + 48 + 24 + 80 + 32 + 24 + 24 + 24 + 16

-- The oldest macOS the runtime runs on, `os_sync_wait_on_address`'s, which
-- is also the SDK recorded.
let minimumOS = 0x000E0400

let dylinker = "/usr/lib/dyld"
let libSystem = "/usr/lib/libSystem.B.dylib"

-- `__DATA_CONST`'s index among the segments, from `__PAGEZERO`'s 0, by
-- which the bind opcodes name it.
let offsetTableSegment = 2

-- The section ordinals of the module's code, C strings, constants and
-- data: ordinals count from 1, across every segment, and `__stubs` and
-- `__got` are the second and the fifth.
let ordinals = [1, 3, 4, 6]

-- A symbol table entry before its name is placed.
type Entry = Entry { name : String, kind : Int, section : Int, desc : Int, value : Int }

-- Returns `obj` as a signed executable whose code signature names it
-- `identifier`, with each of `obj.undefined` bound to the library `dylibOf`
-- maps its name to, by install name, and every other to libSystem. `entry` is
-- the symbol the program starts at, which `obj` defines. Fills in `obj`'s
-- sections in place, so `obj` is spent.
fun executableFile(obj : Object Fixup, entry : Symbol, identifier : String,
                   dylibOf : Map String String) -> Array Byte {
    let sections = obj.sections
    -- The assembler puts these first, in this order.
    let text = 0
    let cstrings = 1
    let constants = 2
    let data = 3
    check(sections)
    let dylibs = [libSystem]
    for name in Array.sort(Map.values(dylibOf)) {
        if name != libSystem && dylibs[len(dylibs) - 1] != name { Vec.push(dylibs, name) }
    }
    -- A library's ordinal is its place among the `LC_LOAD_DYLIB`s, from 1.
    let ordinalOf = Map.new()
    for var k = 0; k < len(dylibs); k = k + 1 { Map.put(ordinalOf, dylibs[k], k + 1) }
    let ordinal = fun(sym : Symbol) = match Map.get(dylibOf, sym.name) {
        Some(name) -> Map.getOr(ordinalOf, name, 1)
        None -> 1
    }
    let byLibrary = fun(a : Symbol, b : Symbol) =
        Array.threeWay((ordinal(a), a.name), (ordinal(b), b.name))
    let imports = Vec.toArray(Vec.sortBy(obj.undefined, byLibrary))
    let ordinals = Array.map(imports, ordinal)
    let n = len(imports)
    let dylibSizes = Vec.map(dylibs, fun(name) = alignUp(24 + len(String.toBytes(name)) + 1, 8))
    var commandsSize = fixedCommandsSize
    for size in dylibSizes { commandsSize = commandsSize + size }

    -- `__TEXT`, from the header.
    let textAt = alignUp(headerSize + commandsSize, 1 << sections[text].align)
    let stubsAt = alignUp(textAt + len(sections[text].bytes), 4)
    let cstringsAt = alignUp(stubsAt + stubSize * n, 1 << sections[cstrings].align)
    let constantsAt = alignUp(cstringsAt + len(sections[cstrings].bytes),
                              1 << sections[constants].align)
    let textSegment = pages(constantsAt + len(sections[constants].bytes))
    -- `__DATA_CONST` and `__DATA`, a section each.
    let offsetTableAt = textSegment
    let offsetTableSegmentSize = pages(8 * n)
    let dataAt = offsetTableAt + offsetTableSegmentSize
    let dataSegment = pages(len(sections[data].bytes))
    -- `__LINKEDIT`.
    let linkeditAt = dataAt + dataSegment
    let binds = bindOpcodes(imports, ordinals)
    let addresses = Array.filled(len(sections), -1)
    addresses[text] = base + textAt
    addresses[cstrings] = base + cstringsAt
    addresses[constants] = base + constantsAt
    addresses[data] = base + dataAt
    let (entries, locals, exported) = symbols(obj, imports, ordinals, addresses)
    let strings = []
    Vec.push(strings, Byte.truncate(0))
    let nameAt = Vec.map(entries, fun(e) {
        let offset = len(strings)
        for b in String.bytes(e.name) { Vec.push(strings, b) }
        Vec.push(strings, Byte.truncate(0))
        offset
    })
    while len(strings) % 8 != 0 { Vec.push(strings, Byte.truncate(0)) }
    let symbolsAt = alignUp(linkeditAt + len(binds), 8)
    let indirectAt = symbolsAt + 16 * len(entries)
    let stringsAt = indirectAt + 4 * 2 * n
    let signatureAt = alignUp(stringsAt + len(strings), 16)
    let signatureSize = CodeSignature.size(identifier, signatureAt)
    let fileSize = signatureAt + signatureSize

    -- Every field filled in, with each import standing for its stub.
    let stubOf = Map.new()
    for var k = 0; k < n; k = k + 1 { Map.put(stubOf, Asm.spell(imports[k]), k) }
    Image.apply(Encode.isa(), obj, addresses, [], fun(sym) = match Map.get(stubOf, Asm.spell(sym)) {
        Some(k) -> base + stubsAt + stubSize * k
        None -> error("internal error: " + Asm.spell(sym) + " is neither defined nor imported")
    })
    let named = Asm.spell(entry)
    let start = match Iterator.find(obj.defined, fun(d) = Asm.spell(d.symbol) == named) {
        Some(d) -> if d.section == text { textAt + d.offset } else {
            error("internal error: the entry " + Asm.spell(entry) + " is not code")
        }
        None -> error("internal error: the entry " + Asm.spell(entry) + " is not defined")
    }

    let out = Array.filled(fileSize, Byte.truncate(0))
    var at = 0
    let le = fun(width, value) {
        Byte.putLE(out, at, width, value)
        at = at + width
    }
    let name16 = fun(name) {
        let bytes = String.toBytes(name)
        for var k = 0; k < 16; k = k + 1 {
            out[at + k] = if k < len(bytes) { bytes[k] } else { Byte.truncate(0) }
        }
        at = at + 16
    }
    let segment = fun(name, address, size, offset, fileSize, protection, count, flags) {
        le(4, 0x19)
        le(4, segmentSize + sectionSize * count)
        name16(name)
        le(8, address)
        le(8, size)
        le(8, offset)
        le(8, fileSize)
        le(4, protection)
        le(4, protection)
        le(4, count)
        le(4, flags)
    }
    let section = fun(segmentName, name, offset, size, align, flags, indirect, stride) {
        name16(name)
        name16(segmentName)
        le(8, base + offset)
        le(8, size)
        le(4, offset)
        le(4, align)
        le(4, 0)
        le(4, 0)
        le(4, flags)
        le(4, indirect)
        le(4, stride)
        le(4, 0)
    }

    -- mach_header_64: arm64, an executable, with every undefined symbol
    -- bound to a library (`MH_NOUNDEFS`), loaded by dyld (`MH_DYLDLINK`),
    -- looked up in that library alone (`MH_TWOLEVEL`), and loaded at a
    -- random address (`MH_PIE`).
    le(4, 0xFEEDFACF)
    le(4, 0x0100000C)
    le(4, 0)
    le(4, 2)
    le(4, fixedCommands + len(dylibs))
    le(4, commandsSize)
    le(4, 0x00200085)
    le(4, 0)
    segment("__PAGEZERO", 0, base, 0, 0, 0, 0, 0)
    segment("__TEXT", base, textSegment, 0, textSegment, 5, textSections, 0)
    -- Instructions, and only instructions.
    section("__TEXT", "__text", textAt, len(sections[text].bytes), sections[text].align,
            0x80000400, 0, 0)
    -- `S_SYMBOL_STUBS`, each `stubSize` bytes, whose imports are the first
    -- `n` entries of the indirect symbol table.
    section("__TEXT", "__stubs", stubsAt, stubSize * n, 2, 0x80000408, 0, stubSize)
    section("__TEXT", "__cstring", cstringsAt, len(sections[cstrings].bytes),
            sections[cstrings].align, 0x2, 0, 0)
    section("__TEXT", "__const", constantsAt, len(sections[constants].bytes),
            sections[constants].align, 0, 0, 0)
    -- `SG_READ_ONLY`: read-only once the loader has bound it.
    segment("__DATA_CONST", base + offsetTableAt, offsetTableSegmentSize, offsetTableAt,
            offsetTableSegmentSize, 3, 1, 0x10)
    -- `S_NON_LAZY_SYMBOL_POINTERS`, whose imports are the next `n` entries.
    section("__DATA_CONST", "__got", offsetTableAt, 8 * n, 3, 0x6, n, 0)
    segment("__DATA", base + dataAt, dataSegment, dataAt, dataSegment, 3, 1, 0)
    section("__DATA", "__data", dataAt, len(sections[data].bytes), sections[data].align, 0,
            0, 0)
    segment("__LINKEDIT", base + linkeditAt, pages(fileSize - linkeditAt), linkeditAt,
            fileSize - linkeditAt, 1, 0, 0)
    -- LC_DYLD_INFO_ONLY: binds, and no rebases, weak binds, lazy binds or
    -- exports.
    le(4, 0x80000022)
    le(4, 48)
    le(4, 0)
    le(4, 0)
    le(4, linkeditAt)
    le(4, len(binds))
    for var k = 0; k < 6; k = k + 1 { le(4, 0) }
    -- LC_SYMTAB
    le(4, 0x2)
    le(4, 24)
    le(4, symbolsAt)
    le(4, len(entries))
    le(4, stringsAt)
    le(4, len(strings))
    -- LC_DYSYMTAB: the three runs of the symbol table, and the indirect
    -- symbol table, which names each stub's import and then each slot's.
    le(4, 0xB)
    le(4, 80)
    le(4, 0)
    le(4, locals)
    le(4, locals)
    le(4, exported)
    le(4, locals + exported)
    le(4, n)
    for var k = 0; k < 6; k = k + 1 { le(4, 0) }
    le(4, indirectAt)
    le(4, 2 * n)
    for var k = 0; k < 4; k = k + 1 { le(4, 0) }
    -- LC_LOAD_DYLINKER
    le(4, 0xE)
    le(4, 32)
    le(4, 12)
    string(out, at, dylinker)
    at = at + 20
    -- LC_UUID, filled in once everything else is.
    let uuidAt = at + 8
    le(4, 0x1B)
    le(4, 24)
    at = at + 16
    -- LC_BUILD_VERSION: macOS, and no tools.
    le(4, 0x32)
    le(4, 24)
    le(4, 1)
    le(4, minimumOS)
    le(4, minimumOS)
    le(4, 0)
    -- LC_MAIN: the entry's offset in the file, and the default stack.
    le(4, 0x80000028)
    le(4, 24)
    le(8, start)
    le(8, 0)
    -- LC_LOAD_DYLIB: libSystem, at version 1.0.0 or later, and then each
    -- other library with both versions 0, which dyld does not check.
    for var k = 0; k < len(dylibs); k = k + 1 {
        let version = if k == 0 { 0x10000 } else { 0 }
        le(4, 0xC)
        le(4, dylibSizes[k])
        le(4, 24)
        le(4, 2)
        le(4, version)
        le(4, version)
        string(out, at, dylibs[k])
        at = at + dylibSizes[k] - 24
    }
    -- LC_CODE_SIGNATURE
    le(4, 0x1D)
    le(4, 16)
    le(4, signatureAt)
    le(4, signatureSize)
    if at != headerSize + commandsSize {
        error("internal error: the load commands take " + Int.toString(at - headerSize)
              + " bytes, not " + Int.toString(commandsSize))
    }

    copy(out, textAt, sections[text].bytes)
    copy(out, stubsAt, stubs(base + stubsAt, base + offsetTableAt, n))
    copy(out, cstringsAt, sections[cstrings].bytes)
    copy(out, constantsAt, sections[constants].bytes)
    copy(out, dataAt, sections[data].bytes)
    for var k = 0; k < len(binds); k = k + 1 { out[linkeditAt + k] = binds[k] }
    for var k = 0; k < len(entries); k = k + 1 {
        let e = entries[k]
        let p = symbolsAt + 16 * k
        Byte.putLE(out, p, 4, nameAt[k])
        Byte.putLE(out, p + 4, 1, e.kind)
        Byte.putLE(out, p + 5, 1, e.section)
        Byte.putLE(out, p + 6, 2, e.desc)
        Byte.putLE(out, p + 8, 8, e.value)
    }
    -- The undefined symbols are the imports, in the same order.
    for var k = 0; k < 2 * n; k = k + 1 {
        Byte.putLE(out, indirectAt + 4 * k, 4, locals + exported + k % n)
    }
    copy(out, stringsAt, strings)

    -- The UUID is the first half of a SHA-256 of the file with the UUID
    -- and signature still zero, marked as RFC 9562's version 8, a UUID of
    -- the maker's own construction, with the RFC 4122 variant.
    let h = SHA256.new()
    SHA256.update(h, out, 0, signatureAt)
    let digest = SHA256.finish(h)
    for var k = 0; k < 16; k = k + 1 { out[uuidAt + k] = digest[k] }
    out[uuidAt + 6] = Byte.truncate(Byte.toInt(digest[6]) & 0x0F | 0x80)
    out[uuidAt + 8] = Byte.truncate(Byte.toInt(digest[8]) & 0x3F | 0x80)
    CodeSignature.sign(out, signatureAt, identifier, (0, textSegment))
    out
}

-- The bind opcodes that fill in the offset table: one slot per import, in
-- order from its start, each bound to a pointer to the import in the library
-- of the same place in `ordinals`. Ends with `BIND_OPCODE_DONE` and padded to
-- eight bytes.
fun bindOpcodes(imports : Array Symbol, ordinals : Array Int) -> Vec Byte {
    let out = []
    let op = fun(n) = Vec.push(out, Byte.truncate(n))
    -- BIND_OPCODE_SET_TYPE_IMM BIND_TYPE_POINTER, and
    -- BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB at the table's start.
    op(0x51)
    op(0x70 | offsetTableSegment)
    op(0)
    -- For each import: its library, when it is not the last one's, by
    -- BIND_OPCODE_SET_DYLIB_ORDINAL_IMM, or _ULEB past the immediate's four
    -- bits; BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM with no flags; then
    -- BIND_OPCODE_DO_BIND, which steps to the next slot.
    var library = 0
    for var k = 0; k < len(imports); k = k + 1 {
        let sym = imports[k]
        if ordinals[k] != library {
            library = ordinals[k]
            if library < 16 {
                op(0x10 | library)
            } else {
                op(0x20)
                uleb(out, library)
            }
        }
        op(0x40)
        for b in String.bytes(sym.name) { Vec.push(out, b) }
        op(0)
        op(0x90)
    }
    op(0)
    while len(out) % 8 != 0 { op(0) }
    out
}

-- The symbol table, and how many of its entries are local and how many
-- exported. Each import is from the library of the same place in
-- `ordinals`. `addresses` holds each section's address, or -1 for one the
-- image leaves out.
fun symbols(obj : Object Fixup, imports : Array Symbol, ordinals : Array Int,
            addresses : Array Int) -> (Vec Entry, Int, Int) {
    let locals = []
    let exported = []
    for d in obj.defined {
        if let Temporary = d.symbol.kind { continue }
        if addresses[d.section] < 0 {
            error("internal error: " + d.symbol.name + " is in a section the image leaves out")
        }
        let e = Entry { name = d.symbol.name, kind = if d.exported { 0xF } else { 0xE },
                        section = ordinals[d.section], desc = 0,
                        value = addresses[d.section] + d.offset }
        Vec.push(if d.exported { exported } else { locals }, e)
    }
    let byName = fun(a : Entry, b : Entry) = Array.threeWay(a.name, b.name)
    let entries = []
    for e in locals { Vec.push(entries, e) }
    for e in Vec.sortBy(exported, byName) { Vec.push(entries, e) }
    -- N_UNDF | N_EXT, with the library's ordinal in the description's high
    -- byte.
    for var k = 0; k < len(imports); k = k + 1 {
        Vec.push(entries, Entry { name = imports[k].name, kind = 0x1, section = 0,
                                  desc = ordinals[k] << 8, value = 0 })
    }
    (entries, len(locals), len(exported))
}

-- Appends `n`, unsigned, as LEB128.
fun uleb(out : Vec Byte, n : Int) -> Unit {
    var rest = n
    loop {
        let low = rest & 0x7F
        rest = rest >> 7
        if rest == 0 {
            Vec.push(out, Byte.truncate(low))
            break
        }
        Vec.push(out, Byte.truncate(low | 0x80))
    }
}

-- `text`'s bytes at `at`, the zeros after them already there.
fun string(out : Array Byte, at : Int, text : String) -> Unit {
    let bytes = String.toBytes(text)
    for var k = 0; k < len(bytes); k = k + 1 { out[at + k] = bytes[k] }
}

-- A segment's size for `n` bytes: whole pages, and at least one.
fun pages(n : Int) -> Int = max(alignUp(n, page), page)
