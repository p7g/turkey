export (Matcher(..), Body(..), compile)

-- Match compilation: a `match` over source patterns, which nest, becomes nested
-- `match`es over `Turkey.Core.Alt`s, which do not.
--
-- `Turkey.Lower` calls this for every `match` it builds, so Core never holds a
-- nested pattern and every pass after it sees one level of test at a time. That
-- is the shape `Turkey.Opt`'s case-of-known-constructor decides, so a
-- constructor built in one place and taken apart by a nested pattern in
-- another meets a rule that can delete it, and a group of arms that test the
-- same value tests it once.
--
-- The automaton is a backtracking one, in the style of Wadler's chapter of
-- *The Implementation of Functional Programming Languages* (Peyton Jones,
-- 1987) and of Le Fessant and Maranget, "Optimizing pattern matching" (ICFP
-- 2001). The arms are rows of a matrix with one column per value under test.
-- The first column splits the rows into maximal runs whose patterns there are
-- all variables or all constructors (the *mixture rule*). A run of
-- constructors is one `match` on the column with one arm per constructor, in
-- the order the rows first name them, so rows that name the same constructor
-- share a test and the rows for different constructors, which cannot both
-- match, are not tested against each other. A run of variables binds the
-- column and drops it. When a run fails, control goes to the code for the next
-- run, which is a join point the run jumps to.
--
-- Backtracking rather than a decision tree because the size of the output is
-- linear in the size of the input: no arm body and no pattern is copied. A
-- decision tree tests fewer things on some paths and copies arms to do it, and
-- `Opt` then inlines whatever this emits.
--
-- What this does not decide: whether the arms are exhaustive and which are
-- unreachable. `Turkey.Exhaustive` has said so already, on the patterns as
-- written. A value no arm matches reaches a `match` with no arm for it, and the
-- backend panics there.
--
-- The order of tests is the order of the source: columns left to right, a
-- constructor's fields before the columns after it. A run is never reordered
-- with another, so an arm that might match is tried before every arm after it.
--
-- An arm with guards is a row like any other until its patterns have all
-- matched. Its guards then run under its bindings, and a failing one jumps to
-- the rows after it, which is a join point of its own.
--
-- Alternatives inside a pattern, `(GET | HEAD, path)`, are compiled where they
-- stand rather than multiplied out into one row per combination, which would
-- copy the rest of the row once per alternative and grow as the product of
-- their counts. A row whose first pattern is alternatives is a run of its own:
-- a join point that takes the variables the alternatives bind and matches the
-- rest of the row, and a one-column matrix with a row per alternative, each
-- jumping there with what it bound. This is Le Fessant and Maranget's scheme
-- with exits that carry variables. The first alternative that matches is the
-- one taken: when the rest of the row or a guard then fails, the rows after it
-- are tried, not the other alternatives. Retrying them could only matter to a
-- guard, since the rest of the row tests other columns.

import Turkey.Ast (..)
import Turkey.Core (..)
import Turkey.Decls as Decls
import Turkey.Decls (DeclTable)
import Turkey.Diag as Diag
import Turkey.Source (Span)
import Turkey.Types as Ty
import Turkey.Types (TTuple, TBottom, TCon)

-- What compiling needs from the pass that calls it: the declarations, how to
-- reduce a field's type to the one its constructors are read off, how to name
-- a binder it invents, and the id of the binder a pattern variable binds. A
-- binder is a spelling and an id; see `Turkey.Core.CParam`.
type Matcher = Matcher {
    decls    : DeclTable,
    reduce   : fun(Ty.Type) -> Ty.Type,
    fresh    : fun(String) -> (String, Int),
    binderOf : fun(Pat) -> Int,
}

-- What an arm does once its patterns have matched.
type Body
    -- Returns its value.
    = Taken(Core)
    -- Runs its guards and then returns its value. Given a join that takes no
    -- arguments, its spelling and id, returns code that jumps there when a
    -- guard fails.
    | Guarded(fun((String, Int)) -> Core)

-- One compilation's state: how many jumps there are to each fallthrough, and
-- which fallthroughs a guard jumps to, each by the fallthrough's id.
type State = State {
    m       : Matcher,
    jumps   : Map Int Int,
    guarded : Map Int Bool,
}

-- `match scrutinee { arms }`, of type `ty`, compiled.
fun compile(m : Matcher, scrutinee : Core, arms : Vec (Pat, Body), ty : Ty.Type,
            span : Option Span) -> Core {
    let st = State { m = m, jumps = Map.new(), guarded = Map.new() }
    let site = Site { ty = ty, span = span }
    -- The scrutinee is evaluated once, and a later run may test it again, so it
    -- is held in a variable unless it is one or nothing reads it twice.
    let root = match scrutinee.kind {
        CVar(name, id) -> Column { name = name, id = id, ty = scrutinee.ty }
        _ -> {
            let (name, id) = m.fresh("scrut")
            Column { name = name, id = id, ty = scrutinee.ty }
        }
    }
    let rows = Array.map(arms, fun((pat, body)) = Row { pats = [pat], binds = [], body = body })
    let out = if len(rows) == 0 {
        switch(root, [], site)
    } else {
        matrix(st, [root], rows, None, site)
    }
    match scrutinee.kind {
        CVar(_, _) -> out
        _ -> once(out, root, scrutinee)
    }
}

-- `out` with the scrutinee in the one place that reads the column `root`, when
-- that place is where `out` starts, and bound to `root` around `out` otherwise.
fun once(out : Core, root : Column, scrutinee : Core) -> Core {
    let counted = Map.new()
    countNames(out, counted)
    if Map.getOr(counted, root.id, 0) == 1 {
        match out.kind {
            CMatch(s, alts) -> if isVar(s, root.id) {
                return mkCore(out.ty, out.span, CMatch(scrutinee, alts))
            }
            CLet(bound, boundId, ty, value, body, binders) -> if isVar(value, root.id) {
                return mkCore(out.ty, out.span,
                              CLet(bound, boundId, ty, scrutinee, body, binders))
            }
            _ -> {}
        }
    }
    mkCore(out.ty, out.span, CLet(root.name, root.id, scrutinee.ty, scrutinee, out, []))
}

fun isVar(e : Core, id : Int) -> Bool = match e.kind {
    CVar(_, n) -> n == id
    _ -> False
}

-- Counts the references to each binder in `e`, by id.
fun countNames(e : Core, out : Map Int Int) -> Unit {
    match e.kind {
        CVar(_, n) -> Map.put(out, n, Map.getOr(out, n, 0) + 1)
        _ -> {}
    }
    discard(mapKind(e.kind, Mapper {
        expr = fun(x) = {
            countNames(x, out)
            x
        },
        type_ = fun(t) = t,
        bind = fun(b) = {
            countNames(b.value, out)
            b
        },
    }))
}

fun discard(x : a) -> Unit = {}

-- -- the matrix ------------------------------------------------------------------------

-- A value under test: the variable that holds it, and its type.
type Column = Column { name : String, id : Int, ty : Ty.Type }

-- One arm, part way through: the patterns still to test, one per column, and
-- the variables the patterns already passed bound, each to the column it named.
type Row = Row {
    pats  : Array Pat,
    binds : Array (String, Int, Ty.Type, Column),
    body  : Body,
}

-- What every `match` this emits shares: the type and span of the source one.
type Site = Site { ty : Ty.Type, span : Option Span }

-- The code for `rows` against `columns`, jumping to `fail` when none matches,
-- or reaching a `match` with no arm for the value when there is no `fail`.
fun matrix(st : State, columns : Vec Column, rows : Array Row,
           fail : Option (String, Int), site : Site) -> Core {
    if len(columns) == 0 { return leaves(st, rows, 0, fail, site) }
    runs(st, columns, runsOf(rows), 0, fail, site)
}

-- Returns the code for rows `i` onwards once every test has passed: the first
-- row's body, then the rows after it if that body is guarded and a guard fails.
--
-- A guard fails under its row's bindings, so the rows after it are a join
-- defined outside them, and `fail` is marked as reached from under bindings.
-- A guarded row with no row after it falls to `fail`. There is always one:
-- `Turkey.Exhaustive` counts a guarded arm as covering nothing, so some later
-- arm handles every value a guard can decline.
fun leaves(st : State, rows : Array Row, i : Int, fail : Option (String, Int),
           site : Site) -> Core {
    let row = rows[i]
    match row.body {
        Taken(body) -> leafOf(row, body)
        Guarded(build) -> {
            if i + 1 == len(rows) {
                let (target, targetId) = match fail {
                    Some(f) -> f
                    None -> oops("a guarded arm with nothing to fall through to")
                }
                Map.put(st.jumps, targetId, Map.getOr(st.jumps, targetId, 0) + 1)
                Map.put(st.guarded, targetId, True)
                return leafOf(row, build((target, targetId)))
            }
            let (next, nextId) = st.m.fresh("next")
            let rest = leaves(st, rows, i + 1, fail, site)
            mkCore(site.ty, site.span,
                   CJoin(next, nextId, [], rest, leafOf(row, build((next, nextId))), False))
        }
    }
}

-- A row with every test passed: `body` under the variables the row bound.
--
-- The bindings are made here and not where each variable was met, so that no
-- jump to a fallthrough from a pattern test is ever under a binding a later
-- arm's body could mention. That is what lets `runs` put a fallthrough with
-- one jump in the jump's place. A guard's jump is under them, which is why
-- `runs` keeps a fallthrough a guard reaches as a join.
fun leafOf(row : Row, body : Core) -> Core {
    var out = body
    for var i = len(row.binds) - 1; i >= 0; i = i - 1 {
        let (name, id, ty, column) = row.binds[i]
        out = mkCore(out.ty, out.span,
                     CLet(name, id, ty, mkCore(ty, out.span, CVar(column.name, column.id)),
                          out, []))
    }
    out
}

-- Runs `i` onwards: run `i`, falling through to the rest.
--
-- The rest is a join point when more than one place falls through to it, and
-- stands in for the one jump when one does.
fun runs(st : State, columns : Vec Column, all : Vec (Vec Row), i : Int,
         fail : Option (String, Int), site : Site) -> Core {
    if i + 1 == len(all) { return run(st, columns, all[i], fail, site) }
    let rest = runs(st, columns, all, i + 1, fail, site)
    let (next, nextId) = st.m.fresh("next")
    Map.put(st.jumps, nextId, 0)
    let first = run(st, columns, all[i], Some((next, nextId)), site)
    match Map.getOr(st.jumps, nextId, 0) {
        0 -> first
        1 -> if Map.contains(st.guarded, nextId) {
            mkCore(site.ty, site.span, CJoin(next, nextId, [], rest, first, False))
        } else {
            replaceJump(first, nextId, rest)
        }
        _ -> mkCore(site.ty, site.span, CJoin(next, nextId, [], rest, first, False))
    }
}

-- What a run's patterns are in its first column.
type Head = Variable | Literal | Tuple | Constructor | Alternatives

fun headOf(row : Row) -> Head = match unannot(row.pats[0]).kind {
    PVar(_) -> Variable
    PWild -> Variable
    PLit(_) -> Literal
    PTuple(_) -> Tuple
    PCon(_, _) -> Constructor
    PRecord(_, _, _) -> Constructor
    POr(_) -> Alternatives
    PAnnot(_, _) -> oops("an annotation under an annotation")
}

fun sameHead(a : Head, b : Head) -> Bool = match (a, b) {
    (Variable, Variable) -> True
    (Literal, Literal) -> True
    (Tuple, Tuple) -> True
    (Constructor, Constructor) -> True
    _ -> False
}

-- Whether a row is a run by itself: an existential pattern, or alternatives.
fun alone(row : Row) -> Bool = match headOf(row) {
    Alternatives -> True
    _ -> Option.isSome(unannot(row.pats[0]).opening)
}

-- The rows split where the kind of the first pattern changes. An existential
-- pattern is a run of its own: what it opens is named by its own pattern, and
-- two rows opening one constructor name their constants differently. So are
-- alternatives; see `alternatives`.
fun runsOf(rows : Array Row) -> Vec (Vec Row) {
    let out = []
    var current = [rows[0]]
    for var i = 1; i < len(rows); i = i + 1 {
        let row = rows[i]
        let prev = current[len(current) - 1]
        if sameHead(headOf(row), headOf(prev)) && !alone(row) && !alone(prev) {
            Vec.push(current, row)
        } else {
            Vec.push(out, current)
            current = [row]
        }
    }
    Vec.push(out, current)
    out
}

fun run(st : State, columns : Vec Column, rows : Vec Row,
        fail : Option (String, Int), site : Site) -> Core {
    let column = columns[0]
    let after = Vec.slice(columns, 1, len(columns))
    match headOf(rows[0]) {
        Variable -> matrix(st, after, Array.map(rows, fun(row) = {
            let bare = unannot(row.pats[0])
            let binds = match bare.kind {
                PVar(name) -> Array.append(row.binds,
                    [(name, st.m.binderOf(bare), column.ty, column)])
                _ -> row.binds
            }
            Row { pats = rest(row), binds = binds, body = row.body }
        }), fail, site)
        Literal -> literals(st, column, after, rows, fail, site)
        Tuple -> {
            let types = match st.m.reduce(column.ty) {
                TTuple(ts) -> ts
                _ -> []
            }
            let subs = Array.map(rows, fun(row) = match unannot(row.pats[0]).kind {
                PTuple(elems) -> elems
                _ -> oops("a tuple run with a row that is not a tuple")
            })
            let fieldTypes = Array.init(len(subs[0]), fun(i) =
                if i < len(types) { types[i] } else { TBottom })
            let (binders, body) = expand(st, after, rows, subs, fieldTypes, fail, site)
            switch(column, [CAlt { alt = ATuple(binders), body = body }], site)
        }
        Constructor -> constructors(st, column, after, rows, fail, site)
        Alternatives -> alternatives(st, column, after, rows[0], fail, site)
    }
}

-- A row whose first pattern is alternatives: a join that matches the rest of
-- the row, taking the variables the alternatives bind as columns, and a
-- `match` of the column against each alternative in turn that jumps to it.
--
-- The join's parameters are columns, so the row binds its variables to them
-- in `leafOf`, as it binds any other. Each alternative's variables are bound
-- under fresh binders of their own, since every alternative binds the same
-- names and a binder is bound once in a program; the jump passes those on.
-- Both the join and the alternatives fall through to `fail`.
fun alternatives(st : State, column : Column, after : Vec Column, row : Row,
                 fail : Option (String, Int), site : Site) -> Core {
    let bare = unannot(row.pats[0])
    let alts = match bare.kind {
        POr(ps) -> ps
        _ -> oops("an alternatives run with a row that is not alternatives")
    }
    let types = Map.new()
    variableTypes(st, bare, column.ty, types)
    let vars = varPatterns(bare)
    let params = Array.map(vars, fun(v) {
        let name = varName(v)
        let (spelled, id) = st.m.fresh(name)
        CParam { name = spelled, id = id, ty = Map.getOr(types, name, TBottom) }
    })
    let binds = Array.append(row.binds, Array.init(len(vars), fun(i) {
        let p = params[i]
        (varName(vars[i]), st.m.binderOf(vars[i]), p.ty,
         Column { name = p.name, id = p.id, ty = p.ty })
    }))
    let continued = matrix(st, after, [Row { pats = rest(row), binds = binds, body = row.body }],
                      fail, site)
    let (label, labelId) = st.m.fresh("matched")
    -- A variable is bound under its own spelling, and only its binder is new.
    let renamed = Map.new()
    let rows = Array.map(alts, fun(alt) {
        let mine = Map.new()
        for v in varPatterns(alt) {
            let (_, id) = st.m.fresh(varName(v))
            Map.put(renamed, v.id, id)
            Map.put(mine, varName(v), id)
        }
        let args = Vec.new(len(vars))
        for var i = 0; i < len(vars); i = i + 1 {
            let name = varName(vars[i])
            let id = match Map.get(mine, name) {
                Some(found) -> found
                None -> oops("an alternative that does not bind '" + name + "'")
            }
            Vec.push(args, mkCore(params[i].ty, site.span, CVar(name, id)))
        }
        Row { pats = [alt], binds = [],
              body = Taken(mkCore(TBottom, site.span, CJump(label, labelId, args))) }
    })
    let inner = State {
        m = Matcher {
            decls = st.m.decls, reduce = st.m.reduce, fresh = st.m.fresh,
            binderOf = fun(p) = match Map.get(renamed, p.id) {
                Some(id) -> id
                None -> st.m.binderOf(p)
            },
        },
        jumps = st.jumps, guarded = st.guarded,
    }
    let tried = matrix(inner, [column], rows, fail, site)
    mkCore(site.ty, site.span, CJoin(label, labelId, params, continued, tried, False))
}

-- Adds to `out` the type of each variable `p` binds, matched against a value
-- of type `ty`: the types the columns for them would have.
fun variableTypes(st : State, p : Pat, ty : Ty.Type, out : Map String Ty.Type) -> Unit =
    match p.kind {
        PVar(name) -> Map.put(out, name, ty)
        PWild -> {}
        PLit(_) -> {}
        PAnnot(inner, _) -> variableTypes(st, inner, ty, out)
        POr(alts) -> variableTypes(st, alts[0], ty, out)
        PTuple(elems) -> match st.m.reduce(ty) {
            TTuple(ts) -> for var i = 0; i < len(elems) && i < len(ts); i = i + 1 {
                variableTypes(st, elems[i], ts[i], out)
            }
            _ -> oops("a tuple pattern against " + Ty.show(ty))
        }
        PCon(name, _) | PRecord(name, _, _) -> {
            let info = match Decls.con(st.m.decls, name) {
                Some(i) -> i
                None -> oops("unknown constructor '" + name + "'")
            }
            let fields = match Decls.conFieldTypes(st.m.decls, st.m.reduce(ty), name) {
                Some(ts) -> ts
                None -> oops("no field types for '" + name + "' at " + Ty.show(ty))
            }
            let subs = positional(info, p)
            for var i = 0; i < len(subs) && i < len(fields); i = i + 1 {
                variableTypes(st, subs[i], fields[i], out)
            }
        }
    }

fun varName(p : Pat) -> String = match p.kind {
    PVar(name) -> name
    _ -> oops("a binder from a pattern that is not a variable")
}

-- A row's patterns after its first.
fun rest(row : Row) -> Array Pat = Array.slice(row.pats, 1, len(row.pats))

-- One arm per constructor the run names, in the order it first names them, and
-- an arm that falls through when the run does not name them all.
fun constructors(st : State, column : Column, after : Vec Column,
                 rows : Vec Row, fail : Option (String, Int), site : Site) -> Core {
    let names = []
    for row in rows {
        let name = conName(unannot(row.pats[0]))
        if !Vec.contains(names, name) { Vec.push(names, name) }
    }
    let ty = st.m.reduce(column.ty)
    let alts = []
    for name in names {
        let info = match Decls.con(st.m.decls, name) {
            Some(i) -> i
            None -> oops("unknown constructor '" + name + "'")
        }
        let these = Vec.filter(rows, fun(row) = conName(unannot(row.pats[0])) == name)
        let opening = unannot(these[0].pats[0]).opening
        let fieldTypes = match opening {
            Some(o) -> Decls.conFieldTypesOpened(st.m.decls, ty, name,
                                                 Array.map(o.skolems, TCon))
            None -> Decls.conFieldTypes(st.m.decls, ty, name)
        }
        let types = match fieldTypes {
            Some(ts) -> ts
            None -> oops("no field types for '" + name + "' at " + Ty.show(ty))
        }
        let subs = Array.map(these, fun(row) = positional(info, unannot(row.pats[0])))
        let (binders, body) = expand(st, after, these, subs, types, fail, site)
        Vec.push(alts, CAlt { alt = ACon(name, binders, opening), body = body })
    }
    if len(names) < Decls.variantCount(st.m.decls, names[0]) {
        orElse(st, alts, fail, site)
    }
    switch(column, alts, site)
}

fun conName(p : Pat) -> String = match p.kind {
    PCon(name, _) -> name
    PRecord(name, _, _) -> name
    _ -> oops("a constructor run with a row that is not a constructor")
}

-- A constructor pattern's fields in declaration order, `_` for a record field
-- it does not name.
fun positional(info : Decls.ConInfo, p : Pat) -> Vec Pat = match p.kind {
    PCon(_, args) -> args
    PRecord(_, labelled, _) -> match info.fields {
        Some(labels) -> {
            let out = Vec.new(len(labels))
            for label in labels {
                var sub = Pat { id = p.id, span = p.span, kind = PWild, opening = None }
                for (given, pat) in labelled {
                    if given == label { sub = pat }
                }
                Vec.push(out, sub)
            }
            out
        }
        None -> oops("a record pattern for '" + info.name + "', which has no fields")
    }
    _ -> oops("not a constructor pattern")
}

-- One arm per literal the run names, and one that falls through: no run of
-- literals names them all.
--
-- Two rows share an arm when their literals are spelled alike. Not floats,
-- whose equality is not their spelling's.
fun literals(st : State, column : Column, after : Vec Column,
             rows : Vec Row, fail : Option (String, Int), site : Site) -> Core {
    let seen : Vec Lit = []
    let groups : Vec (Vec Row) = []
    for row in rows {
        let lit = literalOf(row)
        var found = -1
        for var i = 0; i < len(seen); i = i + 1 {
            if found < 0 && sameLiteral(seen[i], lit) { found = i }
        }
        if found < 0 {
            Vec.push(seen, lit)
            Vec.push(groups, [row])
        } else {
            Vec.push(groups[found], row)
        }
    }
    let alts = []
    for var i = 0; i < len(groups); i = i + 1 {
        let inner = Array.map(groups[i], fun(row) = Row {
            pats = rest(row), binds = row.binds, body = row.body,
        })
        Vec.push(alts, CAlt { alt = ALit(seen[i]),
                                body = matrix(st, after, inner, fail, site) })
    }
    orElse(st, alts, fail, site)
    switch(column, alts, site)
}

fun literalOf(row : Row) -> Lit = match unannot(row.pats[0]).kind {
    PLit(lit) -> lit
    _ -> oops("a literal run with a row that is not a literal")
}

fun sameLiteral(a : Lit, b : Lit) -> Bool = match (a, b) {
    (LInt(x), LInt(y)) -> x == y
    (LString(x), LString(y)) -> x == y
    (LChar(x), LChar(y)) -> x == y
    _ -> False
}

-- The arm that falls through, when there is somewhere to fall.
fun orElse(st : State, alts : Vec CAlt, fail : Option (String, Int), site : Site) -> Unit =
    match fail {
        Some(target) -> Vec.push(alts, CAlt { alt = AAny(None), body = jump(st, target, site) })
        None -> {}
    }

-- A constructor's or tuple's fields as new columns ahead of the rest, and the
-- rows with their sub-patterns in front: the binders of the arm, and its body.
--
-- A field every row ignores is not bound. A row alone in its arm with nothing
-- left to test binds its variables in the arm itself, which is the arm as it
-- was written: no test follows, so nothing can fall through from under them.
-- Otherwise each field is bound to a fresh variable, a column the rows go on
-- to test.
fun expand(st : State, after : Vec Column, rows : Vec Row,
           subs : Array (Vec Pat), types : Array Ty.Type,
           fail : Option (String, Int), site : Site)
        -> (Array (Option (String, Int)), Core) {
    if len(rows) == 1 && every(subs[0], leaf) && every(rest(rows[0]), leaf) {
        let row = rows[0]
        let binders = Array.map(subs[0], fun(p) {
            let bare = unannot(p)
            match bare.kind {
                PVar(name) -> Some((name, st.m.binderOf(bare)))
                _ -> None
            }
        })
        let inner = Row { pats = rest(row), binds = row.binds, body = row.body }
        return (binders, matrix(st, after, [inner], fail, site))
    }
    let columns = []
    let kept = []
    let binders = Array.init(len(types), fun(i) {
        var used = False
        for s in subs {
            if i < len(s) && !ignored(s[i]) { used = True }
        }
        if used {
            let (name, id) = st.m.fresh(hintFor(subs, i))
            Vec.push(columns, Column { name = name, id = id, ty = types[i] })
            Vec.push(kept, i)
            Some((name, id))
        } else {
            None
        }
    })
    let inner = Array.init(len(rows), fun(r) {
        let row = rows[r]
        let front = Array.map(kept, fun(i) = subs[r][i])
        Row { pats = Array.append(front, rest(row)), binds = row.binds, body = row.body }
    })
    (binders, matrix(st, Vec.append(columns, after), inner, fail, site))
}

-- What a field's column is called after: the variable the rows bind it to,
-- when they agree on one, so a dump still says `k` where the source did. The
-- column is a fresh name all the same, since a body under it may read another
-- `k`; only the letters are kept, and the printer drops the counter.
fun hintFor(subs : Array (Vec Pat), i : Int) -> String {
    var named = ""
    for s in subs {
        if i < len(s) {
            match unannot(s[i]).kind {
                PWild -> {}
                PVar(name) -> if named == "" || named == name { named = name } else {
                    return "field"
                }
                _ -> return "field"
            }
        }
    }
    let letters = String.fromCodePoints(takeLetters(named))
    if letters == "" { "field" } else { letters }
}

fun takeLetters(name : String) -> Vec Char {
    let out = []
    for ch in String.codePoints(name) {
        if !Char.isAsciiAlpha(ch) { return out }
        Vec.push(out, ch)
    }
    out
}

fun every[Iterator c, Item c ~ a](xs : c, p : fun(a) -> Bool) -> Bool {
    for x in xs { if !p(x) { return False } }
    True
}

-- A pattern that tests nothing.
fun leaf(p : Pat) -> Bool = match unannot(p).kind {
    PVar(_) -> True
    PWild -> True
    _ -> False
}

fun ignored(p : Pat) -> Bool = match unannot(p).kind {
    PWild -> True
    _ -> False
}

fun unannot(p : Pat) -> Pat = match p.kind {
    PAnnot(inner, _) -> unannot(inner)
    _ -> p
}

fun switch(column : Column, alts : Vec CAlt, site : Site) -> Core =
    mkCore(site.ty, site.span, CMatch(mkCore(column.ty, site.span,
                                             CVar(column.name, column.id)), alts))

-- -- fallthrough -----------------------------------------------------------------------

fun jump(st : State, target : (String, Int), site : Site) -> Core {
    let (name, id) = target
    Map.put(st.jumps, id, Map.getOr(st.jumps, id, 0) + 1)
    mkCore(TBottom, site.span, CJump(name, id, []))
}

-- `e` with its one jump to the join `label` replaced by `with`. Every variable `with`
-- reads is bound outside `e` or is a column bound around the jump under a name
-- of this pass's, so nothing on the way down can capture it; see `leafOf`.
--
-- An arm that only falls through, to code that binds the value its `match`
-- tests, becomes an arm binding that value: `_ -> let y = v in b`, in a
-- `match v`, is `y -> b`, which is the arm as it was written.
fun replaceJump(e : Core, label : Int, with : Core) -> Core = match e.kind {
    CJump(_, target, _) -> if target == label { with } else { e }
    CMatch(scrutinee, alts) -> mkCore(e.ty, e.span, CMatch(scrutinee, Vec.map(alts,
        fun(a) = match (a.alt, a.body.kind) {
            (AAny(None), CJump(_, target, _)) ->
                if target == label { bindingArm(scrutinee, with) } else { a }
            _ -> CAlt { alt = a.alt, body = replaceJump(a.body, label, with) }
        })))
    _ -> mkCore(e.ty, e.span, mapKind(e.kind, Mapper {
        expr = replaceJump(_, label, with),
        type_ = fun(t) = t,
        bind = fun(b) = CBind {
            name = b.name, id = b.id, ty = b.ty, binders = b.binders,
            value = replaceJump(b.value, label, with), span = b.span,
            mutable = b.mutable, module_ = b.module_, equations = b.equations,
            layouts = b.layouts,
        },
    }))
}

fun bindingArm(scrutinee : Core, with : Core) -> CAlt = match (scrutinee.kind, with.kind) {
    (CVar(_, tested), CLet(bound, boundId, _, value, body, binders)) ->
        if isVar(value, tested) && len(binders) == 0 {
            CAlt { alt = AAny(Some((bound, boundId))), body = body }
        } else {
            CAlt { alt = AAny(None), body = with }
        }
    _ -> CAlt { alt = AAny(None), body = with }
}

fun oops(message : String) -> a = Diag.fail(Diag.whole("internal error", message), "")
