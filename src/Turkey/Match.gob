module Turkey.Match (program)

-- Match compilation: every `match` whose arms nest patterns becomes nested
-- `match`es whose arms do not, before `Turkey.Opt` sees the program.
--
-- Afterwards an arm's pattern is *flat*: a variable, `_`, a literal, or a
-- constructor, record or tuple pattern whose parts are all variables or `_`.
-- That is the shape `Opt`'s case-of-known-constructor decides, so a constructor
-- built in one place and taken apart by a nested pattern in another meets a
-- rule that can delete it, and a group of arms that test the same value tests
-- it once.
--
-- The automaton is a backtracking one, in the style of Wadler's chapter of
-- *The Implementation of Functional Programming Languages* (Peyton Jones,
-- 1987) and of Le Fessant and Maranget, "Optimizing pattern matching" (ICFP
-- 2001). The arms are rows of a matrix with one column per value under test.
-- The first column splits the rows into maximal runs whose patterns there are
-- all variables or all constructors (the *mixture rule*). A run of
-- constructors is one `match` on the column with one arm per constructor, in
-- the order the rows first name them, so rows that name the same constructor
-- share a test and the rows for different constructors, which cannot both
-- match, are not tested against each other. A run of variables binds the
-- column and drops it. When a run fails, control goes to the code for the next
-- run, which is a join point the run jumps to.
--
-- Backtracking rather than a decision tree because the size of the output is
-- linear in the size of the input: no arm body and no pattern is copied. A
-- decision tree tests fewer things on some paths and copies arms to do it, and
-- `Opt` then inlines whatever this emits.
--
-- What this does not decide: whether the arms are exhaustive and which are
-- unreachable. `Turkey.Exhaustive` has said so already, on the patterns as
-- written. A value no arm matches reaches a flat `match` with no arm for it,
-- and the backend panics there as it would have before.
--
-- The order of tests is the order of the source: columns left to right, a
-- constructor's fields before the columns after it. A run is never reordered
-- with another, so an arm that might match is tried before every arm after it.

import Turkey.Ast
import Turkey.Classes (ClassTable)
import Turkey.Core
import Turkey.Coretc (famsOf)
import Turkey.Decls as Decls
import Turkey.Decls (DeclTable)
import Turkey.Diag as Diag
import Turkey.Source (Span)
import Turkey.Typed as Typed
import Turkey.Types as Ty
import Turkey.Types (TTuple, TBottom, TCon)

type Compiler = Compiler {
    decls     : DeclTable,
    classes   : ClassTable,
    -- The equalities of every binding the walk is inside, which is what a
    -- scrutinee's type is reduced under to find its constructors' fields.
    equations : Array (Ty.Type, Ty.Type),
    fams      : Ty.Families,
    counter   : Int,
    -- How many jumps there are to each fallthrough emitted so far.
    jumps     : Map String Int,
}

fun program(p : CProgram, decls : DeclTable, classes : ClassTable) -> CProgram {
    let c = Compiler {
        decls = decls, classes = classes, equations = [],
        fams = famsOf(classes, []), counter = 0, jumps = Map.new(),
    }
    CProgram {
        dicts = Array.map(p.dicts, bind(c, _)),
        binds = Array.map(p.binds, bind(c, _)),
    }
}

fun bind(c : Compiler, b : CBind) -> CBind {
    let saved = c.equations
    let savedFams = c.fams
    if len(b.equations) > 0 {
        c.equations = Array.append(saved, b.equations)
        c.fams = famsOf(c.classes, c.equations)
    }
    let value = expr(c, b.value)
    c.equations = saved
    c.fams = savedFams
    withValue(b, value)
}

fun withValue(b : CBind, value : Core) -> CBind = CBind {
    name = b.name, ty = b.ty, binders = b.binders, value = value,
    span = b.span, mutable = b.mutable, module_ = b.module_,
    equations = b.equations, layouts = b.layouts,
}

fun expr(c : Compiler, e : Core) -> Core = match e.kind {
    CMatch(scrutinee, alts) -> {
        let s = expr(c, scrutinee)
        let arms = Array.map(alts, fun(a) = CAlt { pat = a.pat, body = expr(c, a.body) })
        if every(arms, fun(a) = flat(a.pat)) {
            mkCore(e.ty, e.span, CMatch(s, arms))
        } else {
            compile(c, e, s, arms)
        }
    }
    _ -> mkCore(e.ty, e.span, mapKind(e.kind, Mapper {
        expr = expr(c, _),
        type_ = fun(t) = t,
        bind = bind(c, _),
    }))
}

-- Whether an arm's pattern is already one this pass would emit.
fun flat(p : Pat) -> Bool = match unannot(p).kind {
    PVar(_) -> True
    PWild -> True
    PLit(_) -> True
    PCon(_, args) -> every(args, leaf)
    PRecord(_, fields, _) -> every(fields, fun((_, sub)) = leaf(sub))
    PTuple(elems) -> every(elems, leaf)
    PAnnot(_, _) -> False
}

fun every(xs : Array a, p : fun(a) -> Bool) -> Bool {
    for x in xs { if !p(x) { return False } }
    True
}

fun leaf(p : Pat) -> Bool = match unannot(p).kind {
    PVar(_) -> True
    PWild -> True
    _ -> False
}

fun unannot(p : Pat) -> Pat = match p.kind {
    PAnnot(inner, _) -> unannot(inner)
    _ -> p
}

-- -- the matrix ------------------------------------------------------------------------

-- A value under test: the variable that holds it, and its type.
type Column = Column { name : String, ty : Ty.Type }

-- One arm, part way through: the patterns still to test, one per column, and
-- the variables the patterns already passed bound, each to the column it named.
type Row = Row {
    pats  : Array Pat,
    binds : Array (String, Ty.Type, String),
    body  : Core,
}

-- What every `match` this emits shares: the type and span of the one it
-- replaces.
type Site = Site { ty : Ty.Type, span : Option Span }

fun compile(c : Compiler, e : Core, scrutinee : Core, alts : Array CAlt) -> Core {
    let site = Site { ty = e.ty, span = e.span }
    -- The scrutinee is evaluated once, and a later run tests it again, so it is
    -- held in a variable unless it is one.
    let (root, held) = match scrutinee.kind {
        CVar(name) -> (Column { name = name, ty = scrutinee.ty }, False)
        _ -> (Column { name = fresh(c, "scrut"), ty = scrutinee.ty }, True)
    }
    let rows = Array.map(alts, fun(a) = Row { pats = [a.pat], binds = [], body = a.body })
    let out = matrix(c, [root], rows, None, site)
    if held {
        mkCore(e.ty, e.span, CLet(root.name, scrutinee.ty, scrutinee, out, []))
    } else {
        out
    }
}

-- The code for `rows` against `columns`, jumping to `fail` when none matches,
-- or reaching a `match` with no arm for the value when there is no `fail`.
fun matrix(c : Compiler, columns : Array Column, rows : Array Row,
           fail : Option String, site : Site) -> Core {
    if len(columns) == 0 { return leafOf(rows[0]) }
    runs(c, columns, runsOf(rows), 0, fail, site)
}

-- The first row, every test passed: its body under the variables it bound.
--
-- The bindings are made here and not where each variable was met, so that no
-- jump to a fallthrough is ever under a binding a later arm's body could
-- mention. That is what lets `runs` put a fallthrough with one jump in the
-- jump's place.
fun leafOf(row : Row) -> Core {
    var out = row.body
    for var i = len(row.binds) - 1; i >= 0; i = i - 1 {
        let (name, ty, column) = row.binds[i]
        out = mkCore(out.ty, out.span,
                     CLet(name, ty, mkCore(ty, out.span, CVar(column)), out, []))
    }
    out
}

-- Runs `i` onwards: run `i`, falling through to the rest.
--
-- The rest is a join point when more than one place falls through to it, and
-- stands in for the one jump when one does.
fun runs(c : Compiler, columns : Array Column, all : Array (Array Row), i : Int,
         fail : Option String, site : Site) -> Core {
    if i + 1 == len(all) { return run(c, columns, all[i], fail, site) }
    let rest = runs(c, columns, all, i + 1, fail, site)
    let next = fresh(c, "next")
    Map.put(c.jumps, next, 0)
    let first = run(c, columns, all[i], Some(next), site)
    match Map.getOr(c.jumps, next, 0) {
        0 -> first
        1 -> replaceJump(first, next, rest)
        _ -> mkCore(site.ty, site.span, CJoin(next, [], rest, first, False))
    }
}

-- What a run's patterns are in its first column.
type Head = Variable | Literal | Tuple | Constructor

fun headOf(row : Row) -> Head = match unannot(row.pats[0]).kind {
    PVar(_) -> Variable
    PWild -> Variable
    PLit(_) -> Literal
    PTuple(_) -> Tuple
    PCon(_, _) -> Constructor
    PRecord(_, _, _) -> Constructor
    PAnnot(_, _) -> oops("an annotation under an annotation")
}

fun sameHead(a : Head, b : Head) -> Bool = match (a, b) {
    (Variable, Variable) -> True
    (Literal, Literal) -> True
    (Tuple, Tuple) -> True
    (Constructor, Constructor) -> True
    _ -> False
}

fun opens(row : Row) -> Bool = Option.isSome(unannot(row.pats[0]).opening)

-- The rows split where the kind of the first pattern changes. An existential
-- pattern is a run of its own: what it opens is named by its own pattern, and
-- two rows opening one constructor name their constants differently.
fun runsOf(rows : Array Row) -> Array (Array Row) {
    let out = []
    var current = [rows[0]]
    for var i = 1; i < len(rows); i = i + 1 {
        let row = rows[i]
        let prev = current[len(current) - 1]
        if sameHead(headOf(row), headOf(prev)) && !opens(row) && !opens(prev) {
            Array.push(current, row)
        } else {
            Array.push(out, current)
            current = [row]
        }
    }
    Array.push(out, current)
    out
}

fun run(c : Compiler, columns : Array Column, rows : Array Row,
        fail : Option String, site : Site) -> Core {
    let column = columns[0]
    let after = Array.slice(columns, 1, len(columns))
    match headOf(rows[0]) {
        Variable -> matrix(c, after, Array.map(rows, fun(row) = {
            let binds = match unannot(row.pats[0]).kind {
                PVar(name) -> Array.append(row.binds, [(name, column.ty, column.name)])
                _ -> row.binds
            }
            Row { pats = Array.slice(row.pats, 1, len(row.pats)), binds = binds,
                  body = row.body }
        }), fail, site)
        Literal -> literals(c, column, after, rows, fail, site)
        Tuple -> {
            let types = match reduced(c, column.ty) {
                TTuple(ts) -> ts
                _ -> []
            }
            let head = unannot(rows[0].pats[0])
            let subs = Array.map(rows, fun(row) = match unannot(row.pats[0]).kind {
                PTuple(elems) -> elems
                _ -> oops("a tuple run with a row that is not a tuple")
            })
            let arity = len(subs[0])
            let fieldTypes = Array.new(arity)
            for var i = 0; i < arity; i = i + 1 {
                Array.push(fieldTypes, if i < len(types) { types[i] } else { TBottom })
            }
            let (pats, body) = expand(c, after, rows, subs, fieldTypes, fail, site)
            let pat = Pat { id = head.id, span = head.span, kind = PTuple(pats),
                            opening = None }
            switch(column, [CAlt { pat = pat, body = body }], site)
        }
        Constructor -> constructors(c, column, after, rows, fail, site)
    }
}

-- One arm per constructor the run names, in the order it first names them, and
-- an arm that falls through when the run does not name them all.
fun constructors(c : Compiler, column : Column, after : Array Column,
                 rows : Array Row, fail : Option String, site : Site) -> Core {
    let names = []
    for row in rows {
        let name = conName(unannot(row.pats[0]))
        if !Array.contains(names, name) { Array.push(names, name) }
    }
    let ty = reduced(c, column.ty)
    let alts = []
    for name in names {
        let info = match Decls.con(c.decls, name) {
            Some(i) -> i
            None -> oops("unknown constructor '" + name + "'")
        }
        let these = Array.filter(rows, fun(row) = conName(unannot(row.pats[0])) == name)
        let head = unannot(these[0].pats[0])
        let fieldTypes = match head.opening {
            Some(o) -> Decls.conFieldTypesOpened(c.decls, ty, name, Array.map(o.skolems, TCon))
            None -> Decls.conFieldTypes(c.decls, ty, name)
        }
        let types = match fieldTypes {
            Some(ts) -> ts
            None -> oops("no field types for '" + name + "' at " + Ty.show(ty))
        }
        let subs = Array.map(these, fun(row) = positional(info, unannot(row.pats[0])))
        let (pats, body) = expand(c, after, these, subs, types, fail, site)
        let kind = match info.fields {
            Some(labels) -> {
                let fields = []
                var dropped = False
                for var i = 0; i < len(labels) && i < len(pats); i = i + 1 {
                    match pats[i].kind {
                        PWild -> { dropped = True }
                        _ -> Array.push(fields, (labels[i], pats[i]))
                    }
                }
                PRecord(name, fields, dropped)
            }
            None -> PCon(name, pats)
        }
        let pat = Pat { id = head.id, span = head.span, kind = kind, opening = head.opening }
        Array.push(alts, CAlt { pat = pat, body = body })
    }
    if len(names) < Decls.variantCount(c.decls, names[0]) {
        orElse(c, alts, rows[0].pats[0], fail, site)
    }
    switch(column, alts, site)
}

fun conName(p : Pat) -> String = match p.kind {
    PCon(name, _) -> name
    PRecord(name, _, _) -> name
    _ -> oops("a constructor run with a row that is not a constructor")
}

-- A constructor pattern's fields in declaration order, `_` for a record field
-- it does not name.
fun positional(info : Decls.ConInfo, p : Pat) -> Array Pat = match p.kind {
    PCon(_, args) -> args
    PRecord(_, labelled, _) -> match info.fields {
        Some(labels) -> Array.map(labels, fun(label) = {
            var sub = Pat { id = p.id, span = p.span, kind = PWild, opening = None }
            for (given, pat) in labelled {
                if given == label { sub = pat }
            }
            sub
        })
        None -> oops("a record pattern for '" + info.name + "', which has no fields")
    }
    _ -> oops("not a constructor pattern")
}

-- One arm per literal the run names, and one that falls through: no run of
-- literals names them all.
--
-- Two rows share an arm when their literals are spelled alike. Not floats,
-- whose equality is not their spelling's.
fun literals(c : Compiler, column : Column, after : Array Column,
             rows : Array Row, fail : Option String, site : Site) -> Core {
    let seen : Array Lit = []
    let groups : Array (Array Row) = []
    for row in rows {
        let lit = literalOf(row)
        var found = -1
        for var i = 0; i < len(seen); i = i + 1 {
            if found < 0 && sameLiteral(seen[i], lit) { found = i }
        }
        if found < 0 {
            Array.push(seen, lit)
            Array.push(groups, [row])
        } else {
            Array.push(groups[found], row)
        }
    }
    let alts = []
    for group in groups {
        let head = unannot(group[0].pats[0])
        let rest = Array.map(group, fun(row) = Row {
            pats = Array.slice(row.pats, 1, len(row.pats)),
            binds = row.binds, body = row.body,
        })
        let pat = Pat { id = head.id, span = head.span, kind = head.kind, opening = None }
        Array.push(alts, CAlt { pat = pat, body = matrix(c, after, rest, fail, site) })
    }
    orElse(c, alts, rows[0].pats[0], fail, site)
    switch(column, alts, site)
}

fun literalOf(row : Row) -> Lit = match unannot(row.pats[0]).kind {
    PLit(lit) -> lit
    _ -> oops("a literal run with a row that is not a literal")
}

fun sameLiteral(a : Lit, b : Lit) -> Bool = match (a, b) {
    (LInt(x), LInt(y)) -> x == y
    (LString(x), LString(y)) -> x == y
    (LChar(x), LChar(y)) -> x == y
    _ -> False
}

-- The arm that falls through, when there is somewhere to fall.
fun orElse(c : Compiler, alts : Array CAlt, at : Pat, fail : Option String, site : Site) -> Unit =
    match fail {
        Some(name) -> {
            let pat = Pat { id = at.id, span = at.span, kind = PWild, opening = None }
            Array.push(alts, CAlt { pat = pat, body = jump(c, name, site) })
        }
        None -> {}
    }

-- A constructor's or tuple's fields as new columns ahead of the rest, and the
-- rows with their sub-patterns in front.
--
-- A field every row ignores gets no column, and its pattern in the flat arm is
-- `_`; the others are bound to fresh variables, which are the flat arm's
-- pattern.
fun expand(c : Compiler, after : Array Column, rows : Array Row,
           subs : Array (Array Pat), types : Array Ty.Type,
           fail : Option String, site : Site) -> (Array Pat, Core) {
    let head = unannot(rows[0].pats[0])
    let pats = []
    let columns = []
    let kept = []
    for var i = 0; i < len(types); i = i + 1 {
        var used = False
        for s in subs {
            if i < len(s) && !ignored(s[i]) { used = True }
        }
        if used {
            let name = fresh(c, hintFor(subs, i))
            Array.push(columns, Column { name = name, ty = types[i] })
            Array.push(kept, i)
            Array.push(pats, Pat { id = head.id, span = head.span, kind = PVar(name),
                                   opening = None })
        } else {
            Array.push(pats, Pat { id = head.id, span = head.span, kind = PWild,
                                   opening = None })
        }
    }
    let inner = []
    for var r = 0; r < len(rows); r = r + 1 {
        let row = rows[r]
        let front = Array.map(kept, fun(i) = subs[r][i])
        Array.push(inner, Row {
            pats = Array.append(front, Array.slice(row.pats, 1, len(row.pats))),
            binds = row.binds, body = row.body,
        })
    }
    (pats, matrix(c, Array.append(columns, after), inner, fail, site))
}

-- What a field's column is called after: the variable the rows bind it to,
-- when they agree on one, so a dump still says `k` where the source did. The
-- column is a fresh name all the same, since a body under it may read another
-- `k`; only the letters are kept, which is what the printer renumbers.
fun hintFor(subs : Array (Array Pat), i : Int) -> String {
    var named = ""
    for s in subs {
        if i < len(s) {
            match unannot(s[i]).kind {
                PWild -> {}
                PVar(name) -> if named == "" || named == name { named = name } else {
                    return "field"
                }
                _ -> return "field"
            }
        }
    }
    let letters = String.fromCodePoints(takeLetters(named))
    if letters == "" { "field" } else { letters }
}

fun takeLetters(name : String) -> Array Char {
    let out = []
    for ch in String.codePoints(name) {
        if !Char.isAsciiAlpha(ch) { return out }
        Array.push(out, ch)
    }
    out
}

fun ignored(p : Pat) -> Bool = match unannot(p).kind {
    PWild -> True
    _ -> False
}

fun switch(column : Column, alts : Array CAlt, site : Site) -> Core =
    mkCore(site.ty, site.span, CMatch(mkCore(column.ty, site.span, CVar(column.name)), alts))

-- -- fallthrough -----------------------------------------------------------------------

fun jump(c : Compiler, name : String, site : Site) -> Core {
    Map.put(c.jumps, name, Map.getOr(c.jumps, name, 0) + 1)
    mkCore(TBottom, site.span, CJump(name, []))
}

-- `e` with its one jump to `name` replaced by `with`. Every variable `with`
-- reads is bound outside `e` or is a column bound around the jump under a name
-- of this pass's, so nothing on the way down can capture it; see `leafOf`.
fun replaceJump(e : Core, name : String, with : Core) -> Core = match e.kind {
    CJump(target, _) -> if target == name { with } else { e }
    _ -> mkCore(e.ty, e.span, mapKind(e.kind, Mapper {
        expr = replaceJump(_, name, with),
        type_ = fun(t) = t,
        bind = fun(b) = withValue(b, replaceJump(b.value, name, with)),
    }))
}

-- -- names and types -------------------------------------------------------------------

fun fresh(c : Compiler, hint : String) -> String {
    c.counter = c.counter + 1
    "%" + hint + Int.toString(c.counter)
}

fun reduced(c : Compiler, ty : Ty.Type) -> Ty.Type =
    Ty.prune(Typed.reduceDeep(ty, Some(c.fams)))

fun oops(message : String) -> a = Diag.fail(Diag.whole("internal error", message), "")
