module Turkey.Modules (
    Namespace(..), Scope(..), newScope, spaces, lookupName, conflictsIn,
    Module(..),
    Loader(..), newLoader, loadEntry,
    ownDeclared, ownScope,
)

-- Loading a program's modules, and deciding what each one can see.
--
-- A program is not a file; it is a graph of them. This module walks that graph
-- and produces, for each module, the two tables the rest of the compiler needs:
-- a *scope* mapping every surface name the module may write to the internal
-- name it means, and an *export* map that is the part of that scope its
-- importers get to share. `Turkey.Resolve` does the rewriting; nothing here
-- touches a tree beyond parsing it.
--
-- Local declarations shadow explicit imports, which shadow the implicit
-- Prelude. Distinct declarations from peer imports remain ambiguous until a
-- use chooses a namespace; importing the same declaration twice is harmless.
--
-- The import graph must be acyclic. Two modules that need each other are one
-- module here, which is also why this compiler's own layering is a DAG.

import Turkey.Ast
import System.Env as Env
import System.IO as IO
-- `Data.Set` is not one of the modules the Prelude re-exports.
import Data.Set as Set
import Turkey.Diag as Diag
import Turkey.Parser as Parser
import Turkey.Prelude as Prelude
import Turkey.Prims as Prims
import Turkey.Source as Source
import Turkey.Source (Source(..), Span)
import Turkey.Giblets as Giblets

-- -- scopes -------------------------------------------------------------------------

-- One module's view of the world, in five namespaces.
--
-- They have to be at least three. A value is lowercase while a type and a
-- constructor are both uppercase, so `type Point = Point(Int, Int)` puts the
-- same spelling in two of them. Each maps a name the module may *write* --
-- bare, or qualified by an import's alias -- to the internal name it means.
--
-- Class identity is scoped even though the resulting instance table is global:
-- two modules may define different classes with the same short name. The fifth
-- is protocol-method identity, for the operator and iteration nodes the parser
-- writes itself; a method also appears in `values` for ordinary calls.
type Namespace = ValueSpace | TypeSpace | ConstructorSpace | ClassSpace | MethodSpace

let namespaces =
    [ValueSpace, TypeSpace, ConstructorSpace, ClassSpace, MethodSpace]

-- Array storage follows the same order as `spaces` and `namespaces`.
fun namespaceIndex(space : Namespace) -> Int = match space {
    ValueSpace -> 0
    TypeSpace -> 1
    ConstructorSpace -> 2
    ClassSpace -> 3
    MethodSpace -> 4
}

fun conflictsIn(s : Scope, space : Namespace) -> Map String (Array String) =
    s.conflicts[namespaceIndex(space)]

type Scope = Scope {
    values  : Map String String,
    types   : Map String String,
    cons    : Map String String,
    classes : Map String String,
    methods : Map String String,
    var conflicts : Array (Map String (Array String)),
}

fun newScope() -> Scope = Scope {
    values = Map.new(), types = Map.new(), cons = Map.new(),
    classes = Map.new(), methods = Map.new(),
    conflicts = [Map.new(), Map.new(), Map.new(), Map.new(), Map.new()],
}

-- The five, in a fixed order, so that a rule which applies to all of them is
-- written once. A `Map` is a reference, so these are the scope's own tables and
-- not copies of them.
fun spaces(s : Scope) -> Array (Map String String) =
    [s.values, s.types, s.cons, s.classes, s.methods]

fun spaceAt(s : Scope, space : Namespace) -> Map String String = match space {
    ValueSpace -> s.values
    TypeSpace -> s.types
    ConstructorSpace -> s.cons
    ClassSpace -> s.classes
    MethodSpace -> s.methods
}

-- Conflicts retain declaration identities, not import spellings: two routes
-- to the same re-export are still one declaration.
fun lookupName(s : Scope, space : Namespace, name : String,
               where : Option Span) -> Option String {
    match Map.get(conflictsIn(s, space), name) {
        Some(targets) -> oopsAt("ambiguous name '" + name + "': "
            + String.join(Array.map(Array.sort(targets), fun(t) =
                quoted(String.replace(t, "#", "."))), ", "), where)
        None -> Map.get(spaceAt(s, space), name)
    }
}

fun mergeName(s : Scope, space : Namespace, name : String, target : String) -> Unit {
    let into = spaceAt(s, space)
    match Map.get(into, name) {
        Some(previous) -> if previous != target {
            let targets = Map.getOr(conflictsIn(s, space), name, [previous])
            if !Array.contains(targets, target) { Array.push(targets, target) }
            Map.put(conflictsIn(s, space), name, targets)
        }
        None -> Map.put(into, name, target)
    }
}

type Module = Module {
    name        : String,
    program     : Program,
    library     : Bool,
    var scope   : Scope,
    -- The part of that scope an importer gets.
    var exports : Scope,
}

-- -- the loader ---------------------------------------------------------------------

type Loader = Loader {
    -- The entry file's own directory first, then the shipped library, which is
    -- always last and is what marks a module as one the language ships.
    search       : Array String,
    modules      : Map String Module,
    -- Every module, in the order they finished loading, which is dependency
    -- order because a module finishes after everything it imports.
    order        : Array Module,
    -- Every type name known so far, threaded into later parses: section 7's
    -- alias-versus-data pre-pass cannot see another file.
    tycons       : Array String,
    -- Internal type name -> its constructors' short names, so a `T(..)` in an
    -- export or import list can be answered for a type this module did not
    -- itself declare.
    variants     : Map String (Array String),
    -- Internal class name -> its exported methods and associated families.
    classMembers : Map String (Array String),
}

fun newLoader(search : Array String) -> Loader = Loader {
    search = search,
    modules = Map.new(),
    order = Array.new(8),
    tycons = Array.new(16),
    variants = Map.new(),
    classMembers = Map.new(),
}

-- The program, the effective imports it declares, and the module that starts
-- it if it has a `main`: `Turkey.Entry` holds `turkey_main`, the entry thread
-- and the crash handler, which C calls and nothing in the program imports
-- directly. Loaded ahead of what the entry imports; a program with no `main`
-- cannot be started, and needs none.
fun loadEntry(l : Loader, source : Source, name : String) -> Module =
    add(l, name, source, False, [name], True)

let startupModule = "Turkey.Entry"

fun declaresMain(program : Program) -> Bool {
    for d in program.decls {
        if let DStmt(s) = d {
            if let SFun(f) = s.kind {
                if f.name == "main" { return True }
            }
        }
    }
    False
}

fun load(l : Loader, name : String, stack : Array String) -> Module =
    match Map.get(l.modules, name) {
        Some(existing) -> existing
        None -> {
            if Array.contains(stack, name) {
                oops("imports form a cycle: " + cycleOf(stack, name)
                     + ". Two modules that need each other are one module here.")
            }
            let (path, library, bytes) = resolvePath(l, name)
            let source = match String.fromBytes(bytes) {
                Some(text) -> Source { name = path, text = text }
                None -> oops("cannot read module '" + name + "' at " + path)
            }
            add(l, name, source, library, Array.append(stack, [name]), False)
        }
    }

fun cycleOf(stack : Array String, name : String) -> String {
    let from = match Array.indexOf(stack, name) {
        Some(i) -> i
        None -> 0
    }
    String.join(Array.append(Array.slice(stack, from, len(stack)), [name]), " -> ")
}

-- `Data.String` is `Data/String.gob` under one of the search roots. The last
-- root is the library, and a module found there is a library module -- which is
-- the whole of what `library` means and the only thing that decides whether
-- `Prim.*` is spellable.
--
-- Each candidate is read rather than asked about: the first one that reads is
-- the module, and its bytes come back with it so that nothing can change
-- between finding the file and compiling it. Decoding is the caller's, so
-- "not there" and "not UTF-8" stay two different failures.
fun resolvePath(l : Loader, name : String) -> (String, Bool, Array Byte) {
    let relative = String.replace(name, ".", "/") + ".gob"
    for var i = 0; i < len(l.search); i = i + 1 {
        -- A module beside an entry named without a directory is `Wrong.gob`,
        -- as the entry itself is quoted, not `./Wrong.gob`.
        let root = l.search[i]
        let candidate = if root == "." { relative } else { root + "/" + relative }
        match IO.readBytes(candidate) {
            Some(bytes) -> return (candidate, i == len(l.search) - 1, bytes)
            None -> {}
        }
    }
    oops("cannot find module '" + name + "' (searched "
         + String.join(l.search, ", ") + ")")
}

fun add(l : Loader, name : String, source : Source, library : Bool,
        stack : Array String, entry : Bool) -> Module {
    var program = Parser.parse(source, l.tycons)
    if entry && declaresMain(program) { discard(load(l, startupModule, stack)) }
    let before = len(l.tycons)
    let explicitPrelude = hasPreludeImport(program)
    if name != Prelude.preludeName && !explicitPrelude {
        discard(load(l, Prelude.preludeName, stack))
    }
    for imp in program.imports {
        -- The empty Prelude import removes the otherwise implicit edge. Empty
        -- imports of every other module remain instance-only edges.
        if !(imp.name == Prelude.preludeName && isEmptyList(imp.items)) {
            let imported = load(l, imp.name, stack)
            if !library { checkInternalImport(imported, imp) }
        }
    }
    if len(l.tycons) != before {
        -- An imported type name changes how section 7 reads this file, and the
        -- pre-pass that decides it already ran. Read it again, knowing.
        program = Parser.parse(source, l.tycons)
    }

    for d in program.decls {
        match d {
            DType(t) -> {
                Array.push(l.tycons, t.name)
                match t.variants {
                    Some(vs) -> Map.put(l.variants, Prelude.internal(name, t.name),
                                        Array.map(vs, conName))
                    None -> {}
                }
            }
            DClass(c) -> Map.put(l.classMembers, Prelude.internal(name, c.name),
                                 Array.append(Array.map(c.methods, funName),
                                              Array.map(c.families, famName)))
            _ -> {}
        }
    }

    checkForeignPlacement(name, program, library)
    Giblets.checkPlacement(name, library, Source.span(source.name, 1, 1))
    let m = Module {
        name = name, program = program, library = library,
        scope = newScope(), exports = newScope(),
    }
    m.scope = scopeOf(l, m)
    m.exports = exportsOf(l, m)
    Map.put(l.modules, name, m)
    Array.push(l.order, m)
    m
}

fun conName(c : ConDecl) -> String = c.name
fun funName(f : FunDecl) -> String = f.name
fun famName(f : FamDecl) -> String = f.name

fun hasPreludeImport(program : Program) -> Bool {
    for imp in program.imports {
        if imp.name == Prelude.preludeName { return True }
    }
    False
}

fun isEmptyList(items : Option (Array ExportItem)) -> Bool = match items {
    Some(xs) -> len(xs) == 0
    None -> False
}

-- -- scope --------------------------------------------------------------------------

-- Whether a library module may spell a builtin. The target's are typed by the
-- library's `Target` module, which only that module is sure to have loaded.
fun visible(b : Prims.Builtin, m : Module) -> Bool = match b {
    Prims.Machine(_) -> True
    Prims.Fixed(c) -> match c {
        Prims.TargetOs | Prims.TargetArch -> m.name == Prelude.targetName
        Prims.GcVerify | Prims.GcStats -> True
    }
}

fun scopeOf(l : Loader, m : Module) -> Scope {
    let scope = newScope()
    -- `Prim.*` is spellable only from a library module, which is what keeps the
    -- machine operations out of the language: the environment holds them for
    -- every module, and this is the stage that says no.
    if m.library {
        for b in Prims.all {
            if visible(b, m) {
                let name = Prims.spelling(b)
                Map.put(scope.values, name, name)
            }
        }
        Map.put(scope.types, "Prim.Array", "Prim.Array")
        Map.put(scope.types, "Prim.Ptr", "Prim.Ptr")
    }
    -- So are the built-in type constructors, which no module declares.
    for name in Parser.builtinTycons { Map.put(scope.types, name, name) }
    -- `String` is declared in a library module but spelled bare everywhere, so
    -- it is put in scope here rather than imported. A module that declares its
    -- own shadows it like any other name.
    Map.put(scope.types, "String", "Data.String.Type#String")

    let explicitPrelude = hasPreludeImport(m.program)
    if m.name != Prelude.preludeName && !explicitPrelude {
        let implicit = newScope()
        bring(l, implicit, moduleNamed(l, Prelude.preludeName), Prelude.preludeName,
              False, None, None, None)
        let from = spaces(implicit)
        let into = spaces(scope)
        for var i = 0; i < len(into); i = i + 1 {
            for (k, v) in Map.entries(from[i]) { Map.put(into[i], k, v) }
        }
    }
    let imports = newScope()
    for imp in m.program.imports {
        if !(imp.name == Prelude.preludeName && isEmptyList(imp.items)) {
            let dep = moduleNamed(l, imp.name)
            let alias = match imp.alias {
                Some(a) -> a
                None -> imp.name
            }
            bring(l, imports, dep, alias, imp.qualified, Some(imp.span),
                  imp.items, imp.hidden)
        }
    }

    let imported = spaces(imports)
    let destination = spaces(scope)
    for var i = 0; i < len(imported); i = i + 1 {
        for (k, v) in Map.entries(imported[i]) { Map.put(destination[i], k, v) }
    }
    scope.conflicts = imports.conflicts

    -- Last, so a module's own declarations shadow everything imported.
    let own = ownScope(m.name, m.program)
    let into = spaces(scope)
    let from = spaces(own)
    for var i = 0; i < len(into); i = i + 1 {
        for (k, v) in Map.entries(from[i]) {
            Map.put(into[i], k, v)
            discard(Map.delete(scope.conflicts[i], k))
        }
    }
    scope
}

fun moduleNamed(l : Loader, name : String) -> Module = match Map.get(l.modules, name) {
    Some(m) -> m
    None -> oops("module '" + name + "' was not loaded")
}

fun bring(l : Loader, scope : Scope, dep : Module, alias : String,
          qualified : Bool, where : Option Span,
          items : Option (Array ExportItem),
          hidden : Option (Array ExportItem)) -> Unit {
    var chosen = Array.map(spaces(dep.exports), copyMap)
    match items {
        None -> {}
        Some(wantedItems) -> {
            chosen = spaces(newScope())
            let available = spaces(dep.exports)
            for item in wantedItems {
                if !namedAnywhere(dep.exports, item.name) {
                    oopsAt("module '" + dep.name + "' does not export "
                           + quoted(item.name), where)
                }
                for space in namespaces {
                    let i = namespaceIndex(space)
                    -- A type name alone does not request its same-named
                    -- constructor. A standalone constructor name is legal.
                    let typeOnly = match space {
                        ConstructorSpace -> Map.contains(dep.exports.types, item.name)
                        _ -> False
                    }
                    if !typeOnly {
                        match Map.get(available[i], item.name) {
                            Some(target) -> Map.put(chosen[i], item.name, target)
                            None -> {}
                        }
                    }
                }
                for sub in subsOf(l, dep, item) {
                    checkImportedMember(l, dep, item, sub, where)
                    let memberSpaces = if Map.contains(dep.exports.classes, item.name) {
                        [ValueSpace, TypeSpace, MethodSpace]
                    } else { [ConstructorSpace] }
                    for space in memberSpaces {
                        let i = namespaceIndex(space)
                        match Map.get(available[i], sub) {
                            Some(target) -> Map.put(chosen[i], sub, target)
                            None -> {}
                        }
                    }
                }
            }
        }
    }
    match hidden {
        None -> {}
        Some(hiddenItems) -> {
            let out = Set.new()
            for item in hiddenItems {
                Set.add(out, item.name)
                if Option.isSome(Map.get(dep.exports.classes, item.name)) {
                    for sub in subsOf(l, dep, item) { Set.add(out, sub) }
                }
            }
            chosen = Array.map(chosen, fun(space) =
                keepIf(space, !Set.contains(out, _)))
        }
    }

    for space in namespaces {
        let i = namespaceIndex(space)
        for (short, target) in Map.entries(chosen[i]) {
            mergeName(scope, space, alias + "." + short, target)
            if !qualified { mergeName(scope, space, short, target) }
        }
    }
}

fun checkImportedMember(l : Loader, dep : Module, item : ExportItem,
                        sub : String, where : Option Span) -> Unit {
    match Map.get(dep.exports.classes, item.name) {
        Some(cls) -> {
            if !Array.contains(membersOf(l, cls), sub)
                || !(Map.contains(dep.exports.methods, sub)
                     || Map.contains(dep.exports.types, sub)) {
                oopsAt("module '" + dep.name + "' does not export member '"
                       + sub + "' of class '" + item.name + "'", where)
            }
        }
        None -> {
            if !constructorMember(l, Map.get(dep.exports.types, item.name),
                                  sub, Map.get(dep.exports.cons, sub)) {
                oopsAt("module '" + dep.name + "' does not export constructor '"
                       + sub + "' of type '" + item.name + "'", where)
            }
        }
    }
}

fun constructorMember(l : Loader, parent : Option String, name : String,
                      target : Option String) -> Bool {
    if !Array.contains(variantsOf(l, parent), name) { return False }
    match (parent, target) {
        (Some(p), Some(t)) -> match String.rsplitOnce(p, "#") {
            Some((owner, _)) -> t == Prelude.internal(owner, name)
            None -> False
        }
        _ -> False
    }
}

fun quoted(name : String) -> String = "'" + name + "'"

fun copyMap(m : Map String String) -> Map String String {
    let out = Map.new()
    for (k, v) in Map.entries(m) { Map.put(out, k, v) }
    out
}

fun keepIf(m : Map String String, keep : fun(String) -> Bool) -> Map String String {
    let out = Map.new()
    for (k, v) in Map.entries(m) {
        if keep(k) { Map.put(out, k, v) }
    }
    out
}

fun namedAnywhere(s : Scope, name : String) -> Bool {
    for space in spaces(s) {
        if Map.contains(space, name) { return True }
    }
    False
}

-- The members `T(..)` or `C(..)` names, given what `T` or `C` is here.
fun subsOf(l : Loader, dep : Module, item : ExportItem) -> Array String =
    match Map.get(dep.exports.classes, item.name) {
        Some(cls) -> subsFrom(item, membersOf(l, cls))
        None -> subsFrom(item, variantsOf(l, Map.get(dep.exports.types, item.name)))
    }

fun membersOf(l : Loader, cls : String) -> Array String =
    Map.getOr(l.classMembers, cls, Array.new(0))

fun variantsOf(l : Loader, target : Option String) -> Array String = match target {
    None -> Array.new(0)
    Some(name) -> Map.getOr(l.variants, name, Array.new(0))
}

-- `T` names the type alone; `T(..)` every constructor; `T(A, B)` those.
fun subsFrom(item : ExportItem, all : Array String) -> Array String = match item.subs {
    None -> Array.new(0)
    Some(subs) -> if isDotDot(subs) { all } else { subs }
}

fun isDotDot(subs : Array String) -> Bool =
    (len(subs) == 1 && subs[0] == "..")
    || (len(subs) == 2 && subs[0] == "." && subs[1] == ".")

-- -- exports ------------------------------------------------------------------------

fun exportsOf(l : Loader, m : Module) -> Scope {
    let mine = ownScope(m.name, m.program)
    match m.program.header {
        None -> mine
        Some(header) -> match header.exports {
            None -> mine
            Some(items) -> {
                let out = newScope()
                for item in items { exportOne(l, m, mine, item, out) }
                out
            }
        }
    }
}

fun exportOne(l : Loader, m : Module, mine : Scope, item : ExportItem,
              out : Scope) -> Unit {
    if item.kind == "module" {
        return reexport(m, item, out)
    }
    if isLower(item.name) {
        return Map.put(out.values, item.name,
                       exported(m, mine.values, ValueSpace, item))
    }
    -- A name the module *declares itself* is that declaration, whatever an
    -- import may have brought in under the same spelling. Without this,
    -- `Data.String`'s own `Index` type is invisible and its export list
    -- silently re-exports `Std.Classes`'s `Index` class instead -- the module's
    -- own declaration losing to an import, which is the opposite of the rule
    -- the scope applies everywhere else.
    if !Map.contains(mine.types, item.name)
       && (Map.contains(mine.classes, item.name)
           || Map.contains(m.scope.classes, item.name)) {
        exportClass(l, m, mine, item, out)
    } else {
        exportType(l, m, mine, item, out)
    }
}

fun exportClass(l : Loader, m : Module, mine : Scope, item : ExportItem,
                out : Scope) -> Unit {
    let target = exported(m, mine.classes, ClassSpace, item)
    Map.put(out.classes, item.name, target)
    for member in subsFrom(item, membersOf(l, target)) {
        let value = firstOf(Map.get(mine.methods, member),
                            lookupName(m.scope, MethodSpace, member, Some(item.span)))
        let family = firstOf(Map.get(mine.types, member),
                             lookupName(m.scope, TypeSpace, member, Some(item.span)))
        match value {
            Some(v) -> {
                Map.put(out.values, member, v)
                Map.put(out.methods, member, v)
            }
            None -> match family {
                Some(f) -> Map.put(out.types, member, f)
                None -> oopsAt("'" + member + "' is not a member of class '"
                               + item.name + "'", Some(item.span))
            }
        }
    }
}

fun exportType(l : Loader, m : Module, mine : Scope, item : ExportItem,
               out : Scope) -> Unit {
    let target = exported(m, mine.types, TypeSpace, item)
    Map.put(out.types, item.name, target)
    let variants = variantsOf(l, Some(target))
    for con in subsFrom(item, variants) {
        if !Array.contains(variants, con) {
            oopsAt("'" + con + "' is not a constructor of '"
                   + item.name + "'", Some(item.span))
        }
        match firstOf(Map.get(mine.cons, con), lookupName(m.scope, ConstructorSpace, con, Some(item.span))) {
            Some(t) -> {
                if !constructorMember(l, Some(target), con, Some(t)) {
                    oopsAt("'" + con + "' is not a constructor of '"
                           + item.name + "'", Some(item.span))
                }
                Map.put(out.cons, con, t)
            }
            None -> oopsAt("'" + con + "' is not a constructor of '"
                           + item.name + "'", Some(item.span))
        }
    }
}

-- `module M`: everything in scope here under that qualification, passed on
-- *still qualified*. That is what lets the Prelude hand every program
-- `Array.push` without claiming the bare `push`.
fun reexport(m : Module, item : ExportItem, out : Scope) -> Unit {
    let prefix = item.name + "."
    var found = False
    let into = spaces(out)
    let from = spaces(m.scope)
    for space in namespaces {
        let i = namespaceIndex(space)
        for (surface, target) in Map.entries(from[i]) {
            if String.startsWith(surface, prefix) {
                discard(lookupName(m.scope, space, surface, Some(item.span)))
                Map.put(into[i], surface, target)
                found = True
            }
        }
    }
    if !found {
        oopsAt("module '" + m.name + "' re-exports '" + item.name
               + "', which is not imported here", Some(item.span))
    }
}

fun exported(m : Module, own : Map String String, space : Namespace,
             item : ExportItem) -> String =
    match firstOf(Map.get(own, item.name), lookupName(m.scope, space, item.name, Some(item.span))) {
        Some(target) -> target
        None -> oopsAt("module '" + m.name + "' exports '" + item.name
                       + "', which is not defined or imported here",
                       Some(item.span))
    }

fun firstOf(a : Option v, b : Option v) -> Option v = match a {
    Some(_) -> a
    None -> b
}

fun isLower(name : String) -> Bool = match String.decode(name, String.start(name)) {
    Some(c) -> Char.isAsciiLower(c)
    None -> False
}

-- -- the implementation's own modules ------------------------------------------------

-- The shipped library's `Turkey.*` modules are the implementation -- the
-- collector, the allocator, the entry, the C symbols they call -- and not a
-- library: only another library module may import one. Their interfaces trade
-- in raw pointers and C signatures that nothing checks, and a program that
-- reached them would be depending on that as surely as on a public API.
--
-- Decided by where the imported file came from, as `Prim.` is, so the
-- compiler's own `Turkey.*` modules, which sit beside its entry, are the
-- compiler's business and not this rule's.
let internalPrefix = "Turkey."

-- Modules a program may import anyway, for the tests that exercise the
-- implementation through an ordinary program: comma-separated names.
let internalTestHook = "TURKEY_TEST_INTERNAL_IMPORTS"

fun checkInternalImport(imported : Module, imp : ImportDecl) -> Unit {
    if !imported.library || !String.startsWith(imported.name, internalPrefix) {
        return {}
    }
    match Env.get(internalTestHook) {
        Some(allowed) -> if Array.contains(String.split(allowed, ","), imported.name) {
            return {}
        }
        None -> {}
    }
    oopsAt("'" + imported.name + "' is part of the implementation, and only the "
           + "standard library may import it", Some(imp.span))
}

-- The modules where a `foreign` declaration may appear, from the shipped
-- library. A list rather than a naming convention, as the giblet modules are:
-- joining it is a deliberate edit to the compiler.
--
-- A declaration is an assertion about a C signature that nothing can check,
-- so the fewer places hold one the better, and every other module reaches C
-- through what these export. It is not a check on the module's declared
-- *name* alone: only the loader knows where a file came from, and a program
-- that called its own module `Turkey.Libc` and put it beside itself would
-- otherwise let itself in. Nor is it "any directory named lib" -- the first
-- search root is the entry file's own directory, so that would be the same
-- hole wearing a different hat.
let foreignModules = ["Turkey.Libc", "Turkey.Entry"]

-- Extra names for the tests, which declare symbols in throwaway modules.
let foreignTestHook = "TURKEY_TEST_FOREIGN"

fun declaresForeign(name : String) -> Bool {
    if Array.contains(foreignModules, name) { return True }
    match Env.get(foreignTestHook) {
        Some(extra) -> Array.contains(String.split(extra, ","), name)
        None -> False
    }
}

fun checkForeignPlacement(name : String, program : Program,
                          library : Bool) -> Unit {
    -- A definition's gate is narrower than a declaration's: a
    -- C caller sets up nothing before the call, so the body must be code the
    -- collector need not know about, and a giblet module is where that is
    -- checked.
    let giblet = library && Set.contains(Giblets.gibletModules(), name)
    for d in program.decls {
        if let DStmt(s) = d {
            if let SFun(f) = s.kind {
                if Option.isSome(f.symbol) && !giblet {
                    oopsAt("a foreign definition may only appear in a giblet "
                        + "module, and '" + name + "' is not one: C calls it "
                        + "with no root frame and no collector to hand, so its "
                        + "body may hold no traced value", Some(s.span))
                }
            }
        }
    }
    if library && declaresForeign(name) { return }
    for d in program.decls {
        match d {
            DForeign(f) -> oopsAt("a foreign declaration may only appear in "
                + "Turkey.Libc or Turkey.Entry, from the standard library, and '"
                + name + "' is not one; declare the symbol there and export a "
                + "wrapper", Some(f.span))
            _ -> {}
        }
    }
}

-- -- what a module declares ---------------------------------------------------------

-- What a module declares, in each of `Scope`'s five namespaces, before class
-- membership is taken into account.
fun ownDeclared(program : Program) -> Array (Array String) {
    let values = Array.new(8)
    let types = Array.new(4)
    let cons = Array.new(4)
    let classes = Array.new(2)
    let methods = Array.new(4)
    for decl in program.decls {
        match decl {
            DStmt(s) -> match s.kind {
                SFun(d) -> Array.push(values, d.name)
                SLet(pat, _) -> for v in Array.sort(patternVars(pat)) {
                    Array.push(values, v)
                }
                SVar(pat, _) -> for v in Array.sort(patternVars(pat)) {
                    Array.push(values, v)
                }
                _ -> {}
            }
            DType(t) -> {
                Array.push(types, t.name)
                match t.variants {
                    Some(vs) -> for v in vs { Array.push(cons, v.name) }
                    None -> {}
                }
            }
            DClass(c) -> {
                Array.push(classes, c.name)
                for meth in c.methods {
                    Array.push(values, meth.name)
                    Array.push(methods, meth.name)
                }
                for fam in c.families { Array.push(types, fam.name) }
            }
            DInstance(_) -> {}
            DForeign(f) -> Array.push(values, f.name)
        }
    }
    [values, types, cons, classes, methods]
}

-- The module's declarations with class members owned by their class.
--
-- A method is `M#C.method`, not `M#method`: an ordinary top-level `method` and
-- two classes that use the same member spelling are distinct bindings.
fun ownScope(name : String, program : Program) -> Scope {
    let scope = newScope()
    let into = spaces(scope)
    let declared = ownDeclared(program)
    for var i = 0; i < len(into); i = i + 1 {
        for short in declared[i] {
            Map.put(into[i], short, Prelude.internal(name, short))
        }
    }
    for decl in program.decls {
        match decl {
            DClass(c) -> {
                let cls = Prelude.internal(name, c.name)
                for meth in c.methods {
                    let target = cls + "." + meth.name
                    Map.put(scope.values, meth.name, target)
                    Map.put(scope.methods, meth.name, target)
                }
                for fam in c.families {
                    Map.put(scope.types, fam.name, cls + "." + fam.name)
                }
            }
            _ -> {}
        }
    }
    -- Ordinary top-level values shadow an explicitly called method, while the
    -- separate method namespace above keeps compiler-written operators stable.
    for decl in program.decls {
        match decl {
            DStmt(s) -> match s.kind {
                SFun(d) -> Map.put(scope.values, d.name,
                                   Prelude.internal(name, d.name))
                SLet(pat, _) -> for v in patternVars(pat) {
                    Map.put(scope.values, v, Prelude.internal(name, v))
                }
                SVar(pat, _) -> for v in patternVars(pat) {
                    Map.put(scope.values, v, Prelude.internal(name, v))
                }
                _ -> {}
            }
            DForeign(f) -> Map.put(scope.values, f.name,
                                   Prelude.internal(name, f.name))
            _ -> {}
        }
    }
    scope
}

-- -- diagnostics --------------------------------------------------------------------

fun oops(message : String) -> a = oopsAt(message, None)

fun oopsAt(message : String, where : Option Span) -> a = match where {
    None -> Diag.fail(Diag.whole("type error", message), "")
    Some(s) -> Diag.fail(Diag.at("type error", message, s), s.file)
}

-- A block answers with its last statement, so a call made for its effect has to
-- say so.
fun discard(x : a) -> Unit = {}
