export (
    maxTypeNodes, rounds, ceilingFactor, expandingBindings,
    State(..), newState,
    monomorphize, reduceTypes, checkLayouts, reachable, runtimeRoots,
)

-- Monomorphization: one copy of a polymorphic binding per type it is used at.
--
-- The input is a typed Core in which every dictionary is an explicit argument
-- at a known type. A generalized binding carries its binders, and every use of
-- one is a type application at recorded arguments, so "which types is this used
-- at" is a question the IR already answers. This pass reads the answer and
-- writes a copy per answer.
--
-- What that buys: a dictionary is built once rather than rebuilt per request; a
-- dictionary at a call site is a *name*; a method selected from a ground
-- dictionary is then a projection out of a record whose definition is right
-- here, so it becomes a binding of its own; and what nothing reaches is dropped.
--
-- ## It is a *partial* pass, and that is a decision
--
-- Turkey admits polymorphic recursion, so the reachable set of specializations
-- can be infinite -- the standard reason monomorphization is undecidable. Two
-- things refuse a copy, and each refuses only what it has to:
--
-- * a binding on an *expanding cycle* (`expandingBindings`), decided from the
--   program before specializing, is never copied -- that is exactly the
--   polymorphic recursion that would never end, and nothing else;
-- * a program-wide *ceiling* on the specialized code (`ceilingFactor`) bounds
--   specialization that ends but grows exponentially without recursion.
--
-- A refused call site keeps its type application and goes on calling the
-- generic binding, which survives the pass unchanged and is copied per layout
-- by `Turkey.Layout`; a method of a known dictionary is still called
-- directly (see devirtualization). Turkey does not *promise* monomorphization.
--
-- ## It goes round twice, and the ceiling does not restart
--
-- Specializing and devirtualizing each *make* bindings the other would have
-- worked on. So the pipeline runs twice and reachability runs once at the end.
-- `State` is shared by the rounds: one account against the ceiling, and the
-- memo of what has already been built.

import System.Parallel as Parallel
import Data.Set as Set
import Turkey.Ast (..)
import Turkey.Binders as Binders
import Turkey.Binders (Origin(..))
import Turkey.Classes as Classes
import Turkey.Classes (ClassTable(..), ClassInfo(..), MethodInfo(..), Slot(..))
import Turkey.Core (..)
import Turkey.Core as Cr
import Turkey.Decls as Decls
import Turkey.Decls (DeclTable(..), ForeignInfo(..))
import Turkey.Diag as Diag
import Turkey.Inert as Inert
import Turkey.Methods as Methods
import Turkey.Opt as Opt
import Turkey.Deps as Deps
import Turkey.Runtime as Rt
import Turkey.Source (Span(..))
import Turkey.Types as Ty
import Turkey.Types (Kind(..), VarCell(..), TVar, TCon, TApp, TFam, TFun,
                     TTuple, TSet, TBottom)

-- How large a type argument may be. A cheap early refusal: a request this
-- large is almost certainly an unrolling that the tests below would refuse
-- anyway, and checking size is cheaper than checking anything else.
let maxTypeNodes = 64

-- How much specialized code the whole program may gain, as a multiple of its
-- own size (both by `Opt.sizeOf_`). Specialization that terminates can still
-- grow exponentially with no recursion in it -- a chain of functions each
-- calling the next at two new types -- and this is what bounds that. It is a
-- ceiling rather than a budget: set well above what any real program reaches,
-- so a program that trips it is pathological, and what it trips on falls back
-- to generic code with its methods still called directly.
--
-- Measured: the largest ratio of specialized to original code in the corpus
-- is 0.57 (`regex_library.gob`), and the compiler's own is 0.48.
--
-- The charge is a copy's size before `Turkey.Opt`, which is all that exists
-- here. Inlining then grows each copy, by at most what the inliner's own limit
-- allows per function, so the finished program is still linear in the ceiling;
-- only the constant is larger for a program made of tiny copies, each calling
-- the next.
let ceilingFactor = 2

-- How many times the whole pipeline runs. A fixed number rather than a fixed
-- point: specializing and devirtualizing each make work for the other, and two
-- rounds finish what the programs this compiles give them. The ceiling is
-- shared across rounds, so it bounds the whole pass however many there are.
let rounds = 2

-- -- small questions about types ----------------------------------------------------

-- No unbound variable anywhere in it, so it names one type and not a family of
-- them. The test a specialization request has to pass.
-- A skolem an existential pattern opened is not ground either: it stands for
-- whichever type was packed, and a copy at it would be one body
-- for every one of them. Left generic, the call is keyed by `Turkey.Layout`
-- inside each copy of the arm, where the skolem's layout is known.
fun ground(t : Ty.Type) -> Bool =
    len(Ty.varsOf([t])) == 0 && len(Ty.skolemsOf([t])) == 0

fun typeSize(t : Ty.Type) -> Int = match Ty.prune(t) {
    TApp(fn, arg, _) -> 1 + typeSize(fn) + typeSize(arg)
    TFam(_, arg, _) -> 1 + typeSize(arg)
    TFun(params, ret) -> {
        var n = 1 + typeSize(ret)
        for p in params { n = n + typeSize(p) }
        n
    }
    TTuple(elems) -> {
        var n = 1
        for e in elems { n = n + typeSize(e) }
        n
    }
    _ -> 1
}

-- A ground type, as a fragment of a name.
--
-- Two requirements. It is readable -- `Main#squash@Int` should be findable in
-- a dump by someone who knows what they are looking for -- and it is
-- injective on ground types, because a specialization is spelled by its
-- origin and its type arguments alone (`spelling`), and two specializations
-- of one binding at two types must not be spelled alike. A constructor is
-- written by its short name unless another module declared the same one
-- (`Ty.display`), which is a property of the program, not of the order
-- anything was asked for in.
fun mangle(t : Ty.Type) -> String = match Ty.prune(t) {
    TCon(c) -> Ty.display(c.name)
    TApp(_, _, _) -> {
        let (h, args) = Ty.spine(Ty.prune(t))
        mangle(h) + "(" + mangleAll(args) + ")"
    }
    TFam(name, arg, _) -> name + "(" + mangle(arg) + ")"
    TFun(params, ret) -> "fun(" + mangleAll(params) + ")->" + mangle(ret)
    TTuple(elems) -> "(" + mangleAll(elems) + ")"
    TSet(names) -> "{" + String.join(names, ",") + "}"
    TBottom -> "!"
    -- Not ground, so never asked for.
    TVar(_) -> "_"
}

fun mangleAll(ts : Array Ty.Type) -> String = String.join(Array.map(ts, mangle), ",")

-- Whether this binding is a lambda over nothing but dictionaries.
--
-- Two things wear that shape and the collapse treats them alike: an instance
-- with a context (a function from a dictionary to a dictionary) and any binding
-- whose scheme retained a predicate. Both are applied to evidence at every use
-- and neither needs to be, once the evidence is ground.
--
-- Asked structurally rather than by the `%inst.` prefix, because the shape is
-- what the collapse depends on and a name is a convention a later pass could
-- change. `%Dict.` is not a convention in the same sense: no source type can be
-- spelled that way, so a parameter with one is evidence and nothing else.
fun takesDictionaries(b : CBind) -> Bool = match b.value.kind {
    CLam(params, _, _) -> {
        if len(params) == 0 { return False }
        for p in params {
            if Option.isNone(dictClass(p.ty)) { return False }
        }
        True
    }
    _ -> False
}

-- -- what one round tells the next --------------------------------------------------

-- The budget and the memo, neither of which may restart with a round.
--
-- **The budget.** A per-round count is not a cap: refuse a binding its
-- thirty-third copy and the next round, counting from zero, grants it
-- thirty-two more. So the count is charged to the binding a copy *descends
-- from*, which is what `origin` records.
--
-- **The memo.** A second round that re-asked for a binding at the same types
-- would not find round one's answer, and would build a byte-identical second
-- copy -- specialization as a source of duplication, which is the opposite of
-- the point.
type State = State {
    -- Request key -> the specialization's spelling and binder id.
    done          : Map String (String, Int),
    -- Spelling -> the request key it was made for; see `spelling`.
    spellings     : Map String String,
    origin        : Map String String,
    -- Bindings on an expanding cycle (`expandingBindings`), never copied.
    var expanding : Set.Set String,
    -- The specialized code granted so far, and how much is allowed.
    var spent   : Int,
    var ceiling : Int,
}

fun newState() -> State = State {
    done = Map.new(), spellings = Map.new(), origin = Map.new(),
    expanding = Set.new(),
    spent = 0, ceiling = 0,
}

fun root(st : State, name : String) -> String = Map.getOr(st.origin, name, name)

-- Whether a copy of this binding may be made, charging it to the ceiling if
-- so. A binding on an expanding cycle never is: its copies would never end.
-- Every other binding is, until the program's specialized code reaches the
-- ceiling.
fun admit(st : State, b : CBind) -> Bool {
    if Set.contains(st.expanding, root(st, b.name)) { return False }
    let cost = Opt.sizeOf_(b.value) + 1
    if st.spent + cost > st.ceiling { return False }
    st.spent = st.spent + cost
    True
}

-- Record that a name is a descendant of another's original. Transitive by
-- construction: the root is stored, never the parent. Used for a specialization
-- and for a hoisted method alike -- the method is charged to the dictionary it
-- came out of because that is what it is, a piece of it.
fun derive(st : State, made : String, parent : String) -> Unit =
    Map.put(st.origin, made, root(st, parent))

-- A generalized binding *inside* a body -- a `let` that generalized, or a local
-- `fun` -- and the instantiations found for it.
--
-- It cannot be lifted to the top level and specialized there, because its body
-- may close over the enclosing binding's parameters. So it is specialized in
-- place: one extra binding beside the original, per type it was used at, each
-- a binder of its own.
type Local = Local {
    name    : String,
    -- The binder's id in the output, which a copy names as its origin.
    id      : Int,
    span    : Option Span,
    binders : Vec VarCell,
    -- Arguments key -> the copy's spelling, its id, and the arguments.
    insts   : Map String (String, Int, Array Ty.Type),
}

fun newLocal(name : String, id : Int, span : Option Span,
             binders : Vec VarCell) -> Local =
    Local { name = name, id = id, span = span, binders = binders, insts = Map.new() }

-- -- the whole program, and the specializations asked of it -------------------------

type Mono = Mono {
    program    : CProgram,
    -- Every specialization is minted here: see `request`.
    table      : Binders.Table,
    decls      : DeclTable,
    classes    : ClassTable,
    state      : State,
    byname     : Map String CBind,
    generic    : Map String CBind,
    takesDicts : Set.Set String,
    -- Every top-level dictionary binding. A collapse may only be handed one of
    -- these, since the binding it makes lives out here with them. A dictionary
    -- this pass *builds* joins the set: the second collapse of a chain is handed
    -- the first one's answer, and refusing it there would leave the rebuild in
    -- place one level up.
    topDicts   : Set.Set String,
    dictGroup  : Set.Set String,
    made       : Map String (Vec CBind),
    queue      : Vec (String, Int, CBind, Array Ty.Type, Option (Vec String)),
}

fun newMono(program : CProgram, table : Binders.Table, decls : DeclTable,
            classes : ClassTable, state : State) -> Mono = Mono {
    program = program, table = table, decls = decls, classes = classes,
    state = state, byname = Map.new(), generic = Map.new(),
    takesDicts = Set.new(), topDicts = Set.new(), dictGroup = Set.new(),
    made = Map.new(), queue = Vec.new(8),
}

-- One binding's body, rewritten under one substitution.
--
-- Created per specialization (with the binders mapped to that specialization's
-- type arguments) and per ground binding (with an empty substitution, where it
-- only rewrites call sites and touches no types).
--
-- **A copy binds nothing its original binds.** A specialization's body, and a
-- local's, is a second copy of a term the program keeps, so each binder with
-- an id it meets gets a fresh one (`bindId`), in the owner the copy is minted
-- into, and each reference to it is renamed with it (`refId`). The original is
-- rewritten in place and keeps its ids.
type Rewriter = Rewriter {
    owner      : Mono,
    subst      : Map Int Ty.Type,
    equations  : Vec (Ty.Type, Ty.Type),
    inert      : Inert.Inert,
    var rename : Map Ref String,
    -- A local that is nothing but another name for a top-level dictionary,
    -- by the reference that reads it in the output. An instance's own method
    -- opens with `let %d2.C = %inst.C.T` -- the self-dictionary the lowering
    -- binds -- and passing *that* to a recursive instance is what the
    -- collapse has to see through, since the binding it hoists the
    -- application into cannot see a local name.
    aliases    : Map Ref String,
    -- Every generalized local met so far, by its id in the input. Not scoped:
    -- before `Turkey.Opt` no id is bound twice, so an id names one binder
    -- wherever it is read.
    locals     : Map Int Local,
    -- The owner a copy's binders are minted into, or `None` when this rewrites
    -- an original in place.
    copyInto   : Option Int,
    -- Input id -> output id, for each binder this copy renamed.
    ids        : Map Int Int,
}

fun newRewriter(owner : Mono, subst : Map Int Ty.Type,
                equations : Vec (Ty.Type, Ty.Type), copyInto : Option Int,
                locals : Map Int Local, ids : Map Int Int) -> Rewriter {
    -- Substituted before the family reducer is built from them: a given
    -- `Item s ~ Op` becomes `Item (Array Int) ~ Op` under the specialization,
    -- and it is the substituted form that is a rewrite rule for the types in the
    -- body. Plain substitution and not the reducing one, since the reducing one
    -- is what this makes.
    let eqs = Vec.map(equations, fun(pair) = {
        let (a, b) = pair
        (Decls.substitute(a, subst), Decls.substitute(b, subst))
    })
    Rewriter {
        owner = owner, subst = subst, equations = eqs,
        inert = Inert.ofEquations(owner.classes, eqs),
        rename = Map.new(), aliases = Map.new(), locals = locals,
        copyInto = copyInto, ids = ids,
    }
}

-- A rewriter for a member of a group with equations of its own: the same
-- term, so it renames as `r` does.
fun childRewriter(r : Rewriter, equations : Vec (Ty.Type, Ty.Type)) -> Rewriter {
    let made = newRewriter(r.owner, r.subst, equations, r.copyInto, r.locals, r.ids)
    for (k, v) in Map.entries(r.aliases) { Map.put(made.aliases, k, v) }
    made.rename = r.rename
    made
}

-- A rewriter for a copy of a generalized local's value, at the substitution
-- that specializes it. It shares the locals, so the copy can still reach the
-- ones around it, and starts from `r`'s renaming, so it reads them under the
-- ids they have here. Its own binders are minted into the owner `r` copies
-- into, or the local's own when `r` rewrites an original.
fun copyRewriter(r : Rewriter, local : Local, subst : Map Int Ty.Type,
                 equations : Vec (Ty.Type, Ty.Type)) -> Rewriter {
    let ids = Map.new()
    for (k, v) in Map.entries(r.ids) { Map.put(ids, k, v) }
    let made = newRewriter(r.owner, subst, equations, Some(homeOf(r, local.id)),
                           r.locals, ids)
    for (k, v) in Map.entries(r.aliases) { Map.put(made.aliases, k, v) }
    made.rename = r.rename
    made
}

-- Where a binder made beside the local `near` is minted.
fun homeOf(r : Rewriter, near : Int) -> Int = match r.copyInto {
    Some(o) -> o
    None -> Binders.ownerOf(near)
}

-- The output id of a binder bound at `id`: fresh in a copy, the same in an
-- original.
fun bindId(r : Rewriter, name : String, id : Int) -> Int {
    if id == noId { return id }
    match r.copyInto {
        None -> id
        Some(o) -> {
            let made = Binders.fresh(r.owner.table, o, name, Binders.Local, CopyOf(id))
            Map.put(r.ids, id, made)
            made
        }
    }
}

-- The output id of a reference to the binder `id`.
fun refId(r : Rewriter, id : Int) -> Int = Map.getOr(r.ids, id, id)

-- A type under the substitution, with families reduced.
--
-- Reducing matters: `Item s` over a rigid `s` is stuck in the generic body and
-- becomes `Item (Array Int)` here, which the instance table decides -- and a
-- node still claiming the unreduced form would be rejected by a checker that had
-- reduced it.
--
-- With no substitution there is nothing to do. That is not just an optimization:
-- a ground binding's types were reduced by the lowering already, and re-deriving
-- them would be a second opinion where the milestone wants none.
fun rTy(r : Rewriter, t : Ty.Type) -> Ty.Type {
    if len(Map.keys(r.subst)) == 0 { return t }
    Inert.rewrite(r.inert, Decls.substitute(t, r.subst))
}

fun rewrite(r : Rewriter, e : Core) -> Core = match e.kind {
    CVar(ref) -> mkCore(rTy(r, e.ty), e.span, CVar(match Map.get(r.rename, ref) {
        -- A dictionary parameter a collapse consumed: the dictionary it was
        -- handed, which is top-level.
        Some(dict) -> BySpelling(dict)
        None -> match ref {
            ById(id) -> ById(refId(r, id))
            BySpelling(_) -> ref
        }
    }))
    CTyApp(fn, args) -> rewriteTyApp(r, e, fn, args)
    CApp(_, _) -> match collapse(r, e) {
        Some(made) -> made
        None -> generic(r, e)
    }
    CLet(name, id, bound, value, body, binders) ->
        rewriteLet(r, e, name, id, bound, value, body, binders)
    CLetRec(binds, body) -> rewriteLetRec(r, e, binds, body)
    -- The other binding forms: each binder renamed before the term it scopes
    -- over is rewritten.
    CLam(params, body, name) -> {
        let ps = Array.map(params, rewriteParam(r, _))
        mkCore(rTy(r, e.ty), e.span, CLam(ps, rewrite(r, body), name))
    }
    CJoin(name, id, params, body, rest, recursive) -> {
        let made = bindId(r, name, id)
        let ps = Array.map(params, rewriteParam(r, _))
        mkCore(rTy(r, e.ty), e.span,
               CJoin(name, made, ps, rewrite(r, body), rewrite(r, rest), recursive))
    }
    CJump(target, args) -> mkCore(rTy(r, e.ty), e.span,
        CJump(match target {
                  ById(id) -> ById(refId(r, id))
                  BySpelling(_) -> target
              }, Vec.map(args, rewrite(r, _))))
    CMatch(scrutinee, alts) -> mkCore(rTy(r, e.ty), e.span,
        CMatch(rewrite(r, scrutinee), Vec.map(alts, fun(a) = {
            let alt = rewriteAlt(r, a.alt)
            CAlt { alt = alt, body = rewrite(r, a.body) }
        })))
    _ -> generic(r, e)
}

fun rewriteParam(r : Rewriter, p : CParam) -> CParam {
    let CParam { name, id, ty } = p
    CParam { name = name, id = bindId(r, name, id), ty = rTy(r, ty) }
}

fun rewriteAlt(r : Rewriter, a : Alt) -> Alt = match a {
    ACon(con, fields, opening) -> ACon(con, Array.map(fields, rewriteBinder(r, _)),
        match opening {
            Some(o) -> {
                let Opened { evidence, skolems, layouts } = o
                Some(Opened {
                    evidence = Array.map(evidence, fun((name, id)) = (name, bindId(r, name, id))),
                    skolems = skolems, layouts = layouts,
                })
            }
            None -> None
        })
    ATuple(elems) -> ATuple(Array.map(elems, rewriteBinder(r, _)))
    ALit(_) -> a
    AAny(binder) -> AAny(rewriteBinder(r, binder))
}

fun rewriteBinder(r : Rewriter, binder : Option (String, Int)) -> Option (String, Int) =
    match binder {
        Some((name, id)) -> Some((name, bindId(r, name, id)))
        None -> None
    }

-- Every node not named above: rebuild it, rewriting the children and
-- substituting the types. `Turkey.Core.mapKind` is that rule, written once.
fun generic(r : Rewriter, e : Core) -> Core = mkCore(rTy(r, e.ty), e.span,
    mapKind(e.kind, Mapper {
        expr = fun(x) = rewrite(r, x),
        type_ = fun(t) = rTy(r, t),
        bind = fun(b) = rewriteMember(r, (b, b.id)),
    }))

-- A type application: the one place a specialization is asked for.
--
-- The operand is a name or a method projection. A name is what this pass can
-- specialize; a projection is a method's own quantification, which lives in a
-- record field and stays.
fun rewriteTyApp(r : Rewriter, e : Core, fn : Core,
                 args : Array Ty.Type) -> Core {
    let resolved = Array.map(args, rTy(r, _))
    match fn.kind {
        CVar(ref) -> match instantiate(r, ref, resolved, e) {
            Some(made) -> return made
            None -> {}
        }
        _ -> {}
    }
    mkCore(rTy(r, e.ty), e.span, CTyApp(rewrite(r, fn), resolved))
}

-- The specialization a use means, or `None` to leave it generic.
fun instantiate(r : Rewriter, ref : Ref, args : Array Ty.Type,
                e : Core) -> Option Core {
    for a in args {
        if !ground(a) { return None }
    }
    if let ById(id) = ref {
        if let Some(local) = Map.get(r.locals, id) {
            let (_, madeId) = localInst(r, local, args)
            return Some(mkCore(rTy(r, e.ty), e.span, CVar(ById(madeId))))
        }
    }
    let name = match topLevelName(r, ref) {
        Some(n) -> n
        None -> return None
    }
    let b = match Map.get(r.owner.generic, name) {
        Some(x) -> x
        None -> return None
    }
    if len(b.binders) != len(args) { return None }
    match request(r.owner, b, args, None) {
        Some((made, _)) -> Some(mkCore(rTy(r, e.ty), e.span, CVar(BySpelling(made))))
        None -> None
    }
}

-- An application to ground evidence becomes a binding with the evidence already
-- in it.
--
-- For an instance that removes the per-request rebuild: the application is
-- collapsed rather than merely specialized because specializing alone would
-- leave it a *function*, still applied, still allocating a record every time.
-- For an ordinary binding it removes the parameter, which is what makes the
-- dictionary a top-level name inside the body -- which is what devirtualization
-- then needs to see.
--
-- Coherence is what makes both sound: the dictionary arguments are ground, so
-- they are the only ones this name could be applied to at these types, and doing
-- the application once does it with the same contents.
fun collapse(r : Rewriter, e : Core) -> Option Core = match e.kind {
    CApp(fn, args) -> collapseApp(r, e, fn, args)
    _ -> None
}

fun collapseApp(r : Rewriter, e : Core, fn : Core,
                args : Array Core) -> Option Core {
    var head = fn
    var targs = []
    match fn.kind {
        CTyApp(inner, ta) -> {
            targs = Array.map(ta, rTy(r, _))
            head = inner
        }
        _ -> {}
    }
    let name = match head.kind {
        CVar(ref) -> match topLevelName(r, ref) {
            Some(n) -> n
            None -> return None
        }
        _ -> return None
    }
    let b = match Map.get(r.owner.byname, name) {
        Some(x) -> x
        None -> return None
    }
    if !Set.contains(r.owner.takesDicts, name) { return None }
    let params = match b.value.kind {
        CLam(ps, _, _) -> ps
        _ -> return None
    }
    if len(b.binders) != len(targs) || len(params) != len(args) { return None }
    let lowered = Array.map(args, rewrite(r, _))
    let supplied = Vec.new(len(lowered))
    for a in lowered {
        match globalDict(r, a) {
            -- A context this pass could not reduce to a *top-level* name -- a
            -- capped instance, or a dictionary parameter still in scope. The
            -- collapse hoists this application to the top level, so an argument
            -- that is not visible there cannot come along.
            None -> return None
            Some(n) -> Vec.push(supplied, n)
        }
    }
    let granted = match request(r.owner, b, targs, Some(supplied)) {
        Some(n) -> n
        None -> return None
    }
    let (made, _) = granted
    let ty = rTy(r, e.ty)
    let promoted = promotedBinders(b, Some(supplied))
    if len(promoted) == 0 { return Some(mkCore(ty, e.span, CVar(BySpelling(made)))) }
    -- The copy states the abstraction; this site is where the *value* of it was
    -- expected, so it is restated here as the eta-expansion it is.
    let types = Array.map(promoted, TVar)
    Some(mkCore(ty, e.span, CTyLam(promoted,
        mkCore(ty, e.span, CTyApp(mkCore(ty, e.span, CVar(BySpelling(made))), types)))))
}

-- The top-level binding `ref` names, through the dictionary a collapse
-- handed a parameter, or `None` for a local.
fun topLevelName(r : Rewriter, ref : Ref) -> Option String = match Map.get(r.rename, ref) {
    Some(dict) -> Some(dict)
    None -> spellingOf(ref)
}

-- The top-level dictionary this expression names, or `None`.
fun globalDict(r : Rewriter, e : Core) -> Option String = match e.kind {
    CVar(given) -> {
        let name = match Map.get(r.aliases, given) {
            Some(aliased) -> aliased
            None -> match given {
                BySpelling(n) -> n
                ById(_) -> return None
            }
        }
        if Set.contains(r.owner.topDicts, name) { Some(name) } else { None }
    }
    _ -> None
}

-- -- generalized bindings inside a body ---------------------------------------------

-- The copy of a local at these arguments, as its spelling and its id, made
-- the first time it is asked for. Two locals may share a spelling, and so may
-- their copies; a reference finds one by its id.
fun localInst(r : Rewriter, local : Local, args : Array Ty.Type) -> (String, Int) {
    let key = argsKey(args)
    match Map.get(local.insts, key) {
        Some((made, id, _)) -> (made, id)
        None -> {
            let made = spelling(local.name, args)
            let id = Binders.fresh(r.owner.table, homeOf(r, local.id), made,
                                   Binders.Local,
                                   Specialized(Some(local.id), args, local.span))
            Map.put(local.insts, key, (made, id, args))
            (made, id)
        }
    }
}

-- A specialization's spelling: its origin's and its type arguments', which
-- `mangle` writes injectively. Its display form (`Turkey.Demangle`) has the
-- arguments in square brackets: `Main.area[Rectangle]`. So a binding's specializations are spelled
-- apart, and no counter or order of requests enters the spelling.
fun spelling(origin : String, args : Array Ty.Type) -> String =
    origin + "@" + mangleAll(args)

fun argsKey(args : Array Ty.Type) -> String =
    String.join(Array.map(args, Ty.typeKey), "|")

fun rewriteLet(r : Rewriter, e : Core, name : String, id : Int, bound : Ty.Type,
               value : Core, body : Core, binders : Vec VarCell) -> Core {
    let out = bindId(r, name, id)
    if len(binders) == 0 {
        -- Written out rather than left to `generic`, because the alias has to be
        -- recorded between the value and the body: the value is what decides
        -- whether there is one, and the body is where it is used.
        let v = rewrite(r, value)
        let read = refTo(name, out)
        let had = Map.contains(r.aliases, read)
        let saved = Map.getOr(r.aliases, read, "")
        match globalDict(r, v) {
            Some(named) -> Map.put(r.aliases, read, named)
            None -> {}
        }
        let b = rewrite(r, body)
        if had { Map.put(r.aliases, read, saved) }
        else { discard(Map.delete(r.aliases, read)) }
        return mkCore(rTy(r, e.ty), e.span,
                      CLet(name, out, rTy(r, bound), v, b, []))
    }
    if id == noId { oops("a generalized local '" + name + "' has no binder id", e.span) }
    let local = newLocal(name, out, e.span, binders)
    Map.put(r.locals, id, local)
    let b = rewrite(r, body)
    let made = drain(r, local, binders, value)
    var rest = b
    for var i = len(made) - 1; i >= 0; i = i - 1 {
        let (n, nid, v) = made[i]
        rest = mkCore(rTy(r, e.ty), e.span, CLet(n, nid, v.ty, v, rest, []))
    }
    -- The generic binding stays, outermost, so that a use this pass could not
    -- specialize -- a capped one, or one under a variable that is not this
    -- binding's -- still finds something to name. It is a value, so evaluating it
    -- costs an allocation and nothing else, and reachability removes it when
    -- nothing reads it.
    mkCore(rTy(r, e.ty), e.span,
           CLet(name, out, rTy(r, bound), rewrite(r, value), rest, binders))
}

-- Build every instantiation of one local binding, including the ones discovered
-- while building the others.
fun drain(r : Rewriter, local : Local, binders : Vec VarCell,
          value : Core) -> Vec (String, Int, Core) {
    let out = Vec.new(4)
    let seen = Set.new()
    var going = True
    while going {
        let todo = Vec.new(4)
        for (k, v) in Map.entries(local.insts) {
            if !Set.contains(seen, k) { Vec.push(todo, (k, v)) }
        }
        if len(todo) == 0 { return out }
        for (key, made) in todo {
            Set.add(seen, key)
            let (name, id, args) = made
            let sub = copyRewriter(r, local, extended(r.subst, binders, args),
                                   r.equations)
            Vec.push(out, (name, id, rewrite(sub, value)))
        }
    }
    out
}

fun extended(subst : Map Int Ty.Type, binders : Vec VarCell,
             args : Array Ty.Type) -> Map Int Ty.Type {
    let out = Map.new()
    for (k, v) in Map.entries(subst) { Map.put(out, k, v) }
    for var i = 0; i < len(binders) && i < len(args); i = i + 1 {
        Map.put(out, binders[i].id, args[i])
    }
    out
}

fun rewriteLetRec(r : Rewriter, e : Core, binds : Vec CBind,
                  body : Core) -> Core {
    -- Every member renamed before any is rewritten, since each may name the
    -- others.
    let renamed = Vec.map(binds, fun(b) = (b, bindId(r, b.name, b.id)))
    let poly = Map.new()
    for (b, out) in renamed {
        if len(b.binders) > 0 {
            if b.id == noId {
                oops("a generalized local '" + b.name + "' has no binder id", b.span)
            }
            let local = newLocal(b.name, out, b.span, b.binders)
            Map.put(poly, b.id, local)
            Map.put(r.locals, b.id, local)
        }
    }
    if len(Map.keys(poly)) == 0 {
        return mkCore(rTy(r, e.ty), e.span,
                      CLetRec(Vec.map(renamed, rewriteMember(r, _)), rewrite(r, body)))
    }
    let rest = rewrite(r, body)
    -- The generic copies first, and for the reason a `let` keeps its original: a
    -- sibling or a capped call may still name them. Their own recursive calls are
    -- at their own binders, which are not ground, so nothing inside them
    -- specializes.
    let out = Vec.map(renamed, rewriteMember(r, _))
    let pending = Map.new()
    for b in binds {
        if len(b.binders) > 0 { Map.put(pending, b.id, b) }
    }
    let seen = Set.new()
    var going = True
    while going {
        let todo = Vec.new(4)
        for (origin, local) in Map.entries(poly) {
            for (k, v) in Map.entries(local.insts) {
                let at = Int.toString(origin) + "|" + k
                if !Set.contains(seen, at) { Vec.push(todo, (origin, at, v)) }
            }
        }
        if len(todo) == 0 { going = False }
        for (origin, at, made) in todo {
            Set.add(seen, at)
            let (name, id, args) = made
            let orig = match Map.get(pending, origin) {
                Some(x) -> x
                None -> oops("a local instantiation lost its original", e.span)
            }
            let local = match Map.get(poly, origin) {
                Some(x) -> x
                None -> oops("a local instantiation lost its original", e.span)
            }
            let sub = copyRewriter(r, local, extended(r.subst, orig.binders, args),
                                   orig.equations)
            let b = CBind {
                name = name, id = id, ty = rTy(sub, orig.ty), binders = [],
                value = rewrite(sub, orig.value), span = orig.span,
                mutable = False, module_ = orig.module_,
                equations = sub.equations, layouts = orig.layouts,
            }
            Vec.push(out, b)
        }
    }
    mkCore(rTy(r, e.ty), e.span, CLetRec(out, rest))
}

-- One member of a group, generic or not, under this rewriter, with the id
-- `rewriteLetRec` renamed it to -- and with its own equations added, since a
-- member may carry some. A member records only the equations it states; the
-- enclosing binding's are on that binding.
fun rewriteMember(r : Rewriter, renamed : (CBind, Int)) -> CBind {
    let (b, id) = renamed
    if len(b.equations) == 0 {
        return CBind {
            name = b.name, id = id, ty = rTy(r, b.ty), binders = b.binders,
            value = rewrite(r, b.value), span = b.span, mutable = b.mutable,
            module_ = b.module_, equations = b.equations, layouts = b.layouts,
        }
    }
    let sub = childRewriter(r, b.equations)
    CBind {
        name = b.name, id = id, ty = rTy(sub, b.ty), binders = b.binders,
        value = rewrite(sub, b.value), span = b.span, mutable = b.mutable,
        module_ = b.module_, equations = sub.equations, layouts = b.layouts,
    }
}

-- -- the specializer ----------------------------------------------------------------

fun runMono(m : Mono) -> CProgram {
    for (group, isDict) in [(m.program.dicts, True), (m.program.binds, False)] {
        for b in group {
            Map.put(m.byname, b.name, b)
            if len(b.binders) > 0 { Map.put(m.generic, b.name, b) }
            if isDict { Set.add(m.dictGroup, b.name) }
            if isDict && len(b.binders) == 0 { Set.add(m.topDicts, b.name) }
            if takesDictionaries(b) { Set.add(m.takesDicts, b.name) }
        }
    }
    -- A ground binding is where every specialization starts: its body's type
    -- arguments are already types rather than variables. `main` is one of these,
    -- and so is every instance dictionary with no context.
    --
    -- A *generic* binding's body is rewritten too, which it did not used to be.
    -- Its own binders are not ground, so `request` refuses every type
    -- application mentioning one and leaves it exactly as it was -- but a
    -- generic body can also hold a perfectly ground application, and those used
    -- to reach the backend as a reference to the *generic* binding.
    -- `Data.Map#new` is generic in `k` and `v` and calls `defaultSize[Int]`,
    -- which mentions neither. Skipping it meant `opt` -- which this pass relies
    -- on to inline generic bindings into ground call sites -- carried the
    -- unspecialized reference along, and the backend saw a scalar at the
    -- generic binding's pointer representation.
    let rewritten = Map.new()
    for group in [m.program.dicts, m.program.binds] {
        for b in group {
            Map.put(rewritten, b.name, rewriteTop(m, b))
        }
    }
    var at = 0
    while at < len(m.queue) {
        let (name, id, b, targs, dicts) = m.queue[at]
        at = at + 1
        let group = match Map.get(m.made, b.name) {
            Some(g) -> g
            None -> {
                let g = Vec.new(2)
                Map.put(m.made, b.name, g)
                g
            }
        }
        Vec.push(group, build(m, name, id, b, targs, dicts))
    }

    let out = CProgram { dicts = Vec.new(16), binds = Vec.new(32) }
    for (group, target) in [(m.program.dicts, out.dicts),
                            (m.program.binds, out.binds)] {
        for b in group {
            -- Beside its original, which is already in dependency order, and
            -- ahead of it, since a specialization depends on no more than the
            -- original does. Top-level bindings are evaluated in this order, so
            -- it has to be one that works.
            for made in Map.getOr(m.made, b.name, []) {
                Vec.push(target, made)
            }
            Vec.push(target, Map.getOr(rewritten, b.name, b))
        }
    }
    out
}

fun rewriteTop(m : Mono, b : CBind) -> CBind {
    let r = newRewriter(m, Map.new(), b.equations, None, Map.new(), Map.new())
    CBind {
        name = b.name, id = b.id, ty = b.ty, binders = b.binders,
        value = rewrite(r, b.value), span = b.span, mutable = b.mutable,
        module_ = b.module_, equations = b.equations,
        layouts = b.layouts,
    }
}

-- Ask for a binding at these arguments, and get its spelling and binder id.
-- `None` means the cap said no.
--
-- **Each specialization is a top-level binder in an owner of its own.** The
-- owner is registered here, and owners are numbered from one counter, so the
-- id depends on the order of requests. That order is the program's: the
-- whole of `runMono` runs on one thread, rewriting the bindings in program
-- order and then building the queue in the order it was filled. The owner is
-- named, and the binder spelled, by the origin and the type arguments.
fun request(m : Mono, b : CBind, targs : Array Ty.Type,
            dicts : Option (Vec String)) -> Option (String, Int) {
    for t in targs {
        if !ground(t) { return None }
    }
    let key = b.name + "|" + argsKey(targs) + "|" + match dicts {
        Some(ds) -> String.join(ds, ",")
        None -> "*"
    }
    match Map.get(m.state.done, key) {
        Some(found) -> return Some(found)
        None -> {}
    }
    -- Size first, then the budget, so a request refused for its type does not
    -- also spend a copy the program never received.
    for t in targs {
        if typeSize(t) > maxTypeNodes { return None }
    }
    if !admit(m.state, b) { return None }
    let name = topSpelling(b, targs, dicts)
    match Map.get(m.state.spellings, name) {
        Some(other) -> oops("two specializations are both spelled '" + name
                            + "': " + other + " and " + key, b.span)
        None -> Map.put(m.state.spellings, name, key)
    }
    let origin = if b.id == noId { None } else { Some(b.id) }
    let id = Binders.fresh(m.table, Binders.owner(m.table, b.module_, name), name,
                           Binders.TopLevel, Specialized(origin, targs, b.span))
    derive(m.state, name, b.name)
    match dicts {
        Some(_) -> if Set.contains(m.dictGroup, b.name) { Set.add(m.topDicts, name) }
        None -> {}
    }
    -- Recorded *before* the body is built, which is what makes a recursive
    -- binding terminate: the copy's own call to itself, at its own arguments,
    -- finds this entry rather than asking for another copy.
    Map.put(m.state.done, key, (name, id))
    Vec.push(m.queue, (name, id, b, targs, dicts))
    Some((name, id))
}

-- A top-level specialization's spelling, which is also its symbol in the
-- object file.
--
-- A binding that takes dictionaries is specialized two ways: collapsed, with
-- the dictionaries supplied, and, where a call's dictionary is not a
-- top-level one, at its types alone and still taking them. The second is
-- spelled `~dicts`. Two collapses of one binding at one type are handed the
-- same dictionaries, since instances are coherent; `request` checks it, and
-- an earlier spelling that a second request would reuse is an internal
-- error rather than a binding defined twice.
fun topSpelling(b : CBind, targs : Array Ty.Type, dicts : Option (Vec String)) -> String =
    match dicts {
        None -> if takesDictionaries(b) { spelling(b.name, targs) + "~dicts" }
                else { spelling(b.name, targs) }
        Some(_) -> spelling(b.name, targs)
    }

fun build(m : Mono, name : String, id : Int, b : CBind, targs : Array Ty.Type,
          dicts : Option (Vec String)) -> CBind {
    let subst = Map.new()
    for var i = 0; i < len(b.binders) && i < len(targs); i = i + 1 {
        Map.put(subst, b.binders[i].id, targs[i])
    }
    let r = newRewriter(m, subst, b.equations, Some(Binders.ownerOf(id)),
                        Map.new(), Map.new())
    var ty = rTy(r, b.ty)
    var value = b.value
    match dicts {
        None -> {}
        Some(ds) -> {
            -- The evidence, supplied. The lambda goes away and its parameters
            -- are renamed to the dictionaries they were handed -- a rename and
            -- not a `let`, because the argument is a top-level name, so
            -- substituting it is capture-free and leaves what the body projects
            -- out of something devirtualization can see through.
            let (params, body, _) = match value.kind {
                CLam(ps, bd, n) -> (ps, bd, n)
                _ -> oops("a collapsed binding is not a lambda", b.span)
            }
            for var i = 0; i < len(params) && i < len(ds); i = i + 1 {
                Map.put(r.rename, refTo(params[i].name, params[i].id), ds[i])
            }
            value = body
            ty = rTy(r, body.ty)
        }
    }
    -- A method is polymorphic in its *own* variables as well as the class
    -- variable, and the lowering states those in a `CTyLam` under the
    -- dictionary lambda. Consuming that lambda leaves the abstraction
    -- outermost, and a copy that left it there would be a binding with no
    -- binders whose body is still generic -- which `instantiate` cannot match
    -- type arguments against and layout sharing cannot key a copy on. The call
    -- site already applies these types to the copy, so the abstraction belongs
    -- on the binding.
    let binders = Vec.new(2)
    var going = True
    while going {
        match value.kind {
            CTyLam(vs, body) -> {
                for v in vs { Vec.push(binders, v) }
                value = body
                ty = rTy(r, body.ty)
            }
            _ -> { going = False }
        }
    }
    CBind {
        name = name, id = id, ty = ty, binders = binders, value = rewrite(r, value),
        span = b.span, mutable = b.mutable, module_ = b.module_,
        equations = r.equations, layouts = b.layouts,
    }
}

-- The binders a specialization of `b` will state for itself: the `CTyLam` that
-- `build` above lifts out once the dictionary lambda is consumed.
fun promotedBinders(b : CBind, dicts : Option (Vec String)) -> Vec VarCell {
    let out = Vec.new(2)
    match dicts {
        None -> return out
        Some(_) -> {}
    }
    var value = match b.value.kind {
        CLam(_, body, _) -> body
        _ -> return out
    }
    var going = True
    while going {
        match value.kind {
            CTyLam(vs, body) -> {
                for v in vs { Vec.push(out, v) }
                value = body
            }
            _ -> { going = False }
        }
    }
    out
}

-- -- what the backend is handed ---------------------------------------------------

-- Every type in the program, with its family applications reduced.
--
-- The backend reads a type *whole* and asks it for a representation, and an
-- unreduced family has none: nothing can answer `Index.Value (Array Bool)`,
-- while the body that produces the value knows it is the `Bool` the instance
-- says it is and hands over a bare `i1`. The reader then unboxes a raw value.
--
-- The rewriter reduces as it substitutes, so a *specialized* binding is already
-- reduced -- and says, correctly, that with no substitution there is nothing to
-- do. What that leaves is the binding nothing specialized, whose types are the
-- ones the lowering wrote: a dictionary's method still takes
-- `Index.Key (Array a)` there, because the lowering builds a field's type by
-- putting the instance head into the method's scheme and the scheme is written
-- in the class's families.
--
-- So it is done here, once, for the whole program, rather than at each of the
-- places a family can be introduced -- a layout is total on the types that
-- reach it only if *every* such place remembered, and one pass is a thing that
-- can be true rather than a rule five writers have to keep.
fun reduceTypes(program : CProgram, classes : ClassTable) -> CProgram {
    let instances = Inert.empty(classes)
    CProgram {
        dicts = Vec.map(program.dicts, reduceBind(_, instances)),
        binds = Vec.map(program.binds, reduceBind(_, instances)),
    }
}

fun reduceBind(b : CBind, instances : Inert.Inert) -> CBind {
    let out = rewriteValue(b, reduceCore(b.value, instances))
    out.ty = Inert.rewrite(instances, b.ty)
    out
}

fun rewriteValue(b : CBind, value : Core) -> CBind = CBind {
    name = b.name, id = b.id, ty = b.ty, binders = b.binders, value = value,
    span = b.span, mutable = b.mutable, module_ = b.module_,
    equations = b.equations, layouts = b.layouts,
}

fun reduceCore(e : Core, instances : Inert.Inert) -> Core =
    mkCore(Inert.rewrite(instances, e.ty), e.span, mapKind(e.kind, Mapper {
        expr = fun(x) = reduceCore(x, instances),
        type_ = fun(t) = Inert.rewrite(instances, t),
        bind = fun(b) = reduceBind(b, instances),
    }))

-- The bindings holding an existential arm `Turkey.Layout` did not copy.
--
-- The arm's field layouts depend on what was packed, so an arm with no layouts
-- is one the backend would read at a guess -- the same refusal
-- `leakedParameters` makes for a generic parameter, for the binder it cannot
-- see: a pattern's.
fun unsharedOpenings(program : CProgram) -> Vec String {
    let all = Vec.append(program.dicts, program.binds)
    let unshared = Parallel.map(all, fun(b) {
        let hits = Vec.new(1)
        unsharedInto(b.value, hits)
        len(hits) > 0
    })
    let found = Vec.new(2)
    for var i = 0; i < len(all); i = i + 1 {
        if unshared[i] { Vec.push(found, all[i].name) }
    }
    found
}

fun unsharedInto(e : Core, found : Vec Bool) -> Unit {
    if len(found) > 0 { return {} }
    match e.kind {
        CMatch(_, alts) -> for alt in alts {
            match openingOf(alt.alt) {
                Some(o) -> match o.layouts {
                    None -> Vec.push(found, True)
                    Some(_) -> {}
                }
                None -> {}
            }
        }
        _ -> {}
    }
    discard(mapKind(e.kind, Mapper {
        expr = fun(x) = {
            unsharedInto(x, found)
            x
        },
        type_ = fun(t) = t,
        bind = fun(b) = {
            unsharedInto(b.value, found)
            b
        },
    }))
}

-- Refuse to compile a program with an existential arm that no layout copy
-- was made for.
--
-- Refusing rather than warning because the alternative is silence: the backend
-- reads a field at the layout it computes, and if the arm disagreed with the
-- packing the result would be a wrong value rather than an error. Every other
-- type's layout is checked by `Turkey.Layout.unknownLayouts`.
fun checkLayouts(program : CProgram) -> Unit {
    let unopened = unsharedOpenings(program)
    if len(unopened) > 0 {
        oops("an existential pattern reached the backend with no layout for "
             + "what it opens: " + String.join(Vec.sort(unopened), ", "), None)
    }
}

fun oops(message : String, where : Option Span) -> a = match where {
    None -> Diag.fail(Diag.whole("internal error", message), "")
    Some(s) -> Diag.fail(Diag.at("internal error", message, s), s.file)
}

fun discard(x : a) -> Unit = {}

-- -- devirtualization ---------------------------------------------------------------

-- A method selected from a *known* dictionary becomes a name.
--
-- After specialization a method call is a projection out of a record this pass
-- can see the definition of, and then an indirect call. Both halves are
-- avoidable: each method of a dictionary is hoisted into a top-level binding of
-- its own, the record's field becomes a reference to it, and a projection out
-- of the dictionary reads that reference back (`Turkey.Methods`, the one rule
-- for it, which `Turkey.Opt` applies too).
--
-- Coherence is what makes it sound. One instance at one type is one record,
-- and no other value can ever be that class's dictionary there, so a field's
-- value is decided at compile time and a name for it is a name for what the
-- projection would have found.
--
-- A *generic* dictionary is as known as a ground one: an instance applied to
-- types the budget did not give a copy for still has the instance's methods as
-- its fields. So its methods are hoisted too, generic in the instance's
-- variables and then the method's own, taking the instance's context
-- dictionaries first; its fields refer to them applied to those variables and
-- parameters, and reading one out of an application substitutes. Specialization
-- then treats a method like any other generic binding: a copy if one is
-- granted, otherwise the generic body, called directly and copied per layout
-- by `Turkey.Layout`. Whether a *body* is
-- copied is a budget question; whether a method of a known instance is called
-- through a record is not.
--
-- What falls out rather than being arranged: a `for` loop's `iter` and `next`
-- are ordinary names; a superclass field is already a reference to a
-- dictionary, so it is read like any other; and hoisting is idempotent -- a
-- field that is already a reference is left alone -- so the rounds need not
-- remember what an earlier one hoisted. The records stay; reachability removes
-- the ones nothing reads.
type Devirt = Devirt {
    program   : CProgram,
    table     : Binders.Table,
    classes   : ClassTable,
    state     : State,
    used      : Set.Set String,
    hoisted   : Vec CBind,
    var dicts : Methods.Dictionaries,
}

fun newDevirt(program : CProgram, table : Binders.Table, classes : ClassTable,
              state : State) -> Devirt =
    Devirt {
        program = program, table = table, classes = classes, state = state, used = Set.new(),
        hoisted = Vec.new(8), dicts = Map.new(),
    }

fun runDevirt(d : Devirt) -> CProgram {
    for b in Vec.append(d.program.dicts, d.program.binds) {
        Set.add(d.used, b.name)
    }
    -- Every method hoisted before any rewrite, because a method's body may
    -- project out of a dictionary whose fields have not been looked at yet --
    -- including its own.
    let dicts = Vec.map(d.program.dicts, fun(b) = match hoistAll(d, b) {
        Some(value) -> withValue(b, value)
        None -> b
    })
    d.dicts = Methods.dictionaries(dicts)
    let out = CProgram { dicts = Vec.new(16), binds = Vec.new(32) }
    for b in dicts { Vec.push(out.dicts, devirtBind(d, b)) }
    -- The hoisted bindings live with the dictionaries, not after them: everything
    -- in `dicts` is defined before any record is filled, and a record's field
    -- now names a hoisted binding. A hoisted binding is always a lambda, so
    -- defining it builds a closure and cannot read a record that is still empty.
    for b in d.hoisted { Vec.push(out.dicts, devirtBind(d, b)) }
    for b in d.program.binds { Vec.push(out.binds, devirtBind(d, b)) }
    out
}

fun withValue(b : CBind, value : Core) -> CBind = CBind {
    name = b.name, id = b.id, ty = b.ty, binders = b.binders, value = value,
    span = b.span, mutable = b.mutable, module_ = b.module_,
    equations = b.equations, layouts = b.layouts,
}

fun devirtBind(d : Devirt, b : CBind) -> CBind = withValue(b, devirt(d, b.value))

-- A dictionary with each method moved into a binding of its own and its field
-- replaced by a reference to that binding, or `None` when there is nothing to
-- move.
fun hoistAll(d : Devirt, b : CBind) -> Option Core {
    if b.mutable { return None }
    match b.value.kind {
        CDict(cls, slots) ->
            match hoistFields(d, b, b.ty, [], slots) {
                Some(made) -> Some(mkCore(b.value.ty, b.value.span, CDict(cls, made)))
                None -> None
            }
        CLam(params, body, name) -> match body.kind {
            CDict(cls, slots) -> match hoistFields(d, b, body.ty, params, slots) {
                Some(made) -> Some(mkCore(b.value.ty, b.value.span, CLam(params,
                    mkCore(body.ty, body.span, CDict(cls, made)), name)))
                None -> None
            }
            _ -> None
        }
        _ -> None
    }
}

fun hoistFields(d : Devirt, owner : CBind, dictTy : Ty.Type, params : Array CParam,
                slots : Array Core) -> Option (Array Core) {
    let cls = match dictClass(dictTy) {
        Some(c) -> c
        None -> return None
    }
    var changed = False
    let out = Array.init(len(slots), fun(i) {
        let method = match Classes.slotAt(d.classes, cls, i) {
            Some(MethodSlot(m)) -> m
            _ -> return slots[i]
        }
        match hoist(d, owner, dictTy, params, method, slots[i]) {
            Some(reference) -> {
                changed = True
                reference
            }
            None -> slots[i]
        }
    })
    if changed { Some(out) } else { None }
}

-- One method as a binding: generic in the instance's variables and then the
-- method's own, taking the instance's context dictionaries first. Answers the
-- reference the field holds instead. A field that is already a reference is
-- left alone, and so is one that is not a method: hoisting a value that is not
-- a lambda would move an evaluation to where the dictionaries are built, and
-- what an evaluation there can observe is exactly what the two-pass build
-- exists to be careful about.
fun hoist(d : Devirt, owner : CBind, dictTy : Ty.Type, params : Array CParam,
          method : String, value : Core) -> Option Core {
    if Methods.isAtom(value) { return None }
    let (own, inner) = abstraction(d, dictTy, method, value)
    match inner.kind {
        CLam(_, _, _) -> {}
        _ -> return None
    }
    var made = owner.name + "#" + Classes.surfaceMember(method)
    while Set.contains(d.used, made) { made = made + "~" }
    Set.add(d.used, made)
    derive(d.state, made, owner.name)
    let binders = Vec.append(owner.binders, own)
    let body = if len(params) == 0 { inner } else {
        -- The instance's lambda still binds `params`, and so does every other
        -- method hoisted out of it, so each method's binding binds copies of
        -- them, each under an id of its own.
        let home = Binders.owner(d.table, owner.module_, made)
        let ids = Map.new()
        let copies = Array.map(params, fun(p) {
            let CParam { name, id, ty } = p
            let copy = Binders.fresh(d.table, home, name, Binders.Local, CopyOf(id))
            Map.put(ids, id, copy)
            CParam { name = name, id = copy, ty = ty }
        })
        mkCore(TFun(Array.map(params, _.ty), inner.ty), owner.span,
               CLam(copies, renamedRefs(inner, ids), made))
    }
    Vec.push(d.hoisted, CBind {
        name = made, id = noId, ty = body.ty, binders = binders, value = body,
        span = owner.span, mutable = False, module_ = owner.module_,
        equations = Vec.slice(owner.equations, 0, len(owner.equations)),
        layouts = Map.new(),
    })
    let head = mkCore(body.ty, value.span, CVar(BySpelling(made)))
    let applied = if len(binders) == 0 { head } else {
        mkCore(body.ty, value.span, CTyApp(head, Array.map(binders, TVar)))
    }
    let reference = if len(params) == 0 { applied } else {
        mkCore(inner.ty, value.span, CApp(applied,
            Array.map(params, fun(p) = mkCore(p.ty, value.span, CVar(refTo(p.name, p.id))))))
    }
    -- A method that states its own quantification keeps stating it.
    match value.kind {
        CTyLam(stated, _) -> Some(mkCore(value.ty, value.span, CTyLam(stated, reference)))
        _ -> Some(reference)
    }
}

-- `e` with each reference to a binder `ids` maps made to the binder it maps
-- to instead.
--
-- Rebuilds every node of `e`, and `hoist` calls it on every method body it
-- moves out of an instance with a context. That is a measured cost we
-- accept. On the self-compile it is about 0.75M allocations, and they shift
-- the collector's schedule so that peak heap regions are about 20% higher
-- than without them, while peak live objects are about 2% lower. The renaming
-- cannot be avoided: every method hoisted out of one instance binds that
-- instance's context, and no id may be bound in two bindings.
fun renamedRefs(e : Core, ids : Map Int Int) -> Core = match e.kind {
    CVar(ById(id)) -> match Map.get(ids, id) {
        Some(made) -> mkCore(e.ty, e.span, CVar(ById(made)))
        None -> e
    }
    _ -> mkCore(e.ty, e.span, mapKind(e.kind, Mapper {
        expr = renamedRefs(_, ids),
        type_ = fun(t) = t,
        bind = fun(b) = withValue(b, renamedRefs(b.value, ids)),
    }))
}

-- A field's own type abstraction, as binders and a body.
--
-- A method that quantifies over more than its class variable is not always a
-- type abstraction in the term. When the method has a context of its own the
-- lowering emits the dictionary lambda and leaves the quantification implicit,
-- because the checker reads a projection's binders off the *class table* rather
-- than off the term. So this reads them the same way, and takes the term's only
-- when the term states them.
--
-- Getting this from the term alone is what a first attempt did, and the checker
-- caught it immediately: a method was hoisted with no binders and the use site
-- still had one type argument.
fun abstraction(d : Devirt, dictTy : Ty.Type, method : String,
                value : Core) -> (Vec VarCell, Core) {
    match value.kind {
        CTyLam(binders, body) -> return (binders, body)
        _ -> {}
    }
    let cls = match dictClass(dictTy) {
        Some(c) -> c
        None -> return ([], value)
    }
    let info = match Map.get(d.classes.classes, cls) {
        Some(i) -> i
        None -> return ([], value)
    }
    let m = match Map.get(info.methods, method) {
        Some(x) -> x
        None -> return ([], value)
    }
    let binders = Vec.new(4)
    for q in m.scheme.quantified {
        if q.id != m.classVar.id { Vec.push(binders, q) }
    }
    (binders, value)
}

-- Every projection out of a known dictionary, read back as the reference its
-- field holds. A projection applied to the method's own types is read with
-- them, as one: reading the bare projection first would leave an application
-- of an application.
fun devirt(d : Devirt, e : Core) -> Core = match e.kind {
    CTyApp(fn, own) -> match fn.kind {
        CSlot(target, index) -> {
            let field = mkCore(fn.ty, fn.span, CSlot(devirt(d, target), index))
            match Methods.knownField(d.dicts, field, own, e.ty) {
                Some(found) -> found
                None -> mkCore(e.ty, e.span, CTyApp(field, own))
            }
        }
        _ -> recurse(d, e)
    }
    CSlot(target, index) -> {
        let field = mkCore(e.ty, e.span, CSlot(devirt(d, target), index))
        match Methods.knownField(d.dicts, field, [], e.ty) {
            Some(found) -> found
            None -> field
        }
    }
    _ -> recurse(d, e)
}

fun recurse(d : Devirt, e : Core) -> Core = mkCore(e.ty, e.span, mapKind(e.kind, Mapper {
    expr = fun(x) = devirt(d, x),
    type_ = fun(t) = t,
    bind = fun(b) = devirtBind(d, b),
}))

-- -- reachability -------------------------------------------------------------------

-- Whether not evaluating this binding is unobservable.
--
-- The test is *effects*, not use, because a top-level binding is evaluated for
-- its own sake: the program walks its bindings in order before it calls `main`,
-- so a binding whose right-hand side prints has printed whether or not anything
-- reads it. Three kinds are safe, each for a stated reason: a dictionary, which
-- is a record or a lambda; a binding with binders, which generalized, and under
-- the value restriction a generalized right-hand side is a syntactic value; and
-- any other binding whose value is literally a lambda.
--
-- The trap this sets for code that differs by target: a top-level `let` of
-- anything else is kept whether or not it is read, so everything its value
-- mentions reaches the link. A per-target value that names a `foreign` symbol
-- only one target has -- a record of functions for Linux, say -- has to be
-- built by a function, and chosen by a `match Target.os` that calls it, or a
-- build for every other target keeps the symbol and fails to link.
fun droppable(b : CBind, isDict : Bool) -> Bool {
    if isDict || len(b.binders) > 0 { return True }
    match b.value.kind {
        CLam(_, _, _) -> True
        CTyLam(_, _) -> True
        _ -> False
    }
}

-- Drop the bindings nothing reaches, where dropping one is unobservable.
--
-- This is what makes specialization a saving rather than an addition. A program
-- that used a class at two types carried the generic binding, the two copies, and
-- every dictionary the Prelude declares; after this it carries the two copies and
-- the dictionaries they name.
--
-- The guard the cap needs is not written here because it does not need to be: a
-- capped call site still holds a type application of the generic binding, so the
-- generic binding is named by whatever reaches that call site, and being named is
-- all this asks for.
--
-- Run once, at the end, and not between rounds: an intermediate round's output is
-- full of bindings nothing reaches *yet*, and dropping one would be answering a
-- question the next round was going to ask.
--
-- Only the bindings `prunable` accepts are dropped; the rest are kept as if
-- `main` named them.
fun reachable(program : CProgram, main : String, roots : Vec String,
              definitions : Map String ForeignInfo,
              prunable : fun(CBind) -> Bool) -> CProgram {
    let byname = Map.new()
    for b in Vec.append(program.dicts, program.binds) {
        Map.put(byname, b.name, b)
    }
    let drop = Set.new()
    for b in program.dicts {
        if prunable(b) { Set.add(drop, b.name) }
    }
    for b in program.binds {
        if droppable(b, False) && prunable(b) { Set.add(drop, b.name) }
    }
    let work = Vec.new(16)
    for (name, _) in Map.entries(byname) {
        if !Set.contains(drop, name) { Vec.push(work, name) }
    }
    Vec.push(work, main)
    for name in roots { Vec.push(work, name) }
    -- A `Prim.codeAddress` names its definition by C symbol.
    let bySymbol = Map.new()
    for (name, info) in Map.entries(definitions) {
        Map.put(bySymbol, codeAddressName(info.symbol), name)
    }
    let reach = Set.new()
    for n in work { Set.add(reach, n) }
    while len(work) > 0 {
        let name = match Vec.pop(work) {
            Some(n) -> n
            None -> ""
        }
        match Map.get(byname, name) {
            None -> {}
            Some(b) -> for used in Set.elements(namesOf(b.value)) {
                let n = Map.getOr(bySymbol, used, used)
                if !Set.contains(reach, n) {
                    Set.add(reach, n)
                    Vec.push(work, n)
                }
            }
        }
    }
    let out = CProgram { dicts = Vec.new(16), binds = Vec.new(32) }
    for b in program.dicts {
        if Set.contains(reach, b.name) { Vec.push(out.dicts, b) }
    }
    for b in program.binds {
        if Set.contains(reach, b.name) { Vec.push(out.binds, b) }
    }
    out
}

-- Specialize, devirtualize, again, and then drop what nothing reaches.
--
-- The rounds share one state, which is what makes the ceiling one ceiling. Reachability
-- runs once, at the end, over the finished program.
fun monomorphize(program : CProgram, table : Binders.Table, decls : DeclTable,
                 classes : ClassTable, main : String, roots : Vec String) -> CProgram {
    let state = newState()
    state.expanding = expandingBindings(program)
    var size = 0
    for b in Vec.append(program.dicts, program.binds) {
        size = size + Opt.sizeOf_(b.value) + 1
    }
    state.ceiling = size * ceilingFactor
    var out = program
    for var i = 0; i < rounds; i = i + 1 {
        let specialized = runMono(newMono(out, table, decls, classes, state))
        out = runDevirt(newDevirt(specialized, table, classes, state))
    }
    reachable(out, main, roots, decls.definitions, fun(_) = True)
}

-- The bindings reachability starts from besides `main`: the `foreign`
-- definitions C may call. A program's own are there for C, which this cannot
-- see, so every one is a root. The runtime's (`Turkey.*`) are there for the
-- code the backend writes, so only those it names by symbol are -- unless a
-- C caller drives the runtime without running the program, as the runtime's
-- own tests do, and then only C knows which it will call.
fun runtimeRoots(decls : DeclTable, everyDefinition : Bool) -> Vec String {
    let out = []
    for (name, info) in Map.entries(decls.definitions) {
        if everyDefinition || !String.startsWith(name, "Turkey.")
                || Array.contains(Rt.referencedSymbols, info.symbol) {
            Vec.push(out, name)
        }
    }
    Vec.sort(out)
}

-- -- polymorphic recursion ------------------------------------------------------------

-- The bindings whose specializations would never end: those on a cycle that
-- instantiates a binding at a type strictly containing one of its own
-- parameters.
--
-- The test is the one ECMA-335 states for generic definitions (II.9.2): a
-- graph whose nodes are type parameters, with an edge from a parameter `a` of
-- the caller to the parameter `b` of the callee it instantiates, for every
-- call from one member of a recursive binding group to another. The edge is
-- *plain* when the argument is `a` itself and *expanding* when `a` occurs
-- strictly inside it (`depth` at `a` calling `depth` at `Pair a`). The
-- instantiations reachable from any ground call are finite exactly when no
-- cycle contains an expanding edge: a cycle of plain edges only permutes
-- parameters, and the memo already stops that. So this is decided before
-- specializing, from the program alone, and nothing that is not
-- polymorphically recursive is ever refused for being so.
--
-- Only a binding with a complete signature can be polymorphically recursive:
-- without one a recursive use is at the group's own parameters, which is a
-- plain edge. An instance's context only ever asks for dictionaries at smaller
-- types, so dictionary construction adds no expanding edge.
fun expandingBindings(program : CProgram) -> Set.Set String {
    let generic = Map.new()
    for b in Vec.append(program.dicts, program.binds) {
        if len(b.binders) > 0 { Map.put(generic, b.name, b) }
    }
    let calls = Map.new()
    for (name, b) in Map.entries(generic) {
        let deps = Set.new()
        for n in Set.elements(namesOf(b.value)) {
            if Map.contains(generic, n) { Set.add(deps, n) }
        }
        Map.put(calls, name, deps)
    }
    let groupOf = Map.new()
    for group in Deps.sccs(calls) {
        for n in group { Map.put(groupOf, n, group[0]) }
    }
    let params = Map.new()
    let expanding = []
    for (name, b) in Map.entries(generic) {
        let group = Map.getOr(groupOf, name, name)
        for (callee, types) in typeApplications(b.value) {
            match Map.get(generic, callee) {
                Some(target) -> if Map.getOr(groupOf, callee, callee) == group {
                    for var j = 0; j < len(types) && j < len(target.binders); j = j + 1 {
                        let t = Ty.prune(types[j])
                        for var i = 0; i < len(b.binders); i = i + 1 {
                            let from = parameterNode(name, i)
                            let to = parameterNode(callee, j)
                            let plain = match t {
                                TVar(cell) -> cell.id == b.binders[i].id
                                _ -> False
                            }
                            var occurs = False
                            for v in Ty.varsOf([t]) {
                                if v.id == b.binders[i].id { occurs = True }
                            }
                            if plain || occurs {
                                let out = match Map.get(params, from) {
                                    Some(found) -> found
                                    None -> {
                                        let made = Set.new()
                                        Map.put(params, from, made)
                                        made
                                    }
                                }
                                Set.add(out, to)
                                if !plain { Vec.push(expanding, (from, to)) }
                            }
                        }
                    }
                }
                None -> {}
            }
        }
    }
    let componentOf = Map.new()
    let components = Deps.sccs(params)
    for var k = 0; k < len(components); k = k + 1 {
        for n in components[k] { Map.put(componentOf, n, k) }
    }
    let out = Set.new()
    for (from, to) in expanding {
        match (Map.get(componentOf, from), Map.get(componentOf, to)) {
            (Some(a), Some(b)) -> if a == b {
                for n in components[a] { Set.add(out, bindingOfNode(n)) }
            }
            _ -> {}
        }
    }
    out
}

fun parameterNode(binding : String, index : Int) -> String =
    binding + "\t" + Int.toString(index)

fun bindingOfNode(node : String) -> String = String.split(node, "\t")[0]

-- Every type application of a name in `e`, as (name, types).
fun typeApplications(e : Core) -> Vec (String, Array Ty.Type) {
    let out = []
    collectTypeApplications(e, out)
    out
}

fun collectTypeApplications(e : Core, out : Vec (String, Array Ty.Type)) -> Unit {
    match e.kind {
        CTyApp(fn, types) -> match fn.kind {
            CVar(BySpelling(name)) -> Vec.push(out, (name, types))
            _ -> {}
        }
        _ -> {}
    }
    let _ = mapKind(e.kind, Mapper {
        expr = fun(x) = { collectTypeApplications(x, out); x },
        type_ = fun(t) = t,
        bind = fun(b) = { collectTypeApplications(b.value, out); b },
    })
}
