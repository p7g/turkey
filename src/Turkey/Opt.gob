export (
    inlineLimit, joinSpecializeLimit, speculativeInlineLimit,
    loopBreakers, reduceProgram, sizeOf_, instantiateTypes, measure,
)

-- The local reductions, from inlining through loop-result fusion.
--
-- None of them knows what a monad is, and that is the point: a `bind` chain is
-- reached the way any other saturated call to a known small function is
-- reached.
--
-- Within either side of join discovery they are one traversal rather than a
-- pass per rule, because they feed each other and it would be dishonest to
-- pretend otherwise. Inlining `bind` puts a lambda in the function position of
-- an application, which is beta; beta binds a parameter to a constructor
-- application, which is case-of-known-constructor; and that selects a branch,
-- which exposes the next call. Splitting those rules into separate passes over
-- the whole program would mean running the sequence to a fixed point from
-- outside, which is the same computation with more traversals and a less
-- obvious bound.
--
-- ## Termination is structural, not budgeted
--
-- `Turkey.Mono`'s cap is a budget: monomorphization stops because it has spent enough,
-- not because it has finished. This pass does not work that way -- inlining
-- terminates when the call graph it walks is acyclic, and the standard way to
-- make it acyclic is to choose a **loop breaker** in each cycle and never
-- inline that one. The choice within a component is arbitrary but stable: the
-- lexicographically first, which is the first element because `Turkey.Deps`
-- sorts each component. Arbitrary because no criterion here is better than
-- another; stable because a `.opt` golden would otherwise move whenever a name
-- changed.
--
-- ## Arguments are bound, not substituted -- unless they are values
--
-- The evaluator is strict and left to right, so substituting an argument
-- expression into a body that mentions its parameter twice would evaluate it
-- twice, and into one that mentions it never would evaluate it never. So an
-- argument becomes a `CLet`, which is exactly a call-by-value binding. The
-- exception is an argument that is already a **value**: duplicating one costs
-- nothing and evaluates nothing, and substituting it is what lets the next
-- reduction see through it.
--
-- ## Every binder is bound once
--
-- Every local binder has an id (`adoptProgram`), and no id is bound twice in
-- the program, in the input or in the output: `Turkey.Coretc` checks it before
-- this pass and after it. Every rule that puts a second copy of a term in the
-- program makes it with `copyWith`, which gives each binder in the copy a
-- fresh id. So no rule has to ask whether moving a term under a binder
-- captures a variable: the binder and the variable have different ids. Each
-- rule keys a binder on its id, never on its spelling, and a copy keeps its
-- original's spelling, so the spellings of two binders may clash until
-- `respell` tells them apart.
--
-- The ids a reduction mints are deterministic however components are
-- scheduled; see `mint`.
--
-- ## One place that knows a node's shape
--
-- The shape of a node is read in one place -- `anyKid` -- and every walk that
-- only needs "the subterms" is written in terms of it. The walks that need
-- more than that (binders, free names, tail positions) say what more they need
-- beside their own recursion, which is where they differ from each other
-- anyway.
--
-- ## Not here: constant folding and common subexpressions
--
-- Neither would fire. In the Core this pass leaves, over the test corpus and
-- the compiler itself, no primitive application has even one literal operand
-- -- a programmer writes a constant already folded, and inlining substitutes
-- variables -- and a repeated pure expression occurs 32 times in 384,095
-- nodes. The constants appear during lowering (tag tests, offsets, bounds),
-- which is why the low IR has sparse conditional constant propagation and this
-- has none. Core already propagates what it can: `let`-bound values are
-- substituted, a known constructor selects its branch, and a join is
-- specialized per constructor its jumps supply.
--
-- A folder added here anyway has two traps. `Int` arithmetic panics on
-- overflow, so it must fold only a result it has proved in range -- neither
-- to a wrapped literal nor to an eager panic in a branch that may not run --
-- and must check before it computes, since the compiler's own `+` panics too.
-- And CSE needs an effects analysis Core does not have: `isValue` is about
-- cost, not about whether two occurrences read the same mutable state.

import Data.Set as Set
import Turkey.Ast (..)
import Turkey.Ast as Ast
import Turkey.Binders as Binders
import Turkey.Binders (Origin(..))
import Turkey.Core (..)
import Turkey.Decls as Decls
import Turkey.Decls (DeclTable(..), substitute)
import Turkey.Deps as Deps
import Turkey.Prims as Prims
import Turkey.Diag as Diag
import Turkey.Methods as Methods
import Turkey.Prelude as P
import Turkey.Source (Span)
import Turkey.Types as Ty
import Turkey.Types (VarCell(..), TBottom)
import System.IO as IO
import System.Parallel as Parallel
import Algorithm.Hash (fnv1a)
import Data.Hashable (Hasher(..))
import Time.Duration (Duration)
import Time.Duration as Duration
import Time.Stopwatch as Stopwatch

-- How large a body may be and still be inlined, counted as `sizeOf_` counts.
-- Small enough that a call site does not become unreadable, large enough for
-- the things this exists to reach: a method's body, an instance's `bind`.
let inlineLimit = 32

-- A shared join is copied only when specializing a known constructor makes the
-- copy small. Deliberately the same scale as ordinary inlining: both trade a
-- bounded amount of code for exposing a local reduction, and neither the
-- traffic through a join nor the number of callers gets to raise that bound.
let joinSpecializeLimit = inlineLimit

-- A larger body may be *examined* at a call site, but is admitted only if
-- applying the known arguments and reducing it brings the residual back under
-- `inlineLimit`. This bounds the work spent asking the question as well as the
-- code ultimately copied. It is deliberately not another emission limit.
let speculativeInlineLimit = inlineLimit * 4

-- What a call may cost when its result is scrutinised right there. The
-- ordinary limit asks only how much code a call site grows by, which is the
-- wrong question when the caller is about to take the constructor apart:
-- inlining `Iterator.next` puts a `Some` next to the `match` that reads it,
-- `caseOfCase` pushes the match through the join the callee's early `return`
-- left behind, and `knownConstructor` then deletes both the allocation and the
-- branch. GHC gives the same discount by name -- a case on a call's result
-- raises the inliner's budget, so `Option` never reaches the heap -- and LLVM's
-- inliner does it too, crediting a call whose result feeds a branch. The whole
-- cost of a `for` loop's `Some` per element rides on this.
let scrutineeInlineLimit = inlineLimit * 2

-- What a callee that always panics may carry into its caller. A bare
-- forwarding call -- `fun error(message) = Prim.error(message)` -- is worth
-- copying, because it costs the caller nothing and keeps the standard library
-- out of the panic trace. Anything larger is the failure path charging the
-- success path, which is what this exists to stop. On `sizeOf_`'s scale that
-- forwarder is the single call and nothing else, since its argument is a
-- variable and variables are free.
let bottomInlineLimit = 1

-- -- the shape of a node, once -------------------------------------------------------

-- Whether `p` holds of some immediate Core subterm, asked in field order and
-- stopping at the first that answers true.
--
-- A visitor rather than a function returning the subterms as an array, which
-- would read better and is a compromise for speed: every walk over the children
-- is a loop, and an array returned to it escapes to the caller, so it is an
-- allocation per node visited that no analysis removes. The closure passed here
-- goes to a parameter that is only called, so it is built in the caller's frame.
fun anyKid(k : CoreKind, p : fun(Core) -> Bool) -> Bool = match k {
    CLit(_) -> False
    CUnit -> False
    CVar(_, _) -> False
    CCon(_) -> False
    CPrim(_) -> False
    CTuple(elems) -> anyOf(elems, p)
    CArray(elems) -> anyOf(elems, p)
    CDict(_, slots) -> anyOf(slots, p)
    CSlot(target, _) -> p(target)
    CProject(target, _) -> p(target)
    CIndex(target, index) -> p(target) || p(index)
    CLam(_, body, _) -> p(body)
    CApp(fn, args) -> p(fn) || anyOf(args, p)
    CTyLam(_, body) -> p(body)
    CTyApp(fn, _) -> p(fn)
    CLet(_, _, _, value, body, _) -> p(value) || p(body)
    CLetRec(binds, body) -> {
        for b in binds { if p(bindValue(b)) { return True } }
        p(body)
    }
    CJoin(_, _, _, body, rest, _) -> p(body) || p(rest)
    CJump(_, _, args) -> anyOf(args, p)
    CRef(value) -> p(value)
    CDeref(target) -> p(target)
    CAssign(target, value) -> p(target) || p(value)
    CIf(cond, then, otherwise) -> p(cond) || p(then) || match otherwise {
        Some(o) -> p(o)
        None -> False
    }
    CMatch(scrutinee, alts) -> {
        if p(scrutinee) { return True }
        for a in alts { if p(altBody(a)) { return True } }
        False
    }
}

-- `f` on every immediate Core subterm, in field order.
fun eachKid(k : CoreKind, f : fun(Core) -> Unit) -> Unit =
    discard(anyKid(k, fun(c) {
        f(c)
        False
    }))

fun anyOf[Iterator c, Item c ~ Core](xs : c, p : fun(Core) -> Bool) -> Bool {
    for x in xs { if p(x) { return True } }
    False
}

fun withValue(b : CBind, value : Core) -> CBind = CBind {
    name = b.name, id = b.id, ty = b.ty, binders = b.binders, value = value,
    span = b.span, mutable = b.mutable, module_ = b.module_,
    equations = b.equations, layouts = b.layouts,
}

-- -- the call graph, and the cycles in it ---------------------------------------------

-- What a binding's value names, and reads or passes along, from one walk
-- each. Everything `reduceProgram` needs to know about the whole program
-- before it starts -- the call graph, the loop breakers, the `var`s something
-- writes -- is read off these, which are walked on as many workers as there
-- are.
type Walked = Walked {
    names    : Set.Set String,
    mentions : Set.Set String,
}

fun walk(b : CBind) -> Walked {
    let mentions = Set.new()
    mentionsInto(b.value, mentions)
    Walked { names = namesOf(b.value), mentions = mentions }
}

-- Which top-level bindings each one mentions, and nothing else.
fun callGraph(binds : Vec CBind, walked : Array Walked) -> Map String (Set.Set String) {
    let known = Set.new()
    for b in binds { Set.add(known, b.name) }
    let graph = Map.new()
    for var i = 0; i < len(binds); i = i + 1 {
        let deps = Set.new()
        for n in Set.elements(walked[i].names) {
            if Set.contains(known, n) { Set.add(deps, n) }
        }
        Map.put(graph, binds[i].name, deps)
    }
    graph
}

-- Enough bindings that every cycle contains one, never to be inlined.
--
-- One per component is not enough. Removing a component's breaker cuts the
-- cycles through it, and a component can hold others: `head` calling itself
-- beside `expr -> inside -> head -> expr` survives the removal of `cell`, and
-- inlining the survivors then does not terminate. So what is left of a
-- component once its breaker is out is split into components again, until none
-- is cyclic.
--
-- Deterministic on purpose: `Turkey.Deps.sccs` sorts each component, so taking
-- the first is the lexicographically first name, and a golden that depends on
-- which binding was broken does not move when an unrelated one is added.
fun loopBreakers(graph : Map String (Set.Set String)) -> Set.Set String {
    let out = Set.new()
    let pending = [graph]
    var k = 0
    while k < len(pending) {
        let current = pending[k]
        k = k + 1
        for component in Deps.sccs(current) {
            let first = component[0]
            if len(component) == 1 {
                if Set.contains(successorsOf(current, first), first) {
                    Set.add(out, first)
                }
            } else {
                Set.add(out, first)
                let rest = Set.new()
                for var m = 1; m < len(component); m = m + 1 {
                    Set.add(rest, component[m])
                }
                let sub = Map.new()
                for var m = 1; m < len(component); m = m + 1 {
                    let kept = Set.new()
                    for n in Set.elements(successorsOf(current, component[m])) {
                        if Set.contains(rest, n) { Set.add(kept, n) }
                    }
                    Map.put(sub, component[m], kept)
                }
                Vec.push(pending, sub)
            }
        }
    }
    out
}

fun successorsOf(graph : Map String (Set.Set String), name : String)
        -> Set.Set String = match Map.get(graph, name) {
    Some(s) -> s
    None -> Set.new()
}

-- Returns `roots` and every name they reach in `graph`.
fun reachable(graph : Map String (Set.Set String), roots : Vec String)
        -> Set.Set String {
    let seen = Set.new()
    let work = []
    for name in roots { Vec.push(work, name) }
    for var k = 0; k < len(work); k = k + 1 {
        if Set.contains(seen, work[k]) { continue }
        Set.add(seen, work[k])
        for next in Set.elements(successorsOf(graph, work[k])) { Vec.push(work, next) }
    }
    seen
}

-- -- the traversal --------------------------------------------------------------------

-- What is being inlined around the term being reduced: the calls `inline`
-- leaves alone here that it would inline elsewhere.
type Inlining = Inlining {
    -- What is currently being inlined. Belt and braces beside the loop
    -- breakers: this makes non-termination impossible in the code rather than
    -- merely absent from the graph.
    active : Vec String,
    -- A speculative large inline may reduce ordinary small calls inside its
    -- residual, but does not recursively speculate about another large call.
    var speculating : Bool,
    -- How many times a call was left alone only because of `active` or
    -- `speculating`. A term reduced while this stayed put is at a fixed point
    -- whatever is being inlined around it, and `expr` marks it so; one reduced
    -- while it moved may reduce further once those are lifted.
    var declined : Int,
    -- The binding whose code the term is: the one being reduced, or the callee
    -- `bodyOf` is reducing. Inlined code becomes part of it.
    var within : String,
}

-- Returns the context of a term with nothing inlined around it.
fun outermost() -> Inlining =
    Inlining { active = [], speculating = False, declined = 0, within = "" }

type Reducer = Reducer {
    breakers : Set.Set String,
    -- Which constructors are their type's only one, and a record constructor's
    -- field order: what deciding a nested pattern needs.
    decls : DeclTable,
    -- Only an immutable, lambda-valued binding can be inlined. A mutable one is
    -- a cell, and reading it twice is not reading it once. Type binders are
    -- fine: a call through `CTyApp` instantiates the lambda in place, which is
    -- type-level beta reduction rather than another top-level specialization.
    bindings : Map String CBind,
    -- The dictionaries a projection is read out of (`Turkey.Methods`).
    dicts : Methods.Dictionaries,
    inlining : Inlining,
    -- The size and the transfer question of each reduced body, beside the body
    -- itself: both are questions about the callee, so both are asked once per
    -- binding rather than once per call site. These, and `reduced` below,
    -- hold the answers about this component's own bindings, which depend on
    -- how far it has got; `cache` holds those about finished components'.
    sizes : Map String Int,
    moves : Map String Bool,
    ends  : Map String Bool,
    cache : Cache,
    -- Which call of `reduceProgram` this is. The second can inline what the
    -- first could not, so it must not trust the first's marks.
    run : Int,
    -- The bindings whose inlined code takes the span of the call it replaces
    -- (`placed`).
    callSites : Set.Set String,
    -- A binding's body, reduced, computed once. Without it a chain `f` calls
    -- `g` calls `h` re-reduces `h` once per path that reaches it, which is
    -- exponential in the depth of the call graph.
    reduced : Map String Core,
    -- The immutable top-level bindings whose reduced value is `atomic`, which a
    -- mention is replaced by. Filled as `reduceProgram` finishes each binding,
    -- and an atom mentions no other binding, so it is finished before anything
    -- that reads it is reduced.
    constants : Map String CBind,
    -- The top-level `var`s nothing ever writes, by the atom each holds from
    -- the start: a read of one is that atom. Only a `var` every mention of
    -- which is a read (`written`), since one passed along as a reference
    -- could be written through.
    unwritten : Map String Core,
    written : Set.Set String,
    minting : Minting,
    -- Which component each binding is in, the one being reduced, and the
    -- results of finished ones (`reduceProgram`). `reduced`, `constants` and
    -- `unwritten` above hold only this component's own; another's are its
    -- `Done`, which every component this one depends on has finished.
    homes : Homes,
    component : Int,
    finished : fun(Int) -> Done,
}

-- Where the binders a reduction makes are numbered (`mint`): in `owner`, the
-- component's own, from `count`, or while `bodyOf` reduces a callee, in
-- `scratch`, from `next`.
type Minting = Minting {
    owner        : Int,
    var count    : Int,
    scratch      : Int,
    var template : Bool,
    var next     : Int,
}

-- Answers about bindings of finished components, kept by a worker across the
-- components it reduces (`Parallel.graphWith`): each is a function of the
-- binding, or of the instantiation, alone, so whichever component asked
-- first, the answer is the same. `wrote` is the size of each body *as
-- written*, which is what the speculative ceiling is checked against before
-- the body is reduced at all.
type Cache = Cache {
    reduced : Map String Core,
    sizes   : Map String Int,
    moves   : Map String Bool,
    ends    : Map String Bool,
    wrote   : Map String Int,
}

fun newCache() -> Cache = Cache {
    reduced = Map.new(), sizes = Map.new(), moves = Map.new(), ends = Map.new(),
    wrote = Map.new(),
}

-- The component of each binding, and of just the bindings that can be a
-- constant (`constant`) or an unwritten `var` (`unwrittenOf`), which are few:
-- every mention of a variable asks, and most variables are neither.
type Homes = Homes {
    all       : Map String Int,
    constant  : Map String Int,
    unwritten : Map String Int,
}

-- What reducing one component made: its bindings' reduced values by index,
-- and the memo entries later components read.
type Done = Done {
    values    : Vec (Int, Core),
    reduced   : Map String Core,
    constants : Map String CBind,
    unwritten : Map String Core,
    cost      : Duration,
}

fun newReducer(program : CProgram, decls : DeclTable, graph : Map String (Set.Set String),
               walked : Array Walked, run : Int, table : Binders.Table,
               callSites : Set.Set String) -> Reducer {
    let all = Vec.append(program.dicts, program.binds)
    let bindings = Map.new()
    for b in all {
        -- Not a `foreign` definition, which C can call by its symbol: the
        -- runtime's use `Prim.frameAddress()` to record their own frame as
        -- where the worker parks while it waits (`Turkey.Workers.acquire`).
        -- Inlined, that frame is the caller's, whose roots a walk from it
        -- skips, and a collection meanwhile frees what the caller holds.
        if !b.mutable && !Map.contains(decls.definitions, b.name) {
            match b.value.kind {
                CLam(_, _, _) -> Map.put(bindings, b.name, b)
                _ -> {}
            }
        }
    }
    let written = Set.new()
    for var i = 0; i < len(all); i = i + 1 {
        for n in Set.elements(walked[i].mentions) { Set.add(written, n) }
    }
    Reducer {
        breakers = loopBreakers(graph), decls = decls, bindings = bindings,
        dicts = Methods.dictionaries(program.dicts),
        inlining = outermost(), sizes = Map.new(), moves = Map.new(),
        ends = Map.new(), cache = newCache(),
        run = run, callSites = callSites,
        reduced = Map.new(), constants = Map.new(),
        unwritten = Map.new(), written = written,
        minting = Minting {
            owner = -1, count = 0,
            scratch = Binders.owner(table, "", "the bodies Turkey.Opt copies"),
            template = False, next = 0,
        },
        homes = Homes { all = Map.new(), constant = Map.new(), unwritten = Map.new() },
        component = -1,
        finished = fun(_) = oops("no component has finished"),
    }
}

-- A reducer for component `c`: what `base` shares, which nothing writes
-- while components are reduced, and memo tables of its own. It mints into
-- `owner`, which no other reducer mints into.
fun forComponent(base : Reducer, c : Int, owner : Int, finished : fun(Int) -> Done,
                 cache : Cache) -> Reducer = Reducer {
    breakers = base.breakers, decls = base.decls, bindings = base.bindings,
    dicts = base.dicts, inlining = outermost(), sizes = Map.new(), moves = Map.new(),
    ends = Map.new(), cache = cache, run = base.run,
    callSites = base.callSites, reduced = Map.new(),
    constants = Map.new(), unwritten = Map.new(), written = base.written,
    minting = Minting {
        owner = owner, count = 0, scratch = base.minting.scratch, template = False,
        next = 0,
    },
    homes = base.homes, component = c, finished = finished,
}

-- Whether `name` is this component's own.
fun owned(r : Reducer, name : String) -> Bool = match Map.get(r.homes.all, name) {
    Some(c) -> c == r.component
    None -> False
}

-- The finished component `name` is in, if it is not this one's.
fun doneOf(r : Reducer, name : String) -> Option Done = match Map.get(r.homes.all, name) {
    Some(c) -> if c == r.component { None } else { Some(r.finished(c)) }
    None -> None
}

-- `name`'s reduced body under `key`: this component's, or, for a
-- monomorphic key, the finished component's that `name` is in.
fun reducedOf(r : Reducer, name : String, key : String) -> Option Core =
    if owned(r, name) { Map.get(r.reduced, key) } else {
        match Map.get(r.cache.reduced, key) {
            Some(found) -> Some(found)
            -- A monomorphic key is the name and a bar, and only those are
            -- published.
            None -> if String.byteLength(key) != String.byteLength(name) + 1 { None } else {
                match doneOf(r, name) {
                    Some(done) -> Map.get(done.reduced, key)
                    None -> None
                }
            }
        }
    }

fun constantOf(r : Reducer, name : String) -> Option CBind = match Map.get(r.homes.constant, name) {
    Some(c) -> Map.get(if c == r.component { r.constants } else { r.finished(c).constants }, name)
    None -> None
}

fun unwrittenOf(r : Reducer, name : String) -> Option Core = match Map.get(r.homes.unwritten, name) {
    Some(c) -> Map.get(if c == r.component { r.unwritten } else { r.finished(c).unwritten }, name)
    None -> None
}

-- `boot --timings`: how parallel `reduceProgram` could be. Off otherwise.
var measuring = False

fun measure(on : Bool) -> Unit {
    measuring = on
}

-- The reduction's dependency structure, timed: components are reduced callees
-- first, so a component can start once every component it calls is done, and
-- the most expensive chain of such dependencies bounds how far running
-- components in parallel could shorten the whole.
fun reportSchedule(graph : Map String (Set.Set String), components : Vec (Vec String),
                   costs : Array Duration) -> Unit {
    let componentOf = Map.new()
    for var c = 0; c < len(components); c = c + 1 {
        for name in components[c] { Map.put(componentOf, name, c) }
    }
    -- `components` lists callees first, so each one's dependencies are done.
    let finish = Array.filled(len(components), Duration.zero)
    var total = Duration.zero
    var critical = Duration.zero
    var largest = Duration.zero
    var largestAt = 0
    for var c = 0; c < len(components); c = c + 1 {
        var ready = Duration.zero
        for name in components[c] {
            for callee in Set.elements(Map.getOr(graph, name, Set.new())) {
                match Map.get(componentOf, callee) {
                    Some(d) -> if d != c && finish[d] > ready { ready = finish[d] }
                    None -> {}
                }
            }
        }
        finish[c] = ready + costs[c]
        total = total + costs[c]
        if finish[c] > critical { critical = finish[c] }
        if costs[c] > largest {
            largest = costs[c]
            largestAt = c
        }
    }
    let tenths = fun(d) {
        let n = Duration.toNanos(d) / 100000
        Int.toString(n / 10) + "." + Int.toString(n % 10) + "ms"
    }
    let _ = IO.writeText(IO.stderr(), "opt-schedule\tcomponents " + Int.toString(len(components))
              + "\ttotal " + tenths(total) + "\tcritical path " + tenths(critical)
              + "\tlargest component " + tenths(largest) + " ("
              + Int.toString(len(components[largestAt])) + " bindings, "
              + (if len(components) > 0 { components[largestAt][0] } else { "" }) + ")\n")
}

-- How many times `reduceProgram` has been called, which numbers its runs from 1.
var runs = 0

-- Every binding's body, reduced -- callees before their callers.
--
-- The order is not cosmetic. `bodyOf` reduces a callee the first time some call
-- site asks for it, and if that call site is itself inside a body being
-- reduced, the callee's traversal runs *nested inside* the caller's. On a
-- program with a deep call graph that makes the traversal's stack depth the
-- product of call-graph depth and term depth, which is what made this pass
-- unable to compile the bootstrap compiler at all.
--
-- Reducing in dependency order -- `Deps.sccs` already emits it -- means the
-- memo is warm before anyone asks, so `bodyOf` is a lookup and every traversal
-- is one term deep. Within a cycle there is no such order and the nesting can
-- still happen, but it is then bounded by the size of the component rather than
-- by the height of the whole graph.
--
-- A component waits only for the components it mentions, so components that do
-- not depend on each other are reduced at once, one per worker
-- (`Parallel.graphWith`). What makes that safe and the output the same however
-- they are scheduled: a component writes only its own `Done`, which nothing
-- reads until it has finished; it reads only finished components' and its
-- own; the answers a worker keeps across components are about finished
-- components, and so the same whoever asked first; and the binders it makes
-- are minted into an owner of its own (`mint`). One component is reduced by
-- one worker, in order, because within a cycle what is known depends on that
-- order.
--
-- Every local binder of the result has an id, and within one binding no two
-- binders share a spelling (`respell`).
fun reduceProgram(input : CProgram, decls : DeclTable, table : Binders.Table,
                  keepsCallSites : fun(String) -> Bool) -> CProgram {
    let program = adoptProgram(table, input)
    let binds = Vec.append(program.dicts, program.binds)
    let walked = Parallel.map(binds, walk)
    let graph = callGraph(binds, walked)
    runs = runs + 1
    -- The giblet check follows a call out of a giblet and names the line in
    -- each function along the way, so a binding reachable from one where
    -- positions are read needs its call sites as much as that one does.
    let wanted = Vec.filter(binds, \keepsCallSites(_.module_))
    let callSites = reachable(graph, Vec.map(wanted, _.name))
    let base = newReducer(program, decls, graph, walked, runs, table, callSites)
    let first = Map.new()
    for var i = 0; i < len(binds); i = i + 1 {
        if !Map.contains(first, binds[i].name) {
            Map.put(first, binds[i].name, i)
        }
    }
    let components = Deps.sccs(graph)
    for var c = 0; c < len(components); c = c + 1 {
        for name in components[c] { Map.put(base.homes.all, name, c) }
    }
    -- A lambda stays a lambda however it is reduced, so only a binding that
    -- is not one can come out atomic, and only a reference cell can be an
    -- unwritten `var`.
    for b in binds {
        match Map.get(base.homes.all, b.name) {
            Some(c) -> match b.value.kind {
                CLam(_, _, _) -> {}
                CRef(_) -> {
                    Map.put(base.homes.unwritten, b.name, c)
                    if !b.mutable { Map.put(base.homes.constant, b.name, c) }
                }
                _ -> if !b.mutable { Map.put(base.homes.constant, b.name, c) }
            }
            None -> {}
        }
    }
    -- A component waits for the components it mentions, and on as many
    -- workers as there are, runs alongside any it does not.
    let dependsOn = fun(c) {
        let on = Set.new()
        for name in components[c] {
            for callee in Set.elements(Map.getOr(graph, name, Set.new())) {
                match Map.get(base.homes.all, callee) {
                    Some(d) -> if d != c { Set.add(on, d) }
                    None -> {}
                }
            }
        }
        Array.sort(Set.elements(on))
    }
    -- Registered here, on one thread and in component order, because an
    -- owner's index is a count of the owners before it.
    let owners = Array.map(components, fun(names) {
        let module_ = match Map.get(first, names[0]) {
            Some(index) -> binds[index].module_
            None -> ""
        }
        Binders.owner(table, module_, names[0])
    })
    let restOwner = Binders.owner(table, "", "bindings of a name bound twice")
    let reduceComponent = fun(cache, c, finished) {
        let started = if measuring { Some(Stopwatch.start()) } else { None }
        let r = forComponent(base, c, owners[c], finished, cache)
        let values = []
        for name in components[c] {
            match Map.get(first, name) {
                Some(index) -> {
                    r.inlining.within = name
                    let value = expr(r, binds[index].value)
                    Vec.push(values, (index, value))
                    memoize(r, name, value)
                    if !binds[index].mutable && atomic(value) {
                        Map.put(r.constants, name, withValue(binds[index], value))
                    }
                    match value.kind {
                        CRef(initial) -> if atomic(initial) && !Set.contains(r.written, name) {
                            Map.put(r.unwritten, name, initial)
                        }
                        _ -> {}
                    }
                }
                None -> {}
            }
        }
        Done { values = values, reduced = r.reduced, constants = r.constants,
               unwritten = r.unwritten,
               cost = match started {
                   Some(s) -> Stopwatch.elapsed(s)
                   None -> Duration.zero
               } }
    }
    let made = Parallel.graphWith(len(components), dependsOn, newCache, reduceComponent)
    if measuring { reportSchedule(graph, components, Array.map(made, fun(d) = d.cost)) }
    let done = Map.new()
    for d in made {
        for (index, value) in d.values { Map.put(done, index, value) }
    }
    -- A name bound twice has one entry in the graph, so its later bindings are
    -- in no component, and are reduced last, with every component finished.
    let rest = forComponent(base, len(components), restOwner, fun(c) = made[c], newCache())
    for var i = 0; i < len(binds); i = i + 1 {
        if !Map.contains(done, i) {
            rest.inlining.within = binds[i].name
            Map.put(done, i, expr(rest, binds[i].value))
        }
    }
    let split = len(program.dicts)
    let dicts = Vec.new(split)
    for var i = 0; i < split; i = i + 1 {
        Vec.push(dicts, withValue(program.dicts[i], Map.getOr(done, i,
            program.dicts[i].value)))
    }
    let others = Vec.new(len(program.binds))
    for var i = 0; i < len(program.binds); i = i + 1 {
        Vec.push(others, withValue(program.binds[i], Map.getOr(done, split + i,
            program.binds[i].value)))
    }
    CProgram {
        dicts = Vec.fromArray(Parallel.map(dicts, respell)),
        binds = Vec.fromArray(Parallel.map(others, respell)),
    }
}

-- Record a top-level binding's reduced body for `bodyOf`.
--
-- Only the monomorphic ones: a binding with type binders is reduced again per
-- instantiation, under a key that names the type arguments, and the
-- uninstantiated body is not an answer to any of those.
fun memoize(r : Reducer, name : String, value : Core) -> Unit {
    let bind = match Map.get(r.bindings, name) {
        Some(b) -> b
        None -> return
    }
    if len(bind.binders) > 0 { return }
    match value.kind {
        CLam(_, body, _) ->
            if !Map.contains(r.reduced, name + "|") {
                Map.put(r.reduced, name + "|", body)
            }
        _ -> {}
    }
}

-- `e` with its subterms reduced, then reduced itself to a fixed point.
--
-- Bottom-up, so each rewrite sees children that are already as small as they
-- are going to get -- which is what lets one traversal do the work of running
-- three passes to a fixed point.
fun expr(r : Reducer, e : Core) -> Core {
    -- A rewrite's result is walked again below, and without this every
    -- subterm it kept would be reduced again at every rewrite above it.
    if e.settledIn == r.run { return e }
    let declined = r.inlining.declined
    var out = children(r, e)
    var settled = False
    while !settled {
        match step(r, out) {
            None -> { settled = True }
            -- And walk it again. A reduction does not only rewrite the node it
            -- fires on: substituting a continuation for a parameter puts a
            -- lambda where `bind`'s body had `f(x)`, and that beta redex is in
            -- a subterm this traversal has already been past.
            Some(made) -> { out = children(r, made) }
        }
    }
    -- `out` is new, from `children`, so nothing else holds it yet.
    if r.inlining.declined == declined { out.settledIn = r.run }
    out
}

fun children(r : Reducer, e : Core) -> Core =
    mkCore(e.ty, e.span, mapKind(e.kind, Mapper {
        expr = fun(x) = expr(r, x),
        type_ = fun(t) = t,
        bind = fun(b) = withValue(b, expr(r, b.value)),
    }))

-- One reduction at the root of `e`, or `None` if none applies.
--
-- Whatever it returns has reduced subterms: inlining and join specialization
-- reduce the bodies they bring in, and the remaining rules only rearrange terms
-- that came from here.
fun step(r : Reducer, e : Core) -> Option Core {
    match e.kind {
        CVar(_, _) -> return constant(r, e)
        -- A method read out of a known dictionary. Inlining makes these: a
        -- generic function's dictionary parameter becomes the dictionary its
        -- caller passed. With the method's own types when it has some, which is
        -- why the bare projection below it is left for this.
        CSlot(_, _) -> return Methods.knownField(r.dicts, e, [], e.ty)
        CTyApp(fn, own) -> return match fn.kind {
            CSlot(_, _) -> Methods.knownField(r.dicts, fn, own, e.ty)
            _ -> constant(r, e)
        }
        CApp(fn, _) -> return match fn.kind {
            CLam(_, _, _) -> beta(r, e)
            CSlot(_, _) -> knownLambda(r.decls, e)
            CProject(_, _) -> match knownLambda(r.decls, e) {
                Some(made) -> Some(made)
                None -> inline(r, e, inlineLimit)
            }
            _ -> inline(r, e, inlineLimit)
        }
        CMatch(_, _) -> {
            match knownConstructor(r, e) {
                Some(m) -> return Some(m)
                None -> {}
            }
            match inlineScrutinee(r, e) {
                Some(m) -> return Some(m)
                None -> {}
            }
            match floatLet(e) {
                Some(m) -> return Some(m)
                None -> {}
            }
            match fuseRecursiveJoinResult(r, e) {
                Some(m) -> return Some(m)
                None -> {}
            }
            match caseOfCase(r, e) {
                Some(m) -> return Some(m)
                None -> {}
            }
            return caseOfJoin(e)
        }
        CLet(_, _, _, _, _, _) -> {
            match deadLet(r.decls, e) {
                Some(m) -> return Some(m)
                None -> {}
            }
            match trivialLet(r, e) {
                Some(m) -> return Some(m)
                None -> {}
            }
            match letToMatch(e) {
                Some(m) -> return Some(m)
                None -> {}
            }
            match nameArguments(r, e) {
                Some(m) -> return Some(m)
                None -> {}
            }
            match knownLet(r, e) {
                Some(m) -> return Some(m)
                None -> {}
            }
            return floatLetThroughJoin(e)
        }
        CJoin(_, _, _, _, _, _) -> {
            match specializeJoin(r, e) {
                Some(m) -> return Some(m)
                None -> {}
            }
            return flattenJoin(r, e)
        }
        CIf(_, _, _) -> return knownCondition(r.decls, e)
        CDeref(target) -> return match target.kind {
            CVar(name, _) -> match unwrittenOf(r, name) {
                Some(initial) -> Some(mkCore(e.ty, e.span, initial.kind))
                None -> None
            }
            _ -> None
        }
        _ -> {}
    }
    None
}

-- The names `e` mentions anywhere other than as the reference a `!` reads:
-- an assignment's target, a reference passed as a value. A top-level `var`
-- no binding mentions so is never written.
fun mentionsInto(e : Core, out : Set.Set String) -> Unit = match e.kind {
    CVar(name, _) -> Set.add(out, name)
    CDeref(target) -> match target.kind {
        CVar(_, _) -> {}
        _ -> mentionsInto(target, out)
    }
    _ -> eachKid(e.kind, mentionsInto(_, out))
}

-- An `if` whose condition is a constructor of `Bool`: the arm it chooses,
-- with a missing `else` as the unit it answers. A top-level `let` of a
-- constant has been substituted by now (`constant`), so this is what removes
-- code behind a flag the program fixes at compile time.
fun knownCondition(d : DeclTable, e : Core) -> Option Core = match e.kind {
    CIf(cond, then, otherwise) -> match constructorName(d, cond) {
        Some(name) -> if name == P.boolTrue { Some(then) }
                      else if name == P.boolFalse { match otherwise {
                          Some(o) -> Some(o)
                          None -> Some(mkCore(e.ty, e.span, CUnit))
                      } }
                      else { None }
        None -> None
    }
    _ -> None
}

-- Returns a new binder, as its spelling and its id. The spelling is the same
-- for every binder made with `hint`; the id tells them apart.
fun fresh(r : Reducer, hint : String) -> (String, Int) {
    ("%" + hint, mint(r))
}

-- Returns the id of a new binder.
--
-- A component's reducer numbers its binders in an owner of its own, which
-- `reduceProgram` registered before any component started, and one worker
-- reduces the whole component in order. So the ids it mints are a function of
-- the component alone, whichever worker runs it and whatever else that worker
-- reduced first. A body `bodyOf` reduces is numbered from 0 in `scratch`
-- instead: such a body is cached on a worker, so the component that asks for
-- it first varies from run to run, and numbering it in that component's owner
-- would make the component's later ids vary too.
--
-- No id minted here is recorded in the table (`Binders.unrecorded`). Most are
-- copies, the self-compile makes millions, and nothing after this pass reads
-- their records: recording them doubled the compiler's peak heap.
fun mint(r : Reducer) -> Int {
    let m = r.minting
    if m.template {
        m.next = m.next + 1
        return Binders.unrecorded(m.scratch, m.next - 1)
    }
    m.count = m.count + 1
    Binders.unrecorded(m.owner, m.count - 1)
}

-- -- the reductions --------------------------------------------------------------------

-- A mention of an atomic top-level binding, replaced by its value.
--
-- A top-level binding is evaluated before `main`, but an atom does no work and
-- has one value, so reading the binding and writing the atom in its place are
-- indistinguishable. The replacement takes the mention's type rather than the
-- binding's: for a generic binding that is the instantiation, including one
-- the specialization cap left mentioning an enclosing type variable, which a
-- polymorphically recursive function does. An atom holds no type of its own
-- to substitute, so the node's type is the whole of the instantiation.
--
-- A generic binding is replaced only under its type application, since a
-- bare mention of one is the function position of that application.
fun constant(r : Reducer, e : Core) -> Option Core {
    let name = match stripTyApp(e).kind {
        CVar(n, _) -> n
        _ -> return None
    }
    let applied = match e.kind {
        CTyApp(_, _) -> True
        _ -> False
    }
    match constantOf(r, name) {
        Some(b) -> if applied == (len(b.binders) > 0) {
            Some(mkCore(e.ty, e.span, b.value.kind))
        } else { None }
        None -> None
    }
}

-- A call under a `match`, inlined on the larger budget.
--
-- `expr` works bottom-up, so by the time this `match` is reduced its scrutinee
-- has already been offered to `inline` and turned down on size. Being
-- scrutinised is the information that offer did not have.
fun inlineScrutinee(r : Reducer, e : Core) -> Option Core = match e.kind {
    CMatch(scrutinee, alts) -> match scrutinee.kind {
        CApp(_, _) -> match inline(r, scrutinee, scrutineeInlineLimit) {
            Some(made) -> Some(mkCore(e.ty, e.span, CMatch(made, alts)))
            None -> None
        }
        _ -> None
    }
    _ -> None
}

-- A saturated call to a small, known, non-loop-breaking binding.
fun inline(r : Reducer, e : Core, limit : Int) -> Option Core = match e.kind {
    CApp(fn, args) -> inlineApp(r, e, fn, args, limit)
    _ -> None
}

fun inlineApp(r : Reducer, e : Core, fn : Core, args : Array Core,
              limit : Int) -> Option Core {
    var name = ""
    var targs = None
    match fn.kind {
        CVar(n, _) -> { name = n }
        CTyApp(inner, ts) -> match inner.kind {
            CVar(n, _) -> {
                name = n
                targs = Some(ts)
            }
            _ -> return None
        }
        _ -> return None
    }
    if Set.contains(r.breakers, name) { return None }
    if Vec.contains(r.inlining.active, name) {
        r.inlining.declined = r.inlining.declined + 1
        return None
    }
    let bind = match Map.get(r.bindings, name) {
        Some(b) -> b
        None -> return None
    }
    var lam = bind.value
    var key = name + "|"
    match targs {
        None -> if len(bind.binders) > 0 { return None }
        Some(ts) -> {
            if len(bind.binders) == 0 || len(bind.binders) != len(ts) {
                return None
            }
            let mapping = Map.new()
            for var i = 0; i < len(ts); i = i + 1 {
                Map.put(mapping, bind.binders[i].id, ts[i])
            }
            lam = instantiateTypes(bind.value, mapping)
            key = name + "|" + String.join(Array.map(ts, Ty.typeKey), "|")
        }
    }
    let params = match lam.kind {
        CLam(ps, _, _) -> ps
        _ -> oops("an inlinable binding whose value is not a lambda")
    }
    if len(params) != len(args) { return None }
    -- The ceiling, asked of the body *as written*, before anything reduces it.
    -- Asking it only of the reduced body -- which is what this did -- means the
    -- reduction happens first and the answer is discarded, so a callee too
    -- large to inline is fully optimized at every call site that names it,
    -- nested inside that call site's own traversal.
    --
    -- `Turkey.Desugar#thread` is fifty nodes and sits in a twenty-one binding
    -- cycle with `#expr`, the desugarer's whole expression walker. Reducing
    -- `thread` reduced `expr` inside it, and then the stack. Nothing was gained
    -- -- `expr` is refused on size the moment the question is finally asked.
    --
    -- It is also the size question GHC asks: its unfolding guidance is computed
    -- from the term as written.
    if written(r, name) > speculativeInlineLimit { return None }
    -- A monomorphic callee is reduced in its own turn, and `reduceProgram`
    -- takes those turns in dependency order, so by the time a caller is reached
    -- every callee it can name is already in the memo. A cold one is therefore
    -- a binding in the caller's own cycle whose turn has not come -- and
    -- reducing it *here*, nested inside this traversal, is what the dependency
    -- order exists to avoid.
    --
    -- Declining costs the inlining of a cycle's members into each other before
    -- their turn, and keeps it after: the components come out of `Deps.sccs`
    -- sorted, so a member is inlined into every later member and into none of
    -- the earlier ones. That is the same arbitrary-but-stable choice the loop
    -- breaker already makes, and for the same reason.
    --
    -- Type instantiation is exempt: `reduceProgram` warms no key that names
    -- type arguments, so a cold one there means "not asked for yet" rather than
    -- "not its turn", and that nesting is bounded anyway.
    let known = reducedOf(r, name, key)
    match targs {
        None -> if Option.isNone(known) { return None }
        Some(_) -> {}
    }
    -- The *reduced* body drives the ordinary limit, not the written one. A
    -- small source body that expands to five hundred nodes is five hundred
    -- nodes at every call site.
    let body = match known {
        Some(found) -> found
        None -> bodyOf(r, name, key, lam)
    }
    -- Both questions are about the *callee's* body, which `bodyOf` has already
    -- computed once and shares with every call site. Asking them here, before
    -- anything is copied, is what keeps a body that can never be inlined from
    -- being copied and substituted at every site that mentions it -- which was,
    -- measurably, most of the work this pass did on a program the size of the
    -- bootstrap compiler.
    if movesOf(r, name, key, body) { return None }
    -- A body that is one primitive applied to operands is that primitive under
    -- a library name -- `Turkey.Array#move` is `Prim.arrayCopy` and
    -- nothing else -- and inlining it puts back exactly the application the
    -- caller would have held had it spelled the primitive. Admit it whatever
    -- the primitive costs. Held to the size limit, a bulk primitive's name
    -- would stay a call at every site and be specialized for every element type.
    if forwardsPrim(body) {
        return Some(applyParams(r, params, args, body, e.ty, placing(r, e.span)))
    }
    let size = sizeOf(r, name, key, body)
    if size > speculativeInlineLimit { return None }
    if r.inlining.speculating && size > limit {
        r.inlining.declined = r.inlining.declined + 1
        return None
    }
    -- A callee that always panics has no useful residual -- there is nothing
    -- for the caller to reduce against -- so copying in anything it carries
    -- lets the *failure* path decide what the success path costs.
    -- `Turkey.Array#outOfBounds` is the case that matters: every string
    -- in its message is allocated, so inlining the message put thirteen live
    -- pointers across allocations into a function that is otherwise two
    -- comparisons, and every in-range access paid for a root frame it could
    -- not use. Rust marks
    -- these paths `#[cold] #[inline(never)]` and GHC keeps bottoming
    -- expressions off the hot path with `exprIsBottom`.
    --
    -- Only when it carries something, though. `Control.Panic#error` is
    -- `Prim.error(message)` and nothing else, so inlining it costs the caller
    -- nothing -- and *not* inlining it would put a frame in every panic trace
    -- pointing at the standard library rather than at the code that failed.
    if endsOf(r, name, key, body) && size > bottomInlineLimit { return None }
    -- A copied callee body becomes part of this call site (`placing`).
    let made = applyParams(r, params, args, body, e.ty, placing(r, e.span))
    if size <= limit { return Some(made) }
    -- Restored to what it was, not to `False`. Speculation is meant not to
    -- nest -- the flag is the whole mechanism for that -- and clearing it on
    -- the way out of an inner speculation re-armed the outer one, so a chain of
    -- large calls could speculate at every level after all. That is unbounded
    -- rather than merely expensive: the traversal's depth grew with whatever
    -- stack it was given.
    let was = r.inlining.speculating
    r.inlining.speculating = True
    let residual = expr(r, made)
    r.inlining.speculating = was
    if sizeOf_(residual) <= limit { Some(residual) } else { None }
}

-- `size` of a reduced body, once per binding rather than per site.
-- `size` of a binding's body as written, once per binding.
--
-- Type instantiation copies a body without changing its shape, so this is asked
-- of the name rather than of the key: every specialization of `name` has the
-- same written size.
fun written(r : Reducer, name : String) -> Int = match Map.get(r.cache.wrote, name) {
    Some(found) -> found
    None -> {
        let bind = match Map.get(r.bindings, name) {
            Some(b) -> b
            None -> oops("no binding named '" + name + "'")
        }
        let body = match bind.value.kind {
            CLam(_, inner, _) -> inner
            _ -> bind.value
        }
        let found = sizeOf_(body)
        Map.put(r.cache.wrote, name, found)
        found
    }
}

fun sizeOf(r : Reducer, name : String, key : String, body : Core) -> Int {
    let sizes = if owned(r, name) { r.sizes } else { r.cache.sizes }
    match Map.get(sizes, key) {
        Some(found) -> found
        None -> {
            let made = sizeOf_(body)
            Map.put(sizes, key, made)
            made
        }
    }
}

-- `transfers` of a reduced body, once per binding rather than per site. Both
-- are answers about the callee, and the callee is shared.
fun movesOf(r : Reducer, name : String, key : String, body : Core) -> Bool {
    let moves = if owned(r, name) { r.moves } else { r.cache.moves }
    match Map.get(moves, key) {
        Some(found) -> found
        None -> {
            let made = transfers(body, Set.new())
            Map.put(moves, key, made)
            made
        }
    }
}

-- `bottoms` of a reduced body, on the same terms as the other two.
fun endsOf(r : Reducer, name : String, key : String, body : Core) -> Bool {
    let ends = if owned(r, name) { r.ends } else { r.cache.ends }
    match Map.get(ends, key) {
        Some(found) -> found
        None -> {
            let made = bottoms(body)
            Map.put(ends, key, made)
            made
        }
    }
}

-- A binding's reduced body, computed once.
--
-- The `active` guard cannot actually fire -- every cycle in the call graph
-- contains a loop breaker and a breaker is never inlined, so a chain of
-- expansions cannot come back to a name it is already inside. It is here so
-- that termination is a property of this function rather than of that argument.
--
-- It is reduced as if no speculation were under way, and the binders it makes
-- are numbered from 0 in `scratch`, so that the body is the same whichever
-- component asks for it first, on whichever worker: each worker reduces it
-- once. Those ids are not recorded and are shared by every such body, which
-- is sound because no such body reaches the output: `inlineApp` copies it into
-- each caller, and the copy gives every binder in it a fresh id.
fun bodyOf(r : Reducer, name : String, key : String, lam : Core) -> Core =
    match reducedOf(r, name, key) {
        Some(found) -> found
        None -> {
            let inner = match lam.kind {
                CLam(_, body, _) -> body
                _ -> oops("a callee whose value is not a lambda")
            }
            let m = r.minting
            let (template, next) = (m.template, m.next)
            let (speculating, within) = (r.inlining.speculating, r.inlining.within)
            m.template = True
            m.next = 0
            r.inlining.speculating = False
            r.inlining.within = name
            Vec.push(r.inlining.active, name)
            let made = expr(r, inner)
            discard(Vec.pop(r.inlining.active))
            m.template = template
            m.next = next
            r.inlining.speculating = speculating
            r.inlining.within = within
            Map.put(if owned(r, name) { r.reduced } else { r.cache.reduced }, key, made)
            made
        }
    }

-- Expose a lambda read out of a dictionary or a record built right there, to
-- beta. All sibling slots must be values: building the object evaluates them
-- before the call.
--
-- A build with identity qualifies too: the object is read once, right where
-- it is built, so nothing else can hold it.
fun knownLambda(d : DeclTable, e : Core) -> Option Core = match e.kind {
    CApp(fn, args) -> match fn.kind {
        CProject(target, index) -> applyPart(d, e, target, index, args)
        CSlot(target, index) -> applyPart(d, e, target, index, args)
        _ -> None
    }
    _ -> None
}

fun applyPart(d : DeclTable, e : Core, target : Core, index : Int,
              args : Array Core) -> Option Core {
    let parts = match target.kind {
        CDict(_, slots) -> slots
        CApp(con, fields) -> match con.kind {
            CCon(_) -> fields
            _ -> return None
        }
        _ -> return None
    }
    if index >= len(parts) { return None }
    for v in parts { if !isValue(d, v) { return None } }
    match parts[index].kind {
        CLam(_, _, _) -> Some(mkCore(e.ty, e.span, CApp(parts[index], args)))
        _ -> None
    }
}

-- A lambda applied directly. What inlining a call site leaves behind when the
-- callee's own body was itself a call.
fun beta(r : Reducer, e : Core) -> Option Core = match e.kind {
    CApp(fn, args) -> match fn.kind {
        CLam(params, body, _) ->
            if len(params) != len(args) || transfers(body, Set.new()) {
                None
            } else {
                Some(applyParams(r, params, args, body, e.ty, Moving))
            }
        _ -> None
    }
    _ -> None
}

-- A binding nothing reads, of a value, is not a binding.
--
-- Not swept in for tidiness: it is what the other three leave behind.
-- Devirtualization turns `d.mul(x, 10)` into `%inst.Mul.Int#mul(x, 10)` and
-- leaves the `let %d1.Mul` that fetched the dictionary standing. The value must
-- be a value -- a `let %seq = print(x)` reads nothing either, and dropping it
-- would drop the printing.
fun deadLet(d : DeclTable, e : Core) -> Option Core = match e.kind {
    CLet(_, id, _, value, body, binders) ->
        if !isValue(d, value) || len(binders) > 0 {
            None
        } else if mentions(body, id) {
            None
        } else {
            Some(body)
        }
    _ -> None
}

-- `match (let x = v in b) { alts }` is `let x = v in match b { alts }`.
--
-- Not a reduction in itself: it is what lets the other rules see. Every call
-- this pass inlines becomes a `let` chain around the body, so a scrutinee that
-- is morally `Some(5)` arrives as several bindings wrapped around it, and
-- case-of-known-constructor -- which looks only at the node in front of it --
-- would stop there.
fun floatLet(e : Core) -> Option Core = match e.kind {
    CMatch(scrutinee, alts) -> match scrutinee.kind {
        CLet(name, id, bound, value, body, binders) -> {
            if len(binders) > 0 { return None }
            let inner = mkCore(e.ty, e.span, CMatch(body, alts))
            Some(mkCore(e.ty, scrutinee.span,
                        CLet(name, id, bound, value, inner, [])))
        }
        _ -> None
    }
    _ -> None
}

-- `match (join j(p) = B in R) { alts }`, with the match moved into B.
--
-- What an inlined `Iterator.next` leaves behind. The callee's early `return`
-- became a join, so the constructor the caller wants to take apart is not the
-- scrutinee itself but the argument of a `jump` inside it, and `caseOfCase` --
-- which knows how to push a match into the arms of a `match` or an `if` -- does
-- not reach it.
--
-- Moving the match into the join's *body* puts it exactly one step from those
-- jumps, and `specializeJoin` closes the gap: it copies the body once per
-- constructor signature seen at a jump, and the copy is a match on a known
-- constructor, which `knownConstructor` deletes along with the allocation. This
-- is GHC's case-of-case over join points, and the reason it is one rule there
-- and two here is that this compiler's join specialization is a separate rule
-- already.
--
-- `R` must not fall through, or its own value would escape unmatched. That is
-- not a restriction in practice: a join stands where a `return` or a `?` was,
-- and control reaches its continuation by jumping.
--
-- And the join must not be recursive. `B` then holds jumps back to `j`, and
-- with `B` as the scrutinee of the moved match those jumps are no longer in
-- tail position: a self-jump would skip the match it now sits under, so the
-- rewrite is wrong and not merely unchecked. A loop's result reaches its
-- consumer through `fuseRecursiveJoinResult`, which moves the match to the
-- loop's exits instead; when that rule declines, this one must too.
fun caseOfJoin(e : Core) -> Option Core = match e.kind {
    CMatch(scrutinee, alts) -> match scrutinee.kind {
        CJoin(name, id, params, body, rest, recursive) -> {
            if recursive || fallsThrough(rest) { return None }
            Some(mkCore(e.ty, scrutinee.span, CJoin(
                name, id, params,
                mkCore(e.ty, e.span, CMatch(body, alts)),
                retype(rest, e.ty), recursive)))
        }
        _ -> None
    }
    _ -> None
}

-- `match (match S {...}) { alts }`, with the outer match pushed in.
--
-- The pass item 7 names as the one that actually erases `Flow`. A `?` builds a
-- `Flow` in one branch and scrutinises it downstream, and the two never meet
-- until the downstream match is moved next to the constructor -- at which point
-- case-of-known-constructor collapses both.
--
-- It is also the pass that duplicates continuations, which is why item 7
-- insists on join points *first*. `alts` goes into a `CJoin`, each branch that
-- does not reduce becomes a `jump` to it, and only the branches that genuinely
-- collapse carry a copy. Without the join, a chain of `?` over a
-- four-constructor `Flow` multiplies its continuation by four at every step.
--
-- Declined outright when no branch reduces: the join would then be pure
-- overhead, and this is not a rewrite worth doing for its own sake.
--
-- Each branch gets a copy of the alternatives of its own, and the join's body
-- keeps the originals.
fun caseOfCase(r : Reducer, e : Core) -> Option Core = match e.kind {
    CMatch(scrutinee, alts) -> caseOfCaseOn(r, e, scrutinee, alts)
    _ -> None
}

fun caseOfCaseOn(r : Reducer, e : Core, scrutinee : Core,
                 alts : Vec CAlt) -> Option Core {
    let branches = match scrutinee.kind {
        CMatch(_, inner) -> Array.map(inner, _.body)
        CIf(_, then, otherwise) -> match otherwise {
            Some(o) -> [then, o]
            None -> return None
        }
        _ -> return None
    }
    -- A branch holding a `return` is one whose value is not what the outer
    -- match will scrutinise. Item 7's last step is what makes this case
    -- ordinary; until then it is one to leave alone.
    if transfers(scrutinee, Set.new()) { return None }

    let (name, id) = fresh(r, "cc")
    let pushed = Vec.new(len(branches))
    var landed = False
    for branch in branches {
        let made = expr(r, mkCore(e.ty, e.span, CMatch(branch, copyAlts(r, alts))))
        if mentionsAlts(made, alts) {
            Vec.push(pushed, mkCore(TBottom, branch.span,
                                      CJump(name, id, [branch])))
        } else {
            Vec.push(pushed, made)
            landed = True
        }
    }
    if !landed { return None }

    let (cv, cvId) = fresh(r, "cv")
    let param = CParam { name = cv, id = cvId, ty = scrutinee.ty }
    let body = mkCore(e.ty, e.span, CMatch(
        mkCore(scrutinee.ty, e.span, CVar(param.name, param.id)), alts))
    let rest = match scrutinee.kind {
        CMatch(inner, innerAlts) -> {
            let made = Vec.new(len(innerAlts))
            for var i = 0; i < len(innerAlts); i = i + 1 {
                Vec.push(made, CAlt { alt = innerAlts[i].alt, body = pushed[i] })
            }
            mkCore(e.ty, scrutinee.span, CMatch(inner, made))
        }
        CIf(cond, _, _) ->
            mkCore(e.ty, scrutinee.span, CIf(cond, pushed[0], Some(pushed[1])))
        _ -> return None
    }
    -- Every branch reduced, so nothing jumps and the join is dead.
    if !jumpsTo(rest, id) { return Some(rest) }
    Some(mkCore(e.ty, e.span, CJoin(name, id, [param], body, rest, False)))
}

-- Push a recursive join's result consumer through its boundary.
--
-- A lifted loop commonly has this shape:
--
--     match (join rec loop() : Option (Flow ...) = body in jump loop()) { exits }
--
-- The loop breaker correctly prevents ordinary inlining from unfolding `loop`,
-- so the produced `Flow` cannot meet `exits` unless the consumer moves into the
-- loop. Change the join's answer type to the match's answer type and consume
-- both its body and its entry there. Self-jumps stay self-jumps, so recursion
-- is neither copied nor turned into host recursion; only the loop's actual
-- exits are rewritten.
--
-- A general worker/result-wrapper rule: it knows neither `Flow` nor `Option`
-- and is useful whenever a recursive join returns a value that is immediately
-- scrutinised. Each exit gets a copy of the alternatives of its own.
fun fuseRecursiveJoinResult(r : Reducer, e : Core) -> Option Core = match e.kind {
    CMatch(scrutinee, alts) -> match scrutinee.kind {
        CJoin(name, id, params, body, rest, recursive) -> if !recursive { None } else {
            Some(mkCore(e.ty, scrutinee.span, CJoin(
                name, id, params,
                expr(r, consumeTail(r, body, alts, e.ty, e.span)),
                expr(r, consumeTail(r, rest, alts, e.ty, e.span)),
                recursive)))
        }
        _ -> None
    }
    _ -> None
}

-- A binding of a name to a name is not a binding.
--
-- `let %k1 = x in let a = %k1 in ...` is what a `?` chain becomes once `bind`
-- is inlined and its continuation beta-reduced: three names for one value.
-- Substituting costs nothing -- reading a variable is free and may be done
-- twice or never -- and it is what puts the `if` that built the value next to
-- the `match` that scrutinises it.
--
-- Only names and literals, not every value: substituting a `CLam` would
-- duplicate its body at each mention, which is inlining and has a size limit
-- for a reason.
fun trivialLet(r : Reducer, e : Core) -> Option Core = match e.kind {
    CLet(_, id, _, value, body, binders) -> {
        if len(binders) > 0 { return None }
        match value.kind {
            CVar(_, _) -> {}
            CLit(_) -> {}
            CUnit -> {}
            CCon(_) -> {}
            _ -> return None
        }
        let mapping = Map.new()
        Map.put(mapping, id, value)
        Some(moved(r, body, mapping))
    }
    _ -> None
}

-- `let x = v in match x {...}` is `match v {...}`, when `x` is read only there.
--
-- The other half of putting a producer next to its consumer, and the one that
-- hands case-of-case something to work on.
fun letToMatch(e : Core) -> Option Core = match e.kind {
    CLet(_, id, _, value, body, binders) -> {
        if len(binders) > 0 { return None }
        match body.kind {
            CMatch(scrutinee, alts) -> {
                match scrutinee.kind {
                    CVar(_, n) -> if n != id { return None }
                    _ -> return None
                }
                for a in alts { if mentions(altBody(a), id) { return None } }
                Some(mkCore(body.ty, body.span, CMatch(value, alts)))
            }
            _ -> None
        }
    }
    _ -> None
}

-- Move a binding used only by a join's `rest` to that `rest`.
--
-- Inlined `bind` commonly leaves exactly this shape: the producer is an `if`,
-- its consumer is a `match`, and the continuation join introduced to keep
-- case-of-case from duplicating code sits between them. Moving the `let` across
-- a non-recursive join puts producer and consumer back together.
--
-- The value is not moved into the join body, and the rewrite is declined when
-- that body reads the binding. A recursive join is left alone: its rest is an
-- entry to a loop rather than merely the continuation beside this binding.
fun floatLetThroughJoin(e : Core) -> Option Core = match e.kind {
    CLet(name, id, bound, value, body, binders) -> match body.kind {
        CJoin(joinName, joinId, params, joinBody, joinRest, recursive) -> {
            if len(binders) > 0 || recursive { return None }
            if mentions(joinBody, id) { return None }
            let rest = mkCore(body.ty, e.span,
                              CLet(name, id, bound, value, joinRest, binders))
            Some(mkCore(e.ty, body.span,
                        CJoin(joinName, joinId, params, joinBody, rest, recursive)))
        }
        _ -> None
    }
    _ -> None
}

-- One specialized copy of a join, per constructor signature its jumps carry.
type Variant = Variant {
    -- Which argument positions arrive as a known constructor.
    known    : Array Bool,
    calls    : Vec Core,
    -- Filled in once the copy is built and found to be worth keeping, as its
    -- label's spelling and id.
    var made : Option (String, Int),
}

-- Carry known constructor tags across a non-recursive join.
--
-- A single-use join is beta-reduced: its body moves to the jump. For a shared
-- join, calls with the same constructor signature are redirected to one
-- specialized copy. Constructor fields, and arguments whose tag is unknown,
-- become parameters of that copy; rebuilding the known constructor in its body
-- lets the ordinary match rule select an arm.
--
-- This preserves the reason the join exists: a continuation is copied once per
-- useful tag, never once per incoming edge. Copies which do not shrink after
-- reduction, or remain over `joinSpecializeLimit`, are declined.
--
-- Replacements are keyed by a jump's signature rather than by the jump: which
-- replacement a jump gets is decided entirely by that signature, so the walk
-- that rewrites recomputes it and looks it up. A jump with no known constructor
-- anywhere cannot
-- collide with a group, because every group was founded by a jump that has one.
fun specializeJoin(r : Reducer, e : Core) -> Option Core = match e.kind {
    CJoin(name, id, params, body, rest, recursive) ->
        if recursive { None } else { specializeOn(r, e, name, id, params, body, rest) }
    _ -> None
}

fun specializeOn(r : Reducer, e : Core, name : String, id : Int, params : Array CParam,
                 body : Core, rest : Core) -> Option Core {
    -- Tried at every visit of every join, and usually no jump carries a known
    -- constructor: asking that first stops at the first one found, and the
    -- jumps are collected only when there is something to specialize. One
    -- walk answers both that and whether there is any jump at all; a second
    -- walk for the latter would cost more than collecting the jumps.
    var jumped = False
    let known = someJump(rest, id, fun(j) {
        jumped = True
        hasKnownArg(r.decls, j)
    })
    if !known { return if jumped { None } else { Some(rest) } }
    let jumps = joinJumps(rest, id)

    -- One jump: the body moves there, and nothing is copied.
    if len(jumps) == 1 {
        let args = jumpArgs(jumps[0])
        let made = expr(r, applyParams(r, params, args, body, e.ty, Moving))
        return Some(replaceJumps(rest, id, fun(_) = Some(made)))
    }

    let groups = Map.new()
    for j in jumps {
        if hasKnownArg(r.decls, j) {
            let key = signatureKey(r.decls, jumpArgs(j))
            match Map.get(groups, key) {
                Some(g) -> Vec.push(g.calls, j)
                None -> Map.put(groups, key, Variant {
                    known = Array.map(jumpArgs(j),
                                      isConstructor(r.decls, _)),
                    calls = [j], made = None,
                })
            }
        }
    }

    let variants = Vec.new(4)
    var replaced = 0
    for (_, group) in Map.entries(groups) {
        let first = jumpArgs(group.calls[0])
        let fresh_ = Vec.new(4)
        let templates = Vec.new(len(first))
        for var i = 0; i < len(first); i = i + 1 {
            let arg = first[i]
            if !group.known[i] {
                let (made, madeId) = fresh(r, "jv")
                Vec.push(fresh_, CParam { name = made, id = madeId, ty = params[i].ty })
                Vec.push(templates, mkCore(params[i].ty, arg.span, CVar(made, madeId)))
            } else {
                let vars = Array.map(constructorArgs(arg), fun(field) {
                    let (made, madeId) = fresh(r, "jf")
                    Vec.push(fresh_, CParam { name = made, id = madeId, ty = field.ty })
                    mkCore(field.ty, field.span, CVar(made, madeId))
                })
                Vec.push(templates, rebuildConstructor(arg, vars))
            }
        }
        let made = expr(r, applyParams(r, params, templates, body, e.ty, Copying))
        if sizeOf_(made) < sizeOf_(body) && sizeOf_(made) <= joinSpecializeLimit {
            let label = fresh(r, "js")
            group.made = Some(label)
            replaced = replaced + len(group.calls)
            Vec.push(variants, (label, Vec.toArray(fresh_), made))
        }
    }
    if len(variants) == 0 { return None }

    var out = replaceJumps(rest, id, specialized(r.decls, groups, _))
    if replaced != len(jumps) {
        out = mkCore(e.ty, e.span, CJoin(name, id, params, body, out, False))
    }
    for var i = len(variants) - 1; i >= 0; i = i - 1 {
        let ((label, labelId), ps, made) = variants[i]
        out = mkCore(e.ty, e.span, CJoin(label, labelId, ps, made, out, False))
    }
    Some(out)
}

-- The jump a specialized copy wants in place of this one, if its signature
-- founded a copy that was kept.
fun specialized(d : DeclTable, groups : Map String Variant, j : Core) -> Option Core {
    let args = jumpArgs(j)
    if !hasKnownArg(d, j) { return None }
    let group = match Map.get(groups, signatureKey(d, args)) {
        Some(g) -> g
        None -> return None
    }
    let label = match group.made {
        Some(made) -> made
        None -> return None
    }
    let (target, targetId) = label
    let out = Vec.new(len(args))
    for var i = 0; i < len(args); i = i + 1 {
        if group.known[i] {
            for field in constructorArgs(args[i]) { Vec.push(out, field) }
        } else {
            Vec.push(out, args[i])
        }
    }
    Some(mkCore(TBottom, j.span, CJump(target, targetId, out)))
}

-- A join parameter passed as its fields, where every jump builds it on the
-- spot.
--
-- `join j(t : (Char, Index)) = match t {..}`, reached only by `jump j((c, i))`,
-- builds the tuple at every jump and takes it apart again in the body, and
-- the backend keeps a tuple in memory even when it never escapes. When every
-- jump to `j` -- from `rest`, and from the body of a loop -- passes the same
-- constructor at a position, the jumps pass its fields there instead, and the
-- body rebinds the parameter to the constructor rebuilt from them, which
-- `letToMatch` and `knownLet` then take apart. MLton's `Flatten` does this for
-- a block whose tuple argument is available at every jump.
--
-- Nothing is copied, so unlike `specializeJoin` this needs no size bound. A
-- body that uses the parameter whole costs no more than before: it builds the
-- value once per entry, where every jump built one, and it is bound rather
-- than substituted, so two mentions still build it once. The fields are
-- evaluated where the constructor's arguments were, left to right among the
-- jump's other arguments, so nothing moves.
--
-- Only constructors `unfoldable` admits: one with a `var` field has identity,
-- and no `match` on it can be decided from its arguments, so splitting it
-- would gain nothing.
fun flattenJoin(r : Reducer, e : Core) -> Option Core = match e.kind {
    CJoin(name, id, params, body, rest, recursive) -> {
        let jumps = joinJumps(rest, id)
        if recursive { collectJumps(body, id, jumps) }
        if len(jumps) == 0 { return None }
        let first = jumpArgs(jumps[0])
        let flat = Vec.new(len(params))
        var found = False
        for var i = 0; i < len(params); i = i + 1 {
            let shape = shapeOf(r, first[i])
            var same = Option.isSome(shape)
            for j in jumps {
                if shapeOf(r, jumpArgs(j)[i]) != shape { same = False }
            }
            Vec.push(flat, same)
            found = found || same
        }
        if !found { return None }

        let ps = Vec.new(len(params))
        let lets = Vec.new(4)
        for var i = 0; i < len(params); i = i + 1 {
            if !flat[i] {
                Vec.push(ps, params[i])
            } else {
                let vars = Array.map(knownParts(first[i]), fun(field) {
                    let (v, vId) = fresh(r, "jf")
                    Vec.push(ps, CParam { name = v, id = vId, ty = field.ty })
                    mkCore(field.ty, field.span, CVar(v, vId))
                })
                Vec.push(lets, (params[i], rebuildKnown(first[i], vars)))
            }
        }
        let split = fun(j) = Some(mkCore(j.ty, j.span, CJump(name, id,
                                                            flatArgs(flat, j))))
        var made = if recursive { replaceJumps(body, id, split) } else { body }
        for var i = len(lets) - 1; i >= 0; i = i - 1 {
            let (p, value) = lets[i]
            made = mkCore(body.ty, value.span, CLet(p.name, p.id, p.ty, value, made, []))
        }
        Some(mkCore(e.ty, e.span, CJoin(name, id, Vec.toArray(ps), made,
                                        replaceJumps(rest, id, split),
                                        recursive)))
    }
    _ -> None
}

-- The constructor and arity `flattenJoin` needs every jump to agree on, or
-- `None` for an argument it cannot split.
fun shapeOf(r : Reducer, e : Core) -> Option String {
    if !unfoldable(r, e) { return None }
    let arity = Int.toString(len(knownParts(e)))
    match e.kind {
        CTuple(_) -> Some("()/" + arity)
        _ -> Option.map(constructorName(r.decls, e), _ + "/" + arity)
    }
}

-- A jump's arguments with the fields of each position `flat` marks in place
-- of the constructor.
fun flatArgs(flat : Vec Bool, j : Core) -> Vec Core {
    let args = jumpArgs(j)
    let out = Vec.new(len(args))
    for var i = 0; i < len(args); i = i + 1 {
        if flat[i] {
            for part in knownParts(args[i]) { Vec.push(out, part) }
        } else {
            Vec.push(out, args[i])
        }
    }
    out
}

-- A `match` on a constructor application, a tuple or a literal that is right
-- there.
--
-- Scanned in source order and stopped at the first arm that is not decided, so
-- an earlier arm that might have matched keeps this from firing. An arm tests
-- one level, so it is decided by the shape of the scrutinee alone.
--
-- The scrutinee need not be a value, but nothing it computes may be thrown
-- away. Selecting a branch discards the arms not taken -- which a `match` would
-- not have run anyway -- and it discards the constructor application itself,
-- which it *would* have. So every argument is bound, in order, including the
-- ones the arm ignores, under a name nothing reads. `Some(launch())` still
-- launches.
fun knownConstructor(r : Reducer, e : Core) -> Option Core = match e.kind {
    CMatch(scrutinee, alts) -> if isKnown(r.decls, scrutinee) {
        selectArm(r, e, scrutinee, scrutinee, alts)
    } else {
        None
    }
    _ -> None
}

-- Whether the shape of `e` can answer a pattern at its root.
fun isKnown(d : DeclTable, e : Core) -> Bool = match e.kind {
    CTuple(_) -> True
    CLit(_) -> True
    _ -> isConstructor(d, e)
}

-- `root` is what an arm that binds the whole scrutinee binds: the scrutinee
-- itself, or the name a `let` gave it, which must not be rebuilt.
fun selectArm(r : Reducer, e : Core, scrutinee : Core, root : Core,
              alts : Vec CAlt) -> Option Core {
    for alt in alts {
        let names = []
        let values = []
        match decide(r, alt.alt, scrutinee, root, names, values) {
            Fails -> {}
            Undecided -> return None
            Matches -> return Some(applyNames(r, names, values, alt.body, e.ty, Moving))
        }
    }
    None
}

-- `let x = C(e1, .., en) in body` with each argument that is not atomic named
-- first: `let t1 = e1 in .. let x = C(t1, .., tn) in body`.
--
-- What lets `knownLet` take `x` apart at a `match` further down: the
-- constructor's arguments are then names it can copy, where copying `e1` would
-- evaluate it twice. Only when `body` has a `match x` where `knownLet` looks,
-- so a binding nobody takes apart keeps its shape. The arguments are bound in
-- the order the constructor application evaluated them, before it, so nothing
-- moves.
fun nameArguments(r : Reducer, e : Core) -> Option Core = match e.kind {
    CLet(name, id, ty, value, body, binders) -> {
        if len(binders) > 0 || !unfoldable(r, value) { return None }
        let parts = knownParts(value)
        var plain = True
        for part in parts { if !isAtom(part) { plain = False } }
        if plain { return None }
        match onSpine(body, id, fun(m) = Some(m)) {
            None -> return None
            Some(_) -> {}
        }
        let names = []
        let atoms = Array.map(parts, fun(part) =
            if isAtom(part) {
                part
            } else {
                let (t, tId) = fresh(r, "arg")
                Vec.push(names, (t, tId, part))
                mkCore(part.ty, part.span, CVar(t, tId))
            })
        var out = mkCore(e.ty, e.span,
                         CLet(name, id, ty, rebuildKnown(value, atoms), body, binders))
        for var i = len(names) - 1; i >= 0; i = i - 1 {
            let (t, tId, part) = names[i]
            out = mkCore(e.ty, part.span, CLet(t, tId, part.ty, part, out, []))
        }
        Some(out)
    }
    _ -> None
}

-- `let x = C(a, b) in .. match x { .. } ..`, with the first `match x` on the
-- body's spine replaced by the arm the constructor selects.
--
-- GHC's case-of-known-constructor through an unfolding. The arguments are
-- atoms by now (`nameArguments`), so selecting an arm copies names, never
-- work; a variable pattern at the root binds `x` itself, so the constructor
-- is not built a second time.
--
-- Only on the spine -- `let` values and bodies, join bodies and continuations
-- -- and not in every subterm. This is tried at every `let`, and a `let` chain
-- is the whole of a function, so a walk of the body at each one is quadratic
-- in its length. The spine is where a producer and the `match` that consumes
-- it meet once calls are inlined.
fun knownLet(r : Reducer, e : Core) -> Option Core = match e.kind {
    CLet(name, id, ty, value, body, binders) -> {
        if len(binders) > 0 || !unfoldable(r, value) { return None }
        for part in knownParts(value) { if !isAtom(part) { return None } }
        let whole = mkCore(value.ty, value.span, CVar(name, id))
        let decided = onSpine(body, id, fun(m) = match m.kind {
            CMatch(_, alts) -> selectArm(r, m, value, whole, alts)
            _ -> None
        })
        match decided {
            Some(made) -> Some(mkCore(e.ty, e.span,
                                      CLet(name, id, ty, value, made, binders)))
            None -> None
        }
    }
    _ -> None
}

-- `e` with the first `match` of the binder `id` on its spine replaced by
-- what `decide` makes of it, or `None` if there is none or `decide` declines.
fun onSpine(e : Core, id : Int, decide : fun(Core) -> Option Core) -> Option Core =
    match e.kind {
    CMatch(scrutinee, _) -> match scrutinee.kind {
        CVar(_, n) -> if n == id { decide(e) } else { None }
        _ -> None
    }
    CLet(bound, boundId, ty, value, body, binders) -> {
        match onSpine(value, id, decide) {
            Some(made) -> return Some(mkCore(e.ty, e.span,
                                             CLet(bound, boundId, ty, made, body, binders)))
            None -> {}
        }
        match onSpine(body, id, decide) {
            Some(made) -> Some(mkCore(e.ty, e.span,
                                      CLet(bound, boundId, ty, value, made, binders)))
            None -> None
        }
    }
    CJoin(label, labelId, params, body, rest, recursive) -> {
        match onSpine(rest, id, decide) {
            Some(made) -> return Some(mkCore(e.ty, e.span,
                                             CJoin(label, labelId, params, body, made,
                                                   recursive)))
            None -> {}
        }
        match onSpine(body, id, decide) {
            Some(made) -> Some(mkCore(e.ty, e.span,
                                      CJoin(label, labelId, params, made, rest, recursive)))
            None -> None
        }
    }
    _ -> None
}

-- A constructor application or tuple whose `match` can be decided wherever
-- its name is read. Not a build with identity (`Decls.hasIdentity`): its
-- fields can be assigned, and a `match` after the assignment reads what it was
-- assigned.
fun unfoldable(r : Reducer, e : Core) -> Bool = match e.kind {
    CTuple(_) -> True
    _ -> match constructorName(r.decls, e) {
        Some(con) -> Option.isSome(Decls.con(r.decls, con))
        None -> False
    }
}

fun knownParts(e : Core) -> Array Core = match e.kind {
    CTuple(parts) -> parts
    _ -> constructorArgs(e)
}

fun rebuildKnown(e : Core, parts : Array Core) -> Core = match e.kind {
    CTuple(_) -> mkCore(e.ty, e.span, CTuple(parts))
    _ -> rebuildConstructor(e, parts)
}

-- Whether copying `e` copies no work and no allocation.
fun isAtom(e : Core) -> Bool = match e.kind {
    CVar(_, _) -> True
    CPrim(_) -> True
    CLit(_) -> True
    CUnit -> True
    CCon(_) -> True
    _ -> False
}


-- What an arm against a known scrutinee comes to.
type Decision = Matches | Fails | Undecided

-- Test `alt` against `known`, recording in `names` and `values` what it binds,
-- each part of `known` to the binder the arm gives it or to a name nothing
-- reads.
--
-- Selecting an opening arm would have to substitute the packed type for the
-- constants it opened, throughout its body. `Turkey.Layout` narrows that case
-- to the one layout instead.
fun decide(r : Reducer, alt : Alt, known : Core, root : Core,
           names : Vec (String, Int), values : Vec Core) -> Decision = match alt {
    AAny(binder) -> {
        Vec.push(names, nameOr(r, binder))
        Vec.push(values, root)
        Matches
    }
    ALit(lit) -> match known.kind {
        CLit(k) -> match sameLiteral(lit, k) {
            Some(True) -> {
                Vec.push(names, fresh(r, "seq"))
                Vec.push(values, known)
                Matches
            }
            Some(False) -> Fails
            None -> Undecided
        }
        _ -> Undecided
    }
    ATuple(binders) -> match known.kind {
        CTuple(parts) -> bindParts(r, binders, parts, names, values)
        _ -> Undecided
    }
    ACon(_, _, Some(_)) -> Undecided
    ACon(name, binders, None) -> match constructorName(r.decls, known) {
        Some(con) -> if con == name {
            bindParts(r, binders, constructorArgs(known), names, values)
        } else {
            Fails
        }
        None -> Undecided
    }
}

fun bindParts(r : Reducer, binders : Array (Option (String, Int)), parts : Array Core,
              names : Vec (String, Int), values : Vec Core) -> Decision {
    if len(binders) != len(parts) { return Undecided }
    for var i = 0; i < len(parts); i = i + 1 {
        Vec.push(names, nameOr(r, binders[i]))
        Vec.push(values, parts[i])
    }
    Matches
}

fun nameOr(r : Reducer, binder : Option (String, Int)) -> (String, Int) = match binder {
    Some(named) -> named
    None -> fresh(r, "seq")
}

-- Whether two literals are equal, when that is a question of their spelling.
-- Not for a float, whose equality is not its spelling's: `0.0` and `-0.0`.
fun sameLiteral(a : Lit, b : Lit) -> Option Bool = match (a, b) {
    (LInt(x), LInt(y)) -> Some(x == y)
    (LString(x), LString(y)) -> Some(x == y)
    (LChar(x), LChar(y)) -> Some(x == y)
    _ -> None
}

-- -- binding a call's arguments ---------------------------------------------------------

-- How `applyNames` places a body.
type Placing
    -- The body moves: the term it came from is gone, so its binders are bound
    -- nowhere else and keep their ids.
    = Moving
    -- The body is a second copy of a term that stays where it is, so every
    -- binder in it gets a fresh id.
    | Copying
    -- As `Copying`, for a callee's body inlined at a call with this span, which
    -- every node copied from the body takes.
    | Inlined(Option Span)

-- How a callee's body is placed at a call with `span`. Positions of inlined
-- code are read in two places: the giblet check, which names the line that
-- allocates in each function from a giblet on, and allocation counting by
-- site. So code inlined into a binding either one reads takes the call's span;
-- elsewhere the copy keeps the callee's own spans, which only an internal
-- error from a later Core check would show.
fun placing(r : Reducer, span : Option Span) -> Placing =
    if Set.contains(r.callSites, r.inlining.within) { Inlined(span) } else { Copying }

fun applyParams[Iterator p, Length p, Item p ~ CParam,
                Index c, Key c ~ Int, Value c ~ Core, Iterator c, Item c ~ Core](
        r : Reducer, params : p, args : c, body : Core, ty : Ty.Type,
        how : Placing) -> Core =
    applyNames(r, Array.map(params, fun(p) = (p.name, p.id)), args, body, ty, how)

-- `body` with each binder bound to its argument.
--
-- A value argument is substituted, because seeing through it is what lets the
-- next reduction fire, and each mention gets a copy of its own. Everything
-- else becomes a `CLet`, which is call by value written down.
--
-- The `let`s are sequential where a call is not: `let a = e1 in let b = e2`
-- puts `a` in scope for `e2`, where a call evaluates every argument in the
-- caller's scope. That is sound because no argument mentions a binder this
-- binds: an argument is the caller's term, and each of these binders is bound
-- only in the body, or, for a copy, is fresh.
fun applyNames[Iterator n, Length n, Item n ~ (String, Int),
               Index c, Key c ~ Int, Value c ~ Core, Iterator c, Item c ~ Core](
        r : Reducer, binders : n, args : c, body : Core, ty : Ty.Type,
        how : Placing) -> Core {
    let d = r.decls
    let names = Array.map(binders, fun((name, _)) = name)
    let ids = Array.map(binders, fun((_, id)) = id)
    let subst = Map.new()
    let renamed = Map.new()
    let lets = Vec.new(len(names))
    for var i = 0; i < len(names); i = i + 1 {
        if isValue(d, args[i]) {
            Map.put(subst, ids[i], args[i])
        } else {
            let bound = match how {
                Moving -> (names[i], ids[i])
                _ -> {
                    let made = (names[i], mint(r))
                    Map.put(renamed, ids[i], made)
                    made
                }
            }
            Vec.push(lets, (bound, args[i]))
        }
    }
    var out = match how {
        Moving -> if len(subst) == 0 { body } else { moved(r, body, subst) }
        Copying -> copyWith(fun() = mint(r), body, subst, renamed, True, None)
        Inlined(span) -> copyWith(fun() = mint(r), body, subst, renamed, True, Some(span))
    }
    for var i = len(lets) - 1; i >= 0; i = i - 1 {
        let ((name, id), arg) = lets[i]
        out = mkCore(ty, arg.span, CLet(name, id, arg.ty, arg, out, []))
    }
    out
}

-- Apply a result match at every yielding tail of `e`, each a copy of `alts`.
--
-- A jump is already an exit and must remain in tail position. The other cases
-- mirror `Turkey.Core.tailFieldNames` but are written out because their result
-- type also changes from the consumed value's type to `ty`.
fun consumeTail(r : Reducer, e : Core, alts : Vec CAlt, ty : Ty.Type,
                span : Option Span) -> Core = match e.kind {
    CJump(_, _, _) -> e
    CIf(cond, then, otherwise) -> {
        let inner = match otherwise {
            Some(o) -> o
            None -> mkCore(e.ty, e.span, CUnit)
        }
        mkCore(ty, e.span, CIf(cond, consumeTail(r, then, alts, ty, span),
                               Some(consumeTail(r, inner, alts, ty, span))))
    }
    CLet(name, id, bound, value, body, binders) ->
        mkCore(ty, e.span, CLet(name, id, bound, value,
                                consumeTail(r, body, alts, ty, span), binders))
    CLetRec(binds, body) ->
        mkCore(ty, e.span, CLetRec(binds, consumeTail(r, body, alts, ty, span)))
    CMatch(scrutinee, inner) ->
        mkCore(ty, e.span, CMatch(scrutinee, Vec.map(inner, fun(a) = CAlt {
            alt = a.alt, body = consumeTail(r, a.body, alts, ty, span),
        })))
    CJoin(name, id, params, body, rest, recursive) ->
        mkCore(ty, e.span, CJoin(name, id, params,
                                 consumeTail(r, body, alts, ty, span),
                                 consumeTail(r, rest, alts, ty, span), recursive))
    _ -> mkCore(ty, span, CMatch(e, copyAlts(r, alts)))
}

-- -- copying a term ----------------------------------------------------------------------

-- `value` with free type variables replaced by a call's type arguments.
--
-- The erased-language equivalent of beta-reducing a `CTyApp`. Deliberately
-- happy with non-ground arguments: unlike monomorphization it makes no
-- top-level copy and cannot chase polymorphic recursion, and a phantom variable
-- such as a lifted loop's uninhabited `Brk` slot is exactly the case that
-- brought this rule here.
--
-- A binder introduces a type variable rather than using one, so `mapKind`
-- leaves those alone; the types under them may still mention an outer variable
-- and are therefore walked normally.
fun instantiateTypes(e : Core, mapping : Map Int Ty.Type) -> Core =
    mkCore(substitute(e.ty, mapping), e.span, mapKind(e.kind, Mapper {
        expr = fun(x) = instantiateTypes(x, mapping),
        type_ = fun(t) = substitute(t, mapping),
        bind = fun(b) = CBind {
            name = b.name, id = b.id, ty = substitute(b.ty, mapping),
            binders = b.binders, value = instantiateTypes(b.value, mapping),
            span = b.span, mutable = b.mutable, module_ = b.module_,
            equations = Vec.map(b.equations, fun(pair) = {
                let (l, r) = pair
                (substitute(l, mapping), substitute(r, mapping))
            }),
            layouts = b.layouts,
        },
    }))

-- Returns a copy of `alts` in which every binder has a fresh id, for a rule
-- that puts them in more than one place.
fun copyAlts(r : Reducer, alts : Vec CAlt) -> Vec CAlt {
    let c = copier(fun() = mint(r), Map.new(), Map.new(), True, None)
    Vec.map(alts, fun(a) = CAlt { alt = bindAlt(c, a.alt), body = copyTerm(c, a.body) })
}

-- Returns `body` with each variable `subst` maps replaced by a copy of its
-- term, for a body that moves: its binders are bound nowhere else, so they
-- keep their ids.
fun moved(r : Reducer, body : Core, subst : Map Int Core) -> Core =
    copyWith(fun() = mint(r), body, subst, Map.new(), False, None)

type Copier = Copier {
    -- Returns the id of a fresh binder.
    mint : fun() -> Int,
    -- What each binder becomes, as its spelling and id, by its id: met by the
    -- copy, or given beforehand.
    renamed : Map Int (String, Int),
    subst : Map Int Core,
    -- Whether a binder not in `renamed` gets a fresh id.
    freshen : Bool,
    -- The span every node copied takes, if one does.
    rebase : Option (Option Span),
    -- How many variables `subst` has replaced so far.
    var substituted : Int,
    -- How many binders and references `renamed` has respelled or renumbered
    -- so far, with the variables replaced.
    var changed : Int,
}

fun copier(mint : fun() -> Int, subst : Map Int Core,
           renamed : Map Int (String, Int), freshen : Bool,
           rebase : Option (Option Span)) -> Copier = Copier {
    mint = mint, renamed = renamed, subst = subst, freshen = freshen,
    rebase = rebase, substituted = 0, changed = 0,
}

-- Returns `body` with each variable `subst` maps replaced by a copy of its own
-- of the term it maps to, and each binder renamed as `renamed` says. When
-- `freshen` holds, every other binder gets a fresh id from `mint`; when
-- `rebase` holds a span, every node copied from `body` takes it.
--
-- Every rule that puts a second copy of a term into the program makes it
-- here, which is what keeps each binder id bound once.
fun copyWith(mint : fun() -> Int, body : Core, subst : Map Int Core,
             renamed : Map Int (String, Int), freshen : Bool,
             rebase : Option (Option Span)) -> Core =
    copyTerm(copier(mint, subst, renamed, freshen, rebase), body)

fun copyTerm(c : Copier, e : Core) -> Core {
    -- A leaf that binds nothing and reads nothing renamed or replaced is
    -- shared as it is, unless its span is to change.
    if Option.isNone(c.rebase) {
        match e.kind {
            CLit(_) | CUnit | CCon(_) | CPrim(_) -> return e
            CVar(_, id) -> if !Map.contains(c.subst, id) && !Map.contains(c.renamed, id) {
                return e
            }
            _ -> {}
        }
    }
    let before = c.substituted
    let changedBefore = c.changed
    let kind = match e.kind {
        CVar(name, id) -> match Map.get(c.subst, id) {
            -- With the value's own spans, and binders of its own: a value is
            -- substituted at every mention.
            Some(value) -> {
                c.substituted = c.substituted + 1
                c.changed = c.changed + 1
                return copyWith(c.mint, value, Map.new(), Map.new(), True, None)
            }
            None -> {
                let (n, i) = referenceTo(c, name, id)
                CVar(n, i)
            }
        }
        CJump(name, id, args) -> {
            let (n, i) = referenceTo(c, name, id)
            CJump(n, i, Vec.map(args, copyTerm(c, _)))
        }
        CLam(params, body, label) -> {
            let ps = Array.map(params, bindParam(c, _))
            CLam(ps, copyTerm(c, body), label)
        }
        CLet(name, id, ty, value, body, binders) -> {
            let v = copyTerm(c, value)
            let (n, i) = bindName(c, name, id)
            CLet(n, i, ty, v, copyTerm(c, body), binders)
        }
        CLetRec(binds, body) -> {
            let named = Vec.map(binds, fun(b) = bindName(c, b.name, b.id))
            let made = Vec.new(len(binds))
            for var k = 0; k < len(binds); k = k + 1 {
                let CBind {
                    name = _, id = _, ty, binders, value, span, mutable, module_,
                    equations, layouts,
                } = binds[k]
                let (n, i) = named[k]
                Vec.push(made, CBind {
                    name = n, id = i, ty = ty, binders = binders,
                    value = copyTerm(c, value), span = span, mutable = mutable,
                    module_ = module_, equations = equations, layouts = layouts,
                })
            }
            CLetRec(made, copyTerm(c, body))
        }
        CJoin(name, id, params, body, rest, recursive) -> {
            let (n, i) = bindName(c, name, id)
            let ps = Array.map(params, bindParam(c, _))
            CJoin(n, i, ps, copyTerm(c, body), copyTerm(c, rest), recursive)
        }
        CMatch(scrutinee, alts) -> {
            let s = copyTerm(c, scrutinee)
            CMatch(s, Vec.map(alts, fun(a) = CAlt {
                alt = bindAlt(c, a.alt), body = copyTerm(c, a.body),
            }))
        }
        _ -> mapKind(e.kind, Mapper {
            expr = copyTerm(c, _),
            type_ = fun(t) = t,
            bind = fun(_) = oops("a binding outside a letrec reached copyTerm"),
        })
    }
    -- A subterm the walk changed nothing in -- one that binds nothing and
    -- reads nothing renamed or replaced -- is shared as it was, not rebuilt
    -- and still marked as settled. Sharing it is sound because only binders
    -- have to be unique, and it has none.
    if Option.isNone(c.rebase) && c.changed == changedBefore { return e }
    let span = match c.rebase {
        Some(s) -> s
        None -> e.span
    }
    let out = mkCore(e.ty, span, kind)
    -- No reduction reads a span or depends on which ids a term's binders
    -- have, so a copy of a settled term is settled too, and an inlined body is
    -- not reduced again at every call site. A substituted value can expose a
    -- reduction, so a node above one is not.
    if c.substituted == before { out.settledIn = e.settledIn }
    out
}

-- What the binder spelled `name` with the id `id` becomes in the copy.
fun bindName(c : Copier, name : String, id : Int) -> (String, Int) {
    match Map.get(c.renamed, id) {
        Some(made) -> {
            c.changed = c.changed + 1
            return made
        }
        None -> {}
    }
    if !c.freshen { return (name, id) }
    -- Under `noId`, every reference to a top-level binding without an id
    -- would be renamed to this binder.
    if id == noId { oops("the binder '" + name + "' has no id") }
    let made = (name, c.mint())
    Map.put(c.renamed, id, made)
    c.changed = c.changed + 1
    made
}

fun bindParam(c : Copier, p : CParam) -> CParam {
    let CParam { name, id, ty } = p
    let (n, i) = bindName(c, name, id)
    CParam { name = n, id = i, ty = ty }
}

fun referenceTo(c : Copier, name : String, id : Int) -> (String, Int) =
    match Map.get(c.renamed, id) {
        Some(made) -> {
            c.changed = c.changed + 1
            made
        }
        None -> (name, id)
    }

-- An existential's evidence keeps its spelling: it has no id, and is scoped
-- by spelling.
fun bindAlt(c : Copier, alt : Alt) -> Alt = match alt {
    ACon(con, fields, opening) -> ACon(con, Array.map(fields, bindPart(c, _)), opening)
    ATuple(fields) -> ATuple(Array.map(fields, bindPart(c, _)))
    ALit(_) -> alt
    AAny(binder) -> AAny(bindPart(c, binder))
}

fun bindPart(c : Copier, binder : Option (String, Int)) -> Option (String, Int) =
    match binder {
        Some((name, id)) -> Some(bindName(c, name, id))
        None -> None
    }

-- -- ids for every binder, and spellings that tell them apart --------------------------

-- `program` with an id on every local binder, and on every reference to one.
--
-- `Turkey.Lower` leaves dictionary parameters, an instance's parameters and a
-- few temporaries without one, found by their spelling, and `Turkey.Mono`
-- copies them as they are. Every reduction here keys a binder on its id, so
-- each is given one first. They are minted on this thread, in program order:
-- into the owner of the binding they are in, or, for a binding with no id,
-- into an owner registered for it. A reference with no id means the innermost
-- binder of its spelling, as `Turkey.Coretc` resolves one, or a top-level
-- binding if none is in scope. An existential's evidence keeps no id, since
-- `Alt` has nowhere to put one.
fun adoptProgram(table : Binders.Table, program : CProgram) -> CProgram = CProgram {
    dicts = Vec.map(program.dicts, adopt(table, _)),
    binds = Vec.map(program.binds, adopt(table, _)),
}

type Adopter = Adopter {
    table  : Binders.Table,
    bind   : CBind,
    -- Where this binding's new binders go; -1 until one needs it.
    var owner : Int,
    -- The binder each spelling means here, by id; `noId` for evidence.
    terms  : Map String Int,
    labels : Map String Int,
    -- How many binders and references the walk has given an id so far.
    var changed : Int,
}

fun adopt(table : Binders.Table, b : CBind) -> CBind = withValue(b, adoptTerm(Adopter {
    table = table, bind = b, owner = -1, terms = Map.new(), labels = Map.new(), changed = 0,
}, b.value))

-- `e` as `adoptProgram` leaves it: the term itself when it has no binder or
-- reference without an id, so that most of the program is not rebuilt.
fun adoptTerm(a : Adopter, e : Core) -> Core {
    let before = a.changed
    let made = mkCore(e.ty, e.span, adoptKind(a, e))
    if a.changed == before { e } else { made }
}

fun adoptKind(a : Adopter, e : Core) -> CoreKind = match e.kind {
    CVar(name, id) -> if id != noId { e.kind } else {
        CVar(name, adoptReference(a, a.terms, name))
    }
    CJump(name, id, args) -> CJump(name,
        if id != noId { id } else { adoptReference(a, a.labels, name) },
        Vec.map(args, adoptTerm(a, _)))
    CLam(params, body, label) -> {
        let ps = Array.map(params, fun(p) =
            CParam { name = p.name, id = adoptId(a, p.name, p.id), ty = p.ty })
        let saved = within(a.terms, Array.map(ps, fun(p) = (p.name, p.id)))
        let made = adoptTerm(a, body)
        restore(a.terms, saved)
        CLam(ps, made, label)
    }
    CLet(name, id, ty, value, body, binders) -> {
        let v = adoptTerm(a, value)
        let i = adoptId(a, name, id)
        let saved = within(a.terms, [(name, i)])
        let made = adoptTerm(a, body)
        restore(a.terms, saved)
        CLet(name, i, ty, v, made, binders)
    }
    CLetRec(binds, body) -> {
        let ids = Vec.map(binds, fun(b) = adoptId(a, b.name, b.id))
        let pairs = []
        for var k = 0; k < len(binds); k = k + 1 { Vec.push(pairs, (binds[k].name, ids[k])) }
        let saved = within(a.terms, pairs)
        let made = []
        for var k = 0; k < len(binds); k = k + 1 {
            let b = withValue(binds[k], adoptTerm(a, binds[k].value))
            b.id = ids[k]
            Vec.push(made, b)
        }
        let rest = adoptTerm(a, body)
        restore(a.terms, saved)
        CLetRec(made, rest)
    }
    -- The parameters scope over the body, and the label over the rest, and
    -- over the body too when the join is recursive.
    CJoin(name, id, params, body, rest, recursive) -> {
        let i = adoptId(a, name, id)
        let ps = Array.map(params, fun(p) =
            CParam { name = p.name, id = adoptId(a, p.name, p.id), ty = p.ty })
        let savedParams = within(a.terms, Array.map(ps, fun(p) = (p.name, p.id)))
        let savedLabel = within(a.labels, if recursive { [(name, i)] } else { [] })
        let madeBody = adoptTerm(a, body)
        restore(a.labels, savedLabel)
        restore(a.terms, savedParams)
        let savedRest = within(a.labels, [(name, i)])
        let madeRest = adoptTerm(a, rest)
        restore(a.labels, savedRest)
        CJoin(name, i, ps, madeBody, madeRest, recursive)
    }
    CMatch(scrutinee, alts) -> {
        let s = adoptTerm(a, scrutinee)
        CMatch(s, Vec.map(alts, fun(alt) {
            let made = adoptAlt(a, alt.alt)
            let saved = within(a.terms, scopedBy(made))
            let body = adoptTerm(a, alt.body)
            restore(a.terms, saved)
            CAlt { alt = made, body = body }
        }))
    }
    _ -> mapKind(e.kind, Mapper {
        expr = adoptTerm(a, _),
        type_ = fun(t) = t,
        bind = fun(_) = oops("a binding outside a letrec reached adoptTerm"),
    })
}

-- The id of the binder `name` means in `scope`, or `noId` for a top-level
-- binding.
fun adoptReference(a : Adopter, scope : Map String Int, name : String) -> Int {
    let id = Map.getOr(scope, name, noId)
    if id != noId { a.changed = a.changed + 1 }
    id
}

fun adoptId(a : Adopter, name : String, id : Int) -> Int {
    if id != noId { return id }
    a.changed = a.changed + 1
    if a.owner < 0 {
        a.owner = if a.bind.id != noId { Binders.ownerOf(a.bind.id) } else {
            Binders.owner(a.table, a.bind.module_, a.bind.name)
        }
    }
    Binders.fresh(a.table, a.owner, name, Binders.Local, Synthesized(None))
}

fun adoptAlt(a : Adopter, alt : Alt) -> Alt {
    let part = fun(binder) = match binder {
        Some((name, id)) -> Some((name, adoptId(a, name, id)))
        None -> None
    }
    match alt {
        ACon(con, fields, opening) -> ACon(con, Array.map(fields, part), opening)
        ATuple(fields) -> ATuple(Array.map(fields, part))
        ALit(_) -> alt
        AAny(binder) -> AAny(part(binder))
    }
}

-- What an arm binds over its body, as spellings and ids.
fun scopedBy(alt : Alt) -> Vec (String, Int) {
    let out = []
    let part = fun(binder) = match binder {
        Some(pair) -> Vec.push(out, pair)
        None -> {}
    }
    match alt {
        ACon(_, fields, opening) -> {
            if let Some(o) = opening {
                for d in o.evidence { Vec.push(out, (d, noId)) }
            }
            for f in fields { part(f) }
        }
        ATuple(fields) -> for f in fields { part(f) }
        ALit(_) -> {}
        AAny(binder) -> part(binder)
    }
    out
}

-- Puts each pair in `scope`, and returns what `restore` needs to undo it.
fun within[Iterator c, Item c ~ (String, Int)](scope : Map String Int, pairs : c)
        -> Vec (String, Option Int) {
    let saved = []
    for (name, id) in pairs {
        Vec.push(saved, (name, Map.get(scope, name)))
        Map.put(scope, name, id)
    }
    saved
}

fun restore(scope : Map String Int, saved : Vec (String, Option Int)) -> Unit {
    for var i = len(saved) - 1; i >= 0; i = i - 1 {
        let (name, was) = saved[i]
        match was {
            Some(id) -> Map.put(scope, name, id)
            None -> discard(Map.delete(scope, name))
        }
    }
}

-- `b` with its local binders respelled so that no two share a spelling.
--
-- The reductions key binders on ids and give a copy its original's spelling,
-- so two binders of one binding may share a spelling, and one may come to sit
-- under the other. `Turkey.SsaLower` and `Turkey.Layout` find a binder by its
-- spelling, and so does `Turkey.Coretc`'s check that a reference's spelling
-- and id agree: to them the inner binder would capture a reference to the
-- outer. So the first binder of each spelling keeps it, and each later one
-- gets the spelling with `~` and a number, which nothing else in the binding
-- is spelled. A dump prints a spelling without that suffix
-- (`Turkey.Core.baseName`), and tells the binders apart by id.
fun respell(b : CBind) -> CBind {
    let spellings = Set.new()
    let bound = Map.new()
    let order = []
    spellingsIn(b.value, spellings, bound, order)
    let renamed = Map.new()
    for name in order {
        let ids = Map.getOr(bound, name, [])
        var k = 1
        for var i = 1; i < len(ids); i = i + 1 {
            var made = name
            while Set.contains(spellings, made) {
                k = k + 1
                made = name + "~" + Int.toString(k)
            }
            Set.add(spellings, made)
            Map.put(renamed, ids[i], (made, ids[i]))
        }
    }
    if len(renamed) == 0 { return b }
    withValue(b, copyWith(fun() = oops("respell mints nothing"), b.value, Map.new(),
                          renamed, False, None))
}

-- Adds to `spellings` every spelling `e` binds or reads, and to `bound` the
-- ids bound under each spelling, in the order the walk meets them. `order`
-- gets each bound spelling once, in the order it is first bound.
fun spellingsIn(e : Core, spellings : Set.Set String, bound : Map String (Vec Int),
                order : Vec String) -> Unit {
    let binder = fun(name, id) {
        Set.add(spellings, name)
        if id != noId {
            match Map.get(bound, name) {
                Some(ids) -> Vec.push(ids, id)
                None -> {
                    Map.put(bound, name, [id])
                    Vec.push(order, name)
                }
            }
        }
    }
    match e.kind {
        CVar(name, _) -> Set.add(spellings, name)
        CJump(name, _, _) -> Set.add(spellings, name)
        CLam(params, _, _) -> for p in params { binder(p.name, p.id) }
        CLet(name, id, _, _, _, _) -> binder(name, id)
        CLetRec(binds, _) -> for b in binds { binder(b.name, b.id) }
        CJoin(name, id, params, _, _, _) -> {
            binder(name, id)
            for p in params { binder(p.name, p.id) }
        }
        CMatch(_, alts) -> for a in alts {
            for (name, id) in scopedBy(a.alt) { binder(name, id) }
        }
        _ -> {}
    }
    eachKid(e.kind, spellingsIn(_, spellings, bound, order))
}

-- -- small questions about terms ------------------------------------------------------

-- Whether evaluating `e` does no work and can be done twice or never.
--
-- A `CVar` counts: variables are immutable bindings, and a `var` is a `CRef`
-- read through a `CDeref`, which is not this. A build with identity
-- (`Decls.hasIdentity`) does not: done twice, it is two objects.
fun isValue(d : DeclTable, e : Core) -> Bool = match e.kind {
    CLit(_) -> True
    CUnit -> True
    CVar(_, _) -> True
    CCon(_) -> True
    CPrim(_) -> True
    CLam(_, _, _) -> True
    CTuple(elems) -> {
        for x in elems { if !isValue(d, x) { return False } }
        True
    }
    CApp(fn, args) -> match fn.kind {
        CCon(name) -> {
            if Decls.hasIdentity(d, name) { return False }
            for a in args { if !isValue(d, a) { return False } }
            True
        }
        _ -> False
    }
    _ -> False
}

-- Whether `e` can stand for a top-level binding at every mention of it.
--
-- A literal, `()`, or a constructor not applied to anything. Each is a value
-- that evaluates to the same thing everywhere and allocates nothing: a string
-- literal is static data. Not a constructor *application*, even of atoms:
-- `Some(1)` allocates at each mention where the binding allocated once, and
-- without constants in static data that is a cost, not a saving. Not a record
-- or an array, which are mutable, so that two copies are two objects.
fun atomic(e : Core) -> Bool = match e.kind {
    CLit(_) -> True
    CUnit -> True
    CCon(_) -> True
    _ -> False
}

-- Roughly the code `e` becomes, for the inliner to spend a budget of.
--
-- Counting every node as one is what this did, and it charges for a great deal
-- that is not code. `Main#inc` in the brainfuck benchmark -- one array element
-- read, incremented and written back -- measured 98 against a budget of 40 and
-- so stayed a call, while the loop that called it three times a cycle paid a
-- frame, a spill set and a panic-flag test for each. Most of those 98 nodes
-- were names: `match xs { Data.Vec#Vec(value) -> value }` appeared four
-- times, which is a single-constructor unpack and lowers to one load, and the
-- `let`s naming each intermediate lower to nothing at all, the backend being in
-- SSA already.
--
-- So: a variable, a primitive, a literal and a nullary constructor are
-- operands and cost nothing; a type application is erased; a `let` is a name for a value, and
-- costs what it names. A match with one alternative is a projection -- the
-- backend does not even test the tag -- while one with several costs a branch
-- each. This is GHC's `sizeExpr`, which is free for variables, literals, types
-- and coercions and charges per case alternative, and it is the same reasoning
-- as the discounts already here: the budget should track what a call site
-- actually grows by.
fun sizeOf_(e : Core) -> Int = match e.kind {
    CVar(_, _) -> 0
    CPrim(_) -> 0
    CLit(_) -> 0
    CUnit -> 0
    CCon(_) -> 0
    CTyApp(fn, _) -> sizeOf_(fn)
    CLet(_, _, _, value, body, _) -> sizeOf_(value) + sizeOf_(body)
    CLam(_, body, _) -> sizeOf_(body)
    CJoin(_, _, _, body, rest, _) -> sizeOf_(body) + sizeOf_(rest)
    CMatch(scrutinee, alts) -> {
        var total = if len(alts) <= 1 { 0 } else { len(alts) }
        total = total + sizeOf_(scrutinee)
        for a in alts { total = total + sizeOf_(a.body) }
        total
    }
    -- A `letrec` member costs what its value costs, which is what the
    -- recursion over `eachKid` already does: the wrapper itself is not code.
    _ -> {
        var total = 1 + expansion(e)
        eachKid(e.kind, fun(child) { total = total + sizeOf_(child) })
        total
    }
}

-- What a primitive application grows into beyond one instruction. The runs
-- of elements and bytes are one application here and several loops once
-- lowered (`Turkey.Bulk`): counted as one, they made every function holding
-- one look free to inline, and `String` concatenation, inlined at each `+`,
-- grew the compiler by two thirds.
fun expansion(e : Core) -> Int = match e.kind {
    CApp(fn, _) -> match stripTyApp(fn).kind {
        CPrim(p) -> match p {
            Prims.ArrayCopy | Prims.ArrayCopyIn | Prims.ArrayFill | Prims.CopyBytes
                | Prims.FillBytes -> bulkSize
            _ -> 0
        }
        _ -> 0
    }
    _ -> 0
}

-- Whether `body` is one primitive applied to variables and literals, and
-- nothing else.
fun forwardsPrim(body : Core) -> Bool = match body.kind {
    CApp(fn, args) -> match stripTyApp(fn).kind {
        CPrim(_) -> Iterator.all(args, fun(a) = match a.kind {
            CVar(_, _) | CLit(_) | CUnit -> True
            _ -> False
        })
        _ -> False
    }
    _ -> False
}

-- Twice the ordinary budget, so that a body with one run is inlined only
-- where a larger budget applies, and one with two is never inlined.
let bulkSize = inlineLimit * 2

-- Whether evaluating `e` always diverges.
--
-- GHC's `exprIsBottom`, cut down to the one producer this compiler has:
-- `Prim.error`. Conservative in the direction of answering false, which costs
-- an inline allowed rather than a term moved wrongly.
fun bottoms(e : Core) -> Bool = match e.kind {
    CApp(fn, _) -> match stripTyApp(fn).kind {
        CPrim(Prims.Error) -> True
        _ -> False
    }
    CLet(_, _, _, _, body, _) -> bottoms(body)
    CJoin(_, _, _, _, rest, _) -> bottoms(rest)
    CMatch(_, alts) -> {
        if len(alts) == 0 { return False }
        for a in alts { if !bottoms(a.body) { return False } }
        True
    }
    CIf(_, then, otherwise) -> match otherwise {
        Some(o) -> bottoms(then) && bottoms(o)
        None -> False
    }
    _ -> False
}

fun stripTyApp(e : Core) -> Core = match e.kind {
    CTyApp(fn, _) -> stripTyApp(fn)
    _ -> e
}

-- Whether `e` can produce a value of its own rather than jumping away.
--
-- A join's type is the type of its result, which says nothing about where that
-- result comes from: the `if` an inlined `return` leaves behind is typed
-- `Option a` while both its branches are jumps, so nothing ever reaches the
-- expression after it. `caseOfJoin` needs that distinction, and only the syntax
-- has it.
--
-- Conservative in the direction of answering true: an unrecognised term is
-- assumed to fall through, which costs a rewrite declined rather than a value
-- dropped.
fun fallsThrough(e : Core) -> Bool = match e.kind {
    CJump(_, _, _) -> False
    CLet(_, _, _, _, body, _) -> fallsThrough(body)
    CJoin(_, _, _, body, rest, _) -> fallsThrough(body) || fallsThrough(rest)
    CMatch(_, alts) -> {
        for a in alts { if fallsThrough(a.body) { return True } }
        False
    }
    CIf(_, then, otherwise) -> match otherwise {
        Some(o) -> fallsThrough(then) || fallsThrough(o)
        None -> True
    }
    _ -> True
}

-- `e`, with the result type of every tail position replaced.
--
-- Only ever called where `fallsThrough(e)` is false, and that is what makes it
-- sound: nothing here can produce a value, so the type each of these nodes
-- carries is a label on a result that never happens. Because `fallsThrough`
-- decides a join by *both* its body and its rest, and a match by all of its
-- arms, the recursion below reaches exactly the terms that inherited the
-- phantom type and stops at the jumps that gave it away.
fun retype(e : Core, ty : Ty.Type) -> Core = match e.kind {
    CLet(name, id, bound, value, body, binders) ->
        mkCore(ty, e.span, CLet(name, id, bound, value, retype(body, ty), binders))
    CJoin(name, id, params, body, rest, recursive) ->
        mkCore(ty, e.span, CJoin(name, id, params, retype(body, ty),
                                 retype(rest, ty), recursive))
    CMatch(scrutinee, alts) ->
        mkCore(ty, e.span, CMatch(scrutinee, Vec.map(alts, fun(a) = CAlt {
            alt = a.alt, body = retype(a.body, ty),
        })))
    CIf(cond, then, otherwise) -> match otherwise {
        Some(o) -> mkCore(ty, e.span, CIf(cond, retype(then, ty),
                                          Some(retype(o, ty))))
        None -> e
    }
    _ -> e
}

-- Whether the alternatives `alts` are still being matched on inside `e`:
-- whether *this* match survived the reduction, which is exactly the question
-- "did pushing it into the branch buy anything".
--
-- **Constant, and deliberately so.** Asking it by the identity of the
-- alternative list answers false every time: `expr` rebuilds every node it
-- touches, the list included, before any rule fires, so the list the caller
-- named is gone by the time the reduction being asked about has happened, and
-- no rule reuses it.
--
-- Carrying the *patterns*' identity instead would make it fire -- a pattern is
-- the one part of an alternative that survives a rebuild, here and in
-- `Turkey.Core.mapKind` alike -- and that was tried on both sides and reverted.
-- It costs optimization rather than buying protection: a branch whose pushed-in
-- match has not collapsed *yet* becomes a jump carrying the whole unreduced
-- branch, and the join specialization downstream can no longer find a
-- constructor tag to split on. What the guard should key on is open; that this
-- spelling of it has never fired is not.
fun mentionsAlts(e : Core, alts : Vec CAlt) -> Bool = False

-- Whether `e` contains a jump that leaves it.
--
-- A term is movable when everything it transfers to travels with it. A jump
-- names its target, so the question is whether the name is bound inside `e`. A
-- function whose body holds a `return` carries its own `%ret` join *inside* its
-- lambda, so the whole body is self-contained and this answers false where a
-- position-named transfer would have answered true -- which is the reduction
-- the join points were for.
--
-- A jump under a nested `CLam` cannot exist: a lambda body is out of tail
-- position and the checker gives it an empty join scope. So a lambda is not
-- descended into, and a `CJoin` extends the bound set for its `rest` always and
-- for its own `body` only when it says it is recursive, exactly as the checker
-- does.
fun transfers(e : Core, bound : Set.Set Int) -> Bool = match e.kind {
    CJump(_, id, _) -> !Set.contains(bound, id)
    CLam(_, _, _) -> False
    -- No label is bound twice, so the walk shares one set: a label added here
    -- is never one a jump outside this join names.
    CJoin(_, id, _, body, rest, recursive) -> {
        if recursive { Set.add(bound, id) }
        if transfers(body, bound) { return True }
        Set.add(bound, id)
        transfers(rest, bound)
    }
    _ -> anyKid(e.kind, transfers(_, bound))
}

-- `e` read as a saturated constructor application, whose value is its
-- constructor and fields and nothing else. Not a build with identity
-- (`Decls.hasIdentity`): rebuilding one from its fields, or reading a field
-- off the build rather than off the object, would answer for a different
-- object than the program holds.
fun constructorName(d : DeclTable, e : Core) -> Option String {
    let name = match e.kind {
        CCon(name) -> name
        CApp(fn, _) -> match fn.kind {
            CCon(name) -> name
            _ -> return None
        }
        _ -> return None
    }
    if Decls.hasIdentity(d, name) { None } else { Some(name) }
}

fun constructorArgs(e : Core) -> Array Core = match e.kind {
    CApp(fn, args) -> match fn.kind {
        CCon(_) -> args
        _ -> []
    }
    _ -> []
}

fun isConstructor(d : DeclTable, e : Core) -> Bool = match constructorName(d, e) {
    Some(_) -> True
    None -> False
}

-- A constructor shaped like `e`, with `args` as its fields.
fun rebuildConstructor(e : Core, args : Array Core) -> Core = match e.kind {
    CCon(_) -> e
    CApp(fn, _) -> mkCore(e.ty, e.span, CApp(fn, args))
    _ -> oops("not a constructor application")
}

fun hasKnownArg(d : DeclTable, j : Core) -> Bool {
    for a in jumpArgs(j) { if isConstructor(d, a) { return True } }
    False
}

fun jumpArgs(j : Core) -> Vec Core = match j.kind {
    CJump(_, _, args) -> args
    _ -> oops("not a jump")
}

-- What groups two jumps into one specialized copy: the constructor at each
-- position, with its arity, or nothing where the tag is unknown.
fun signatureKey(d : DeclTable, args : Vec Core) -> String {
    let parts = Array.map(args, fun(a) = match constructorName(d, a) {
        Some(con) -> con + "/" + Int.toString(len(constructorArgs(a)))
        None -> "*"
    })
    String.join(parts, ",")
}

-- The jumps in `e` to the join `id`.
fun joinJumps(e : Core, id : Int) -> Vec Core {
    let out = Vec.new(4)
    collectJumps(e, id, out)
    out
}

fun collectJumps(e : Core, id : Int, out : Vec Core) -> Unit = match e.kind {
    CJump(_, target, args) -> {
        if target == id { Vec.push(out, e) }
        for a in args { collectJumps(a, id, out) }
    }
    _ -> eachKid(e.kind, collectJumps(_, id, out))
}

-- Whether one of the jumps `joinJumps` would have found satisfies `p`,
-- stopping at the first that does.
fun someJump(e : Core, id : Int, p : fun(Core) -> Bool) -> Bool = match e.kind {
    CJump(_, target, args) -> (target == id && p(e)) || anyOf(args, someJump(_, id, p))
    _ -> anyKid(e.kind, someJump(_, id, p))
}

-- Rewrite the jumps `joinJumps` would have found, where `chosen` has something
-- to say about one. A replaced jump's arguments are not descended into: the
-- replacement is the whole answer for that jump, and walking into what it
-- replaced would rewrite the same arguments twice.
fun replaceJumps(e : Core, id : Int, chosen : fun(Core) -> Option Core) -> Core =
    match e.kind {
    CJump(target, targetId, args) -> {
        if targetId == id {
            match chosen(e) {
                Some(made) -> return made
                None -> {}
            }
        }
        mkCore(e.ty, e.span, CJump(target, targetId, Vec.map(args, fun(a) =
            replaceJumps(a, id, chosen))))
    }
    _ -> mkCore(e.ty, e.span, mapKind(e.kind, Mapper {
        expr = fun(x) = replaceJumps(x, id, chosen),
        type_ = fun(t) = t,
        bind = fun(b) = withValue(b, replaceJumps(b.value, id, chosen)),
    }))
}

fun jumpsTo(e : Core, id : Int) -> Bool {
    match e.kind {
        CJump(_, target, _) -> if target == id { return True }
        _ -> {}
    }
    anyKid(e.kind, jumpsTo(_, id))
}

fun oops(message : String) -> a =
    Diag.fail(Diag.whole("internal error", message), "")

fun discard(x : a) -> Unit = {}
