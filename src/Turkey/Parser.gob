export (parse, collectTycons)

--- Recursive descent.
---
--- Three decisions shape the whole file. Types and expressions have separate
--- entry points, which is what tells `fun(Int) -> Int` from `fun(x) -> Int = e`.
--- `noRecord` is set while reading the scrutinee of `if`/`while`/`match` and the
--- iterable of `for ... in`, so `if Foo { ... }` is a condition and a block
--- rather than a record construction. And a type declaration is classified
--- against the type constructor names a pre-pass collected, so a type may
--- mention one declared later in the file.
---
--- **Nothing here backtracks.** There are no exceptions to catch, so a
--- speculative parse could not be undone even if one were attempted. Where two
--- readings are possible -- a method signature against a method with a body, the
--- `for ... in` form against the C-style header -- a token scan looks ahead for
--- the one thing that tells them apart, and only then is either parsed. Keep new
--- ambiguities to that shape: a scan decides by looking, where a speculative
--- parse would have to decide by failing.

import Turkey.Ast (..)
import Turkey.Diag as Diag
import Turkey.Fixity as Fixity
import Turkey.Lexer as Lexer
import Turkey.Source as Source
import Turkey.Source (Source(..), Span)
import Turkey.Token as Token
import Turkey.Token (Comment, Kind(..), Token(..), Value(..))

type P = P {
    toks         : Vec Token,
    var i        : Int,
    tycons       : Vec String,
    var noRecord : Bool,
    file         : String,
    -- How many `\` functions enclose the current position. Inside one, every
    -- `_` is its parameter and no boundary closes a `_` function.
    var explicit : Int,
    -- How many `_` placeholders have been read and not yet made into a
    -- parameter. Zero is the common case, and it lets a boundary skip the walk.
    var pending  : Int,
    -- See `Program.letElses`.
    letElses     : Vec LetElse,
    comments     : Vec Comment,
    blankLines   : Vec Int,
}

fun parse(source : Source, known : Vec String) -> Program {
    let lexed = Lexer.tokenize(source)
    let toks = lexed.tokens
    let p = P {
        toks = toks,
        i = 0,
        tycons = Vec.append(collectTycons(toks), known),
        noRecord = False,
        file = source.name,
        explicit = 0,
        pending = 0,
        letElses = [],
        comments = lexed.comments,
        blankLines = lexed.blankLines,
    }
    parseProgram(p)
}

--- The pre-pass: every `type CONID` name declared in this file, so that a
--- declaration can mention a type constructor declared after it.
fun collectTycons(toks : Vec Token) -> Vec String {
    let names = Vec.fromArray(knownTycons)
    for var i = 0; i + 1 < len(toks); i = i + 1 {
        if Token.isWord(toks[i].kind, "type") && isConid(toks[i + 1]) {
            Vec.push(names, text(toks[i + 1]))
        }
    }
    names
}

-- Type names every file may be read knowing, wherever they are declared, so
-- that `type Count = Int` reads as an alias before the module declaring `Int`
-- has been read. Knowing a name here puts nothing in scope.
let knownTycons = ["Int", "Float", "String", "Char", "Byte", "Bool", "Unit", "Array"]

-- -- token helpers ------------------------------------------------------------------

fun cur(p : P) -> Token = p.toks[p.i]

fun peek(p : P, ahead : Int) -> Token {
    let at = p.i + ahead
    if at >= len(p.toks) { return p.toks[len(p.toks) - 1] }
    p.toks[at]
}

fun kindOf(p : P) -> String = Token.kindName(cur(p).kind)

fun at(p : P, name : String) -> Bool = kindOf(p) == name

fun atAny(p : P, names : Array String) -> Bool = Array.contains(names, kindOf(p))

fun advance(p : P) -> Token {
    let tok = cur(p)
    if !at(p, "EOF") { p.i = p.i + 1 }
    tok
}

-- `advance` for its effect alone. A discarded value is an error, and moving
-- past a token the caller has already looked at is most of what a parser does.
fun step(p : P) -> Unit {
    let _ = advance(p)
}

fun eat(p : P, name : String) -> Bool {
    if at(p, name) {
        step(p)
        True
    } else {
        False
    }
}

fun expect(p : P, name : String) -> Token = expectWhat(p, name, "'" + name + "'")

-- `expect` in statement position. A block answers with its last statement, so a
-- branch ending in `expect` answers a `Token` while the sibling branch ending
-- in a `while` answers `Unit`, and the two do not unify. This is the one-word
-- fix, used wherever the token consumed is not the answer.
fun skipToken(p : P, name : String) -> Unit {
    let _ = expect(p, name)
    ()
}

fun skipWhat(p : P, name : String, what : String) -> Unit {
    let _ = expectWhat(p, name, what)
    ()
}

fun expectWhat(p : P, name : String, what : String) -> Token {
    if !at(p, name) {
        oops(p, "expected " + what + ", found " + describe(cur(p))
                + splitHint(cur(p)), cur(p).span)
    }
    advance(p)
}

-- What to say about an operator run that is probably two operators written
-- without a space between them, `=-` in `x =-1` say. Nothing when it is not.
fun splitHint(tok : Token) -> String {
    if !isOperatorRun(tok) || Fixity.isBuiltin(text(tok)) { return "" }
    Fixity.splitAdvice(text(tok), Fixity.isBuiltin)
}

-- A token spelled with operator characters. The lexer makes every such run
-- one token, so its first character decides.
fun isOperatorRun(tok : Token) -> Bool = match tok.kind {
    KOp(op) -> match String.decode(op, String.start(op)) {
        Some(c) -> Lexer.isOperatorChar(c)
        None -> False
    }
    _ -> False
}

-- Ends the compile. The parser has no recovery: after an error it cannot
-- tell where the construct it was reading ends, so it has no next one to go
-- on to.
fun oops(p : P, message : String, where : Span) -> a =
    Diag.fail(Diag.at("parse error", message, where), p.file)

-- Returns how a message names a token: as the user wrote it, in quotes. A
-- string or character literal carries its own quotes, a keyword says it is
-- one, and a line break or the end of the file is named in words.
fun describe(tok : Token) -> String = match tok.kind {
    KEof -> "end of file"
    KNewline -> if tok.forced { "';'" } else { "end of line" }
    KString -> Token.quote(text(tok))
    KChar -> match tok.value {
        VChar(c) -> charLiteral(c)
        _ -> "'" + text(tok) + "'"
    }
    KWord(word) -> "keyword '" + word + "'"
    KOp(op) -> "'" + op + "'"
    KInt | KFloat | KIdent | KConid -> "'" + text(tok) + "'"
}

-- `c` spelled as a character literal. The value is all a token keeps, so a
-- number comes back in decimal and an escape in `Token.quote`'s spelling.
fun charLiteral(c : Char) -> String = match c {
    '\'' -> "'\\''"
    '"' -> "'\"'"
    -- `quote` escapes for a string; with its double quotes gone, the escapes
    -- that remain are the same in a character literal.
    _ -> "'" + String.replace(Token.quote(Char.toString(c)), "\"", "") + "'"
}

-- A token's value as text, which is what an error message quotes and what a
-- name is read from.
fun text(tok : Token) -> String = match tok.value {
    VText(s) -> s
    VInt(n) -> Int.toString(n)
    VFloat(x) -> Float.toString(x)
    VChar(c) -> Char.toString(c)
    VNone -> ""
}

fun skipNewlines(p : P) -> Unit {
    while at(p, "NEWLINE") { step(p) }
}

fun setNoRecord(p : P, flag : Bool) -> Bool {
    let saved = p.noRecord
    p.noRecord = flag
    saved
}

-- -- node construction --------------------------------------------------------------
--
-- Every node gets a fresh id here, which is the only place nodes are made.
--
-- A node the source writes spans from the start it is given to the end of the
-- last token read. So `mkExpr` and the others below build a node only once its
-- last token has been read, and a node built any earlier would be cut short.
-- A node the parser writes itself, such as the wildcard arm of an `if let`
-- or the method a `-` means, covers no text: the `made` forms give it an
-- empty span at the start it is given, which is where its diagnostics point.

fun freshId(p : P) -> Int = freshNodeId()

-- Returns `s` ending where the last token read ends. A line break never ends
-- a node, so it is skipped.
fun close(p : P, s : Span) -> Span {
    var j = p.i - 1
    while j >= 0 && isNewline(p.toks[j]) { j = j - 1 }
    if j < 0 { return s }
    Source.through(s, p.toks[j].span)
}

fun isNewline(tok : Token) -> Bool = match tok.kind {
    KNewline -> True
    _ -> False
}

fun mkType(p : P, s : Span, k : TypeKind) -> Type =
    Type { id = freshId(p), span = close(p, s), kind = k }

fun mkPat(p : P, s : Span, k : PatKind) -> Pat = patNode(p, close(p, s), k)

fun madePat(p : P, s : Span, k : PatKind) -> Pat = patNode(p, Source.emptyAt(s), k)

fun patNode(p : P, s : Span, k : PatKind) -> Pat =
    Pat { id = freshId(p), span = s, kind = k, opening = None }

fun mkExpr(p : P, s : Span, k : ExprKind) -> Expr = exprNode(p, close(p, s), k)

fun madeExpr(p : P, s : Span, k : ExprKind) -> Expr = exprNode(p, Source.emptyAt(s), k)

fun exprNode(p : P, s : Span, k : ExprKind) -> Expr =
    Expr { id = freshId(p), span = s, kind = k }

fun mkStmt(p : P, s : Span, k : StmtKind) -> Stmt = stmtNode(p, close(p, s), k)

fun madeStmt(p : P, s : Span, k : StmtKind) -> Stmt = stmtNode(p, Source.emptyAt(s), k)

fun stmtNode(p : P, s : Span, k : StmtKind) -> Stmt =
    Stmt { id = freshId(p), span = s, kind = k }

-- An arm the parser writes itself, as the `match` an `if let` means has.
fun madeArm(s : Span, patterns : Vec Pat, guards : Vec Guard, body : Expr) -> Arm =
    Arm { span = Source.emptyAt(s), patterns = patterns, guards = guards, body = body }

-- A marked method reference: the `neg` a `-` means. Marked, so that a module
-- defining its own `neg` does not quietly capture every `-` in the file.
fun method(p : P, s : Span, name : String) -> Expr =
    madeExpr(p, s, EVar(name, True))

-- -- tables -------------------------------------------------------------------------

let literalKinds = ["INT", "FLOAT", "STRING", "CHAR"]

let exprStart = [
    "INT", "FLOAT", "STRING", "CHAR",
    "IDENT", "CONID", "(", "[", "{", "-", "!",
    "fun", "if", "match", "while", "for", "loop", "return", "break", "continue",
    "do", "\\",
]

let patternStart = ["INT", "FLOAT", "STRING", "CHAR", "IDENT", "CONID", "("]

-- -- program ------------------------------------------------------------------------

fun parseProgram(p : P) -> Program {
    let s = cur(p).span
    skipNewlines(p)
    -- The export declaration comes first, so that what a module offers is the
    -- first thing its reader sees.
    var exportDecl : Option ExportDecl = None
    if at(p, "export") {
        exportDecl = Some(parseExportDecl(p))
        endOfStatement(p)
    }
    let imports = Vec.new(4)
    let decls = Vec.new(16)
    skipNewlines(p)
    while !at(p, "EOF") {
        if at(p, "import") {
            Vec.push(imports, parseImport(p))
        } else if at(p, "type") {
            Vec.push(decls, DType(parseTypeDecl(p)))
        } else if at(p, "class") {
            Vec.push(decls, DClass(parseClassDecl(p)))
        } else if at(p, "instance") {
            Vec.push(decls, DInstance(parseInstanceDecl(p)))
        } else if at(p, "foreign") {
            parseForeign(p, decls)
        } else if at(p, "fun") {
            let s2 = cur(p).span
            Vec.push(decls, DStmt(mkStmt(p, s2, SFun(parseFunDecl(p, False)))))
        } else if at(p, "let") || at(p, "var") {
            Vec.push(decls, DStmt(parseBindingStmt(p)))
        } else if atInfix(p) {
            Vec.push(decls, DInfix(parseInfixDecl(p)))
        } else if at(p, "export") {
            if Option.isSome(exportDecl) {
                oops(p, "this file already has an export declaration; "
                        + "merge the two", cur(p).span)
            }
            oops(p, "this 'export' comes after an import or declaration; "
                    + "move it to the top of the file", cur(p).span)
        } else if at(p, "module") {
            oops(p, "'module' cannot begin a declaration; write 'export (...)' "
                    + "to list the module's exports", cur(p).span)
        } else {
            oops(p, "expected a top-level declaration, found "
                    + describe(cur(p)), cur(p).span)
        }
        endOfStatement(p)
    }
    Program {
        span = close(p, s), exportDecl = exportDecl, imports = imports, decls = decls,
        letElses = p.letElses, comments = p.comments, blankLines = p.blankLines,
    }
}

fun endOfStatement(p : P) -> Unit {
    if at(p, "NEWLINE") {
        skipNewlines(p)
    } else if !at(p, "EOF") && !at(p, "}") {
        oops(p, "expected end of statement, found " + describe(cur(p)), cur(p).span)
    }
}

-- `export (...)`, or `export (..)` for everything the module declares. A
-- module's name is its path, so nothing here names it.
fun parseExportDecl(p : P) -> ExportDecl {
    let s = advance(p).span
    skipWhat(p, "(", "'(' and the module's exports")
    if eat(p, "..") {
        skipToken(p, ")")
        return ExportDecl { span = close(p, s), items = None }
    }
    let items = Vec.new(8)
    while !at(p, ")") {
        Vec.push(items, parseExportItem(p))
        if !eat(p, ",") { break }
    }
    skipToken(p, ")")
    ExportDecl { span = close(p, s), items = Some(items) }
}

-- `f`, `T`, `T(..)`, `T(A, B)`, a qualifier, `module Q`, or an operator in
-- parentheses, `(<>)`, which is the item `<>`.
fun parseExportItem(p : P) -> ExportItem {
    if at(p, "(") && isOperatorRun(peek(p, 1)) {
        step(p)
        let opTok = advance(p)
        skipWhat(p, ")", "')' after the operator")
        return ExportItem {
            span = opTok.span, name = text(opTok), subs = None, qualifier = False,
        }
    }
    if at(p, "module") {
        let s = advance(p).span
        let tok = expectWhat(p, "CONID", "a qualifier")
        if at(p, ".") {
            let path = dottedFrom(p, tok)
            let last = match String.rsplitOnce(path, ".") {
                Some((_, x)) -> x
                None -> path
            }
            oops(p, "'module " + path + "' names a module by its path; an "
                    + "export list can name only a qualifier of one "
                    + "component; write 'import " + path + " as " + last
                    + "' and 'module " + last + "'", tok.span)
        }
        return ExportItem {
            span = close(p, s), name = text(tok), subs = None, qualifier = True,
        }
    }
    let tok = advance(p)
    if !isNameToken(tok) {
        oops(p, "expected a name, found " + describe(tok), tok.span)
    }
    var subs : Option (Vec String) = None
    if isConid(tok) && at(p, "(") {
        step(p)
        let names = Vec.new(4)
        while !at(p, ")") {
            Vec.push(names, text(advance(p)))
            if !eat(p, ",") { break }
        }
        skipToken(p, ")")
        subs = Some(names)
    }
    ExportItem {
        span = close(p, tok.span), name = text(tok), subs = subs, qualifier = False,
    }
}

fun isNameToken(tok : Token) -> Bool = match Token.kindName(tok.kind) {
    "IDENT" | "CONID" -> True
    _ -> False
}

fun isConid(tok : Token) -> Bool = Token.kindName(tok.kind) == "CONID"

fun parseModname(p : P) -> String =
    dottedFrom(p, expectWhat(p, "CONID", "a module name"))

fun parseImport(p : P) -> ImportDecl {
    let s = expect(p, "import").span
    let name = parseModname(p)
    var alias : Option String = None
    var items : Option (Vec ImportItem) = None
    var rest = False
    if eat(p, "as") { alias = Some(text(expectWhat(p, "CONID", "a module alias"))) }
    -- An alias and a list are independent: `import M as S (f)` names the
    -- qualifier and chooses the bare names.
    if at(p, "(") {
        let (list, dots) = parseImportList(p)
        items = Some(list)
        rest = dots
    } else if at(p, "IDENT") && text(cur(p)) == "hiding" {
        oops(p, "'hiding' cannot appear in an import; write 'import " + name
                + " (" + withheld(p) + "..)' instead", cur(p).span)
    }
    ImportDecl { span = close(p, s), name = name, alias = alias, items = items, rest = rest }
}

-- The names in the list after a `hiding` at the cursor, each as `x as _, `,
-- for a message to suggest; `x as _, ` when there is no such list.
fun withheld(p : P) -> String {
    let b = String.builder()
    if Token.kindName(peek(p, 1).kind) == "(" {
        var ahead = 2
        while isNameToken(peek(p, ahead)) {
            String.push(b, text(peek(p, ahead)) + " as _, ")
            if Token.kindName(peek(p, ahead + 1).kind) != "," { break }
            ahead = ahead + 2
        }
    }
    let names = String.build(b)
    if names == "" { "x as _, " } else { names }
}

-- `(a, T(..), x as y, C as _, ..)`. Beside a `..`, which already brings every
-- name the list does not mention, an item can only rename or withhold.
fun parseImportList(p : P) -> (Vec ImportItem, Bool) {
    skipToken(p, "(")
    let items = Vec.new(4)
    var dots : Option Span = None
    while !at(p, ")") {
        if at(p, "..") {
            let tok = advance(p)
            if Option.isSome(dots) {
                oops(p, "'..' appears twice in this import list", tok.span)
            }
            dots = Some(tok.span)
        } else {
            Vec.push(items, parseImportItem(p))
        }
        if !eat(p, ",") { break }
    }
    skipToken(p, ")")
    if Option.isSome(dots) {
        for entry in items {
            if Option.isNone(entry.rename) {
                let name = if entry.item.qualifier { "module " + entry.item.name }
                           else { entry.item.name }
                oops(p, "'" + name + "' is already imported by '..'; remove it, "
                        + "or write '" + name + " as _' to withhold it",
                     entry.item.span)
            }
        }
    }
    (items, Option.isSome(dots))
}

fun parseImportItem(p : P) -> ImportItem {
    let operator = at(p, "(")
    let item = parseExportItem(p)
    if !eat(p, "as") { return ImportItem { item = item, rename = None } }
    let tok = advance(p)
    -- A renamed operator would keep its group under a symbol no `infix`
    -- declaration names. A module that wants another spelling declares it,
    -- as `infix G (<+>) = M.f`, and the group is then written where it is
    -- used.
    if operator && text(tok) != "_" {
        oops(p, "operator '" + item.name + "' cannot be renamed; write '("
                + item.name + ") as _' to withhold it, or declare the spelling "
                + "you want with 'infix'", tok.span)
    }
    if !isNameToken(tok) {
        oops(p, "expected a name, or '_' for none, after 'as', found "
                + describe(tok), tok.span)
    }
    let to = text(tok)
    if to != "_" && isConid(tok) != startsUpper(item.name) {
        let rule = if item.qualifier {
            "a qualifier must start with a capital"
        } else if startsUpper(item.name) {
            "the name of a type, class or constructor must start with a capital"
        } else {
            "a value's name must start with a lowercase letter"
        }
        oops(p, "'" + item.name + "' cannot be renamed to '" + to + "'; " + rule,
             tok.span)
    }
    ImportItem { item = item, rename = Some(to) }
}

fun startsUpper(name : String) -> Bool = match String.decode(name, String.start(name)) {
    Some(c) -> Char.isAsciiUpper(c)
    None -> False
}

-- -- operator declarations -----------------------------------------------------------

-- `infix` is a keyword only here, at the start of a top-level declaration and
-- before a group name, so it stays free for a program's own names.
fun atInfix(p : P) -> Bool =
    at(p, "IDENT") && text(cur(p)) == "infix" && Token.kindName(peek(p, 1).kind) == "CONID"

fun parseInfixDecl(p : P) -> InfixDecl {
    step(p)
    let groupTok = expectWhat(p, "CONID", "a precedence group")
    let group = match Fixity.groupNamed(text(groupTok)) {
        Some(g) -> g
        None -> oops(p, "unknown precedence group '" + text(groupTok)
                        + "'; the groups are " + Fixity.groupList, groupTok.span)
    }
    skipWhat(p, "(", "'(' before the operator")
    let opTok = cur(p)
    if !isOperatorRun(opTok) {
        oops(p, "expected an operator, found " + describe(opTok), opTok.span)
    }
    step(p)
    match Fixity.declarable(text(opTok), group) {
        Some(why) -> oops(p, why, opTok.span)
        None -> {}
    }
    skipWhat(p, ")", "')' after the operator")
    skipToken(p, "=")
    let targetTok = cur(p)
    var target = ""
    if at(p, "IDENT") {
        target = text(advance(p))
    } else if at(p, "CONID") {
        let qualifier = dottedFrom(p, advance(p))
        skipWhat(p, ".", "a function name")
        target = qualifier + "." + text(expectWhat(p, "IDENT", "a function name"))
    } else {
        oops(p, "expected the name of a function after '=', found "
                + describe(targetTok), targetTok.span)
    }
    InfixDecl {
        span = close(p, opTok.span), group = group, op = text(opTok), target = target,
        targetSpan = targetTok.span,
    }
}

-- -- type declarations ---------------------------------------------------------------

fun parseTypeDecl(p : P) -> TypeDecl {
    let s = expect(p, "type").span
    let name = text(expectWhat(p, "CONID", "a type name"))
    let params = Vec.new(2)
    while at(p, "IDENT") { Vec.push(params, text(advance(p))) }
    let derives = if eat(p, ":") { parseDerives(p) } else { [] }
    skipToken(p, "=")

    -- A `|` or a `{` payload means data type outright. A bare `C` or `C(...)`
    -- is a data type when `C` does not name an existing type constructor -- or
    -- when it names the type being declared, which is the newtype case and not
    -- a recursive alias.
    --
    -- Any other `C args` is an alias whether or not `C` is known yet, because
    -- a constructor's payload is one parenthesized list with nothing after it.
    -- This matters on the first read of a file, made before its imports are
    -- loaded: `type D e = Either Int e` must not be taken for a malformed
    -- constructor while `Either` is still unknown. An alias whose head stays
    -- unknown is refused by the declaration table.
    --
    -- A qualified head is a type: a constructor is never written qualified
    -- where it is declared.
    if at(p, "CONID") && Token.kindName(peek(p, 1).kind) != "." {
        let headName = text(cur(p))
        if Token.kindName(peek(p, 1).kind) == "{" || rhsHasAlternatives(p) {
            return parseDataRhs(p, s, name, params, derives)
        }
        if headName == name
                || (!Vec.contains(p.tycons, headName) && constructorShaped(p)) {
            return parseDataRhs(p, s, name, params, derives)
        }
    }
    let alias = parseTypeExpr(p)
    TypeDecl {
        span = close(p, s), name = name, params = params, derives = derives,
        variants = None, alias = Some(alias),
    }
}

-- `Eq, !Hash` -- a derive list, after its `:`. Each entry is a class name,
-- qualified or not, with a `!` before it to refuse the class.
fun parseDerives(p : P) -> Vec Derive {
    let out = Vec.new(2)
    loop {
        let s = cur(p).span
        let refused = eat(p, "!")
        let first = expectWhat(p, "CONID", "a class name")
        let cls = dottedFrom(p, first)
        Vec.push(out, Derive { span = close(p, s), cls = cls, refused = refused })
        if !eat(p, ",") { break }
    }
    out
}

-- Whether the right-hand side at the cursor, a `CONID`, has a constructor's
-- shape: nothing after it, or one parenthesized list and nothing after that,
-- where "nothing" is anything that cannot begin a type argument.
fun constructorShaped(p : P) -> Bool {
    var j = p.i + 1
    if j < len(p.toks) && Token.kindName(p.toks[j].kind) == "(" {
        var depth = 0
        while j < len(p.toks) {
            let kind = Token.kindName(p.toks[j].kind)
            if kind == "(" || kind == "[" || kind == "{" {
                depth = depth + 1
            } else if kind == ")" || kind == "]" || kind == "}" {
                depth = depth - 1
                if depth == 0 { break }
            } else if kind == "EOF" {
                return True
            }
            j = j + 1
        }
        j = j + 1
    }
    if j >= len(p.toks) { return True }
    let kind = Token.kindName(p.toks[j].kind)
    kind != "IDENT" && kind != "CONID" && kind != "(" && kind != "fun"
}

-- Look ahead for a top-level `|` before the declaration ends.
fun rhsHasAlternatives(p : P) -> Bool {
    var depth = 0
    var j = p.i
    while j < len(p.toks) {
        let kind = Token.kindName(p.toks[j].kind)
        if kind == "(" || kind == "[" || kind == "{" {
            depth = depth + 1
        } else if kind == ")" || kind == "]" || kind == "}" {
            if depth == 0 { return False }
            depth = depth - 1
        } else if depth == 0 {
            if kind == "|" { return True }
            if kind == "NEWLINE" || kind == "EOF" { return False }
        }
        j = j + 1
    }
    False
}

fun parseDataRhs(p : P, s : Span, name : String, params : Vec String,
                 derives : Vec Derive) -> TypeDecl {
    let variants = Vec.new(4)
    Vec.push(variants, parseConDecl(p))
    while eat(p, "|") {
        skipNewlines(p)
        Vec.push(variants, parseConDecl(p))
    }
    TypeDecl {
        span = close(p, s), name = name, params = params, derives = derives,
        variants = Some(variants), alias = None,
    }
}

-- `[s, Error e]` -- the variables an existential constructor hides. Read like a
-- `fun`'s context, with a bare variable as one more form and an equality
-- refused.
fun parseConContext(p : P) -> (Vec String, Vec Pred) {
    let binders = Vec.new(1)
    let preds = Vec.new(1)
    if !at(p, "[") { return (binders, preds) }
    step(p)
    loop {
        let s = cur(p).span
        let written = parseTypeExpr(p)
        if at(p, "~") {
            oops(p, "'~' cannot appear in an existential bracket; write type "
                    + "variables such as 's' and constraints such as 'Error e'", s)
        }
        match written.kind {
            TEVar(name) -> Vec.push(binders, name)
            TECon(name, args) -> {
                if len(args) != 1 { oops(p, conContextShape, s) }
                Vec.push(preds, Pred { span = close(p, s), kind = PClass(name, args[0]) })
            }
            _ -> oops(p, conContextShape, s)
        }
        if !eat(p, ",") { break }
        if at(p, "]") { break }
    }
    skipToken(p, "]")
    (binders, preds)
}

let conContextShape =
    "this entry is neither a type variable nor a constraint; an existential "
    + "bracket can hold only entries such as 's' or 'Error e'"

fun parseConDecl(p : P) -> ConDecl {
    let tok = expectWhat(p, "CONID", "a constructor name")
    let (binders, context) = parseConContext(p)
    if at(p, "{") {
        let (fields, vars, spans) = parseRecordPayload(p)
        return ConDecl {
            span = close(p, tok.span), name = text(tok), args = [],
            fields = Some(fields), vars = vars, fieldSpans = spans,
            binders = binders, context = context,
        }
    }
    let args = Vec.new(2)
    if eat(p, "(") {
        -- A value constructor is an uncurried function, so it declares its
        -- payload the way a function declares parameters. Type application
        -- inside stays juxtaposed -- `Loop(Array Op)`.
        while !at(p, ")") {
            Vec.push(args, parseTypeExpr(p))
            if !eat(p, ",") { break }
        }
        skipToken(p, ")")
    } else if at(p, "IDENT") || at(p, "CONID") || at(p, "fun") {
        oops(p, "the payload of constructor '" + text(tok) + "' is not in "
                + "parentheses; write '" + text(tok) + "(...)'", cur(p).span)
    }
    ConDecl {
        span = close(p, tok.span), name = text(tok), args = args, fields = None,
        vars = [], fieldSpans = [], binders = binders, context = context,
    }
}

-- What separates two fields in braces: a comma, a significant newline, or both,
-- in a declaration, a construction and a pattern alike. A newline that survived
-- the newline rule ended the field, so what follows it must be a field or the
-- closing brace.
fun fieldSeparator(p : P) -> Bool {
    if eat(p, ",") {
        skipNewlines(p)
        return True
    }
    if !at(p, "NEWLINE") { return False }
    skipNewlines(p)
    if !at(p, "IDENT") && !at(p, "var") && !at(p, "..") && !at(p, "}") {
        oops(p, "expected a field or '}' at the start of this line, found "
                + describe(cur(p)), cur(p).span)
    }
    True
}

-- A record constructor's fields, the names of those declared `var`, and where
-- each field's name is written.
fun parseRecordPayload(p : P) -> (Vec (String, Type), Vec String, Vec Span) {
    skipToken(p, "{")
    skipNewlines(p)
    let fields = Vec.new(4)
    let vars = []
    let spans = []
    let seen = Vec.new(4)
    while !at(p, "}") {
        let assignable = eat(p, "var")
        let tok = expectWhat(p, "IDENT", "a field name")
        if assignable { Vec.push(vars, text(tok)) }
        Vec.push(spans, tok.span)
        if Vec.contains(seen, text(tok)) {
            oops(p, "field '" + text(tok) + "' is declared twice", tok.span)
        }
        Vec.push(seen, text(tok))
        skipToken(p, ":")
        Vec.push(fields, (text(tok), parseTypeExpr(p)))
        if !fieldSeparator(p) { break }
    }
    skipToken(p, "}")
    (fields, vars, spans)
}

-- -- type expressions ----------------------------------------------------------------

fun parseTypeExpr(p : P) -> Type {
    let head = parseAtype(p)
    let args = Vec.new(2)
    while at(p, "IDENT") || at(p, "CONID") || at(p, "(") {
        Vec.push(args, parseAtype(p))
    }
    if len(args) == 0 { return head }
    match head.kind {
        TECon(name, existing) -> {
            if len(existing) == 0 {
                return mkType(p, head.span, TECon(name, args))
            }
            oops(p, "'" + name + "' is applied to arguments both inside and "
                    + "outside parentheses; write them all after '" + name + "'",
                 head.span)
        }
        -- A variable in head position: `f a`, which is what a higher-kinded
        -- parameter looks like at the surface.
        TEVar(_) -> mkType(p, head.span, TEApp(head, args))
        _ -> oops(p, "this type cannot be applied to arguments; only a type "
                     + "name or a type variable can be", head.span)
    }
}

fun parseAtype(p : P) -> Type {
    let tok = cur(p)
    match kindOf(p) {
        "IDENT" -> {
            step(p)
            mkType(p, tok.span, TEVar(text(tok)))
        }
        -- A qualified type constructor: `S.Node`. The dotted chain is one name,
        -- resolved as one.
        "CONID" -> {
            step(p)
            mkType(p, tok.span, TECon(dottedFrom(p, tok), []))
        }
        "fun" -> {
            step(p)
            skipToken(p, "(")
            let params = Vec.new(2)
            while !at(p, ")") {
                Vec.push(params, parseTypeExpr(p))
                if !eat(p, ",") { break }
            }
            skipToken(p, ")")
            skipWhat(p, "->", "'->' and a return type")
            mkType(p, tok.span, TEFun(params, parseTypeExpr(p)))
        }
        "(" -> parseParenType(p, tok)
        _ -> oops(p, "expected a type, found " + describe(tok), tok.span)
    }
}

-- The rest of a dotted name whose first CONID has already been consumed.
fun dottedFrom(p : P, first : Token) -> String {
    let parts = Vec.new(2)
    Vec.push(parts, text(first))
    while at(p, ".") && Token.kindName(peek(p, 1).kind) == "CONID" {
        step(p)
        Vec.push(parts, text(advance(p)))
    }
    String.join(parts, ".")
}

fun parseParenType(p : P, tok : Token) -> Type {
    step(p)
    -- `()`, the unit type.
    if eat(p, ")") { return mkType(p, tok.span, TETuple(Vec.new(0))) }
    let elems = Vec.new(2)
    Vec.push(elems, parseTypeExpr(p))
    while eat(p, ",") {
        if at(p, ")") {
            if len(elems) == 1 {
                oops(p, "a tuple cannot have just one component; remove the "
                        + "trailing ','", cur(p).span)
            }
            break
        }
        Vec.push(elems, parseTypeExpr(p))
    }
    skipToken(p, ")")
    if len(elems) == 1 { return elems[0] }
    mkType(p, tok.span, TETuple(elems))
}

-- -- functions -----------------------------------------------------------------------

fun parseFunDecl(p : P, allowSignature : Bool) -> FunDecl {
    let s = expect(p, "fun").span
    let name = text(expectWhat(p, "IDENT", "a function name"))
    let context = parseContext(p)
    if allowSignature && looksLikeSignature(p) {
        return parseSignature(p, s, name, context)
    }
    let params = parseParamList(p)
    var ret : Option Type = None
    if eat(p, "->") { ret = Some(parseTypeExpr(p)) }
    let body = parseFunBody(p)
    FunDecl {
        id = freshId(p), span = close(p, s), name = name, params = params, ret = ret,
        body = Some(body), context = context, monomorphic = False, symbol = None,
    }
}

-- Is this method a signature rather than a definition?
--
-- Answered by looking rather than by parsing and undoing, since there is
-- nothing to undo a parse with. What it looks for is the body: a definition has
-- an `=` or a `{` after its parameter list and a signature has neither.
--
-- The scan starts at the `(` and runs to the end of the declaration at bracket
-- depth zero. Nothing inside the parameter list or inside a return type can be
-- mistaken for a body, since both are nested; and a return type contains no
-- `=` or `{` at any depth.
fun looksLikeSignature(p : P) -> Bool {
    if !at(p, "(") { return False }
    var depth = 0
    var j = p.i
    while j < len(p.toks) {
        let kind = Token.kindName(p.toks[j].kind)
        if kind == "(" || kind == "[" || kind == "{" {
            if depth == 0 && kind == "{" { return False }
            depth = depth + 1
        } else if kind == ")" || kind == "]" || kind == "}" {
            if depth == 0 { return True }
            depth = depth - 1
        } else if depth == 0 {
            if kind == "=" { return False }
            if kind == "NEWLINE" || kind == "EOF" { return True }
        }
        j = j + 1
    }
    True
}

fun parseSignature(p : P, s : Span, name : String, context : Vec Pred) -> FunDecl {
    skipToken(p, "(")
    let types = Vec.new(2)
    while !at(p, ")") {
        Vec.push(types, parseTypeExpr(p))
        if !eat(p, ",") { break }
    }
    skipToken(p, ")")
    if !eat(p, "->") {
        oops(p, "method '" + name + "' has neither a body nor a return type; "
                + "add '-> T' after the parameters", cur(p).span)
    }
    let ret = parseTypeExpr(p)
    -- A parameter of a stated type with no name is an anonymous binder.
    let params = Vec.new(len(types))
    for t in types {
        Vec.push(params, madePat(p, t.span, PAnnot(madePat(p, t.span, PWild), t)))
    }
    FunDecl {
        id = freshId(p), span = close(p, s), name = name, params = params,
        ret = Some(ret), body = None, context = context, monomorphic = False,
        symbol = None,
    }
}

-- A `foreign` declaration, appended to `decls`, or a block of them, each
-- appended in order: `foreign "name" major { "symbol" fun name(params) -> ret
-- ... }`. Every declaration in a block carries the block's library, and a
-- block holds declarations only, since a definition is not imported from
-- anywhere.
fun parseForeign(p : P, decls : Vec Decl) -> Unit {
    let s = expect(p, "foreign").span
    if Token.kindName(peek(p, 1).kind) != "INT" {
        Vec.push(decls, parseForeignDecl(p, s, None))
        return {}
    }
    let tok = expectWhat(p, "STRING", "the library's name as a string")
    let name = text(tok)
    if name == "" {
        oops(p, "the library's name is empty; write it between the quotes, as in "
                + "'foreign \"ssl\" 3'", tok.span)
    }
    let major = intOf(advance(p))
    let library = Some(ForeignLibrary { name = name, major = major, span = close(p, s) })
    skipToken(p, "{")
    skipNewlines(p)
    -- An empty block would be no declaration at all, so neither the gate on
    -- where declarations may appear nor the check of the library's version
    -- would ever see it.
    if at(p, "}") {
        oops(p, "the block for library '" + name + "' declares nothing; declare a function "
                + "in it, or remove it", cur(p).span)
    }
    while !at(p, "}") {
        Vec.push(decls, parseForeignDecl(p, cur(p).span, library))
        endOfStatement(p)
    }
    skipToken(p, "}")
}

-- `"symbol" fun name(params) -> ret`, with or without a body, after the
-- `foreign` at `s` or inside a block of `library`. Without a body C defines
-- the symbol; with one Turkey defines it and C may call it. A definition is
-- an ordinary function carrying an exported symbol.
--
-- The C symbol is always written, even when it is the Turkey name spelled the
-- same way, so which of the two names is which is never something a reader has
-- to work out.
--
-- There is no context, and a body only for a definition. A return type is
-- required either way: a C function that returns nothing writes `-> Unit`, because "the signature is stated in
-- full" is the only property that makes the declaration worth trusting.
fun parseForeignDecl(p : P, s : Span, library : Option ForeignLibrary) -> Decl {
    let tok = cur(p)
    if Token.kindName(tok.kind) != "STRING" {
        oops(p, "expected the C symbol as a string, found " + describe(tok),
             tok.span)
    }
    step(p)
    let symbol = text(tok)
    if symbol == "" {
        oops(p, "the C symbol is empty; write its name between the quotes",
             tok.span)
    }
    skipToken(p, "fun")
    let name = text(expectWhat(p, "IDENT", "a function name"))
    let (params, variadic) = parseForeignParams(p)
    if !eat(p, "->") {
        oops(p, "foreign '" + name + "' has no return type; add '-> T' after "
                + "the parameters, or '-> Unit' if it returns nothing",
             cur(p).span)
    }
    let ret = parseTypeExpr(p)
    if at(p, "{") || at(p, "=") {
        if Option.isSome(library) {
            oops(p, "foreign '" + name + "' is inside a library's block, so it cannot have "
                    + "a body; move it out of the block", cur(p).span)
        }
        if let Some((_, marker)) = variadic {
            oops(p, "foreign '" + name + "' has a body, so it cannot be "
                    + "variadic; remove the '...'", marker)
        }
        -- Every parameter of a definition is a binder, and a name is what
        -- binds one; an unnamed parameter could never be read.
        for param in params {
            let named = match param.kind {
                PAnnot(inner, _) -> match inner.kind {
                    PVar(_) -> True
                    _ -> False
                }
                _ -> False
            }
            if !named {
                oops(p, "foreign '" + name + "' has a body, so each parameter "
                        + "needs a name; write 'x : T'", param.span)
            }
        }
        let body = parseFunBody(p)
        return DStmt(mkStmt(p, s, SFun(FunDecl {
            id = freshId(p), span = close(p, s), name = name, params = params,
            ret = Some(ret), body = Some(body), context = [],
            monomorphic = True, symbol = Some(symbol),
        })))
    }
    let fixed = match variadic {
        Some((at, _)) -> at
        None -> len(params)
    }
    DForeign(ForeignDecl {
        id = freshId(p), span = close(p, s), name = name, symbol = symbol, params = params,
        fixed = fixed, ret = ret, library = library,
    })
}

-- `(fd : Int, buf : Prim.Ptr)`, or `(Int, Prim.Ptr)`, or a mix, and where a
-- `...` begins the variadic arguments, if one does: the index of the first
-- parameter after it, and the marker's span.
--
-- Stored the way a signature's parameters are -- an annotated pattern -- so
-- everything downstream reads a parameter's type off one shape whether it was
-- named or not. Naming is allowed here and not there because the ambiguity
-- `looksLikeSignature` exists to settle cannot arise: every parameter of a
-- foreign signature states its type, so `x : T` is always a name.
--
-- The marker stands before a parameter, not at the end of the list as C's
-- does, because each declaration fixes the type of every argument it passes:
-- `open` called with a mode is one declaration and `open` called without one
-- another. So a `...` must have a parameter after it, and there is one per
-- list.
fun parseForeignParams(p : P) -> (Vec Pat, Option (Int, Span)) {
    skipToken(p, "(")
    let params = Vec.new(2)
    var variadic = None
    while !at(p, ")") {
        if at(p, "...") {
            let marker = cur(p).span
            if Option.isSome(variadic) {
                oops(p, "'...' appears twice in this parameter list; remove "
                        + "one", marker)
            }
            step(p)
            if at(p, ")") {
                oops(p, "'...' has no parameters after it; declare the variadic "
                        + "arguments after it, as in '... mode : Int'", marker)
            }
            variadic = Some((len(params), marker))
        }
        let tok = cur(p)
        if Token.kindName(tok.kind) == "IDENT"
                && Token.kindName(peek(p, 1).kind) == ":" {
            step(p)
            let binder = mkPat(p, tok.span, if text(tok) == "_" { PWild } else { PVar(text(tok)) })
            step(p)
            let ty = parseTypeExpr(p)
            Vec.push(params, mkPat(p, tok.span, PAnnot(binder, ty)))
        } else {
            let ty = parseTypeExpr(p)
            Vec.push(params, madePat(p, ty.span, PAnnot(madePat(p, ty.span, PWild), ty)))
        }
        if !eat(p, ",") { break }
    }
    skipToken(p, ")")
    (params, variadic)
}

-- `[C a, Item c ~ Op]` -- a context, not a binder.
--
-- Each entry is read as a *type expression* first and classified after, because
-- nothing shorter can tell the two forms apart: `Item c ~ Op` and
-- `Show (Elem c)` begin identically and the `~` is two atypes away.
fun parseContext(p : P) -> Vec Pred {
    if !at(p, "[") { return [] }
    step(p)
    let preds = Vec.new(2)
    loop {
        Vec.push(preds, parsePredEntry(p))
        if !eat(p, ",") { break }
        if at(p, "]") { break }
    }
    skipToken(p, "]")
    preds
}

fun parsePredEntry(p : P) -> Pred {
    let s = cur(p).span
    let written = parseTypeExpr(p)
    if eat(p, "~") {
        let other = parseTypeExpr(p)
        return Pred { span = close(p, s), kind = PEq(written, other) }
    }
    match written.kind {
        TECon(name, args) -> {
            if len(args) == 1 {
                return Pred { span = close(p, s), kind = PClass(name, args[0]) }
            }
            oops(p, contextShape, s)
        }
        _ -> oops(p, contextShape, s)
    }
}

let contextShape =
    "this entry is neither a constraint nor an equality; a context can hold "
    + "only entries such as 'Ord a' or 'Item c ~ Op'"

-- -- classes and instances -------------------------------------------------------------

fun parseClassDecl(p : P) -> ClassDecl {
    let s = expect(p, "class").span
    let name = text(expectWhat(p, "CONID", "a class name"))
    let param = text(expectWhat(p, "IDENT", "the class parameter"))
    -- The same entries as an instance context: a superclass may be an equality.
    let supers = parseInstanceContext(p)
    skipNewlines(p)
    let body = parseClassBody(p, True, param)
    ClassDecl {
        span = close(p, s), name = name, param = param, supers = supers,
        methods = body.0, families = body.1,
    }
}

fun parseInstanceDecl(p : P) -> InstanceDecl {
    let s = expect(p, "instance").span
    let name = parseModname(p)
    -- An `atype`, so a partially applied head parenthesizes.
    let head = parseAtype(p)
    let context = parseInstanceContext(p)
    skipNewlines(p)
    let body = parseInstanceBody(p)
    InstanceDecl {
        span = close(p, s), cls = name, head = head, context = context,
        methods = body.0, families = body.1,
    }
}

fun parseInstanceContext(p : P) -> Vec Pred {
    if !eat(p, ":") { return [] }
    let preds = Vec.new(2)
    loop {
        Vec.push(preds, parsePredEntry(p))
        if !eat(p, ",") { break }
        skipNewlines(p)
        if at(p, "{") { break }
    }
    preds
}

-- The `{ ... }` of a class: methods, and family *declarations*.
fun parseClassBody(p : P, isClass : Bool, param : String)
    -> (Vec FunDecl, Vec FamDecl) {
    skipToken(p, "{")
    skipNewlines(p)
    let methods = Vec.new(4)
    let families = Vec.new(2)
    while !at(p, "}") {
        if at(p, "type") {
            let s = expect(p, "type").span
            let name = text(expectWhat(p, "CONID", "an associated type name"))
            let written = text(expectWhat(p, "IDENT", "'" + param + "', the class parameter"))
            Vec.push(families, FamDecl { span = close(p, s), name = name, param = written })
        } else if at(p, "fun") {
            Vec.push(methods, parseFunDecl(p, isClass))
        } else {
            oops(p, "expected 'fun' or 'type', found " + describe(cur(p)),
                 cur(p).span)
        }
        endOfStatement(p)
    }
    skipToken(p, "}")
    (methods, families)
}

-- The `{ ... }` of an instance: methods, and family *definitions*. The two
-- bodies cannot share a function because what a `type` means differs, and a
-- pair of lists is what each answers.
fun parseInstanceBody(p : P) -> (Vec FunDecl, Vec FamBind) {
    skipToken(p, "{")
    skipNewlines(p)
    let methods = Vec.new(4)
    let families = Vec.new(2)
    while !at(p, "}") {
        if at(p, "type") {
            let s = expect(p, "type").span
            let name = text(expectWhat(p, "CONID", "an associated type name"))
            skipToken(p, "=")
            let body = parseTypeExpr(p)
            Vec.push(families, FamBind { span = close(p, s), name = name, body = body })
        } else if at(p, "fun") {
            Vec.push(methods, parseFunDecl(p, False))
        } else {
            oops(p, "expected 'fun' or 'type', found " + describe(cur(p)),
                 cur(p).span)
        }
        endOfStatement(p)
    }
    skipToken(p, "}")
    (methods, families)
}

fun parseParamList(p : P) -> Vec Pat {
    skipToken(p, "(")
    let saved = setNoRecord(p, False)
    let params = Vec.new(4)
    while !at(p, ")") {
        Vec.push(params, parsePattern(p))
        if !eat(p, ",") { break }
    }
    skipToken(p, ")")
    p.noRecord = saved
    params
}

fun parseFunBody(p : P) -> Expr {
    if eat(p, "=") {
        let saved = setNoRecord(p, False)
        let body = closeWhole(p, parseExpr(p))
        p.noRecord = saved
        return body
    }
    if at(p, "{") { return parseBlock(p) }
    oops(p, "expected '=' or a block to begin a function body, found "
            + describe(cur(p)), cur(p).span)
}

-- -- statements ---------------------------------------------------------------------

fun parseBindingStmt(p : P) -> Stmt {
    let tok = advance(p)
    let mutable = Token.isWord(tok.kind, "var")
    let saved = setNoRecord(p, False)
    let pattern = parsePattern(p)
    skipToken(p, "=")
    let value = closeWhole(p, parseExpr(p))
    p.noRecord = saved
    if at(p, "else") { return parseLetElse(p, tok.span, mutable, pattern, value) }
    mkStmt(p, tok.span, if mutable { SVar(pattern, value) } else { SLet(pattern, value) })
}

-- `let p = e else { B }` is
--
--     let (x, y) = match e { p -> (x, y), _ -> B }
--
-- for the names `p` binds, with a lone name in place of the tuple, or `_` for
-- none, and `var` in place of `let` for `var p = e else { B }`.
--
-- The names are bound by a `let` of the block rather than by putting the rest
-- of the block in the first arm. Desugaring `?` treats a statement of the block
-- differently from one inside a branch, so nesting would change how every `?`
-- after this statement is lowered.
fun parseLetElse(p : P, s : Span, mutable : Bool, pat : Pat, value : Expr) -> Stmt {
    -- `let x = if c { a } else { b } else { ... }` would read either way, so a
    -- value ending in a block cannot take an `else`.
    if Token.kindName(p.toks[p.i - 1].kind) == "}" {
        oops(p, "a 'let' value that ends in '}' cannot be followed by 'else'; "
                + "put the value in parentheses", cur(p).span)
    }
    skipToken(p, "else")
    let otherwise = parseBlock(p)
    let tails = Vec.new(2)
    tailCalls(otherwise, tails)
    Vec.push(p.letElses, LetElse {
        block = otherwise, completion = completion(otherwise), tailCalls = tails,
    })
    let names = patternVars(pat)
    let vars = Vec.map(names, fun(n) = madePat(p, pat.span, PVar(n)))
    let refs = Vec.map(names, fun(n) = madeExpr(p, pat.span, EVar(n, False)))
    let (bound, out) = match len(names) {
        0 -> (madePat(p, pat.span, PWild), madeExpr(p, pat.span, EUnit))
        1 -> (vars[0], refs[0])
        _ -> (madePat(p, pat.span, PTuple(vars)), madeExpr(p, pat.span, ETuple(refs)))
    }
    let m = madeExpr(p, s, EMatch(value, [
        madeArm(pat.span, [pat], [], out),
        madeArm(otherwise.span, [madePat(p, otherwise.span, PWild)], [], otherwise),
    ]))
    mkStmt(p, s, if mutable { SVar(bound, m) } else { SLet(bound, m) })
}

-- Collect into `out` the calls in `e`'s tail positions: its value, through
-- the last statement of a block, both branches of an `if` and every arm of a
-- `match`.
fun tailCalls(e : Expr, out : Vec Expr) -> Unit = match e.kind {
    ECall(_, _) -> Vec.push(out, e)
    EBlock(stmts) -> if len(stmts) > 0 {
        if let SExpr(last) = stmts[len(stmts) - 1].kind { tailCalls(last, out) }
    }
    EIf(_, then, otherwise) -> {
        tailCalls(then, out)
        if let Some(o) = otherwise { tailCalls(o, out) }
    }
    EMatch(_, arms) -> for arm in arms { tailCalls(arm.body, out) }
    _ -> {}
}

fun parseStmt(p : P) -> Stmt {
    if at(p, "let") || at(p, "var") { return parseBindingStmt(p) }
    if at(p, "fun") && Token.kindName(peek(p, 1).kind) == "IDENT" {
        let s = cur(p).span
        return mkStmt(p, s, SFun(parseFunDecl(p, False)))
    }
    let s = cur(p).span
    let saved = setNoRecord(p, False)
    let e = parseExpr(p)
    -- Assignment: the grammar puts these only in the C-style `for` header, but
    -- blocks plainly need them too.
    if at(p, "=") {
        step(p)
        checkAssignable(p, e, s)
        refusePlaceholder(p, e, "the target of an assignment")
        let value = closeWhole(p, parseExpr(p))
        p.noRecord = saved
        return mkStmt(p, s, SAssign(e, value))
    }
    p.noRecord = saved
    mkStmt(p, s, SExpr(closeWhole(p, e)))
}

fun checkAssignable(p : P, e : Expr, s : Span) -> Unit = match e.kind {
    EProject(_, index) ->
        oops(p, "cannot assign to the tuple component '." + Int.toString(index)
                + "'; build a new tuple instead", s)
    EVar(_, _) -> {}
    EField(_, _) -> {}
    EIndex(_, _, _, _) -> {}
    _ -> oops(p, "this expression cannot be assigned to; the left side of '=' "
                 + "must be a variable, a record field or an array element", s)
}

fun parseBlock(p : P) -> Expr {
    let s = expect(p, "{").span
    let saved = setNoRecord(p, False)
    let stmts = Vec.new(8)
    skipNewlines(p)
    while !at(p, "}") {
        if at(p, "EOF") { oops(p, "this block has no closing '}'", s) }
        Vec.push(stmts, parseStmt(p))
        endOfStatement(p)
    }
    skipToken(p, "}")
    p.noRecord = saved
    mkExpr(p, s, EBlock(stmts))
}

-- -- patterns ------------------------------------------------------------------------

-- Parses a pattern, alternatives included: `p1 | p2 | ...` is one `POr`.
-- Patterns sit between delimiters wherever this is called, so a `|` after one
-- can only be another alternative.
fun parsePattern(p : P) -> Pat {
    let first = parseAlternative(p)
    if !at(p, "|") { return first }
    let alts = [first]
    while eat(p, "|") {
        skipNewlines(p)
        Vec.push(alts, parseAlternative(p))
    }
    mkPat(p, first.span, POr(alts))
}

-- Parses one alternative: a pattern with no `|` outside brackets, which an
-- annotation may follow.
fun parseAlternative(p : P) -> Pat {
    let pattern = parsePatternAtom(p)
    if at(p, ":") {
        step(p)
        return mkPat(p, pattern.span, PAnnot(pattern, parseTypeExpr(p)))
    }
    pattern
}

fun parsePatternAtom(p : P) -> Pat {
    let tok = cur(p)
    match kindOf(p) {
        "IDENT" -> {
            step(p)
            if text(tok) == "_" {
                mkPat(p, tok.span, PWild)
            } else {
                mkPat(p, tok.span, PVar(text(tok)))
            }
        }
        "CONID" -> parseConPattern(p)
        "INT" | "FLOAT" | "STRING" | "CHAR" -> {
            step(p)
            mkPat(p, tok.span, PLit(literalOf(tok)))
        }
        "(" -> parseParenPattern(p, tok)
        _ -> oops(p, "expected a pattern, found " + describe(tok), tok.span)
    }
}

fun parseParenPattern(p : P, tok : Token) -> Pat {
    step(p)
    let elems = Vec.new(2)
    Vec.push(elems, parsePattern(p))
    while eat(p, ",") {
        if at(p, ")") {
            if len(elems) == 1 {
                oops(p, "a tuple cannot have just one component; remove the "
                        + "trailing ','", cur(p).span)
            }
            break
        }
        Vec.push(elems, parsePattern(p))
    }
    skipToken(p, ")")
    if len(elems) == 1 { return elems[0] }
    mkPat(p, tok.span, PTuple(elems))
}

fun literalOf(tok : Token) -> Lit = match tok.value {
    VInt(n) -> LInt(n)
    VFloat(x) -> LFloat(x)
    VChar(c) -> LChar(c)
    VText(s) -> LString(s)
    VNone -> LString("")
}

fun parseConPattern(p : P) -> Pat {
    let tok = expect(p, "CONID")
    -- Qualified as in an expression, `G.Point(x, y)`, and resolved the same way
    -- by module: a constructor imported only under a qualifier could not
    -- otherwise be matched at all.
    let con = dottedFrom(p, tok)
    if at(p, "{") {
        step(p)
        skipNewlines(p)
        let fields = Vec.new(4)
        var rest = False
        while !at(p, "}") {
            if eat(p, "..") {
                -- The rest, deliberately unnamed; last, or it is not the rest.
                rest = True
                let _ = fieldSeparator(p)
                if !at(p, "}") {
                    oops(p, "'..' is not last in this record pattern; move it "
                            + "to the end", cur(p).span)
                }
                break
            }
            let name = expectWhat(p, "IDENT", "a field name")
            -- Punning: `C { x }` binds `x` from field `x`.
            var sub = mkPat(p, name.span, PVar(text(name)))
            if eat(p, "=") { sub = parsePattern(p) }
            Vec.push(fields, (text(name), sub))
            if !fieldSeparator(p) { break }
        }
        skipToken(p, "}")
        return mkPat(p, tok.span, PRecord(con, fields, rest))
    }
    let args = Vec.new(2)
    if at(p, "(") {
        step(p)
        while !at(p, ")") {
            Vec.push(args, parsePattern(p))
            if !eat(p, ",") { break }
        }
        skipToken(p, ")")
    } else if atAny(p, patternStart) {
        oops(p, "the arguments of '" + con + "' are not in parentheses; write '"
                + con + "(...)'", cur(p).span)
    }
    mkPat(p, tok.span, PCon(con, args))
}

-- -- expressions ---------------------------------------------------------------------

fun parseExpr(p : P) -> Expr {
    let e = parseChain(p)
    if at(p, ":") {
        step(p)
        return mkExpr(p, e.span, EAnnot(e, parseTypeExpr(p)))
    }
    e
}

-- Binary operators, read flat: how `a + b * c` groups is decided by
-- `Turkey.Resolve`, once every operator's precedence group is known. Nothing
-- here knows a precedence, so nothing here needs an import.
fun parseChain(p : P) -> Expr {
    let first = parseUnary(p)
    if !atBinaryOperator(p) { return first }
    let operands = Vec.new(4)
    let ops = Vec.new(4)
    Vec.push(operands, first)
    while atBinaryOperator(p) {
        let tok = advance(p)
        Vec.push(ops, (text(tok), tok.span))
        Vec.push(operands, parseUnary(p))
    }
    mkExpr(p, first.span, EChain(operands, ops))
}

-- Every operator run is a binary operator except the ones that are
-- punctuation -- `=`, `->`, `~` -- and the prefix `!`.
fun atBinaryOperator(p : P) -> Bool =
    isOperatorRun(cur(p)) && !atAny(p, notBinary)

let notBinary = ["=", "->", "~", "!"]

fun parseUnary(p : P) -> Expr {
    if isOperatorRun(cur(p)) && !at(p, "!") && !at(p, "-") {
        let hint = splitHint(cur(p))
        if hint != "" {
            oops(p, "expected an expression, found " + describe(cur(p)) + hint,
                 cur(p).span)
        }
    }
    if at(p, "!") || at(p, "-") {
        let tok = advance(p)
        let op = Token.kindName(tok.kind)
        var fn : Option Expr = None
        if op == "-" { fn = Some(method(p, tok.span, "neg")) }
        return mkExpr(p, tok.span, EUnary(op, parseUnary(p), fn))
    }
    parsePostfix(p)
}

fun parsePostfix(p : P) -> Expr {
    var e = parseAtom(p)
    loop {
        if at(p, "(") {
            step(p)
            let saved = setNoRecord(p, False)
            let args = Vec.new(4)
            while !at(p, ")") {
                Vec.push(args, closePart(p, parseExpr(p)))
                if !eat(p, ",") { break }
            }
            skipToken(p, ")")
            p.noRecord = saved
            e = closeAround(p, mkExpr(p, e.span, ECall(e, args)), args)
        } else if at(p, "[") {
            step(p)
            let saved = setNoRecord(p, False)
            let index = closePart(p, parseExpr(p))
            p.noRecord = saved
            skipToken(p, "]")
            e = closeAround(p, mkExpr(p, e.span, EIndex(e, index, None, None)), [index])
        } else if at(p, ".") && memberFollows(p) {
            step(p)
            let member = advance(p)
            match member.kind {
                KInt -> { e = mkExpr(p, e.span, EProject(e, intOf(member))) }
                _ -> { e = mkExpr(p, e.span, EField(e, text(member))) }
            }
        } else if at(p, "?") {
            -- A suffix like the other three, so it binds tighter
            -- than any operator and chains with them. `bind` is
            -- marked, so a program's own `bind` is not what a `?`
            -- means.
            step(p)
            e = mkExpr(p, e.span,
                       EQuestion(e, Some(method(p, e.span, "bind"))))
        } else {
            break
        }
    }
    e
}

fun memberFollows(p : P) -> Bool = match Token.kindName(peek(p, 1).kind) {
    "IDENT" | "INT" -> True
    _ -> False
}

fun intOf(tok : Token) -> Int = match tok.value {
    VInt(n) -> n
    _ -> 0
}

-- Dispatch on the current token's kind, which is what `turkey/parser.py` does
-- with a chain of `if kind == ...`. A `match` on the kind name says the same
-- thing and says that it is a table.
fun parseAtom(p : P) -> Expr {
    let tok = cur(p)
    match kindOf(p) {
        "INT" | "FLOAT" | "STRING" | "CHAR" -> {
            step(p)
            mkExpr(p, tok.span, ELit(literalOf(tok)))
        }
        "IDENT" -> {
            step(p)
            if text(tok) == "_" { p.pending = p.pending + 1 }
            mkExpr(p, tok.span, EVar(text(tok), False))
        }
        "\\" -> parseExplicit(p, tok)
        "CONID" -> parseConidAtom(p)
        "(" -> parseParenAtom(p, tok)
        "[" -> parseArrayAtom(p, tok)
        "{" -> parseBlock(p)
        "do" -> {
            step(p)
            mkExpr(p, tok.span, EDo(parseBlock(p)))
        }
        "fun" -> {
            step(p)
            let params = parseParamList(p)
            var ret : Option Type = None
            if eat(p, "->") { ret = Some(parseTypeExpr(p)) }
            mkExpr(p, tok.span, ELambda(params, ret, parseFunBody(p)))
        }
        "if" -> parseIf(p)
        "while" -> {
            step(p)
            var lead : Vec Expr = []
            if !at(p, "let") && !at(p, "var") {
                let cond = parseScrutinee(p, "the condition of 'while'")
                if !at(p, ",") { return mkExpr(p, tok.span, EWhile(cond, parseBlock(p))) }
                lead = [cond]
            }
            -- `while c1, c2, ... { B }` is `loop { match ... { A -> B, _ -> break } }`,
            -- where `A` is the guarded arm the conditions become, as for `if`.
            -- A condition failing is what ends the loop.
            let s = tok.span
            let (value, patterns, guards, body) = parseConditions(p, "'while'", lead)
            let m = madeExpr(p, s, EMatch(value, [
                madeArm(s, patterns, guards, body),
                madeArm(s, [madePat(p, s, PWild)], [], madeExpr(p, s, EBreak(None))),
            ]))
            return mkExpr(p, s, ELoop(madeExpr(p, s, EBlock([madeStmt(p, s, SExpr(m))]))))
        }
        "for" -> parseFor(p)
        "loop" -> {
            step(p)
            mkExpr(p, tok.span, ELoop(parseBlock(p)))
        }
        "match" -> parseMatch(p)
        "return" -> {
            step(p)
            mkExpr(p, tok.span, EReturn(parseOptionalValue(p)))
        }
        "break" -> {
            step(p)
            mkExpr(p, tok.span, EBreak(parseOptionalValue(p)))
        }
        "continue" -> {
            step(p)
            mkExpr(p, tok.span, EContinue)
        }
        _ -> oops(p, "expected an expression, found " + describe(tok), tok.span)
    }
}

-- `()` is Unit, `(e)` is grouping, and `(e, ...)` is a tuple.
fun parseParenAtom(p : P, tok : Token) -> Expr {
    step(p)
    if at(p, ")") {
        step(p)
        return mkExpr(p, tok.span, EUnit)
    }
    let saved = setNoRecord(p, False)
    let elems = Vec.new(2)
    Vec.push(elems, parseExpr(p))
    while eat(p, ",") {
        if at(p, ")") {
            if len(elems) == 1 {
                oops(p, "a tuple cannot have just one component; remove the "
                        + "trailing ','", cur(p).span)
            }
            break
        }
        Vec.push(elems, parseExpr(p))
    }
    skipToken(p, ")")
    p.noRecord = saved
    -- Grouping parentheses are not a boundary: they exist for precedence, so
    -- `(_ + 1) * 2` is one function. A tuple's components are.
    if len(elems) == 1 { return elems[0] }
    let parts = Vec.map(elems, closePart(p, _))
    closeAround(p, mkExpr(p, tok.span, ETuple(parts)), parts)
}

fun parseArrayAtom(p : P, tok : Token) -> Expr {
    step(p)
    let saved = setNoRecord(p, False)
    let elems = Vec.new(4)
    while !at(p, "]") {
        Vec.push(elems, closePart(p, parseExpr(p)))
        if !eat(p, ",") { break }
    }
    skipToken(p, "]")
    p.noRecord = saved
    closeAround(p, mkExpr(p, tok.span, EArray(elems)), elems)
}

-- A CONID atom is a constructor, a record construction, or -- when followed by
-- `.` and a lowercase name -- a qualified variable.
fun parseConidAtom(p : P) -> Expr {
    let tok = expect(p, "CONID")
    let name = dottedFrom(p, tok)
    -- A trailing lowercase name makes the whole chain a qualified *variable*:
    -- `Data.Vec.push`, not the constructor `Data.Array` applied to anything.
    if at(p, ".") && Token.kindName(peek(p, 1).kind) == "IDENT" {
        step(p)
        return mkExpr(p, tok.span, EVar(name + "." + text(advance(p)), False))
    }
    if at(p, "{") && !p.noRecord {
        step(p)
        skipNewlines(p)
        let fields = Vec.new(4)
        let saved = setNoRecord(p, False)
        while !at(p, "}") {
            let fname = expectWhat(p, "IDENT", "a field name")
            -- Punning: `C { x }` is `C { x = x }`, as in patterns.
            var value = mkExpr(p, fname.span, EVar(text(fname), False))
            if eat(p, "=") { value = closePart(p, parseExpr(p)) }
            Vec.push(fields, (text(fname), value))
            if !fieldSeparator(p) { break }
        }
        p.noRecord = saved
        skipToken(p, "}")
        let record = mkExpr(p, tok.span, ERecord(name, fields))
        return closeAround(p, record, Vec.map(fields, fun((_, value)) = value))
    }
    mkExpr(p, tok.span, ECon(name))
}

-- The value of `return` or `break`, which is a whole: `return _ * n` answers
-- the function, as `_ * n` on the last line of a block does.
fun parseOptionalValue(p : P) -> Option Expr {
    if atAny(p, exprStart) { return Some(closeWhole(p, parseExpr(p))) }
    None
}

fun parseScrutinee(p : P, what : String) -> Expr {
    let saved = setNoRecord(p, True)
    let e = parseExpr(p)
    p.noRecord = saved
    refusePlaceholder(p, e, what)
    e
}

fun parseIf(p : P) -> Expr {
    let s = expect(p, "if").span
    if at(p, "let") || at(p, "var") { return parseIfLet(p, s, []) }
    let cond = parseScrutinee(p, "the condition of 'if'")
    if at(p, ",") { return parseIfLet(p, s, [cond]) }
    let then = parseBlock(p)
    var otherwise : Option Expr = None
    if eat(p, "else") {
        if at(p, "if") { otherwise = Some(parseIf(p)) }
        else { otherwise = Some(parseBlock(p)) }
    }
    mkExpr(p, s, EIf(cond, then, otherwise))
}

-- Parses the rest of an `if` whose head is a condition list, and returns the
-- `match` it means: one arm that runs the then-block, guarded by the later
-- conditions, and `_ -> B`. When the first condition is `let p = e`, the
-- `match` is on `e` and the arm's pattern is `p`; when it is a test, the
-- `match` is on `()` and every condition is a guard. Without an `else`, `B`
-- is `()`. `lead` holds the test the head began with, if the caller has read it.
--
-- Build it here rather than in a later pass: nothing downstream needs to know
-- the form existed, and a guarded `match` is what every stage already handles.
fun parseIfLet(p : P, s : Span, lead : Vec Expr) -> Expr {
    let (value, patterns, guards, then) = parseConditions(p, "'if'", lead)
    var otherwise = madeExpr(p, s, EUnit)
    if eat(p, "else") {
        if at(p, "if") { otherwise = parseIf(p) }
        else { otherwise = parseBlock(p) }
    }
    mkExpr(p, s, EMatch(value, [
        madeArm(s, patterns, guards, then),
        madeArm(s, [madePat(p, s, PWild)], [], otherwise),
    ]))
}

-- Parses the conditions of an `if` or `while` head and the block after them,
-- and returns the one guarded arm they become: the value it matches, its
-- patterns, its guards, and its body. Raises a parse error for two tests in a
-- row, which `a && b` already says.
--
-- A `var` condition prefixes the block with `var x = x` for each binder, in
-- pattern order, so that only the block can assign them.
fun parseConditions(p : P, construct : String, lead : Vec Expr)
        -> (Expr, Vec Pat, Vec Guard, Expr) {
    let s = cur(p).span
    let guards : Vec Guard = Vec.map(lead, GTest)
    let assignable : Vec Pat = []
    var afterTest = len(lead) > 0
    var more = len(lead) == 0 || eat(p, ",")
    while more {
        skipNewlines(p)
        if at(p, "{") {
            oops(p, "expected a condition after ','", cur(p).span)
        }
        if at(p, "let") || at(p, "var") {
            let mutable = at(p, "var")
            step(p)
            let saved = setNoRecord(p, False)
            let patterns = parseAlternatives(p)
            skipToken(p, "=")
            p.noRecord = saved
            let value = parseScrutinee(p, "the value a 'let' condition matches")
            if mutable { for pat in patterns { Vec.push(assignable, pat) } }
            Vec.push(guards, GLet(patterns, value))
            afterTest = False
        } else {
            let where = cur(p).span
            let test = parseScrutinee(p, "the condition of " + construct)
            if afterTest {
                oops(p, "two tests in a row cannot be separated by ','; join them "
                        + "with '&&'", where)
            }
            Vec.push(guards, GTest(test))
            afterTest = True
        }
        more = eat(p, ",")
    }
    var body = parseBlock(p)
    if len(assignable) > 0 {
        let stmts = []
        let seen : Vec String = []
        for pat in assignable {
            for name in patternVars(pat) {
                if !Vec.contains(seen, name) {
                    Vec.push(seen, name)
                    Vec.push(stmts, madeStmt(p, s, SVar(madePat(p, s, PVar(name)),
                                                        madeExpr(p, s, EVar(name, False)))))
                }
            }
        }
        match body.kind {
            EBlock(inner) -> for st in inner { Vec.push(stmts, st) }
            _ -> {}
        }
        body = madeExpr(p, body.span, EBlock(stmts))
    }
    match guards[0] {
        GLet(patterns, value) ->
            (value, patterns, Vec.slice(guards, 1, len(guards)), body)
        GTest(_) -> (madeExpr(p, s, EUnit), [madePat(p, s, PWild)], guards, body)
    }
}

-- Parses `p1 | p2 | ...`, the patterns of a `match` arm or a `let` condition,
-- as a list rather than one `POr`.
fun parseAlternatives(p : P) -> Vec Pat {
    let patterns = Vec.new(2)
    Vec.push(patterns, parseAlternative(p))
    while eat(p, "|") {
        skipNewlines(p)
        Vec.push(patterns, parseAlternative(p))
    }
    patterns
}

-- `for pat in expr` and the C-style header are told apart by the `in`, found by
-- scanning for the keyword itself at bracket depth zero, before the loop's body
-- or the first `;`. A nested `for ... in` is inside braces, so it is never at
-- depth zero here.
fun parseFor(p : P) -> Expr {
    let s = expect(p, "for").span
    if forInFollows(p) {
        let saved = setNoRecord(p, False)
        let pattern = parsePattern(p)
        p.noRecord = saved
        skipToken(p, "in")
        let iterable = parseScrutinee(p, "the sequence of 'for'")
        let body = parseBlock(p)
        return mkExpr(p, s, EForIn(
            pattern, iterable, body,
            Some(method(p, iterable.span, "iter")),
            Some(method(p, iterable.span, "next"))))
    }
    let saved = setNoRecord(p, False)
    var init : Option Stmt = None
    if !at(p, "NEWLINE") { init = Some(parseStmt(p)) }
    skipWhat(p, "NEWLINE", "';' after the loop initializer")
    let cond = parseExpr(p)
    refusePlaceholder(p, cond, "the condition of 'for'")
    skipWhat(p, "NEWLINE", "';' after the loop condition")
    var step : Option Stmt = None
    if !at(p, "{") { step = Some(parseStmt(p)) }
    p.noRecord = saved
    mkExpr(p, s, EForC(init, cond, step, parseBlock(p)))
}

fun forInFollows(p : P) -> Bool {
    var depth = 0
    var j = p.i
    while j < len(p.toks) {
        let kind = Token.kindName(p.toks[j].kind)
        if kind == "(" || kind == "[" || kind == "{" {
            -- A `{` right after a constructor name opens a record pattern, not
            -- the loop body: `for Arm { body, .. } in arms`. Treating it as the
            -- body here would end the scan before it reached the `in`.
            let afterCon = j > p.i && Token.kindName(p.toks[j - 1].kind) == "CONID"
            if depth == 0 && kind == "{" && !afterCon { return False }
            depth = depth + 1
        } else if kind == ")" || kind == "]" || kind == "}" {
            if depth == 0 { return False }
            depth = depth - 1
        } else if depth == 0 {
            if kind == "in" { return True }
            if kind == "NEWLINE" || kind == "EOF" { return False }
        }
        j = j + 1
    }
    False
}

fun parseMatch(p : P) -> Expr {
    let s = expect(p, "match").span
    let scrutinee = parseScrutinee(p, "the value 'match' inspects")
    skipToken(p, "{")
    let saved = setNoRecord(p, False)
    let arms = Vec.new(4)
    skipNewlines(p)
    while !at(p, "}") {
        if at(p, "EOF") { oops(p, "this 'match' has no closing '}'", s) }
        Vec.push(arms, parseMatchArm(p))
        if at(p, "NEWLINE") {
            skipNewlines(p)
        } else if !at(p, "}") {
            oops(p, "expected the next match arm, found " + describe(cur(p)),
                 cur(p).span)
        }
    }
    skipToken(p, "}")
    p.noRecord = saved
    if len(arms) == 0 {
        oops(p, "this 'match' has no arms; add at least one 'pattern -> value' arm", s)
    }
    mkExpr(p, s, EMatch(scrutinee, arms))
}

fun parseMatchArm(p : P) -> Arm {
    -- `|` only separates the patterns of one arm. An arm cannot begin with
    -- one: the newline before a `|` is dropped, so a `|` opening a line would
    -- join the previous arm's body, and arms are separated by a line break or
    -- `;` already.
    if at(p, "|") {
        oops(p, "a match arm cannot begin with '|'; remove it, and separate arms "
                + "with a line break or ';'", cur(p).span)
    }
    let s = cur(p).span
    let patterns = parseAlternatives(p)
    skipWhat(p, "->", "'->' after the arm's patterns")
    let body = closeWhole(p, parseExpr(p))
    Arm { span = close(p, s), patterns = patterns, guards = [], body = body }
}

-- -- lambda shorthand -----------------------------------------------------------------
--
-- `_` in an expression is a placeholder. The parser reads it as `EVar("_")`, a
-- name no program can bind, and rewrites it into the parameter of a function
-- before the node leaves this module. Which function is decided by the
-- *boundary* that closes it.
--
-- A *part* -- a call argument, an index, a tuple component, an array element, a
-- record field -- closes the `_`s inside it, except that a bare `_` makes the
-- function of the node it is a part of. That is what makes `pow(_, 2)` the
-- function rather than the `_`. The node closes as soon as it is read, so
-- nothing around it joins the function: `xs |> map(_, f) |> filter(_, g)` is
-- two functions, and `show(_) + "!"` adds a function to a string.
--
-- A *whole* -- a statement, including a block's last; a `let` right-hand side;
-- a `fun` body; a match arm; the value of `return` or `break` -- closes the
-- same way, and a bare `_` there is an error, having nothing further out to
-- belong to.
--
-- A condition, a scrutinee, an iterable and an assignment target refuse a `_`
-- outright: the function one would make there could never be used.
--
-- Everything else is transparent: operators, field access, projection, `?`,
-- `:`, a callee, and grouping parentheses, which never become a node.
--
-- Inside `\` none of that applies. Every `_` belongs to the nearest enclosing
-- `\`, through any `fun` in between, and they are all the one parameter.
--
-- Boundaries close bottom-up, as the parser returns from them. So when one
-- looks, every `_` beneath a nested boundary has been rewritten already, and a
-- bare part has been closed by the node around it -- and walking the whole
-- expression finds exactly the `_`s this boundary owns.

fun isPlaceholder(e : Expr) -> Bool = match e.kind {
    EVar(name, _) -> name == "_"
    _ -> False
}

fun placeholders(e : Expr) -> Vec Expr {
    let out = Vec.new(2)
    collectPlaceholders(ChExpr(e), out)
    out
}

fun collectPlaceholders(c : Child, out : Vec Expr) -> Unit {
    match c {
        ChExpr(e) -> {
            if isPlaceholder(e) {
                Vec.push(out, e)
                return {}
            }
        }
        _ -> {}
    }
    for child in children(c) { collectPlaceholders(child, out) }
}

fun closePart(p : P, e : Expr) -> Expr {
    if p.pending == 0 || p.explicit > 0 || isPlaceholder(e) { return e }
    closeImplicit(p, e)
}

fun closeAround(p : P, e : Expr, parts : Vec Expr) -> Expr {
    if p.pending == 0 || p.explicit > 0 { return e }
    for part in parts {
        if isPlaceholder(part) { return closeImplicit(p, e) }
    }
    e
}

fun closeWhole(p : P, e : Expr) -> Expr {
    if p.pending == 0 || p.explicit > 0 { return e }
    if isPlaceholder(e) {
        oops(p, "'_' on its own is not a function; write 'fun(x) = x'", e.span)
    }
    closeImplicit(p, e)
}

fun closeImplicit(p : P, e : Expr) -> Expr {
    let found = placeholders(e)
    if len(found) == 0 { return e }
    if len(found) > 1 {
        oops(p, "'_' appears more than once in this function; start it with '\\' "
                + "to make every '_' the same parameter, or write 'fun(a, b) = ...'",
             found[1].span)
    }
    shorthandLambda(p, e, found, e.span)
}

fun refusePlaceholder(p : P, e : Expr, what : String) -> Unit {
    let message = "'_' cannot be used in " + what
    -- A bare part has made its node a function before the condition is read,
    -- so `if Array.contains(_, 2)` leaves no `_` pending: the function is here.
    match e.kind {
        ELambda(params, _, _) -> if isShorthand(e) { oops(p, message, params[0].span) }
        _ -> {}
    }
    if p.pending == 0 || p.explicit > 0 { return {} }
    let found = placeholders(e)
    if len(found) > 0 { oops(p, message, found[0].span) }
}

-- `\e` is `fun(x) = e` with every `_` it owns as `x`, and reaches as far right
-- as a `fun` body does. A nested `\` has claimed its own `_`s by the time this
-- one looks, so what is left is this one's.
fun parseExplicit(p : P, tok : Token) -> Expr {
    step(p)
    let saved = setNoRecord(p, False)
    p.explicit = p.explicit + 1
    let body = parseExpr(p)
    p.explicit = p.explicit - 1
    p.noRecord = saved
    let found = placeholders(body)
    if len(found) == 0 {
        oops(p, "'\\' has no '_' after it; remove the '\\', or use '_' for "
                + "the parameter", tok.span)
    }
    shorthandLambda(p, body, found, close(p, tok.span))
}

-- `s` is the whole span of the function: of the `\` and its body, or of the
-- expression a `_` made into a function.
fun shorthandLambda(p : P, body : Expr, found : Vec Expr, s : Span) -> Expr {
    let name = shorthandPrefix + Int.toString(freshId(p))
    for placeholder in found { placeholder.kind = EVar(name, False) }
    p.pending = p.pending - len(found)
    exprNode(p, s, ELambda([madePat(p, found[0].span, PVar(name))], None, body))
}
