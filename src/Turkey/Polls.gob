module Turkey.Polls (insert)

-- Polls: where a worker running a loop stops for a collection.
--
-- With several workers, a collection stops every worker at a safepoint first.
-- A worker reaches one whenever it allocates past its cursor or calls, but a
-- loop may do neither for as long as it likes, and every other worker would
-- wait for it. So every loop's back edge gets a `Poll`: a test of the worker's
-- stop word, and a call to the runtime (`turkey_poll`) when a stop has been
-- asked for.
--
-- A `Poll` is one instruction until the frame is laid out, and not a call to
-- the register allocator, which keeps each value in one place for its whole
-- life: a call in the loop, however rarely taken, would move every value live
-- across the loop out of the registers a call clobbers, and that cost the
-- self-compile 6.8%. The call is written after allocation instead
-- (`Turkey.Emit.poll`), off the loop's path, saving exactly the registers
-- that are live there and storing the roots that are.
--
-- Every back edge, without trying to prove that the loop's body already
-- reaches a safepoint on every iteration: a call or an allocation that is
-- conditional does not, and an allocation reaches the runtime only once its
-- cursor's word runs out.
--
-- Not in the runtime's own modules (`Turkey.Giblets`): the collector's loops
-- run with every other worker stopped, and code that may not allocate may not
-- call something that collects.

import Turkey.LowIr as L
import Turkey.LowIr (Op(..), Low(..))
import Turkey.Ssa as Ssa
import Turkey.Ssa (BlockId(..), RepClass(..), Term(..))

-- Add a poll to every back edge of `f`: an edge to a block that dominates
-- the block it leaves.
fun insert(f : Ssa.Func Low) -> Unit {
    let idom = Ssa.dominators(f)
    let edges = []
    for var b = 0; b < len(f.blocks); b = b + 1 {
        -- An unreachable block has no dominator, and its edges are not loops.
        match idom[b] {
            None -> {}
            Some(_) -> for target in Ssa.successors(f.blocks[b].term) {
                if Ssa.dominates(idom, target, BlockId(b)) {
                    Array.push(edges, (b, Ssa.blockId(target)))
                }
            }
        }
    }
    for (from, header) in edges { poll(f, from, header) }
}

-- Put a poll on the edge from `from` to `header`: at the end of `from` when it
-- jumps there, and in a block of its own on a branch's arm, whose target takes
-- no arguments.
fun poll(f : Ssa.Func Low, from : Int, header : Int) -> Unit {
    let edge = match f.blocks[from].term {
        Jump(_, _) -> from
        Branch(c, yes, no) -> {
            Array.push(f.blocks, Ssa.newBlock())
            let made = len(f.blocks) - 1
            f.blocks[made].term = Jump(BlockId(header), [])
            f.blocks[from].term = if Ssa.blockId(yes) == header {
                Branch(c, BlockId(made), no)
            } else {
                Branch(c, yes, BlockId(made))
            }
            made
        }
        _ -> return
    }
    let done = Ssa.freshValue(f, Ssa.untraced(Unit))
    Array.push(f.blocks[edge].insts, L.low(done, Poll))
}
