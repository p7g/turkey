export (Files(..), files, fileName, Site(..), Cache, cache, fromSpan, pack, notStmt,
        isStmt, line, column, file, site, describe)

--- A source position packed into one `Int`, as every instruction from the low
--- IR to emission carries it.
---
--- From the low bit:
---
--- | field   | bits | meaning                                            |
--- |---------|------|----------------------------------------------------|
--- | notStmt | 1    | the position is not a stepping target              |
--- | column  | 10   | 0 unknown, saturates at 1023                       |
--- | line    | 20   | 0 means no position at all, saturates at 1,048,575 |
--- | file    | 14   | index into the program's `Files`, from 1           |
--- | site    | 18   | inline site, 0 when not inlined                    |
---
--- An inline site is the function's own `Site` numbered from 1. A position
--- with one is the callee's own text, and the site says which call it was
--- inlined through.
---
--- The whole is 63 bits, so a position is never negative. A position with no
--- line is 0 in every bit, whatever else was asked for: `notStmt(0)` is 0.
---
--- One word rather than a `Span` because it rides on every instruction, and a
--- word costs nothing to copy and nothing to trace. It is decoded only to be
--- printed or written as debug information, never to decide code.

import Turkey.Source as Source
import Turkey.Source (Span(..), InlineSite(..))

let columnShift = 1
let lineShift = 11
let fileShift = 31
let siteShift = 45

let columnMax = 1023
let lineMax = 1048575
let fileMax = 16383
let siteMax = 262143

--- The program's source files, numbered from 1 in the order they were given.
---
--- Built once, before lowering, and only read after that, so the lowering's
--- workers share one.
type Files = Files {
    names : Array String,
    index : Map String Int,
}

--- Returns the table numbering `names` from 1, in order. A name given twice
--- keeps its first number.
fun files(names : Vec String) -> Files {
    let index = Map.new()
    let kept = []
    for name in names {
        if Option.isNone(Map.get(index, name)) && len(kept) < fileMax {
            Vec.push(kept, name)
            Map.put(index, name, len(kept))
        }
    }
    Files { names = Vec.toArray(kept), index = index }
}

--- Returns the name of file `n`, or `None` for 0 or a number the table does
--- not have.
fun fileName(fs : Files, n : Int) -> Option String =
    if n >= 1 && n <= len(fs.names) { Some(fs.names[n - 1]) } else { None }

--- A call one function's code was inlined through: the name of the function
--- inlined, and the position of the call, whose own site is the call that one
--- was inlined through in turn, or 0 for a call in the function itself.
---
--- A function's sites are numbered from 1 in the order its positions first
--- name them, so a site's parent always has a smaller number.
type Site = Site { callee : String, call : Int }

--- The program's files, a one-entry memo of the last file looked up, and the
--- sites of the function whose positions are being made, with an index of
--- them by call position.
---
--- Consecutive spans are almost always in one file, so comparing a span's path
--- with the last one replaces a hash and a table lookup per instruction.
type Cache = Cache {
    files     : Files,
    var name  : String,
    var found : Int,
    sites     : Vec Site,
    byCall    : Map Int (Vec Int),
}

--- Returns a cache that numbers inline sites into `sites`.
fun cache(fs : Files, sites : Vec Site) -> Cache =
    Cache { files = fs, name = "", found = 0, sites = sites, byCall = Map.new() }

--- Returns the position of the start of `s`, a statement, with the site of
--- the call it was inlined through, or 0 when `s` is in a file the table does
--- not have. A new site is appended to the cache's sites.
---
--- Past the field's width, inlined text takes the position of its outermost
--- call instead, as though it had not been inlined.
fun fromSpan(c : Cache, s : Span) -> Int {
    let at = match s.inlined {
        None -> 0
        Some(inner) -> siteOf(c, inner)
    }
    if at < 0 { return fromSpan(c, Source.outermost(s)) }
    if s.file != c.name {
        c.name = s.file
        c.found = Map.getOr(c.files.index, s.file, 0)
    }
    if c.found == 0 { 0 } else { pack(c.found, s.line, s.col) | (at << siteShift) }
}

-- Returns the number of `site` in the cache's sites, adding it and its
-- parents if they are not there, or -1 when there is no room.
fun siteOf(c : Cache, site : InlineSite) -> Int {
    let call = fromSpan(c, site.call)
    let same = Map.getOr(c.byCall, call, [])
    for k in same {
        if c.sites[k - 1].callee == site.callee { return k }
    }
    if len(c.sites) >= siteMax { return -1 }
    Vec.push(c.sites, Site { callee = site.callee, call = call })
    let made = len(c.sites)
    if len(same) == 0 { Map.put(c.byCall, call, [made]) } else { Vec.push(same, made) }
    made
}

--- Returns the statement position `file:line:col`, outside any inline site.
--- Each field saturates at its width; a line below 1 gives 0.
fun pack(fileNumber : Int, lineNumber : Int, col : Int) -> Int =
    if lineNumber < 1 || fileNumber < 1 { 0 }
    else {
        (clamp(fileNumber, fileMax) << fileShift)
            | (clamp(lineNumber, lineMax) << lineShift)
            | (clamp(col, columnMax) << columnShift)
    }

fun clamp(n : Int, most : Int) -> Int = if n < 0 { 0 } else if n > most { most } else { n }

--- Returns `p` marked as not a stepping target: a spill, a reload, a copy.
fun notStmt(p : Int) -> Int = if p == 0 { 0 } else { p | 1 }

fun isStmt(p : Int) -> Bool = (p & 1) == 0

fun line(p : Int) -> Int = (p >> lineShift) & lineMax

fun column(p : Int) -> Int = (p >> columnShift) & columnMax

fun file(p : Int) -> Int = (p >> fileShift) & fileMax

fun site(p : Int) -> Int = (p >> siteShift) & siteMax

--- Returns `p` as `file:line:col` for a dump, with ` ns` after a position that
--- is not a statement, and `-` for 0.
fun describe(fs : Files, p : Int) -> String =
    if p == 0 { "-" }
    else {
        Option.unwrapOr(fileName(fs, file(p)), "?") + ":" + Int.toString(line(p)) + ":"
            + Int.toString(column(p)) + (if isStmt(p) { "" } else { " ns" })
    }
