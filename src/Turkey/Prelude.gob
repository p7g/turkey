export (
    monadBind, monadPure,
    flowFall, flowBrk, flowCont, flowRet,
    typedClass, typeRepCon, proxyCon,
    eqClass, ordClass, hashClass, hasherClass, objectClass,
    debugClass, showClass, debugConstructor, debugRecord, debugObject,
    error,
    optionType, optionNone, optionSome,
    boolType, boolTrue, boolFalse,
    stringType,
    learnWellKnown, protocolMethod,
    preludeName, preludeQualifiers, wellKnownName, targetName, entryName, sep, internal,
    moduleOf,
)

--- The compiler's half of the Prelude (`turkey/prelude.py`).
---
--- The Prelude itself is ordinary source in `lib/Prelude.gob` and is loaded like
--- any other module. What is here is the handful of names the *compiler* has to
--- know, because it writes nodes naming them: what `?` desugars to, and what a
--- `return` crossing a `?` becomes. A program cannot change any of them by
--- shadowing, which is why they are constants here rather than lookups.
---
--- The names that reach an AST are already *internal* -- `Prelude#Fall`, not
--- `Fall` -- because desugaring runs after resolution and everything it writes
--- has to be spelled the way resolution would have spelled it.

--- What `?` is written in terms of, by the spellings `protocolMethod` takes.
let monadBind = "bind"
let monadPure = "pure"

--- What a `return`, `break` or `continue` becomes when it crosses a `?`.
--- Declared in the Prelude and exported by nothing, so only the lowering can
--- write one.
let flowFall = "Prelude#Fall"
let flowBrk = "Prelude#Brk"
let flowCont = "Prelude#Cont"
let flowRet = "Prelude#Ret"

-- The library declarations the compiler writes nodes naming, by their internal
-- names. They are not spelled out here: each is what `Turkey.WellKnown`
-- exports under the name `learnWellKnown` gives, so the library may keep them
-- in any module. Read once the program's modules are loaded, by
-- `Turkey.Modules`, before anything is resolved -- which is the first thing
-- that reads one.

--- Diverges, so it can stand in for a `Flow` arm the language's own rules make
--- unreachable -- a `break` where there is no loop -- which the exhaustiveness
--- checker has no way to know is unreachable.
var error = ""

--- Checked downcasting. `Typed` is a class a program may
--- name -- `cast[Typed a]` -- but not instance: its instances are derived, one
--- per type constructor, because a hand-written one could claim any type for
--- any value, and the comparison of reps *is* what a cast checks. GHC has
--- rejected user `Typeable` instances since 7.10 for the same reason.
var typedClass = ""
var typeRepCon = ""
var proxyCon = ""

--- The classes a type declaration may derive, and the class of what a derived
--- `Hash` feeds a value's parts to.
var eqClass = ""
var ordClass = ""
var hashClass = ""
var hasherClass = ""

--- Identity. Like `Typed`, a class a program may name but not instance: its
--- instances are derived for the types whose values have stable identity,
--- and an instance for any other type would compare words the compiler is
--- free to copy.
var objectClass = ""

--- Structural text, derived for every type, and what a derived `debug` is
--- written in: a constructor's text, a record's, and the guard an object's
--- text goes through.
var debugClass = ""
--- Text for a program's user, which a tuple derives as its `Debug`.
var showClass = ""
var debugConstructor = ""
var debugRecord = ""
var debugObject = ""

var optionType = ""
var optionNone = ""
var optionSome = ""

var boolType = ""
var boolTrue = ""
var boolFalse = ""

var stringType = ""

-- The class methods the compiler writes references to, by the spelling the
-- parser and desugaring mark each reference with: `-x` is `neg`, `xs[i]` and
-- `xs[i] = v` are `get` and `set`, `for` is `iter` and `next`, and `?` and
-- `do` are `bind` and `pure`. A reference means the method by its internal
-- name, so a program's own class with a method spelled alike does not capture
-- it.
let protocolSpellings = ["neg", "get", "set", "iter", "next", "bind", "pure"]
let protocolMethods : Map String String = Map.new()

--- Returns the internal name of the class method a compiler-written reference
--- marked `spelling` means, or `None` for a spelling that marks none.
fun protocolMethod(spelling : String) -> Option String = Map.get(protocolMethods, spelling)

--- Read every name above from `find`, which answers what `Turkey.WellKnown`
--- exports by a name in one of its namespaces: "type", "constructor", "class"
--- or "value".
fun learnWellKnown(find : fun(String, String) -> String) -> Unit {
    error = find("value", "error")
    typedClass = find("class", "Typed")
    typeRepCon = find("constructor", "TypeRep")
    proxyCon = find("constructor", "Proxy")
    eqClass = find("class", "Eq")
    ordClass = find("class", "Ord")
    hashClass = find("class", "Hash")
    hasherClass = find("class", "Hasher")
    objectClass = find("class", "Object")
    debugClass = find("class", "Debug")
    showClass = find("class", "Show")
    debugConstructor = find("value", "debugConstructor")
    debugRecord = find("value", "debugRecord")
    debugObject = find("value", "debugObject")
    optionType = find("type", "Option")
    optionNone = find("constructor", "None")
    optionSome = find("constructor", "Some")
    boolType = find("type", "Bool")
    boolTrue = find("constructor", "True")
    boolFalse = find("constructor", "False")
    stringType = find("type", "String")
    for spelling in protocolSpellings {
        Map.put(protocolMethods, spelling, find("value", spelling))
    }
}

let preludeName = "Prelude"

--- What comes with the Prelude besides its bare names: each module here is
--- imported under the last component of its name, `Data.Vec` as `Vec`, so every
--- module that has the Prelude writes `Vec.push` and `String.slice` without an
--- import of its own. `import Prelude ()` opts out of these with the rest.
let preludeQualifiers = [
    "Data.Array", "Data.Bool", "Data.Byte", "Data.Char", "Data.Either",
    "Data.Error", "Data.Float", "Data.Int", "Iter", "Data.Map",
    "Data.Option", "Data.Ordering", "Data.String", "Data.Vec", "FrozenArray",
]
let wellKnownName = "Turkey.WellKnown"
let targetName = "Target"
let entryName = "Main"

--- What a module's top-level binding is called once resolution has run. `#` is
--- not a character any surface name may contain, so an internal name can never
--- collide with one a program could write -- and a diagnostic can strip the
--- prefix back off without having to guess where a module name ends, which an
--- ordinary `.` would leave ambiguous against `Vec.push`.
let sep = "#"

fun internal(owner : String, name : String) -> String = owner + sep + name

--- Returns the module that declares the internal name `name`: what precedes
--- its first `#`, since a module's name has none and what follows may
--- (`Main#C.m#show`, `Main#<#>`). Returns `None` for a name with no `#`, such
--- as a built-in type's, and for a name the compiler made that begins with
--- `%`, such as an instance's dictionary, whose module is not part of it.
fun moduleOf(name : String) -> Option String =
    if String.startsWith(name, "%") { None }
    else {
        match String.splitOnce(name, sep) {
            Some((owner, _)) -> Some(owner)
            None -> None
        }
    }
