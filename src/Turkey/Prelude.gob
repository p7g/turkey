module Turkey.Prelude (
    monadBind, monadPure,
    flowFall, flowBrk, flowCont, flowRet,
    typedClass, typeRepCon, proxyCon,
    error,
    optionType, optionNone, optionSome,
    boolType, boolTrue, boolFalse,
    stringType,
    learnWellKnown,
    preludeName, wellKnownName, targetName, entryName, sep, internal,
)

-- The compiler's half of the Prelude (`turkey/prelude.py`).
--
-- The Prelude itself is ordinary source in `lib/Prelude.gob` and is loaded like
-- any other module. What is here is the handful of names the *compiler* has to
-- know, because it writes nodes naming them: what `?` desugars to, and what a
-- `return` crossing a `?` becomes. A program cannot change any of them by
-- shadowing, which is why they are constants here rather than lookups.
--
-- The names that reach an AST are already *internal* -- `Prelude#Fall`, not
-- `Fall` -- because desugaring runs after resolution and everything it writes
-- has to be spelled the way resolution would have spelled it.

-- What `?` is written in terms of. Both are looked up in
-- the module's protocol-method scope and marked as method references, so a
-- module defining its own `bind` does not capture the one a `?` means.
let monadBind = "bind"
let monadPure = "pure"

-- What a `return`, `break` or `continue` becomes when it crosses a `?`.
-- Declared in the Prelude and exported by nothing, so only the lowering can
-- write one.
let flowFall = "Prelude#Fall"
let flowBrk = "Prelude#Brk"
let flowCont = "Prelude#Cont"
let flowRet = "Prelude#Ret"

-- The library declarations the compiler writes nodes naming, by their internal
-- names. They are not spelled out here: each is what `Turkey.WellKnown`
-- exports under the name `learnWellKnown` gives, so the library may keep them
-- in any module. Read once the program's modules are loaded, by
-- `Turkey.Modules`, before anything is resolved -- which is the first thing
-- that reads one.

-- Diverges, so it can stand in for a `Flow` arm the language's own rules make
-- unreachable -- a `break` where there is no loop -- which the exhaustiveness
-- checker has no way to know is unreachable.
var error = ""

-- Checked downcasting. `Typed` is a class a program may
-- name -- `cast[Typed a]` -- but not instance: its instances are derived, one
-- per type constructor, because a hand-written one could claim any type for
-- any value, and the comparison of reps *is* what a cast checks. GHC has
-- rejected user `Typeable` instances since 7.10 for the same reason.
var typedClass = ""
var typeRepCon = ""
var proxyCon = ""

var optionType = ""
var optionNone = ""
var optionSome = ""

var boolType = ""
var boolTrue = ""
var boolFalse = ""

var stringType = ""

-- Read every name above from `find`, which answers what `Turkey.WellKnown`
-- exports by a name in one of its namespaces: "type", "constructor", "class"
-- or "value".
fun learnWellKnown(find : fun(String, String) -> String) -> Unit {
    error = find("value", "error")
    typedClass = find("class", "Typed")
    typeRepCon = find("constructor", "TypeRep")
    proxyCon = find("constructor", "Proxy")
    optionType = find("type", "Option")
    optionNone = find("constructor", "None")
    optionSome = find("constructor", "Some")
    boolType = find("type", "Bool")
    boolTrue = find("constructor", "True")
    boolFalse = find("constructor", "False")
    stringType = find("type", "String")
}

let preludeName = "Prelude"
let wellKnownName = "Turkey.WellKnown"
let targetName = "Target"
let entryName = "Main"

-- What a module's top-level binding is called once resolution has run. `#` is
-- not a character any surface name may contain, so an internal name can never
-- collide with one a program could write -- and a diagnostic can strip the
-- prefix back off without having to guess where a module name ends, which an
-- ordinary `.` would leave ambiguous against `Vec.push`.
let sep = "#"

fun internal(owner : String, name : String) -> String = owner + sep + name
