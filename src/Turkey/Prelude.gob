export (
	monadBind,
	monadPure,
	flowModule,
	flowFall,
	flowBrk,
	flowCont,
	flowRet,
	typedClass,
	typeRepCon,
	proxyCon,
	eqClass,
	ordClass,
	hashClass,
	hasherClass,
	objectClass,
	debugClass,
	showClass,
	debugConstructor,
	debugRecord,
	debugObject,
	error,
	optionType,
	optionNone,
	optionSome,
	eitherType,
	eitherLeft,
	eitherRight,
	boolType,
	boolTrue,
	boolFalse,
	stringType,
	stringBuilder,
	stringPush,
	stringBuild,
	showMethod,
	stepType,
	stepDone,
	stepYield,
	steps,
	learnWellKnown,
	protocolMethod,
	preludeName,
	wellKnownName,
	targetName,
	entryName,
	sep,
	internal,
	moduleOf,
	programModule,
	writtenName,
	display,
	unmarked,
)

--- The compiler's half of the Prelude (`turkey/prelude.py`).
---
--- The Prelude itself is ordinary source in `lib/Prelude.gob` and is loaded like
--- any other module. What is here is the handful of names the *compiler* has to
--- know, because it writes nodes naming them: what `?` desugars to, and what a
--- `return` crossing a `?` becomes. A program cannot change any of them by
--- shadowing, which is why they are constants here rather than lookups.
---
--- The names that reach an AST are already *internal* -- `Turkey.Flow#Fall`,
--- not `Fall` -- because desugaring runs after resolution and everything it writes
--- has to be spelled the way resolution would have spelled it.

--- What `?` is written in terms of, by the spellings `protocolMethod` takes.
let monadBind = "bind"
let monadPure = "pure"

--- The library module that declares what a `return`, `break` or `continue`
--- becomes when it crosses a `?`. A program may not import it, so only the
--- lowering can write one of its constructors. Any module may hold a `?`,
--- so `Turkey.Modules` loads this one ahead of every other.
let flowModule = "Turkey.Flow"
let flowFall = "Turkey.Flow#Fall"
let flowBrk = "Turkey.Flow#Brk"
let flowCont = "Turkey.Flow#Cont"
let flowRet = "Turkey.Flow#Ret"

-- The library declarations the compiler writes nodes naming, by their internal
-- names. They are not spelled out here: each is what `Turkey.WellKnown`
-- exports under the name `learnWellKnown` gives, so the library may keep them
-- in any module. Read once the program's modules are loaded, by
-- `Turkey.Modules`, before anything is resolved -- which is the first thing
-- that reads one.

--- Diverges, so it can stand in for a `Flow` arm the language's own rules make
--- unreachable -- a `break` where there is no loop -- which the exhaustiveness
--- checker has no way to know is unreachable.
var error = ""

--- Checked downcasting. `Typed` is a class a program may
--- name -- `cast[Typed a]` -- but not instance: its instances are derived, one
--- per type constructor, because a hand-written one could claim any type for
--- any value, and the comparison of reps *is* what a cast checks. GHC has
--- rejected user `Typeable` instances since 7.10 for the same reason.
var typedClass = ""
var typeRepCon = ""
var proxyCon = ""

--- The classes a type declaration may derive, and the class of what a derived
--- `Hash` feeds a value's parts to.
var eqClass = ""
var ordClass = ""
var hashClass = ""
var hasherClass = ""

--- Identity. Like `Typed`, a class a program may name but not instance: its
--- instances are derived for the types whose values have stable identity,
--- and an instance for any other type would compare words the compiler is
--- free to copy.
var objectClass = ""

--- Structural text, derived for every type, and what a derived `debug` is
--- written in: a constructor's text, a record's, and the guard an object's
--- text goes through.
var debugClass = ""
--- Text for a program's user, which a tuple derives as its `Debug`.
var showClass = ""
var debugConstructor = ""
var debugRecord = ""
var debugObject = ""

var optionType = ""
var optionNone = ""
var optionSome = ""

var eitherType = ""

--- What `e!` matches its method's answer against.
var eitherLeft = ""
var eitherRight = ""

var boolType = ""
var boolTrue = ""
var boolFalse = ""

var stringType = ""

--- What a string literal with holes is written in: a `String.Builder`, a push
--- per piece and per hole, and the `build` that joins them.
var stringBuilder = ""
var stringPush = ""
var stringBuild = ""

--- Hold `Step`, the type a `for` loop's `next` returns when the library's
--- `Iterator` threads its cursor through `next`, and its constructors `Done`
--- and `Yield(x, after)`. Empty when `Turkey.WellKnown` exports no `Step`; then
--- `next` returns an `Option` and advances the cursor it is given, and `steps`
--- returns `False`.
---
--- `Step` must be declared `Step a s = Done | Yield(a, s)`: the element type
--- before the cursor type, and `Yield`'s fields in the same order. Inference
--- applies `Step` to the element and the cursor in that order, and lowering
--- matches `Yield`'s first field as the element; nothing here checks either.
var stepType = ""
var stepDone = ""
var stepYield = ""

--- Returns whether a `for` loop threads its cursor through `next`'s `Step`
--- rather than reading an `Option` from a cursor `next` advances.
fun steps() -> Bool = stepType != ""

-- The class methods the compiler writes references to, by the spelling the
-- parser and desugaring mark each reference with: `-x` is `neg`, `xs[i]` and
-- `xs[i] = v` are `get` and `set`, `for` is `iter` and `next`, `?` and `do`
-- are `bind` and `pure`, a string literal's holes are `show`, and `e!` is
-- `tryUnwrap`. A reference means the method by its internal name, so a
-- program's own class with a method spelled alike does not capture it.
let protocolSpellings = ["neg", "get", "set", "iter", "next", "bind", "pure", "show", "tryUnwrap"]

--- The spelling of the `show` each hole of a string literal is written in.
let showMethod = "show"
let protocolMethods : Map String String = Map.new()

--- Returns the internal name of the class method a compiler-written reference
--- marked `spelling` means, or `None` for a spelling that marks none.
fun protocolMethod(spelling : String) -> Option String = Map.get(protocolMethods, spelling)

--- Read every name above from `find`, which answers what `Turkey.WellKnown`
--- exports by a name in one of its namespaces: "type", "constructor", "class"
--- or "value". `Step` and its constructors are read from `optional`, which
--- answers `None` for a name the module does not export.
fun learnWellKnown(
	find : fun(String, String) -> String,
	optional : fun(String, String) -> Option String,
) -> Unit {
	error = find("value", "error")
	typedClass = find("class", "Typed")
	typeRepCon = find("constructor", "TypeRep")
	proxyCon = find("constructor", "Proxy")
	eqClass = find("class", "Eq")
	ordClass = find("class", "Ord")
	hashClass = find("class", "Hash")
	hasherClass = find("class", "Hasher")
	objectClass = find("class", "Object")
	debugClass = find("class", "Debug")
	showClass = find("class", "Show")
	debugConstructor = find("value", "debugConstructor")
	debugRecord = find("value", "debugRecord")
	debugObject = find("value", "debugObject")
	optionType = find("type", "Option")
	optionNone = find("constructor", "None")
	optionSome = find("constructor", "Some")
	eitherType = find("type", "Either")
	eitherLeft = find("constructor", "Left")
	eitherRight = find("constructor", "Right")
	boolType = find("type", "Bool")
	boolTrue = find("constructor", "True")
	boolFalse = find("constructor", "False")
	stringType = find("type", "String")
	stringBuilder = find("value", "builder")
	stringPush = find("value", "push")
	stringBuild = find("value", "build")
	-- All three or none: a `Step` without its constructors is a library
	-- that cannot be iterated, which `find` reports.
	stepType = Option.unwrapOr(optional("type", "Step"), "")
	stepDone = if steps() { find("constructor", "Done") } else { "" }
	stepYield = if steps() { find("constructor", "Yield") } else { "" }
	for spelling in protocolSpellings {
		Map.put(protocolMethods, spelling, find("value", spelling))
	}
}

let preludeName = "Prelude"

let wellKnownName = "Turkey.WellKnown"
let targetName = "Target"
let entryName = "Main"

--- What a module's top-level binding is called once resolution has run. `#` is
--- not a character any surface name may contain, so an internal name can never
--- collide with one a program could write -- and a diagnostic can strip the
--- prefix back off without having to guess where a module name ends, which an
--- ordinary `.` would leave ambiguous against `Vec.push`.
let sep = "#"

fun internal(owner : String, name : String) -> String = owner + sep + name

-- What ends the name of a program's module that shares its written name with
-- a library module. A module name is letters, digits, `_`, `'` and `.`, and
-- no namer writes a `:`, so the two modules' internal names differ and the
-- mark can be taken back off wherever it is.
let programMark = ":"

--- Returns the name a program's own module has when the library has a module
--- written `name` too. Both may be loaded into one program, the library's for
--- the library's modules and this one for the program's, and each
--- declaration's internal name starts with its module's, so the two never
--- share one.
fun programModule(name : String) -> String = name + programMark

--- Returns the name a module is imported by, given the name it is loaded
--- under. For finding the module's file and comparing with a name an import
--- writes; text a reader sees is `display`'s.
fun writtenName(module_ : String) -> String =
	Option.unwrapOr(String.stripSuffix(module_, programMark), module_)

--- Returns an internal name, or the name a module is loaded under, as a
--- reader writes it: `Data.Set#union` is `Data.Set.union`, and a program
--- module's mark is left out. Every diagnostic, documentation page and type
--- that shows such a name goes through this function or `unmarked`.
fun display(name : String) -> String =
	String.replace(String.replace(name, programMark, ""), sep, ".")

--- Returns `text`, which may hold internal names among other words, with
--- each program module's mark left out and the names otherwise as they are.
--- A mark is found by the `#` after it, which follows a module's name in
--- every internal name, so a `:` the text has for another reason stays.
fun unmarked(text : String) -> String = String.replace(text, programMark + sep, sep)

--- Returns the module that declares the internal name `name`: what precedes
--- its first `#`, since a module's name has none and what follows may
--- (`Main#C.m#show`, `Main#<#>`). Returns `None` for a name with no `#`, such
--- as a built-in type's, and for a name the compiler made that begins with
--- `%`, such as an instance's dictionary, whose module is not part of it.
fun moduleOf(name : String) -> Option String =
	if String.startsWith(name, "%") {
		None
	} else {
		match String.splitOnce(name, sep) {
			Some((owner, _)) -> Some(owner)
			None             -> None
		}
	}
