export (
	Colour(..),
	Spill(..),
	Pool(..),
	Pressure(..),
	inFile,
	pressureOf,
	effectivePressure,
	AcrossCalls(..),
	acrossCalls,
	Colouring(..),
	colour,
	verifyColouring,
	Spills(..),
	Allocation(..),
	allocate,
	verifyAllocation,
	untracedPressure,
	worstCall,
	moveHints,
	hintsTaken,
)

--- Register allocation, for any target that describes itself through two
--- classes.
---
--- The design is spill, then colour, then coalesce -- the SSA decomposition
--- rather than linear scan or IRC. What makes it worth the three phases is one
--- theorem: the dominance relation of an SSA program induces a perfect
--- elimination order on its interference graph, so the graph never has to be
--- built, colouring is a walk of the dominator tree, and it *cannot fail* once
--- pressure fits. Chordal graphs have a clique number equal to their chromatic
--- number, which in this setting reads: the registers needed are exactly the
--- maximum number of values live at once.
---
--- That last sentence is why this file begins with a measurement instead of a
--- spiller. If maximum pressure never exceeds the registers a target has, then
--- the corpus needs no spilling at all, and the first working allocator is the
--- colourer alone. Spilling is the largest and least certain part of this pass
--- and the only part whose heuristic affects code quality, so knowing whether
--- the corpus needs it is worth more than starting it.
---
--- The precondition the theorem needs is one this project already checks on
--- every function: `Ssa.verify` enforces that a definition dominates its uses.
---
--- A target is two instances over its instruction type. `Colour` is what the
--- colouring walk and its checker need: the register files and their pools,
--- what each instruction clobbers, and which physical registers it reads and
--- writes. `Spill` is what spilling needs on top: slots, and the instructions
--- that store to and reload from them. `colour` needs only the first, so a
--- target whose files are unbounded never needs the second. `allocate` needs
--- both.

import Data.BitSet as BitSet
import Data.BitSet (BitSet)
import Data.Map as Map
import Data.Set as Set
import Turkey.Position as Position
import Turkey.Ssa as Ssa
import Turkey.Ssa (Func, BlockId, Value, Term(..))

--- What the colouring walk needs to know about a target's instructions.
---
--- Registers are numbered within their file, from 0. A value lives in one
--- file, chosen by its representation, and the files are allocated apart.
---
--- Methods that would mention only a file take the function as well, because
--- an associated type does not determine the instruction type it came from.
class Colour i : Ssa.Inst i {
	--- The register files.
	type File i
	--- Every file, in a fixed order. A file's position here is its
	--- `fileIndex`.
	fun files(Func i) -> Array (File i)
	--- The position of a file in `files`.
	fun fileIndex(Func i, File i) -> Int
	--- The file value `id` of the function is allocated in.
	fun fileOf(Func i, Int) -> File i
	--- The file's name, for a message.
	fun fileName(Func i, File i) -> String
	--- The name of register `n` of the file, for a message.
	fun registerName(Func i, File i, Int) -> String
	--- The registers of the file the allocator may hand out, in the order it
	--- hands them out. A bounded file's register numbers are below 64. An
	--- unbounded file has no physical registers: no instruction clobbers,
	--- reads or writes one of its registers directly.
	fun pool(Func i, File i) -> Pool
	--- The registers of the file the instruction destroys, as a mask with bit
	--- `n` for register `n`: the physical ones it writes, and those a call lets
	--- its callee use.
	fun clobbers(i, File i) -> Int
	--- The registers of the file the instruction lets a callee destroy, as a
	--- mask, and 0 for an instruction that is not a call.
	fun callClobbers(i, File i) -> Int
	--- Calls the function with the file and number of each physical register
	--- the instruction writes.
	fun eachPhysicalWrite(i, fun(File i, Int) -> Unit) -> Unit
	--- Calls the function with the file and number of each physical register
	--- the instruction reads, leaving out the ones that are never live: a
	--- register that nothing in a function writes, say.
	fun eachPhysicalRead(i, fun(File i, Int) -> Unit) -> Unit
	--- A move between a value and a physical register of the same file, as
	--- the value and the register it would like.
	fun moveHint(i) -> Option (Int, Int)
	--- The operands the instruction still reads after it writes its
	--- destination, as a mask with bit `k` for the `k`th value `Ssa.uses`
	--- lists; bit 63 stands for every operand from the 63rd on. Such an
	--- operand may not share the destination's register even where it dies
	--- there.
	fun readAfterWrite(i) -> Int
	--- The operand whose register the destination would like when that
	--- operand dies here, as an index into `Ssa.uses`. Only a preference.
	fun reusedOperand(inst : i) -> Option Int = None
	--- How many of the instructions directly after instruction `n` of the
	--- block have their destinations written by instruction `n` itself.
	--- Their destinations are placed with its own, as if it defined them. So
	--- they avoid the registers of instruction `n`'s operands only where
	--- those operands are in its `readAfterWrite` mask: with a mask of 0, a
	--- later destination may share the register of an operand that dies at
	--- instruction `n`. `verifyColouring` checks each such destination at
	--- its own instruction, not at instruction `n`.
	fun writtenWith(block : Ssa.Block i, n : Int) -> Int = 0
	--- Whether the instruction calls out of the function, at least on some
	--- path: a point where the collector may run.
	fun isCall(i) -> Bool
}

--- The registers a file hands out.
type Pool
	--- These registers, in this order.
	= Bounded(Array Int)
	--- As many as are wanted, numbered from 0, the lowest free one first.
	| Unbounded

--- What spilling needs to know about a target's instructions, beyond what
--- colouring does.
class Spill i : Colour i {
	--- A frame slot a value can be stored in.
	type Slot i
	--- Slot `n` of the root array `Turkey.Roots` assigns.
	fun rootSlot(Func i, Int) -> Slot i
	--- Spill slot `n`, one of the allocator's own.
	fun spillSlot(Func i, Int) -> Slot i
	--- Whether the slot is one of the root array's.
	fun isRootSlot(Func i, Slot i) -> Bool
	--- The slot's name. Two slots are the same slot exactly when their names
	--- are equal.
	fun slotName(Func i, Slot i) -> String
	--- The source position of an instruction, packed (`Turkey.Position`).
	fun positionOf(i) -> Int
	--- `spillStore(id, slot, at)` is an instruction at position `at` storing
	--- value `id` into the slot.
	fun spillStore(Int, Slot i, Int) -> i
	--- `spillLoad(t, slot, at)` is an instruction at position `at` defining
	--- value `t` by loading the slot.
	fun spillLoad(Int, Slot i, Int) -> i
	--- The value a store to a slot writes, and the slot.
	fun slotStore(i) -> Option (Int, Slot i)
	--- The value a load from a slot defines, and the slot.
	fun slotLoad(i) -> Option (Int, Slot i)
	--- Whether the instruction can be repeated wherever its value is wanted,
	--- in place of keeping that value in a register or a slot.
	fun rematerializable(i) -> Bool
	--- `remade(def, id, t, at)` is the definition `def` of value `id`,
	--- defining value `t` instead, at position `at`.
	fun remade(i, Int, Int, Int) -> i
	--- Whether the instruction is the map of a safepoint, which follows the
	--- call it describes.
	fun isSafepointMap(i) -> Bool
	--- Whether the instruction is a loop's poll, at which the collector may
	--- run.
	fun isPoll(i) -> Bool
	--- Whether instruction `n` of the block, if it reads the flags, still
	--- reads the ones its setter left. Spill code is the only thing spilling
	--- puts between two instructions.
	fun flagsIntact(Ssa.Block i, Int) -> Bool
}

--- How many registers are live at once, at the worst point in a function, in
--- each file, by `fileIndex`. The files are counted apart because they are
--- allocated apart.
type Pressure = Pressure(Array Int)

--- The count for one file.
fun inFile[Colour i](f : Func i, Pressure(counts) : Pressure, file : File i) -> Int =
	counts[fileIndex(f, file)]

--- The maximum number of values simultaneously live, per file.
---
--- Only *virtual* registers are counted. The physical registers selection pins
--- around a call -- on arm64, the arguments in `x0`-`x7` and the result out of
--- `x0` -- are not `Ssa.Value`s and so are not in any live set. They are a
--- real constraint on the colourer and they are not pressure in this sense:
--- their live ranges are the two instructions either side of the call, and
--- what this number is for is deciding whether a spiller is needed.
fun pressureOf[Colour i](f : Func i) -> Pressure =
	peakPressure(f, Ssa.liveness(f), BitSet.new(len(f.reps)))

-- The most values live at once in each file, leaving out the values in
-- `skip`.
fun peakPressure[Colour i](f : Func i, liveOut : Array BitSet, skip : BitSet) -> Pressure {
	-- Measured at two kinds of program point: after each instruction of a
	-- block, which is where a definition has just added to the pressure, and
	-- at each block's live-out, which is where a value crossing an edge does.
	-- Those are the peaks; a point inside an instruction cannot exceed both of
	-- its neighbours.
	let peak = Array.filled(len(files(f)), 0)
	let count = Array.filled(len(peak), 0)
	for var b = 0; b < len(f.blocks); b = b + 1 {
		let at = Ssa.BlockId(b)
		raise(f, peak, count, BitSet.elements(liveOut[b]), skip)
		for live in Ssa.liveAfter(f, at, liveOut[b]) { raise(f, peak, count, live, skip) }
	}
	Pressure(peak)
}

-- Raises each file's entry in `peak` to the number of values in `live` of
-- that file, leaving out the values in `skip`. `count` is scratch.
--
-- `Ssa.liveness` answers value ids, and `f.reps` is what says which file each
-- belongs in -- the same table the low IR used, because selection copies it
-- rather than deriving a second one.
fun raise[Colour i](
	f : Func i,
	peak : Array Int,
	count : Array Int,
	live : Array Int,
	skip : BitSet,
) -> Unit {
	for var k = 0; k < len(count); k = k + 1 { count[k] = 0 }
	for id in live {
		if !BitSet.contains(skip, id) {
			let k = fileIndex(f, fileOf(f, id))
			count[k] = count[k] + 1
		}
	}
	for var k = 0; k < len(count); k = k + 1 {
		if count[k] > peak[k] { peak[k] = count[k] }
	}
}

--- How many values are live *across* a call, which is the second number the
--- colourer's feasibility turns on and a tighter one than total pressure.
---
--- A call clobbers every caller-saved register, so a value live across one can
--- be held only in a callee-saved register or in memory. Total pressure can
--- fit comfortably in the pool and this can still not fit in the callee-saved
--- registers. A call that clobbers nothing the allocator hands out, such as an
--- arm64 allocation, is not counted (`callClobbers`).
---
--- Traced and untraced are counted apart because they are not equally
--- expensive to spill. A traced value live across a safepoint is *already*
--- being written to the root array, because that is what rooting is; spilling
--- it costs the reload and not the store. An untraced one has no such slot and
--- pays for both. So the untraced count is the one that says whether a spiller
--- is needed, and the traced count says how much cheaper the spilling is than
--- it looks.
type AcrossCalls = AcrossCalls {
	untraced : Pressure
	traced   : Pressure
	calls    : Int
}

fun acrossCalls[Colour i](f : Func i) -> AcrossCalls {
	let count = len(files(f))
	let untraced = Array.filled(count, 0)
	let traced = Array.filled(count, 0)
	let thisUntraced = Array.filled(count, 0)
	let thisTraced = Array.filled(count, 0)
	var calls = 0
	let liveOut = Ssa.liveness(f)
	for var b = 0; b < len(f.blocks); b = b + 1 {
		let block = f.blocks[b]
		let after = Ssa.liveAfter(f, Ssa.BlockId(b), liveOut[b])
		for var n = 0; n < len(block.insts); n = n + 1 {
			if clobbersOnCall(f, block.insts[n]) {
				calls = calls + 1
				for var k = 0; k < count; k = k + 1 {
					thisUntraced[k] = 0
					thisTraced[k] = 0
				}
				for id in after[n] {
					let k = fileIndex(f, fileOf(f, id))
					if f.reps[id].traced {
						thisTraced[k] = thisTraced[k] + 1
					} else {
						thisUntraced[k] = thisUntraced[k] + 1
					}
				}
				for var k = 0; k < count; k = k + 1 {
					if thisUntraced[k] > untraced[k] { untraced[k] = thisUntraced[k] }
					if thisTraced[k] > traced[k] { traced[k] = thisTraced[k] }
				}
			}
		}
	}
	AcrossCalls { untraced = Pressure(untraced), traced = Pressure(traced), calls = calls }
}

-- Whether an instruction is a call that destroys some register the
-- allocator hands out.
fun clobbersOnCall[Colour i](f : Func i, inst : i) -> Bool {
	for file in files(f) {
		if callClobbers(inst, file) != 0 { return True }
	}
	False
}

--- Pressure once the root array is counted as the spill slot it already is.
---
--- The measurement it produces is the one the colourer's feasibility rests on:
--- if effective pressure fits in the register file, no spiller is needed.
---
--- Approximated deliberately, and in the safe direction. A value that is live
--- across *some* call is excluded from every live set here, not only from the
--- ones spanning a call, so this under-counts the registers such a value uses
--- between calls. What it cannot do is under-count a function that needs
--- spilling for some other reason, because every value not in that set is
--- counted in full. Read it as "is the colourer plausible", not as a
--- register count.
fun effectivePressure[Colour i](f : Func i) -> Pressure {
	-- `Turkey.Roots` gives a stack slot to every traced value live across a
	-- safepoint, and the emitter *already* stores it there before the call --
	-- that store is what rooting is. So such a value need not hold a register
	-- across the call at all: it can be read back from its slot afterwards, at
	-- the cost of a load and no store. Its live range is split at every call,
	-- and between calls it is an ordinary value.
	--
	-- This is not a spiller. It is the observation that the spilling has
	-- already happened, for a different reason, and that the allocator may as
	-- well use it.
	let liveOut = Ssa.liveness(f)
	-- The traced values live across some call: exactly what `Turkey.Roots`
	-- gives a slot to, recomputed here on the machine graph because selection
	-- keeps the value numbering and this module cannot see a `Func Low`.
	let rooted = BitSet.new(len(f.reps))
	for var b = 0; b < len(f.blocks); b = b + 1 {
		let block = f.blocks[b]
		let after = Ssa.liveAfter(f, Ssa.BlockId(b), liveOut[b])
		for var n = 0; n < len(block.insts); n = n + 1 {
			if isCall(block.insts[n]) {
				for id in after[n] {
					if f.reps[id].traced { BitSet.add(rooted, id) }
				}
			}
		}
	}
	peakPressure(f, liveOut, rooted)
}

-- -- the colourer ------------------------------------------------------------

--- What the allocator answers: a physical register per value, and nothing
--- rewritten.
---
--- The assignment is kept **on the side** rather than substituted into the
--- instructions. That is regalloc2's design, and the reason it gives is the one
--- that applies here: Cranelift's emitter became "almost completely immutable"
--- once allocation stopped editing the code, and a pass that does not mutate
--- its input is a pass whose input can still be printed, verified and re-run.
type Colouring = Colouring {
	--- Value id -> register number within that value's own file. `-1` for a
	--- value that was never assigned one, which after a successful run means
	--- only that it is dead.
	of_ : Array Int
	--- Why it stopped, if it did. The discipline selection uses: a function
	--- that cannot be coloured is reported rather than approximated, and the
	--- histogram is the plan for the next slice.
	stopped : Option String
}

--- Colour one function by walking its blocks in a dominance-compatible order.
fun colour[Colour i](f : Func i) -> Colouring {
	let w = walk(f, newSpills(), Map.new(), None)
	Colouring { of_ = w.of_, stopped = w.stopped }
}

-- One colouring walk, which either stops at the first value it cannot place
-- (`evict` is `None`, what `colour` runs) or keeps going and names the values
-- that must go to memory for the next attempt to succeed (`evict` holds the
-- spill costs to weigh them by, what `allocate` runs).
--
-- The slot type is a parameter, not `Slot i`, because a constructor field
-- cannot name an associated type declared in this module.
type Walk i s = Walk {
	f         : Func i
	spills    : Spills i s
	evict     : Option (fun(Func i, Map Int Int) -> Array Int)
	forbidden : Array Int
	hints     : Array Int
	-- `affinities`: the block parameters each value is passed to, and the
	-- values each block parameter is passed.
	sinks       : Array (Vec Int)
	sources     : Array (Vec Int)
	of_         : Array Int
	var stopped : Option String
	evicted     : Set.Set Int
	-- The evicted values that left because every register was held, rather
	-- than because they were live across a clobber. One reload shared by
	-- several reads would hold a register over the same crowded stretch, so
	-- these are reloaded at each read.
	crowded : Set.Set Int
	liveOut : Array BitSet
	roots   : Map Int Int
	-- `spillCosts`, computed the first time `place` has to choose and empty
	-- until then: most functions never do.
	var cost : Array Int
}

fun walk[Colour i](
	f : Func i,
	spills : Spills i s,
	roots : Map Int Int,
	evict : Option (fun(Func i, Map Int Int) -> Array Int),
) -> Walk i s {
	-- Reverse postorder is dominance-compatible, so a definition is always
	-- coloured before any use, and the theorem does the rest: at the point a
	-- value is defined, everything it can interfere with is live there, so a
	-- colour that avoids the live ones avoids all of them. No interference
	-- graph, no worklist, no second pass.
	--
	-- Two things the theorem does not cover, and both are real here:
	--
	-- * **Physical registers.** Selection pins arguments into fixed registers
	--   and reads the result out of one -- on arm64, `x0`-`x7` and `x0` -- and
	--   a `mov x0, %5` destroys whatever the allocator put in `x0`. So a
	--   value's forbidden set collects every physical register written at a
	--   point where that value is live, and a call forbids all of the
	--   caller-saved ones at once.
	-- * **The flags.** Nothing that sets flags may come between a
	--   flag-setting instruction and the one that reads them. Colouring
	--   inserts nothing; spilling inserts only spill code -- on arm64 `ldr`
	--   and `str`, which leave the flags alone -- and `verifyAllocation` asks
	--   `flagsIntact` of every instruction.
	let (liveIn, liveOut) = Ssa.livenessInOut(f)
	let forbidden = forbiddenSets(f, liveOut)
	let of_ = Array.filled(len(f.reps), -1)
	let (sinks, sources) = affinities(f)
	-- Everything `place` needs in one record, so that it takes five arguments
	-- and not ten: a call passing more than eight is one this backend cannot
	-- yet select, and the allocator should not be where `turkey` gains one.
	let w = Walk {
		f         = f
		spills    = spills
		evict     = evict
		forbidden = forbidden
		hints     = moveHints(f)
		sinks     = sinks
		sources   = sources
		of_       = of_
		stopped   = None
		evicted   = Set.new()
		crowded   = Set.new()
		liveOut   = liveOut
		roots     = roots
		cost      = []
	}
	let entry = f.blocks[Ssa.blockId(f.entry)]

	-- The function's own parameters, before anything else.
	--
	-- They are live from entry and are defined by nothing in any block --
	-- `Func.params` and `Block.params` are different fields, and the walk
	-- below only ever colours the second. Missing this left every parameter
	-- with no register at all, which nothing downstream noticed because an
	-- unassigned value simply does not appear in the checks. It was found by
	-- the hint hit rate reading exactly 0 of 3714, which is not a bad hint
	-- rate but an absent one.
	let entryTaken = newTaken()
	for p in f.params {
		let id = Ssa.valueId(p)
		place(w, entryTaken, id, entry, 0)
	}

	let scratch = BitSet.new(len(f.reps))
	for at in Ssa.reversePostorder(f) {
		let b = Ssa.blockId(at)
		let block = f.blocks[b]
		-- A block's parameters are defined at its entry and are all live at
		-- once, so each avoids the values entering the block and the
		-- parameters already placed.
		let taken = newTaken()
		for id in BitSet.elements(liveIn[b]) {
			if w.of_[id] >= 0 { hold(taken, key(f, id, w.of_[id]), id) }
		}
		for p in block.params {
			let pid = Ssa.valueId(p)
			place(w, taken, pid, block, 0)
		}
		-- From here `taken` is kept rather than rebuilt: before instruction
		-- `n` it holds what is live after `n - 1`, so releasing what `ends[n]`
		-- names leaves what is live after `n`, less the definitions `n` is
		-- about to place. Interference is with what is live *after* the
		-- instruction, not before it: an operand that dies here may share the
		-- destination's register, which is what makes `add x0, x0, x1` legal.
		let ends = endings(f, block, liveOut[b], scratch)
		for var n = 0; n < len(block.insts); n = n + 1 {
			-- An instruction that writes its destination before its last read
			-- of some operands (on arm64, an inline array allocation) places
			-- it while those operands still hold their registers. Everything
			-- else that ends here is released first: the operands it reads
			-- only before writing, and what it does not read at all, a dead
			-- definition of the instruction before it or a dead parameter.
			let i = block.insts[n]
			let late = readAfterWrite(i)
			if late != 0 {
				for id in ends[n] {
					if doneBeforeWriting(i, late, id) { releaseValue(w, taken, id) }
				}
				placeDefinitions(w, taken, block, n)
				for id in ends[n] {
					if !doneBeforeWriting(i, late, id) { releaseValue(w, taken, id) }
				}
				continue
			}
			for id in ends[n] { releaseValue(w, taken, id) }
			placeDefinitions(w, taken, block, n)
		}
	}
	w
}

-- Places the definitions of instruction `n` of the block, and those of the
-- instructions after it that it writes (`writtenWith`). A later one's own
-- turn then finds its definitions placed.
fun placeDefinitions[Colour i](w : Walk i s, taken : Taken, block : Ssa.Block i, n : Int) -> Unit {
	let last = n + writtenWith(block, n)
	for var k = n; k <= last && k < len(block.insts); k = k + 1 {
		Ssa.eachDef(block.insts[k], fun(d) = place(w, taken, Ssa.valueId(d), block, n + 1))
	}
}

-- For each instruction of a block, the values that stop holding a register
-- just before it is coloured: the operands it reads for the last time, and the
-- definitions of the instruction before it that nothing reads. The first
-- instruction's also has the block's parameters that nothing reads. A dead
-- definition is released one instruction late on purpose, because it still
-- writes its register and so must not share it with anything live there.
--
-- Most instructions end nothing, and those share one empty array, so a block
-- costs a handful of small arrays rather than a live set per instruction.
-- `live` is scratch, overwritten here.
fun endings[Ssa.Inst i](
	f : Func i,
	block : Ssa.Block i,
	out : BitSet,
	live : BitSet,
) -> Array (Vec Int) {
	let count = len(block.insts)
	let ends : Array (Vec Int) = Array.init(count, fun(_) = [])
	BitSet.copyFrom(live, out)
	for v in Ssa.termUses(block.term) { BitSet.add(live, Ssa.valueId(v)) }
	for var n = count - 1; n >= 0; n = n - 1 {
		let here = n
		Ssa.eachDef(block.insts[here], fun(d) {
			let id = Ssa.valueId(d)
			if !BitSet.remove(live, id) && here + 1 < count {
				Vec.push(ends[here + 1], id)
			}
		})
		Ssa.eachUse(block.insts[here], fun(u) {
			let id = Ssa.valueId(u)
			if !BitSet.contains(live, id) {
				BitSet.add(live, id)
				Vec.push(ends[here], id)
			}
		})
	}
	if count > 0 {
		for p in block.params {
			if !BitSet.contains(live, Ssa.valueId(p)) {
				Vec.push(ends[0], Ssa.valueId(p))
			}
		}
	}
	ends
}

-- A value that was evicted, or never placed, holds nothing to release.
fun releaseValue[Colour i](w : Walk i s, taken : Taken, id : Int) -> Unit {
	let n = w.of_[id]
	if n >= 0 {
		let k = key(w.f, id, n)
		if holderOf(taken, k) == id { release(taken, k) }
	}
}

-- Whether `inst` is done with value `id` before it writes its destination:
-- `id` is no operand in the mask `late`, or no operand at all.
fun doneBeforeWriting[Ssa.Inst i](inst : i, late : Int, id : Int) -> Bool {
	-- Every operand is late in the mask that has every bit, and a target that
	-- answers it may answer it for every instruction, so it is asked without
	-- building the operand list.
	if late == -1 { return !Ssa.anyUse(inst, fun(u) = Ssa.valueId(u) == id) }
	let operands = Ssa.uses(inst)
	for var k = 0; k < len(operands); k = k + 1 {
		if Ssa.valueId(operands[k]) == id && readsLate(late, k) { return False }
	}
	True
}

-- Whether operand `k` is in a `readAfterWrite` mask.
fun readsLate(late : Int, k : Int) -> Bool = forbids(late, if k < 63 { k } else { 63 })

-- A taken-register key. The files are allocated apart, so register 3 of one
-- and register 3 of another must not collide; the file is part of the key
-- rather than every table being split per file, which would multiply every
-- loop above. Register `n` of file `k`, of `c` files, is key `n * c + k`, so
-- an unbounded file's keys never run into another file's.
--
-- A wrapper rather than a bare `Int` because the tables it keys hold value
-- ids, which are `Int`s too, and swapping the two must not compile. It erases
-- to the number, so it costs nothing.
type RegKey = RegKey(Int)

fun key[Colour i](f : Func i, id : Int, n : Int) -> RegKey = keyIn(f, fileOf(f, id), n)

fun keyIn[Colour i](f : Func i, file : File i, n : Int) -> RegKey =
	RegKey(n * len(files(f)) + fileIndex(f, file))

-- A bound on a bounded file's register numbers, which are below it, so that
-- one word holds a mask of a file's registers.
let boundedRegisters = 64

-- The registers held at one program point: for each key, the value holding
-- that register, or `-1`. `place` has to know whom it would evict, so a mask
-- of the held registers is not enough; an array indexed by key answers both
-- questions with no hashing, and the colourer updates one per block rather
-- than building one per instruction. It grows as registers are held, so that
-- an unbounded file fits; a key past its end is not held.
type Taken = Taken(Vec Int)

fun newTaken() -> Taken = Taken([])

fun holderOf(Taken(held) : Taken, RegKey(k) : RegKey) -> Int = if k < len(held) {
	held[k]
} else {
	-1
}

fun isHeld(taken : Taken, k : RegKey) -> Bool = holderOf(taken, k) >= 0

fun hold(Taken(held) : Taken, RegKey(k) : RegKey, id : Int) -> Unit {
	while len(held) <= k { Vec.push(held, -1) }
	held[k] = id
}

fun release(Taken(held) : Taken, RegKey(k) : RegKey) -> Unit {
	if k < len(held) { held[k] = -1 }
}

-- The registers a bounded file hands out, in order. Only eviction asks for
-- them, and the walk evicts only when no register is free, which in an
-- unbounded file one always is.
fun poolOf[Colour i](f : Func i, file : File i) -> Array Int = match pool(f, file) {
	Bounded(registers) -> registers
	Unbounded -> error(
		"internal error: an eviction from the unbounded " + fileName(f, file) + " file",
	)
}

-- Whether the file's pool hands out register `n`.
fun inPool[Colour i](f : Func i, file : File i, n : Int) -> Bool = match pool(f, file) {
	Bounded(registers) -> Array.contains(registers, n)
	Unbounded          -> n >= 0
}

-- How many of the file's registers can be physical ones: any of a bounded
-- file's, and none of an unbounded one's.
fun physicalCount[Colour i](f : Func i, file : File i) -> Int = match pool(f, file) {
	Bounded(_) -> boundedRegisters
	Unbounded  -> 0
}

-- Give one value the lowest register its file allows that nothing live holds
-- and nothing forbids -- or, when there is none and `evict` is set, decide
-- what goes to memory instead.
--
-- `taken` says which value holds each register, because eviction has to know
-- whom it is evicting. `from` is the index in `block` from which a holder's
-- next use is measured: one past the instruction that defines `id`, or 0 for
-- a parameter.
--
-- Two different failures, and they need different answers. That is the one
-- thing about spilling this pass got wrong on paper before it got it right:
--
-- * **A register is free but forbidden.** The value is live across a clobber
--   -- a call, or a physical register in use -- and every register nobody
--   holds is one the clobber destroys. Either this value goes to memory --
--   stored at its definition and reloaded after the calls, it is no longer
--   live across one -- or a holder of a register it may have does, and
--   `cheaperHolder` picks whichever costs less. A reload shared by several
--   reads can meet this too, across a physical register's live range, and is
--   split into one reload per read.
-- * **Every register is held.** Spilling this value would not help: it still
--   needs a register at this very point, for the one instruction between its
--   definition and its store. Something *else* has to leave, and the holder
--   whose next use is furthest away is Belady's answer and the one that frees
--   the register for longest.
fun place[Colour i](
	w : Walk i s,
	taken : Taken,
	id : Int,
	block : Ssa.Block i,
	from : Int,
) -> Unit {
	if w.of_[id] >= 0 { return }
	let spills = w.spills
	let file = fileOf(w.f, id)
	let why = "a value with no free register in the " + fileName(w.f, file) + " file"
	var placing = True
	while placing {
		match freeRegister(
			w.f,
			taken,
			w.forbidden[id],
			file,
			preference(w, taken, id, file, block, from),
		) {
			Some(n) -> {
				w.of_[id] = n
				hold(taken, keyIn(w.f, file, n), id)
				placing = False
			}
			None -> if Option.isNone(w.evict) {
				stopOnce(w, why)
				placing = False
			} else if anyUnheld(w.f, taken, file) {
				if Set.contains(spills.shared, id) {
					Set.add(w.evicted, id)
					placing = False
				} else if Map.contains(spills.reloadOf, id) || Map.contains(spills.slots, id) {
					stopOnce(
						w,
						"a reload or store with no free register in the "
							+ fileName(w.f, file)
							+ " file",
					)
					placing = False
				} else {
					match cheaperHolder(w, taken, id, file) {
						Some(v) -> {
							release(taken, keyIn(w.f, file, w.of_[v]))
							w.of_[v] = -1
							Set.add(w.evicted, v)
						}
						None -> {
							Set.add(w.evicted, id)
							placing = False
						}
					}
				}
			} else {
				match victim(w, taken, file, block, from) {
					Some(v) -> {
						release(taken, keyIn(w.f, file, w.of_[v]))
						w.of_[v] = -1
						Set.add(w.evicted, v)
						Set.add(w.crowded, v)
					}
					None -> {
						stopOnce(w, why)
						placing = False
					}
				}
			}
		}
	}
}

fun stopOnce(w : Walk i s, why : String) -> Unit = if let None = w.stopped { w.stopped = Some(why) }

-- The hint first, then the pool in order. A hint is only ever a preference:
-- taking it makes a move redundant and missing it makes the move real, and
-- neither can make the result wrong. That is the whole reason parameters are
-- *hinted* to their argument registers rather than pinned to them -- a pin
-- can contradict (a parameter in `x0` that is live across a call has had `x0`
-- destroyed), and a preference cannot.
fun freeRegister[Colour i](
	f : Func i,
	taken : Taken,
	forbidden : Int,
	file : File i,
	hint : Int,
) -> Option Int {
	if usable(f, taken, forbidden, file, hint) { return Some(hint) }
	match pool(f, file) {
		Bounded(registers) -> {
			for n in registers {
				if !isHeld(taken, keyIn(f, file, n)) && !forbids(forbidden, n) {
					return Some(n)
				}
			}
			None
		}
		-- Finitely many registers are held, so the search ends.
		Unbounded -> {
			var n = 0
			while isHeld(taken, keyIn(f, file, n)) || forbids(forbidden, n) { n = n + 1 }
			Some(n)
		}
	}
}

-- Whether register `n` can be handed out here. Only a register the pool would
-- hand out: on arm64, a move from `x29`, which is how `Prim.frameAddress`
-- reads the frame, must not colour its destination into the frame register
-- itself.
fun usable[Colour i](f : Func i, taken : Taken, forbidden : Int, file : File i, n : Int) -> Bool =
	n >= 0 && inPool(f, file, n) && !isHeld(taken, keyIn(f, file, n)) && !forbids(forbidden, n)

-- The register `id` would best take, or `-1` for none in particular: the first
-- of these it may have here, each of which makes one copy redundant.
--
-- 1. Its move hint, to or from a fixed register.
-- 2. For a definition, the register of the operand its instruction would
--    reuse (`reusedOperand`), when that operand dies there and is in the
--    same file.
-- 3. The register of a block parameter it is passed to. A loop header's
--    parameters are coloured before anything in the loop, so a value a latch
--    passes back finds the header's register already chosen, and taking it
--    empties that slot of the back edge's parallel copy. A parameter not yet
--    coloured is searched through, to the parameters it is passed to in turn:
--    a block that several latches jump to, like the one holding a loop's
--    poll, passes its parameters straight on to the header's, and without the
--    search each latch would copy into that block's registers and the block
--    copy them again into the header's.
-- 4. For a block parameter, the register of a value passed to it. That serves
--    a forward merge, whose arguments are all coloured before it.
--
-- Sinks come before sources because a sink already coloured is almost always
-- a loop header, and a copy on a back edge runs every iteration.
--
-- This is a preference and never a constraint, and the walk colours in
-- dominance order, where any free register keeps the rest colourable, so no
-- choice made here can make the colouring fail.
fun preference[Colour i](
	w : Walk i s,
	taken : Taken,
	id : Int,
	file : File i,
	block : Ssa.Block i,
	from : Int,
) -> Int {
	let forbidden = w.forbidden[id]
	let hint = w.hints[id]
	if usable(w.f, taken, forbidden, file, hint) { return hint }
	if from > 0 {
		let reused = reusedRegister(w, block.insts[from - 1], file)
		-- An operand that is still live holds its register, so `usable` also
		-- says whether the operand dies here.
		if usable(w.f, taken, forbidden, file, reused) { return reused }
	}
	let seen = [id]
	for var n = 0; n < len(seen) && n < sinkSearch; n = n + 1 {
		for s in w.sinks[seen[n]] {
			let r = w.of_[s]
			if r >= 0 {
				if usable(w.f, taken, forbidden, file, r) { return r }
			} else if !Vec.contains(seen, s) {
				Vec.push(seen, s)
			}
		}
	}
	for s in w.sources[id] {
		let r = w.of_[s]
		if usable(w.f, taken, forbidden, file, r) { return r }
	}
	-1
}

-- The register of the operand `inst` would reuse for its destination, if it
-- names one in `file`, or `-1`.
fun reusedRegister[Colour i](w : Walk i s, inst : i, file : File i) -> Int =
	match reusedOperand(inst) {
		None -> -1
		Some(k) -> {
			let operands = Ssa.uses(inst)
			if k >= len(operands) { return -1 }
			let a = Ssa.valueId(operands[k])
			if fileIndex(w.f, fileOf(w.f, a)) == fileIndex(w.f, file) { w.of_[a] } else { -1 }
		}
	}

-- How many values `preference` searches through for a coloured sink. A chain
-- of parameters that only pass a value along is short -- a latch's value,
-- the poll block's parameter, the header's -- and the bound keeps a value
-- passed to many jumps from costing a walk of the whole loop.
let sinkSearch = 8

-- For each value, the block parameters a `Jump` passes it to (its sinks), and
-- for each block parameter the values passed to it (its sources). A value
-- passed to its own parameter, as a loop passes an unchanged variable back,
-- is neither: that slot of the copy is empty whatever is chosen.
fun affinities(f : Func i) -> (Array (Vec Int), Array (Vec Int)) {
	let sinks : Array (Vec Int) = Array.init(len(f.reps), fun(_) = [])
	let sources : Array (Vec Int) = Array.init(len(f.reps), fun(_) = [])
	for block in f.blocks {
		if let Jump(target, args) = block.term {
			let params = f.blocks[Ssa.blockId(target)].params
			for var i = 0; i < len(params) && i < len(args); i = i + 1 {
				let a = Ssa.valueId(args[i])
				let p = Ssa.valueId(params[i])
				if a != p {
					Vec.push(sinks[a], p)
					Vec.push(sources[p], a)
				}
			}
		}
	}
	(sinks, sources)
}

fun anyUnheld[Colour i](f : Func i, taken : Taken, file : File i) -> Bool {
	if let Unbounded = pool(f, file) { return True }
	for n in poolOf(f, file) {
		if !isHeld(taken, keyIn(f, file, n)) { return True }
	}
	False
}

-- The holder to evict: in the same file, not a store or a reload read only
-- once (those live for one instruction and spilling them again would loop),
-- and used furthest from `from`. Ties go to the lower value id, so that two
-- runs agree.
fun victim[Colour i](
	w : Walk i s,
	taken : Taken,
	file : File i,
	block : Ssa.Block i,
	from : Int,
) -> Option Int {
	let spills = w.spills
	var best = -1
	var bestDistance = -1
	for n in poolOf(w.f, file) {
		let holder = holderOf(taken, keyIn(w.f, file, n))
		if holder >= 0 {
			let movable = (!Map.contains(spills.reloadOf, holder)
				|| Set.contains(spills.shared, holder))
				&& !Map.contains(spills.slots, holder)
			if movable {
				let d = nextUse(block, holder, from)
				if d > bestDistance || (d == bestDistance && holder < best) {
					best = holder
					bestDistance = d
				}
			}
		}
	}
	if best < 0 { None } else { Some(best) }
}

-- When `id` is live across a clobber and every register it may have is held,
-- the holder of one of those registers that would cost less in memory than
-- `id` does, and the cheapest of them; ties go to the lower value id.
--
-- Without this the value being placed is the one spilled, and the walk is in
-- dominance order, so whatever is defined first keeps the callee-saved
-- registers. In a loop that is the wrong way round: the invariants defined
-- before it take them, and the loop's own variables, defined at its header,
-- go to memory and are reloaded at every use in the body.
fun cheaperHolder[Colour i](w : Walk i s, taken : Taken, id : Int, file : File i) -> Option Int {
	if len(w.cost) == 0 {
		if let Some(costs) = w.evict { w.cost = costs(w.f, w.roots) }
	}
	let spills = w.spills
	var best = -1
	for n in poolOf(w.f, file) {
		let holder = holderOf(taken, keyIn(w.f, file, n))
		let movable = holder >= 0
			&& !forbids(w.forbidden[id], n)
			&& !Map.contains(spills.reloadOf, holder)
			&& !Map.contains(spills.slots, holder)
		if movable
				&& w.cost[holder] < w.cost[id]
				&& (best < 0
					|| w.cost[holder] < w.cost[best]
					|| (w.cost[holder] == w.cost[best] && holder < best)) {
			best = holder
		}
	}
	if best < 0 { None } else { Some(best) }
}

-- What spilling each value would cost in executed loads and stores, by
-- `loopWeights`: a load at every read, and a store at the definition unless
-- the value has a root slot. The root store selection puts after a
-- definition is not counted as a read, since `spill` drops it for a value it
-- spills into that slot -- which is what makes a traced value the cheaper one
-- to send to memory.
--
-- Every read is charged although `spill` loads once for all the reads between
-- two calls. Charging only those loads is the plausible refinement and it
-- picks worse victims: a traced pointer read several times in a loop then
-- ties with an accumulator that pays a store and a load, and spilling the
-- pointer puts a load in front of every dereference. On a loop over two
-- arrays with nine accumulators, and on library loops a bytecode interpreter
-- spends its time in, it measured 1.5 to 3% slower.
--
-- A value `spill` would rematerialize pays no store, and each read costs a
-- quarter of a load: one instruction that waits on nothing. So it is the
-- holder `cheaperHolder` sends to memory first.
fun spillCosts[Spill i](f : Func i, roots : Map Int Int) -> Array Int {
	let weight = loopWeights(f)
	let remat = rematerializations(f, roots)
	let cost = Array.filled(len(f.reps), 0)
	for var b = 0; b < len(f.blocks); b = b + 1 {
		let block = f.blocks[b]
		let w = weight[b]
		let charge = fun(v : Value) {
			let id = Ssa.valueId(v)
			let each = if Map.contains(remat, id) { w } else { memoryCost * w }
			cost[id] = cost[id] + each
		}
		let stored = fun(v : Value) {
			let id = Ssa.valueId(v)
			if !Map.contains(roots, id) && !Map.contains(remat, id) {
				cost[id] = cost[id] + memoryCost * w
			}
		}
		for p in block.params { stored(p) }
		for i in block.insts {
			let rootStore = match slotStore(i) {
				Some((_, m)) -> isRootSlot(f, m)
				None         -> False
			}
			if !rootStore { Ssa.eachUse(i, charge) }
			Ssa.eachDef(i, stored)
		}
		for v in Ssa.termUses(block.term) { charge(v) }
	}
	cost
}

-- What `spillCosts` charges for one executed load or store, against one for
-- a repeated definition.
let memoryCost = 4

-- How often each block is guessed to run relative to the entry: ten times
-- over for each natural loop it is in, the weight Chaitin's spill cost uses,
-- up to four loops deep. A natural loop is a back edge -- an edge into a
-- block that dominates its source -- with every block that reaches the source
-- without passing the header. An irreducible cycle has no back edge, so its
-- blocks are weighted as if it were not a loop.
fun loopWeights(f : Func i) -> Array Int {
	let count = len(f.blocks)
	let idom = Ssa.dominators(f)
	let preds = Ssa.predecessors(f)
	let depth = Array.filled(count, 0)
	for var h = 0; h < count; h = h + 1 {
		let work : Vec Int = []
		for p in preds[h] {
			if Ssa.dominates(idom, Ssa.BlockId(h), p) { Vec.push(work, Ssa.blockId(p)) }
		}
		if len(work) > 0 {
			let body = BitSet.new(count)
			BitSet.add(body, h)
			while let Some(b) = Vec.pop(work) {
				if !BitSet.contains(body, b) {
					BitSet.add(body, b)
					for p in preds[b] { Vec.push(work, Ssa.blockId(p)) }
				}
			}
			for b in BitSet.elements(body) { depth[b] = depth[b] + 1 }
		}
	}
	Array.map(depth, fun(d) = loopWeight[if d < len(loopWeight) { d } else { len(loopWeight) - 1 }])
}

let loopWeight = [1, 10, 100, 1000, 10000]

-- How far ahead a value is next read, counting from instruction `from`: its
-- index if an instruction reads it, one past the last if the terminator does,
-- and two past if the block never does (it is live out, or dead).
fun nextUse[Ssa.Inst i](block : Ssa.Block i, id : Int, from : Int) -> Int {
	for var n = from; n < len(block.insts); n = n + 1 {
		if Ssa.anyUse(block.insts[n], fun(u) = Ssa.valueId(u) == id) { return n }
	}
	for u in Ssa.termUses(block.term) {
		if Ssa.valueId(u) == id { return len(block.insts) }
	}
	len(block.insts) + 1
}

-- For each value, the register numbers it may not take, as a mask: bit `n`
-- for register `n`. A bounded file's register numbers are below 64, so one
-- word holds the set, and the value's file says which file it is of. An
-- unbounded file has no physical registers, so nothing forbids one of its
-- registers, whatever its number.
--
-- One sweep: at every instruction, whatever physical registers it writes are
-- denied to every value live *across* it, and a call writes all of the
-- caller-saved ones. A value never live across such a point collects an empty
-- set and takes the first register in the pool.
--
-- Each block is walked backwards with one running live set. Most instructions
-- clobber nothing and sit where no physical register is live, and they cost
-- only the update of that set: the live values are listed only where there is
-- something to deny them.
fun forbiddenSets[Colour i](f : Func i, liveOut : Array BitSet) -> Array Int {
	let out = Array.filled(len(f.reps), 0)
	let live = BitSet.new(len(f.reps))
	let all = files(f)
	let clobbered = Array.filled(len(all), 0)
	for var b = 0; b < len(f.blocks); b = b + 1 {
		let block = f.blocks[b]
		let (physical, _) = physicalLive(f, block)
		BitSet.copyFrom(live, liveOut[b])
		for v in Ssa.termUses(block.term) { BitSet.add(live, Ssa.valueId(v)) }
		for var n = len(block.insts) - 1; n >= 0; n = n - 1 {
			-- `live` is what is live after instruction `n`.
			let i = block.insts[n]
			var clobbering = False
			for var k = 0; k < len(all); k = k + 1 {
				clobbered[k] = clobbers(i, all[k])
				if clobbered[k] != 0 { clobbering = True }
			}
			let held = physical[n]
			let holding = anyHeld(held)
			if clobbering || holding {
				let after = BitSet.elements(live)
				for id in after {
					out[id] = out[id] | clobbered[fileIndex(f, fileOf(f, id))]
				}
				-- And the other half: a physical register that is *live*
				-- here -- written by an earlier instruction, read by a later
				-- one -- is denied to everything live across this point and
				-- to whatever this instruction defines, since defining a
				-- value writes its register.
				if holding {
					for id in touched(i, after) { forbidHeld(out, f, held, id) }
				}
			}
			Ssa.eachDef(i, fun(d) {
				let _ = BitSet.remove(live, Ssa.valueId(d))
			})
			Ssa.eachUse(i, fun(u) = BitSet.add(live, Ssa.valueId(u)))
		}
	}
	out
}

fun forbidHeld[Colour i](out : Array Int, f : Func i, held : PhysicalLive, id : Int) -> Unit {
	for r in held.byFile[fileIndex(f, fileOf(f, id))] { out[id] = forbid(out[id], r) }
}

fun forbids(mask : Int, n : Int) -> Bool = n < boundedRegisters && mask >> n & 1 != 0

fun forbid(mask : Int, n : Int) -> Int = mask | 1 << n

-- The values live after an instruction, plus the ones it defines whether or
-- not they are used. A dead definition still writes a register. Without
-- repeats: a definition may be live after, and an instruction defines one or
-- two values, so a scan finds it.
fun touched[Colour i](inst : i, after : Array Int) -> Vec Int {
	let out = Vec.fromArray(after)
	Ssa.eachDef(inst, fun(d) {
		let id = Ssa.valueId(d)
		if !Vec.contains(out, id) { Vec.push(out, id) }
	})
	-- And an operand read after the destination is written, which holds its
	-- register at the same time as the destination does.
	let late = readAfterWrite(inst)
	if late != 0 {
		let operands = Ssa.uses(inst)
		for var k = 0; k < len(operands); k = k + 1 {
			let id = Ssa.valueId(operands[k])
			if readsLate(late, k) && !Vec.contains(out, id) { Vec.push(out, id) }
		}
	}
	out
}

-- Physical registers live at a program point, per file by `fileIndex`.
-- Arrays of distinct register numbers, for the reason `Ssa.liveAfter` answers
-- arrays.
type PhysicalLive = PhysicalLive { byFile : Array (Array Int) }

fun anyHeld(held : PhysicalLive) -> Bool {
	for registers in held.byFile {
		if len(registers) > 0 { return True }
	}
	False
}

-- The physical registers live *after* each instruction of a block, and the
-- ones live on entry to it.
--
-- One backward walk: a register a later instruction reads is live until the
-- instruction that writes it. Selection only ever writes a physical register
-- and reads it back within one block -- on arm64, arguments into `x0`-`x7`
-- before a call and the results out of `x0` up after it -- so nothing should
-- be live on entry, and `verifyColouring` says so if it is. A register that
-- is never live (`eachPhysicalRead`) is not counted.
fun physicalLive[Colour i](f : Func i, block : Ssa.Block i) -> (Array PhysicalLive, PhysicalLive) {
	let count = len(files(f))
	-- Nothing is live at almost every point, so those share one value.
	let nothing = noneLive(count)
	let sets = Array.init(len(block.insts), fun(_) = nothing)
	let live = Array.map(files(f), fun(file) = BitSet.new(physicalCount(f, file)))
	for var n = len(block.insts) - 1; n >= 0; n = n - 1 {
		if anyLive(live) { sets[n] = PhysicalLive { byFile = Array.map(live, BitSet.elements) } }
		let i = block.insts[n]
		eachPhysicalWrite(i, fun(file, k) {
			let _ = BitSet.remove(live[fileIndex(f, file)], k)
		})
		eachPhysicalRead(i, fun(file, k) = BitSet.add(live[fileIndex(f, file)], k))
	}
	(sets, PhysicalLive { byFile = Array.map(live, BitSet.elements) })
}

fun noneLive(count : Int) -> PhysicalLive = PhysicalLive { byFile = Array.init(count, fun(_) = []) }

fun anyLive(live : Array BitSet) -> Bool {
	for registers in live {
		if !BitSet.isEmpty(registers) { return True }
	}
	False
}

--- Whether a colouring is actually a colouring.
---
--- Two things are wrong and both are invisible downstream:
---
--- * **Two values live at one point sharing a register.** The colouring is
---   worthless if this happens, and nothing later can tell -- the printer will
---   print it, the assembler will assemble it, and the program will compute a
---   wrong number.
--- * **A value holding a register that is clobbered while it is live.** The
---   classic form is a value in a caller-saved register across a call, which
---   the callee destroys.
---
--- Both are quadratic in the live set at worst and the live sets are small,
--- which is what makes checking every program point affordable.
fun verifyColouring[Colour i](f : Func i, c : Colouring) -> Vec String {
	-- `Ssa.verify` checks the graph and knows nothing about registers, so this
	-- is the allocator's half of the same idea: the pass that can silently
	-- produce code which assembles, links, runs and computes the wrong answer
	-- gets a checker rather than a hope.
	let out : Vec String = []
	let (_, liveOut) = Ssa.livenessInOut(f)
	let forbidden = forbiddenSets(f, liveOut)
	-- Reachable blocks only, which is what `colour` walks. An unreachable
	-- block's values are never coloured and never executed, so checking them
	-- reports a problem that does not exist -- and it reported thousands.
	--
	-- That the corpus *has* unreachable blocks is a separate matter and not a
	-- happy one: they are the panic blocks a guard creates, which means the
	-- branch to them went missing.
	let none = noneLive(len(files(f)))
	for at in Ssa.reversePostorder(f) {
		let b = Ssa.blockId(at)
		let block = f.blocks[b]
		let after = Ssa.liveAfter(f, at, liveOut[b])
		let (physical, entering) = physicalLive(f, block)
		-- The entry block is the exception, and the only one: it reads the
		-- argument registers the caller wrote.
		if anyHeld(entering) && b != Ssa.blockId(f.entry) {
			Vec.push(out, "a physical register is live on entry to block b" + Int.toString(b))
		}
		for var n = 0; n < len(block.insts); n = n + 1 {
			checkPoint(
				out,
				f,
				c,
				forbidden,
				touched(block.insts[n], after[n]),
				physical[n],
				where_(b, n),
			)
		}
		checkPoint(out, f, c, forbidden, BitSet.elements(liveOut[b]), none, where_(b, -1))
	}
	out
}

-- One program point: the values live there and the ones just defined, which
-- is every value holding a register at that moment.
fun checkPoint[Colour i, Iterator l, Item l ~ Int](
	out : Vec String,
	f : Func i,
	c : Colouring,
	forbidden : Array Int,
	live : l,
	physical : PhysicalLive,
	at : String,
) -> Unit {
	let seen = Map.new()
	for id in live {
		let r = c.of_[id]
		-- A value that is live and has no register is the failure this check
		-- did not have and needed: it is not a collision, so the loop below
		-- says nothing about it, and it is not a stop, so the histogram says
		-- nothing either. Every function parameter was in this state and the
		-- run reported a clean bill.
		if r < 0 {
			Vec.push(
				out,
				"value %" + Int.toString(id) + " is live at " + at + " with no register assigned",
			)
		}
		if r >= 0 {
			let file = fileOf(f, id)
			let slot = keyIn(f, file, r)
			let k = registerName(f, file, r)
			match Map.get(seen, slot) {
				Some(other) -> Vec.push(
					out,
					"values %"
						+ Int.toString(other)
						+ " and %"
						+ Int.toString(id)
						+ " both hold "
						+ k
						+ " at "
						+ at,
				)
				None -> Map.put(seen, slot, id)
			}
			if forbids(forbidden[id], r) {
				Vec.push(
					out,
					"value %"
						+ Int.toString(id)
						+ " holds "
						+ k
						+ ", which is clobbered while it is live, at "
						+ at,
				)
			}
			if Array.contains(physical.byFile[fileIndex(f, file)], r) {
				Vec.push(
					out,
					"value %"
						+ Int.toString(id)
						+ " holds "
						+ k
						+ " while the physical "
						+ k
						+ " is live, at "
						+ at,
				)
			}
		}
	}
}

fun where_(b : Int, n : Int) -> String =
	if n < 0 {
		"the end of block b" + Int.toString(b)
	} else {
		"b" + Int.toString(b) + " instruction " + Int.toString(n)
	}

--- Pressure counting only the values that have nowhere free to go.
---
--- This number is the answer to "what if there are too many untraced values":
--- if it fits in the file, the traced fallback is enough and nothing needs a
--- frame; if it does not, a real spiller does, and this says by how much.
fun untracedPressure[Colour i](f : Func i) -> Pressure {
	-- An untraced value has no root slot, so spilling one needs a real stack
	-- slot and therefore a frame.
	let traced = BitSet.new(len(f.reps))
	for var id = 0; id < len(f.reps); id = id + 1 {
		if f.reps[id].traced { BitSet.add(traced, id) }
	}
	peakPressure(f, Ssa.liveness(f), traced)
}

--- The most values live across any single call in each file, traced and
--- untraced together, counting the calls `acrossCalls` counts.
---
--- `acrossCalls` reports the two categories' maxima independently, which can be
--- at different call sites and so understates the worst one. This is the number
--- the callee-saved budget is actually spent against.
fun worstCall[Colour i](f : Func i) -> Pressure {
	let liveOut = Ssa.liveness(f)
	let worst = Array.filled(len(files(f)), 0)
	let here = Array.filled(len(worst), 0)
	for var b = 0; b < len(f.blocks); b = b + 1 {
		let block = f.blocks[b]
		let after = Ssa.liveAfter(f, Ssa.BlockId(b), liveOut[b])
		for var n = 0; n < len(block.insts); n = n + 1 {
			if clobbersOnCall(f, block.insts[n]) {
				for var k = 0; k < len(here); k = k + 1 { here[k] = 0 }
				for id in after[n] {
					let k = fileIndex(f, fileOf(f, id))
					here[k] = here[k] + 1
				}
				for var k = 0; k < len(here); k = k + 1 {
					if here[k] > worst[k] { worst[k] = here[k] }
				}
			}
		}
	}
	Pressure(worst)
}

--- Which register each value would rather have, or `-1`.
---
--- A preference, never a pin: taking it makes a move redundant, and missing it
--- keeps the move and is still correct.
fun moveHints[Colour i](f : Func i) -> Array Int {
	-- A pin could contradict -- a parameter fixed in `x0` and live across a
	-- call has had `x0` destroyed -- and a preference cannot, which is the
	-- whole reason the calling convention is written as moves
	-- (`Select.incoming`, `Select.call`) rather than as constraints.
	--
	-- Read off those moves: a value moved out of a physical register, or into
	-- one, would like that register. That covers the parameters, the arguments
	-- and the results at once.
	let out = Array.filled(len(f.reps), -1)
	for block in f.blocks {
		for i in block.insts {
			if let Some((id, n)) = moveHint(i) {
				if out[id] < 0 { out[id] = n }
			}
		}
	}
	out
}

--- How many hinted values got the register their move wanted.
---
--- Every miss is one move the emitter keeps. A miss is not a bug -- a value
--- live across a call *must* miss an argument register, which is caller-saved
--- -- so this is a code-quality number rather than a correctness one.
fun hintsTaken[Colour i](f : Func i, c : Colouring) -> (Int, Int) {
	let hints = moveHints(f)
	var taken = 0
	var total = 0
	for var id = 0; id < len(hints) && id < len(c.of_); id = id + 1 {
		if hints[id] >= 0 {
			total = total + 1
			if c.of_[id] == hints[id] { taken = taken + 1 }
		}
	}
	(taken, total)
}

-- -- spilling ---------------------------------------------------------------

--- What has gone to memory, and where. `s` is the target's `Slot i`.
type Spills i s = Spills {
	--- Spilled value id -> its slot: its root slot if `Turkey.Roots` gave it
	--- one, a spill slot of its own otherwise.
	slots : Map Int s
	--- Rematerialized value id -> its defining instruction. Such a value has
	--- no slot and no store: its definition is deleted, and each reload of it
	--- repeats that instruction into the reload's value.
	remat : Map Int i
	--- Reload value id -> the spilled or rematerialized value it reloads.
	reloadOf : Map Int Int
	--- The reloads read more than once. Only these may be evicted: a later
	--- round splits one back into a reload per read.
	shared         : Set.Set Int
	var spillSlots : Int
	var stores     : Int
}

fun newSpills() -> Spills i s =
	Spills {
		slots      = Map.new()
		remat      = Map.new()
		reloadOf   = Map.new()
		shared     = Set.new()
		spillSlots = 0
		stores     = 0
	}

--- What `allocate` answers. `s` is the target's `Slot i`.
type Allocation i s = Allocation {
	--- The function as allocated: unreachable blocks gone, spill code in.
	func      : Func i
	colouring : Colouring
	spills    : Spills i s
	--- How many times spill code was inserted before the colouring finished.
	rounds      : Int
	var stopped : Option String
	--- Each block's live-out set in `func`, from the walk that coloured it:
	--- what `Turkey.Frame` reads a poll's live registers from.
	liveOut : Array BitSet
}

let maxRounds = 16

--- Spill, then colour, until the colouring finishes.
---
--- The input is not changed.
fun allocate[Spill i](f : Func i, roots : Map Int Int) -> Allocation i (Slot i) {
	-- A spilled value is stored once, directly after its definition, and
	-- reloaded into a fresh value before a read -- once for every read up to
	-- the next call, in its block and in the blocks below it that have no
	-- other predecessor (`spill`). Every reload dominates its reads, so the
	-- function stays in SSA form with no reconstruction -- which here would
	-- also mean splitting edges, since a `Branch` cannot carry the block
	-- argument a merge would need -- and the chordal theorem still holds for
	-- the next walk.
	--
	-- The walk decides what to spill as it fails (`place`), so the loop is
	-- spill what the last walk named, then walk again. It converges because a
	-- value is spilled at most once, a store is never spilled, and a reload is
	-- spilled only if it has more than one read, into reloads that have one;
	-- the cap is a report, not a policy.
	--
	-- Selection's output is still printed and measured after this runs, and a
	-- pass that mutated it would make both lie.
	let g = copyFunc(Ssa.pruneUnreachable(f))
	let spills = newSpills()
	var rounds = 0
	var answer = Allocation {
		func      = g
		colouring = Colouring { of_ = [], stopped = None }
		spills    = spills
		rounds    = 0
		stopped   = None
		liveOut   = []
	}
	var going = True
	while going {
		let w = walk(g, spills, roots, Some(spillCosts))
		answer = Allocation {
			func      = g
			colouring = Colouring { of_ = w.of_, stopped = w.stopped }
			spills    = spills
			rounds    = rounds
			stopped   = w.stopped
			liveOut   = w.liveOut
		}
		match w.stopped {
			Some(_) -> { going = False }
			None -> if len(w.evicted) == 0 {
				going = False
			} else if rounds == maxRounds {
				answer.stopped = Some(
					"spilling did not finish in " + Int.toString(maxRounds) + " rounds",
				)
				going = False
			} else {
				spill(g, w.evicted, w.crowded, roots, spills)
				rounds = rounds + 1
			}
		}
	}
	answer
}

-- Each value `spill` sends to memory by repeating its definition, and that
-- definition. Not a rooted one: its root store reads the value after its
-- definition, and the frame table names its slot.
fun rematerializations[Spill i](g : Func i, roots : Map Int Int) -> Map Int i {
	let out = Map.new()
	for block in g.blocks {
		for i in block.insts {
			if rematerializable(i) {
				Ssa.eachDef(i, fun(d) {
					let id = Ssa.valueId(d)
					if !Map.contains(roots, id) { Map.put(out, id, i) }
				})
			}
		}
	}
	out
}

fun copyFunc(f : Func i) -> Func i {
	let g = Ssa.newFunc(f.name, f.results)
	g.module_ = f.module_
	for r in f.reps { Vec.push(g.reps, r) }
	for p in f.params { Vec.push(g.params, p) }
	for block in f.blocks {
		let made = Ssa.newBlock()
		for p in block.params { Vec.push(made.params, p) }
		for i in block.insts { Vec.push(made.insts, i) }
		made.term = block.term
		made.termAt = block.termAt
		Vec.push(g.blocks, made)
	}
	g.entry = f.entry
	g.at = f.at
	g.sites = f.sites
	g.variables = f.variables
	g.holds = f.holds
	g.anchors = f.anchors
	g
}

-- Store each value in `ids` after its definition, and reload it before the
-- first read after each call; a reload in `ids` is instead replaced by a
-- reload in front of each of its reads.
--
-- A reload stands in for its value until the next call or poll, through the
-- rest of its block and on into any block whose only predecessor is the one
-- it reaches the end of. Within that region it is one value in one register
-- and never live across a call, which is what the value itself could not be;
-- and since the region is a tree, it dominates every read it serves, so no
-- merge needs a parameter. A value in `crowded` was evicted for want of any
-- register, not of one that survives a call, and a reload held from read to
-- read would want one over the same stretch, so it gets a reload per read.
--
-- A rooted value's slot is its root slot. The collector scans that slot
-- whenever the safepoint's mask says the value is live, so writing it once at
-- the definition is the store rooting needs as well -- the safepoint is left
-- only the mask to write. That is the saving the root array was always going
-- to give this backend, and it is why the root array is consulted here and not
-- only by the emitter. It is also why splitting at the calls costs only the
-- loads: the store was owed anyway.
--
-- A value `rematerializations` names gets no slot and no store. Its
-- definition is deleted, since every read of it is renamed, and its reload is
-- a copy of that definition into the reload's value: a constant is one
-- instruction to recompute, where a slot costs a store, a load, and room in
-- the frame.
--
-- Positions: a store takes its definition's, a reload or a recomputation the
-- position of the read it serves, and neither is a stepping target. A block
-- parameter is defined at the block's start, so its store takes the position
-- of what the block does first.
fun spill[Spill i](
	g : Func i,
	ids : Set.Set Int,
	crowded : Set.Set Int,
	roots : Map Int Int,
	spills : Spills i (Slot i),
) -> Unit {
	let splitting = Set.new()
	let remat = rematerializations(g, roots)
	for id in Array.sort(Set.elements(ids)) {
		if Map.contains(spills.reloadOf, id) {
			Set.add(splitting, id)
			continue
		}
		if let Some(def) = Map.get(remat, id) {
			Map.put(spills.remat, id, def)
			continue
		}
		let slot = match Map.get(roots, id) {
			Some(n) -> rootSlot(g, n)
			None -> {
				let n = spills.spillSlots
				spills.spillSlots = n + 1
				spillSlot(g, n)
			}
		}
		Map.put(spills.slots, id, slot)
	}
	let preds = Ssa.predecessors(g)
	let leaving : Array (Option (Map Int Int)) = Array.filled(len(g.blocks), None)
	for at in Ssa.reversePostorder(g) {
		let b = Ssa.blockId(at)
		let block = g.blocks[b]
		-- Spilled value -> the reload standing in for it here.
		let ready = inherited(preds, leaving, b)
		let out : Vec i = []
		let entered = Position.notStmt(
			if len(block.insts) > 0 { positionOf(block.insts[0]) } else { block.termAt },
		)
		for p in block.params { storeIfSpilled(out, spills, ids, Ssa.valueId(p), entered) }
		for var n = 0; n < len(block.insts); n = n + 1 {
			let i = block.insts[n]
			-- Selection stores every root into its slot after its definition.
			-- A value spilled into that same slot is stored there by
			-- `storeIfSpilled` at the same point, so selection's store would
			-- be a reload and a second write of what the slot holds.
			if isRootStoreOfSpilled(g, i, ids, spills) { continue }
			if Ssa.anyDef(i, fun(d) = isRemade(Ssa.valueId(d), ids, splitting, spills)) {
				continue
			}
			var renamed = i
			for id in Array.sort(Set.elements(usedSpilled(Ssa.uses(i), ids))) {
				let t = standIn(g, out, spills, ready, crowded, id, Position.notStmt(positionOf(i)))
				renamed = Ssa.renameUses(renamed, renamedValue(_, id, t))
			}
			Vec.push(out, renamed)
			-- A call that defines its own result (on arm64, `Allocate`) keeps
			-- its safepoint map directly after it, where the frame expects
			-- it, and the result's spill store goes after the map.
			if isCall(i) && n + 1 < len(block.insts) && isSafepointMap(block.insts[n + 1]) {
				Vec.push(out, block.insts[n + 1])
				n = n + 1
			}
			Ssa.eachDef(
				i,
				fun(d) = storeIfSpilled(
					out,
					spills,
					ids,
					Ssa.valueId(d),
					Position.notStmt(positionOf(i)),
				),
			)
			if endsReloads(i) { clear(ready) }
		}
		var term = block.term
		for id in Array.sort(Set.elements(usedSpilled(Ssa.termUses(term), ids))) {
			let t = standIn(g, out, spills, ready, crowded, id, Position.notStmt(block.termAt))
			term = renamedTerm(term, id, t)
		}
		block.insts = out
		block.term = term
		leaving[b] = Some(ready)
	}
	for id in Set.elements(splitting) {
		let _ = Map.delete(spills.reloadOf, id)
		let _ = Set.remove(spills.shared, id)
	}
}

-- The value to read in place of the spilled or split `id`, loading it at the
-- end of `out` with position `at` if nothing loaded already stands in for it.
fun standIn[Spill i](
	g : Func i,
	out : Vec i,
	spills : Spills i (Slot i),
	ready : Map Int Int,
	crowded : Set.Set Int,
	id : Int,
	at : Int,
) -> Int {
	if let Some(from) = Map.get(spills.reloadOf, id) {
		return reload(g, out, spills, from, at)
	}
	match Map.get(ready, id) {
		Some(t) -> {
			Set.add(spills.shared, t)
			t
		}
		None -> {
			let t = reload(g, out, spills, id, at)
			if !Set.contains(crowded, id) { Map.put(ready, id, t) }
			t
		}
	}
}

-- Whether an instruction ends every reload's stretch: a call, which destroys
-- the registers a reload could otherwise keep, or an allocation or a poll, at
-- which the collector may run.
fun endsReloads[Spill i](inst : i) -> Bool = isCall(inst) || isPoll(inst)

-- What a block starts out knowing from above, as `leaving` records each
-- block's end: its predecessor's, if it has exactly one and that one is
-- done, and nothing otherwise. Reverse postorder visits a block's only
-- predecessor first, since that predecessor dominates it.
fun inherited(
	preds : Array (Vec BlockId),
	leaving : Array (Option (Map Int v)),
	b : Int,
) -> Map Int v {
	let out = Map.new()
	let p = onlyPredecessor(preds, b)
	if p >= 0 {
		if let Some(m) = leaving[p] {
			for (k, v) in Map.entries(m) { Map.put(out, k, v) }
		}
	}
	out
}

-- The one block with an edge into `b`, counting a block with several edges
-- into it once, or `-1`. A block that is its own predecessor has none for
-- this purpose: what it knows at its end is not known at its start.
fun onlyPredecessor(preds : Array (Vec BlockId), b : Int) -> Int {
	var only = -1
	for p in preds[b] {
		let n = Ssa.blockId(p)
		if n == b || (only >= 0 && n != only) { return -1 }
		only = n
	}
	only
}

fun clear(m : Map Int v) -> Unit {
	for k in Map.keys(m) {
		let _ = Map.delete(m, k)
	}
}

-- Whether `spill` deletes the definition of `id`, because each of its reads
-- gets a reload of its own instead: a reload being split, or a value being
-- rematerialized.
fun isRemade(id : Int, ids : Set.Set Int, splitting : Set.Set Int, spills : Spills i s) -> Bool =
	Set.contains(splitting, id) || (Set.contains(ids, id) && Map.contains(spills.remat, id))

fun isRootStoreOfSpilled[Spill i](
	g : Func i,
	inst : i,
	ids : Set.Set Int,
	spills : Spills i (Slot i),
) -> Bool = match slotStore(inst) {
	Some((v, m)) -> isRootSlot(g, m) && Set.contains(ids, v) && spilledInto(g, spills, v, m)
	None         -> False
}

-- Whether `m` is the slot value `id` was spilled into.
fun spilledInto[Spill i](g : Func i, spills : Spills i (Slot i), id : Int, m : Slot i) -> Bool =
	match Map.get(spills.slots, id) {
		Some(slot) -> slotName(g, slot) == slotName(g, m)
		None       -> False
	}

fun usedSpilled[Iterator c, Item c ~ Value](vs : c, ids : Set.Set Int) -> Set.Set Int {
	let out = Set.new()
	for v in vs {
		if Set.contains(ids, Ssa.valueId(v)) { Set.add(out, Ssa.valueId(v)) }
	}
	out
}

fun storeIfSpilled[Spill i](
	out : Vec i,
	spills : Spills i (Slot i),
	ids : Set.Set Int,
	id : Int,
	at : Int,
) -> Unit {
	if Set.contains(ids, id) {
		if let Some(slot) = Map.get(spills.slots, id) {
			Vec.push(out, spillStore(id, slot, at))
			spills.stores = spills.stores + 1
		}
	}
}

-- A fresh value holding `id`, at the end of `out` with position `at`: loaded
-- from its slot, or computed again by a copy of its definition.
fun reload[Spill i](
	g : Func i,
	out : Vec i,
	spills : Spills i (Slot i),
	id : Int,
	at : Int,
) -> Int {
	let t = Ssa.valueId(Ssa.freshValue(g, g.reps[id]))
	Map.put(spills.reloadOf, t, id)
	match Map.get(spills.slots, id) {
		Some(slot) -> Vec.push(out, spillLoad(t, slot, at))
		None -> if let Some(def) = Map.get(spills.remat, id) {
			Vec.push(out, remade(def, id, t, at))
		}
	}
	t
}

fun renamedValue(v : Value, from : Int, to : Int) -> Value =
	if Ssa.valueId(v) == from { Ssa.Value(to) } else { v }

fun renamedTerm(t : Term, from : Int, to : Int) -> Term = match t {
	Ret(vs) -> Ret(Vec.map(vs, renamedValue(_, from, to)))
	Jump(target, args) ->
		Jump(target, Vec.map(args, renamedValue(_, from, to)))
	Branch(c, yes, no)        -> Branch(renamedValue(c, from, to), yes, no)
	Switch(v, cases, default) -> Switch(renamedValue(v, from, to), cases, default)
	Panic(v)                  -> Panic(renamedValue(v, from, to))
	Unreachable               -> Unreachable
}

--- Whether spill code is what it claims to be.
---
--- `Ssa.verify` and `verifyColouring` still run on the allocated function and
--- still mean what they meant. This is the third check, and the one only
--- spilling needs: a register colouring can be perfect over code whose stores
--- and reloads are in the wrong places, and that is a wrong program which
--- neither of the other two can see.
fun verifyAllocation[Spill i](a : Allocation i (Slot i)) -> Vec String {
	let out : Vec String = []
	let g = a.func
	let spills = a.spills
	-- One value per slot.
	let owner = Map.new()
	for (id, slot) in Map.entries(spills.slots) {
		let name = slotName(g, slot)
		match Map.get(owner, name) {
			Some(other) -> Vec.push(
				out,
				"values %"
					+ Int.toString(other)
					+ " and %"
					+ Int.toString(id)
					+ " share the slot "
					+ name,
			)
			None -> Map.put(owner, name, id)
		}
	}
	let entry = Ssa.blockId(g.entry)
	let preds = Ssa.predecessors(g)
	let leaving : Array (Option (Map Int Unit)) = Array.filled(len(g.blocks), None)
	for at in Ssa.reversePostorder(g) {
		let b = Ssa.blockId(at)
		let block = g.blocks[b]
		-- The values defined on entry to this block, which a store at its
		-- head may be writing.
		let definers = if b == entry { Vec.append(g.params, block.params) } else { block.params }
		-- The reloads that may be read here: `spill`'s rule, kept apart.
		let ready = inherited(preds, leaving, b)
		for var n = 0; n < len(block.insts); n = n + 1 {
			let inst = block.insts[n]
			Ssa.eachUse(inst, fun(u) {
				let id = Ssa.valueId(u)
				if Map.contains(spills.slots, id) {
					checkStore(out, g, spills, definers, b, n, id)
				}
				checkRematRead(out, spills, id, where_(b, n))
				checkReloadRead(out, spills, ready, id, where_(b, n))
			})
			match slotLoad(inst) {
				Some((t, mem)) -> match Map.get(spills.reloadOf, t) {
					Some(from) -> {
						if !spilledInto(g, spills, from, mem) {
							Vec.push(
								out,
								"reload %"
									+ Int.toString(t)
									+ " loads the wrong slot for %"
									+ Int.toString(from),
							)
						}
						Map.put(ready, t, ())
					}
					None -> Vec.push(
						out,
						"a slot load at " + where_(b, n) + " is not a recorded reload",
					)
				}
				None -> checkRemade(out, spills, ready, inst, where_(b, n))
			}
			if endsReloads(inst) { clear(ready) }
			if !flagsIntact(block, n) {
				Vec.push(
					out,
					"the instruction at "
						+ where_(b, n)
						+ " does not follow the instruction that sets the flags it reads",
				)
			}
		}
		for u in Ssa.termUses(block.term) {
			let id = Ssa.valueId(u)
			if Map.contains(spills.slots, id) {
				Vec.push(
					out,
					"spilled value %"
						+ Int.toString(id)
						+ " is read by the terminator of b"
						+ Int.toString(b),
				)
			}
			checkRematRead(out, spills, id, "the terminator of b" + Int.toString(b))
			checkReloadRead(out, spills, ready, id, "the terminator of b" + Int.toString(b))
		}
		leaving[b] = Some(ready)
	}
	out
}

-- A spilled value is read by exactly one thing: the store of it to its own
-- slot, placed directly after its definition -- after a run of other stores at
-- most, or at the head of the block that defines it as a parameter.
--
-- Seven parameters, not eight, and the count is not style. Every function
-- takes its closure environment as a hidden first argument, so eight declared
-- parameters are nine in the general file -- a call this backend cannot yet
-- select. The first version had eight here and in `checkPoint`, and `turkey`
-- gained two stack-argument stops from its own allocator.
fun checkStore[Spill i](
	out : Vec String,
	g : Func i,
	spills : Spills i (Slot i),
	definers : Vec Value,
	b : Int,
	n : Int,
	id : Int,
) -> Unit {
	let block = g.blocks[b]
	let ok = match slotStore(block.insts[n]) {
		Some((v, mem)) -> v == id && spilledInto(g, spills, id, mem)
		None           -> False
	}
	if !ok {
		Vec.push(
			out,
			"spilled value %"
				+ Int.toString(id)
				+ " is read at "
				+ where_(b, n)
				+ " by something other than its store",
		)
		return
	}
	var m = n - 1
	while m >= 0 && isStore(block.insts[m]) { m = m - 1 }
	-- A call that defines its own result (on arm64, `Allocate`) has it stored
	-- after its safepoint map.
	if m >= 1 && isSafepointMap(block.insts[m]) && isCall(block.insts[m - 1]) {
		m = m - 1
	}
	let defined = if m >= 0 {
		Ssa.anyDef(block.insts[m], fun(d) = Ssa.valueId(d) == id)
	} else {
		mentions(definers, id)
	}
	if !defined {
		Vec.push(
			out,
			"the store of %"
				+ Int.toString(id)
				+ " at "
				+ where_(b, n)
				+ " is not directly after its definition",
		)
	}
}

fun mentions[Iterator c, Item c ~ Value](vs : c, id : Int) -> Bool {
	for v in vs {
		if Ssa.valueId(v) == id { return True }
	}
	False
}

fun isStore[Spill i](inst : i) -> Bool = Option.isSome(slotStore(inst))

-- A reload is read only where no call or poll lies between its load and the
-- read: later in its own block, or in a block reached from the end of that one
-- through edges into blocks with no other predecessor. That is the whole of
-- the region it may stand in for, and it is what makes a reload safe to keep
-- in any register -- it is never live across a call, so it needs no register
-- a callee preserves, and never across a point where the collector runs, so a
-- traced one needs no root. A read anywhere else means `spill` reused a load
-- across a merge, where it may not dominate the read, or across a call, where
-- the register holding it is gone.
fun checkReloadRead(
	out : Vec String,
	spills : Spills i s,
	ready : Map Int Unit,
	id : Int,
	at : String,
) -> Unit {
	if Map.contains(spills.reloadOf, id) && !Map.contains(ready, id) {
		Vec.push(
			out,
			"reload %"
				+ Int.toString(id)
				+ " is read at "
				+ at
				+ ", past a call or a merge since it was loaded",
		)
	}
}

-- A rematerialized value is read by nothing. Its definition is gone, and each
-- read reads a reload instead: a copy of that definition into a fresh value,
-- which `checkReloadRead` holds to a reload's rule, never read across a call
-- or a poll from where it was placed.
fun checkRematRead(out : Vec String, spills : Spills i s, id : Int, at : String) -> Unit {
	if Map.contains(spills.remat, id) {
		Vec.push(out, "rematerialized value %" + Int.toString(id) + " is read at " + at)
	}
}

-- A reload defined by anything but a slot load is a rematerialized value's,
-- and is defined by exactly that value's definition, renamed. From there it may
-- be read as any reload may.
fun checkRemade[Spill i](
	out : Vec String,
	spills : Spills i (Slot i),
	ready : Map Int Unit,
	inst : i,
	at : String,
) -> Unit {
	Ssa.eachDef(inst, fun(d) {
		let t = Ssa.valueId(d)
		if let Some(from) = Map.get(spills.reloadOf, t) {
			match Map.get(spills.remat, from) {
				Some(def) -> if show(remade(def, from, t, positionOf(inst))) != show(inst) {
					Vec.push(
						out,
						"reload %"
							+ Int.toString(t)
							+ " at "
							+ at
							+ " is not the definition of %"
							+ Int.toString(from),
					)
				}
				None -> Vec.push(
					out,
					"reload %"
						+ Int.toString(t)
						+ " at "
						+ at
						+ " is not a load of %"
						+ Int.toString(from)
						+ "'s slot",
				)
			}
			Map.put(ready, t, ())
		}
	})
}
