module Turkey.Roots (
    Frame(..), FrameObject(..), analyze, slotCount, liveAt, objectsAt, objectOf,
    isSafepoint,
)

-- Which values the collector must be able to find, and where each one lives
-- for the collector to read.
--
-- **An analysis, not a pass, and that is the whole design decision.** The
-- obvious alternative is an IR pass that *materializes* root frames, leaving
-- the emitter dumb. Two things argue it down.
--
-- The answer has more than one reader. Selection stores each live root into
-- its slot before a safepoint, the frame layout gives the slots offsets, and
-- the frame table tells the collector which of them are live at each return
-- address. What *can* go wrong -- silently, rarely, and only under
-- collection -- is **which values are live across which safepoint**, and all
-- three have to agree on it, so it is computed once, here.
--
-- And a pass would have cost the IR. Materializing roots needs the address of
-- a stack slot, which is an opcode the IR does not have and would gain for one
-- caller. The analysis needs nothing: it reads a `Func Low` and answers a
-- table.
--
-- The overflow and division checks are the other way round, and stay in the
-- emitter: arm64 wants `adds` and a flag register the IR cannot name, and
-- expanding them target-neutrally in the IR would cost what the flag saves.

import Data.Map as Map
import Data.Set as Set
import Turkey.Escape as Escape
import Turkey.LowIr as L
import Turkey.LowIr (Op(..), Low(..), Callee(..))
import Turkey.Ssa as Ssa
import Turkey.Ssa (Value(..), BlockId(..), Rep(..), RepClass(..), Func(..))

-- One function's root frame.
type Frame = Frame {
    -- Value id -> its slot. Only the traced values live across some safepoint
    -- are in it.
    slots : Map Int Int,
    -- (block, instruction) -> the value ids to publish there, sorted. Keyed on
    -- a string because a pair is not hashable here; the key is private to this
    -- module and `liveAt` is the only reader.
    at    : Map String (Array Int),
    -- The objects built in the frame (`StackObject`, `StackClosure`), in
    -- the order the frame lays them out, and each one's index by value id.
    objects : Array FrameObject,
    objectIndex : Map Int Int,
    -- (block, instruction) -> the objects whose traced fields the collector
    -- must read there, as indices into `objects`, sorted.
    held : Map String (Array Int),
}

-- An object in the frame: the value that is its address, its size in words
-- (the three header words, then the fields), and which fields are traced.
--
-- `zeroed` says its traced fields must be cleared on entry: some path reads
-- its slot before building it -- the head of a loop, holding the previous
-- iteration's object in a phi that holds something else on the way in -- and
-- on that path the collector would read whatever the stack held as pointers.
type FrameObject = FrameObject { id : Int, words : Int, traced : Array Int, zeroed : Bool }

fun key(b : Int, n : Int) -> String = Int.toString(b) + ":" + Int.toString(n)

fun slotCount(frame : Frame) -> Int = len(frame.slots)

-- The frame objects the collector must read at this position.
fun objectsAt(frame : Frame, b : Int, n : Int) -> Array Int =
    Map.getOr(frame.held, key(b, n), [])

-- The index of the frame object value `id` addresses, if it is one.
fun objectOf(frame : Frame, id : Int) -> Option Int = Map.get(frame.objectIndex, id)

-- The (slot, value) pairs to publish before the instruction at this position,
-- and nothing if it is not a safepoint.
fun liveAt(frame : Frame, b : Int, n : Int) -> Array (Int, Int) {
    let out = []
    for id in Map.getOr(frame.at, key(b, n), []) {
        match Map.get(frame.slots, id) {
            Some(slot) -> Array.push(out, (slot, id))
            None -> {}
        }
    }
    out
}

-- The whole analysis, once per function.
--
-- Liveness is computed once and every safepoint's set is read out of it, which
-- is what keeps a root set a property of a *program point* rather than of a
-- function -- the one that stops a cold path deciding what a hot one pays.
fun analyze(f : Func Low) -> Frame {
    let live = Ssa.liveness(f)
    let (objects, objectIndex) = objectsOf(f)
    -- A frame object's address is never a root: it names no heap object, and
    -- `x29` finds it again. It is excluded the way a constant is.
    let constants = constantsOf(f)
    let addresses = Set.new()
    for o in objects {
        Set.add(constants, o.id)
        Set.add(addresses, o.id)
    }
    let held = if len(objects) == 0 { Map.new() }
               else { slotsHeld(f, objects, objectIndex, Escape.reach(f, addresses)) }
    let needed = Set.new()
    let at = Map.new()
    for var b = 0; b < len(f.blocks); b = b + 1 {
        let after = Ssa.liveAfter(f, BlockId(b), live[b])
        let insts = Ssa.blockAt(f, BlockId(b)).insts
        for var n = 0; n < len(insts); n = n + 1 {
            if isSafepoint(insts[n].op) {
                let here = Array.sort(Set.elements(
                    across(f, constants, after[n], insts[n])))
                for id in here { Set.add(needed, id) }
                Map.put(at, key(b, n), here)
            }
        }
    }
    -- Sorted, so the slot a value gets does not depend on a set's iteration
    -- order and two runs produce the same output.
    let slots = Map.new()
    let ids = Array.sort(Set.elements(needed))
    for var i = 0; i < len(ids); i = i + 1 { Map.put(slots, ids[i], i) }
    Frame { slots = slots, at = at, objects = objects, objectIndex = objectIndex,
            held = held }
}

-- The frame objects, in instruction order, with their traced fields: those
-- whose operand is traced, which is the representation the object's metadata
-- was built from. A closure shell is two words, code then environment, and
-- only the environment is traced.
fun objectsOf(f : Func Low) -> (Array FrameObject, Map Int Int) {
    let out = []
    let index = Map.new()
    for block in f.blocks {
        for i in block.insts {
            let made = match i.op {
                StackObject(_, _, _, fields) -> {
                    let traced = []
                    for var k = 0; k < len(fields); k = k + 1 {
                        if Ssa.repOf(f, fields[k]).traced { Array.push(traced, k) }
                    }
                    Some(FrameObject { id = Ssa.valueId(i.result),
                                       words = 3 + len(fields), traced = traced,
                                       zeroed = False })
                }
                StackClosure(_, environment) -> Some(FrameObject {
                    id = Ssa.valueId(i.result), words = 5,
                    traced = match environment {
                        Some(_) -> [1]
                        None -> []
                    },
                    zeroed = False,
                })
                _ -> None
            }
            match made {
                Some(o) -> {
                    Map.put(index, o.id, len(out))
                    Array.push(out, o)
                }
                None -> {}
            }
        }
    }
    (out, index)
}

-- Where each frame object's fields must be published: the safepoints at which
-- its slot is *live*, treating the slot as a variable that the object's
-- construction writes and every use of a value that may reach it reads.
-- A safepoint's own operands count as read across it, since the callee holds
-- them.
--
-- **Not** "wherever a value that may reach it is live", which is the obvious
-- rule and is wrong. What a value may reach is flow-insensitive: a phi that
-- carries the object into a loop reaches it on every iteration, though after
-- the first it holds something else. Between its last real use and the next
-- iteration no live value reaches the object, so a collection there does not
-- trace its fields and frees what they named; the next iteration publishes it
-- again, and the collector marks freed memory. Liveness of the slot closes
-- that gap -- from the construction to the last read, on every path -- so a
-- field is either traced at every collection since it was written or never
-- published again.
--
-- The same answer says which objects to clear on entry: those whose slot is
-- live there, read on some path before anything built it
-- (`FrameObject.zeroed`).
fun slotsHeld(f : Func Low, objects : Array FrameObject, objectIndex : Map Int Int,
              reached : Map Int (Set.Set Int)) -> Map String (Array Int) {
    -- The objects a value may reach, as indices.
    let of_ = fun(v : Value) -> Array Int {
        let out = []
        match Map.get(reached, Ssa.valueId(v)) {
            Some(ids) -> for o in Set.elements(ids) {
                match Map.get(objectIndex, o) {
                    Some(k) -> Array.push(out, k)
                    None -> {}
                }
            }
            None -> {}
        }
        out
    }
    let count = len(f.blocks)
    let liveIn : Array (Set.Set Int) = []
    for var b = 0; b < count; b = b + 1 { Array.push(liveIn, Set.new()) }
    -- Backwards through one block from its live-out set, calling `at` with
    -- each safepoint's published objects.
    let walk = fun(b : Int, at : fun(Int, Set.Set Int) -> Unit) -> Set.Set Int {
        let live = Set.new()
        for s in Ssa.successors(f.blocks[b].term) {
            for k in Set.elements(liveIn[Ssa.blockId(s)]) { Set.add(live, k) }
        }
        for v in Ssa.termUses(f.blocks[b].term) {
            for k in of_(v) { Set.add(live, k) }
        }
        let insts = f.blocks[b].insts
        for var n = len(insts) - 1; n >= 0; n = n - 1 {
            match Map.get(objectIndex, Ssa.valueId(insts[n].result)) {
                Some(k) -> { let _ = Set.remove(live, k) }
                None -> {}
            }
            for v in Ssa.uses(insts[n]) {
                for k in of_(v) { Set.add(live, k) }
            }
            if isSafepoint(insts[n].op) { at(n, live) }
        }
        live
    }
    let order = Array.reverse(Ssa.reversePostorder(f))
    var changed = True
    while changed {
        changed = False
        for block in order {
            let b = Ssa.blockId(block)
            let entering = walk(b, fun(_, _) = {})
            if len(entering) != len(liveIn[b]) { changed = True }
            liveIn[b] = entering
        }
    }
    let held = Map.new()
    for var b = 0; b < count; b = b + 1 {
        let _ = walk(b, fun(n, live) = {
            if len(live) > 0 { Map.put(held, key(b, n), Array.sort(Set.elements(live))) }
        })
    }
    for k in Set.elements(liveIn[Ssa.blockId(f.entry)]) { objects[k].zeroed = True }
    held
}

-- The traced values live *across* a safepoint, which is not the same as those
-- live after it.
--
-- An argument whose last use is this very call is dead afterwards and is still
-- needed *during* it: the callee holds it, and the collector may run while it
-- does. Rooting only what survives the call freed `Int.toString`'s result
-- while `turkey_string_concat` was reading it, and "circle of 5" came out
-- "circle of c".
--
-- An allocation is the same case from the other side: `ObjectNew` and
-- `ClosureNew` write their operands into the object *after* allocating it, so
-- an operand read only by the allocation is dead after it and still needed
-- during it.
--
-- The result goes the other way and must *not* be rooted: it does not exist
-- until the collection is over, so storing it would be a use before its
-- definition -- not merely useless but not SSA, which clang answers with a
-- segfault rather than a diagnosis.
--
-- Both halves have to hold at once, and getting either backwards produces a
-- wrong answer at run time rather than a failure here.
fun across(f : Func Low, constants : Set.Set Int, live : Array Int,
           i : Low) -> Set.Set Int {
    let out = Set.new()
    for id in live {
        if id != Ssa.valueId(i.result) && root(f, constants, id) { Set.add(out, id) }
    }
    for v in Ssa.uses(i) {
        let id = Ssa.valueId(v)
        if id != Ssa.valueId(i.result) && root(f, constants, id) { Set.add(out, id) }
    }
    out
}

-- A traced value the collector has something to find at. A constant is not
-- one: a traced constant is always a null -- the environment every direct call
-- passes, or the fill of a fresh pointer array -- and a null names no object.
-- Rooting one costs a store per call site, and gives a function that holds
-- nothing a root frame anyway.
fun root(f : Func Low, constants : Set.Set Int, id : Int) -> Bool =
    if id < 0 || id >= len(f.reps) { False }
    else { f.reps[id].traced && !Set.contains(constants, id) }

fun constantsOf(f : Func Low) -> Set.Set Int {
    let out = Set.new()
    for block in f.blocks {
        for i in block.insts {
            match i.op {
                ConstInt(_) -> Set.add(out, Ssa.valueId(i.result))
                _ -> {}
            }
        }
    }
    out
}

-- An operation the collector may run inside.
--
-- Every call, and every allocation. Being wrong in the *inclusive* direction
-- costs a store and a mask write; being wrong the other way frees a live
-- object under the program's feet, so a call that cannot itself allocate is
-- listed anyway -- it may call one that can.
--
-- Matched exhaustively rather than defaulted, because the question this asks
-- of a new opcode -- can the collector run inside it -- is one whose wrong
-- answer is silent, and a `_ ->` arm would answer it by omission.
fun isSafepoint(op : Op) -> Bool = match op {
    Call(_, _) -> True
    ObjectNew(_, _, _, _, _) -> True
    ArrayNew(_, _, _) -> True
    CellNew(_) -> True
    ClosureNew(_, _) -> True
    -- The frame is already there: building in it takes nothing from the heap.
    StackObject(_, _, _, _) -> False
    StackClosure(_, _) -> False
    -- These two are safepoints here and are not allocations in
    -- `LowIr.effectsOf`, the one place the lists disagree, and they answer
    -- different questions. `Unbox` is a call into the runtime and every call
    -- is listed; `ClosureCapture` is an inline store in `Turkey.Select` and is
    -- listed in the direction that costs a store rather than a freed object.
    -- The giblets check asks "may this allocate" and so reads `effectsOf`.
    ClosureCapture(_, _, _) -> True
    Box(_) -> True
    Unbox(_) -> True
    -- A string literal is interned by the runtime rather than allocated per
    -- evaluation, which is what makes it not a safepoint and what makes
    -- `ConstString` a load in the emitters.
    ConstString(_) -> False
    Address(_) -> False
    ConstInt(_) -> False
    ConstFloat(_) -> False
    ConstUnit -> False
    Bin(_, _, _) -> False
    Cmp(_, _, _) -> False
    Neg(_) -> False
    Not(_) -> False
    Convert(_, _) -> False
    ObjectGet(_, _) -> False
    ObjectSet(_, _, _) -> False
    ObjectTag(_) -> False
    ArrayGet(_, _) -> False
    ArraySet(_, _, _) -> False
    ArrayLength(_) -> False
    -- One machine instruction, and the whole reason raw memory is an opcode
    -- rather than a runtime call: nothing can collect inside a load, so
    -- nothing has to be rooted around one. The address itself is untraced,
    -- so there is also nothing here for the collector to move.
    PtrLoad(_, _, _) -> False
    PtrStore(_, _, _, _) -> False
    CellLoad(_) -> False
    CellStore(_, _) -> False
    GlobalLoad(_) -> False
    GlobalStore(_, _) -> False
    SlotLoad(_) -> False
    SlotStore(_, _) -> False
}
