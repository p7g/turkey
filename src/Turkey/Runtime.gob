module Turkey.Runtime (
    Entry(..), Routine(..), routineName, layoutCode, traceBit, elementWidth, accessWidth, entryPoint,
    processState, processStateBytes, voidSymbols, immediates, fieldLimit,
    headerBytes, headerGeneration, headerSize, headerKind, young, heapObject, heapCell,
    workerCursors, cursorBytes, cursorFree, cursorBase, cursorSlot, sizeClass, classSlot,
    classesGlobal, classStep, fastPayload, referencedSymbols, swapStackSymbol,
    workerRunningStack, workerStop, stackParked, stackResumedBy, stackStartSymbol, coroutineStart, workerStartSymbol, workerRun,
    emitsSymbol,
)

-- The interface shared by generated code and the runtime.
--
-- **The test for what belongs here is not "two passes read it".** It is
-- whether the thing is a fact about an artifact this compiler does not own.
-- The layout codes are a number `mark_children` reads out of an object header;
-- the entry points are symbols the runtime exports. Neither is a decision a
-- pass gets to make, so a pass holding its own copy is not a second
-- implementation of a rule -- it is a second transcription of someone else's
-- constant, which is the kind that drifts without anything going red.
--
-- That is a different argument from the one in `Turkey.Roots`, and the
-- difference is worth keeping straight. `Roots` is an *analysis*, kept apart
-- from selection because it is the one thing a collection depends on and
-- nothing else would notice being wrong. Here nothing is computed at all.
--
-- And it is the argument for what is *not* here. The overflow and division
-- checks stay in the emitter (`Turkey.Select`'s header): those are an
-- intention with no constant behind it, and each target writes its own
-- sequence.

import Turkey.Ssa as Ssa
import Turkey.Ssa (Rep(..), RepClass(..))

-- -- representations ------------------------------------------------------------------

-- The number the runtime calls this representation.
--
-- Written into an object's header three bits at a time by
-- `Turkey.SsaLower.metadata`, and passed to `turkey_cell_new` and
-- `turkey_array_new` by every emitter. One numbering,
-- read by `mark_children` -- so the collector follows a pointer iff the writer
-- and the caller agreed, and there is no diagnostic when they do not.
--
-- The two pointer codes are the whole reason `Rep` carries a trace bit as far
-- as the runtime: 7 is a pointer the collector follows and 6 is a
-- pointer-sized word it must not. A reader that tests `>= 6` follows both and
-- collects through a raw address.
fun layoutCode(r : Rep) -> Int = match r.class_ {
    Unit -> 0
    I1 -> 1
    I8 -> 2
    I32 -> 3
    I64 -> 4
    F64 -> 5
    Ptr -> if r.traced { 7 } else { 6 }
}

-- The most fields a tuple or constructed value can have: what one header word
-- describes, at three bits a field (`layoutCode`). A wider one is refused at
-- compile time; the allocator refuses one too, but the code generated in line
-- does not check, and would leave fields the collector does not see.
let fieldLimit = 21

-- Whether the collector must follow a slot, for the one-bit-per-slot encoding
-- that closures and environments use. Not `layoutCode`: one C field carries
-- both encodings and the object's kind is what says which.
fun traceBit(r : Rep) -> Int = if r.traced { 1 } else { 0 }

-- Bytes one array element occupies. `turkey_array_new` is called with this
-- width and the element is then read at this stride, so the two uses have to
-- be the same rule -- as they must also stay the same rule as
-- `turkey/backend_lower._layout_width`.
fun elementWidth(c : RepClass) -> Int = match c {
    I8 -> 1
    I32 -> 4
    _ -> 8
}

-- Bytes a *raw* access at this class touches.
--
-- Not `elementWidth`, and the difference is `I1`. An `Array Bool` gives a
-- whole word to an element, which is this compiler's choice about arrays; a
-- raw load at `i1` touches one byte, which is not a choice -- it is C's
-- `bool`, and raw memory is a layout someone else already decided. Sharing
-- one rule here would read a word out of a struct with a `bool` in it.
fun accessWidth(c : RepClass) -> Int = match c {
    Unit -> 0
    I1 -> 1
    I8 -> 1
    I32 -> 4
    _ -> 8
}

-- Words below this in a traced slot are not pointers, and the collector skips
-- them as it skips null: nothing is ever mapped in the first page, on any
-- target. A compact sum's nullary constructors are held there. `Turkey.Heap`
-- and `Turkey.HeapCheck` state the same bound for the collector's side.
let immediates = 4096

-- -- the heap's small-object cursors -------------------------------------------------

-- Generated code allocates a small object of a known size itself, from its
-- size class's cursor, and calls the runtime only when the cursor is empty
-- (`Turkey.Select.allocateInline`). So it depends on `Turkey.Heap`'s layouts
-- below, each of which that module defines under the same name.
--
-- The heap header, just before every payload: the generation word, the
-- payload's size, and the heap kind with a zero mark epoch above it.
let headerBytes = 24
let headerGeneration = 0
let headerSize = 8
let headerKind = 16
let young = 0
let heapObject = 2
let heapCell = 3

-- The running worker's cursors: one per size class, each `cursorBytes` long,
-- from `workerCursors` bytes into the worker's record (`A.worker`), so that an
-- allocation finds its class's cursor from `x28` with no load
-- (`Turkey.Heap.cursorOf`).
-- A cursor holds a word of free-slot bits (`cursorFree`, set bits free), the
-- header address of that word's first slot (`cursorBase`), and the class's
-- slot size (`cursorSlot`).
let workerCursors = 320
let cursorBytes = 64
let cursorFree = 0
let cursorBase = 8
let cursorSlot = 16

-- `Turkey.Heap.classes`: the size class of a payload, one byte for each step
-- of 16, indexed by the payload's size plus `classStep`, over 16. It covers a
-- payload of up to `fastPayload` bytes; a larger one is the runtime's to
-- place. Generated code reads it for an array, whose size is known only at
-- run time.
let classesGlobal = "Turkey.Heap#classes"
let classStep = 39
let fastPayload = 32728

-- The size class of a payload of `size` bytes: the class of its slot, header
-- included, rounded up to 16. `Turkey.Heap.classOf` reads the same answer out
-- of a table it builds with this rule, and the heap verifier is the test that
-- the two agree: it reports a small object in any other class's slot.
fun sizeClass(size : Int) -> Int {
    let bytes = Int.and(size + headerBytes + 15, -16)
    if bytes <= 32 { return 0 }
    if bytes <= 256 { return Int.shr(bytes + 15, 4) - 2 }
    var classSize = 256
    var c = 14
    while classSize < bytes {
        classSize = classSize * 2
        c = c + 1
    }
    c
}

-- The bytes between one slot of class `c` and the next.
fun classSlot(c : Int) -> Int = if c < 15 { 32 + 16 * c } else { Int.shl(256, c - 14) }

-- -- the process state -----------------------------------------------------------------

-- Storage every program defines for itself, zeroed, under this C symbol.
-- `Turkey.Process` owns its layout and reaches it through `Prim.processState`;
-- all the code generator knows is that the first word is an `Int` that is
-- nonzero while a panic or an exit unwinds.
--
-- That flag is data rather than a function because generated code reads it
-- after every call, and a call to ask would be one more call to test it
-- after. The symbol is named for the flag, since that is what C reads.
let processState = "turkey_has_panicked"

-- The worker's record: what `Turkey.Process` lays out in its first 320 bytes,
-- the cursors of `Turkey.Heap`'s 22 size classes, and then three words of the
-- worker's allocation counts, which the heap folds into its own.
let processStateBytes = workerCursors + cursorBytes * 22 + 24

-- -- what the backend names -----------------------------------------------------------

-- The runtime's `foreign` definitions that generated code calls or names by
-- C symbol. Nothing in a program's Core mentions them -- the backend writes
-- the references -- so reachability (`Turkey.Mono.reachable`) starts from
-- them, as it starts from `main`. A symbol missing here is a definition the
-- compile drops and the link then cannot find.
let referencedSymbols = [
    -- The entry sequence (`Turkey.Emit.emitEntry`).
    "turkey_main", "turkey_entry_returned", "turkey_entry_stack_set",
    "turkey_frame_table_register", "turkey_root_enter", "turkey_string_new",
    -- Selection: the slow paths of allocation, the write barrier, panics,
    -- and `Prim.exit` (`entryPoint`).
    "turkey_object_new", "turkey_cell_new", "turkey_closure_shell",
    "turkey_array_new", "turkey_write_barrier", "turkey_panic",
    "turkey_panic_string", "turkey_exit",
    -- A loop's poll (`Turkey.Polls`), and a worker thread's end
    -- (`Turkey.Emit.emitWorkerStart`).
    "turkey_poll", "turkey_worker_ended",
]

-- -- entry points ---------------------------------------------------------------------

-- A primitive's runtime implementation: the C symbol, and what C says it
-- returns.
--
-- `result` is `None` where C says `void`. That is not the same as the
-- language's unit and must not be spelled as it: a `void` function writes no
-- result register, so whatever the call's result is read as, it has to be
-- made rather than read (`Turkey.Select.call`).
--
-- `switchesStacks` marks the one entry point that does not return to its
-- caller's stack: it parks the caller and resumes another, so the code that
-- runs before it returns is anyone's, and a call to it preserves no register
-- (`Turkey.Arm64.PreservesNone`).
type Entry = Entry { symbol : String, result : Option RepClass, switchesStacks : Bool }

-- A primitive the runtime implements, which is what a `Runtime` call calls.
type Routine = Exit | SwapStack

let routines = [Exit, SwapStack]

fun entryPoint(r : Routine) -> Entry = match r {
    Exit -> Entry { symbol = "turkey_exit", result = None, switchesStacks = False }
    SwapStack -> Entry { symbol = swapStackSymbol, result = None, switchesStacks = True }
}

-- How the IR dump spells a routine: as the primitive it implements.
fun routineName(r : Routine) -> String = match r {
    Exit -> "Prim.exit"
    SwapStack -> "Prim.swapStack"
}

-- -- stacks -------------------------------------------------------------------------

-- `Prim.swapStack(from, to)`: park the running stack on `from` and resume
-- `to`. The code is the compiler's own, written once per program by
-- `Turkey.Emit.emitSwapStack`, because what it does is move `sp` and `x29`,
-- which no Turkey function can.
let swapStackSymbol = "turkey_swap_stack"

-- The word of the worker's record that names the stack it is running
-- (`Turkey.Stack.running`), which the switch updates, and the word of a stack
-- record that holds the frame record it was parked at:
-- `Turkey.Stack.stackParked`.
let workerRunningStack = 280

-- The word of the worker's record a loop's poll tests (`Turkey.Polls`): zero
-- unless the runtime wants the worker to stop at a safepoint, and then the
-- poll calls `turkey_poll`.
let workerStop = 272
let stackParked = 8
let stackResumedBy = 32

-- What a coroutine's stack runs first: the code `Turkey.Emit.emitStackStart`
-- writes, which calls the Turkey function `coroutineStart` and, when that
-- returns, switches back to the stack that resumed it for the last time.
-- `Turkey.Stack.new` parks a new stack with a return into it, which it
-- names with `Prim.codeAddress`.
let stackStartSymbol = "turkey_stack_start"
let coroutineStart = "Turkey.Coroutine#start"

-- What a worker thread runs (`Turkey.Scheduler`), entered from C through the
-- code `Turkey.Emit.emitWorkerStart` writes, which sets the worker's record in
-- `x28` and calls the Turkey function `workerRun`.
let workerStartSymbol = "turkey_worker_start"
let workerRun = "Turkey.Scheduler#workerLoop"

-- Whether `symbol` is code the compiler writes into every program that needs
-- it, which `Prim.codeAddress` may name as it names a `foreign` definition.
fun emitsSymbol(symbol : String) -> Bool =
    symbol == swapStackSymbol || symbol == stackStartSymbol || symbol == workerStartSymbol

-- The entry points C declares `void`. A caller reading their result register
-- reads whatever the callee last left there.
fun voidSymbols() -> Array String {
    let out = []
    for r in routines {
        let entry = entryPoint(r)
        if let None = entry.result { Array.push(out, entry.symbol) }
    }
    out
}
