export (
    Entry(..), Routine(..), routineName, traceBit, Element(..), element, arrayElements, cellValue, accessWidth, entryPoint,
    processState, processStateBytes, voidSymbols, immediates, tracedLimit,
    Layout(..), layout, fieldWidth, objectFields, objectBytes, fieldOffset, closureShell,
    closureCode, closureEnvironment, headerWord, staticHeaderWord, closureKind, arrayKind, cellKind, cellBytes,
    regionShift, regionSizes,
    workerCursors, cursorBytes, cursorFree, cursorBase, cursorSlot, sizeClass, classSlot,
    classesGlobal, classStep, classShift, fastBytes, referencedSymbols, swapStackSymbol,
    workerRunningStack, workerStop, stackParked, stackResumedBy, stackStartSymbol, coroutineStart, workerStartSymbol, workerRun,
    emitsSymbol,
)

--- The interface shared by generated code and the runtime.
---
--- **The test for what belongs here is not "two passes read it".** It is
--- whether the thing is a fact about an artifact this compiler does not own.
--- An array's element descriptor is two numbers the collector reads out of an
--- object header; the entry points are symbols the runtime exports. Neither is a decision a
--- pass gets to make, so a pass holding its own copy is not a second
--- implementation of a rule -- it is a second transcription of someone else's
--- constant, which is the kind that drifts without anything going red.
---
--- That is a different argument from the one in `Turkey.Roots`, and the
--- difference is worth keeping straight. `Roots` is an *analysis*, kept apart
--- from selection because it is the one thing a collection depends on and
--- nothing else would notice being wrong. Here nothing is computed at all.
---
--- And it is the argument for what is *not* here. The overflow and division
--- checks stay in the emitter (`Turkey.Select`'s header): those are an
--- intention with no constant behind it, and each target writes its own
--- sequence.

import Turkey.Ssa as Ssa
import Turkey.Ssa (Rep(..), RepClass(..))

-- -- representations ------------------------------------------------------------------

--- The most traced words an object can start with: its header counts them in
--- 16 bits. Lowering refuses an object with more.
let tracedLimit = 65535

-- -- objects ----------------------------------------------------------------------------

--- Where a sequence of fields is, in bytes from the first: each field's offset
--- and width, the bytes the sequence spans and the alignment it needs, and how
--- many of its words, from the first, are pointers the collector follows.
---
--- The layout of an object's fields is a function of their representations
--- and of nothing else, so every producer and every reader of an object that
--- computes it from the same representations finds each field in the same
--- place. That is the whole contract: no object says where its fields are.
---
--- The traced pointers come first, in field order, and then every other
--- field by decreasing width, in field order within a width. So every field is
--- at its natural alignment with no padding between fields, and the
--- collector's description of any object is one count (`pointers`): the words
--- to scan, starting where the fields do, right after the header it has just
--- read. Declaration order would leave padding after a narrow field and
--- scatter the pointers, and a pointer after a scalar would need a bitmap. A
--- `Unit` field is zero bytes, at the end.
---
--- Offsets are from the start of the fields, not of the object, so the same
--- layout places a sequence wherever it is put: after an object's header
--- (`objectFields`), or anywhere else at an alignment of `align`.
---
--- Nothing else in an object says where its pointers are, so the order is a
--- representation invariant the collector depends on: an object whose traced
--- fields were not first would have pointers it never scans.
type Layout = Layout {
    reps     : Array Rep,
    offsets  : Array Int,
    widths   : Array Int,
    size     : Int,
    align    : Int,
    pointers : Int,
}

--- Bytes a field of this representation occupies, and the alignment it needs.
---
--- An array's element of one slot takes the same bytes (`element`). Not
--- `accessWidth`, though the two agree: that one is C's layout, and this one is
--- this compiler's choice for its own objects.
fun fieldWidth(r : Rep) -> Int = match r.class_ {
    Unit -> 0
    I1 -> 1
    I8 -> 1
    I32 -> 4
    I64 -> 8
    F64 -> 8
    Ptr -> 8
}

let scalarWidths = [8, 4, 1, 0]

fun layout(reps : Array Rep) -> Layout {
    let offsets = Array.filled(len(reps), 0)
    let widths = Array.map(reps, fieldWidth)
    var at = 0
    var pointers = 0
    for var i = 0; i < len(reps); i = i + 1 {
        if reps[i].traced {
            offsets[i] = at
            at = at + 8
            pointers = pointers + 1
        }
    }
    var align = if pointers > 0 { 8 } else { 1 }
    for width in scalarWidths {
        for var i = 0; i < len(reps); i = i + 1 {
            if widths[i] == width && !reps[i].traced {
                offsets[i] = at
                at = at + width
                if width > align { align = width }
            }
        }
    }
    Layout { reps = reps, offsets = offsets, widths = widths,
             size = (at + align - 1) & -align, align = align,
             pointers = pointers }
}

--- Where an object's fields start: after its header, one word, which an
--- object's address points at. Little-endian, from its first byte:
---
---   +0  u8   the generation: 0 young, 1 old, 2 old and remembered
---   +1  u8   the kind: 0 constructor, 1 record, 2 array, 3 closure,
---            4 environment, 5 cell
---   +2  u16  the count of the traced words an object's fields start with: in
---            an array, the count each element starts with; in a cell, 1 if
---            its value is traced
---   +4  i32  the tag, which generated code reads with one 32-bit load; in an
---            array, its element's stride in bytes; unused in a cell
---
--- An array's length is the word after the header, and its elements follow
--- (`arrayElements`), laid out as `element` says; a cell's value is that word
--- (`cellValue`).
---
--- No object records its size. The heap knows it from the slot, since a small
--- object's size class is chosen from it, a large object has a region of its
--- own, and an array's length gives its elements. `Turkey.Alloc.header`
--- writes the same word, and `Turkey.Heap` and `Turkey.HeapCheck` read it.
let objectFields = 8

let closureKind = 3
let arrayKind = 2
let cellKind = 5

--- The header of an object of `kind` and `tag` whose fields start with
--- `traced` traced words, young. For a cell, `traced` is its flag. For an
--- array, it is the traced words each element starts with, and `tag` is the
--- stride (`Element`), the two numbers `turkey_array_new` is called with.
fun headerWord(kind : Int, traced : Int, tag : Int) -> Int =
    kind << 8 | traced << 16 | (tag & 0xFFFF_FFFF) << 32

--- The header of the same object laid out as static data: old, so that the
--- write barrier never remembers the object a store puts one in.
fun staticHeaderWord(kind : Int, traced : Int, tag : Int) -> Int =
    headerWord(kind, traced, tag) | oldGeneration

let oldGeneration = 1

--- The bytes of an object with these fields, header included: a whole number
--- of words, which is what the allocator clears and the verifier checks.
fun objectBytes(l : Layout) -> Int = objectFields + ((l.size + 7) & -8)

--- Field `index` of an object, in bytes from the object's address.
fun fieldOffset(l : Layout, index : Int) -> Int = objectFields + l.offsets[index]

--- A closure: its code's address and its environment, null when it captures
--- nothing. `Turkey.Alloc.closureShell` builds one, so it states the same
--- offsets.
let closureCode = 0
let closureEnvironment = 1
let closureShell = layout([Ssa.untraced(Ptr), Ssa.traced(Ptr)])

--- A cell's header count: 1 if the collector must follow its value.
fun traceBit(r : Rep) -> Int = if r.traced { 1 } else { 0 }

-- -- arrays ---------------------------------------------------------------------------

--- How an array lays out its elements: one element's slots, placed by `layout`
--- as an object's fields are, and the bytes from one element to the next. So
--- every element starts with `layout.pointers` traced words, and the array's
--- header holds that count and the stride (`headerWord`): the collector scans
--- that many words at every stride.
---
--- The stride is the layout's size, which is a multiple of its alignment, so
--- every slot of every element is at its natural alignment. An element of one
--- slot is that slot's `fieldWidth`, and an `Array Bool` gives an element one
--- byte. A bit per element would make a store a read, a change and a write of
--- a byte that other elements share, and two tasks storing into neighbouring
--- elements would lose one of the stores; a byte is stored on its own.
---
--- An element of no bytes, `unit`, is given a word anyway. A stride of 0 would
--- need its own case wherever a stride divides or scales a length (the
--- allocator's size classes, the collector, the copy loops), and an array of
--- `unit` is too rare for those cases to pay for themselves.
type Element = Element { layout : Layout, stride : Int }

fun element(reps : Array Rep) -> Element {
    let l = layout(reps)
    Element { layout = l, stride = if l.size == 0 { 8 } else { l.size } }
}

--- Where an array's first element is, in bytes from the array's address: after
--- its header and its length, as `Turkey.Alloc.arrayNew` writes them.
let arrayElements = 16

--- Where a cell's value is, in bytes from its address, as `Turkey.Alloc.cellNew`
--- writes it: what `CellLoad` and `CellStore` read and write and every access
--- to a `Prim.Atomic` is made at.
let cellValue = 8
let cellBytes = 16

--- Bytes a *raw* access at this class touches.
---
--- Not `fieldWidth`, though the two agree on every class: this one is C's
--- layout, and raw memory is a layout someone else already decided, where
--- `fieldWidth` is this compiler's choice for its own objects and arrays.
fun accessWidth(c : RepClass) -> Int = match c {
    Unit -> 0
    I1 -> 1
    I8 -> 1
    I32 -> 4
    _ -> 8
}

--- Words below this in a traced slot are not pointers, and the collector skips
--- them as it skips null: nothing is ever mapped in the first page, on any
--- target. A compact sum's nullary constructors are held there. `Turkey.Heap`
--- and `Turkey.HeapCheck` state the same bound for the collector's side.
let immediates = 4096

-- -- the heap's small-object cursors -------------------------------------------------

--- Generated code allocates a small object of a known size itself, from its
--- size class's cursor, and calls the runtime only when the cursor is empty
--- (`Turkey.Select.allocate`). So it depends on `Turkey.Heap`'s layouts below,
--- each of which that module defines under the same name.
---
--- A program compiled with `--gc-verify` also records each object's size, for
--- the heap verifier to check the size class against. A region's base is an
--- object's address with its low `regionShift` bits cleared, and the word at
--- `regionSizes` in it is a table as long as a region: the size of the object
--- at each offset in the region is the word at the same offset in the table.
let regionShift = 16
let regionSizes = 1080

--- The running worker's cursors: one per size class, each `cursorBytes` long,
--- from `workerCursors` bytes into the worker's record (`A.worker`), so that an
--- allocation finds its class's cursor from `x28` with no load
--- (`Turkey.Heap.cursorOf`).
--- A cursor holds a word of free-slot bits (`cursorFree`, set bits free), the
--- address of that word's first slot (`cursorBase`), and the class's slot size
--- (`cursorSlot`).
let workerCursors = 320
let cursorBytes = 64
let cursorFree = 0
let cursorBase = 8
let cursorSlot = 16

--- `Turkey.Heap.classes`: the size class of an object, one byte for each step
--- of 8, indexed by the object's size plus `classStep`, shifted right by
--- `classShift`. It covers an object of up to `fastBytes` bytes; a larger one
--- is the runtime's to place. Generated code reads it for an array, whose size
--- is known only at run time.
let classesGlobal = "Turkey.Heap#classes"
let classStep = 7
let classShift = 3
let fastBytes = 32760

-- How many small size classes there are, and so how many cursors.
let sizeClasses = 26

--- The size class of an object of `size` bytes, header included: the class of
--- its slot. Slots are 16 to 64 bytes in steps of 8, 80 to 256 in steps of 16,
--- and then powers of two. `Turkey.Heap.classOf` reads the same answer out of a
--- table it builds with this rule, and the heap verifier is the test that the
--- two agree: it reports a small object in any other class's slot.
fun sizeClass(size : Int) -> Int {
    let bytes = (size + 7) & -8
    if bytes <= 16 { return 0 }
    if bytes <= 64 { return (bytes >> 3) - 2 }
    if bytes <= 256 { return ((bytes + 15) >> 4) + 2 }
    var classSize = 256
    var c = 18
    while classSize < bytes {
        classSize = classSize * 2
        c = c + 1
    }
    c
}

--- The bytes between one slot of class `c` and the next.
fun classSlot(c : Int) -> Int =
    if c < 7 { 16 + 8 * c } else if c < 19 { 64 + 16 * (c - 6) } else { 256 << (c - 18) }

-- -- the process state -----------------------------------------------------------------

--- Storage every program defines for itself, zeroed, under this C symbol.
--- `Turkey.Process` owns its layout and reaches it through `Prim.processState`;
--- all the code generator knows is that the first word is an `Int` that is
--- nonzero while a panic or an exit unwinds.
---
--- That flag is data rather than a function because generated code reads it
--- after every call, and a call to ask would be one more call to test it
--- after. The symbol is named for the flag, since that is what C reads.
let processState = "turkey_has_panicked"

--- The worker's record: what `Turkey.Process` lays out in its first 320 bytes,
--- the cursors of `Turkey.Heap`'s size classes, and then three words of the
--- worker's allocation counts, which the heap folds into its own.
let processStateBytes = workerCursors + cursorBytes * sizeClasses + 24

-- -- what the backend names -----------------------------------------------------------

--- The runtime's `foreign` definitions that generated code calls or names by
--- C symbol. Nothing in a program's Core mentions them -- the backend writes
--- the references -- so reachability (`Turkey.Mono.reachable`) starts from
--- them, as it starts from `main`. A symbol missing here is a definition the
--- compile drops and the link then cannot find.
let referencedSymbols = [
    -- The entry sequence (`Turkey.Emit.emitEntry`).
    "turkey_main", "turkey_entry_returned", "turkey_entry_stack_set",
    "turkey_frame_table_set", "turkey_root_enter", "turkey_static_register",
    -- Selection: the slow paths of allocation, the write barrier, panics,
    -- and `Prim.exit` (`entryPoint`).
    "turkey_object_new", "turkey_cell_new", "turkey_closure_shell",
    "turkey_array_new", "turkey_write_barrier", "turkey_panic",
    "turkey_panic_string", "turkey_exit",
    -- A loop's poll (`Turkey.Polls`), and a worker thread's end
    -- (`Turkey.Emit.emitWorkerStart`).
    "turkey_poll", "turkey_worker_ended",
]

-- -- entry points ---------------------------------------------------------------------

--- A primitive's runtime implementation: the C symbol, and what C says it
--- returns.
---
--- `result` is `None` where C says `void`. That is not the same as the
--- language's unit and must not be spelled as it: a `void` function writes no
--- result register, so whatever the call's result is read as, it has to be
--- made rather than read (`Turkey.Select.call`).
---
--- `switchesStacks` marks the one entry point that does not return to its
--- caller's stack: it parks the caller and resumes another, so the code that
--- runs before it returns is anyone's, and a call to it preserves no register
--- (`Turkey.Arm64.PreservesNone`).
type Entry = Entry { symbol : String, result : Option RepClass, switchesStacks : Bool }

--- A primitive the runtime implements, which is what a `Runtime` call calls.
type Routine = Exit | SwapStack

let routines = [Exit, SwapStack]

fun entryPoint(r : Routine) -> Entry = match r {
    Exit -> Entry { symbol = "turkey_exit", result = None, switchesStacks = False }
    SwapStack -> Entry { symbol = swapStackSymbol, result = None, switchesStacks = True }
}

--- How the IR dump spells a routine: as the primitive it implements.
fun routineName(r : Routine) -> String = match r {
    Exit -> "Prim.exit"
    SwapStack -> "Prim.swapStack"
}

-- -- stacks -------------------------------------------------------------------------

--- `Prim.swapStack(from, to)`: park the running stack on `from` and resume
--- `to`. The code is the compiler's own, written once per program by
--- `Turkey.Emit.emitSwapStack`, because what it does is move `sp` and `x29`,
--- which no Turkey function can.
let swapStackSymbol = "turkey_swap_stack"

--- The word of the worker's record that names the stack it is running
--- (`Turkey.Stack.running`), which the switch updates, and the word of a stack
--- record that holds the frame record it was parked at:
--- `Turkey.Stack.stackParked`.
let workerRunningStack = 280

--- The word of the worker's record a loop's poll tests (`Turkey.Polls`): zero
--- unless the runtime wants the worker to stop at a safepoint, and then the
--- poll calls `turkey_poll`.
let workerStop = 272
let stackParked = 8
let stackResumedBy = 32

--- What a coroutine's stack runs first: the code `Turkey.Emit.emitStackStart`
--- writes, which calls the Turkey function `coroutineStart` and, when that
--- returns, switches back to the stack that resumed it for the last time.
--- `Turkey.Stack.new` parks a new stack with a return into it, which it
--- names with `Prim.codeAddress`.
let stackStartSymbol = "turkey_stack_start"
let coroutineStart = "Turkey.Coroutine#start"

--- What a worker thread runs (`Turkey.Scheduler`), entered from C through the
--- code `Turkey.Emit.emitWorkerStart` writes, which sets the worker's record in
--- `x28` and calls the Turkey function `workerRun`.
let workerStartSymbol = "turkey_worker_start"
let workerRun = "Turkey.Scheduler#workerLoop"

--- Whether `symbol` is code the compiler writes into every program that needs
--- it, which `Prim.codeAddress` may name as it names a `foreign` definition.
fun emitsSymbol(symbol : String) -> Bool =
    symbol == swapStackSymbol || symbol == stackStartSymbol || symbol == workerStartSymbol

--- The entry points C declares `void`. A caller reading their result register
--- reads whatever the callee last left there.
fun voidSymbols() -> Vec String {
    let out = []
    for r in routines {
        let entry = entryPoint(r)
        if let None = entry.result { Vec.push(out, entry.symbol) }
    }
    out
}
