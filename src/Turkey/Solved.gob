export (
    Scope(..), newScope,
    Abstraction(..), newAbstraction, Export(..),
    Use(..), newUse,
    Hole(..), Proof(..), newHole,
    InstanceCheck(..),
    dictName, resetDictNames,
)

--- What solving records for elaboration.
---
--- Three records, and they are here rather than with the elaborator because the
--- constraint tree holds them: a `CInstance` carries a `Use`, a `CLet` carries an
--- `Abstraction`, and a `CAssume` opens a `Scope`. Each is filled in *after* it
--- has been handed out -- what a binder makes available is not known until its
--- definition has been solved -- so what travels is the record and not its
--- contents.

import Turkey.Classes (Evidence(..), InstInfo(..), MethodInfo(..))
import Turkey.Source (Span)
import Turkey.Types as Ty
import Turkey.Types (Scheme(..), Pred(..))

--- The dictionaries a binder makes available inside its definition.
---
--- Created empty when the solver descends into a definition and filled in when it
--- comes back out. A `Use` only holds the record, so filling it late is enough.
--- The `id` is the identity: a scope is created once and handed out by
--- reference, and two scopes granting the same predicates are still two scopes,
--- so structure cannot stand in for it.
type Scope = Scope {
    id         : Int,
    var givens : Vec (String, Pred),
}

fun newScope() -> Scope {
    dictCounter.scopes = dictCounter.scopes + 1
    Scope { id = dictCounter.scopes, givens = Vec.new(2) }
}

--- The leading dictionary parameters of one binding group.
---
--- The generator hangs one of these on each declaration of the group and on the
--- group's `CLet`; the solver fills it in when it generalizes.
type Abstraction = Abstraction {
    var params : Vec String,
    var preds  : Vec Pred,
    --- The scheme each name in the group ended up with, filled in beside the
    --- parameters and by the same loop. A *local* binding's scheme is otherwise
    --- unrecoverable: it is defined into a child environment popped as soon as
    --- the body is solved, so by the time anything lowers the tree there is
    --- nowhere left to ask what `fun go()` was generalized to.
    schemes    : Map String Scheme,
    --- For a group that is one *signature-checked* declaration: which rigid
    --- constant stands for which of the signature's variables. A declared type is
    --- checked against skolems, so the body's recorded types name constants where
    --- the scheme names variables.
    skolems    : Map Int Ty.Type,
    --- By binder id, each binder whose scheme is a wrapper around the scheme
    --- the group's code is lowered at: a binder of a group of `fun`s whose
    --- scheme takes fewer of the group's class predicates or equalities than
    --- the group's bodies take, and every binder of a pattern `let` whose
    --- value takes type arguments or evidence. Every other binder's code is
    --- lowered at its own scheme.
    exports    : Map Int Export,
}

fun newAbstraction() -> Abstraction = Abstraction {
    params = Vec.new(2), preds = Vec.new(2),
    schemes = Map.new(), skolems = Map.new(), exports = Map.new(),
}

--- A binder whose scheme is a wrapper around its group's: GHC's `ABExport`.
--- Its code is lowered at `internal`, which takes every class predicate and
--- equality of the group, and the binder's scheme takes the dictionaries in
--- `params`, for `preds`, and the coercions for its own equalities, and
--- applies the internal binding at `use`. A pattern `let`'s `internal`
--- quantifies every variable of the group, and its body is the binder's type
--- in the pattern.
---
--- `use` is a use of the internal binding at the scheme's type. Its type
--- arguments are the scheme's own variables where the internal binding has
--- them, and types solving decided for the rest, and its evidence proves
--- the group's dictionaries from `params`. Its types name the scheme's
--- variables by the skolems in `skolems`, by variable id.
type Export = Export {
    internal : Scheme,
    params   : Vec String,
    preds    : Vec Pred,
    use      : Use,
    skolems  : Map Int Ty.Type,
}

--- One occurrence of a name, and the evidence the solver found it needs.
---
--- `typeArgs` is the other half of the same story, filled in beside the
--- predicates by the same line of the solver. A use of a polymorphic name
--- instantiates its scheme at *something*; the predicates say what evidence that
--- costs, and the type arguments say what the instantiation was. They are in the
--- scheme's `quantified` order, which is the order the definition's type
--- abstraction binds them in -- so the two need no separate agreement.
type Use = Use {
    name         : String,
    --- The id of the binder the occurrence means. `None` for a constructor or
    --- a field access, which mean none.
    binder       : Option Int,
    span         : Option Span,
    var preds    : Vec Pred,
    var scopes   : Vec Scope,
    --- One per predicate, in the same order: where the solver puts the
    --- evidence for it when it discharges it.
    var holes    : Vec Hole,
    --- The holes read out once solving is over (`Turkey.Evidence.run`).
    var evidence : Vec Evidence,
    --- The equalities the scheme demands, instantiated here and in its order.
    --- Each is passed as a coercion after the dictionaries.
    var equalities : Vec Pred,
    var method   : Option MethodInfo,
    var typeArgs : Vec Ty.Type,
    --- Whether the use is inside an inaccessible implication: an override that
    --- can never be called, whose errors were muted. It is never lowered, and
    --- its holes may be empty.
    var inaccessible : Bool,
    --- Whether a call through this occurrence never returns: its scheme is a
    --- function whose result is one of the scheme's own quantified variables,
    --- and neither a parameter nor a predicate of the scheme mentions it.
    var neverReturns : Bool,
}

fun newUse(name : String, binder : Option Int, where : Option Span,
           m : Option MethodInfo) -> Use = Use {
    name = name, binder = binder, span = where, preds = Vec.new(2), scopes = Vec.new(2),
    holes = Vec.new(2), evidence = Vec.new(2), equalities = Vec.new(0), method = m,
    typeArgs = Vec.new(2), inaccessible = False,
    neverReturns = False,
}

-- -- evidence ------------------------------------------------------------------------

--- Where the evidence for one wanted class predicate goes: empty until the
--- solver discharges the predicate, and filled exactly once, by the rule that
--- discharges it. GHC's evidence variable for a wanted dictionary, and the
--- binding `setWantedDict` adds for it (`GHC/Tc/Solver/Monad.hs`).
---
--- **Invariant.** The evidence for a wanted is fixed when the wanted is
--- solved, by the same rule and under the same givens that solved it, and
--- nothing downstream recomputes it: `Turkey.Evidence` only reads the holes out,
--- and the lowering only translates what it reads. So the solver and the
--- lowering cannot disagree about which dictionary a predicate needs, or about
--- the type the solver found it at.
---
--- That type may differ from the predicate's own: `Add Int` for `Add (Elem a)`
--- found under `Elem a ~ Int`. Core accepts the dictionary only where a
--- coercion in scope grants that equality, so every equality a dictionary was
--- found under, given or retained, is one the enclosing binding takes a
--- coercion for.
type Hole = Hole { var proof : Option Proof }

fun newHole() -> Hole = Hole { proof = None }

--- How the solver discharged a wanted. An instance's context is itself a list
--- of wanteds, solved later or elsewhere, so its evidence is holes too: the
--- whole tree is complete only when solving is, as in ICFP 2008's §5, where the
--- substitution of evidence grows with each rule that fires.
type Proof
    --- A dictionary in scope under this name, and the superclasses to select
    --- from it: a given of a signature or of an opened existential, or a
    --- predicate a binding group retained in its scheme.
    = ByGiven(String, Array String, Pred)
    --- An instance, the match of its head against the class argument, and
    --- the holes of its context under that match.
    | ByInstance(InstInfo, Map Int Ty.Type, Array Hole)
    --- The class argument is bottom; the class's name.
    | ByNothing(String)
    --- The evidence of an identical wanted, which a binding group's context
    --- kept in place of this one.
    | Same(Hole)
    --- An equality wanted, solved. Its coercion is zero-width and carries only
    --- its type: the equality as the wanted posed it, before rewriting.
    | ByCoercion(Pred)

--- The obligations one instance declaration demands of its own context, each
--- with the hole its evidence goes into: GHC's superclass bindings (`$cp<n>`,
--- `tcSuperClasses`) and the bindings of the methods it takes from its class's
--- defaults (`mkDefMethBind`). Over the skolems `skolems` maps the head's
--- variables to.
type InstanceCheck = InstanceCheck {
    inst       : InstInfo,
    --- Each class superclass at the head, by the superclass's name.
    supers     : Vec (String, Hole),
    --- Each equality superclass at the head, in the class's order.
    equalities : Vec Hole,
    --- The instance's own class at its head, once per method it takes from the
    --- class's default, by the method's name.
    defaults   : Vec (String, Hole),
    --- A derived instance's class at each of its fields' types, at the head,
    --- by `Ty.typeKey` of the type. Empty for a written instance.
    fields     : Vec (String, Pred, Hole),
    skolems    : Map Int Ty.Type,
}

-- -- generated dictionary names ----------------------------------------------------

type Counter = Counter { var n : Int, var scopes : Int }

let dictCounter = Counter { n = 0, scopes = 0 }

--- A runtime name for one dictionary parameter. `%` cannot start an identifier,
--- so a generated name can never be shadowed by, or shadow, one the program
--- wrote.
fun dictName(hint : String) -> String {
    let name = "%d" + Int.toString(dictCounter.n) + "." + hint
    dictCounter.n = dictCounter.n + 1
    name
}

--- Reset per program, not per process. One process can check many programs, and
--- a counter that kept running would give the second program different
--- dictionary names from the first for no reason in its source.
fun resetDictNames() -> Unit {
    dictCounter.n = 0
}
