export (Span(..), span, endingAt, through, emptyAt, isEmpty, contains, before,
        showSpan, Source(..), read)

-- Where a thing is, and what it is in.
--
-- The bottom of the compiler's module graph. Turkey has no mutually recursive
-- modules, so every layer above this one may mention a `Span` and nothing here
-- may mention a token, a tree or a type.

import System.File as File

-- A range of source text, from `line:col` up to but not including
-- `endLine:endCol`.
--
-- Lines and columns are 1-based and counted in *code points* rather than bytes,
-- so a column is what a reader would count in their editor and not where the
-- byte happens to fall.
--
-- An empty range marks something the compiler wrote rather than the source: a
-- method a `+` means, the wildcard arm of an `if let`. It sits where that
-- thing's diagnostics point, and it covers no text.
type Span = Span {
    line    : Int,
    col     : Int,
    endLine : Int,
    endCol  : Int,
    file    : String,
}

-- Returns the empty range at `line:col`.
fun span(file : String, line : Int, col : Int) -> Span =
    Span { line = line, col = col, endLine = line, endCol = col, file = file }

-- Returns `s` with its end moved to `endLine:endCol`.
fun endingAt(s : Span, endLine : Int, endCol : Int) -> Span =
    Span { line = s.line, col = s.col, endLine = endLine, endCol = endCol, file = s.file }

-- Returns the range from the start of `first` to the end of `last`.
fun through(first : Span, last : Span) -> Span = endingAt(first, last.endLine, last.endCol)

-- Returns the empty range at the start of `s`.
fun emptyAt(s : Span) -> Span = endingAt(s, s.line, s.col)

fun isEmpty(s : Span) -> Bool = s.line == s.endLine && s.col == s.endCol

-- Whether `inner` lies within `outer`, ends included.
fun contains(outer : Span, inner : Span) -> Bool =
    !before(inner.line, inner.col, outer.line, outer.col)
        && !before(outer.endLine, outer.endCol, inner.endLine, inner.endCol)

-- Whether position `line:col` comes before `otherLine:otherCol`.
fun before(line : Int, col : Int, otherLine : Int, otherCol : Int) -> Bool =
    line < otherLine || (line == otherLine && col < otherCol)

-- `line:col`, the start alone, with no file. The file is the caller's to print, because a
-- diagnostic prints it once and a token dump never prints it at all.
fun showSpan(s : Span) -> String =
    Int.toString(s.line) + ":" + Int.toString(s.col)

type Source = Source {
    name : String,
    text : String,
}

-- `None` when the file cannot be read *or* is not well-formed UTF-8. The two
-- are not distinguished because nothing above needs them to be: either way
-- there is no source to compile, and the message says which file.
fun read(path : String) -> Option Source = match File.readText(path) {
    Left(_) -> None
    Right(text) -> Some(Source { name = path, text = text })
}
