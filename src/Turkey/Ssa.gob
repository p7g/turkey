export (
    Value(..), valueId, BlockId(..), blockId,
    RepClass(..), Rep(..), traced, untraced, Layout(..), layoutName, keyName, slotName,
    Effects(..), reads_, writes, allocates, traps, diverges,
    isSafepoint, deletable,
    Term(..), successors, switchTargets,
    Block(..), newBlock, Func(..), newFunc, Variable(..), Anchor(..), holding, hold, holdFrom,
    anchorsOf, anchorAt, carryHolds,
    Inst(..), eachUse, eachDef,
    freshValue, repOf, blockAt,
    predecessors, reversePostorder, dominators, dominates,
    verify, showFunc,
    liveness, livenessInOut, liveAfter, termUses, pruneUnreachable,
)

-- The low IR: an SSA control-flow graph, parameterized over its instructions.
--
-- The parameter is the design. Instruction selection produces a *different*
-- instruction type rather than rewriting this one in place, so that after it a
-- virtual opcode is not representable and every `match` stays exhaustive --
-- and the analyses below, which are the subtle part, are written once for
-- both. QBE and Go put virtual and machine instructions in one enum and pay
-- nothing for it, because neither C nor Go checks a `switch` for
-- exhaustiveness; Hoopl's graph is parameterized over its node type for
-- exactly the reason this one is.
--
-- Three things follow from Turkey rather than from taste:
--
-- * **A value is a dense index**, because there is no object identity and so
--   nothing to point at. Everything known about a value lives in an array
--   indexed by it. That is also what Cranelift's entity
--   references and Go's `ssa.Value` ids are, so the constraint pushes toward
--   what a backend wants anyway. `Value` and `BlockId` are newtypes and are
--   therefore free -- a single-field immutable wrapper is its payload and is
--   not allocated -- so the two index spaces can be kept apart at no cost.
-- * **Blocks take parameters and jumps carry arguments**, rather than phi
--   nodes. A jump with arguments is a parallel copy at a named point, which is
--   what going out of SSA and allocating registers both need; a phi is a
--   pseudo-instruction that every pass has to special-case.
-- * **A block's terminator is not optional.** Hoopl indexes a block by its
--   shape at entry and exit so that one which must end in a terminator cannot
--   fall through, and needs GADTs to do it. A non-optional field says the same
--   thing, and `Unreachable` is what an unfinished block holds while it is
--   being built.
--
-- SSA here is *function-wide*: a definition dominates its uses. A block-local
-- rule would force everything crossing an edge through memory, which makes
-- promoting it a precondition for every optimization rather than one of them.

-- No diagnostics: `verify` answers with complaints rather than failing, so
-- this module reports nothing itself.
import Data.BitSet as BitSet
import Data.BitSet (BitSet)
import Data.Set as Set
import Turkey.Position as Position
import Turkey.Source (Span)
import Turkey.Types as Ty

-- -- values and representations ---------------------------------------------------

-- A value, as an index into the function's side tables.
type Value = Value(Int)

fun valueId(Value(n)) -> Int = n

-- A block, as an index into `Func.blocks`. Distinct from `Value` so that the
-- two cannot be confused, which costs nothing: both erase to a machine
-- integer.
type BlockId = BlockId(Int)

fun blockId(BlockId(n)) -> Int = n

instance Eq Value { fun eq(Value(a), Value(b)) = a == b }

instance Eq BlockId { fun eq(BlockId(a), BlockId(b)) = a == b }

-- What a register has to hold. Instruction selection reads this.
-- `Unit` is zero-width and occupies no register. Every instruction defines a
-- value, so an effectful one defines a unit -- and without this that would
-- burn a register per store, per call for effect, per assignment. LLVM's
-- `void` and QBE's absent return type are the same choice.
type RepClass = Unit | I1 | I8 | I32 | I64 | F64 | Ptr

instance Eq RepClass {
    fun eq(x, y) = match (x, y) {
        (Unit, Unit) -> True
        (I1, I1) -> True
        (I8, I8) -> True
        (I32, I32) -> True
        (I64, I64) -> True
        (F64, F64) -> True
        (Ptr, Ptr) -> True
        _ -> False
    }
}

-- A representation is two facts, not one.
--
-- Spelling them as members of one enum -- `ptr` beside `boxed` -- works until
-- something asks a register class about a `boxed`. A register class and a
-- collector obligation are different questions and both get asked.
type Rep = Rep {
    class_ : RepClass,
    -- Whether the collector must find this value at a safepoint.
    traced : Bool,
}

instance Show RepClass {
    fun show(c) = match c {
        Unit -> "unit"
        I1 -> "i1"
        I8 -> "i8"
        I32 -> "i32"
        I64 -> "i64"
        F64 -> "f64"
        Ptr -> "ptr"
    }
}

fun traced(c : RepClass) -> Rep = Rep { class_ = c, traced = True }

fun untraced(c : RepClass) -> Rep = Rep { class_ = c, traced = False }

instance Eq Rep {
    fun eq(a, b) = a.class_ == b.class_ && a.traced == b.traced
}

-- A traced pointer prints `ptr*`: the star is the collector's obligation, kept
-- separate from the register class it is printed beside.
instance Show Rep {
    fun show(r) = if r.traced { show(r.class_) + "*" } else { show(r.class_) }
}

-- -- layouts ------------------------------------------------------------------------

-- How a value of some type is held: its slots, in order, one `Rep` each. A
-- value with no slots occupies nothing, and is held at `Unit` when it has to
-- be held at all. Each slot is one register, so a layout of n slots is n
-- values once lowered.
--
-- Declared here rather than in `Turkey.Layout`, which computes them, because
-- `Turkey.Ast` and `Turkey.Core` hold layouts and `Turkey.Layout` imports both.
type Layout = Layout { slots : Array Rep }

instance Eq Layout {
    fun eq(a, b) = {
        if len(a.slots) != len(b.slots) { return False }
        for var i = 0; i < len(a.slots); i = i + 1 {
            if a.slots[i] != b.slots[i] { return False }
        }
        True
    }
}

-- Returns the name of `l` as a copy's name spells it, `f@[i64,ptr]`, and as
-- the dumps print it. Distinct layouts get distinct names, so a name can key a
-- map in place of its layout. Nothing else spells a layout.
fun layoutName(l : Layout) -> String =
    -- Name no slots `unit`, and join several with `+`, which cannot be confused
    -- with the `,` that `keyName` puts between a key's layouts.
    if len(l.slots) == 0 { "unit" }
    else { String.join(Array.map(l.slots, slotName), "+") }

-- Returns the name of a key of several layouts, as a copy's name spells it
-- between `@[` and `]`: each layout's name, joined by `,`.
fun keyName(parts : Vec Layout) -> String =
    String.join(Vec.map(parts, layoutName), ",")

-- Returns a slot's class, except that a pointer is `ptr` when the collector
-- traces it and `addr` when it does not.
fun slotName(r : Rep) -> String = match (r.class_, r.traced) {
    (Ptr, True) -> "ptr"
    (Ptr, False) -> "addr"
    (c, False) -> show(c)
    -- Only a pointer can be traced. A traced integer is a slot nothing builds,
    -- and spelling it as its class would give two layouts one name.
    (c, True) -> show(c) + "*"
}

-- -- effects ------------------------------------------------------------------------

-- What an instruction may do, which is what reordering, elimination and
-- garbage collection all need to ask.
--
-- `allocates` is the load-bearing one: allocation is the only thing that can
-- trigger a collection, so an allocating instruction is a **safepoint**, and a
-- safepoint is where the register allocator has to record which registers hold
-- traced values. Without that bit a backend has no choice but to root every
-- pointer live anywhere in the function: one measured frame needed 481 slots
-- that way, against the handful a safepoint actually requires.
--
-- `traps` and `diverges` are different questions. `diverges` is "never
-- returns", as for a call to a bottoming function. `traps` is "may not return"
-- -- an `add` that overflows panics -- and a dead-code pass may not delete a
-- trapping instruction on the grounds that its result is unused.
type Effects = Effects {
    var reads     : Bool,
    var writes    : Bool,
    var allocates : Bool,
    var traps     : Bool,
    var diverges  : Bool,
}

-- The union of two effects, and the effect of doing nothing. An instruction
-- that both reads and traps is `reads_() <> traps()`, and a fold over a
-- block's instructions is `Array.fold` with no special case for the empty one,
-- which is what a monoid is for.
instance Semigroup Effects {
    fun combine(a, b) = Effects {
        reads = a.reads || b.reads,
        writes = a.writes || b.writes,
        allocates = a.allocates || b.allocates,
        traps = a.traps || b.traps,
        diverges = a.diverges || b.diverges,
    }
}

instance Monoid Effects {
    fun empty() = Effects {
        reads = False, writes = False, allocates = False, traps = False,
        diverges = False,
    }
}

fun reads_() -> Effects {
    let e = empty()
    e.reads = True
    e
}

fun writes() -> Effects {
    let e = empty()
    e.writes = True
    e
}

fun allocates() -> Effects {
    let e = empty()
    e.allocates = True
    e
}

fun diverges() -> Effects {
    let e = empty()
    e.diverges = True
    e
}

fun traps() -> Effects {
    let e = empty()
    e.traps = True
    e
}

fun isSafepoint(e : Effects) -> Bool = e.allocates

-- May an instruction whose result is unused be deleted?
--
-- Not the same as "pure". A read may be deleted -- reading has no effect on
-- anything else -- and so may an allocation, since a collection is not
-- observable. What may not be deleted is a write, a trap or a divergence,
-- because each is the whole reason the instruction is there.
fun deletable(e : Effects) -> Bool = !e.writes && !e.traps && !e.diverges

-- -- the graph ----------------------------------------------------------------------

-- Terminators are shared by every instantiation, because they are what the
-- control-flow graph is made of: both a virtual and a machine instruction
-- sequence branches and jumps, and every analysis below reads only this.
type Term
    -- The function's results, one per register it answers in, in the order
    -- `Func.results` gives their representations.
    = Ret(Vec Value)
    -- The arguments are the target block's parameters, positionally.
    | Jump(BlockId, Vec Value)
    | Branch(Value, BlockId, BlockId)
    -- A multi-way branch on an integer: to the case equal to the value, or
    -- else to the default. Like `Branch`, it passes its targets nothing.
    -- No default says the cases are every value the operand can hold, which
    -- is what lets a lowering test fewer of them than there are.
    | Switch(Value, Vec (Int, BlockId), Option BlockId)
    | Panic(Value)
    -- What an unfinished block holds while it is built, and what a block after
    -- a diverging call legitimately ends with.
    | Unreachable

fun successors(t : Term) -> Array BlockId = match t {
    Ret(_) -> []
    Jump(target, _) -> [target]
    Branch(_, yes, no) -> [yes, no]
    Switch(_, cases, default) -> switchTargets(cases, default)
    Panic(_) -> []
    Unreachable -> []
}

fun switchTargets(cases : Vec (Int, BlockId), default : Option BlockId) -> Array BlockId =
    match default {
        Some(d) -> Array.init(len(cases) + 1, fun(i) = if i < len(cases) { cases[i].1 } else { d })
        None -> Array.map(cases, fun((_, target)) = target)
    }

type Block i = Block {
    var params : Vec Value,
    var insts  : Vec i,
    var term   : Term,
    -- The terminator's source position, packed (`Turkey.Position`), since a
    -- terminator defines no value to carry one. Like an instruction's, it
    -- never decides code: nothing compares or keys on it.
    var termAt : Int,
}

fun newBlock() -> Block i =
    Block { params = [], insts = [], term = Unreachable, termAt = 0 }

type Func i = Func {
    name       : String,
    params     : Vec Value,
    -- What the function answers in, one `Rep` per register: one for most
    -- functions, and a flat value's slots for a function that returns one in
    -- several registers. Each register's `Rep` is fixed, whatever value is
    -- returned, so the collector never has to ask which constructor came
    -- back to know whether a result register holds a pointer.
    results    : Array Rep,
    var blocks : Vec (Block i),
    var entry  : BlockId,
    -- Indexed by `valueId`. The side table a dense index buys.
    reps   : Vec Rep,
    -- Where in the source an instruction that may allocate, or a string
    -- literal, came from, by the value it defines. Read by diagnostics only -- the giblets check prints
    -- it -- so nothing is lost but a location when a pass does not carry it.
    var origins : Map Int Span,
    -- What source construct an allocating instruction was lowered from, where
    -- the opcode alone does not say: an `ObjectNew` is a constructor, a record
    -- or an existential package. Diagnostics only, like `origins`.
    var reasons : Map Int String,
    -- Where the function is declared, packed (`Turkey.Position`), or 0 for one
    -- the compiler made. Its entry's parameter moves and its prologue take it.
    var at : Int,
    -- The calls inlined into the function that its positions name, numbered
    -- from 1 by the site field of a position (`Turkey.Position`).
    var sites : Vec Position.Site,
    -- With `-g`, the variables of the source the function binds, and the
    -- ones each value holds, by value id: a value holds a variable, or one
    -- slot of a variable held in several (`holding`). It holds it from its
    -- definition on, or from an assignment to the variable at one of the
    -- points `anchors` gives it there, by value id (`holdFrom`). Debug
    -- information is the only reader, so a pass that loses a value's entry
    -- loses only what a debugger shows.
    var variables : Vec Variable,
    var holds     : Map Int (Vec (Int, Int)),
    var anchors   : Map Int (Vec (Int, Int, Anchor)),
    -- The variable each slot of a `var` holds, by slot, which `Turkey.Promote`
    -- gives the values it puts in the slot's place.
    var slotHolds : Map Int Int,
    -- The module that declares the binding the function was lowered from,
    -- lambdas and instance methods included, and for a lambda lifted out of
    -- an initializer, the module of the global it initializes; empty for one
    -- the compiler made for the whole program, such as an initializer. The giblets check and
    -- poll insertion decide by it.
    var module_ : String,
}

fun newFunc(name : String, results : Array Rep) -> Func i = Func {
    name = name, params = [], results = results,
    blocks = [], entry = BlockId(0), reps = [], origins = Map.new(),
    reasons = Map.new(), at = 0, sites = [], variables = [], holds = Map.new(),
    anchors = Map.new(), slotHolds = Map.new(), module_ = "",
}

-- A local of the source, as a debugger shows it: its name, the position of
-- its binding (`Turkey.Position`), whether it is one of the function's
-- parameters, its type, and how it is held: at `layout`, in its slots, or in
-- one pointer to an object of them if `boxed`.
type Variable = Variable {
    name      : String,
    declared  : Int,
    parameter : Bool,
    ty        : Ty.Type,
    layout    : Layout,
    boxed     : Bool,
}

-- What value `id` holds: each variable, as an index into `Func.variables`,
-- and which of its slots, or -1 for the whole of it.
fun holding(f : Func i, id : Int) -> Vec (Int, Int) = Map.getOr(f.holds, id, [])

-- A point in a block that a pass names by the values around it, which
-- outlast the instructions between them: just after the definition of a
-- value, its block's start for a block parameter, or just before the
-- definition of a value.
type Anchor = After(Int) | Before(Int)

-- Records that value `id` holds slot `slot` of variable `k`, or the whole of
-- it if `slot` is -1, from its definition on.
fun hold(f : Func i, id : Int, k : Int, slot : Int) -> Unit {
    addHolding(f, id, k, slot)
    if let Some(anchored) = Map.get(f.anchors, id) {
        Map.put(f.anchors, id, Vec.filter(anchored, fun((k2, s2, _)) = k2 != k || s2 != slot))
    }
}

-- Records that value `id` holds slot `slot` of variable `k`, or the whole of
-- it, from an assignment at `at` on, as well as from any point it already
-- does. Records nothing if `at` is `None`: a pass that cannot name where an
-- assignment is leaves the variable to the values that hold it elsewhere.
fun holdFrom(f : Func i, id : Int, k : Int, slot : Int, at : Option Anchor) -> Unit {
    let a = match at {
        Some(a) -> a
        None -> return
    }
    if let After(w) = a { if w == id { return hold(f, id, k, slot) } }
    let held = Iterator.any(holding(f, id), fun((k2, s2)) = k2 == k && s2 == slot)
    if held && len(anchorsOf(f, id, k, slot)) == 0 { return }
    addHolding(f, id, k, slot)
    match Map.get(f.anchors, id) {
        Some(anchored) -> Vec.push(anchored, (k, slot, a))
        None -> Map.put(f.anchors, id, [(k, slot, a)])
    }
}

fun addHolding(f : Func i, id : Int, k : Int, slot : Int) -> Unit = match Map.get(f.holds, id) {
    Some(held) -> if !Iterator.any(held, fun((k2, s2)) = k2 == k && s2 == slot) {
        Vec.push(held, (k, slot))
    }
    None -> Map.put(f.holds, id, [(k, slot)])
}

-- Returns the points value `id` holds slot `slot` of variable `k` from, or
-- nothing if it holds it from its definition.
fun anchorsOf(f : Func i, id : Int, k : Int, slot : Int) -> Vec Anchor {
    let out = []
    for (k2, s2, a) in Map.getOr(f.anchors, id, []) {
        if k2 == k && s2 == slot { Vec.push(out, a) }
    }
    out
}

-- Returns the anchor of the point before instruction `index` of `block`:
-- just after the last value defined before it, or the block's start through
-- a parameter, or just before the first value defined after it, of the
-- values `kept` accepts, which are those that outlast the pass asking.
-- Returns `None` if the block defines none of them.
fun anchorAt[Inst i](block : Block i, index : Int, kept : fun(Value) -> Bool) -> Option Anchor {
    for var k = index - 1; k >= 0; k = k - 1 {
        let made = Vec.filter(defs(block.insts[k]), kept)
        if len(made) > 0 { return Some(After(valueId(made[len(made) - 1]))) }
    }
    for p in block.params { if kept(p) { return Some(After(valueId(p))) } }
    for var k = index; k < len(block.insts); k = k + 1 {
        let made = Vec.filter(defs(block.insts[k]), kept)
        if len(made) > 0 { return Some(Before(valueId(made[0]))) }
    }
    None
}

-- Gives value `to` what `from` holds: for a pass that replaces every read
-- of `from` with `to`, where `at` is the point `from` was defined at. What
-- `from` held from its definition, `to` holds from `at`, since `to` may be
-- defined earlier, when the variable held something else.
fun carryHolds(f : Func i, from : Int, to : Int, at : Option Anchor) -> Unit {
    if from == to { return }
    for (k, slot) in holding(f, from) {
        let anchored = anchorsOf(f, from, k, slot)
        if len(anchored) == 0 { holdFrom(f, to, k, slot, at) }
        else { for a in anchored { holdFrom(f, to, k, slot, Some(a)) } }
    }
}

-- A value of the given representation, appended to the function's table.
fun freshValue(f : Func i, r : Rep) -> Value {
    let id = len(f.reps)
    Vec.push(f.reps, r)
    Value(id)
}

fun repOf(f : Func i, v : Value) -> Rep = f.reps[valueId(v)]

fun blockAt(f : Func i, b : BlockId) -> Block i = f.blocks[blockId(b)]

-- What every analysis and generic pass needs of an instruction, and nothing
-- more.
--
-- Anything opcode-specific -- what a particular opcode's operands must be,
-- what it computes -- belongs to the module that declares the instruction
-- type, not here, because the generic passes cannot use it and adding it would
-- make this class a place where target knowledge accumulates. `copyOf` is the
-- one question about an opcode's meaning, and it is here because the answer is
-- target-neutral: a copy is a copy on either side of selection.
-- `Show` is a superclass rather than a `render` method of its own: printing an
-- instruction is not a backend concept, and an instruction that could not be
-- shown would be one nothing could debug.
class Inst i : Show i {
    -- Whether the function holds of some value the instruction reads, or
    -- defines, asked in operand order and stopping at the first that answers
    -- true. Visitors rather than arrays, which would read better, as a
    -- compromise for speed: every pass asks this of every instruction, and a
    -- returned array escapes to its caller, so it is an allocation per
    -- question that no analysis removes. `eachUse` and `eachDef` are the loops.
    fun anyUse(i, fun(Value) -> Bool) -> Bool
    fun anyDef(i, fun(Value) -> Bool) -> Bool
    -- The same values as arrays, for a caller that keeps them.
    fun uses(inst : i) -> Vec Value = collect(anyUse(inst, _))
    fun defs(inst : i) -> Vec Value = collect(anyDef(inst, _))
    fun effects(i) -> Effects
    -- The same instruction with every value it reads passed through the
    -- function. What it defines is unchanged.
    fun renameUses(i, fun(Value) -> Value) -> i
    -- A plain copy, as (destination, source): the destination may be replaced
    -- by the source everywhere. An instantiation answers `None` for anything it
    -- does not want renamed, including a copy between representations.
    fun copyOf(i) -> Option (Value, Value)
}

fun eachUse[Inst i](i : i, f : fun(Value) -> Unit) -> Unit {
    let _ = anyUse(i, fun(v) {
        f(v)
        False
    })
}

fun eachDef[Inst i](i : i, f : fun(Value) -> Unit) -> Unit {
    let _ = anyDef(i, fun(v) {
        f(v)
        False
    })
}

fun collect(visit : fun(fun(Value) -> Bool) -> Bool) -> Vec Value {
    let out = []
    let _ = visit(fun(v) {
        Vec.push(out, v)
        False
    })
    out
}

-- -- traversal and dominance --------------------------------------------------------

fun predecessors(f : Func i) -> Array (Vec BlockId) {
    let out : Array (Vec BlockId) = Array.init(len(f.blocks), fun(_) = [])
    for var b = 0; b < len(f.blocks); b = b + 1 {
        for s in successors(f.blocks[b].term) {
            Vec.push(out[blockId(s)], BlockId(b))
        }
    }
    out
}

-- Blocks in reverse postorder, which is the order the dominance solver wants:
-- every block but the entry appears after at least one of its predecessors, so
-- one pass already computes most of the answer.
fun reversePostorder(f : Func i) -> Vec BlockId = Vec.reverse(postorder(f))

-- The blocks the entry reaches, each after every block a depth-first search
-- from the entry visits below it: the order a backward analysis wants, since
-- every block comes after its successors except across an edge that closes a
-- cycle.
fun postorder(f : Func i) -> Vec BlockId {
    let order : Vec BlockId = []
    let seen = Array.filled(len(f.blocks), False)
    -- An explicit stack, as three in step: the path from the entry, each
    -- block's successors, and which of them to visit next. The recursive form
    -- is depth-first over a graph the size of a whole function, which is deep
    -- enough to exhaust the real one. Three stacks rather than one of tuples,
    -- because a tuple per step is an allocation per step, and this runs for
    -- every analysis of every function.
    let path = [f.entry]
    let succs = [successors(f.blocks[blockId(f.entry)].term)]
    let visit = [0]
    seen[blockId(f.entry)] = True
    while len(path) > 0 {
        let top = len(path) - 1
        let k = visit[top]
        if k < len(succs[top]) {
            visit[top] = k + 1
            let next = succs[top][k]
            if !seen[blockId(next)] {
                seen[blockId(next)] = True
                Vec.push(path, next)
                Vec.push(succs, successors(f.blocks[blockId(next)].term))
                Vec.push(visit, 0)
            }
        } else {
            Vec.push(order, path[top])
            let _ = Vec.pop(path)
            let _ = Vec.pop(succs)
            let _ = Vec.pop(visit)
        }
    }
    order
}

-- The immediate dominator of each block, or `None` for one the entry does not
-- reach. `None` rather than a sentinel index: an unreachable block and block
-- number -1 are different facts, and a language with `Option` should not need
-- to be told them apart by convention.
--
-- Cooper, Harvey and Kennedy's iterative algorithm ("A Simple, Fast Dominance
-- Algorithm", 2001), which is the one to write and not merely the one that is
-- easy. Its headline claim -- 2.5x faster than Lengauer-Tarjan -- does not
-- hold up; a more careful implementation of Lengauer-Tarjan later reversed it.
-- What holds up is that on the graphs a compiler actually meets, every
-- published algorithm lands within a small factor of a breadth-first search
-- and all of them are measured in microseconds, so the difference does not
-- matter and simplicity is the only axis left. This needs no spanning tree and
-- no union-find; LLVM's Semi-NCA and GCC's Lengauer-Tarjan need both.
fun dominators(f : Func i) -> Array (Option Int) {
    let order = reversePostorder(f)
    -- Position in reverse postorder, which is what `intersect` walks by. Only
    -- reachable blocks have one, and only reachable blocks are ever asked.
    let rank = Array.filled(len(f.blocks), 0)
    for var i = 0; i < len(order); i = i + 1 { rank[blockId(order[i])] = i }
    let idom : Array (Option Int) = Array.filled(len(f.blocks), None)
    idom[blockId(f.entry)] = Some(blockId(f.entry))
    let preds = predecessors(f)

    var changed = True
    while changed {
        changed = False
        for b in order {
            let here = blockId(b)
            if here == blockId(f.entry) { continue }
            var new : Option Int = None
            for p in preds[here] {
                let there = blockId(p)
                -- Only predecessors already given an answer; an unreachable
                -- one never gets one and is skipped for ever.
                -- The braces are required: an assignment cannot be a match
                -- arm's body.
                match idom[there] {
                    None -> {}
                    Some(_) -> {
                        new = match new {
                            None -> Some(there)
                            Some(sofar) -> Some(intersect(idom, rank, there, sofar))
                        }
                    }
                }
            }
            match new {
                None -> {}
                Some(found) -> if idom[here] != Some(found) {
                    idom[here] = Some(found)
                    changed = True
                }
            }
        }
    }
    idom
}

-- The nearest common dominator of two blocks, walked by reverse-postorder
-- rank: the deeper of the two climbs until they meet.
fun intersect(idom : Array (Option Int), rank : Array Int, a : Int,
              b : Int) -> Int {
    var x = a
    var y = b
    while x != y {
        while rank[x] > rank[y] { x = up(idom, x) }
        while rank[y] > rank[x] { y = up(idom, y) }
    }
    x
}

-- The immediate dominator of a block already known to have one. Only reached
-- for a block `intersect` arrived at through the answers already computed, so
-- an absence here is this module's bug rather than a malformed program.
fun up(idom : Array (Option Int), b : Int) -> Int = match idom[b] {
    Some(n) -> n
    None -> b
}

-- Does `a` dominate `b`? Walks the dominator tree, which is the form the
-- verifier and the optimizations want and is fast enough at this size; a
-- depth-plus-interval numbering is the answer if it ever is not.
fun dominates(idom : Array (Option Int), a : BlockId, b : BlockId) -> Bool {
    var here = blockId(b)
    let want = blockId(a)
    while True {
        if here == want { return True }
        match idom[here] {
            None -> return False
            Some(next) -> {
                -- The entry is its own immediate dominator, which is where the
                -- walk stops.
                if next == here { return False }
                here = next
            }
        }
    }
    False
}

-- -- verification --------------------------------------------------------------------

-- Reject a malformed function, as a list of complaints.
--
-- Run after every pass. A miscompile then becomes a rejected program at the
-- pass that caused it rather than a wrong answer at the end, which is the
-- property that makes an optimizer safe to build incrementally. It matters
-- most here because what checks this level otherwise is running the compiled
-- program, which localizes a fault to a program rather than to a pass.
fun verify[Inst i](f : Func i) -> Vec String {
    let out = []
    let count = len(f.blocks)
    if count == 0 {
        Vec.push(out, f.name + ": no blocks")
        return out
    }
    if blockId(f.entry) < 0 || blockId(f.entry) >= count {
        Vec.push(out, f.name + ": entry is not a block")
        return out
    }
    -- The entry takes the function's parameters, so it must declare none of
    -- its own: there is no edge into it to supply them.
    if len(f.blocks[blockId(f.entry)].params) > 0 {
        Vec.push(out, f.name + ": the entry block takes parameters")
    }
    -- Only a pointer may be traced. Today every `Ptr` is traced and the field
    -- looks redundant; it is not, and this is what keeps it honest -- a code
    -- address is a pointer the collector must *not* follow, and instruction
    -- selection is where the first one appears.
    for var i = 0; i < len(f.reps); i = i + 1 {
        if f.reps[i].traced && f.reps[i].class_ != Ptr {
            Vec.push(out, f.name + ": value " + Int.toString(i) + " is "
                            + show(f.reps[i]) + ", which is not a pointer")
        }
    }

    -- Where each value is defined. `defAt` is a position within a block and
    -- -1 is a real one -- a parameter, before every instruction -- so it stays
    -- an `Int`; `defBlock` is a presence and is an `Option`.
    let defBlock : Array (Option Int) = Array.filled(len(f.reps), None)
    let defAt = Array.filled(len(f.reps), -1)
    for v in f.params { define(out, f, defBlock, defAt, v, blockId(f.entry), -1) }
    for var b = 0; b < count; b = b + 1 {
        for v in f.blocks[b].params { define(out, f, defBlock, defAt, v, b, -1) }
        for var n = 0; n < len(f.blocks[b].insts); n = n + 1 {
            eachDef(f.blocks[b].insts[n], define(out, f, defBlock, defAt, _, b, n))
        }
    }

    -- Only reachable code is checked. Dominance is a statement about paths
    -- from the entry, so it says nothing about a block no path reaches, and
    -- asking anyway would report a use as undominated when what is true is
    -- that it is dead. Unreachable blocks are ordinary here rather than
    -- exceptional: an expression whose every arm diverges leaves the merge
    -- block its context asked for with no edge into it. LLVM's verifier draws
    -- the same line for the same reason.
    let live = Set.new()
    for b in reversePostorder(f) { Set.add(live, blockId(b)) }
    let idom = dominators(f)
    for var b = 0; b < count; b = b + 1 {
        if !Set.contains(live, b) { continue }
        let block = f.blocks[b]
        for var n = 0; n < len(block.insts); n = n + 1 {
            eachUse(block.insts[n],
                    checkUse(out, f, idom, defBlock, defAt, _, b, n))
        }
        checkTerm(out, f, idom, defBlock, defAt, b, block.term)
    }
    out
}

fun define(out : Vec String, f : Func i, defBlock : Array (Option Int),
           defAt : Array Int, v : Value, b : Int, n : Int) -> Unit {
    let id = valueId(v)
    if id < 0 || id >= len(f.reps) {
        Vec.push(out, f.name + ": value " + Int.toString(id) + " has no representation")
        return
    }
    match defBlock[id] {
        Some(_) -> {
            Vec.push(out, f.name + ": value " + Int.toString(id)
                            + " is defined twice")
            return
        }
        None -> {}
    }
    defBlock[id] = Some(b)
    defAt[id] = n
}

-- Every use is dominated by its definition. Within one block that is textual
-- order; across blocks it is the dominator tree.
fun checkUse(out : Vec String, f : Func i, idom : Array (Option Int),
             defBlock : Array (Option Int), defAt : Array Int, v : Value,
             b : Int, n : Int) -> Unit {
    let id = valueId(v)
    if id < 0 || id >= len(f.reps) {
        Vec.push(out, f.name + ": use of value " + Int.toString(id)
                        + " which has no representation")
        return
    }
    let where = match defBlock[id] {
        Some(n) -> n
        None -> {
            Vec.push(out, f.name + ": use of undefined value " + Int.toString(id))
            return
        }
    }
    if where == b {
        if defAt[id] >= n {
            Vec.push(out, f.name + ": value " + Int.toString(id)
                            + " is used before it is defined")
        }
        return
    }
    if !dominates(idom, BlockId(where), BlockId(b)) {
        Vec.push(out, f.name + ": value " + Int.toString(id)
                        + " is used outside the blocks its definition dominates")
    }
}

fun checkTerm(out : Vec String, f : Func i, idom : Array (Option Int),
              defBlock : Array (Option Int), defAt : Array Int, b : Int,
              t : Term) -> Unit {
    let last = len(f.blocks[b].insts)
    match t {
        Ret(vs) -> {
            if len(vs) != len(f.results) {
                Vec.push(out, f.name + ": returns " + Int.toString(len(vs))
                                + " values where " + Int.toString(len(f.results))
                                + " were declared")
                return
            }
            for var k = 0; k < len(vs); k = k + 1 {
                checkUse(out, f, idom, defBlock, defAt, vs[k], b, last)
                if repOf(f, vs[k]) != f.results[k] {
                    Vec.push(out, f.name + ": returns " + show(repOf(f, vs[k]))
                                    + " where " + show(f.results[k]) + " was declared")
                }
            }
        }
        Jump(target, args) -> checkEdge(out, f, idom, defBlock, defAt, b, target, args)
        Branch(cond, yes, no) -> {
            checkUse(out, f, idom, defBlock, defAt, cond, b, last)
            if repOf(f, cond).class_ != I1 {
                Vec.push(out, f.name + ": branches on "
                                + show(repOf(f, cond)) + " rather than i1")
            }
            checkEdge(out, f, idom, defBlock, defAt, b, yes, [])
            checkEdge(out, f, idom, defBlock, defAt, b, no, [])
        }
        Switch(v, cases, default) -> {
            checkUse(out, f, idom, defBlock, defAt, v, b, last)
            let keys = Set.new()
            for (key, _) in cases {
                if Set.contains(keys, key) {
                    Vec.push(out, f.name + ": switches to two cases for "
                                    + Int.toString(key))
                }
                Set.add(keys, key)
            }
            for target in switchTargets(cases, default) {
                checkEdge(out, f, idom, defBlock, defAt, b, target, [])
            }
        }
        Panic(v) -> checkUse(out, f, idom, defBlock, defAt, v, b, last)
        Unreachable -> {}
    }
}

-- A jump's arguments are the target's parameters, so they have to agree in
-- number and in representation. `Branch` carries none, which is why a block
-- reached by a branch may not take any.
fun checkEdge(out : Vec String, f : Func i, idom : Array (Option Int),
              defBlock : Array (Option Int), defAt : Array Int, b : Int,
              target : BlockId, args : Vec Value) -> Unit {
    let to = blockId(target)
    if to < 0 || to >= len(f.blocks) {
        Vec.push(out, f.name + ": jump to block " + Int.toString(to)
                        + ", which does not exist")
        return
    }
    let params = f.blocks[to].params
    if len(params) != len(args) {
        Vec.push(out, f.name + ": jump to block " + Int.toString(to) + " passes "
                        + Int.toString(len(args)) + " arguments to "
                        + Int.toString(len(params)) + " parameters")
        return
    }
    let last = len(f.blocks[b].insts)
    for var i = 0; i < len(args); i = i + 1 {
        checkUse(out, f, idom, defBlock, defAt, args[i], b, last)
        if repOf(f, args[i]) != repOf(f, params[i]) {
            Vec.push(out, f.name + ": jump to block " + Int.toString(to)
                            + " passes " + show(repOf(f, args[i]))
                            + " where " + show(repOf(f, params[i]))
                            + " was declared")
        }
    }
}

-- -- printing -----------------------------------------------------------------------

fun showFunc[Inst i](f : Func i) -> String {
    let b = String.builder()
    String.push(b, "fun @" + f.name + "(")
    for var i = 0; i < len(f.params); i = i + 1 {
        if i > 0 { String.push(b, ", ") }
        String.push(b, showValue(f, f.params[i]))
    }
    String.push(b, ") -> " + showResults(f.results) + " {\n")
    for var n = 0; n < len(f.blocks); n = n + 1 {
        let block = f.blocks[n]
        String.push(b, "  b" + Int.toString(n))
        if len(block.params) > 0 {
            String.push(b, "(")
            for var i = 0; i < len(block.params); i = i + 1 {
                if i > 0 { String.push(b, ", ") }
                String.push(b, showValue(f, block.params[i]))
            }
            String.push(b, ")")
        }
        if n == blockId(f.entry) { String.push(b, "  ; entry") }
        String.push(b, ":\n")
        for inst in block.insts { String.push(b, "    " + show(inst) + "\n") }
        String.push(b, "    " + showTerm(f, block.term) + "\n")
    }
    String.push(b, "}\n")
    String.build(b)
}

-- Returns one result's representation as itself, and several in parentheses.
fun showResults(rs : Array Rep) -> String =
    if len(rs) == 1 { show(rs[0]) }
    else { "(" + String.join(Array.map(rs, show), ", ") + ")" }

fun showValue(f : Func i, v : Value) -> String =
    "%" + Int.toString(valueId(v)) + ":" + show(repOf(f, v))

fun showTerm(f : Func i, t : Term) -> String = match t {
    Ret(vs) -> "ret " + String.join(Vec.map(vs, showValue(f, _)), ", ")
    Jump(target, args) -> {
        let b = String.builder()
        String.push(b, "jump b" + Int.toString(blockId(target)) + "(")
        for var i = 0; i < len(args); i = i + 1 {
            if i > 0 { String.push(b, ", ") }
            String.push(b, showValue(f, args[i]))
        }
        String.push(b, ")")
        String.build(b)
    }
    Branch(cond, yes, no) ->
        "branch " + showValue(f, cond) + ", b" + Int.toString(blockId(yes))
        + ", b" + Int.toString(blockId(no))
    Switch(v, cases, default) -> {
        let parts = Vec.new(len(cases) + 1)
        for (key, target) in cases {
            Vec.push(parts, Int.toString(key) + " -> b" + Int.toString(blockId(target)))
        }
        match default {
            Some(d) -> Vec.push(parts, "_ -> b" + Int.toString(blockId(d)))
            None -> {}
        }
        "switch " + showValue(f, v) + " [" + String.join(parts, ", ") + "]"
    }
    Panic(v) -> "panic " + showValue(f, v)
    Unreachable -> "unreachable"
}

-- -- liveness -----------------------------------------------------------------------

-- Which values are live on the way out of each block.
--
-- Backward dataflow over the graph, solved as `livenessInOut` says. Written
-- here rather than in a pass because it is a fact about the *graph* -- the
-- same analysis serves the collector's root sets now and the register
-- allocator's interference later, and the parameter over instructions is what
-- lets one copy do both.
--
-- Block parameters are the reason this is simpler than it looks. A value
-- crossing an edge is an *argument on that edge*, used by the predecessor's
-- terminator, and the parameter it becomes is defined in the successor. So
-- there is no phi to special-case: `uses` and `defs` already say everything,
-- which is what block parameters buy over phi nodes.
fun liveness[Inst i](f : Func i) -> Array BitSet {
    let (_, out) = livenessInOut(f)
    out
}

-- Both halves of the same analysis. `liveness` answers only live-*out* because
-- that is all the root analysis needed; the colourer needs live-*in* too, to
-- know what a block's parameters interfere with, and computing the analysis
-- twice to get a set it already had would be silly.
--
-- Every set is a bitset over the function's value ids, which are dense, and
-- each block's pair is built in place by unions. Two passes and no fixpoint,
-- after Brandner, Boissinot, Darte, Dupont de Dinechin and Rastello,
-- "Computing Liveness Sets for SSA-Form Programs" (INRIA RR-7503, 2011):
--
-- * A backward pass in postorder, over every edge except those that close a
--   cycle. Along the rest every successor comes first, so each block is
--   walked once, and without a cycle this is already the answer.
-- * A forward pass over the loop-nesting forest. A value live into a loop's
--   header and not one of its parameters is defined outside the loop, since
--   its definition dominates its uses; so it is live into and out of every
--   block of the loop, and that is all the first pass missed.
--
-- The second pass is exact only where every cycle has a header that dominates
-- it. A function with an irreducible cycle iterates to the fixpoint instead,
-- from where the first pass left it: every set is already below the answer,
-- which is all the iteration needs of its start.
fun livenessInOut[Inst i](f : Func i) -> (Array BitSet, Array BitSet) {
    let count = len(f.blocks)
    let values = len(f.reps)
    let liveIn = Array.init(count, fun(_) = BitSet.new(values))
    let liveOut = Array.init(count, fun(_) = BitSet.new(values))
    let order = postorder(f)
    -- Position in postorder, or -1 for a block the entry does not reach.
    let rank = Array.filled(count, -1)
    for var k = 0; k < len(order); k = k + 1 { rank[blockId(order[k])] = k }
    let succs : Array (Array BlockId) = Array.filled(count, [])
    -- Whether some edge goes to a block no earlier in postorder, which only
    -- an edge closing a cycle does.
    var cyclic = False
    for at in order {
        let b = blockId(at)
        succs[b] = successors(f.blocks[b].term)
        for s in succs[b] {
            if rank[blockId(s)] < rank[b] {
                let _ = BitSet.unionInto(liveOut[b], liveIn[blockId(s)])
            } else {
                cyclic = True
            }
        }
        transfer(f, b, liveOut[b], liveIn[b])
    }
    if !cyclic { return (liveIn, liveOut) }
    match loopForest(order, rank, succs) {
        Some((innermost, parent)) -> {
            -- In reverse postorder, which visits a header before the blocks
            -- of its loop and an outer header before an inner one, so each
            -- header's set is complete by the time it is read.
            for var k = len(order) - 1; k >= 0; k = k - 1 {
                let b = blockId(order[k])
                let h = innermost[b]
                if h == b {
                    if parent[b] >= 0 {
                        let _ = BitSet.unionInto(liveIn[b], liveIn[parent[b]])
                    }
                    let _ = BitSet.unionInto(liveOut[b], liveIn[b])
                } else if h >= 0 {
                    let _ = BitSet.unionInto(liveIn[b], liveIn[h])
                    let _ = BitSet.unionInto(liveOut[b], liveIn[h])
                }
            }
        }
        None -> {
            let entering = BitSet.new(values)
            var changed = True
            while changed {
                changed = False
                for at in order {
                    let b = blockId(at)
                    for s in succs[b] {
                        let _ = BitSet.unionInto(liveOut[b], liveIn[blockId(s)])
                    }
                    transfer(f, b, liveOut[b], entering)
                    -- Live-out is a function of the live-ins alone, so a pass
                    -- that changes no live-in has reached the fixpoint.
                    if !BitSet.equal(entering, liveIn[b]) {
                        BitSet.copyFrom(liveIn[b], entering)
                        changed = True
                    }
                }
            }
        }
    }
    (liveIn, liveOut)
}

-- Makes `into` hold what is live into block `b`, given what is live out of it:
-- backward through the terminator, then the instructions, then the
-- parameters.
fun transfer[Inst i](f : Func i, b : Int, out : BitSet, into : BitSet) -> Unit {
    let block = f.blocks[b]
    BitSet.copyFrom(into, out)
    for v in termUses(block.term) { BitSet.add(into, valueId(v)) }
    for var n = len(block.insts) - 1; n >= 0; n = n - 1 {
        eachDef(block.insts[n], fun(v) {
            let _ = BitSet.remove(into, valueId(v))
        })
        eachUse(block.insts[n], fun(v) = BitSet.add(into, valueId(v)))
    }
    for p in block.params {
        let _ = BitSet.remove(into, valueId(p))
    }
}

-- The loop-nesting forest of the blocks in `order`, a postorder from the
-- entry, given each block's position in it and its successors; or `None` if
-- some cycle is irreducible.
--
-- Answers two arrays indexed by block. The first holds the header of the
-- innermost loop containing the block, which for a header is itself, or -1
-- for a block in no loop. The second holds, for a header, the header of the
-- innermost loop strictly containing its own, or -1.
--
-- A loop is a header and every block that reaches one of its back edges
-- without passing the header. An edge closes a cycle when it goes to a block
-- no earlier in postorder; such an edge is a back edge when its target
-- dominates its source, and the graph is reducible when every one is. Walking
-- back from a source without passing the target reaches the entry exactly
-- when the target does not dominate it, so the walk that collects a loop also
-- checks it.
fun loopForest(order : Vec BlockId, rank : Array Int,
               succs : Array (Array BlockId)) -> Option (Array Int, Array Int) {
    let count = len(rank)
    -- Every block's predecessors in one array: those of `b` are at
    -- `start[b]` up to `start[b + 1]`. Two allocations rather than one per
    -- block.
    let start = Array.filled(count + 1, 0)
    for at in order {
        for s in succs[blockId(at)] {
            start[blockId(s) + 1] = start[blockId(s) + 1] + 1
        }
    }
    for var b = 0; b < count; b = b + 1 { start[b + 1] = start[b + 1] + start[b] }
    let fill = Array.init(count, fun(b) = start[b])
    let preds = Array.filled(start[count], 0)
    for at in order {
        for s in succs[blockId(at)] {
            preds[fill[blockId(s)]] = blockId(at)
            fill[blockId(s)] = fill[blockId(s)] + 1
        }
    }

    let entry = len(order) - 1
    let innermost = Array.filled(count, -1)
    let parent = Array.filled(count, -1)
    -- The header whose walk last visited each block.
    let seen = Array.filled(count, -1)
    let work : Vec Int = []
    -- Headers in reverse postorder, which puts each after every header that
    -- dominates it, so a loop is collected after the loops containing it and
    -- an inner header overwrites an outer one.
    for var k = len(order) - 1; k >= 0; k = k - 1 {
        let h = blockId(order[k])
        for var e = start[h]; e < start[h + 1]; e = e + 1 {
            if rank[preds[e]] <= rank[h] { Vec.push(work, preds[e]) }
        }
        if len(work) > 0 {
            parent[h] = innermost[h]
            innermost[h] = h
            seen[h] = h
            while let Some(b) = Vec.pop(work) {
                if seen[b] != h {
                    if rank[b] == entry { return None }
                    seen[b] = h
                    innermost[b] = h
                    for var e = start[b]; e < start[b + 1]; e = e + 1 {
                        Vec.push(work, preds[e])
                    }
                }
            }
        }
    }
    Some((innermost, parent))
}

-- What a terminator reads. Not part of the `Inst` class, because a terminator
-- is not an instruction here -- it is a field of the block, which is what
-- keeps a block from ever being without one.
fun termUses(t : Term) -> Vec Value = match t {
    Ret(vs) -> vs
    Jump(_, args) -> args
    Branch(c, _, _) -> [c]
    Switch(v, _, _) -> [v]
    Panic(v) -> [v]
    Unreachable -> []
}

-- The values live *after* each instruction of a block, given the block's
-- live-out set. Index `n` holds the values live immediately after instruction
-- `n`, which is what a safepoint needs: the callee may collect, and what must
-- survive is whatever is still wanted when it returns.
--
-- Each point is an array of distinct ids, ascending, rather than a set: every
-- reader only walks them, and a snapshot of the one set being updated is a
-- single array where a copy would be a bitset the size of the function.
fun liveAfter[Inst i](f : Func i, at : BlockId,
                      out : BitSet) -> Array (Array Int) {
    let block = f.blocks[blockId(at)]
    let sets : Array (Array Int) = Array.filled(len(block.insts), [])
    let live = BitSet.new(len(f.reps))
    BitSet.copyFrom(live, out)
    for v in termUses(block.term) { BitSet.add(live, valueId(v)) }
    for var n = len(block.insts) - 1; n >= 0; n = n - 1 {
        sets[n] = BitSet.elements(live)
        eachDef(block.insts[n], fun(v) {
            let _ = BitSet.remove(live, valueId(v))
        })
        eachUse(block.insts[n], fun(v) = BitSet.add(live, valueId(v)))
    }
    sets
}

-- The same function with unreachable blocks removed, and the rest in reverse
-- postorder.
--
-- Lowering emits a fallthrough `panic "no match arm applied"` for every
-- `match`, and a non-exhaustive match is an error, so that block is
-- unreachable in every program that compiles. It is not the only such
-- block, which is the reason this prunes by *reachability* rather than by
-- knowing where that panic came from: dropping a block because nothing
-- branches to it is correct whatever made it unreachable, where dropping it
-- because the checker called the match exhaustive would make the output depend
-- on the checker being sound. A hole there would turn a clean panic into a
-- fall-through into whatever block came next.
--
-- Blocks are renumbered, so this must run before anything records a `BlockId`
-- elsewhere. It answers reverse postorder, which puts the entry first and each
-- block after a predecessor -- the order the allocator wants to walk anyway.
fun pruneUnreachable[Inst i](f : Func i) -> Func i {
    let order = reversePostorder(f)
    if len(order) == len(f.blocks) && blockId(order[0]) == blockId(f.entry) {
        -- Nothing to drop and already in order. Answering `f` unchanged keeps
        -- this free for the functions -- most of them -- that have no dead
        -- block, and keeps the value numbering identical for them.
        var same = True
        for var k = 0; k < len(order); k = k + 1 {
            if blockId(order[k]) != k { same = False }
        }
        if same { return f }
    }
    let remap = Array.filled(len(f.blocks), -1)
    for var k = 0; k < len(order); k = k + 1 {
        remap[blockId(order[k])] = k
    }
    let out = newFunc(f.name, f.results)
    out.module_ = f.module_
    for r in f.reps { Vec.push(out.reps, r) }
    for p in f.params { Vec.push(out.params, p) }
    -- The numbering is kept, so the origins are too.
    out.origins = f.origins
    out.reasons = f.reasons
    out.at = f.at
    out.sites = f.sites
    out.variables = f.variables
    out.holds = f.holds
    out.anchors = f.anchors
    out.slotHolds = f.slotHolds
    for at in order {
        let block = f.blocks[blockId(at)]
        let made = newBlock()
        for p in block.params { Vec.push(made.params, p) }
        for inst in block.insts { Vec.push(made.insts, inst) }
        made.term = remapTerm(remap, block.term)
        made.termAt = block.termAt
        Vec.push(out.blocks, made)
    }
    out.entry = BlockId(0)
    out
}

fun remapTerm(remap : Array Int, t : Term) -> Term = match t {
    Ret(vs) -> Ret(vs)
    Jump(target, args) -> Jump(BlockId(remap[blockId(target)]), args)
    Branch(c, yes, no) ->
        Branch(c, BlockId(remap[blockId(yes)]), BlockId(remap[blockId(no)]))
    Switch(v, cases, default) -> Switch(v,
        Vec.map(cases, fun((key, target)) = (key, BlockId(remap[blockId(target)]))),
        match default {
            Some(d) -> Some(BlockId(remap[blockId(d)]))
            None -> None
        })
    Panic(v) -> Panic(v)
    Unreachable -> Unreachable
}
