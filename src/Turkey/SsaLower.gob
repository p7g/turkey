export (
    Unsupported(..), Signature(..), Lifting(..), Module(..),
    lowerBind, lowerProgram, tagsOf, signatures, signatureOf,
)

-- Core to the low IR.
--
-- Two things follow from this IR being an SSA graph rather than a linear
-- sequence, and both make this
-- shorter than its ancestor.
--
-- **Destination passing, into a block parameter.** An expression is lowered
-- *towards* somewhere: the function's return, or a block that takes its value
-- as a parameter. An `if` then needs no machinery at all -- both arms are
-- lowered towards the same destination and the merge block's parameter is
-- where they meet, which is what a phi would have been.
--
-- **No slots for what merely crosses an edge.** A definition dominates its
-- uses, so a value outliving a branch needs no memory; a slot is only what a
-- `var` genuinely needs.
--
-- Incomplete by construction, and says so: an unhandled Core form raises
-- `Unsupported` and the caller counts it. That is what makes this buildable in
-- slices against a corpus of real programs rather than in one attempt --
-- The `ssa` dump reports how much of each program lowered, and the verifier
-- decides whether what did is well formed.

import System.Parallel as Parallel
import Data.Map as Map
import Data.Set as Set
import Turkey.Core as Core
import Turkey.Core (Core(..), CoreKind(..), CParam(..), CAlt(..), CBind(..), CProgram(..), Alt(..),
                    Opened(..),
                    Mapper(..), Ref(..), noId, binderId)
import Turkey.Decls as Decls
import Turkey.Decls (DeclTable(..), ConInfo(..), Compact(..))
import Turkey.Diag as Diag
import Turkey.Giblets as Giblets
import Turkey.Layout as Layout
import Turkey.LowIr as L
import Turkey.LowIr (Op(..), Low(..), AddressOf(..), BinOp(..), CmpOp(..), Conv(..),
                     AtomicOp(..), Callee(..), Builder(..), IndexCheck(..))
import Turkey.Position as Position
import Turkey.Prims as Prims
import Turkey.Runtime as Rt
import Turkey.LocalEscape as LocalEscape
import Turkey.Promote as Promote
import Turkey.Source (Span)
import Turkey.Ssa as Ssa
import Turkey.Ssa (Value(..), BlockId(..), Rep(..), RepClass(..), Term(..),
                   Func(..), Block(..))
import Turkey.Types as Ty
import Turkey.Types (TCon, TTuple, TFun, TBottom)
import Turkey.Ast as Ast
import Turkey.Ast (Lit(..))
import Turkey.Bulk as Bulk

-- What is not lowered yet: the binding, and the form that stopped it.
-- Carried rather than thrown so a driver can report coverage over a corpus --
-- and the *reason* rather than only the count, because a histogram of reasons
-- is what says which form to write next.
--
-- `overLimit` marks a program past one of the runtime's limits (`refuse`).
-- That is the program's fault and `what` says what to change, where every
-- other reason is a form only a compiler bug leaves unlowered.
type Unsupported = Unsupported {
    name      : String,
    what      : String,
    overLimit : Bool,
    span      : Option Span,
}

-- What a *direct* call passes and receives.
--
-- The closure ABI's leading environment is deliberately absent: this is the
-- natural signature, and the uniform one is derived from it where it is
-- needed. `turkey/backend_lower.py` asks the same question with
-- `held_at(expected, callee, decls)` -- the *callee's* abstracted layouts and
-- not the caller's, which is the whole point. A layout-shared copy holds its
-- parameters at the layouts its key names, so a caller that read them off its
-- own scheme would pass a value at a layout the copy does not hold it at.
type Signature = Signature {
    -- Per parameter, the registers it is passed in: its slots (`passedIn`),
    -- or one pointer where the body needs its box (`boxParameters`).
    params : Array (Array Rep),
    -- The registers the result is answered in: a value of several slots in
    -- its slots, one register each (`Ssa.Func.results`), and any other value
    -- in the one register it is held in. A closure answers a value of several
    -- slots as its box, so a closure over a function that answers in several
    -- registers goes through an adapter that boxes them (`adaptClosures`).
    results : Array Rep,
    -- Whether a saturated call never comes back: the body always reaches
    -- `Prim.error` or another such call. Set by `signatures` once every
    -- binding has an entry, since it is a fact about the call graph.
    var diverges : Bool,
}

-- The state one binding's lowering shares across every function it makes.
--
-- Records have reference semantics, so one of these passed to a parent and to
-- the nested `Lower`s its lambdas make is one object, which is what keeps the
-- symbols unique. Copying one would silently restart the counter.
type Lifting = Lifting {
    -- Names one lifted lambda apart from the next. One per binding: a
    -- lambda's symbol begins with its parent's name, which no other binding
    -- shares, so a count of the binding's own lambdas is enough to keep them
    -- apart -- and it does not depend on the order the bindings are lowered
    -- in, which is any order (`lowerProgram`).
    var next : Int,
    -- The program's source files, which every position is numbered against.
    files : Position.Files,
}

-- A whole program's low IR: the functions, the storage the module initializer
-- writes, and the initializer's own name.
--
-- Globals are here rather than implied, because a global's *representation* is
-- not derivable from its name at the use site and both the initializer's store
-- and every `GlobalLoad` need it. It is also what the collector's permanent
-- root array is built from -- a pointer global is rooted for the life of the
-- program, so storing to it and rooting it are the same store.
type Module = Module {
    var functions : Array (Ssa.Func Low),
    globals       : Vec (String, Rep),
    -- The function that computes every global, in the order the program
    -- requires. Called once before `main`.
    initial   : String,
    -- Runs before roots, literals, and any managed allocation.
    early     : String,
    -- Each `foreign` definition that lowered, as (C symbol, function name),
    -- sorted by symbol: what an emitter exports under a C-callable thunk.
    definitions : Vec (String, String),
}

let initializerName = "%module.initialize"

-- The file table of code the compiler writes with no source behind it.
let noFiles = Position.files([])

type Lower = Lower {
    decls   : DeclTable,
    func    : Ssa.Func Low,
    b       : Builder,
    -- Each local bound so far in the function, by binder id -> the value
    -- holding it, and each join, by binder id -> the block it became. Neither
    -- is scoped. No id is bound twice in the program, which `Turkey.Coretc`
    -- checks before this pass, and every reference is in its binder's scope,
    -- so an entry left behind after its scope ends is one nothing reads.
    var env     : Map Int Value,
    var joins   : Map Int BlockId,
    -- Top-level names, which are globals rather than locals.
    globals : Set.Set String,
    -- Mutable giblet globals are plain storage, never reference cells.
    globalRefs : Map String Rep,
    -- The runtime tag of each constructor. A whole-program numbering, so it is
    -- computed once and handed down rather than derived per function.
    tags    : Map String Int,
    -- What a direct call must coerce to, per callee. Program-wide, and read
    -- rather than derived: the caller and the callee agree because they read
    -- one table, not because they compute the same thing twice.
    sigs    : Map String Signature,
    -- The layout each abstracted variable stands for, from the binding. What
    -- `Turkey.Layout` gave the copy, and what makes a representation knowable
    -- inside one.
    var layouts : Map String Ssa.Layout,
    -- The functions lifted out of *this* top-level binding. Shared by
    -- reference with the nested `Lower`s its lambdas make, and discarded whole
    -- if the binding stops -- a lifted body whose parent did not lower is a
    -- symbol nothing calls.
    lifted  : Vec (Ssa.Func Low),
    -- What belongs to the program rather than to one binding.
    shared  : Lifting,
    -- The first form that could not be lowered, if any, and whether it is a
    -- refusal of a program past a limit rather than an unhandled form.
    var stopped : Option String,
    var overLimit : Bool,
    -- The ids of the `let`s `LocalEscape` found do not escape.
    var flatRefs : Set.Set Int,
    var flatRecords : Set.Set Int,
    localRefs : Map Int (Int, Rep),
    -- A local record's or dictionary's slots, by position.
    localObjects : Map Int (Array (Int, Rep)),
    var nextSlot : Int,
    held : Held,
}

-- What one function's lowering knows about how its values are held.
type Held = Held {
    -- Every value of several slots this function holds, by its marker, and
    -- the type of each that an expression gave, which a box's reason names.
    multis : Map Int Multi,
    types  : Map Int Ty.Type,
    -- `Layout.layoutOf` and `Layout.flatOf` of each type asked about under
    -- `layouts`, by its `Ty.typeKey`: the lowering asks about most types many
    -- times, and the answer takes allocation to find. Emptied whenever
    -- `layouts` changes.
    var layouts : Map String Ssa.Layout,
    var flats   : Map String (Option Layout.Flat),
    -- Per join block, which of its values of several slots it takes boxed,
    -- in one parameter (`joinParams`).
    boxedJoins : Map Int (Array Bool),
}

-- A value of a type held in several slots (`Layout.flatOf`), as the lowering
-- carries it. Its `Value` is a marker that no instruction defines, standing
-- for one of two forms: the slots themselves, one SSA value each, or a pointer
-- to the object a memory position holds them in (`Layout.storedRep`).
--
-- **One SSA value is one register, by construction.** No instruction takes or
-- defines a marker: a use that needs the slots takes them out (`slotsOf`), and
-- one that needs a pointer gets the box (`stored`). So `Ssa`, `LowIr`, the
-- register allocator, instruction selection and the frame tables never see a
-- value wider than a word. A marker that escaped into an instruction would be
-- a use of a value nothing defines, which the verifier reports.
--
-- The boxed form is what a value read from memory starts as, and it is taken
-- apart only where its slots are wanted. So a value moved from one memory
-- position to another keeps its box, and is not taken apart and boxed again;
-- a function's or a join's parameter that its body would box is passed boxed
-- for the same reason (`boxParameters`, `joinParams`). The slots are not kept
-- beside the box: a block that wants them loads them, which is cheaper than
-- holding both forms live.
type Multi
    = Slots(Ssa.Layout, Array Value)
    | Boxed(Ssa.Layout, Value)

fun multiLayout(m : Multi) -> Ssa.Layout = match m {
    Slots(layout, _) -> layout
    Boxed(layout, _) -> layout
}

-- Where an expression's value goes.
type Dest
    -- The function's result.
    = ToReturn
    -- A block taking the value as its one parameter. This is where a phi would
    -- be, and having it be a jump argument is why there is no phi.
    | ToBlock(BlockId)
    -- A block taking a value of several slots, whose parameters are decided
    -- once every value arriving at it is known (`control`). Each arrival is
    -- the block it comes from, left unterminated, and the value.
    | ToMerge(BlockId, Vec (BlockId, Value))

-- -- representations ----------------------------------------------------------------

-- What a body holds a value of this type at, under these layouts.
--
-- There is no answer to fall back on. `Turkey.Layout` copies every generic body
-- per layout so that every type a body mentions has one, and
-- `Layout.unknownLayouts` checks that it did; a type without one here is a
-- compiler bug, and holding it at a traced pointer would be a guess that the
-- value's producer or consumer need not share.
--
-- Split out of `heldOf` because the signature pre-pass asks this before any
-- `Lower` exists, and asks it under a *different* binding's layouts than the
-- one being lowered. That is the whole point of `Signature`.
fun layoutIn(decls : DeclTable, layouts : Map String Ssa.Layout,
             ty : Ty.Type) -> Ssa.Layout =
    match Layout.layoutOf(decls, ty, layouts) {
        Some(layout) -> layout
        None -> oops("no layout for the type '" + Ty.show(ty) + "'")
    }

fun heldOf(l : Lower, ty : Ty.Type) -> Ssa.Layout {
    if !Layout.unfolds(l.decls, ty) { return layoutIn(l.decls, l.layouts, ty) }
    let key = Ty.typeKey(ty)
    match Map.get(l.held.layouts, key) {
        Some(found) -> found
        None -> {
            let found = layoutIn(l.decls, l.layouts, ty)
            Map.put(l.held.layouts, key, found)
            found
        }
    }
}

-- Where the fields of a value of `ty` are among its slots, if it is flat.
fun flatHere(l : Lower, ty : Ty.Type) -> Option Layout.Flat {
    if !Layout.unfolds(l.decls, ty) { return Layout.flatOf(l.decls, ty, l.layouts) }
    let key = Ty.typeKey(ty)
    match Map.get(l.held.flats, key) {
        Some(found) -> found
        None -> {
            let found = Layout.flatOf(l.decls, ty, l.layouts)
            Map.put(l.held.flats, key, found)
            found
        }
    }
}

-- Make `layouts` the ones this body is lowered under.
fun setLayouts(l : Lower, layouts : Map String Ssa.Layout) -> Unit {
    l.layouts = layouts
    l.held.layouts = Map.new()
    l.held.flats = Map.new()
}

-- The one register a value of this type is held in when it is held in one: in
-- memory, and in a closure's parameters and result.
-- A type of several slots is held there as a pointer to its box.
fun repIn(decls : DeclTable, layouts : Map String Ssa.Layout, ty : Ty.Type) -> Rep =
    Layout.storedRep(layoutIn(decls, layouts, ty))

fun repOf(l : Lower, ty : Ty.Type) -> Rep = Layout.storedRep(heldOf(l, ty))

fun isMulti(layout : Ssa.Layout) -> Bool = len(layout.slots) > 1

-- The registers a direct call passes a parameter of this layout in: its slots,
-- if it has several, and otherwise the one register it is held in.
fun passedIn(layout : Ssa.Layout) -> Array Rep =
    if isMulti(layout) { layout.slots } else { [Layout.storedRep(layout)] }

-- -- values of several slots ------------------------------------------------------

fun multiOf(l : Lower, v : Value) -> Option Multi = Map.get(l.held.multis, Ssa.valueId(v))

fun newMulti(l : Lower, m : Multi) -> Value {
    let marker = Ssa.freshValue(l.func, Ssa.traced(Ptr))
    Map.put(l.held.multis, Ssa.valueId(marker), m)
    marker
}

-- The value of `layout` made of these slots: nothing, the one slot, or a
-- marker for several.
fun fromSlots(l : Lower, layout : Ssa.Layout, values : Array Value) -> Value =
    match len(layout.slots) {
        0 -> L.emit(l.b, ConstUnit, Ssa.untraced(Unit))
        1 -> coerce(l, values[0], layout.slots[0])
        _ -> newMulti(l, Slots(layout, values))
    }

-- The value of `layout` that a memory position held as `v` (`Layout.storedRep`).
fun fromStored(l : Lower, layout : Ssa.Layout, v : Value) -> Value =
    if isMulti(layout) { newMulti(l, Boxed(layout, v)) } else { v }

-- The slots of `v`, a value of `layout`. A boxed value is loaded here, in the
-- block the slots are wanted in.
fun slotsOf(l : Lower, v : Value, layout : Ssa.Layout) -> Array Value =
    slotsAt(l, v, layout, Array.init(len(layout.slots), fun(i) = i))

-- The slots of `v` at `indices`.
fun slotsAt(l : Lower, v : Value, layout : Ssa.Layout,
            indices : Array Int) -> Array Value {
    if !isMulti(layout) { return Array.map(indices, fun(_) = v) }
    match multiOf(l, v) {
        Some(Slots(_, values)) -> Array.map(indices, fun(i) = values[i])
        Some(Boxed(had, box)) -> {
            let object = Rt.layout(had.slots)
            Array.map(indices, fun(i) =
                L.emit(l.b, ObjectGet(box, L.fieldRef(object, i)), had.slots[i]))
        }
        None -> {
            let _ = stop(l, "a value of " + Ssa.layoutName(layout)
                            + " held in one register")
            Array.map(indices, fun(i) = zero(l, layout.slots[i]))
        }
    }
}

-- What a memory position holds of `v`: `v` itself, unless it is a value of
-- several slots, which is held as a pointer to an object of its slots. A
-- boxed value is its box, and a value in slots is boxed here.
fun stored(l : Lower, v : Value) -> Value = match multiOf(l, v) {
    None -> v
    Some(Boxed(_, box)) -> box
    Some(Slots(layout, values)) -> {
        let made = L.emit(l.b, ObjectNew(0, -1, Rt.layout(layout.slots), values, 0),
                          Ssa.traced(Ptr))
        -- Named as building the value it holds, which is what memory holds of
        -- it.
        let what = match Map.get(l.held.types, Ssa.valueId(v)) {
            Some(ty) -> match Ty.prune(ty) {
                TTuple(_) -> "a tuple"
                t -> match Ty.spine(t) {
                    (TCon(c), _) -> "a value with " + Ty.shortName(c.name)
                    _ -> "a value of " + Ty.show(t)
                }
            }
            None -> "a value of " + Ssa.layoutName(layout)
        }
        Map.put(l.func.reasons, Ssa.valueId(made), "builds " + what)
        made
    }
}

-- What memory positions written together hold of `values`: `stored` of each,
-- with one box for a value that appears more than once, as `(x, x)` does.
fun storedAll(l : Lower, values : Array Value) -> Array Value {
    let out = Array.map(values, fun(v) = v)
    for var i = 0; i < len(values); i = i + 1 {
        if Option.isSome(multiOf(l, values[i])) {
            -- An earlier field of the same value, already boxed, or a box now.
            var j = 0
            while j < i && values[j] != values[i] { j = j + 1 }
            out[i] = if j < i { out[j] } else { stored(l, values[i]) }
        }
    }
    out
}

-- `v`, the value of an expression whose type is held at `layout`, as every
-- value of that layout is carried: a marker if it has several slots. A value
-- of such a type in one register is its box, as a load from memory, a call's
-- result or a closure's parameter gives it.
fun adopted(l : Lower, ty : Ty.Type, layout : Ssa.Layout, v : Value) -> Value {
    if !isMulti(layout) || Option.isSome(l.stopped) { return v }
    let marker = if Option.isSome(multiOf(l, v)) { v }
        else if Ssa.repOf(l.func, v) != Ssa.traced(Ptr) {
            return stop(l, "a value of " + Ssa.layoutName(layout) + " held at "
                           + show(Ssa.repOf(l.func, v)))
        } else { newMulti(l, Boxed(layout, v)) }
    if !Map.contains(l.held.types, Ssa.valueId(marker)) {
        Map.put(l.held.types, Ssa.valueId(marker), ty)
    }
    marker
}

-- The parameters a block takes a value of `layout` in, as one value: one
-- parameter per slot if it has several.
fun paramsFor(l : Lower, block : BlockId, layout : Ssa.Layout) -> Value {
    if !isMulti(layout) { return L.param(l.b, block, Layout.storedRep(layout)) }
    let ps = Array.map(layout.slots, L.param(l.b, block, _))
    newMulti(l, Slots(layout, ps))
}

-- The parameters of the join `target` for `params`, as one value each. A
-- parameter of several slots whose uses in `body`, which is lowered towards
-- `dest`, need its box takes the box,
-- by the rule a function's parameter does (`boxParameters`): a value read from
-- memory and passed through the join is then not taken apart and boxed again.
fun joinParams(l : Lower, target : BlockId, params : Array CParam, body : Core,
               dest : Dest) -> Vec Value {
    -- A function that answers a value of several slots answers its slots,
    -- and a closure answers its box.
    let returned = match dest {
        ToReturn -> len(l.func.results) == 1
        _ -> False
    }
    let boxed = Array.map(params, fun(p) {
        if !isMulti(heldOf(l, p.ty)) { return False }
        let a = Uses { decls = l.decls, layouts = l.layouts, sigs = l.sigs,
                       ids = Set.new(), boxed = False, spread = Map.new() }
        Set.add(a.ids, idOf(p.name, p.id))
        usesIn(a, body, returned)
        a.boxed
    })
    Map.put(l.held.boxedJoins, blockIndex(target), boxed)
    let entered = []
    for var i = 0; i < len(params); i = i + 1 {
        let layout = heldOf(l, params[i].ty)
        Vec.push(entered, if boxed[i] {
            fromStored(l, layout, L.param(l.b, target, Ssa.traced(Ptr)))
        } else { paramsFor(l, target, layout) })
    }
    entered
}

fun blockIndex(b : BlockId) -> Int = match b { BlockId(n) -> n }

-- The arguments a jump passes `values` to `target` in: a value of several
-- slots as its slots, or as its box where `target` takes it boxed, each
-- coerced to its parameter.
fun argsFor(l : Lower, target : BlockId, values : Array Value) -> Vec Value {
    let params = Ssa.blockAt(l.func, target).params
    let boxed = Map.getOr(l.held.boxedJoins, blockIndex(target), [])
    let out = []
    for var i = 0; i < len(values); i = i + 1 {
        let v = values[i]
        match multiOf(l, v) {
            Some(m) -> if i < len(boxed) && boxed[i] { Vec.push(out, stored(l, v)) }
                       else { for x in slotsOf(l, v, multiLayout(m)) { Vec.push(out, x) } }
            None -> Vec.push(out, v)
        }
    }
    if len(out) != len(params) {
        let _ = stop(l, "a jump with " + Int.toString(len(out)) + " values to a "
                        + "block of " + Int.toString(len(params)) + " parameters")
        return []
    }
    let passed = []
    for var i = 0; i < len(out); i = i + 1 {
        Vec.push(passed, coerce(l, out[i], Ssa.repOf(l.func, params[i])))
    }
    passed
}

-- -- lowering -----------------------------------------------------------------------

-- `classes` are the program's classes, whose dictionaries are numbered beside
-- its constructors (`tagsOf`). `files` numbers the program's source files for
-- the positions every instruction carries.
fun lowerProgram(program : CProgram, decls : DeclTable, classes : Array String,
                 files : Position.Files)
        -> (Module, Vec Unsupported) {
    let done : Vec (Ssa.Func Low) = []
    let skipped : Vec Unsupported = []
    let globals = Set.new()
    for bind in Vec.append(program.dicts, program.binds) {
        Set.add(globals, bind.name)
    }
    let globalRefs = Map.new()
    let giblets = Giblets.gibletModules()
    for bind in program.binds {
        if bind.mutable && Set.contains(giblets, bind.module_) {
            Map.put(globalRefs, bind.name,
                    repIn(decls, bind.layouts, Core.refElem(bind.ty)))
        }
    }
    let tags = tagsOf(decls, classes)
    let sigs = signatures(program, decls)
    -- Each binding on its own, on as many workers as there are: lowering
    -- reads the tables above and writes only what it makes.
    let all = Vec.append(program.dicts, program.binds)
    let made = Parallel.map(all, fun(bind) =
        lowerBind(bind, decls, globals, globalRefs, tags, sigs,
                  Lifting { next = 0, files = files }))
    for var i = 0; i < len(all); i = i + 1 {
        let bind = all[i]
        let (f, lifted, why) = made[i]
        match f {
            Some(function) -> {
                -- The parent first, so a dump reads outside in.
                Vec.push(done, function)
                for g in lifted { Vec.push(done, g) }
            }
            -- No reason means it is not a function at all: a global, which the
            -- initializer computes below. That is not a skip and is not
            -- counted as one -- the histogram is what says how much of the
            -- language is still unwritten, so a form that *is* handled, by
            -- another phase, does not belong in it.
            None -> match why {
                Some(u) -> Vec.push(skipped, u)
                None -> {}
            }
        }
    }
    -- Global initializers can also introduce lifted lambdas.
    let (init, early, lifted, storage) = initializer(program, decls, globals, globalRefs, tags,
                                              sigs, Lifting { next = 0, files = files })
    Vec.push(done, init)
    Vec.push(done, early)
    for g in lifted { Vec.push(done, g) }
    let lowered = Set.new()
    for f in done { Set.add(lowered, f.name) }
    let definitions : Vec (String, String) = []
    for (name, info) in Map.entries(decls.definitions) {
        if Set.contains(lowered, name) {
            Vec.push(definitions, (info.symbol, name))
        }
    }
    let module_ = Module { functions = Vec.toArray(done), globals = storage,
                           initial = initializerName, early = Giblets.initializerName,
                           definitions = Vec.sort(definitions) }
    internNullaries(module_, init)
    adaptClosures(module_, sigs)
    (module_, skipped)
}

-- Point every closure over a top-level function that takes a parameter or
-- answers its result in several registers at an adapter of the closure
-- convention, which takes that parameter boxed, as every caller of a closure
-- passes it (`closureCall`), calls the function with its slots, and answers
-- the box of its results. One adapter per such function, made only where a
-- closure over it is.
fun adaptClosures(m : Module, sigs : Map String Signature) -> Unit {
    let made = Map.new()
    let modules = Map.new()
    for f in m.functions { Map.put(modules, f.name, f.module_) }
    for f in m.functions {
        for block in f.blocks {
            for inst in block.insts {
                match inst.op {
                    ClosureNew(name, None) -> match Map.get(sigs, name) {
                        Some(sig) -> if Iterator.any(sig.params, fun(reps) = len(reps) > 1)
                                         || len(sig.results) > 1 {
                            let symbol = name + "%boxed"
                            if !Map.contains(made, name) {
                                let a = adapter(name, symbol, sig)
                                a.module_ = Map.getOr(modules, name, "")
                                Map.put(made, name, a)
                            }
                            inst.op = ClosureNew(symbol, None)
                        }
                        None -> {}
                    }
                    _ -> {}
                }
            }
        }
    }
    if len(made) == 0 { return }
    let adapters = Array.map(Array.sort(Map.keys(made)), fun(name) = made[name])
    m.functions = Array.append(m.functions, adapters)
}

-- The adapter `symbol` for the function `name` of signature `sig`.
fun adapter(name : String, symbol : String, sig : Signature) -> Ssa.Func Low {
    let boxes = len(sig.results) > 1
    let f = Ssa.newFunc(symbol, if boxes { [Ssa.traced(Ptr)] } else { sig.results })
    let b = L.builder(f, BlockId(0), noFiles)
    L.into(b, L.block(b))
    Vec.push(f.params, Ssa.freshValue(f, Ssa.traced(Ptr)))
    let args = [L.emit(b, ConstInt(0), Ssa.traced(Ptr))]
    for reps in sig.params {
        if len(reps) == 1 {
            let v = Ssa.freshValue(f, reps[0])
            Vec.push(f.params, v)
            Vec.push(args, v)
        } else {
            let box = Ssa.freshValue(f, Ssa.traced(Ptr))
            Vec.push(f.params, box)
            let object = Rt.layout(reps)
            for var k = 0; k < len(reps); k = k + 1 {
                Vec.push(args, L.emit(b, ObjectGet(box, L.fieldRef(object, k)), reps[k]))
            }
        }
    }
    let first = L.emit(b, Call(Direct(name), Vec.toArray(args)), sig.results[0])
    if !boxes {
        L.terminate(b, Ret([first]))
        return f
    }
    let results = Array.init(len(sig.results), fun(k) =
        if k == 0 { first } else { L.emit(b, Result(first, k), sig.results[k]) })
    let box = L.emit(b, ObjectNew(0, -1, Rt.layout(sig.results), results, 0), Ssa.traced(Ptr))
    L.terminate(b, Ret([box]))
    f
}

-- Empty objects have no fields to mutate and the language has no physical
-- equality, so one per (kind, tag) can be shared. So can a tuple whose fields
-- are all constants, a box of a value of several slots among them, such as
-- `None` of an `Option Int` returned boxed: neither is written after it is
-- built. Done in the IR, so that the emitter sees ordinary rooted global loads
-- rather than inventing its own interning.
--
-- Not the tuples of a giblet module, which run before the globals here exist,
-- and which are refused if they allocate at all.
fun internNullaries(m : Module, init : Ssa.Func Low) -> Unit {
    let objects : Map String (Int, Int, Rt.Layout, Array Op) = Map.new()
    let giblets = Giblets.gibletModules()
    for f in m.functions {
        let shared = !Set.contains(giblets, f.module_)
            && f.name != Giblets.initializerName
        -- The constant each value is, where one is.
        let constants = Map.new()
        for block in f.blocks {
            for inst in block.insts {
                match inst.op {
                    ConstInt(_) -> Map.put(constants, Ssa.valueId(inst.result), inst.op)
                    ConstFloat(_) -> Map.put(constants, Ssa.valueId(inst.result), inst.op)
                    _ -> {}
                }
            }
        }
        for block in f.blocks {
            for inst in block.insts {
                match inst.op {
                    ObjectNew(kind, tag, layout, fields, mutable) -> if len(fields) == 0 {
                        let name = "%nullary." + Int.toString(kind) + "."
                                   + Int.toString(tag)
                        Map.put(objects, name, (kind, tag, layout, []))
                        inst.op = GlobalLoad(name)
                    } else if shared && kind == 0 && tag == -1 && mutable == 0 {
                        match constantsOf(constants, fields) {
                            Some(ops) -> {
                                let name = "%box." + String.join(Array.map(layout.reps, fun(r) =
                                               Int.toString(Rt.layoutCode(r))), "")
                                           + "." + String.join(Array.map(ops, constantName), ".")
                                Map.put(objects, name, (kind, tag, layout, ops))
                                inst.op = GlobalLoad(name)
                            }
                            None -> {}
                        }
                    }
                    _ -> {}
                }
            }
        }
    }
    if len(objects) == 0 { return }
    -- A new entry block runs before all user initializers. Publish each
    -- object immediately: allocating the next one may collect under stress.
    let b = L.builder(init, init.entry, noFiles)
    let start = L.block(b)
    L.into(b, start)
    for (name, shape) in objects {
        let (kind, tag, layout, ops) = shape
        Vec.push(m.globals, (name, Ssa.traced(Ptr)))
        let values = Array.init(len(ops), fun(i) = L.emit(b, ops[i], layout.reps[i]))
        let made = L.emit(b, ObjectNew(kind, tag, layout, values, 0), Ssa.traced(Ptr))
        L.effect(b, GlobalStore(name, made))
    }
    L.terminate(b, Jump(init.entry, []))
    init.entry = start
    -- Back into reverse postorder, entry first, after inserting the
    -- initialization prefix, as every other lowered function is.
    let ordered = Ssa.pruneUnreachable(init)
    init.blocks = ordered.blocks
    init.entry = ordered.entry
}

-- The constants `fields` are, if every one is one.
fun constantsOf(constants : Map Int Op, fields : Array Value) -> Option (Array Op) {
    let out = []
    for v in fields { Vec.push(out, Map.get(constants, Ssa.valueId(v))?) }
    Some(Vec.toArray(out))
}

-- A constant as a global's name spells it: digits, and letters for the rest.
fun constantName(op : Op) -> String = match op {
    ConstInt(n) -> signed(n)
    ConstFloat(x) -> "f" + signed(Float.bits(x))
    _ -> "x"
}

-- A negative `n` is `m` and its complement, which is not negative.
fun signed(n : Int) -> String = if n < 0 { "m" + Int.toString(Int.not(n)) } else { Int.toString(n) }

-- Where each global's value is kept, and at what representation.
--
-- A binding that is not a function, which is exactly the complement of
-- `signatures`. Its representation comes from the binding's *own* layouts for
-- the same reason a signature does.
fun storageOf(program : CProgram, decls : DeclTable) -> Vec (String, Rep) {
    let out = []
    let giblets = Giblets.gibletModules()
    for bind in Vec.append(program.dicts, program.binds) {
        let ty = if bind.mutable && Set.contains(giblets, bind.module_) {
            Core.refElem(bind.ty)
        } else { bind.ty }
        match signatureOf(decls, bind) {
            Some(_) -> {}
            None -> Vec.push(out, (bind.name,
                                     repIn(decls, bind.layouts, ty)))
        }
    }
    out
}

-- What every top-level function is called at.
--
-- A pre-pass, because a call site is lowered before the callee's body may have
-- been: `lowerProgram` walks the bindings in whatever order the program lists
-- them, and a mutually recursive pair is ordinary. A binding that is not a
-- function has no entry, and that absence is what tells a call site it is
-- reaching a global that holds a closure rather than a symbol.
fun signatures(program : CProgram, decls : DeclTable) -> Map String Signature {
    let out = Map.new()
    for bind in Vec.append(program.dicts, program.binds) {
        match signatureOf(decls, bind) {
            Some(sig) -> {
                -- Top-level names are module-qualified, so a collision is a
                -- compiler bug and not a program that shadows.
                if Map.contains(out, bind.name) {
                    oops("two top-level bindings named '" + bind.name + "'")
                }
                Map.put(out, bind.name, sig)
            }
            None -> {}
        }
    }
    boxParameters(program, decls, out)
    markDiverging(program, out)
    out
}

-- Pass a parameter of several slots boxed, as one pointer, to a function
-- whose body needs its box: one that stores it, or passes it on where a box
-- is wanted. Returning it is not such a use, since a function answers a value
-- of several slots in its slots. Its callers hold such a value boxed often, having read
-- it from memory, and then pass the pointer they have, where in slots the
-- callee would box it again. A parameter the body only takes apart keeps its
-- slots, so nothing is boxed or loaded for it at all.
--
-- Each signature starts with every parameter in slots, and a round moves to a
-- box each one some use now needs boxed. Passing a parameter on to one that
-- became boxed is such a use, so this runs until a round moves none. It only
-- ever moves parameters one way, so it stops.
fun boxParameters(program : CProgram, decls : DeclTable,
                  sigs : Map String Signature) -> Unit {
    -- Per binding, the `spread` its rounds share.
    let spread = Map.new()
    var changed = True
    while changed {
        changed = False
        for bind in program.binds {
            let sig = match Map.get(sigs, bind.name) {
                Some(found) -> found
                None -> continue
            }
            let shape = match spine(bind.value) {
                Some(found) -> found
                None -> continue
            }
            let (params, body) = shape
            let a = Uses { decls = decls, layouts = bind.layouts, sigs = sigs,
                           ids = Set.new(), boxed = False,
                           spread = Map.getOr(spread, bind.name, Map.new()) }
            Map.put(spread, bind.name, a.spread)
            for var i = 0; i < len(params) && i < len(sig.params); i = i + 1 {
                if len(sig.params[i]) > 1 {
                    a.ids = Set.new()
                    a.boxed = False
                    Set.add(a.ids, idOf(params[i].name, params[i].id))
                    usesIn(a, body, len(sig.results) == 1)
                    if a.boxed {
                        sig.params[i] = [Ssa.traced(Ptr)]
                        changed = True
                    }
                }
            }
        }
    }
}

-- What `usesIn` is looking for: a use of any of `ids`, the parameter and
-- what a `let` renames it to, where a box of it is wanted.
--
-- No id is bound twice in the program, so a use of one of `ids` is a use of
-- the parameter wherever it is, and an id added for a `let` need not be taken
-- out after its body.
type Uses = Uses {
    decls   : DeclTable,
    layouts : Map String Ssa.Layout,
    sigs    : Map String Signature,
    var ids : Set.Set Int,
    var boxed : Bool,
    -- `spreads` of each type asked about, by its `Ty.typeKey`.
    spread  : Map String Bool,
}

-- Look for a use in `e`, which is somewhere a box of its value is wanted if
-- `boxed`. A position of several slots that takes them apart, binds them or
-- passes them on in slots wants no box; memory, a closure's argument and a
-- closure's result do.
fun usesIn(a : Uses, e : Core, boxed : Bool) -> Unit {
    if a.boxed { return }
    match e.kind {
        CVar(r) -> if boxed && Set.contains(a.ids, binderId(r)) { a.boxed = True }
        CTyApp(inner, _) -> usesIn(a, inner, boxed)
        CTyLam(_, inner) -> usesIn(a, inner, boxed)
        CLet(_, id, _, bound, body, _) -> {
            usesIn(a, bound, False)
            match bound.kind {
                CVar(r) -> if Set.contains(a.ids, binderId(r)) { Set.add(a.ids, id) }
                _ -> {}
            }
            usesIn(a, body, boxed)
        }
        CIf(c, then_, otherwise) -> {
            usesIn(a, c, False)
            usesIn(a, then_, boxed)
            match otherwise {
                Some(o) -> usesIn(a, o, boxed)
                None -> {}
            }
        }
        CMatch(scrutinee, alts) -> {
            usesIn(a, scrutinee, False)
            for alt in alts { usesIn(a, alt.body, boxed) }
        }
        CJoin(_, _, _, body, rest, _) -> {
            usesIn(a, body, boxed)
            usesIn(a, rest, boxed)
        }
        CJump(_, args) -> for x in args { usesIn(a, x, False) }
        CProject(target, _) -> usesIn(a, target, False)
        CTuple(elems) -> {
            let spread = spreads(a, e.ty)
            for x in elems { usesIn(a, x, !spread) }
        }
        CApp(fn, args) -> match erased(fn).kind {
            -- A newtype's value is its payload, wanted wherever it is.
            CCon(_) -> {
                let wanted = if Option.isSome(Decls.erasedPayload(a.decls, e.ty)) { boxed }
                             else { !spreads(a, e.ty) }
                for x in args { usesIn(a, x, wanted) }
            }
            CVar(BySpelling(name)) -> match Map.get(a.sigs, name) {
                Some(sig) -> if len(sig.params) == len(args) {
                    for var i = 0; i < len(args); i = i + 1 {
                        usesIn(a, args[i], len(sig.params[i]) == 1)
                    }
                } else {
                    for x in args { usesIn(a, x, True) }
                }
                None -> for x in args { usesIn(a, x, True) }
            }
            _ -> {
                usesIn(a, fn, False)
                for x in args { usesIn(a, x, True) }
            }
        }
        -- A lambda's result is boxed, and what it captures is held in slots.
        CLam(_, body, _) -> usesIn(a, body, True)
        _ -> discard(Core.mapKind(e.kind, Mapper {
            expr = fun(x) = {
                usesIn(a, x, True)
                x
            },
            type_ = fun(t) = t,
            bind = fun(b) = {
                usesIn(a, b.value, True)
                b
            },
        }))
    }
}

-- Whether a value of `ty` is held in several slots, so a component of it is
-- spliced into them rather than boxed.
fun spreads(a : Uses, ty : Ty.Type) -> Bool {
    if !Layout.unfolds(a.decls, ty) { return False }
    let key = Ty.typeKey(ty)
    match Map.get(a.spread, key) {
        Some(found) -> found
        None -> {
            let found = match Layout.layoutOf(a.decls, ty, a.layouts) {
                Some(layout) -> isMulti(layout)
                None -> False
            }
            Map.put(a.spread, key, found)
            found
        }
    }
}

-- Set `diverges` on every function whose body never returns, to the least
-- fixed point over direct calls: each round may find a caller of what the
-- last round found. Starting from false marks a function only once every path
-- through it is shown to reach a panic, so a cycle with no panic on it stays
-- unmarked. That is conservative rather than necessary -- such a cycle does
-- not come back either -- and it keeps the claim the simple one.
--
-- The point of knowing is the caller's liveness. A bounds check's failure
-- path calls a function that panics; if the lowering let that call fall
-- through into the code after the check, every value live there would be
-- live across a call, and could only be held in a callee-saved register.
fun markDiverging(program : CProgram, sigs : Map String Signature) -> Unit {
    var changed = True
    while changed {
        changed = False
        for bind in program.binds {
            match (Map.get(sigs, bind.name), spine(bind.value)) {
                (Some(sig), Some((_, body))) -> if !sig.diverges && neverReturns(sigs, body) {
                    sig.diverges = True
                    changed = True
                }
                _ -> {}
            }
        }
    }
}

-- Whether evaluating `e` always ends in a panic. Conservative in the
-- direction of answering false, which costs a block left reachable rather
-- than a caller cut short.
fun neverReturns(sigs : Map String Signature, e : Core) -> Bool = match e.kind {
    CApp(fn, args) -> divergingCall(sigs, e, fn, args)
    CLet(_, _, _, value, body, _) -> neverReturns(sigs, value) || neverReturns(sigs, body)
    CJoin(_, _, _, _, rest, _) -> neverReturns(sigs, rest)
    CMatch(_, alts) -> {
        if len(alts) == 0 { return False }
        for a in alts { if !neverReturns(sigs, a.body) { return False } }
        True
    }
    CIf(_, then, otherwise) -> match otherwise {
        Some(o) -> neverReturns(sigs, then) && neverReturns(sigs, o)
        None -> False
    }
    _ -> False
}

-- Whether the call `e`, of `fn` to `args`, never comes back: its type is
-- bottom, or it is `Prim.error`, or a saturated direct call to a function
-- `sigs` says diverges.
fun divergingCall(sigs : Map String Signature, e : Core, fn : Core, args : Array Core) -> Bool {
    match Ty.prune(e.ty) {
        TBottom -> return True
        _ -> {}
    }
    match erased(fn).kind {
        CPrim(Prims.Error) -> True
        CVar(BySpelling(name)) -> match Map.get(sigs, name) {
            Some(sig) -> sig.diverges && len(args) == len(sig.params)
            None -> False
        }
        _ -> False
    }
}

-- One binding's signature, keyed on *that binding's* layouts.
fun signatureOf(decls : DeclTable, bind : CBind) -> Option Signature {
    let shape = spine(bind.value)
    match shape {
        None -> return None
        Some(_) -> {}
    }
    let params = match shape {
        Some((ps, _)) -> ps
        None -> []
    }
    let body = match shape {
        Some((_, inner)) -> inner
        None -> bind.value
    }
    let reps = Array.map(params, fun(p) = passedIn(layoutIn(decls, bind.layouts, p.ty)))
    -- From the binding's own type rather than from the body: a body that
    -- always diverges is typed bottom, and a caller reads the signature.
    let result = match Ty.prune(resultType(bind.ty)) {
        TBottom -> layoutIn(decls, bind.layouts, body.ty)
        other -> layoutIn(decls, bind.layouts, other)
    }
    Some(Signature { params = reps, results = passedIn(result), diverges = False })
}

-- Every constructor's runtime tag: the whole program's constructor names in
-- order, numbered from zero.
--
-- Sorted rather than in declaration order, because declaration order is the
-- order the modules happened to be read in and a tag is written into a heap
-- object that outlives the compilation that made it. Nothing reads a tag by
-- name at run time; what matters is that one compilation agrees with itself,
-- and that the numbering does not move when an unrelated module gains a type.
--
-- The dictionaries too, numbered after every constructor, one per class. Their
-- tag is never tested -- a dictionary type has one shape -- but it is written
-- into the object, and a numbering that omitted them would give two different
-- dictionaries the same `-1`.
fun tagsOf(decls : DeclTable, classes : Array String) -> Map String Int {
    let names = Array.append(Array.sort(Map.keys(decls.constructors)),
                             Array.map(Array.sort(classes), Core.dictName))
    let out = Map.new()
    for var i = 0; i < len(names); i = i + 1 { Map.put(out, names[i], i) }
    out
}

-- One top-level binding: the function it became, the functions lifted out of
-- it, and the form that stopped it.
fun lowerBind(bind : CBind, decls : DeclTable, globals : Set.Set String,
              globalRefs : Map String Rep,
              tags : Map String Int,
              sigs : Map String Signature, shared : Lifting)
        -> (Option (Ssa.Func Low), Array (Ssa.Func Low), Option Unsupported) {
    -- Not a function: a global whose value the module initializer computes,
    -- which is its own phase. Two `let`s rather than one destructuring
    -- binding, because a control transfer cannot cross one.
    let shape = spine(bind.value)
    match shape {
        None -> return (None, [], None)
        Some(_) -> {}
    }
    let params = match shape {
        Some((ps, _)) -> ps
        None -> []
    }
    let body = match shape {
        Some((_, inner)) -> inner
        None -> bind.value
    }
    -- Read back rather than recomputed. The caller coerces to what `sigs`
    -- says, so the callee must be built from the same entry -- two derivations
    -- of one convention is exactly the disagreement this table exists to
    -- prevent, and a compiler that computed it twice would be right until one
    -- of the two moved.
    let sig = match Map.get(sigs, bind.name) {
        Some(found) -> found
        None -> Signature { params = [], results = [Ssa.traced(Ptr)], diverges = False }
    }
    let f = Ssa.newFunc(bind.name, sig.results)
    f.module_ = bind.module_
    Vec.push(f.params, Ssa.freshValue(f, Ssa.traced(Ptr)))
    let l = newLower(decls, f, globals, globalRefs, tags, sigs, bind.layouts, [],
                     shared)
    f.at = match bind.span {
        Some(s) -> Position.fromSpan(l.b.files, s)
        None -> 0
    }
    let entry = L.block(l.b)
    L.into(l.b, entry)
    for var i = 0; i < len(params); i = i + 1 {
        let layout = heldOf(l, params[i].ty)
        let reps = if i < len(sig.params) { sig.params[i] } else { passedIn(layout) }
        let vs = Array.map(reps, fun(r) {
            let v = Ssa.freshValue(f, r)
            Vec.push(f.params, v)
            v
        })
        let bound = if !isMulti(layout) { vs[0] }
            else if len(vs) == 1 { fromStored(l, layout, vs[0]) }
            else { fromSlots(l, layout, vs) }
        Map.put(l.env, idOf(params[i].name, params[i].id), bound)
    }
    prepareLocals(l, body)
    lower(l, body, ToReturn)
    match l.stopped {
        Some(why) -> (None, [], Some(Unsupported {
            name = bind.name, what = why, overLimit = l.overLimit, span = bind.span,
        }))
        -- Dead blocks dropped here rather than left for each emitter. The
        -- fallthrough panic every `match` gets is unreachable in any program
        -- that compiles, since a non-exhaustive match is rejected. A backend
        -- with its own dead-code pass deletes it silently; one without emits
        -- code for a block nothing can reach.
        None -> (Some(Promote.run(f)), pruneAll(l.lifted), None)
    }
}

-- The three places a `Lower` is made: a top-level binding, a lifted lambda,
-- and a synthesized adapter. One constructor, so a field that is meant to be
-- shared cannot be shared in two of them and copied in the third.
fun newLower(decls : DeclTable, f : Ssa.Func Low, globals : Set.Set String,
             globalRefs : Map String Rep,
             tags : Map String Int,
             sigs : Map String Signature, layouts : Map String Ssa.Layout,
             lifted : Vec (Ssa.Func Low), shared : Lifting) -> Lower = Lower {
    decls = decls, func = f, b = L.builder(f, BlockId(0), shared.files),
    env = Map.new(), joins = Map.new(), globals = globals, tags = tags,
    globalRefs = globalRefs,
    sigs = sigs, layouts = layouts, lifted = lifted,
    shared = shared, stopped = None, overLimit = False, flatRefs = Set.new(), flatRecords = Set.new(),
    localRefs = Map.new(), localObjects = Map.new(),
    nextSlot = 0,
    held = Held { multis = Map.new(), types = Map.new(), layouts = Map.new(),
                  flats = Map.new(), boxedJoins = Map.new() },
}

-- A binding's value as parameters and a body, with type abstraction erased.
fun spine(value : Core) -> Option (Array CParam, Core) = match value.kind {
    CLam(params, body, _) -> Some((params, body))
    CTyLam(_, inner) -> spine(inner)
    _ -> None
}

-- -- scope ------------------------------------------------------------------------

-- The scope files a local binder by its id. Every local binder has one, and
-- a reference by spelling is to a top-level binding, which is filed by its
-- `Module#name` among the globals.

-- Returns `id`. Raises an internal error if it is `noId`: a local binder with
-- no id would have to be found by its spelling, and two binders of one
-- function may share a spelling.
fun idOf(name : String, id : Int) -> Int {
    if id == noId {
        oops("the local '" + name + "' reached the backend with no binder id")
    }
    id
}

-- The label a jump to `target` goes to. Raises an internal error for a jump
-- by spelling: every join after `Turkey.Opt` has an id.
fun labelOf(target : Ref) -> Int = match target {
    ById(id) -> id
    BySpelling(name) -> idOf(name, noId)
}

fun put(l : Lower, local : Ref, v : Value) -> Unit = match local {
    ById(id) -> Map.put(l.env, id, v)
    BySpelling(name) -> oops("the top-level binding '" + name + "' is bound as a local")
}

-- The value the local `local` names holds, if it is in scope. A reference by
-- spelling is to a top-level binding, which is no local.
fun lookup(l : Lower, local : Ref) -> Option Value = match local {
    ById(id) -> Map.get(l.env, id)
    BySpelling(_) -> None
}

-- A function type's result, past the type abstraction.
fun resultType(ty : Ty.Type) -> Ty.Type = match Ty.prune(ty) {
    TFun(_, ret) -> ret
    other -> other
}

fun stop(l : Lower, what : String) -> Value {
    halt(l, what, False)
    -- A value of the right shape so the walk can finish without a second
    -- failure mode; nothing reads it, because the caller discards the whole
    -- function.
    Ssa.freshValue(l.func, Ssa.untraced(Unit))
}

-- Stops the lowering because the program is past one of the runtime's limits.
-- `message` is shown to the user as is, so it says what to change.
fun refuse(l : Lower, message : String) -> Unit = halt(l, message, True)

-- Records the first reason the lowering stopped, and keeps it.
fun halt(l : Lower, what : String, overLimit : Bool) -> Unit {
    match l.stopped {
        None -> {
            l.stopped = Some(what)
            l.overLimit = overLimit
        }
        Some(_) -> {}
    }
}

-- A marker is never emitted as a runtime value, and a flattened binding is
-- found by its id, so no binding can take an ordinary pointer for one.
fun prepareLocals(l : Lower, body : Core) -> Unit {
    let (refs, records) = LocalEscape.analyze(l.decls, body)
    l.flatRefs = refs
    l.flatRecords = records
}

fun localBinding(l : Lower, id : Int, bound : Core) -> Value {
    match bound.kind {
        CRef(inner) -> if Set.contains(l.flatRefs, id) {
            let v = value(l, inner)
            let marker = Ssa.freshValue(l.func, Ssa.traced(Ptr))
            Map.put(l.localRefs, Ssa.valueId(marker), localSlot(l, v))
            return marker
        }
        CDict(_, items) -> if Set.contains(l.flatRecords, id) {
            let slots = Array.map(items, fun(inner) = localSlot(l, value(l, inner)))
            let marker = Ssa.freshValue(l.func, Ssa.traced(Ptr))
            Map.put(l.localObjects, Ssa.valueId(marker), slots)
            return marker
        }
        CApp(fn, args) -> if Set.contains(l.flatRecords, id) && builds(l, fn)
                && Option.isNone(flatHere(l, bound.ty)) {
            let slots = Array.map(args, fun(inner) = localSlot(l, value(l, inner)))
            let marker = Ssa.freshValue(l.func, Ssa.traced(Ptr))
            Map.put(l.localObjects, Ssa.valueId(marker), slots)
            return marker
        }
        _ -> {}
    }
    value(l, bound)
}

-- Whether `fn` is the constructor of a record, so that applying it is the
-- build `LocalEscape` may have found does not escape.
fun builds(l : Lower, fn : Core) -> Bool = match fn.kind {
    CCon(con) -> Decls.isRecordCon(l.decls, con)
    _ -> False
}

fun isMarker(l : Lower, v : Value) -> Bool =
    Map.contains(l.localRefs, Ssa.valueId(v))
        || Map.contains(l.localObjects, Ssa.valueId(v))

fun localSlot(l : Lower, held : Value) -> (Int, Rep) {
    let v = stored(l, held)
    let slot = l.nextSlot
    l.nextSlot = slot + 1
    L.effect(l.b, SlotStore(slot, v))
    (slot, Ssa.repOf(l.func, v))
}

fun globalRef(l : Lower, e : Core) -> Option (String, Rep) = match e.kind {
    CVar(BySpelling(name)) -> match Map.get(l.globalRefs, name) {
        Some(held) -> Some((name, held))
        None -> None
    }
    _ -> None
}

fun localRef(l : Lower, e : Core) -> Option (Int, Rep) = match e.kind {
    CVar(r) -> match lookup(l, r) {
        Some(v) -> Map.get(l.localRefs, Ssa.valueId(v))
        None -> None
    }
    _ -> None
}

fun localPosition(l : Lower, e : Core, index : Int) -> Option (Int, Rep) =
    match e.kind {
        CVar(r) -> match lookup(l, r) {
            Some(v) -> match Map.get(l.localObjects, Ssa.valueId(v)) {
                Some(slots) -> if index < len(slots) { Some(slots[index]) } else { None }
                None -> None
            }
            None -> None
        }
        _ -> None
    }

-- Lower `e`, sending its value to `dest`, with the builder's source position
-- on it for the duration, as `value` has.
fun lower(l : Lower, e : Core, dest : Dest) -> Unit {
    let outer = L.place(l.b)
    match e.span {
        Some(_) -> L.setSpan(l.b, e.span)
        None -> {}
    }
    lowerHere(l, e, dest)
    L.setPlace(l.b, outer)
}

fun lowerHere(l : Lower, e : Core, dest : Dest) -> Unit {
    match l.stopped {
        Some(_) -> return
        None -> {}
    }
    match e.kind {
        CIf(cond, then_, otherwise) -> {
            let test = value(l, cond)
            let yes = L.block(l.b)
            let no = L.block(l.b)
            L.terminate(l.b, Branch(test, yes, no))
            L.into(l.b, yes)
            lower(l, then_, dest)
            L.into(l.b, no)
            match otherwise {
                Some(other) -> lower(l, other, dest)
                -- A one-armed `if` is the statement form and answers `Unit`
                -- whatever its branch does.
                None -> finish(l, L.emit(l.b, ConstUnit, Ssa.untraced(Unit)), dest)
            }
        }
        CLet(name, id, ty, bound, body, _) -> {
            let local = idOf(name, id)
            Map.put(l.env, local, localBinding(l, local, bound))
            lower(l, body, dest)
        }
        -- A join is a block, and a jump to it is a jump. This is the case the
        -- whole IR is shaped for.
        CJoin(name, id, params, body, rest, recursive) -> {
            let target = L.block(l.b)
            let entered = joinParams(l, target, params, body, dest)
            Map.put(l.joins, idOf(name, id), target)
            -- `rest` first: it is what jumps, and the parameters have to exist
            -- before it can.
            lower(l, rest, dest)
            L.into(l.b, target)
            for var i = 0; i < len(params) && i < len(entered); i = i + 1 {
                Map.put(l.env, idOf(params[i].name, params[i].id), entered[i])
            }
            lower(l, body, dest)
        }
        CJump(target, args) -> {
            let supplied = Array.map(args, fun(a) = value(l, a))
            match Map.get(l.joins, labelOf(target)) {
                Some(target) ->
                    L.terminate(l.b, Jump(target, argsFor(l, target, supplied)))
                None -> {
                    let _ = stop(l, "a jump to an unknown join")
                }
            }
        }
        -- The arms all lower towards the same destination. This is where
        -- destination passing earns the most: an arm jumps to where the value
        -- was wanted, rather than materializing it into a block parameter and
        -- then into a slot.
        CMatch(scrutinee, alts) -> {
            let whole = value(l, scrutinee)
            if !switched(l, whole, scrutinee.ty, alts, dest) {
                chain(l, whole, scrutinee.ty, alts, dest)
            }
        }
        CLetRec(binds, body) -> letrec(l, binds, body, dest)
        _ -> finish(l, value(l, e), dest)
    }
}

-- A match as a chain of tests, one arm after another: what a match is when
-- `switched` cannot make it one switch.
fun chain(l : Lower, whole : Value, ty : Ty.Type, alts : Vec CAlt, dest : Dest) -> Unit {
    let failed = L.block(l.b)
    -- The first test happens where the scrutinee was computed, so every later
    -- test block is reached only through this one and the scrutinee dominates
    -- all of them.
    var test = l.b.at
    for var i = 0; i < len(alts); i = i + 1 {
        let success = L.block(l.b)
        let failure = if i + 1 == len(alts) { failed } else { L.block(l.b) }
        L.into(l.b, test)
        -- An existential arm's copy is lowered under the layouts it names for
        -- the constants it opens.
        let outer = l.layouts
        setLayouts(l, openedLayoutsFor(alts[i].alt, outer))
        testArm(l, alts[i].alt, whole, ty, success, failure)
        L.into(l.b, success)
        lower(l, alts[i].body, dest)
        setLayouts(l, outer)
        test = failure
    }
    L.into(l.b, failed)
    noArm(l)
}

-- Exhaustiveness has already decided this is unreachable. It is emitted anyway
-- because the *lowering* must not be the thing that assumes so: a bug in an
-- earlier pass then stops here with a name rather than falling off the end of
-- a block.
fun noArm(l : Lower) -> Unit {
    let message = L.emit(l.b, ConstString("no match arm applied"), Ssa.traced(Ptr))
    L.terminate(l.b, Panic(message))
}

-- A match on the constructors of one sum, or on integer or character
-- literals, as one `Switch`: the tag is read, or the value compared, once for
-- the whole match rather than once per arm. `False`, having emitted nothing,
-- for any other match.
--
-- An arm that matches anything ends the cases; the arms after it cannot be
-- reached.
fun switched(l : Lower, whole : Value, ty : Ty.Type, alts : Vec CAlt,
             dest : Dest) -> Bool {
    let tested = []
    var fallback : Option CAlt = None
    for alt in alts {
        match alt.alt {
            AAny(_) -> {
                fallback = Some(alt)
                break
            }
            _ -> Vec.push(tested, alt)
        }
    }
    if len(tested) < 2 { return False }
    let shape = match switchShape(l, whole, ty, tested) {
        Some(sh) -> sh
        None -> return False
    }
    let blocks = Array.map(tested, fun(_) = L.block(l.b))
    let otherwise = L.block(l.b)
    let cases = []
    let keyed = Set.new()
    var default : Option BlockId = Some(otherwise)
    match shape {
        Literals -> for var i = 0; i < len(tested); i = i + 1 {
            match tested[i].alt {
                ALit(lit) -> {
                    let key = literalKey(lit)
                    if !Set.contains(keyed, key) {
                        Set.add(keyed, key)
                        Vec.push(cases, (key, blocks[i]))
                    }
                }
                _ -> {}
            }
        }
        Tags(all) -> {
            for var i = 0; i < len(tested); i = i + 1 {
                let key = Map.getOr(l.tags, conOf(tested[i].alt), -1)
                if !Set.contains(keyed, key) {
                    Set.add(keyed, key)
                    Vec.push(cases, (key, blocks[i]))
                }
            }
            -- When the arms name every constructor, the tag is one of the
            -- cases, so the switch needs no default and a search over it need
            -- not confirm the last key it reaches.
            if every(all, fun(name) = Set.contains(keyed, Map.getOr(l.tags, name, -1))) {
                default = None
            }
        }
        Spread(f) -> {
            for var i = 0; i < len(tested); i = i + 1 {
                let key = Option.unwrapOr(Array.indexOf(f.names, conOf(tested[i].alt)), -1)
                if !Set.contains(keyed, key) {
                    Set.add(keyed, key)
                    Vec.push(cases, (key, blocks[i]))
                }
            }
            if len(keyed) == len(f.names) { default = None }
        }
        Indices(all) -> {
            for var i = 0; i < len(tested); i = i + 1 {
                let key = Option.unwrapOr(Array.indexOf(all, conOf(tested[i].alt)), -1)
                if !Set.contains(keyed, key) {
                    Set.add(keyed, key)
                    Vec.push(cases, (key, blocks[i]))
                }
            }
            if len(keyed) == len(all) { default = None }
        }
        Words(c) -> {
            var payload : Option BlockId = None
            for var i = 0; i < len(tested); i = i + 1 {
                let name = conOf(tested[i].alt)
                match Vec.indexOf(c.nullaries, name) {
                    Some(key) -> if !Set.contains(keyed, key) {
                        Set.add(keyed, key)
                        Vec.push(cases, (key, blocks[i]))
                    }
                    None -> if Option.isNone(payload) { payload = Some(blocks[i]) }
                }
            }
            -- A nullary is the small integer it is numbered by, and the
            -- payload a pointer above every one of them, so the payload arm is
            -- the default once every nullary is a case.
            if Option.isSome(payload) {
                for var key = 0; key < len(c.nullaries); key = key + 1 {
                    if !Set.contains(keyed, key) {
                        Set.add(keyed, key)
                        Vec.push(cases, (key, otherwise))
                    }
                }
                default = payload
            }
        }
    }
    let discriminant = match shape {
        Tags(_) -> L.emit(l.b, ObjectTag(whole), Ssa.untraced(I32))
        Spread(f) -> flatTag(l, whole, f)
        _ -> whole
    }
    L.terminate(l.b, decide(l, discriminant, cases, default))
    for var i = 0; i < len(tested); i = i + 1 {
        L.into(l.b, blocks[i])
        armOf(l, shape, tested[i], whole, ty, dest)
    }
    L.into(l.b, otherwise)
    match fallback {
        Some(alt) -> armOf(l, shape, alt, whole, ty, dest)
        None -> noArm(l)
    }
    True
}

-- A switch, or a branch where the value is one bit: an enumeration of two
-- constructors is held at `i1`, and a branch tests the bit itself where a
-- switch would compare it against a key.
fun decide(l : Lower, v : Value, cases : Vec (Int, BlockId),
           default : Option BlockId) -> Term {
    if Ssa.repOf(l.func, v).class_ != I1 { return Switch(v, cases, default) }
    match (caseFor(cases, default, 1), caseFor(cases, default, 0)) {
        (Some(yes), Some(no)) -> Branch(v, yes, no)
        _ -> Switch(v, cases, default)
    }
}

fun caseFor(cases : Vec (Int, BlockId), default : Option BlockId,
            key : Int) -> Option BlockId {
    for (k, block) in cases { if k == key { return Some(block) } }
    default
}

-- What a switch reads: an ordinary sum's tag, every one of which its type
-- names; an enumeration's value, which is its index among those names; a
-- one-word compact sum's word; or the value of an integer or character.
type SwitchShape
    = Tags(Array String)
    | Indices(Array String)
    | Words(Compact)
    | Literals
    -- A flat sum's tag slot, which holds the constructor's index.
    | Spread(Layout.Flat)

fun switchShape(l : Lower, whole : Value, ty : Ty.Type,
                tested : Vec CAlt) -> Option SwitchShape {
    match tested[0].alt {
        ALit(_) -> {
            let class_ = Ssa.repOf(l.func, whole).class_
            if class_ != I64 && class_ != I32 { return None }
            for alt in tested {
                match alt.alt {
                    ALit(LInt(_)) -> {}
                    ALit(LChar(_)) -> {}
                    _ -> return None
                }
            }
            Some(Literals)
        }
        ACon(first, _, _) -> {
            if Option.isSome(Decls.erasedPayload(l.decls, ty)) { return None }
            let info = match Decls.con(l.decls, first) {
                Some(i) -> i
                None -> return None
            }
            let variants = match Map.get(l.decls.tycons, info.tycon) {
                Some(t) -> Array.map(t.variants, _.name)
                None -> return None
            }
            if len(variants) < 2 { return None }
            for alt in tested {
                match alt.alt {
                    ACon(name, _, None) -> if !Array.contains(variants, name) { return None }
                    _ -> return None
                }
            }
            if Option.isSome(Decls.enumIndex(l.decls, first)) {
                return Some(Indices(variants))
            }
            match compactAt(l, first, ty) {
                Some(c) -> return Some(Words(c))
                None -> {}
            }
            match flatHere(l, ty) {
                Some(f) -> Some(Spread(f))
                None -> Some(Tags(variants))
            }
        }
        _ -> None
    }
}

fun conOf(alt : Alt) -> String = match alt {
    ACon(name, _, _) -> name
    _ -> ""
}

fun literalKey(lit : Lit) -> Int = match lit {
    LInt(n) -> n
    LChar(c) -> Char.toInt(c)
    _ -> 0
}

-- One arm of a switch, in the block the switch sent it to: what it binds,
-- then its body.
fun armOf(l : Lower, shape : SwitchShape, alt : CAlt, whole : Value, ty : Ty.Type,
          dest : Dest) -> Unit {
    match alt.alt {
        AAny(binder) -> bindTo(l, binder, whole)
        ACon(name, binders, _) -> match shape {
            Words(c) -> if Option.isNone(Vec.indexOf(c.nullaries, name)) {
                compactPayload(l, c, binders, whole, ty)
            }
            Spread(f) -> bindFlat(l, whole, f,
                                  Option.unwrapOr(Array.indexOf(f.names, name), -1), binders)
            _ -> match Decls.conFieldTypes(l.decls, ty, name) {
                Some(types) -> destructure(l, whole, layoutOf(l, types), positions(binders, types, 0))
                None -> stop1(l, "the fields of '" + name + "' at " + Ty.show(ty))
            }
        }
        _ -> {}
    }
    lower(l, alt.body, dest)
}

fun every(xs : Array a, p : fun(a) -> Bool) -> Bool {
    for x in xs { if !p(x) { return False } }
    True
}

-- -- arms ----------------------------------------------------------------------------

-- Test `alt` against `v`, binding what it binds, and terminate the current
-- block into `success` or `failure`.
--
-- One level: the parts an arm binds are variables, so nothing here recurses.
-- A value read for a part nobody binds is not read at all.
fun testArm(l : Lower, alt : Alt, v : Value, ty : Ty.Type,
            success : BlockId, failure : BlockId) -> Unit {
    match l.stopped {
        Some(_) -> return
        None -> {}
    }
    match alt {
        AAny(binder) -> {
            bindTo(l, binder, v)
            L.terminate(l.b, Jump(success, []))
        }
        ALit(LString(text)) -> stringTest(l, text, v, success, failure)
        ALit(lit) -> {
            let test = literalTest(l, lit, v)
            L.terminate(l.b, Branch(test, success, failure))
        }
        ATuple(binders) -> {
            let types = match Ty.prune(ty) {
                TTuple(ts) -> ts
                _ -> return stop1(l, "a tuple pattern at " + Ty.show(ty))
            }
            match flatHere(l, ty) {
                Some(f) -> bindFlat(l, v, f, 0, binders)
                None -> destructure(l, v, layoutOf(l, types), positions(binders, types, 0))
            }
            L.terminate(l.b, Jump(success, []))
        }
        ACon(name, binders, Some(o)) -> opened(l, name, binders, o, v, ty, success, failure)
        ACon(name, binders, None) -> {
            match Decls.enumIndex(l.decls, name) {
                Some(i) -> {
                    if Decls.variantCount(l.decls, name) <= 1 {
                        L.terminate(l.b, Jump(success, []))
                        return
                    }
                    let want = enumValue(l, i, Ssa.repOf(l.func, v))
                    let test = L.emit(l.b, Cmp(Eq, v, want), Ssa.untraced(I1))
                    L.terminate(l.b, Branch(test, success, failure))
                    return
                }
                None -> {}
            }
            -- The wrapper is not there, so there is no tag to test and nothing
            -- to take out: the value in hand already *is* the payload. See
            -- `Decls.newtypes`.
            if Option.isSome(Decls.erasedPayload(l.decls, ty)) && len(binders) == 1 {
                bindTo(l, binders[0], v)
                L.terminate(l.b, Jump(success, []))
                return
            }
            match compactAt(l, name, ty) {
                Some(c) -> {
                    compactTest(l, c, name, binders, v, ty, success, failure)
                    return
                }
                None -> {}
            }
            match flatHere(l, ty) {
                Some(f) -> {
                    let k = if len(f.names) == 0 { 0 } else {
                        let k = Option.unwrapOr(Array.indexOf(f.names, name), -1)
                        let tag = flatTag(l, v, f)
                        let want = enumValue(l, k, f.slots[0])
                        let test = L.emit(l.b, Cmp(Eq, tag, want), Ssa.untraced(I1))
                        let contents = L.block(l.b)
                        L.terminate(l.b, Branch(test, contents, failure))
                        L.into(l.b, contents)
                        k
                    }
                    bindFlat(l, v, f, k, binders)
                    L.terminate(l.b, Jump(success, []))
                    return
                }
                None -> {}
            }
            let types = match Decls.conFieldTypes(l.decls, ty, name) {
                Some(ts) -> ts
                None -> return stop1(l, "the fields of '" + name + "' at " + Ty.show(ty))
            }
            if !tested(l, v, name, failure) { return }
            destructure(l, v, layoutOf(l, types), positions(binders, types, 0))
            L.terminate(l.b, Jump(success, []))
        }
    }
}

fun bindTo(l : Lower, binder : Option (String, Int), v : Value) -> Unit = match binder {
    Some((name, id)) -> Map.put(l.env, idOf(name, id), v)
    None -> {}
}

-- Bind the fields an arm binds of `v`, a value of a flat type built with its
-- `k`th constructor, from the slots `f` puts them in. A field nobody binds is
-- not read.
fun bindFlat(l : Lower, v : Value, f : Layout.Flat, k : Int,
             binders : Array (Option (String, Int))) -> Unit {
    if k < 0 || k >= len(f.fields) {
        return stop1(l, "a constructor not among the flat type's")
    }
    let whole = Ssa.Layout { slots = f.slots }
    let fields = f.fields[k]
    for var i = 0; i < len(binders) && i < len(fields); i = i + 1 {
        match binders[i] {
            Some((name, id)) -> {
                let at = fields[i]
                let layout = Ssa.Layout { slots = Array.map(at, fun(j) = f.slots[j]) }
                Map.put(l.env, idOf(name, id), fromSlots(l, layout, slotsAt(l, v, whole, at)))
            }
            None -> {}
        }
    }
}

-- The tag slot of `v`, a value of the flat sum `f`.
fun flatTag(l : Lower, v : Value, f : Layout.Flat) -> Value =
    slotsAt(l, v, Ssa.Layout { slots = f.slots }, [0])[0]

-- The fields an arm binds: each one's slot in the object, counting from
-- `first`, its binder id, and its type.
fun positions(binders : Array (Option (String, Int)), types : Array Ty.Type,
              first : Int) -> Vec (Int, Int, Ty.Type) {
    let out = []
    for var i = 0; i < len(binders) && i < len(types); i = i + 1 {
        match binders[i] {
            Some((name, id)) -> Vec.push(out, (first + i, idOf(name, id), types[i]))
            None -> {}
        }
    }
    out
}

-- Opening a packed existential: the tag, then the stored index against the one
-- this copy of the arm was lowered for, then the carried dictionaries, then
-- the fields.
fun opened(l : Lower, name : String, binders : Array (Option (String, Int)), o : Opened,
           v : Value, ty : Ty.Type, success : BlockId, failure : BlockId) -> Unit {
    let layouts = match o.layouts {
        Some(ls) -> ls
        None -> return stop1(l, "an arm opening '" + name
                             + "' reached the backend without its layouts")
    }
    let index = match Layout.packingIndex(l.decls, name, layouts) {
        Some(i) -> i
        None -> return stop1(l, "an arm opening '" + name + "' at "
                             + Ssa.keyName(layouts) + ", which nothing packs")
    }
    let skolemTypes = Array.map(o.skolems, TCon)
    let types = match Decls.conFieldTypesOpened(l.decls, ty, name, skolemTypes) {
        Some(ts) -> ts
        None -> return stop1(l, "the fields of '" + name + "' opened at " + Ty.show(ty))
    }
    -- What `packed` built: the index, the dictionaries, the fields.
    let carried = len(o.evidence)
    let reps = Array.init(1 + carried + len(types), fun(i) =
        if i <= carried { Ssa.traced(Ptr) }
        else { repOf(l, types[i - 1 - carried]) })
    let layout = Rt.layout(reps)
    if !tested(l, v, name, failure) { return }
    -- A constructor packed at one key has one copy of each arm opening it, and
    -- nothing to tell apart, as `tested` reasons for a tag.
    if Layout.packingCount(l.decls, name) > 1 {
        let code = L.emit(l.b, ObjectGet(v, L.fieldRef(layout, 0)), Ssa.traced(Ptr))
        let want = L.emit(l.b, ConstInt(index), Ssa.traced(Ptr))
        let test = L.emit(l.b, Cmp(Eq, code, want), Ssa.untraced(I1))
        let next = L.block(l.b)
        L.terminate(l.b, Branch(test, next, failure))
        L.into(l.b, next)
    }
    for var i = 0; i < len(o.evidence); i = i + 1 {
        let (d, id) = o.evidence[i]
        Map.put(l.env, idOf(d, id),
                L.emit(l.b, ObjectGet(v, L.fieldRef(layout, 1 + i)), Ssa.traced(Ptr)))
    }
    destructure(l, v, layout, positions(binders, types, 1 + carried))
    L.terminate(l.b, Jump(success, []))
}

-- Where a cell keeps its value, as an operand.
fun cellValue(l : Lower) -> Value = L.emit(l.b, ConstInt(Rt.cellValue), Ssa.untraced(I64))

fun stop1(l : Lower, message : String) -> Unit {
    let _ = stop(l, message)
    {}
}

-- The layouts an arm's opening names, over the ones already in force.
fun openedLayoutsFor(alt : Alt, outer : Map String Ssa.Layout) -> Map String Ssa.Layout {
    let o = match Core.openingOf(alt) {
        Some(o) -> o
        None -> return outer
    }
    let inner = Map.new()
    for (id_, layout) in Map.entries(outer) { Map.put(inner, id_, layout) }
    match o.layouts {
        Some(ls) -> for var i = 0; i < len(o.skolems) && i < len(ls); i = i + 1 {
            Map.put(inner, Layout.skolemKey(o.skolems[i]), ls[i])
        }
        None -> {}
    }
    inner
}

-- The tag test a constructor needs, continuing in a block reached only when it
-- passes; `False` if the lowering stopped.
--
-- A type with one constructor has nothing to distinguish, and reading the tag
-- to compare it against the only value it can hold costs a load, a compare and
-- a branch on the hot path -- `Vec a = Vec(VecStorage a)` would pay it on
-- every element access. Exhaustiveness already knows the match is total;
-- this is the lowering agreeing with it.
fun tested(l : Lower, v : Value, name : String, failure : BlockId) -> Bool {
    if Decls.variantCount(l.decls, name) <= 1 { return True }
    match Map.get(l.tags, name) {
        Some(tag) -> {
            let seen = L.emit(l.b, ObjectTag(v), Ssa.untraced(I32))
            let want = L.emit(l.b, ConstInt(tag), Ssa.untraced(I32))
            let test = L.emit(l.b, Cmp(Eq, seen, want), Ssa.untraced(I1))
            let contents = L.block(l.b)
            L.terminate(l.b, Branch(test, contents, failure))
            L.into(l.b, contents)
            True
        }
        None -> {
            let _ = stop(l, "the constructor '" + name + "' has no tag")
            False
        }
    }
}

-- Read each field an arm binds and bind it, from an object laid out as
-- `layout`.
fun destructure(l : Lower, object : Value, layout : Rt.Layout,
                fields : Vec (Int, Int, Ty.Type)) -> Unit {
    for (index, id, fieldTy) in fields {
        let held = heldOf(l, fieldTy)
        Map.put(l.env, id, fromStored(l, held,
            L.emit(l.b, ObjectGet(object, L.fieldRef(layout, index)), Layout.storedRep(held))))
    }
}

-- The layout of an object whose fields have these types.
--
-- A reader and the object's builder each compute it, the builder from its
-- operands' representations and the reader from the types, and agree because
-- a value's representation is a function of its type. A field's place depends
-- on every other field's representation, so a reader needs all of the types
-- and not only the one it reads.
fun layoutOf(l : Lower, types : Array Ty.Type) -> Rt.Layout =
    Rt.layout(Array.map(types, repOf(l, _)))

-- Where field `index` is in a value of type `ty`, which a projection names
-- without a pattern: a tuple, or a type with one constructor.
fun projected(l : Lower, ty : Ty.Type, index : Int) -> Option L.FieldRef {
    let types = match Ty.prune(ty) {
        TTuple(ts) -> ts
        t -> match Decls.payloadTypes(l.decls, t) {
            Some(ts) -> ts
            None -> {
                stop1(l, "a projection from " + Ty.show(ty))
                return None
            }
        }
    }
    if index >= len(types) {
        stop1(l, "a projection of field " + Int.toString(index) + " from " + Ty.show(ty))
        return None
    }
    Some(L.fieldRef(layoutOf(l, types), index))
}

-- Slot `index` of a dictionary. Every slot holds a traced pointer -- a
-- method's closure or a superclass's dictionary, which `dictionary` checks of
-- each one it builds and `act` of each one it places -- so the slot is the
-- `index`th pointer, and its place does not depend on how many slots follow.
fun dictionarySlot(index : Int) -> L.FieldRef =
    L.fieldRef(Rt.layout(Array.filled(index + 1, Ssa.traced(Ptr))), index)

-- A literal pattern's test: a machine comparison, and a float comparison is
-- the same constructor with `f64` operands, which is what instruction
-- selection reads it off. A string has `stringTest` instead.
fun literalTest(l : Lower, lit : Lit, v : Value) -> Value {
    let want = literal(l, lit, Ssa.repOf(l.func, v))
    L.emit(l.b, Cmp(Eq, v, want), Ssa.untraced(I1))
}

-- A string literal pattern, compared inline. A `String` is its byte array, so
-- this is a length test and then one byte test per byte of the literal -- what
-- a C compiler makes of a `memcmp` against a short constant, and the literals
-- in patterns are keywords. No call, and therefore no safepoint.
fun stringTest(l : Lower, text : String, v : Value, success : BlockId,
               failure : BlockId) -> Unit {
    let bytes = String.toBytes(text)
    let length = L.emit(l.b, ArrayLength(v), Ssa.untraced(I64))
    let want = L.emit(l.b, ConstInt(len(bytes)), Ssa.untraced(I64))
    var same = L.emit(l.b, Cmp(Eq, length, want), Ssa.untraced(I1))
    for var i = 0; i < len(bytes); i = i + 1 {
        let next = L.block(l.b)
        L.terminate(l.b, Branch(same, next, failure))
        L.into(l.b, next)
        let index = L.emit(l.b, ConstInt(i), Ssa.untraced(I64))
        let got = L.emit(l.b, ArrayGet(v, index, Checked), Ssa.untraced(I8))
        let byte = scalar(l, ConstInt(Byte.toInt(bytes[i])), Ssa.untraced(I64),
                          Ssa.untraced(I8))
        same = L.emit(l.b, Cmp(Eq, got, byte), Ssa.untraced(I1))
    }
    L.terminate(l.b, Branch(same, success, failure))
}

fun finish(l : Lower, v : Value, dest : Dest) -> Unit = match dest {
    ToReturn -> L.terminate(l.b, Ret(returned(l, v)))
    ToBlock(target) -> L.terminate(l.b, Jump(target, argsFor(l, target, [v])))
    ToMerge(_, arrivals) -> Vec.push(arrivals, (l.b.at, v))
}

-- What a function answers for `v`, one value per register it answers in. A
-- value of several slots is answered in its slots, loaded here if it is boxed,
-- so a call's results passed straight back are moved and nothing is built.
fun returned(l : Lower, v : Value) -> Vec Value {
    let results = l.func.results
    if len(results) == 1 { return [coerce(l, v, results[0])] }
    match multiOf(l, v) {
        Some(m) -> {
            let slots = slotsOf(l, v, multiLayout(m))
            if len(slots) != len(results) {
                return [stop(l, "a value of " + Ssa.layoutName(multiLayout(m))
                                + " answered in " + Int.toString(len(results)) + " registers")]
            }
            Vec.fromArray(Array.init(len(results), fun(k) = coerce(l, slots[k], results[k])))
        }
        -- A diverging expression's value, which nothing reads.
        None -> if Ssa.repOf(l.func, v).class_ == Unit {
            Vec.fromArray(Array.map(results, zero(l, _)))
        } else {
            [stop(l, "a value of " + show(Ssa.repOf(l.func, v)) + " answered in "
                     + Int.toString(len(results)) + " registers")]
        }
    }
}

-- -- representation boundaries -------------------------------------------------------

-- Make `v` usable where `want` is required.
--
-- Only a change of obligation on the collector is a conversion: a traced
-- pointer and a raw address are the same word. Every other disagreement is two
-- answers about one value's type, and converting would make it compile. A body
-- knows the layout of every type it mentions, and the value's producer and its
-- consumer each computed that layout from the same ground type, so a scalar
-- reaching a pointer context -- or the reverse -- is a compiler bug. A real
-- conversion is written in the source (`Prim.byteToInt`) and reaches `Convert`
-- through `primitive`.
--
-- Unit is the exception, in both directions: a value of zero width has nothing
-- to convert, and a unit where a word is wanted is a diverging expression's,
-- which nothing reads.
fun coerce(l : Lower, v : Value, want : Rep) -> Value {
    -- A value of several slots is wanted in one register only as its box.
    if Option.isSome(multiOf(l, v)) {
        if want == Ssa.traced(Ptr) { return stored(l, v) }
        return stop(l, "a value of several slots wanted at " + show(want))
    }
    let have = Ssa.repOf(l.func, v)
    if have == want { return v }
    if want.class_ == Unit { return L.emit(l.b, ConstUnit, want) }
    if have.class_ == Unit { return zero(l, want) }
    if have.class_ == Ptr && want.class_ == Ptr { return retagged(l, v, want) }
    stop(l, "an implicit conversion from " + show(have) + " to " + show(want))
}

-- The same machine value with a different obligation on the collector.
fun retagged(l : Lower, v : Value, want : Rep) -> Value =
    if Ssa.repOf(l.func, v) == want { v }
    else { L.emit(l.b, Convert(Retag, v), want) }

-- Lower an expression that yields a value in the current block.
-- Lower one Core node, with the builder's source position on it for the
-- duration, so an allocation this node lowers to is recorded against the
-- construct that asked for it (`Func.origins`). A node with no span of its own
-- -- one the compiler made -- keeps its parent's.
fun value(l : Lower, e : Core) -> Value {
    let outer = L.place(l.b)
    match e.span {
        Some(_) -> L.setSpan(l.b, e.span)
        None -> {}
    }
    let held = if Option.isSome(l.stopped) { Ssa.Layout { slots = [] } } else { heldOf(l, e.ty) }
    let v = adopted(l, e.ty, held, valueHere(l, e, held))
    L.setPlace(l.b, outer)
    v
}

fun valueHere(l : Lower, e : Core, held : Ssa.Layout) -> Value {
    match l.stopped {
        Some(_) -> return Ssa.freshValue(l.func, Ssa.untraced(Unit))
        None -> {}
    }
    let rep = Layout.storedRep(held)
    match e.kind {
        CUnit -> L.emit(l.b, ConstUnit, Ssa.untraced(Unit))
        CLit(lit) -> literal(l, lit, rep)
        CVar(r) -> match lookup(l, r) {
            Some(v) -> v
            -- A top-level *function* mentioned rather than called.
            -- `GlobalLoad` would load the symbol, which is a code address and
            -- not something anything can call; what is wanted is a closure
            -- around it, using the function's own environment-first signature.
            None -> match r {
                ById(_) -> stop(l, "a local binder out of its scope")
                BySpelling(name) -> match Map.get(l.sigs, name) {
                    Some(_) -> {
                        L.emit(l.b, ClosureNew(name, None),
                               Ssa.traced(Ptr))
                    }
                    None -> if Set.contains(l.globals, name) {
                        L.emit(l.b, GlobalLoad(name), rep)
                    } else if Map.contains(l.decls.foreigns, name) {
                        -- The same rule, for the same reason: there is no code
                        -- here to take the address of. A wrapper in the
                        -- declaring module is what makes one a value.
                        stop(l, "the foreign '" + name + "' used as a value")
                    } else {
                        stop(l, "an unbound name '" + name + "'")
                    }
                }
            }
        }
        -- At the application's type, not the applied term's: a type
        -- application's function is not a value, and the type on it says
        -- nothing about the value's representation -- a reference to a generic
        -- global may carry a bare variable there.
        CTyApp(_, _) -> value(l, Core.mkCore(e.ty, e.span, erased(e).kind))
        CTyLam(_, _) -> value(l, Core.mkCore(e.ty, e.span, erased(e).kind))
        CRef(inner) -> L.emit(l.b, CellNew(stored(l, value(l, inner))), Ssa.traced(Ptr))
        CDeref(inner) -> match globalRef(l, inner) {
            Some((name, held)) -> coerce(l, L.emit(l.b, GlobalLoad(name), held), rep)
            None -> match localRef(l, inner) {
            Some((slot, held)) -> coerce(l, L.emit(l.b, SlotLoad(slot), held), rep)
            None -> L.emit(l.b, CellLoad(value(l, inner)), rep)
            }
        }
        -- An erased wrapper has nothing to read out of: the value in hand
        -- already is the payload, the way a pattern on one binds it directly.
        CProject(target, index) -> match localPosition(l, target, index) {
            Some((slot, held)) -> coerce(l, L.emit(l.b, SlotLoad(slot), held), rep)
            None -> match Decls.erasedPayload(l.decls, target.ty) {
            Some(_) -> value(l, target)
            None -> match flatHere(l, target.ty) {
            Some(f) -> {
                let whole = value(l, target)
                if index >= len(f.fields[0]) {
                    return stop(l, "a projection of field " + Int.toString(index)
                                   + " from " + Ty.show(target.ty))
                }
                let at = f.fields[0][index]
                fromSlots(l, held, slotsAt(l, whole, Ssa.Layout { slots = f.slots }, at))
            }
            None -> match projected(l, target.ty, index) {
                Some(field) -> L.emit(l.b, ObjectGet(value(l, target), field), rep)
                None -> Ssa.freshValue(l.func, rep)
            }
            }
            }
        }
        CSlot(target, index) -> match localPosition(l, target, index) {
            Some((slot, held)) -> coerce(l, L.emit(l.b, SlotLoad(slot), held), rep)
            None -> {
                if rep != Ssa.traced(Ptr) {
                    return stop(l, "a dictionary slot held at " + show(rep))
                }
                L.emit(l.b, ObjectGet(value(l, target), dictionarySlot(index)), rep)
            }
        }
        CIndex(target, index) -> {
            let array = value(l, target)
            L.emit(l.b, ArrayGet(array, value(l, index), Checked), rep)
        }
        -- Core assignment evaluates the value before its target, and the
        -- target decides which of three stores it is: all three are assignment
        -- in the surface language and all three are reference semantics.
        CAssign(target, assigned) -> {
            let x = value(l, assigned)
            store(l, target, x)
            L.emit(l.b, ConstUnit, Ssa.untraced(Unit))
        }
        CTuple(elems) -> match flatHere(l, e.ty) {
            Some(f) -> flatValue(l, f, held, 0, elems)
            None -> aggregate(l, elems, 0, -1, 0, "builds a tuple", fieldsOf("this tuple"))
        }
        CDict(cls, slots) -> dictionary(l, cls, slots)
        CArray(elems) -> arrayLiteral(l, e, elems)
        CCon(name) -> match Ty.prune(e.ty) {
            TFun(_, _) -> stop(l, "the constructor '" + name + "' must be saturated")
            _ -> constructor(l, e, name, [], rep)
        }
        -- A call that does not come back -- its result type is bottom, or
        -- its callee always panics -- makes what follows it unreachable
        -- rather than merely dead. Saying so keeps a `ret` or a jump from
        -- being built out of a value that never arrives, which the verifier
        -- reports as a representation disagreement, and keeps the code after
        -- the call out of the graph: a fall-through edge would make every
        -- value live there live across the call too.
        CApp(fn, args) -> {
            let called = call(l, e, fn, args, rep)
            if divergingCall(l.sigs, e, fn, args) {
                L.terminate(l.b, Unreachable)
                L.into(l.b, L.block(l.b))
                zero(l, rep)
            } else { called }
        }
        -- A form that is not a value in itself: it is control flow that
        -- *arrives* at one. Giving it a block whose parameter is where its
        -- value lands is the whole of it -- the same mechanism `if` already
        -- uses for its two arms, applied one level up.
        CLam(params, body, _) -> lambda(l, params, body, resultType(e.ty))
        -- Referred to but not called. Closure conversion does not reach this:
        -- a primitive has no `CBind`, so there is no signature to adapt from,
        -- and the fix is a per-primitive adapter that `primitive` would
        -- generate.
        CPrim(p) -> stop(l, "the primitive '" + Prims.name(p) + "' used as a value")
        CIf(_, _, _) -> control(l, e, held)
        CMatch(_, _) -> control(l, e, held)
        -- One path in and one out, so no block is needed for its value, and
        -- a value of several slots keeps the form its body gave it.
        CLet(name, id, _, bound, body, _) -> {
            let local = idOf(name, id)
            Map.put(l.env, local, localBinding(l, local, bound))
            value(l, body)
        }
        CJoin(_, _, _, _, _, _) -> control(l, e, held)
        CLetRec(_, _) -> control(l, e, held)
        _ -> stop(l, formOf(e))
    }
}

-- An expression that is control flow, used where a value was wanted.
--
-- `lower` already sends a value to a destination; this makes a destination out
-- of a fresh block and reads the value back out of its parameter. Nothing else
-- is needed, and in particular no slot: the parameter is the value.
--
-- A value of several slots arrives boxed when every value sent to it is a box,
-- as values read from memory are, and in its slots otherwise. A merge whose
-- value is stored again then passes the pointer on, where taking every box
-- apart would build a new one for the store. When the merge's value is taken
-- apart instead, the loads move from the arms to the merge, which costs the
-- same. The jumps into it are made once the arms are lowered, since only then
-- is it known which form the values arrive in.
fun control(l : Lower, e : Core, held : Ssa.Layout) -> Value {
    let merge = L.block(l.b)
    if !isMulti(held) {
        let arrived = paramsFor(l, merge, held)
        lower(l, e, ToBlock(merge))
        L.into(l.b, merge)
        return arrived
    }
    let arrivals = []
    lower(l, e, ToMerge(merge, arrivals))
    let boxed = len(arrivals) > 0 && Iterator.all(arrivals, fun((_, v)) = match multiOf(l, v) {
        Some(Boxed(_, _)) -> True
        _ -> False
    })
    let arrived = if boxed {
        Map.put(l.held.boxedJoins, blockIndex(merge), [True])
        fromStored(l, held, L.param(l.b, merge, Ssa.traced(Ptr)))
    } else { paramsFor(l, merge, held) }
    for (from, v) in arrivals {
        L.into(l.b, from)
        L.terminate(l.b, Jump(merge, argsFor(l, merge, [v])))
    }
    L.into(l.b, merge)
    arrived
}

-- The shapes of assignment target.
fun store(l : Lower, target : Core, assigned : Value) -> Unit {
    let x = stored(l, assigned)
    storeStored(l, target, x)
}

fun storeStored(l : Lower, target : Core, x : Value) -> Unit = match target.kind {
    CIndex(array, index) -> {
        let a = value(l, array)
        L.effect(l.b, ArraySet(a, value(l, index), x, Checked))
    }
    CProject(receiver, index) -> match localPosition(l, receiver, index) {
        Some((slot, held)) -> L.effect(l.b, SlotStore(slot, coerce(l, x, held)))
        None -> match projected(l, receiver.ty, index) {
            Some(field) -> L.effect(l.b, ObjectSet(value(l, receiver), field, x))
            None -> {}
        }
    }
    -- Anything else is a reference cell: a `var`, whose mentions are already
    -- `CDeref` and whose assignment is a store through the cell itself.
    _ -> match globalRef(l, target) {
        Some((name, held)) -> L.effect(l.b, GlobalStore(name, coerce(l, x, held)))
        None -> match localRef(l, target) {
            Some((slot, held)) -> L.effect(l.b, SlotStore(slot, coerce(l, x, held)))
            None -> L.effect(l.b, CellStore(value(l, target), x))
        }
    }
}

-- A heap object built with its fields.
--
-- `kind` is 0 for a tuple and 1 for a constructed value, which is what the
-- runtime's own object header distinguishes. `mutable` has a bit set for each
-- field that may be assigned later.
fun aggregate(l : Lower, items : Array Core, kind : Int, tag : Int,
             mutable : Int, what : String, refusal : fun(Int) -> String) -> Value {
    if wide(l, len(items), refusal) { return Ssa.freshValue(l.func, Ssa.traced(Ptr)) }
    let values = Array.map(items, fun(x) = value(l, x))
    built(l, kind, tag, values, mutable, what)
}

-- An object of these fields, laid out from their representations.
fun built(l : Lower, kind : Int, tag : Int, fields : Array Value, mutable : Int,
          what : String) -> Value {
    let values = storedAll(l, fields)
    let layout = Rt.layout(Array.map(values, Ssa.repOf(l.func, _)))
    if !countable(l, layout) { return Ssa.freshValue(l.func, Ssa.traced(Ptr)) }
    let made = L.emit(l.b, ObjectNew(kind, tag, layout, values, mutable), Ssa.traced(Ptr))
    Map.put(l.func.reasons, Ssa.valueId(made), what)
    made
}

-- A dictionary: a constructed value whose slots are all traced pointers, which
-- is what lets a slot be read knowing only its index (`dictionarySlot`).
-- Mutable throughout, as a dictionary the initializer fills one slot at a time
-- must be: the masks of all dictionaries of a class agree.
fun dictionary(l : Lower, cls : String, slots : Array Core) -> Value {
    let what = "builds a dictionary, " + cls
    let refusal = fun(n) = "an instance of class '" + Ty.shortName(cls) + "' needs "
        + Int.toString(n) + " slots, one for each method and superclass, and an instance "
        + "can have at most " + Int.toString(Rt.fieldLimit) + "; split the class into "
        + "smaller ones"
    if wide(l, len(slots), refusal) { return Ssa.freshValue(l.func, Ssa.traced(Ptr)) }
    let values = Array.map(slots, fun(x) = value(l, x))
    for v in values {
        if Ssa.repOf(l.func, v) != Ssa.traced(Ptr) {
            return stop(l, "a dictionary slot of " + cls + " held at " + show(Ssa.repOf(l.func, v)))
        }
    }
    built(l, 1, Map.getOr(l.tags, Core.dictName(cls), -1), values, allFields(len(slots)), what)
}

-- Which fields of a value built with this constructor may be assigned: its
-- `var` fields. Any other field never changes after construction, so an
-- `ObjectGet` of it from an object built in view is the value it was built
-- with. A constructor the declarations do not know -- a dictionary's -- is
-- taken to be mutable throughout.
fun mutableMask(l : Lower, con : String, count : Int) -> Int =
    match Decls.con(l.decls, con) {
        Some(info) -> {
            var mask = 0
            for var i = 0; i < len(info.mutable); i = i + 1 {
                if info.mutable[i] { mask = mask | 1 << i }
            }
            mask
        }
        None -> allFields(count)
    }

-- The mutable mask with every one of `count` fields set.
fun allFields(count : Int) -> Int = (1 << count) - 1

-- Whether an object of `count` fields is past `Rt.fieldLimit`, stopping the
-- lowering with `refusal(count)` if it is. The parser holds a declared
-- constructor and a tuple to the limit; this stops anything else that wide --
-- a dictionary of a class with many methods, a packed existential.
fun wide(l : Lower, count : Int, refusal : fun(Int) -> String) -> Bool {
    if count <= Rt.fieldLimit { return False }
    refuse(l, refusal(count))
    True
}

-- Whether an object of this layout can say where its pointers are, stopping
-- the lowering if it cannot: its header counts its traced words in 16 bits
-- (`Rt.tracedLimit`).
fun countable(l : Lower, layout : Rt.Layout) -> Bool {
    if layout.pointers <= Rt.tracedLimit { return True }
    refuse(l, "a value needs " + Int.toString(layout.pointers) + " pointer fields, and a "
              + "value can have at most " + Int.toString(Rt.tracedLimit)
              + "; move some fields into a record")
    False
}

-- -- closures ----------------------------------------------------------------------

-- The captures a lambda needs: the locals its body mentions that this body
-- holds, and what each is held at, in the order the body first mentions them.
--
-- The *representation* and not the type. The parent writes the capture and the
-- child reads it back, so passing a type would have them each derive a
-- representation from it separately -- two derivations of one fact, and the
-- disagreement would be silent, because the graph still verifies and only the
-- collector notices.
--
-- `Core.references` collects every `CVar` in the body, including those under
-- nested lambdas -- which is what makes a transitive capture work with no
-- second traversal. A binder the body binds itself is not in the environment
-- yet, since no id is bound twice in the program, and a binder that is but whose
-- scope has ended is one the body cannot mention. So what the environment holds
-- of the body's references is exactly its free locals.
--
-- Not the whole environment. `turkey_object_new` refuses more than 63 slots,
-- and the environment of a body the size of `Turkey.Opt#expr` holds far more
-- than 63 locals -- so capturing everything is not a slower correct answer, it
-- is a runtime panic on this compiler's own source. And every capture pins a
-- live range from the closure's creation to the end of the function, which the
-- register allocator would pay for.
--
-- `extra` is `CLetRec`'s siblings: locals that will hold closures but do not
-- yet, so their representation is known before their value is.
fun capturesOf(l : Lower, body : Core, extra : Set.Set Int) -> Vec (Ref, Ssa.Layout) {
    let out = []
    for local in Core.references(body) {
        if Set.contains(extra, binderId(local)) {
            Vec.push(out, (local, Ssa.Layout { slots = [Ssa.traced(Ptr)] }))
        } else {
            match lookup(l, local) {
                -- A flattened `var` or record is a marker, never emitted, and
                -- capturing one would be a use of an undefined value. None is
                -- held here: `LocalEscape` keeps any binding a closure
                -- mentions on the heap.
                --
                -- A `unit` holds nothing and `lift` makes the child its own;
                -- the 63-slot cap makes that worth doing rather than merely
                -- tidy.
                Some(v) -> {
                    match multiOf(l, v) {
                        Some(m) -> Vec.push(out, (local, multiLayout(m)))
                        None -> if !isMarker(l, v) && Ssa.repOf(l.func, v).class_ != Unit {
                            Vec.push(out, (local, Ssa.Layout { slots = [Ssa.repOf(l.func, v)] }))
                        }
                    }
                }
                None -> {}
            }
        }
    }
    out
}

-- Lift a lambda into a function of its own, and answer its symbol.
--
-- The child is an ordinary `Lower` over a fresh `Ssa.Func`: this record holds
-- its function and its builder directly, so a nested one is a second record
-- rather than a saved and restored cursor. What it *shares* is the lifted
-- array and the counter, which is what makes the symbols unique and the
-- results collectable.
fun lift(l : Lower, params : Array CParam, body : Core, result : Ty.Type,
         captures : Vec (Ref, Ssa.Layout)) -> Option String {
    -- A capture of several slots takes a word for each (`environmentLayout`).
    let words = len(environmentReps(captures))
    if words > 63 {
        let counted = if words == len(captures) { Int.toString(words) + " variables" }
            else { Int.toString(len(captures)) + " variables in " + Int.toString(words)
                   + " words" }
        refuse(l, "a nested function captures " + counted + ", and a function can "
                  + "capture at most 63; pass some as parameters, or group them in a "
                  + "record")
        return None
    }
    -- `%` is the compiler's own character: the lexer will not accept one in an
    -- identifier, so no Turkey name mangles onto this, and a top-level name
    -- here already carries `#` and `@`. The symbol is the binding's name and
    -- the lambda's place among the binding's lambdas in the order they are
    -- lowered, so it depends on the program alone. Its display form
    -- (`Turkey.Demangle`) is the binding's with `.<lambda0>` after it.
    let symbol = l.func.name + "%lambda" + Int.toString(l.shared.next)
    l.shared.next = l.shared.next + 1
    -- The body and every call site derive the signature from its types.
    let g = Ssa.newFunc(symbol, [repOf(l, result)])
    g.module_ = l.func.module_
    -- The *parent's* layouts. A closure inside a layout-shared copy holds the
    -- copy's variables at the copy's layouts, and a synthetic binding that
    -- forgot them would read its captures at the boxed width.
    --
    -- An empty `joins`, because a lambda's body is not a tail position: a
    -- closure outlives the frame that binds the join, so no label is in scope
    -- and sharing the parent's map would be a jump into a dead frame.
    -- `Turkey.Core`'s note on tail positions says exactly this.
    let child = newLower(l.decls, g, l.globals, l.globalRefs, l.tags, l.sigs,
                         l.layouts, l.lifted, l.shared)
    -- Under the parent's layouts as they are now, so the child can share what
    -- the parent has found out about them. Either one that changes its
    -- layouts starts afresh (`setLayouts`) rather than emptying these.
    child.held.layouts = l.held.layouts
    child.held.flats = l.held.flats
    -- What the body does before its own first node, reading the environment
    -- and the parameters, is the lambda's. Its position is made by the
    -- child's builder, because a position's inline site is numbered in the
    -- function it is in.
    L.setSpan(child.b, l.b.span)
    g.at = L.here(child.b)
    let entry = L.block(child.b)
    L.into(child.b, entry)
    -- The environment comes first and is not the closure: the callee is handed
    -- what the closure's second slot holds, which is why a capture is read
    -- with an ordinary `ObjectGet` of an object the parent built. The
    -- asymmetry is the runtime's -- the parent has the closure and the child
    -- has the environment -- and not this IR's.
    let environment = Ssa.freshValue(g, Ssa.traced(Ptr))
    Vec.push(g.params, environment)
    -- The `unit` locals `capturesOf` leaves out of the environment, made here
    -- instead, in the order the body first mentions them.
    for local in Core.references(body) {
        match lookup(l, local) {
            Some(v) -> if Ssa.repOf(l.func, v).class_ == Unit {
                put(child, local, L.emit(child.b, ConstUnit, Ssa.untraced(Unit)))
            }
            None -> {}
        }
    }
    let taken : Vec Value = []
    for p in params {
        let v = Ssa.freshValue(g, repOf(l, p.ty))
        Vec.push(g.params, v)
        Vec.push(taken, v)
    }
    let held = environmentLayout(captures)
    let firsts = environmentFirsts(captures)
    for var i = 0; i < len(captures); i = i + 1 {
        let (local, layout) = captures[i]
        let values = Array.init(len(layout.slots), fun(k) =
            L.emit(child.b, ObjectGet(environment, L.fieldRef(held, firsts[i] + k)),
                   layout.slots[k]))
        put(child, local, fromSlots(child, layout, values))
    }
    for var i = 0; i < len(params) && i < len(taken); i = i + 1 {
        let layout = heldOf(l, params[i].ty)
        Map.put(child.env, idOf(params[i].name, params[i].id),
                fromStored(child, layout, coerce(child, taken[i], Layout.storedRep(layout))))
    }
    prepareLocals(child, body)
    lower(child, body, ToReturn)
    match child.stopped {
        Some(why) -> {
            halt(l, why, child.overLimit)
            None
        }
        None -> {
            Vec.push(l.lifted, g)
            Some(symbol)
        }
    }
}

-- A closure and its environment, built with every capture this body holds.
--
-- An environment is an object of kind 4, laid out from its captures'
-- representations as any object is (`environmentLayout`). A capture named in
-- `later` is a sibling in a recursive group that does not exist yet: its slot
-- starts null, which the collector skips, and is marked mutable, and `letrec`
-- writes it with `ClosureCapture` once every shell exists.
fun closureShell(l : Lower, symbol : String, captures : Vec (Ref, Ssa.Layout),
                 later : Set.Set Int) -> Value {
    if len(captures) == 0 {
        return L.emit(l.b, ClosureNew(symbol, None), Ssa.traced(Ptr))
    }
    var mutable = 0
    let values = []
    for (local, layout) in captures {
        if isSibling(later, local) {
            mutable = mutable | 1 << len(values)
            for r in layout.slots { Vec.push(values, storageZero(l, r)) }
        } else {
            match lookup(l, local) {
                Some(v) -> for x in slotsOf(l, v, layout) { Vec.push(values, x) }
                None -> {
                    for r in layout.slots { Vec.push(values, storageZero(l, r)) }
                    let _ = stop(l, "a capture of a local not in scope")
                }
            }
        }
    }
    let environment = L.emit(l.b, ObjectNew(4, -1, environmentLayout(captures),
                                            Vec.toArray(values), mutable),
                             Ssa.traced(Ptr))
    L.emit(l.b, ClosureNew(symbol, Some(environment)), Ssa.traced(Ptr))
}

-- The layout of an environment holding these captures, which the parent
-- builds and writes and the child reads. A capture of several slots takes one
-- field per slot: the environment is private to the two of them, so it need
-- not hold the capture boxed, as a memory position every copy reads must.
fun environmentLayout(captures : Vec (Ref, Ssa.Layout)) -> Rt.Layout =
    Rt.layout(environmentReps(captures))

fun environmentReps(captures : Vec (Ref, Ssa.Layout)) -> Array Rep {
    let out = []
    for (_, layout) in captures { for r in layout.slots { Vec.push(out, r) } }
    Vec.toArray(out)
}

-- The environment field each capture's first slot is in.
fun environmentFirsts(captures : Vec (Ref, Ssa.Layout)) -> Array Int {
    var at = 0
    Array.map(Vec.toArray(captures), fun(c) {
        let first = at
        at = at + len(c.1.slots)
        first
    })
}

-- Whether `local` is one of the recursive group's `siblings`.
fun isSibling(siblings : Set.Set Int, local : Ref) -> Bool = match local {
    ById(id) -> Set.contains(siblings, id)
    BySpelling(_) -> False
}

-- A lambda in value position: lift it, then build the closure.
fun lambda(l : Lower, params : Array CParam, body : Core, result : Ty.Type) -> Value {
    let captures = capturesOf(l, body, Set.new())
    match lift(l, params, body, result, captures) {
        Some(symbol) -> closureShell(l, symbol, captures, Set.new())
        None -> Ssa.freshValue(l.func, Ssa.untraced(Unit))
    }
}

-- Recursive closures, shells first.
--
-- Each lambda may mention its siblings and itself, and the closure it would
-- capture does not exist while it is being lifted. `backend_lower.py` breaks
-- that with a slot per binding, put into the environment before any lifting:
-- the slot exists and the closure fills it later. Here no slot is needed --
-- what has to be known before the lift is a capture's *representation*, and a
-- closure is a traced pointer whether or not it has been allocated yet. So the
-- shells are made first, the names are bound to them, and the captures of
-- siblings are written afterwards, when every sibling is a value that dominates
-- its store.
fun letrec(l : Lower, binds : Vec CBind, body : Core, dest : Dest) -> Unit {
    let siblings = Set.new()
    for bind in binds {
        match spine(bind.value) {
            Some(_) -> Set.add(siblings, idOf(bind.name, bind.id))
            None -> {
                -- Up front, so nothing is half emitted.
                let _ = stop(l, "a recursive binding that is not a function")
                return
            }
        }
    }
    let plans = []
    for bind in binds {
        let shape = spine(bind.value)
        let params = match shape {
            Some((ps, _)) -> ps
            None -> []
        }
        let inner = match shape {
            Some((_, b)) -> b
            None -> bind.value
        }
        let captures = capturesOf(l, inner, siblings)
        match lift(l, params, inner, resultType(bind.ty), captures) {
            Some(symbol) -> Vec.push(plans, (bind.id, symbol, captures))
            None -> return
        }
    }
    -- Every shell exists before a sibling is written into one. Everything
    -- else a shell captures is in scope already, and is built into it.
    let shells = []
    for (_, symbol, captures) in plans {
        Vec.push(shells, closureShell(l, symbol, captures, siblings))
    }
    for var i = 0; i < len(plans) && i < len(shells); i = i + 1 {
        Map.put(l.env, plans[i].0, shells[i])
    }
    for var i = 0; i < len(plans) && i < len(shells); i = i + 1 {
        let (_, _, captures) = plans[i]
        let firsts = environmentFirsts(captures)
        for var j = 0; j < len(captures); j = j + 1 {
            if isSibling(siblings, captures[j].0) {
                match lookup(l, captures[j].0) {
                    Some(v) -> L.effect(l.b, ClosureCapture(shells[i],
                        L.fieldRef(environmentLayout(captures), firsts[j]), v))
                    None -> {}
                }
            }
        }
    }
    lower(l, body, dest)
}

fun arrayLiteral(l : Lower, e : Core, elems : Array Core) -> Value {
    let (_, args) = Ty.spine(Ty.prune(e.ty))
    let element = if len(args) > 0 { repOf(l, args[0]) } else { Ssa.traced(Ptr) }
    let values = storedAll(l, Array.map(elems, value(l, _)))
    let length = L.emit(l.b, ConstInt(len(values)), Ssa.untraced(I64))
    -- `ArrayNew` wants something to fill with. An array with elements is
    -- filled over anyway, and an empty one has no slot to read, so a zero of
    -- the element's own representation is enough in both cases.
    let initial = if len(values) > 0 { values[0] }
                  else { storageZero(l, element) }
    let made = L.emit(l.b, ArrayNew(length, initial, element),
                      Ssa.traced(Ptr))
    for var i = 1; i < len(values); i = i + 1 {
        let at = L.emit(l.b, ConstInt(i), Ssa.untraced(I64))
        L.effect(l.b, ArraySet(made, at, values[i], Checked))
    }
    made
}

-- What a slot holds before it is written: an array's fill, a placeholder
-- global's fields, a recursive closure's sibling captures. A pointer slot is
-- null rather than an allocated box of integer zero -- this is storage
-- initialization, not a generic scalar value, and it must not allocate.
fun storageZero(l : Lower, r : Rep) -> Value =
    if r.class_ == Ptr { L.emit(l.b, ConstInt(0), r) }
    else { zero(l, r) }

fun zero(l : Lower, r : Rep) -> Value = match r.class_ {
    Unit -> L.emit(l.b, ConstUnit, r)
    F64 -> L.emit(l.b, ConstFloat(0.0), r)
    -- A null word, which the collector skips as an immediate.
    Ptr -> L.emit(l.b, ConstInt(0), r)
    _ -> L.emit(l.b, ConstInt(0), r)
}

-- -- compact sums ----------------------------------------------------------------------

-- A compact sum (`Decls.Compact`) whose payload field is held at a traced
-- pointer *at this instantiation* is one word, and nothing is allocated for it:
--
-- * the nullaries are the small integers 0, 1, ... in declaration order;
-- * the payload constructor is the field itself -- `Some(p)` is `p` -- **unless**
--   that word is below `Heap.immediates` or is itself a wrap (an object tagged
--   `wrapTag`). Then it is a fresh one-field wrap around it. So `Some(None)` is
--   a wrap around 0, and a word at or above `Heap.immediates` that is not a
--   wrap is always the bare payload.
--
-- A payload of several slots counts as a traced pointer, since memory holds it
-- as its box. At any other payload representation -- `Option Int` -- the sum is
-- flat, or an ordinary object if it is too wide, as a sum that is not compact
-- is. So which a value is depends on the instantiation, and building or
-- testing one needs the payload's layout: `Turkey.Layout` gives every body
-- that does so at a type variable a layout-keyed copy, and `compactAt` refuses
-- where there is none.
--
-- The word is a function of the *value*, not of the code building it, so ground
-- code, a type-specialized copy and a layout-shared copy agree without knowing
-- about each other. A test is: below the nullary count, the word is that
-- nullary; otherwise it is the payload constructor, and its field is the wrap's
-- field if it is a wrap and the word itself if not. Comparisons are signed,
-- which is exact because a heap address is below 2^47.
--
-- The wrap test reads the tag of an arbitrary traced pointer, which is sound
-- because every value a type variable can stand for has an object header: the
-- one headerless heap value is a `var`'s cell, whose type `%Ref t` is internal
-- and never instantiates a variable.

-- The tag of a wrap object. Declared constructors are numbered from 0 by
-- `tagsOf`, and tuples and closures carry -1.
let wrapTag = -2

-- A wrap holds the one nested value.
let wrapLayout = Rt.layout([Ssa.traced(Ptr)])

-- The compact shape `name`'s type has, if it is one word at `ty`: by the
-- payload's layout, which every body knows (`repIn`).
fun compactAt(l : Lower, name : String, ty : Ty.Type) -> Option Compact {
    let c = match Decls.compactOf(l.decls, name) {
        Some(c) -> c
        None -> return None
    }
    if repOf(l, compactField(l, c, ty)) == Ssa.traced(Ptr) { Some(c) } else { None }
}

-- The payload constructor's field type, at `ty`.
fun compactField(l : Lower, c : Compact, ty : Ty.Type) -> Ty.Type =
    match Decls.conFieldTypes(l.decls, ty, c.payload) {
        Some(ts) -> if len(ts) == 1 { ts[0] } else { Ty.tUnit() }
        None -> Ty.tUnit()
    }

-- Whether values of `ty` are certainly neither below `Heap.immediates` nor
-- wraps, so the payload constructor over one needs no test. A record, tuple,
-- closure, array or any sum that is neither compact-shaped nor an enumeration
-- is an ordinary object.
-- A variable is not known to be, and a compact sum's own values may be small
-- integers or wraps.
fun plain(l : Lower, ty : Ty.Type) -> Bool {
    let t = Ty.prune(ty)
    match Decls.erasedPayload(l.decls, t) {
        Some(payload) -> return plain(l, payload)
        None -> {}
    }
    -- A flat value of several slots is held as its box, an ordinary object. One
    -- of one slot is that slot, which may be anything.
    match flatHere(l, t) {
        Some(f) -> return len(f.slots) > 1
        None -> {}
    }
    match t {
        TTuple(_) -> return True
        TFun(_, _) -> return True
        _ -> {}
    }
    let (h, _) = Ty.spine(t)
    match h {
        TCon(c) -> c.uid == 0 && Option.isNone(Decls.compactShape(l.decls, c.name))
                   && Option.isNone(Decls.enumSize(l.decls, c.name))
        _ -> False
    }
}

-- A one-word compact sum's constructor applied to `args`.
fun compactValue(l : Lower, c : Compact, name : String, ty : Ty.Type,
                 args : Array Core) -> Value {
    match Vec.indexOf(c.nullaries, name) {
        Some(i) -> return L.emit(l.b, ConstInt(i), Ssa.traced(Ptr))
        None -> {}
    }
    if len(args) != 1 {
        return stop(l, "the constructor '" + name + "' must be saturated")
    }
    let x = coerce(l, value(l, args[0]), Ssa.traced(Ptr))
    if plain(l, compactField(l, c, ty)) { return x }
    let wrap = L.block(l.b)
    let tagged = L.block(l.b)
    let as_ = L.block(l.b)
    let after = L.block(l.b)
    let made = L.param(l.b, after, Ssa.traced(Ptr))
    -- `<=` the largest immediate rather than `<` the bound: a traced register
    -- may hold an immediate, and the bound itself is neither that nor a
    -- pointer.
    let limit = L.emit(l.b, ConstInt(Rt.immediates - 1), Ssa.traced(Ptr))
    let small = L.emit(l.b, Cmp(Le, x, limit), Ssa.untraced(I1))
    L.terminate(l.b, Branch(small, wrap, tagged))
    L.into(l.b, tagged)
    let seen = L.emit(l.b, ObjectTag(x), Ssa.untraced(I32))
    let want = L.emit(l.b, ConstInt(wrapTag), Ssa.untraced(I32))
    let isWrap = L.emit(l.b, Cmp(Eq, seen, want), Ssa.untraced(I1))
    L.terminate(l.b, Branch(isWrap, wrap, as_))
    L.into(l.b, as_)
    L.terminate(l.b, Jump(after, [x]))
    L.into(l.b, wrap)
    let object = L.emit(l.b, ObjectNew(1, wrapTag, wrapLayout, [x], 0),
                        Ssa.traced(Ptr))
    Map.put(l.func.reasons, Ssa.valueId(object),
            "wraps a nested value in " + Ty.shortName(name))
    L.terminate(l.b, Jump(after, [object]))
    L.into(l.b, after)
    made
}

-- A constructor on a one-word compact sum: the word test, then the payload,
-- read only if the arm binds it.
fun compactTest(l : Lower, c : Compact, name : String, binders : Array (Option (String, Int)),
                v : Value, ty : Ty.Type,
                success : BlockId, failure : BlockId) -> Unit {
    match Vec.indexOf(c.nullaries, name) {
        Some(i) -> {
            let want = L.emit(l.b, ConstInt(i), Ssa.traced(Ptr))
            let test = L.emit(l.b, Cmp(Eq, v, want), Ssa.untraced(I1))
            L.terminate(l.b, Branch(test, success, failure))
            return
        }
        None -> {}
    }
    let count = L.emit(l.b, ConstInt(len(c.nullaries)), Ssa.traced(Ptr))
    let nullary = L.emit(l.b, Cmp(Lt, v, count), Ssa.untraced(I1))
    let carried = L.block(l.b)
    L.terminate(l.b, Branch(nullary, failure, carried))
    L.into(l.b, carried)
    compactPayload(l, c, binders, v, ty)
    L.terminate(l.b, Jump(success, []))
}

-- A compact sum's payload, known to be there, bound if the arm binds it: the
-- word itself, or the field of the wrap it is.
fun compactPayload(l : Lower, c : Compact, binders : Array (Option (String, Int)), v : Value,
                   ty : Ty.Type) -> Unit {
    let binder = if len(binders) == 1 { binders[0] } else { None }
    let bound = match binder {
        Some((name, id)) -> idOf(name, id)
        None -> return
    }
    let field = compactField(l, c, ty)
    let inner = if plain(l, field) { v } else {
        let wrapped = L.block(l.b)
        let as_ = L.block(l.b)
        let after = L.block(l.b)
        let got = L.param(l.b, after, Ssa.traced(Ptr))
        let seen = L.emit(l.b, ObjectTag(v), Ssa.untraced(I32))
        let want = L.emit(l.b, ConstInt(wrapTag), Ssa.untraced(I32))
        let isWrap = L.emit(l.b, Cmp(Eq, seen, want), Ssa.untraced(I1))
        L.terminate(l.b, Branch(isWrap, wrapped, as_))
        L.into(l.b, wrapped)
        L.terminate(l.b, Jump(after, [L.emit(l.b, ObjectGet(v, L.fieldRef(wrapLayout, 0)),
                                             Ssa.traced(Ptr))]))
        L.into(l.b, as_)
        L.terminate(l.b, Jump(after, [v]))
        L.into(l.b, after)
        got
    }
    Map.put(l.env, bound, fromStored(l, heldOf(l, field), inner))
}

-- An enumeration's constructor: its index, at the width its type is held at
-- (`Decls.enumSize`). An enumeration of one constructor is held at no width.
fun enumValue(l : Lower, index : Int, rep : Rep) -> Value =
    if rep.class_ == Unit { L.emit(l.b, ConstUnit, rep) }
    else { L.emit(l.b, ConstInt(index), rep) }

-- A saturated constructor. A nullary one that is neither an enumeration's nor a
-- one-word compact sum's is an object with no fields, interned per (kind, tag)
-- rather than allocated at each use.
fun constructor(l : Lower, e : Core, name : String, args : Array Core,
                rep : Rep) -> Value {
    match Decls.enumIndex(l.decls, name) {
        Some(i) -> return enumValue(l, i, repOf(l, e.ty))
        None -> {}
    }
    match Decls.erasedPayload(l.decls, e.ty) {
        Some(_) -> if len(args) == 1 { return value(l, args[0]) }
        None -> {}
    }
    match compactAt(l, name, e.ty) {
        Some(c) -> return compactValue(l, c, name, e.ty, args)
        None -> {}
    }
    match flatHere(l, e.ty) {
        Some(f) -> {
            let k = if len(f.names) == 0 { 0 } else {
                match Array.indexOf(f.names, name) {
                    Some(i) -> i
                    None -> return stop(l, "the constructor '" + name + "' is not one of "
                                           + Ty.show(e.ty) + "'s")
                }
            }
            return flatValue(l, f, heldOf(l, e.ty), k, args)
        }
        None -> {}
    }
    match Map.get(l.tags, name) {
        Some(tag) -> match Decls.con(l.decls, name) {
            Some(info) -> if len(info.exists) > 0 {
                packed(l, info, name, args, tag)
            } else {
                aggregate(l, args, 1, tag, mutableMask(l, name, len(args)),
                          "builds a value with " + Ty.shortName(name),
                          fieldsOf("constructor '" + Ty.shortName(name) + "'"))
            }
            None -> aggregate(l, args, 1, tag, mutableMask(l, name, len(args)),
                              "builds a value with " + Ty.shortName(name),
                              fieldsOf("constructor '" + Ty.shortName(name) + "'"))
        }
        None -> stop(l, "the constructor '" + name + "' has no tag")
    }
}

-- A value of a flat type built with its `k`th constructor (the only one, for a
-- product) from `args`: each field's slots where `Layout.Flat` puts them, a
-- sum's tag, and zero in every slot this constructor does not use.
fun flatValue(l : Lower, f : Layout.Flat, held : Ssa.Layout, k : Int,
              args : Array Core) -> Value {
    let fields = f.fields[k]
    if len(args) != len(fields) {
        return stop(l, "a flat value of " + Int.toString(len(fields)) + " fields built from "
                       + Int.toString(len(args)))
    }
    let values = Array.map(args, value(l, _))
    let slots = Array.map(f.slots, storageZero(l, _))
    if len(f.names) > 0 { slots[0] = enumValue(l, k, f.slots[0]) }
    for var i = 0; i < len(fields); i = i + 1 {
        let at = fields[i]
        let parts = slotsOf(l, values[i], Ssa.Layout { slots = Array.map(at, fun(j) = f.slots[j]) })
        for var j = 0; j < len(at); j = j + 1 { slots[at[j]] = parts[j] }
    }
    fromSlots(l, held, slots)
}

-- The refusal of a tuple or constructed value too wide to build, in the
-- parser's words: it refuses the ones a program declares.
fun fieldsOf(subject : String) -> fun(Int) -> String =
    fun(n) = subject + " has " + Int.toString(n) + " fields, and a value can have at most "
             + Int.toString(Rt.fieldLimit)

-- A packed existential: the index of its hidden variables' layouts in the
-- table of keys the constructor is packed at, then the carried dictionaries,
-- then the fields. The index is what an opening compares against the one its
-- arm's copy was lowered for.
--
-- The opening reads the index before it knows the key, so the index is where
-- no key moves it: the first traced word, at the same offset whatever the
-- fields' representations. An untraced index would follow every traced field,
-- at an offset the key decides. It is an immediate, below `Rt.immediates`,
-- which the collector skips as it does a compact sum's nullaries.
fun packed(l : Lower, info : ConInfo, name : String, args : Array Core,
           tag : Int) -> Value {
    let parts = match Layout.packedKeyParts(l.decls, info, args, l.layouts) {
        Some(ps) -> ps
        None -> return stop(l, "packing '" + name
                            + "' at a layout that is not knowable here")
    }
    -- Nothing reads the index of a constructor nothing opens.
    let index = if !Layout.isOpened(l.decls, name) { 0 } else {
        match Layout.packingIndex(l.decls, name, parts) {
            Some(i) -> i
            None -> return stop(l, "packing '" + name + "' at " + Ssa.keyName(parts)
                                + ", which is not in its table")
        }
    }
    let refusal = fun(n) = "constructor '" + Ty.shortName(name) + "' needs " + Int.toString(n)
        + " fields, counting one for its hidden types and one for each constraint, and a "
        + "value can have at most " + Int.toString(Rt.fieldLimit)
        + "; move some fields into a record"
    if wide(l, 1 + len(args), refusal) {
        return Ssa.freshValue(l.func, Ssa.traced(Ptr))
    }
    if index >= Rt.immediates {
        refuse(l, "constructor '" + Ty.shortName(name) + "' hides values of "
                  + Int.toString(Layout.packingCount(l.decls, name)) + " different layouts, "
                  + "and a constructor can hide at most " + Int.toString(Rt.immediates))
        return Ssa.freshValue(l.func, Ssa.traced(Ptr))
    }
    let values = Array.init(1 + len(args), fun(i) =
        if i == 0 {
            L.emit(l.b, ConstInt(index), Ssa.traced(Ptr))
        } else {
            value(l, args[i - 1])
        })
    built(l, 1, tag, values, 0, "packs an existential, " + Ty.shortName(name))
}

fun literal(l : Lower, lit : Lit, rep : Rep) -> Value = match lit {
    -- An integer literal at a float representation is an integer literal
    -- whose *type* is `Float` -- `1` where `1.0` was meant, which the surface
    -- language accepts. The constant has to become a float here, because
    -- `ConstInt` at `f64` is not a thing a machine has and every backend
    -- below would have to invent the same conversion.
    LInt(n) -> if rep.class_ == F64 {
        L.emit(l.b, ConstFloat(Float.fromInt(n)), rep)
    } else {
        scalar(l, ConstInt(n), Ssa.untraced(I64), rep)
    }
    LFloat(x) -> scalar(l, ConstFloat(x), Ssa.untraced(F64), rep)
    LString(s) -> L.emit(l.b, ConstString(s), Ssa.traced(Ptr))
    LChar(c) -> scalar(l, ConstInt(Char.toInt(c)), Ssa.untraced(I64), rep)
}

-- A scalar constant at the representation the context asked for.
--
-- A pointer-shaped context is refused by `coerce` rather than given the
-- constant as a pointer: a literal's layout is its type's, and a context that
-- disagrees is a compiler bug, which a scalar in a traced slot would make
-- silent until the collector followed it.
fun scalar(l : Lower, op : Op, natural : Rep, rep : Rep) -> Value =
    if rep.class_ == Ptr { coerce(l, L.emit(l.b, op, natural), rep) }
    else { L.emit(l.b, op, rep) }

-- A call. The callee decides which of three shapes it is, and the arguments
-- are lowered left to right in every one, because a call's arguments are
-- evaluated in that order and this is the phase where that stops being
-- implicit.
fun call(l : Lower, e : Core, fn : Core, args : Array Core, rep : Rep) -> Value {
    match fn.kind {
        CPrim(p) -> primitive(l, e, p, args, rep)
        CVar(BySpelling(name)) -> if Map.contains(l.decls.foreigns, name) {
            -- A declared C symbol. Everything a runtime call needs
            -- and nothing more: no marshalling, because the type mapping is
            -- the seven types that each erase to one representation, and no
            -- coercion, because the declaration fixed every one of them.
            let supplied = Array.map(args, value(l, _))
            let callee = match Map.get(l.decls.foreigns, name) {
                Some(info) -> Foreign(info.symbol, info.fixed)
                None -> Foreign(name, len(supplied))
            }
            L.emit(l.b, Call(callee, supplied), rep)
        } else {
            -- The signature table and not `l.globals` is the test. A global
            -- may hold a *closure* -- the initializer computed it -- and
            -- calling it as a symbol would jump to a heap address. Having an
            -- entry is what makes a name a function.
            match Map.get(l.sigs, name) {
                Some(sig) -> if len(args) == len(sig.params) {
                    directCall(l, name, sig, args, rep)
                } else {
                    -- Core saturates its calls, so this is a partial
                    -- application and wants a closure that supplies the rest.
                    -- Nothing builds one, and saying so beats calling with the
                    -- wrong arity.
                    stop(l, "a partial application of '" + name + "'")
                }
                None -> closureCall(l, fn, args, rep)
            }
        }
        CCon(name) -> constructor(l, e, name, args, rep)
        CTyApp(_, _) -> call(l, e, Core.mkCore(fn.ty, fn.span, erased(fn).kind), args, rep)
        CTyLam(_, _) -> call(l, e, Core.mkCore(fn.ty, fn.span, erased(fn).kind), args, rep)
        -- Anything else evaluates to a function *value*, which is a closure:
        -- a method out of a dictionary (`CSlot`), the result of another call,
        -- a field of a record. That is the common shape in this language --
        -- every method call is one -- and there is nothing to decide, because
        -- a value that is not a known symbol is reached the only way a value
        -- can be.
        _ -> closureCall(l, fn, args, rep)
    }
}

fun definesSymbol(decls : DeclTable, symbol : String) -> Bool {
    for (_, info) in Map.entries(decls.definitions) {
        if info.symbol == symbol { return True }
    }
    False
}

-- A call to a known top-level function, at *its* representations.
--
-- The arguments are coerced to the callee's signature and the result back from
-- it. `turkey/backend_lower.py` does the same with the callee's own abstracted
-- layouts, and its comment is the reason: a layout-shared copy holds its
-- parameters at the layouts its key names, so a caller reading them off its
-- own scheme would pass a value at a layout the copy does not hold it at.
fun directCall(l : Lower, name : String, sig : Signature, args : Array Core,
               rep : Rep) -> Value {
    let supplied = [L.emit(l.b, ConstInt(0), Ssa.traced(Ptr))]
    for var i = 0; i < len(args); i = i + 1 {
        let v = value(l, args[i])
        let reps = sig.params[i]
        if len(reps) == 1 {
            Vec.push(supplied, coerce(l, v, reps[0]))
        } else {
            let slots = slotsOf(l, v, Ssa.Layout { slots = reps })
            for var k = 0; k < len(slots); k = k + 1 {
                Vec.push(supplied, coerce(l, slots[k], reps[k]))
            }
        }
    }
    let first = L.emit(l.b, Call(Direct(name), Vec.toArray(supplied)), sig.results[0])
    if len(sig.results) == 1 { return coerce(l, first, rep) }
    -- Every result is read right after the call, in the order the callee
    -- answers them (`Result`), whether or not anything uses it: an unused one
    -- is deleted later, and a use that wants the value boxed builds the box.
    let results = Array.init(len(sig.results), fun(k) =
        if k == 0 { first } else { L.emit(l.b, Result(first, k), sig.results[k]) })
    newMulti(l, Slots(Ssa.Layout { slots = sig.results }, results))
}

-- The closure operand's function type defines the ABI at every call site.
-- Scalars stay raw and pointer parameters remain traced, including while
-- later arguments allocate. Layout-shared bodies use their layout mapping.
fun closureCall(l : Lower, fn : Core, args : Array Core, rep : Rep) -> Value {
    -- The callee before the arguments: Core evaluates it first, and this is
    -- the phase where that stops being implicit.
    let closure = value(l, fn)
    match Ty.prune(fn.ty) {
        TFun(params, result) -> {
            let supplied = Array.init(len(args), fun(i) =
                coerce(l, value(l, args[i]), repOf(l, params[i])))
            coerce(l, L.emit(l.b, Call(Indirect(closure), supplied),
                repOf(l, result)), rep)
        }
        _ -> stop(l, "a closure without a function type")
    }
}

-- Past the type abstraction and application, which have no run-time content.
fun erased(e : Core) -> Core = match e.kind {
    CTyApp(inner, _) -> erased(inner)
    CTyLam(_, inner) -> erased(inner)
    _ -> e
}

-- A compiler bug rather than a program that is wrong: top-level names are
-- module-qualified, so nothing a user writes can collide.
fun oops(message : String) -> a =
    Diag.fail(Diag.whole("internal error", message), "")

-- A primitive call, one arm per primitive and no fallback: a primitive added to
-- `Turkey.Prims` does not compile until it is given a lowering here.
--
-- Each arm lowers its own operands, left to right and all of them before the
-- operation, because two of them take a literal the compiler lays out as static
-- data rather than a value, and read it before it could become one.
fun primitive(l : Lower, e : Core, p : Prims.Prim, args : Array Core,
              rep : Rep) -> Value = match p {
    -- `error` does not answer; it leaves. Terminating here and then moving
    -- into a fresh block keeps the walk uniform -- whatever the caller emits
    -- next is well formed and unreachable, and the verifier says nothing
    -- about unreachable code on purpose.
    Prims.Error -> {
        let xs = operands(l, p, args, 1)
        L.terminate(l.b, Panic(xs[0]))
        L.into(l.b, L.block(l.b))
        zero(l, rep)
    }
    Prims.Exit -> L.emit(l.b, Call(Runtime(Rt.Exit), operands(l, p, args, 1)), rep)
    Prims.SwapStack ->
        L.emit(l.b, Call(Runtime(Rt.SwapStack), operands(l, p, args, 2)), rep)
    -- Pointer arithmetic. An address is an integer held at another
    -- class, so all of this is ordinary integer work with a conversion at
    -- each end -- which is also why none of it is a runtime call, and why no
    -- constant and no comparison is ever held at the `Ptr` class.
    --
    -- Wrapping, not checked: `AddWrap` and `SubWrap`. An address near the top
    -- of the space is not an overflow and must not panic, and the language's
    -- trapping `+` is not what is being spelled here.
    Prims.PtrAdd -> {
        let xs = operands(l, p, args, 2)
        let base = L.emit(l.b, Convert(PtrToInt, xs[0]), Ssa.untraced(I64))
        let sum = L.emit(l.b, Bin(AddWrap, base, xs[1]), Ssa.untraced(I64))
        L.emit(l.b, Convert(IntToPtr, sum), Ssa.untraced(Ptr))
    }
    Prims.PtrDiff -> {
        let xs = operands(l, p, args, 2)
        let a = L.emit(l.b, Convert(PtrToInt, xs[0]), Ssa.untraced(I64))
        let b = L.emit(l.b, Convert(PtrToInt, xs[1]), Ssa.untraced(I64))
        L.emit(l.b, Bin(SubWrap, a, b), Ssa.untraced(I64))
    }
    Prims.PtrNull -> {
        noOperands(l, p, args)
        let zero_ = L.emit(l.b, ConstInt(0), Ssa.untraced(I64))
        L.emit(l.b, Convert(IntToPtr, zero_), Ssa.untraced(Ptr))
    }
    Prims.PtrIsNull -> {
        let xs = operands(l, p, args, 1)
        let a = L.emit(l.b, Convert(PtrToInt, xs[0]), Ssa.untraced(I64))
        let zero_ = L.emit(l.b, ConstInt(0), Ssa.untraced(I64))
        L.emit(l.b, Cmp(Eq, a, zero_), Ssa.untraced(I1))
    }
    -- Both operands are already at one representation, so this needs no
    -- conversion the way the rest of the pointer work does.
    Prims.PtrEq -> primCompare(l, p, args, Eq)
    Prims.PtrToInt -> L.emit(l.b, Convert(PtrToInt, operands(l, p, args, 1)[0]),
                             Ssa.untraced(I64))
    Prims.PtrFromInt -> L.emit(l.b, Convert(IntToPtr, operands(l, p, args, 1)[0]),
                               Ssa.untraced(Ptr))
    -- The array's address, no longer one the collector follows, past its
    -- header and `i` elements at the stride its element is stored at.
    Prims.ElementAddress -> {
        let xs = operands(l, p, args, 2)
        let (_, held) = Ty.spine(Ty.prune(args[0].ty))
        if len(held) != 1 { return stop(l, "the element address of a non-array") }
        let element = repOf(l, held[0])
        let base = L.emit(l.b, Convert(PtrToInt, L.emit(l.b, Convert(Retag, xs[0]),
                                                        Ssa.untraced(Ptr))),
                          Ssa.untraced(I64))
        let width = L.emit(l.b, ConstInt(Rt.elementWidth(element.class_)), Ssa.untraced(I64))
        let skipped = L.emit(l.b, Bin(MulWrap, xs[1], width), Ssa.untraced(I64))
        let header = L.emit(l.b, ConstInt(Rt.arrayElements), Ssa.untraced(I64))
        let at = L.emit(l.b, Bin(AddWrap, L.emit(l.b, Bin(AddWrap, base, header),
                                                 Ssa.untraced(I64)), skipped),
                        Ssa.untraced(I64))
        L.emit(l.b, Convert(IntToPtr, at), Ssa.untraced(Ptr))
    }
    Prims.KeepAlive -> {
        L.effect(l.b, KeepAlive(operands(l, p, args, 1)[0]))
        L.emit(l.b, ConstUnit, Ssa.untraced(Unit))
    }
    Prims.CString -> match literalArgument(args) {
        Some(text) -> L.emit(l.b, Address(CBytes(text)), Ssa.untraced(Ptr))
        None -> stop(l, "Prim.cString takes a string literal")
    }
    Prims.CodeAddress -> match literalArgument(args) {
        Some(symbol) -> if definesSymbol(l.decls, symbol) || Rt.emitsSymbol(symbol) {
            L.emit(l.b, Address(CodeOf(symbol)), Ssa.untraced(Ptr))
        } else {
            stop(l, "Prim.codeAddress(\"" + symbol + "\") names no foreign "
                    + "definition in this program")
        }
        None -> stop(l, "Prim.codeAddress takes a string literal")
    }
    Prims.FrameAddress -> {
        noOperands(l, p, args)
        L.emit(l.b, Address(ThisFrame), Ssa.untraced(Ptr))
    }
    Prims.ProcessState -> {
        noOperands(l, p, args)
        L.emit(l.b, Address(ProcessState), Ssa.untraced(Ptr))
    }
    -- Raw load and store, one primitive per representation. The primitive
    -- carries the class because the IR attaches a `Rep` to every value when
    -- it is emitted: a load whose width were known only at run time would
    -- have no result representation for the register allocator or for
    -- `Turkey.Roots`, which is why the floor is twelve primitives and the
    -- single `load` lives in `lib/Turkey/Ptr.gob` as a class instead.
    Prims.LoadI1 -> rawLoad(l, p, args, I1)
    Prims.LoadI8 -> rawLoad(l, p, args, I8)
    Prims.LoadI32 -> rawLoad(l, p, args, I32)
    Prims.LoadI64 -> rawLoad(l, p, args, I64)
    Prims.LoadF64 -> rawLoad(l, p, args, F64)
    Prims.LoadPtr -> rawLoad(l, p, args, Ptr)
    Prims.StoreI1 -> rawStore(l, p, args, I1)
    Prims.StoreI8 -> rawStore(l, p, args, I8)
    Prims.StoreI32 -> rawStore(l, p, args, I32)
    Prims.StoreI64 -> rawStore(l, p, args, I64)
    Prims.StoreF64 -> rawStore(l, p, args, F64)
    Prims.StorePtr -> rawStore(l, p, args, Ptr)
    -- Loops rather than calls, so that `Turkey.Polls` gives them their polls
    -- (`Turkey.Bulk`).
    Prims.CopyBytes -> {
        let xs = operands(l, p, args, 3)
        Bulk.copyBytes(l.b, xs[0], xs[1], xs[2])
        L.emit(l.b, ConstUnit, Ssa.untraced(Unit))
    }
    Prims.FillBytes -> {
        let xs = operands(l, p, args, 3)
        Bulk.fillBytes(l.b, xs[0], xs[1], xs[2])
        L.emit(l.b, ConstUnit, Ssa.untraced(Unit))
    }
    Prims.AtomicCas -> L.emit(l.b, Atomic(Cas, operands(l, p, args, 4)), Ssa.untraced(I64))
    Prims.AtomicAdd ->
        L.emit(l.b, Atomic(FetchAdd, operands(l, p, args, 3)), Ssa.untraced(I64))
    Prims.AtomicLoad ->
        L.emit(l.b, Atomic(LoadAcquire, operands(l, p, args, 2)), Ssa.untraced(I64))
    Prims.AtomicStore -> {
        L.effect(l.b, Atomic(StoreRelease, operands(l, p, args, 3)))
        L.emit(l.b, ConstUnit, Ssa.untraced(Unit))
    }
    -- A `Prim.Atomic` is a cell (`CellNew`) holding an `Int`, which the
    -- collector does not follow, and every access is an atomic one at the
    -- cell's value (`Rt.cellValue`). The cell itself is the base, a traced
    -- operand, so it is live and rooted across the access like any other.
    Prims.AtomicNew -> L.emit(l.b, CellNew(operands(l, p, args, 1)[0]), Ssa.traced(Ptr))
    Prims.AtomicGet -> {
        let xs = operands(l, p, args, 1)
        L.emit(l.b, Atomic(LoadAcquire, [xs[0], cellValue(l)]), Ssa.untraced(I64))
    }
    Prims.AtomicSet -> {
        let xs = operands(l, p, args, 2)
        L.effect(l.b, Atomic(StoreRelease, [xs[0], cellValue(l), xs[1]]))
        L.emit(l.b, ConstUnit, Ssa.untraced(Unit))
    }
    Prims.AtomicAddTo -> {
        let xs = operands(l, p, args, 2)
        L.emit(l.b, Atomic(FetchAdd, [xs[0], cellValue(l), xs[1]]), Ssa.untraced(I64))
    }
    Prims.AtomicSwapIf -> {
        let xs = operands(l, p, args, 3)
        L.emit(l.b, Atomic(Cas, [xs[0], cellValue(l), xs[1], xs[2]]), Ssa.untraced(I64))
    }
    -- The array operations are instructions rather than runtime calls: the
    -- element's representation decides the stride, and that is a fact
    -- instruction selection must see rather than one buried in a callee.
    Prims.ArrayLength ->
        L.emit(l.b, ArrayLength(operands(l, p, args, 1)[0]), Ssa.untraced(I64))
    Prims.ArrayGet -> {
        let xs = operands(l, p, args, 2)
        L.emit(l.b, ArrayGet(xs[0], xs[1], Checked), rep)
    }
    Prims.ArraySet -> {
        let xs = operands(l, p, args, 3)
        L.effect(l.b, ArraySet(xs[0], xs[1], xs[2], Checked))
        L.emit(l.b, ConstUnit, Ssa.untraced(Unit))
    }
    Prims.ArrayNew -> {
        let xs = operands(l, p, args, 2)
        L.emit(l.b, ArrayNew(xs[0], xs[1], Ssa.repOf(l.func, xs[1])), Ssa.traced(Ptr))
    }
    Prims.ArrayCopy -> {
        let xs = operands(l, p, args, 5)
        Bulk.copyArray(l.b, elementRep(l, args[0].ty), xs[0], xs[1], xs[2], xs[3], xs[4])
        L.emit(l.b, ConstUnit, Ssa.untraced(Unit))
    }
    -- Raw memory holds nothing the collector follows, so neither may the
    -- array it is copied into.
    Prims.ArrayCopyIn -> {
        let xs = operands(l, p, args, 4)
        let element = elementRep(l, args[0].ty)
        if element.traced || element.class_ == Unit {
            return stop(l, "Prim.arrayCopyIn into an array of " + show(element))
        }
        Bulk.copyIn(l.b, element, xs[0], xs[1], xs[2], xs[3])
        L.emit(l.b, ConstUnit, Ssa.untraced(Unit))
    }
    Prims.ArrayFill -> {
        let xs = operands(l, p, args, 4)
        Bulk.fillArray(l.b, Ssa.repOf(l.func, xs[3]), xs[0], xs[1], xs[2], xs[3])
        L.emit(l.b, ConstUnit, Ssa.untraced(Unit))
    }
    -- Uninitialized in the source language and not in the heap: the
    -- collector may walk this array before anything writes to it, so a
    -- traced slot must hold something it can follow.
    Prims.ArrayNewUninit -> {
        let xs = operands(l, p, args, 1)
        let element = elementRep(l, e.ty)
        L.emit(l.b, ArrayNew(xs[0], storageZero(l, element), element), Ssa.traced(Ptr))
    }
    -- The conversion half of a checked cast. `Data.Error.cast` compared the
    -- two type reps first, so equal reps mean equal types mean equal
    -- layouts: a legitimate cast is the identity and never converts.
    --
    -- Deliberately not `coerce`. That one boxes a scalar into a pointer,
    -- and this is the one place where doing so would *compile* the
    -- combination the rep check exists to rule out.
    Prims.CastAs -> {
        let xs = operands(l, p, args, 1)
        if Ssa.repOf(l.func, xs[0]) == rep { return xs[0] }
        -- Dead, and provably so -- but contract 1 copies an opened arm per
        -- packed layout, so this copy can be the one whose payload is an `i64`
        -- while the result type is a pointer. Something must still be emitted.
        -- A trap, not a zero: if the reasoning above is ever wrong, this says
        -- so instead of reading a pointer out of an integer.
        let message = L.emit(l.b, ConstString(
            "a cast reached a conversion its type check had ruled out"),
            Ssa.traced(Ptr))
        L.terminate(l.b, Panic(message))
        L.into(l.b, L.block(l.b))
        zero(l, rep)
    }
    Prims.CharFromInt -> primConvert(l, p, args, Narrow, rep)
    Prims.CharToInt -> primConvert(l, p, args, Widen, rep)
    Prims.CharEq -> primCompare(l, p, args, Eq)
    Prims.CharLt -> primCompare(l, p, args, Lt)
    Prims.ByteFromInt -> primConvert(l, p, args, Narrow, rep)
    Prims.ByteToInt -> primConvert(l, p, args, Widen, rep)
    Prims.ByteEq -> primCompare(l, p, args, Eq)
    Prims.ByteLt -> primCompare(l, p, args, Lt)
    Prims.IntAdd -> primBinary(l, p, args, Add, rep)
    Prims.IntSub -> primBinary(l, p, args, Sub, rep)
    Prims.IntMul -> primBinary(l, p, args, Mul, rep)
    Prims.IntDiv -> primBinary(l, p, args, Div, rep)
    Prims.IntRem -> primBinary(l, p, args, Rem, rep)
    Prims.IntNeg -> L.emit(l.b, Neg(operands(l, p, args, 1)[0]), rep)
    -- Distinct opcodes, not the same one: what differs is whether overflow
    -- panics, and a backend that could not tell them apart would emit an
    -- overflow check on `Data.Map`'s hashing and panic on a subtraction the
    -- language says wraps.
    Prims.IntAddWrapping -> primBinary(l, p, args, AddWrap, rep)
    Prims.IntSubWrapping -> primBinary(l, p, args, SubWrap, rep)
    Prims.IntMulWrapping -> primBinary(l, p, args, MulWrap, rep)
    -- Wrapping negation is `0 - x` without the check, which is what `SubWrap`
    -- already is; `Neg` traps.
    Prims.IntNegWrapping -> {
        let xs = operands(l, p, args, 1)
        let zero = L.emit(l.b, ConstInt(0), rep)
        L.emit(l.b, Bin(SubWrap, zero, xs[0]), rep)
    }
    Prims.IntAnd -> primBinary(l, p, args, And, rep)
    Prims.IntOr -> primBinary(l, p, args, Or, rep)
    Prims.IntXor -> primBinary(l, p, args, Xor, rep)
    -- Every bit flipped: an exclusive or with all ones.
    Prims.IntNot -> {
        let xs = operands(l, p, args, 1)
        let ones = L.emit(l.b, ConstInt(-1), rep)
        L.emit(l.b, Bin(Xor, xs[0], ones), rep)
    }
    Prims.IntShl -> primBinary(l, p, args, Shl, rep)
    Prims.IntShr -> primBinary(l, p, args, Shr, rep)
    Prims.IntShrUnsigned -> primBinary(l, p, args, ShrU, rep)
    Prims.IntMulHighUnsigned -> primBinary(l, p, args, MulHighU, rep)
    Prims.IntEq -> primCompare(l, p, args, Eq)
    Prims.IntLt -> primCompare(l, p, args, Lt)
    Prims.IntToFloat -> primConvert(l, p, args, IntToFloat, rep)
    Prims.FloatAdd -> primBinary(l, p, args, Add, rep)
    Prims.FloatSub -> primBinary(l, p, args, Sub, rep)
    Prims.FloatMul -> primBinary(l, p, args, Mul, rep)
    Prims.FloatDiv -> primBinary(l, p, args, Div, rep)
    Prims.FloatNeg -> L.emit(l.b, Neg(operands(l, p, args, 1)[0]), rep)
    Prims.FloatTruncate -> primConvert(l, p, args, FloatToInt, rep)
    Prims.FloatEq -> primCompare(l, p, args, Eq)
    Prims.FloatLt -> primCompare(l, p, args, Lt)
    Prims.FloatLte -> primCompare(l, p, args, Le)
    Prims.FloatGt -> primCompare(l, p, args, Gt)
    Prims.FloatGte -> primCompare(l, p, args, Ge)
    Prims.CharIsScalar -> primIntrinsic(l, p, args, L.CharIsScalar, rep)
    Prims.FloatFitsInt -> primIntrinsic(l, p, args, L.FloatFitsInt, rep)
    Prims.FloatBits -> primIntrinsic(l, p, args, L.FloatBits, rep)
    Prims.FloatFromBits -> primIntrinsic(l, p, args, L.FloatFromBits, rep)
    Prims.FloatIsNaN -> primIntrinsic(l, p, args, L.FloatIsNaN, rep)
    Prims.Not -> L.emit(l.b, Not(operands(l, p, args, 1)[0]), rep)
    Prims.BoolEq -> primCompare(l, p, args, Eq)
    Prims.BoolLt -> primCompare(l, p, args, Lt)
}

-- A primitive's operands, lowered left to right. The type checker fixed the
-- count, so a different one here is a compiler bug.
fun operands(l : Lower, p : Prims.Prim, args : Array Core, arity : Int) -> Array Value {
    if len(args) != arity {
        oops(Prims.name(p) + " applied to " + Int.toString(len(args))
             + " arguments, not " + Int.toString(arity))
    }
    -- A primitive takes a value of several slots only where it stores it.
    Array.map(args, fun(a) = stored(l, value(l, a)))
}

fun noOperands(l : Lower, p : Prims.Prim, args : Array Core) -> Unit {
    if len(args) != 0 {
        oops(Prims.name(p) + " applied to " + Int.toString(len(args)) + " arguments")
    }
}

fun literalArgument(args : Array Core) -> Option String {
    if len(args) == 1 {
        if let CLit(LString(s)) = erased(args[0]).kind { return Some(s) }
    }
    None
}

fun primBinary(l : Lower, p : Prims.Prim, args : Array Core, o : BinOp, rep : Rep) -> Value {
    let xs = operands(l, p, args, 2)
    L.emit(l.b, Bin(o, xs[0], xs[1]), rep)
}

fun primCompare(l : Lower, p : Prims.Prim, args : Array Core, o : CmpOp) -> Value {
    let xs = operands(l, p, args, 2)
    L.emit(l.b, Cmp(o, xs[0], xs[1]), Ssa.untraced(I1))
}

fun primConvert(l : Lower, p : Prims.Prim, args : Array Core, c : Conv, rep : Rep) -> Value =
    L.emit(l.b, Convert(c, operands(l, p, args, 1)[0]), rep)

fun rawLoad(l : Lower, p : Prims.Prim, args : Array Core, c : RepClass) -> Value {
    let xs = operands(l, p, args, 2)
    L.emit(l.b, PtrLoad(xs[0], xs[1], c), Ssa.untraced(c))
}

fun rawStore(l : Lower, p : Prims.Prim, args : Array Core, c : RepClass) -> Value {
    let xs = operands(l, p, args, 3)
    L.effect(l.b, PtrStore(xs[0], xs[1], xs[2], c))
    L.emit(l.b, ConstUnit, Ssa.untraced(Unit))
}

fun primIntrinsic(l : Lower, p : Prims.Prim, args : Array Core, k : L.Intrinsic,
              rep : Rep) -> Value =
    L.emit(l.b, Intrinsic(k, operands(l, p, args, 1)[0]), rep)

-- The element representation of an array type.
fun elementRep(l : Lower, ty : Ty.Type) -> Rep {
    let (_, args) = Ty.spine(Ty.prune(ty))
    if len(args) > 0 { repOf(l, args[0]) } else { Ssa.traced(Ptr) }
}

-- The name of a Core form, for reporting what is not lowered yet. Not
-- `Core.showExpr`, which wants a namer and an alias table and would print a
-- whole subtree where a word is wanted.
fun formOf(e : Core) -> String = match e.kind {
    CLit(_) -> "a literal"
    CUnit -> "unit"
    CVar(_) -> "a variable"
    CCon(name) -> "the constructor '" + name + "'"
    CPrim(p) -> "the primitive '" + Prims.name(p) + "'"
    CTuple(_) -> "a tuple"
    CArray(_) -> "an array literal"
    CDict(_, _) -> "a dictionary"
    CSlot(_, _) -> "a dictionary slot"
    CProject(_, _) -> "a projection"
    CIndex(_, _) -> "an index"
    CLam(_, _, _) -> "a lambda"
    CApp(_, _) -> "an application"
    CTyLam(_, _) -> "a type abstraction"
    CTyApp(_, _) -> "a type application"
    CLet(_, _, _, _, _, _) -> "a let"
    CLetRec(_, _) -> "a letrec"
    CJoin(_, _, _, _, _, _) -> "a join"
    CJump(_, _) -> "a jump"
    CRef(_) -> "a ref"
    CDeref(_) -> "a deref"
    CAssign(_, _) -> "an assignment"
    CIf(_, _, _) -> "an if"
    CMatch(_, _) -> "a match"
}

-- -- the module initializer -----------------------------------------------------------

-- One global's contribution to the initializer.
type Action
    -- Allocate a dictionary and publish it *before* its slots are computed, so
    -- a slot that mentions the dictionary reaches a real address.
    = Placeholder(String, String, Array Core)
    -- One field of a placeheld dictionary, once its object exists.
    | Field(String, Int, Core)
    -- An ordinary global: compute the value, store it.
    | Store(String, Core)

-- Every global, computed in one function.
--
-- Three phases, and the first two exist for one reason: a dictionary's slots
-- are the instance's methods, and a method mentions the dictionary it belongs
-- to. Building the dictionary in one step would need its own address before it
-- had one. So every dictionary is *allocated and published* first, and its
-- slots are stored afterwards -- the same shell-first discipline `letrec`
-- uses, for the same reason, one level up.
--
-- Each action's value is lowered under the *owning binding's* layouts and not
-- the initializer's. `Turkey.Layout` gives a copy its layouts, and the copy of
-- a dictionary is built here, so an initializer that kept one empty
-- map would lift the copy's methods with nothing known and read an array of
-- `i1` at the boxed width, which is why `Lower` carries `layouts` per binding
-- rather than per program.
fun initializer(program : CProgram, decls : DeclTable,
                globals : Set.Set String, globalRefs : Map String Rep,
                tags : Map String Int,
                sigs : Map String Signature, shared : Lifting)
        -> (Ssa.Func Low, Ssa.Func Low, Array (Ssa.Func Low), Vec (String, Rep)) {
    let storage = storageOf(program, decls)
    let held = Map.new()
    for (name, r) in storage { Map.put(held, name, r) }
    let owners = Map.new()
    for bind in Vec.append(program.dicts, program.binds) { Map.put(owners, bind.name, bind) }

    let actions : Vec Action = []
    let deferred = []
    for bind in program.dicts {
        if !Map.contains(held, bind.name) { continue }
        match erased(bind.value).kind {
            CDict(cls, slots) -> {
                Vec.push(actions, Placeholder(bind.name, Core.dictName(cls), slots))
                Vec.push(deferred, (bind.name, slots))
            }
            _ -> Vec.push(actions, Store(bind.name, bind.value))
        }
    }
    for (name, slots) in deferred {
        for var i = 0; i < len(slots); i = i + 1 {
            Vec.push(actions, Field(name, i, slots[i]))
        }
    }
    let earlyActions : Vec Action = []
    let giblets = Giblets.gibletModules()
    for bind in program.binds {
        if Map.contains(held, bind.name) {
            if Set.contains(giblets, bind.module_) {
                let value = match bind.value.kind {
                    CRef(inner) -> if bind.mutable { inner } else { bind.value }
                    _ -> bind.value
                }
                Vec.push(earlyActions, Store(bind.name, value))
            } else {
                Vec.push(actions, Store(bind.name, bind.value))
            }
        }
    }
    let (early, earlyLifted) = lowerActions(Giblets.initializerName, earlyActions,
        decls, globals, globalRefs, tags, sigs, shared, owners, held)
    let (init, lifted) = lowerActions(initializerName, actions,
        decls, globals, globalRefs, tags, sigs, shared, owners, held)
    (init, early, Array.append(earlyLifted, lifted), storage)
}

-- Partitioning preserves the dependency order established by module checking.
-- Early actions contain only untraced globals; nullary objects and dictionary
-- shells belong exclusively to the ordinary initializer.
fun lowerActions(name : String, actions : Vec Action, decls : DeclTable,
                 globals : Set.Set String, globalRefs : Map String Rep,
                 tags : Map String Int,
                 sigs : Map String Signature, shared : Lifting,
                 owners : Map String CBind, held : Map String Rep)
        -> (Ssa.Func Low, Array (Ssa.Func Low)) {
    let f = Ssa.newFunc(name, [Ssa.untraced(Unit)])
    let l = newLower(decls, f, globals, globalRefs, tags, sigs, Map.new(), [], shared)
    L.into(l.b, L.block(l.b))
    for a in actions {
        let owner = ownerOf(a)
        let bind = match Map.get(owners, owner) {
            Some(found) -> found
            None -> oops("the global '" + owner + "' has no binding")
        }
        -- The owning binding's layouts, restored per action.
        setLayouts(l, bind.layouts)
        -- The owning binding's position, which what the action lowers to
        -- takes where its own nodes have none: a dictionary is built from
        -- nodes the compiler made.
        L.setSpan(l.b, bind.span)
        -- The global's module, for the lambdas the action lifts to take.
        -- `Lower` has no room for a field of its own for it; the
        -- initializer's own is put back to empty below.
        f.module_ = bind.module_
        l.env = Map.new()
        l.joins = Map.new()
        l.stopped = None
        act(l, a, held)
        -- A hard failure, unlike a *function* that cannot be lowered.
        --
        -- The difference is what the failure costs. A skipped function leaves
        -- a symbol its callers still name, and `LowIr.checkCalls` says so; a
        -- skipped global leaves an initializer that runs to completion and
        -- quietly did not initialize something, which nothing downstream can
        -- notice. Reporting the second the way the first is reported would be
        -- a coverage number standing in for a program that cannot run.
        --
        -- This was a scaffold while the histogram was being worked down --
        -- skip the global, count it, carry on -- and it is deleted now that
        -- every program in the corpus lowers with nothing skipped.
        match l.stopped {
            None -> {}
            Some(why) -> oops("the global '" + owner + "' cannot be lowered: "
                              + why)
        }
    }
    f.module_ = ""
    L.terminate(l.b, Ret([L.emit(l.b, ConstUnit, Ssa.untraced(Unit))]))
    (Promote.run(f), pruneAll(l.lifted))
}

fun ownerOf(a : Action) -> String = match a {
    Placeholder(name, _, _) -> name
    Field(name, _, _) -> name
    Store(name, _) -> name
}

-- One action, appended to wherever the cursor is.
--
-- A `Store` and a `Field` both have to *compute* a value, and computing one
-- may branch -- a global initialized by a `match` is ordinary. `value` sends
-- such a value to a block whose parameters receive it (`control`), and the
-- store happens there, which leaves the cursor in the right place for the
-- action after it. This is the same destination passing the rest of the module
-- uses, and it is why the initializer needs no reverse chaining: the successor
-- is simply where the cursor ends up.
--
-- Each value is analysed for escaping locals on its own, as a function's body
-- is, so a `var` in an initializer -- or in whatever was inlined into one --
-- is a local and not a heap cell.
fun act(l : Lower, a : Action, held : Map String Rep) -> Unit = match a {
    Placeholder(name, con, slots) -> {
        -- Filled by the `Field` actions that follow, so every slot is mutable,
        -- and starts as a zero.
        let reps = Array.map(slots, fun(v) = repOf(l, v.ty))
        for r in reps {
            if r != Ssa.traced(Ptr) {
                return stop1(l, "a dictionary slot of " + con + " held at " + show(r))
            }
        }
        let layout = Rt.layout(reps)
        if !countable(l, layout) { return {} }
        let made = L.emit(l.b, ObjectNew(1, Map.getOr(l.tags, con, -1), layout,
                                         Array.map(reps, storageZero(l, _)),
                                         allFields(len(slots))),
                          Ssa.traced(Ptr))
        L.effect(l.b, GlobalStore(name, made))
    }
    Field(name, index, v) -> {
        prepareLocals(l, v)
        let arrived = stored(l, value(l, v))
        let record = L.emit(l.b, GlobalLoad(name), Ssa.traced(Ptr))
        L.effect(l.b, ObjectSet(record, dictionarySlot(index), arrived))
    }
    Store(name, v) -> {
        let want = Map.getOr(held, name, Ssa.traced(Ptr))
        prepareLocals(l, v)
        L.effect(l.b, GlobalStore(name, coerce(l, value(l, v), want)))
    }
}


-- The lifted functions get the same treatment: a lambda's body has the same
-- `match` fallthroughs its parent's does.
fun pruneAll(fs : Vec (Ssa.Func Low)) -> Array (Ssa.Func Low) = Array.map(fs, Promote.run)

fun discard(x : a) -> Unit = {}
