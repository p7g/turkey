export (Item(..), Cfi(..), print, fits32)

--- What the emitter produces: a module as a sequence of values, in the order
--- they go into the object, over the target's instruction type `i`.
---
--- Nothing in it is text. The assembly printer below is one consumer, and an
--- encoder that writes the bytes directly is another; both read the same
--- items, so the bytes the encoder writes can be checked against what the
--- system assembler makes of the printed text. A name is a `Turkey.Asm.Symbol`,
--- which the printer spells and an executable writer looks up.
---
--- Labels and data are items rather than fields of an instruction because the
--- assembler treats them so: a label names the position of whatever comes
--- next, and a data item's size is its own, not an instruction's four bytes.

import Turkey.Asm as Asm
import Turkey.Asm (Symbol)
import Turkey.Position as Position

type Item i
    --- The instruction set the code needs, first in a module.
    = Architecture
    --- Following items go into this section.
    | Section(Asm.Section)
    --- The symbol is visible outside the object.
    | Global(Symbol)
    --- The symbol names a function, where the format records that.
    | FunctionType(Symbol)
    --- Pad to a multiple of 2^n bytes.
    | Align(Int)
    --- The position of the next item.
    | Label(Symbol)
    | Instruction(i)
    --- An eight-byte word: a constant, or the address of a symbol.
    | Word(Int)
    | WordOf(Symbol)
    --- A four-byte constant, which `fits32` must accept.
    | Word32(Int)
    --- `n` zero bytes.
    | Space(Int)
    --- A string's bytes. `CString` adds the terminating zero.
    | Bytes(String)
    | CString(String)
    --- Text for the reader of the assembly, with no bytes behind it.
    | Comment(String)
    --- A byte, and an unsigned integer in LEB128, the variable-length encoding
    --- DWARF writes most of its numbers in.
    | Byte(Int)
    | Uleb(Int)
    --- Four bytes holding the distance from the second label to the first,
    --- both in the same section, signed: a length, a function's size, or a
    --- return address's offset from the entry. `Turkey.Assembler` fixes it
    --- in the field. The Mach-O system assembler does too, except where both
    --- an alignment and a symbol that is not a temporary label lie between
    --- the two: there it writes a `SUBTRACTOR` and `UNSIGNED` pair, wherever
    --- the field is. The linker resolves the pair to the same distance in the
    --- image.
    | Difference(Symbol, Symbol)
    --- The same distance in LEB128, for a range list. Its length depends on
    --- its value, so both labels must be placed before it.
    | UlebDifference(Symbol, Symbol)
    --- Four bytes holding the first label's offset from the start of its
    --- section, which the second label marks. Where the linker joins sections
    --- of one name from several objects, as an ELF linker joins
    --- `.debug_str`, the offset is relocated to the joined section's;
    --- Mach-O's debug sections are never joined, so there it is the plain
    --- distance.
    | SectionOffset(Symbol, Symbol)
    --- Source file `n` of the line table, by its path, with the directory it
    --- is relative to when that is not the compile directory. File 0 is the
    --- program's main file and names the compile directory.
    | SourceFile(Int, Option String, String)
    --- A row of the line table at the next instruction: the position the row
    --- starts (`Turkey.Position`), and whether it is where the function's
    --- body begins, after its prologue. Takes no bytes. Position 0 is a row
    --- with no source line, which ends the previous row where a function
    --- with no position begins.
    | Loc(Int, Bool)
    --- A rule of the call frame information at this point in the code, which
    --- an unwinder reads to find the caller's frame. Takes no bytes.
    | Cfi(Cfi)

--- The call frame information's rules: where the canonical frame address
--- (CFA) is, the value `sp` had before the call, and where each register's
--- caller value is. A rule holds from the item it follows to the next rule,
--- and every function starts with the CFA at `sp` and every register its
--- caller's.
---
--- Registers are DWARF's numbers for arm64: `x0`-`x30` are 0-30, `sp` 31,
--- and `d0`-`d31` 64-95.
type Cfi
    --- The function the rules describe starts at the next item, and ends at
    --- the item before `EndProc`.
    = StartProc
    | EndProc
    --- The CFA is the register plus the offset.
    | DefCfa(Int, Int)
    --- The CFA is its register plus this offset.
    | DefCfaOffset(Int)
    --- The register's caller value is saved at the CFA plus the offset.
    | SavedAt(Int, Int)
    --- The register holds its caller's value again.
    | Restored(Int)
    --- The register's caller value is lost. For the return address, the
    --- frame is the outermost.
    | Undefined(Int)
    --- The rules as they stand, kept, and then put back.
    | RememberState
    | RestoreState

--- Whether `n` is a signed 32-bit integer, which is what a `Word32` and a
--- `Difference` hold.
fun fits32(n : Int) -> Bool = n >= -0x80000000 && n < 0x80000000

--- The items as assembly text, appended to `b`, and the array emptied.
fun print[Show i](d : Asm.Dialect, items : Vec (Item i), b : String.Builder) -> Unit {
    for item in items { printItem(d, item, b) }
    -- Emptied because the caller prints a function at a time: held until the
    -- end, `turkey`'s own text is millions of items the collector keeps
    -- tracing.
    Vec.clear(items)
}

fun printItem[Show i](d : Asm.Dialect, item : Item i, b : String.Builder) -> Unit =
    match item {
        Architecture -> match Asm.architecture(d) {
            Some(directive) -> line(b, "    " + directive)
            None -> {}
        }
        Section(s) -> line(b, "    " + Asm.section(d, s))
        Global(sym) -> line(b, "    .globl " + Asm.spell(sym))
        FunctionType(sym) -> match Asm.functionType(sym) {
            Some(directive) -> line(b, "    " + directive)
            None -> {}
        }
        Align(n) -> line(b, "    .p2align " + Int.toString(n))
        Label(sym) -> line(b, Asm.spell(sym) + ":")
        Instruction(i) -> line(b, "    " + show(i))
        Word(n) -> line(b, "    .quad " + Int.toString(n))
        WordOf(sym) -> line(b, "    .quad " + Asm.spell(sym))
        Word32(n) -> line(b, "    .long " + Int.toString(n))
        Space(n) -> line(b, "    .space " + Int.toString(n))
        Bytes(text) -> byteList(b, text, False)
        CString(text) -> byteList(b, text, True)
        Comment(text) -> line(b, "    // " + text)
        Byte(n) -> line(b, "    .byte " + Int.toString(n))
        Uleb(n) -> line(b, "    .uleb128 " + Int.toString(n))
        Difference(to, from) -> line(b, "    .long " + Asm.spell(to) + " - " + Asm.spell(from))
        UlebDifference(to, from) ->
            line(b, "    .uleb128 " + Asm.spell(to) + " - " + Asm.spell(from))
        SectionOffset(label, start) -> match d {
            Asm.MachO -> line(b, "    .long " + Asm.spell(label) + " - " + Asm.spell(start))
            -- A label in another section is a relocation, against the
            -- section, which the linker moves with the joined section.
            Asm.Elf -> line(b, "    .long " + Asm.spell(label))
        }
        SourceFile(n, directory, path) -> {
            let dir = match directory {
                Some(text) -> quoted(text) + " "
                None -> ""
            }
            line(b, "    .file " + Int.toString(n) + " " + dir + quoted(path))
        }
        Loc(at, prologueEnd) -> {
            String.push(b, "    .loc " + Int.toString(Position.file(at)) + " "
                           + Int.toString(Position.line(at)) + " "
                           + Int.toString(Position.column(at)))
            if prologueEnd { String.push(b, " prologue_end") }
            -- Every row says whether it is a statement: the assembler carries
            -- `is_stmt` from one `.loc` to the next.
            String.push(b, if Position.isStmt(at) { " is_stmt 1" } else { " is_stmt 0" })
            String.push(b, "\n")
        }
        Cfi(rule) -> line(b, "    " + directive(rule))
    }

fun directive(rule : Cfi) -> String = match rule {
    StartProc -> ".cfi_startproc"
    EndProc -> ".cfi_endproc"
    DefCfa(r, n) -> ".cfi_def_cfa " + register(r) + ", " + Int.toString(n)
    DefCfaOffset(n) -> ".cfi_def_cfa_offset " + Int.toString(n)
    SavedAt(r, n) -> ".cfi_offset " + register(r) + ", " + Int.toString(n)
    Restored(r) -> ".cfi_restore " + register(r)
    Undefined(r) -> ".cfi_undefined " + register(r)
    RememberState -> ".cfi_remember_state"
    RestoreState -> ".cfi_restore_state"
}

-- A DWARF register number as the assembler names the register.
fun register(r : Int) -> String =
    if r == 31 { "sp" }
    else if r >= 64 { "d" + Int.toString(r - 64) }
    else { "x" + Int.toString(r) }

fun line(b : String.Builder, text : String) -> Unit {
    String.push(b, text)
    String.push(b, "\n")
}

-- `text` as a string the assembler reads back unchanged: a quote and a
-- backslash escaped, and every control character in octal.
fun quoted(text : String) -> String {
    let b = String.builder()
    String.push(b, "\"")
    for c in String.codePoints(text) {
        let n = Char.toInt(c)
        if c == '"' || c == '\\' {
            String.push(b, "\\" + Char.toString(c))
        } else if n < 32 {
            String.push(b, "\\" + Int.toString((n >> 6) & 7) + Int.toString((n >> 3) & 7)
                           + Int.toString(n & 7))
        } else {
            String.push(b, Char.toString(c))
        }
    }
    String.push(b, "\"")
    String.build(b)
}

-- Bytes as a `.byte` directive, never as a quoted string: the text is whatever
-- the program's source said, and `.ascii` would need every quote, backslash
-- and newline escaped the way the assembler reads them back.
--
-- Nothing at all for an empty string with no terminator: `.byte` with no
-- operands is a syntax error, and a zero-length literal is a program writing
-- `""`.
fun byteList(b : String.Builder, text : String, terminated : Bool) -> Unit {
    var any = False
    for byte in String.bytes(text) {
        if any { String.push(b, ", ") } else { String.push(b, "    .byte ") }
        any = True
        String.push(b, Int.toString(Byte.toInt(byte)))
    }
    if terminated {
        if any { String.push(b, ", ") } else { String.push(b, "    .byte ") }
        String.push(b, "0")
        any = True
    }
    if any { String.push(b, "\n") }
}
