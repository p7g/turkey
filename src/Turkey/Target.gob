module Turkey.Target (
    Target(..), named, host, spellings, primitives, chosen,
)

-- The platform a compile is for: what `--target` chose, and what
-- `Prim.targetOs` and `Prim.targetArch` stand for.
--
-- Two views of one choice. The compiler holds it as this record, an ordinary
-- run-time value. The compiled program sees it as `Target.os` and
-- `Target.arch`, constructors of the library's own `OS` and `Arch`, which is
-- why the fields are those constructors' names rather than the spelling on the
-- command line.

import Target (OS(..))
import Target as Platform
import Turkey.Prelude as Prelude

type Target = Target {
    -- As `--target` spells it: `<arch>-<os>`.
    spelling : String,
    os       : String,
    arch     : String,
}

let darwin = Target { spelling = "arm64-darwin", os = "Darwin", arch = "Arm64" }

let linux = Target { spelling = "arm64-linux", os = "Linux", arch = "Arm64" }

-- Every target the compiler can emit code for. `lib/Target.gob` declares a
-- constructor for each `os` and `arch` named here, and no others; lowering a
-- target primitive checks the first half of that.
let known = [darwin, linux]

fun named(spelling : String) -> Option Target {
    for t in known {
        if t.spelling == spelling { return Some(t) }
    }
    None
}

-- The default: the target this compiler was itself compiled for, which is the
-- machine it is running on.
fun host() -> Target = match Platform.os {
    Darwin -> darwin
    Linux -> linux
}

fun spellings() -> String = String.join(Array.map(known, _.spelling), ", ")

-- The primitives `lib/Target.gob` binds `os` and `arch` to.
let primitives = ["Prim.targetArch", "Prim.targetOs"]

-- The constructor a target primitive stands for, as an internal name, or
-- `None` for any other name.
fun chosen(t : Target, name : String) -> Option String = match name {
    "Prim.targetOs" -> Some(Prelude.internal(Prelude.targetName, t.os))
    "Prim.targetArch" -> Some(Prelude.internal(Prelude.targetName, t.arch))
    _ -> None
}
