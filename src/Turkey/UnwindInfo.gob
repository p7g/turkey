export (unwindInfo)

-- `__TEXT,__unwind_info`: the table libunwind, the debuggers and the
-- profilers search for a function's compact unwind encoding, by the
-- function's offset from the Mach-O header.
--
-- **The simplest form the format allows.** Version 1, with no common
-- encodings, no personalities and no language-specific data, and only
-- regular second-level pages, each a sorted array of {function offset,
-- encoding} pairs that a reader searches as it is. The format's compressed
-- pages, which index a table of encodings, take about half the space and
-- several times the code to build.
--
-- **An entry runs to the next one.** A reader takes the last entry at or
-- below a PC, and the function it describes ends where the next entry
-- starts, or, after the last, at the sentinel: the index entry with no page,
-- at the end of the code. So every function needs an entry, and a run of
-- adjacent functions with the same encoding shares the first one's. DWARF
-- mode is never folded: its low 24 bits are the offset of the function's own
-- FDE in `__eh_frame`, which is the reader's starting point in its search,
-- and two such functions sharing an entry would share an FDE.
--
-- A page holds at most 511 entries: with its 8-byte header, those are what
-- fit in a 4,096-byte regular page.

import Turkey.Unwind as Unwind

-- The bits of an encoding that hold its mode.
let modeMask = 0x0F000000

let headerSize = 28
let indexEntrySize = 12
let pageHeaderSize = 8
let entriesPerPage = 511

-- Returns `__unwind_info` for `entries`: each function's offset from the
-- Mach-O header and its encoding, ascending by offset, every one before
-- `end`, the end of the last function.
fun unwindInfo(entries : Vec (Int, Int), end : Int) -> Vec Byte {
    let folded = []
    for (offset, encoding) in entries {
        let n = len(folded)
        if n > 0 {
            let (last, lastEncoding) = folded[n - 1]
            if offset <= last || offset >= end {
                error("internal error: unwind entries are not ascending within the code")
            }
            if encoding == lastEncoding && !Unwind.dwarfMode(encoding & modeMask) { continue }
        }
        Vec.push(folded, (offset, encoding))
    }
    let pages = (len(folded) + entriesPerPage - 1) / entriesPerPage
    let indexAt = headerSize
    -- The language-specific data array, which is empty, follows the index.
    let lsdaAt = indexAt + indexEntrySize * (pages + 1)
    let out = []
    let le = fun(width, value) {
        let at = len(out)
        for var k = 0; k < width; k = k + 1 { Vec.push(out, Byte.truncate(0)) }
        Byte.putLE(out, at, width, value)
    }
    le(4, 1)
    -- The common encodings and the personalities: none, at the index.
    le(4, indexAt)
    le(4, 0)
    le(4, indexAt)
    le(4, 0)
    le(4, indexAt)
    le(4, pages + 1)
    var pageAt = lsdaAt
    for var p = 0; p < pages; p = p + 1 {
        let (first, _) = folded[p * entriesPerPage]
        le(4, first)
        le(4, pageAt)
        le(4, lsdaAt)
        pageAt = pageAt + pageHeaderSize + 8 * pageCount(len(folded), p)
    }
    le(4, end)
    le(4, 0)
    le(4, lsdaAt)
    for var p = 0; p < pages; p = p + 1 {
        let count = pageCount(len(folded), p)
        -- UNWIND_SECOND_LEVEL_REGULAR, then where its entries start and how
        -- many there are.
        le(4, 2)
        le(2, pageHeaderSize)
        le(2, count)
        for var k = 0; k < count; k = k + 1 {
            let (offset, encoding) = folded[p * entriesPerPage + k]
            le(4, offset)
            le(4, encoding)
        }
    }
    out
}

-- How many of `n` entries page `p` holds.
fun pageCount(n : Int, p : Int) -> Int = min(n - p * entriesPerPage, entriesPerPage)
