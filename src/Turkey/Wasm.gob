export (
    HeapType(..), ValType(..), FuncType(..), BlockType(..), IntWidth(..), FloatWidth(..),
    IntRel(..), IntUnOp(..), IntBinOp(..), FloatRel(..), FloatUnOp(..), FloatBinOp(..),
    Conversion(..), LoadKind(..), StoreKind(..), Op(..), funcref, naturalAlignment,
)

--- The WebAssembly instruction set a function body is written in.
---
--- This is the wasm counterpart of `Turkey.Arm64`'s instruction type: what
--- instruction selection produces from the low IR and what the writer
--- (`Turkey.Wasm.Module`) turns into bytes, through the encoder
--- (`Turkey.Wasm.Encode`). It is a type of its own and not part of the low IR,
--- so after selection a virtual operation is not *representable*, and every
--- `match` over `Op` stays exhaustive over wasm instructions only.
---
--- **A function body is a flat sequence.** `Block`, `Loop` and `If` open a
--- nesting level, `Else` switches an `If` to its second arm, and `End` closes
--- the level, exactly as the binary format spells them. A tree would need a
--- second traversal to print or encode and would make the stackifier build the
--- tree it then flattens; the sequence is what that pass emits as it walks the
--- dominator tree. The encoder checks the nesting and every branch depth, so a
--- mismatched `End` or a branch past the outermost label stops with an
--- internal error where it was written, not in the engine's validator.
---
--- **Operands are stack values, not registers.** An instruction pops its
--- operands and pushes its results, so nothing here names a virtual register:
--- a value lives in a local (`LocalGet`, `LocalSet`, `LocalTee`) or on the
--- stack between the instruction that makes it and the one that uses it. The
--- encoder does not type-check the stack; the engine does when it validates
--- the module.
---
--- **What is covered.** The MVP instructions with the sign-extension,
--- saturating-truncation and multi-value extensions; the bulk-memory
--- `memory.copy` and `memory.fill`; the tail-call instructions; and the
--- function references they need (`ref.func` and `call_ref`). Exceptions, GC,
--- SIMD, threads and tables' own instructions are absent: nothing selects them.
---
--- **Integers are `Int`.** `ConstI32` takes the 32-bit value either signed or
--- as its unsigned bit pattern, and `ConstF32` takes the pattern's bits, since
--- the language has no single-precision float.

--- What a reference points at: a function of any type, or one with the type at
--- this index of the type section.
type HeapType
    = HFunc
    | HType(Int)

--- A value a local, a global or the stack can hold.
type ValType
    = I32
    | I64
    | F32
    | F64
    --- A reference that is never null.
    | Ref(HeapType)
    --- A reference that may be null.
    | RefOrNull(HeapType)

--- A reference to a function of any type, that may be null: what a table of
--- functions holds.
let funcref = RefOrNull(HFunc)

--- A function's parameters and results. Several results are allowed.
type FuncType = FuncType { params : Array ValType, results : Array ValType }

--- What a `Block`, `Loop` or `If` consumes and leaves on the stack.
type BlockType
    --- No operands and no results.
    = Empty
    --- No operands and one result.
    | Value(ValType)
    --- The operands and results of the function type at this index, which is
    --- how a block takes parameters or leaves several results.
    | Typed(Int)

--- The width of an integer instruction's operands.
type IntWidth = W32 | W64

--- The width of a floating-point instruction's operands.
type FloatWidth = S32 | S64

--- An integer comparison, which leaves an `I32`. `S` and `U` say whether the
--- operands are read as signed or unsigned.
type IntRel = Eq | Ne | LtS | LtU | GtS | GtU | LeS | LeU | GeS | GeU

type IntUnOp = Clz | Ctz | Popcnt

type IntBinOp
    = Add | Sub | Mul | DivS | DivU | RemS | RemU
    | And | Or | Xor | Shl | ShrS | ShrU | Rotl | Rotr

--- A floating-point comparison, which leaves an `I32`.
type FloatRel = FEq | FNe | FLt | FGt | FLe | FGe

type FloatUnOp = Abs | Neg | Ceil | Floor | Trunc | Nearest | Sqrt

type FloatBinOp = FAdd | FSub | FMul | FDiv | FMin | FMax | Copysign

--- An instruction that changes a value's type or width. Named as the
--- specification names them: the result type, the operation, the operand type
--- and whether the operand is signed.
type Conversion
    = I32WrapI64
    | I32TruncF32S | I32TruncF32U | I32TruncF64S | I32TruncF64U
    | I64ExtendI32S | I64ExtendI32U
    | I64TruncF32S | I64TruncF32U | I64TruncF64S | I64TruncF64U
    | F32ConvertI32S | F32ConvertI32U | F32ConvertI64S | F32ConvertI64U | F32DemoteF64
    | F64ConvertI32S | F64ConvertI32U | F64ConvertI64S | F64ConvertI64U | F64PromoteF32
    | I32ReinterpretF32 | I64ReinterpretF64 | F32ReinterpretI32 | F64ReinterpretI64
    | I32Extend8S | I32Extend16S | I64Extend8S | I64Extend16S | I64Extend32S
    --- The truncations that saturate instead of trapping.
    | I32TruncSatF32S | I32TruncSatF32U | I32TruncSatF64S | I32TruncSatF64U
    | I64TruncSatF32S | I64TruncSatF32U | I64TruncSatF64S | I64TruncSatF64U

--- A load: the type it leaves, then how much memory it reads, with `S` and `U`
--- saying whether a narrow read is sign- or zero-extended.
type LoadKind
    = I32Load | I64Load | F32Load | F64Load
    | I32Load8S | I32Load8U | I32Load16S | I32Load16U
    | I64Load8S | I64Load8U | I64Load16S | I64Load16U | I64Load32S | I64Load32U

--- A store: the type it takes, then how much memory it writes, dropping the
--- high bits of a narrow write.
type StoreKind
    = I32Store | I64Store | F32Store | F64Store
    | I32Store8 | I32Store16 | I64Store8 | I64Store16 | I64Store32

--- Returns the base-2 logarithm of the number of bytes `kind` reads, which is
--- the alignment the encoder gives its memory operand.
fun naturalAlignment(kind : LoadKind) -> Int = match kind {
    I32Load8S | I32Load8U | I64Load8S | I64Load8U -> 0
    I32Load16S | I32Load16U | I64Load16S | I64Load16U -> 1
    I32Load | F32Load | I64Load32S | I64Load32U -> 2
    I64Load | F64Load -> 3
}

--- An instruction. The comments name the operands popped, `->` and what is left.
type Op
    -- -- control ---------------------------------------------------------------
    = Unreachable
    | Nop
    --- Opens a level that `Br` to it leaves, continuing after its `End`.
    | Block(BlockType)
    --- Opens a level that `Br` to it re-enters from the top.
    | Loop(BlockType)
    --- Pops an `I32` and runs the first arm unless it is zero.
    | If(BlockType)
    | Else
    --- Closes the innermost `Block`, `Loop` or `If`. A function body and a
    --- constant expression end with one the encoder supplies.
    | End
    --- Branches out of `n` more levels than the innermost one: 0 is the
    --- innermost, and `n` equal to the number of open levels is the function
    --- itself, which returns.
    | Br(Int)
    --- Pops an `I32` and branches as `Br` unless it is zero.
    | BrIf(Int)
    --- Pops an `I32`, branches to the label at that index of the array, or to
    --- the default when it is out of range.
    | BrTable(Array Int, Int)
    | Return
    --- Calls the function at this index in the function index space, which
    --- counts the imports first.
    | Call(Int)
    --- Pops an `I32` index into the table, and calls what is there, whose
    --- type must be the type section's entry. Takes the type index and then
    --- the table index.
    | CallIndirect(Int, Int)
    --- Pops a function reference of the type at this index and calls it.
    | CallRef(Int)
    --- Calls and returns what the callee returns, in constant stack. The
    --- three forms mirror the calls above.
    | ReturnCall(Int)
    | ReturnCallIndirect(Int, Int)
    | ReturnCallRef(Int)
    -- -- references ------------------------------------------------------------
    | RefNull(HeapType)
    | RefIsNull
    --- Pushes a reference to the function at this index. The function must
    --- appear in an element segment or an export, which the engine checks.
    | RefFunc(Int)
    -- -- parametric and variables ---------------------------------------------
    | Drop
    --- Pops an `I32` and two values of one numeric type; leaves the first
    --- unless the `I32` is zero.
    | Select
    | LocalGet(Int)
    | LocalSet(Int)
    | LocalTee(Int)
    | GlobalGet(Int)
    | GlobalSet(Int)
    -- -- memory ----------------------------------------------------------------
    --- Pops an `I32` address and leaves the value read at the address plus
    --- the constant offset.
    | Load(LoadKind, Int)
    --- Pops a value and an `I32` address, and writes the value at the address
    --- plus the constant offset.
    | Store(StoreKind, Int)
    | MemorySize
    --- Pops a number of pages and leaves the old size in pages, or -1.
    | MemoryGrow
    --- Pops a destination, a source and a length; the ranges may overlap.
    | MemoryCopy
    --- Pops a destination, a byte value and a length.
    | MemoryFill
    -- -- numeric ---------------------------------------------------------------
    | ConstI32(Int)
    | ConstI64(Int)
    --- The bits of the single-precision value.
    | ConstF32(Int)
    | ConstF64(Float)
    --- Pops an integer and leaves 1 if it is zero.
    | IntEqz(IntWidth)
    | IntRel(IntWidth, IntRel)
    | IntUn(IntWidth, IntUnOp)
    | IntBin(IntWidth, IntBinOp)
    | FloatRel(FloatWidth, FloatRel)
    | FloatUn(FloatWidth, FloatUnOp)
    | FloatBin(FloatWidth, FloatBinOp)
    | Convert(Conversion)
