export (encode, expression, unsignedLEB, signedLEB, valType, funcType, name, vector)

--- WebAssembly instructions and the types they mention as the bytes the
--- binary format spells them in.
---
--- One `match` per instruction family over `Wasm.Op`, so a new instruction is
--- a compile error here until it has an encoding. The opcodes follow the
--- specification's binary format: each number below is an instruction's first
--- byte, or its sub-opcode after the `0xFC` prefix.
---
--- Every integer that is a size, an index or a count is an unsigned LEB128 and
--- every constant and block type index a signed one. We write the shortest
--- form, which the format does not require but every reader accepts, and which
--- makes the module's bytes a function of its contents.

import Turkey.Wasm as W
import Turkey.Wasm (
	Op(..),
	ValType(..),
	HeapType(..),
	FuncType(..),
	BlockType(..),
	IntWidth(..),
	FloatWidth(..),
	IntRel(..),
	IntUnOp(..),
	IntBinOp(..),
	FloatRel(..),
	FloatUnOp(..),
	FloatBinOp(..),
	Conversion(..),
	LoadKind(..),
	StoreKind(..),
)

-- The first byte of the instructions that carry a sub-opcode: the saturating
-- truncations and the bulk-memory instructions.
let prefixFC = 0xFC

-- The byte that closes a function body, a constant expression and every
-- nesting level.
let endByte = 0x0B

--- Appends `n` as an unsigned LEB128: seven bits at a time, least significant
--- group first, each byte but the last with its top bit set. `n` must not be
--- negative.
fun unsignedLEB(out : Vec Byte, n : Int) -> Unit {
	if n < 0 { error("internal error: the unsigned LEB128 of " + Int.toString(n)) }
	var rest = n
	while rest >= 0x80 {
		Vec.push(out, Byte.truncate((rest & 0x7F) | 0x80))
		rest = Int.shrUnsigned(rest, 7)
	}
	Vec.push(out, Byte.truncate(rest))
}

--- Appends `n` as a signed LEB128: the same groups of seven, ending at the
--- first byte whose bit 6 already says what the remaining bits are (a sign
--- extension of it).
fun signedLEB(out : Vec Byte, n : Int) -> Unit {
	var rest = n
	var more = True
	while more {
		let group = rest & 0x7F
		rest = Int.shr(rest, 7)
		let signBit = group & 0x40
		if (rest == 0 && signBit == 0) || (rest == -1 && signBit != 0) {
			Vec.push(out, Byte.truncate(group))
			more = False
		} else {
			Vec.push(out, Byte.truncate(group | 0x80))
		}
	}
}

--- Appends the length-prefixed UTF-8 bytes of `s`, which is how the format
--- spells every name.
fun name(out : Vec Byte, s : String) -> Unit {
	unsignedLEB(out, String.byteLength(s))
	for b in String.toBytes(s) { Vec.push(out, b) }
}

--- Appends `items`' count and then each one, written by `each`: the format's
--- `vec`.
fun vector(out : Vec Byte, items : Array a, each : fun(Vec Byte, a) -> Unit) -> Unit {
	unsignedLEB(out, len(items))
	for item in items { each(out, item) }
}

--- Appends the type of a value.
fun valType(out : Vec Byte, t : ValType) -> Unit = match t {
	I32 -> Vec.push(out, Byte.truncate(0x7F))
	I64 -> Vec.push(out, Byte.truncate(0x7E))
	F32 -> Vec.push(out, Byte.truncate(0x7D))
	F64 -> Vec.push(out, Byte.truncate(0x7C))
	-- A nullable reference to a function of any type has a byte of its own.
	RefOrNull(HFunc) -> Vec.push(out, Byte.truncate(0x70))
	RefOrNull(h) -> {
		Vec.push(out, Byte.truncate(0x63))
		heapType(out, h)
	}
	Ref(h) -> {
		Vec.push(out, Byte.truncate(0x64))
		heapType(out, h)
	}
}

-- A heap type is an abstract one's byte, or a type index as a signed 33-bit
-- LEB128, which keeps the two apart: an index is never negative.
fun heapType(out : Vec Byte, h : HeapType) -> Unit = match h {
	HFunc -> Vec.push(out, Byte.truncate(0x70))
	HType(index) -> {
		checkIndex("type", index)
		signedLEB(out, index)
	}
}

-- Raises an internal error for a negative index, which signed encodings would
-- otherwise write as a different thing: `HType(-16)` as the byte for `func`.
fun checkIndex(what : String, index : Int) -> Unit {
	if index < 0 {
		error("internal error: the " + what + " index " + Int.toString(index) + " is negative")
	}
}

--- Appends a function type: the `0x60` that marks it, then the parameters and
--- the results.
fun funcType(out : Vec Byte, t : FuncType) -> Unit {
	Vec.push(out, Byte.truncate(0x60))
	vector(out, t.params, valType)
	vector(out, t.results, valType)
}

fun blockType(out : Vec Byte, t : BlockType) -> Unit = match t {
	Empty    -> Vec.push(out, Byte.truncate(0x40))
	Value(v) -> valType(out, v)
	Typed(index) -> {
		checkIndex("type", index)
		signedLEB(out, index)
	}
}

--- Appends `ops` as a function body's code or a constant expression: each
--- instruction, then the `end` that closes it. `ops` leaves that `end` out.
---
--- Raises an internal error for an `Else` outside an `If`'s first arm, an
--- `End` with no level open, a level never closed and a branch to a level
--- that does not exist.
fun expression(out : Vec Byte, ops : Array Op) -> Unit {
	-- One entry per open level, innermost last: whether it is an `If` that has
	-- not yet had its `Else`.
	let open : Vec Bool = []
	for op in ops {
		match op {
			Block(_) | Loop(_) -> Vec.push(open, False)
			If(_)              -> Vec.push(open, True)
			Else -> {
				if Vec.last(open) != Some(True) {
					error("internal error: 'Else' is not inside the first arm of an 'If'")
				}
				open[len(open) - 1] = False
			}
			End -> {
				if len(open) == 0 {
					error(
						"internal error: 'End' closes nothing; the encoder writes the "
							+ "one that ends the body",
					)
				}
				let _ = Vec.pop(open)
			}
			Br(depth) | BrIf(depth) -> checkDepth(depth, len(open))
			BrTable(targets, fallback) -> {
				for depth in targets { checkDepth(depth, len(open)) }
				checkDepth(fallback, len(open))
			}
			_ -> {}
		}
		encode(op, out)
	}
	if len(open) != 0 {
		error(
			"internal error: "
				+ Int.toString(len(open))
				+ " 'Block', 'Loop' or 'If' "
				+ "is never closed",
		)
	}
	Vec.push(out, Byte.truncate(endByte))
}

-- A branch reaches the `open` levels and then the body itself, which returns.
fun checkDepth(depth : Int, open : Int) -> Unit {
	if depth < 0 || depth > open {
		error(
			"internal error: a branch to level "
				+ Int.toString(depth)
				+ " has only "
				+ Int.toString(open)
				+ " 'Block', 'Loop' or 'If' to leave",
		)
	}
}

--- Appends one instruction and its immediates. The nesting is not checked
--- here; `expression` checks it.
fun encode(op : Op, out : Vec Byte) -> Unit = match op {
	Unreachable -> byte(out, 0x00)
	Nop         -> byte(out, 0x01)
	Block(t) -> {
		byte(out, 0x02)
		blockType(out, t)
	}
	Loop(t) -> {
		byte(out, 0x03)
		blockType(out, t)
	}
	If(t) -> {
		byte(out, 0x04)
		blockType(out, t)
	}
	Else        -> byte(out, 0x05)
	End         -> byte(out, endByte)
	Br(depth)   -> indexed(out, 0x0C, depth)
	BrIf(depth) -> indexed(out, 0x0D, depth)
	BrTable(targets, fallback) -> {
		byte(out, 0x0E)
		vector(out, targets, unsignedLEB)
		unsignedLEB(out, fallback)
	}
	Return  -> byte(out, 0x0F)
	Call(f) -> indexed(out, 0x10, f)
	CallIndirect(t, table) -> {
		indexed(out, 0x11, t)
		unsignedLEB(out, table)
	}
	CallRef(t)    -> indexed(out, 0x14, t)
	ReturnCall(f) -> indexed(out, 0x12, f)
	ReturnCallIndirect(t, table) -> {
		indexed(out, 0x13, t)
		unsignedLEB(out, table)
	}
	ReturnCallRef(t) -> indexed(out, 0x15, t)
	RefNull(h) -> {
		byte(out, 0xD0)
		heapType(out, h)
	}
	RefIsNull  -> byte(out, 0xD1)
	RefFunc(f) -> indexed(out, 0xD2, f)
	Drop       -> byte(out, 0x1A)
	Select     -> byte(out, 0x1B)
	SelectT(t) -> {
		byte(out, 0x1C)
		vector(out, [t], valType)
	}
	LocalGet(n)  -> indexed(out, 0x20, n)
	LocalSet(n)  -> indexed(out, 0x21, n)
	LocalTee(n)  -> indexed(out, 0x22, n)
	GlobalGet(n) -> indexed(out, 0x23, n)
	GlobalSet(n) -> indexed(out, 0x24, n)
	Load(kind, offset) -> {
		checkOffset(offset)
		byte(out, loadOpcode(kind))
		unsignedLEB(out, W.naturalAlignment(kind))
		unsignedLEB(out, offset)
	}
	Store(kind, offset) -> {
		checkOffset(offset)
		byte(out, storeOpcode(kind))
		unsignedLEB(out, storeAlignment(kind))
		unsignedLEB(out, offset)
	}
	-- The memory instructions name memory 0 with a zero byte, which the format
	-- reserves for more than one memory.
	MemorySize -> {
		byte(out, 0x3F)
		byte(out, 0x00)
	}
	MemoryGrow -> {
		byte(out, 0x40)
		byte(out, 0x00)
	}
	MemoryCopy -> {
		prefixed(out, 10)
		byte(out, 0x00)
		byte(out, 0x00)
	}
	MemoryFill -> {
		prefixed(out, 11)
		byte(out, 0x00)
	}
	ConstI32(n) -> {
		byte(out, 0x41)
		signedLEB(out, signed32(n))
	}
	ConstI64(n) -> {
		byte(out, 0x42)
		signedLEB(out, n)
	}
	ConstF32(bits) -> {
		byte(out, 0x43)
		if bits < 0 || bits > 0xFFFF_FFFF {
			error(
				"internal error: the single-precision bits "
					+ Int.toString(bits)
					+ " do not fit in four bytes",
			)
		}
		littleEndian(out, 4, bits)
	}
	ConstF64(x) -> {
		byte(out, 0x44)
		littleEndian(out, 8, Float.bits(x))
	}
	IntEqz(w) -> byte(
		out,
		match w {
			W32 -> 0x45
			W64 -> 0x50
		},
	)
	IntRel(w, r) -> byte(
		out,
		(match w {
			W32 -> 0x46
			W64 -> 0x51
		}) + intRelIndex(r),
	)
	IntUn(w, u) -> byte(
		out,
		(match w {
			W32 -> 0x67
			W64 -> 0x79
		}) + intUnIndex(u),
	)
	IntBin(w, b) -> byte(
		out,
		(match w {
			W32 -> 0x6A
			W64 -> 0x7C
		}) + intBinIndex(b),
	)
	FloatRel(w, r) -> byte(
		out,
		(match w {
			S32 -> 0x5B
			S64 -> 0x61
		}) + floatRelIndex(r),
	)
	FloatUn(w, u) -> byte(
		out,
		(match w {
			S32 -> 0x8B
			S64 -> 0x99
		}) + floatUnIndex(u),
	)
	FloatBin(w, b) -> byte(
		out,
		(match w {
			S32 -> 0x92
			S64 -> 0xA0
		}) + floatBinIndex(b),
	)
	Convert(c) -> {
		let code = conversionCode(c)
		if code >= saturating {
			prefixed(out, code - saturating)
		} else {
			byte(out, code)
		}
	}
}

-- A memory operand's offset is an unsigned 32-bit immediate.
fun checkOffset(offset : Int) -> Unit {
	if offset < 0 || offset > 0xFFFF_FFFF {
		error(
			"internal error: the memory offset "
				+ Int.toString(offset)
				+ " does not fit in 32 bits",
		)
	}
}

fun byte(out : Vec Byte, n : Int) -> Unit = Vec.push(out, Byte.truncate(n))

-- An opcode followed by one unsigned LEB128 immediate.
fun indexed(out : Vec Byte, opcode : Int, n : Int) -> Unit {
	byte(out, opcode)
	unsignedLEB(out, n)
}

-- The `0xFC` prefix and then a sub-opcode.
fun prefixed(out : Vec Byte, sub : Int) -> Unit {
	byte(out, prefixFC)
	unsignedLEB(out, sub)
}

-- Appends the low `width` bytes of `value`, least significant first.
fun littleEndian(out : Vec Byte, width : Int, value : Int) -> Unit {
	let at = len(out)
	for var k = 0; k < width; k = k + 1 { Vec.push(out, Byte.truncate(0)) }
	Byte.putLE(out, at, width, value)
}

-- Returns the 32-bit constant `n` as the signed value an `i32.const` holds. A
-- constant is accepted either signed or as its unsigned bit pattern.
fun signed32(n : Int) -> Int {
	if n < -0x8000_0000 || n > 0xFFFF_FFFF {
		error("internal error: the constant " + Int.toString(n) + " does not fit in 32 bits")
	}
	if n >= 0x8000_0000 { n - 0x1_0000_0000 } else { n }
}

fun loadOpcode(kind : LoadKind) -> Int = match kind {
	I32Load    -> 0x28
	I64Load    -> 0x29
	F32Load    -> 0x2A
	F64Load    -> 0x2B
	I32Load8S  -> 0x2C
	I32Load8U  -> 0x2D
	I32Load16S -> 0x2E
	I32Load16U -> 0x2F
	I64Load8S  -> 0x30
	I64Load8U  -> 0x31
	I64Load16S -> 0x32
	I64Load16U -> 0x33
	I64Load32S -> 0x34
	I64Load32U -> 0x35
}

fun storeOpcode(kind : StoreKind) -> Int = match kind {
	I32Store   -> 0x36
	I64Store   -> 0x37
	F32Store   -> 0x38
	F64Store   -> 0x39
	I32Store8  -> 0x3A
	I32Store16 -> 0x3B
	I64Store8  -> 0x3C
	I64Store16 -> 0x3D
	I64Store32 -> 0x3E
}

-- The base-2 logarithm of the bytes the store writes, as `naturalAlignment`
-- gives the load's.
fun storeAlignment(kind : StoreKind) -> Int = match kind {
	I32Store8 | I64Store8            -> 0
	I32Store16 | I64Store16          -> 1
	I32Store | F32Store | I64Store32 -> 2
	I64Store | F64Store              -> 3
}

-- Each of these is the position of an operation among its family's opcodes,
-- which the specification lays out consecutively, once per width.

fun intRelIndex(r : IntRel) -> Int = match r {
	Eq  -> 0
	Ne  -> 1
	LtS -> 2
	LtU -> 3
	GtS -> 4
	GtU -> 5
	LeS -> 6
	LeU -> 7
	GeS -> 8
	GeU -> 9
}

fun intUnIndex(u : IntUnOp) -> Int = match u {
	Clz    -> 0
	Ctz    -> 1
	Popcnt -> 2
}

fun intBinIndex(b : IntBinOp) -> Int = match b {
	Add  -> 0
	Sub  -> 1
	Mul  -> 2
	DivS -> 3
	DivU -> 4
	RemS -> 5
	RemU -> 6
	And  -> 7
	Or   -> 8
	Xor  -> 9
	Shl  -> 10
	ShrS -> 11
	ShrU -> 12
	Rotl -> 13
	Rotr -> 14
}

fun floatRelIndex(r : FloatRel) -> Int = match r {
	FEq -> 0
	FNe -> 1
	FLt -> 2
	FGt -> 3
	FLe -> 4
	FGe -> 5
}

fun floatUnIndex(u : FloatUnOp) -> Int = match u {
	Abs     -> 0
	Neg     -> 1
	Ceil    -> 2
	Floor   -> 3
	Trunc   -> 4
	Nearest -> 5
	Sqrt    -> 6
}

fun floatBinIndex(b : FloatBinOp) -> Int = match b {
	FAdd     -> 0
	FSub     -> 1
	FMul     -> 2
	FDiv     -> 3
	FMin     -> 4
	FMax     -> 5
	Copysign -> 6
}

-- A conversion's code at or above this is a saturating truncation, whose
-- sub-opcode is the code less this. The plain conversions are single bytes,
-- below it.
let saturating = 0x100

fun conversionCode(c : Conversion) -> Int = match c {
	I32WrapI64        -> 0xA7
	I32TruncF32S      -> 0xA8
	I32TruncF32U      -> 0xA9
	I32TruncF64S      -> 0xAA
	I32TruncF64U      -> 0xAB
	I64ExtendI32S     -> 0xAC
	I64ExtendI32U     -> 0xAD
	I64TruncF32S      -> 0xAE
	I64TruncF32U      -> 0xAF
	I64TruncF64S      -> 0xB0
	I64TruncF64U      -> 0xB1
	F32ConvertI32S    -> 0xB2
	F32ConvertI32U    -> 0xB3
	F32ConvertI64S    -> 0xB4
	F32ConvertI64U    -> 0xB5
	F32DemoteF64      -> 0xB6
	F64ConvertI32S    -> 0xB7
	F64ConvertI32U    -> 0xB8
	F64ConvertI64S    -> 0xB9
	F64ConvertI64U    -> 0xBA
	F64PromoteF32     -> 0xBB
	I32ReinterpretF32 -> 0xBC
	I64ReinterpretF64 -> 0xBD
	F32ReinterpretI32 -> 0xBE
	F64ReinterpretI64 -> 0xBF
	I32Extend8S       -> 0xC0
	I32Extend16S      -> 0xC1
	I64Extend8S       -> 0xC2
	I64Extend16S      -> 0xC3
	I64Extend32S      -> 0xC4
	I32TruncSatF32S   -> saturating + 0
	I32TruncSatF32U   -> saturating + 1
	I32TruncSatF64S   -> saturating + 2
	I32TruncSatF64U   -> saturating + 3
	I64TruncSatF32S   -> saturating + 4
	I64TruncSatF32U   -> saturating + 5
	I64TruncSatF64S   -> saturating + 6
	I64TruncSatF64U   -> saturating + 7
}
