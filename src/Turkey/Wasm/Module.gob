export (
    Limits(..), TableType(..), GlobalType(..), ImportKind(..), Import(..), ExportKind(..),
    Export(..), Global(..), Function(..), Elem(..), Data(..), Module(..),
    newModule, addType, importFunc, importTable, importMemory, importGlobal, declareFunc,
    defineFunc, addTable, addMemory, addGlobal, addExport, addElem, addData, write,
)

--- A WebAssembly module, built up in memory and written as the binary format.
---
--- This is the writer: no tool outside the compiler is involved, as with the
--- Mach-O and ELF writers. A `Module` holds each section's entries as the
--- builder functions add them, and `write` turns it into the module's bytes
--- with its sections in the order the format requires.
---
--- **Indices.** Every item is named by its position in its index space, and
--- the builder functions return it. A space starts with the imports, so a
--- module's own functions, tables, memories and globals are numbered after its
--- imports of that kind: each `import...` function raises an internal error
--- once the module defines an item of the same kind, because that item's
--- index would change underneath whoever holds it.
---
--- **Functions are declared, then defined.** A call names a function that may
--- not have its body yet -- a recursive one, or one selected later -- so
--- `declareFunc` fixes the index and the type and `defineFunc` supplies the
--- code. Writing a module with a function never defined is an internal error.
---
--- **Sizes are not known until the contents are written.** Each section, and
--- each function body, is written into a buffer of its own and copied after its
--- size, which is cheaper to get right than reserving a size field and
--- patching it, and keeps every size in its shortest form.
---
--- **Sections left empty are left out.** The binary is then a function of the
--- module's contents and not of which builder functions ran.
---
--- **What is written.** The type, import, function, table, memory, global,
--- export, element, code and data sections, and a `name` custom section naming
--- each function so a trace shows `fd_write` and not `wasm-function[3]`. No
--- start section: a module is entered through an export. No data count
--- section, since nothing selects an instruction that needs one.

import Turkey.Wasm (ValType(..), FuncType(..), Op(..))
import Turkey.Wasm.Encode as Encode

--- A size in 64 KiB pages, with the most it may grow to if there is one.
type Limits = Limits { min : Int, max : Option Int }

type TableType = TableType { elem : ValType, limits : Limits }

type GlobalType = GlobalType { type_ : ValType, mutable : Bool }

--- What an import brings in. A function is named by the index of its type.
type ImportKind
    = ImportFunc(Int)
    | ImportTable(TableType)
    | ImportMemory(Limits)
    | ImportGlobal(GlobalType)

--- Something the host provides, named by the module it comes from and its own
--- name there (`wasi_snapshot_preview1` and `fd_write`).
type Import = Import { module_ : String, name : String, kind : ImportKind }

type ExportKind = ExportFunc | ExportTable | ExportMemory | ExportGlobal

--- Something the host may use, by the name it asks for it by.
type Export = Export { name : String, kind : ExportKind, index : Int }

--- A global and the constant expression its value starts as, which is a
--- sequence of instructions without the closing `End`.
type Global = Global { type_ : GlobalType, init : Array Op }

--- A function defined in the module. `body` is `None` until `defineFunc`, and
--- otherwise the locals it declares beyond its parameters, which are numbered
--- first, and its instructions without the closing `End`.
type Function = Function {
    name : String,
    type_ : Int,
    body : Option (Array ValType, Array Op),
}

--- The functions a table starts holding, from `offset`.
type Elem = Elem { table : Int, offset : Int, funcs : Array Int }

--- The bytes a memory starts holding, from `offset`.
type Data = Data { memory : Int, offset : Int, bytes : Array Byte }

type Module = Module {
    types : Vec FuncType,
    imports : Vec Import,
    funcs : Vec Function,
    tables : Vec TableType,
    memories : Vec Limits,
    globals : Vec Global,
    exports : Vec Export,
    elems : Vec Elem,
    datas : Vec Data,
}

--- Returns a module with nothing in it.
fun newModule() -> Module = Module {
    types = [], imports = [], funcs = [], tables = [], memories = [], globals = [],
    exports = [], elems = [], datas = [],
}

--- Returns the index of `t` in the type section, adding it unless the module
--- has it.
fun addType(m : Module, t : FuncType) -> Int {
    for var k = 0; k < len(m.types); k = k + 1 {
        if m.types[k] == t { return k }
    }
    Vec.push(m.types, t)
    len(m.types) - 1
}

--- Imports the function `name` of `module_`, of the type at index `type_`, and
--- returns its function index.
fun importFunc(m : Module, module_ : String, name : String, type_ : Int) -> Int =
    addImport(m, module_, name, ImportFunc(type_), len(m.funcs), "function")

fun importTable(m : Module, module_ : String, name : String, t : TableType) -> Int =
    addImport(m, module_, name, ImportTable(t), len(m.tables), "table")

fun importMemory(m : Module, module_ : String, name : String, limits : Limits) -> Int =
    addImport(m, module_, name, ImportMemory(limits), len(m.memories), "memory")

fun importGlobal(m : Module, module_ : String, name : String, t : GlobalType) -> Int =
    addImport(m, module_, name, ImportGlobal(t), len(m.globals), "global")

-- Adds the import and returns its index among the imports of its kind, which
-- is its index, since none is defined yet: `defined` counts those.
fun addImport(m : Module, module_ : String, name : String, kind : ImportKind,
              defined : Int, what : String) -> Int {
    if defined > 0 {
        error("internal error: '" + module_ + "." + name + "' is imported after the module "
              + "defines a " + what + "; imports come first")
    }
    let index = importsOf(m, importTag(kind))
    Vec.push(m.imports, Import { module_ = module_, name = name, kind = kind })
    index
}

-- The position of a kind of import among the four, so that imports of one
-- kind can be counted.
fun importTag(kind : ImportKind) -> Int = match kind {
    ImportFunc(_) -> 0
    ImportTable(_) -> 1
    ImportMemory(_) -> 2
    ImportGlobal(_) -> 3
}

-- Returns how many imports have the kind numbered `tag`.
fun importsOf(m : Module, tag : Int) -> Int {
    var count = 0
    for i in m.imports {
        if importTag(i.kind) == tag { count = count + 1 }
    }
    count
}

--- Adds a function of the type at index `type_` with no code yet, and returns
--- its function index. `name` is what a trace shows.
fun declareFunc(m : Module, name : String, type_ : Int) -> Int {
    Vec.push(m.funcs, Function { name = name, type_ = type_, body = None })
    importsOf(m, 0) + len(m.funcs) - 1
}

--- Gives the function `index`, which `declareFunc` returned, its code.
fun defineFunc(m : Module, index : Int, locals : Array ValType, body : Array Op) -> Unit {
    let k = index - importsOf(m, 0)
    if k < 0 || k >= len(m.funcs) {
        error("internal error: function " + Int.toString(index) + " is not one the module "
              + "defines")
    }
    let f = m.funcs[k]
    if f.body != None {
        error("internal error: function '" + f.name + "' is defined twice")
    }
    m.funcs[k] = Function { name = f.name, type_ = f.type_, body = Some((locals, body)) }
}

--- Adds a table and returns its table index.
fun addTable(m : Module, t : TableType) -> Int {
    Vec.push(m.tables, t)
    importsOf(m, 1) + len(m.tables) - 1
}

--- Adds a memory and returns its memory index.
fun addMemory(m : Module, limits : Limits) -> Int {
    Vec.push(m.memories, limits)
    importsOf(m, 2) + len(m.memories) - 1
}

--- Adds a global starting as the value `init` computes, and returns its global
--- index.
fun addGlobal(m : Module, t : GlobalType, init : Array Op) -> Int {
    Vec.push(m.globals, Global { type_ = t, init = init })
    importsOf(m, 3) + len(m.globals) - 1
}

fun addExport(m : Module, name : String, kind : ExportKind, index : Int) -> Unit =
    Vec.push(m.exports, Export { name = name, kind = kind, index = index })

--- Fills `table` from `offset` with `funcs`, when the module is instantiated.
fun addElem(m : Module, table : Int, offset : Int, funcs : Array Int) -> Unit =
    Vec.push(m.elems, Elem { table = table, offset = offset, funcs = funcs })

--- Fills `memory` from `offset` with `bytes`, when the module is instantiated.
fun addData(m : Module, memory : Int, offset : Int, bytes : Array Byte) -> Unit =
    Vec.push(m.datas, Data { memory = memory, offset = offset, bytes = bytes })

--- Returns the module as the binary format: the magic number, the version, and
--- the sections.
---
--- Raises an internal error for a function declared and never defined, and for
--- an instruction sequence the encoder refuses (`Turkey.Wasm.Encode.expression`).
fun write(m : Module) -> Vec Byte {
    let out : Vec Byte = []
    for b in [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00] {
        Vec.push(out, Byte.truncate(b))
    }
    section(out, 1, m.types, Encode.funcType)
    section(out, 2, m.imports, importEntry)
    section(out, 3, m.funcs, fun(o, f) = Encode.unsignedLEB(o, f.type_))
    section(out, 4, m.tables, tableType)
    section(out, 5, m.memories, limits)
    section(out, 6, m.globals, global)
    section(out, 7, m.exports, exportEntry)
    section(out, 9, m.elems, elem)
    section(out, 10, m.funcs, code)
    section(out, 11, m.datas, data)
    nameSection(out, m)
    out
}

-- Appends section `id` holding `items`, each written by `each`, unless there
-- are none.
fun section(out : Vec Byte, id : Int, items : Vec a, each : fun(Vec Byte, a) -> Unit) -> Unit {
    if len(items) == 0 { return }
    let body : Vec Byte = []
    Encode.vector(body, Vec.toArray(items), each)
    framed(out, id, body)
}

-- Appends `body` as section `id`: its id, its size, then its bytes.
fun framed(out : Vec Byte, id : Int, body : Vec Byte) -> Unit {
    Vec.push(out, Byte.truncate(id))
    Encode.unsignedLEB(out, len(body))
    for b in body { Vec.push(out, b) }
}

-- Appends `bytes` after its length, which is how the format spells a block of
-- code or a blob.
fun sized(out : Vec Byte, bytes : Vec Byte) -> Unit {
    Encode.unsignedLEB(out, len(bytes))
    for b in bytes { Vec.push(out, b) }
}

fun limits(out : Vec Byte, l : Limits) -> Unit = match l.max {
    None -> {
        Vec.push(out, Byte.truncate(0x00))
        Encode.unsignedLEB(out, l.min)
    }
    Some(max) -> {
        Vec.push(out, Byte.truncate(0x01))
        Encode.unsignedLEB(out, l.min)
        Encode.unsignedLEB(out, max)
    }
}

fun tableType(out : Vec Byte, t : TableType) -> Unit {
    Encode.valType(out, t.elem)
    limits(out, t.limits)
}

fun globalType(out : Vec Byte, t : GlobalType) -> Unit {
    Encode.valType(out, t.type_)
    Vec.push(out, Byte.truncate(if t.mutable { 1 } else { 0 }))
}

fun importEntry(out : Vec Byte, i : Import) -> Unit {
    Encode.name(out, i.module_)
    Encode.name(out, i.name)
    match i.kind {
        ImportFunc(t) -> {
            Vec.push(out, Byte.truncate(0x00))
            Encode.unsignedLEB(out, t)
        }
        ImportTable(t) -> {
            Vec.push(out, Byte.truncate(0x01))
            tableType(out, t)
        }
        ImportMemory(l) -> {
            Vec.push(out, Byte.truncate(0x02))
            limits(out, l)
        }
        ImportGlobal(t) -> {
            Vec.push(out, Byte.truncate(0x03))
            globalType(out, t)
        }
    }
}

fun global(out : Vec Byte, g : Global) -> Unit {
    globalType(out, g.type_)
    Encode.expression(out, g.init)
}

fun exportEntry(out : Vec Byte, e : Export) -> Unit {
    Encode.name(out, e.name)
    Vec.push(out, Byte.truncate(match e.kind {
        ExportFunc -> 0x00
        ExportTable -> 0x01
        ExportMemory -> 0x02
        ExportGlobal -> 0x03
    }))
    Encode.unsignedLEB(out, e.index)
}

-- An active segment for table 0 is the short form of flag 0, and one for any
-- other table flag 2 with the table's index and the element kind `funcref`.
fun elem(out : Vec Byte, e : Elem) -> Unit {
    if e.table == 0 {
        Vec.push(out, Byte.truncate(0x00))
    } else {
        Vec.push(out, Byte.truncate(0x02))
        Encode.unsignedLEB(out, e.table)
    }
    Encode.expression(out, [ConstI32(e.offset)])
    if e.table != 0 { Vec.push(out, Byte.truncate(0x00)) }
    Encode.vector(out, e.funcs, Encode.unsignedLEB)
}

-- The same two forms for memory 0 and for another memory.
fun data(out : Vec Byte, d : Data) -> Unit {
    if d.memory == 0 {
        Vec.push(out, Byte.truncate(0x00))
    } else {
        Vec.push(out, Byte.truncate(0x02))
        Encode.unsignedLEB(out, d.memory)
    }
    Encode.expression(out, [ConstI32(d.offset)])
    Encode.unsignedLEB(out, len(d.bytes))
    for b in d.bytes { Vec.push(out, b) }
}

-- A function's entry in the code section: its size, then its locals and its
-- instructions. The locals are written as runs of one type with a count each.
fun code(out : Vec Byte, f : Function) -> Unit {
    let (locals, ops) = match f.body {
        Some(body) -> body
        None -> error("internal error: function '" + f.name + "' is declared and never "
                      + "defined")
    }
    let body : Vec Byte = []
    let runs : Vec (Int, ValType) = []
    for t in locals {
        let k = len(runs) - 1
        if k >= 0 && runs[k].1 == t {
            runs[k] = (runs[k].0 + 1, t)
        } else {
            Vec.push(runs, (1, t))
        }
    }
    Encode.vector(body, Vec.toArray(runs), fun(o, (n, t)) {
        Encode.unsignedLEB(o, n)
        Encode.valType(o, t)
    })
    Encode.expression(body, ops)
    sized(out, body)
}

-- The `name` custom section, which holds one subsection: the names of the
-- functions, by function index, imports first and in ascending order.
fun nameSection(out : Vec Byte, m : Module) -> Unit {
    let names : Vec (Int, String) = []
    for i in m.imports {
        if let ImportFunc(_) = i.kind {
            Vec.push(names, (len(names), i.module_ + "." + i.name))
        }
    }
    for f in m.funcs { Vec.push(names, (len(names), f.name)) }
    if len(names) == 0 { return }
    let subsection : Vec Byte = []
    Encode.vector(subsection, Vec.toArray(names), fun(o, (index, name)) {
        Encode.unsignedLEB(o, index)
        Encode.name(o, name)
    })
    let body : Vec Byte = []
    Encode.name(body, "name")
    -- Subsection 1 names functions.
    Vec.push(body, Byte.truncate(1))
    sized(body, subsection)
    framed(out, 0, body)
}
