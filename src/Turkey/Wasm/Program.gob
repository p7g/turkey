export (Program(..), Unsupported(..), build)

--- A whole program's low IR as a WebAssembly module: what every function is
--- numbered, what it imports, where its data is, and the entry the host
--- calls.
---
--- **Linear memory, from address 0 up:**
---
---   0                    the first page of `Turkey.Runtime.immediates`
---                        bytes, which no object is ever at
---   immediates           the shadow stack, `stackBytes` long, which shadow
---                        frames are pushed on from the top down
---   immediates + stack   the program's data: the literals' static objects,
---                        the globals, the root array and its frame, the
---                        process state, and every C string the code names,
---                        with the frame table and the trace table after the
---                        functions' strings
---   past the data        the heap, which the C library grows the memory
---                        for
---
--- The stack is below the data so that its limit is known before any
--- function is selected; the data grows as selection interns C strings.
---
--- **Functions.** Every function of the low IR is a wasm function of the same
--- name, numbered after the imports in the order the module lists them, and
--- each is declared before any is selected, so a call names its callee
--- whatever the order. A function selection stops in still has a function, a
--- trap, so the module is whole; `refused` names each one and what stopped
--- it.
---
--- **Imports.** A symbol a program calls and does not define is an import
--- from the module its `foreign "module" { ... }` block names: WASI's are
--- `wasi_snapshot_preview1`. The driver has refused any other foreign call
--- before this runs. The module defines its memory and exports it as
--- `memory`, which WASI reads.
---
--- **The table.** A closure's code and a `Prim.codeAddress` are an index into
--- the module's one table, which holds every function that one names, from
--- slot 1: a null code address is slot 0, which is empty and traps.
---
--- **The entry.** `_start`, which WASI calls, runs `turkey_main` --
--- `Turkey.Entry`'s, which runs the program -- and exits with its status.
--- `turkey_entry`, which `Turkey.Entry` calls in turn, is written here: it
--- does what the arm64 entry does.
---
--- **The tables.** A site is named by the number selection gives it
--- (`Turkey.Wasm.Select`) where arm64 names it by its return address, so the
--- frame table and the trace table are arm64's with each key a site's
--- number, from a base of 0.

import Data.Map as Map
import Turkey.LowIr (Op(..), Low(..), AddressOf(..), Callee(..))
import Turkey.Runtime as Rt
import Turkey.Ssa as Ssa
import Turkey.Ssa (Rep(..), RepClass(..), Func(..), Block(..))
import Turkey.SsaLower (Module(..))
import Turkey.Trace as Trace
import Turkey.Wasm as W
import Turkey.Wasm.Module as M
import Turkey.Wasm.Resume as Resume
import Turkey.Wasm.Select as S
import Turkey.Wasm.Types as Types

--- A function selection stopped in, and what stopped it.
type Unsupported = Unsupported { name : String, what : String }

--- The module's bytes, how many functions were selected, and the rest:
--- `switching` names the selected functions that may switch stacks, and
--- `resumePoints` the resume points they have between them.
type Program = Program {
	bytes        : Vec Byte
	selected     : Int
	refused      : Vec Unsupported
	switching    : Vec String
	resumePoints : Int
}

-- The bytes of the shadow stack, sized to expect the engine's own stack to
-- run out first. We expect a frame to take more of the engine's stack than of
-- the shadow stack, since a function's roots are locals there too: a non-tail
-- recursion holding two roots takes about 80 bytes of wasmtime's stack per
-- call and 48 of this, so 8 MiB lasts until the engine's stack is past 13 MiB,
-- against its default of 512 KiB. Nothing enforces it: a frame with large
-- frame objects can take more of this than of the engine's.
let stackBytes = 8 << 20

-- The bytes at the bottom of the shadow stack that only the panic raised by
-- running out may use (`Turkey.Wasm.Select.prologue`). The panic's own
-- functions push frames too; without room for them, each would run out again
-- and panic in turn, recursing until the engine's stack ran out.
let stackReserve = 16384

let pageBytes = 65536

let wasi = "wasi_snapshot_preview1"

--- Returns `m` as a wasm module whose `main` is the Turkey function `main`.
--- `libraries` names the wasm module each import comes from, by symbol. A
--- panic's trace names each file as `fileNames` does, in `Position.Files`
--- order, and each function as `display` does.
fun build(
	m : Module,
	main : String,
	libraries : Map String String,
	fileNames : Array String,
	display : fun(String) -> String,
) -> Program {
	let wasm = M.newModule()
	let defined = Map.new()
	for (symbol, name) in m.definitions { Map.put(defined, symbol, name) }
	let wanted = wants(m, defined)

	-- Imports come first, since they are numbered first.
	let imports = Map.new()
	for (symbol, t) in wanted.imports {
		let library = match Map.get(libraries, symbol) {
			Some(name) -> name
			None -> error("internal error: '" + symbol + "' is called and imported from nowhere")
		}
		Map.put(imports, symbol, M.importFunc(wasm, library, symbol, M.addType(wasm, t)))
	}
	-- `_start`'s exit, which the library may import already.
	let exit =
		if Map.contains(imports, "proc_exit") && Map.get(libraries, "proc_exit") == Some(wasi) {
			Map.getOr(imports, "proc_exit", -1)
		} else {
			M.importFunc(
				wasm,
				wasi,
				"proc_exit",
				M.addType(wasm, W.FuncType { params = [W.I32], results = [] }),
			)
		}

	let functions = Map.new()
	let results = Map.new()
	for f in m.functions {
		let t = M.addType(wasm, Types.functionType(f))
		Map.put(functions, f.name, M.declareFunc(wasm, f.name, t))
		Map.put(results, f.name, f.results)
	}
	let nothing = M.addType(wasm, W.FuncType { params = [], results = [] })
	let entry = M.declareFunc(wasm, Rt.programEntrySymbol, nothing)
	let start = M.declareFunc(wasm, "_start", nothing)

	let slots = Map.new()
	let slotted = []
	for name in wanted.slotted {
		if let Some(f) = Map.get(functions, name) {
			Vec.push(slotted, f)
			Map.put(slots, name, len(slotted))
		}
	}
	let switching = Resume.analyse(m, defined, wanted.slotted)
	checkSwitching(m, switching)
	-- Each tail callee's rewind entry, in the table after the closures' code.
	let byName = Map.new()
	for f in m.functions { Map.put(byName, f.name, f) }
	let rewindEntries = Map.new()
	let rewound = []
	for name in switching.tailCallees {
		if let (Some(f), Some(callee)) = (Map.get(functions, name), Map.get(byName, name)) {
			let t = M.addType(wasm, W.FuncType {
				params  = []
				results = Array.map(Map.getOr(results, name, []), Types.valType)
			})
			let entry = M.declareFunc(wasm, name + " rewind", t)
			Vec.push(slotted, entry)
			Map.put(rewindEntries, name, len(slotted))
			Vec.push(rewound, (entry, f, callee))
		}
	}
	let table = M.addTable(wasm, M.TableType {
		elem   = W.funcref
		limits = M.Limits { min = len(slotted) + 1, max = Some(len(slotted) + 1) }
	})
	M.addElem(wasm, table, 1, Vec.toArray(slotted))

	let data = layout(m, wanted.literals)
	let worker = M.addGlobal(wasm, M.GlobalType { type_ = W.I64, mutable = True }, [
		W.ConstI64(data.processState),
	])
	let stackPointer = M.addGlobal(wasm, M.GlobalType { type_ = W.I64, mutable = True }, [
		W.ConstI64(data.start),
	])
	let stackLimit = M.addGlobal(wasm, M.GlobalType { type_ = W.I64, mutable = True }, [
		W.ConstI64(Rt.immediates + stackReserve),
	])
	let rewinding = M.addGlobal(wasm, M.GlobalType { type_ = W.I32, mutable = True }, [
		W.ConstI32(0),
	])
	let builtins = Map.new()
	Map.put(builtins, Rt.programEntrySymbol, entry)
	let cx = S.Context {
		functions = functions
		results   = results
		defined   = defined
		imports   = imports
		builtins  = builtins
		slots     = slots
		literals  = data.literals
		globals   = data.globals
		module_   = wasm
		strings = S.Strings {
			start     = data.start + len(data.image)
			bytes     = []
			addresses = Map.new()
		}
		worker        = worker
		stackPointer  = stackPointer
		stackLimit    = stackLimit
		stackReserve  = stackReserve
		switching     = switching
		rewinding     = rewinding
		rewindEntries = rewindEntries
		siteCount     = 0
	}
	for (entry, f, callee) in rewound { M.defineFunc(wasm, entry, [], rewindEntry(callee, f)) }

	let refused = []
	var selected = 0
	let switches = []
	var resumePoints = 0
	let entries = []
	let traced : Vec (Trace.Traced Int) = []
	for f in m.functions {
		let index = Map.getOr(functions, f.name, -1)
		let chosen = S.selectFunction(cx, f)
		match chosen.stopped {
			Some(why) -> {
				M.defineFunc(wasm, index, [], [W.Unreachable])
				Vec.push(refused, Unsupported { name = f.name, what = why })
			}
			None -> {
				M.defineFunc(wasm, index, chosen.locals, chosen.body)
				selected = selected + 1
				if Map.contains(switching.switching, f.name) { Vec.push(switches, f.name) }
				resumePoints = resumePoints + chosen.resumePoints
				for e in chosen.entries { Vec.push(entries, e) }
				Vec.push(traced, Trace.Traced {
					name  = f.name
					at    = f.at
					sites = f.sites
					calls = chosen.calls
				})
			}
		}
	}
	-- The tables go after the C strings interned so far. A string interned
	-- later, as the entry's is, goes after them.
	let strings = cx.strings
	let tables = strings.bytes
	align(tables, 8)
	let frameTable = strings.start + len(tables)
	frameTableBytes(entries, tables)
	align(tables, 8)
	let traceTable = strings.start + len(tables)
	Trace.layout(fileNames, traced, display, Trace.Writer {
		word = fun(n) = word32(tables, n)
		call = fun(id) = word32(tables, id)
		text = fun(text) {
			for b in String.toBytes(text) { Vec.push(tables, b) }
			Vec.push(tables, Byte.truncate(0))
		}
		pad = fun(n) = for _ in Array.filled(n, 0) { Vec.push(tables, Byte.truncate(0)) }
	})
	M.defineFunc(wasm, entry, [W.I64], entryBody(cx, m, main, data, frameTable, traceTable))
	M.defineFunc(
		wasm,
		start,
		[],
		[
			-- `turkey_main`'s environment, `argc` and `argv`.
			W.ConstI64(0),
			W.ConstI64(0),
			W.ConstI64(0),
			W.Call(definition(cx, "turkey_main")),
			W.Convert(W.I32WrapI64),
			W.Call(exit),
		],
	)

	let end = strings.start + len(strings.bytes)
	let limits = M.Limits { min = (end + pageBytes - 1) / pageBytes, max = None }
	let memory = M.addMemory(wasm, limits)
	if len(data.image) > 0 { M.addData(wasm, memory, data.start, Vec.toArray(data.image)) }
	M.addData(wasm, memory, strings.start, Vec.toArray(strings.bytes))
	M.addExport(wasm, "memory", M.ExportMemory, memory)
	M.addExport(wasm, "_start", M.ExportFunc, start)
	Program {
		bytes        = M.write(wasm)
		selected     = selected
		refused      = refused
		switching    = switches
		resumePoints = resumePoints
	}
}

-- The code selection calls inside an instruction -- an allocation's slow
-- path, the write barrier, a panic, a trace's entry -- has no resume point
-- around it, since a rewind can only reach an instruction from its start.
-- Nor do the calls `_start` and the entry make outside `drive`, which only
-- `main` and the globals' initializer are called through: `turkey_main`,
-- around the entry, and the entry's setup and its end. So none of these may
-- switch stacks. Nor may early initialization, which runs before there is a
-- stack to switch from.
fun checkSwitching(m : Module, switching : Resume.Switching) -> Unit {
	let unresumable = [
		"turkey_main",
		"turkey_entry_stack_set",
		"turkey_root_enter",
		"turkey_frame_table_set",
		"turkey_trace_table_set",
		"turkey_static_register",
		"turkey_entry_returned",
		"turkey_trace_close",
		"turkey_object_new",
		"turkey_cell_new",
		"turkey_array_new",
		"turkey_closure_shell",
		"turkey_write_barrier",
		"turkey_panic",
		"turkey_panic_string",
		"turkey_trace_push",
	]
	for symbol in unresumable {
		if let Some(name) = Map.get(switching.defined, symbol) {
			if Map.contains(switching.switching, name) {
				error(
					"internal error: "
						+ symbol
						+ " may switch stacks, and is called where no rewind can reach",
				)
			}
		}
	}
	if Map.contains(switching.switching, m.early) {
		error("internal error: early initialization may switch stacks")
	}
}

-- A tail callee's rewind entry: the callee called with zeros, which it
-- ignores, rewinding. A caller that finds the callee's frame parked where its
-- own would be goes on through here (`Turkey.Wasm.Select.forward`), since
-- the entry's type is the same for every callee its caller returns the
-- results of.
fun rewindEntry(callee : Func Low, index : Int) -> Array W.Op {
	let out = []
	for p in callee.params { Vec.push(out, zero(Types.valType(Ssa.repOf(callee, p)))) }
	Vec.push(out, W.ReturnCall(index))
	Vec.toArray(out)
}

fun zero(t : W.ValType) -> W.Op = match t {
	W.I64 -> W.ConstI64(0)
	W.F64 -> W.ConstF64(0.0)
	W.F32 -> W.ConstF32(0)
	_     -> W.ConstI32(0)
}

-- What the module needs that only its instructions say: each C symbol called
-- and not defined, with the type of its first call; each function a closure
-- or a code address names, which the table holds; and each string literal,
-- in the order of first mention.
type Wanted = Wanted {
	imports  : Vec (String, W.FuncType)
	slotted  : Vec String
	literals : Vec String
}

fun wants(m : Module, defined : Map String String) -> Wanted {
	let imports = []
	let imported = Map.new()
	let slotted = []
	let slottedSeen = Map.new()
	let literals = []
	let literalSeen = Map.new()
	let slot = fun(name : String) {
		if !Map.contains(slottedSeen, name) {
			Map.put(slottedSeen, name, ())
			Vec.push(slotted, name)
		}
	}
	let wantImport = fun(symbol : String, t : W.FuncType) {
		if !Map.contains(imported, symbol) {
			Map.put(imported, symbol, ())
			Vec.push(imports, (symbol, t))
		}
	}
	for f in m.functions {
		for block in f.blocks {
			for i in block.insts {
				match i.op {
					Call(Foreign(symbol, _), args) ->
						if !Map.contains(defined, symbol) && symbol != Rt.programEntrySymbol {
							wantImport(symbol, W.FuncType {
								params  = Array.map(args, fun(a) = S.importParam(Ssa.repOf(f, a)))
								results = S.importResult(Ssa.repOf(f, i.result))
							})
						}
					ClosureNew(code, _)   -> slot(code)
					StackClosure(code, _) -> slot(code)
					Address(CodeOf(symbol)) -> if let Some(name) = Map.get(defined, symbol) {
						slot(name)
					}
					ConstString(text) -> if !Map.contains(literalSeen, text) {
						Map.put(literalSeen, text, ())
						Vec.push(literals, text)
					}
					_ -> {}
				}
			}
		}
	}
	Wanted { imports = imports, slotted = slotted, literals = literals }
}

-- -- data ----------------------------------------------------------------------------

-- The data before the C strings, and where each part of it is: `image` holds
-- its bytes from `start`.
type Data = Data {
	start        : Int
	image        : Vec Byte
	literals     : Map String Int
	staticStart  : Int
	staticEnd    : Int
	globals      : Map String Int
	roots        : Int
	rootCount    : Int
	globalsFrame : Int
	processState : Int
}

-- Each literal as a static object, laid out as `turkey_string_new` lays one
-- out -- header, length, bytes -- so that a `String` a literal reads as is
-- the same as one built at run time; they are contiguous, the range the entry
-- registers with the collector. Then a word of storage for each untraced
-- global, the root array holding the traced ones, the `RootFrame` covering
-- it, and the process state, all zero.
fun layout(m : Module, texts : Vec String) -> Data {
	let start = Rt.immediates + stackBytes
	let image : Vec Byte = []
	let at = fun() -> Int = start + len(image)
	let bytes = Rt.element([Ssa.untraced(I8)])
	let header = Rt.staticHeaderWord(Rt.arrayKind, bytes.layout.pointers, bytes.stride)
	let literals = Map.new()
	align(image, 8)
	let staticStart = at()
	for text in texts {
		align(image, 8)
		Map.put(literals, text, at())
		word(image, header)
		let content = String.toBytes(text)
		word(image, len(content))
		for b in content { Vec.push(image, b) }
	}
	align(image, 8)
	let staticEnd = at()

	let globals = Map.new()
	let traced = []
	for (name, r) in m.globals {
		if r.traced {
			Vec.push(traced, name)
		} else {
			Map.put(globals, name, at())
			word(image, 0)
		}
	}
	-- At least one word even when the module roots nothing: the entry hands
	-- this address to `turkey_root_enter`, which refuses a null one.
	let roots = at()
	for name in traced {
		Map.put(globals, name, at())
		word(image, 0)
	}
	if len(traced) == 0 { word(image, 0) }
	-- Five words -- previous, function_name, count, values, live -- in the
	-- layout `lib/Turkey/Heap.gob` reads.
	let globalsFrame = at()
	for _ in [0, 1, 2, 3, 4] { word(image, 0) }
	let processState = at()
	for var k = 0; k < Rt.processStateBytes; k = k + 1 { Vec.push(image, Byte.truncate(0)) }
	align(image, 8)
	Data {
		start        = start
		image        = image
		literals     = literals
		staticStart  = staticStart
		staticEnd    = staticEnd
		globals      = globals
		roots        = roots
		rootCount    = len(traced)
		globalsFrame = globalsFrame
		processState = processState
	}
}

fun align(out : Vec Byte, to : Int) -> Unit {
	while len(out) % to != 0 { Vec.push(out, Byte.truncate(0)) }
}

-- `n` as 8 bytes, little-endian.
fun word(out : Vec Byte, n : Int) -> Unit {
	for var k = 0; k < 8; k = k + 1 { Vec.push(out, Byte.truncate((n >> (8 * k)) & 0xFF)) }
}

-- The low 32 bits of `n` as 4 bytes, little-endian.
fun word32(out : Vec Byte, n : Int) -> Unit {
	for var k = 0; k < 4; k = k + 1 { Vec.push(out, Byte.truncate((n >> (8 * k)) & 0xFF)) }
}

-- The frame table, as `Turkey.Heap.frameTableSet` reads it: the count, then
-- per entry its site's number, its number of roots, and each root's offset
-- from the shadow frame, every field four bytes.
fun frameTableBytes(entries : Vec (Int, Array Int), out : Vec Byte) -> Unit {
	word32(out, len(entries))
	for (id, offsets) in entries {
		word32(out, id)
		word32(out, len(offsets))
		for o in offsets { word32(out, o) }
	}
}

-- -- the entry -----------------------------------------------------------------------

-- `turkey_entry`: early initialization, which runs before roots and
-- literals exist; then, unless that panicked, the stack's outer bound, the
-- permanent root frame over the root array, the literals' range, the
-- globals, and `main`; and `turkey_entry_returned` last.
fun entryBody(
	cx : S.Context,
	m : Module,
	main : String,
	data : Data,
	frameTable : Int,
	traceTable : Int,
) -> Array W.Op {
	let out = []
	let run = fun(name : String) {
		match Map.get(cx.functions, name) {
			Some(f) -> Vec.push(out, W.Call(f))
			None    -> error("internal error: the entry calls " + name + ", which did not lower")
		}
		for _ in Map.getOr(cx.results, name, []) { Vec.push(out, W.Drop) }
	}
	let runtime = fun(symbol : String, args : Array Int) {
		Vec.push(out, W.ConstI64(0))
		for a in args { Vec.push(out, W.ConstI64(a)) }
		Vec.push(out, W.Call(definition(cx, symbol)))
		Vec.push(out, W.Drop)
	}
	Vec.push(out, W.Block(W.Empty))
	run(m.early)
	Vec.push(out, W.GlobalGet(cx.worker))
	Vec.push(out, W.Convert(W.I32WrapI64))
	Vec.push(out, W.Load(W.I32Load, 0))
	Vec.push(out, W.BrIf(0))
	-- Every frame the program makes is below the shadow stack's top.
	Vec.push(out, W.ConstI64(0))
	Vec.push(out, W.GlobalGet(cx.stackPointer))
	Vec.push(out, W.Call(definition(cx, "turkey_entry_stack_set")))
	Vec.push(out, W.Drop)
	-- The permanent frame. Every traced global is live for the whole run, so
	-- its mask is all ones.
	runtime("turkey_root_enter", [
		data.globalsFrame,
		data.roots,
		data.rootCount,
		S.cString(cx.strings, "<globals>"),
	])
	Vec.push(out, W.ConstI32(data.globalsFrame))
	Vec.push(out, W.ConstI64(-1))
	Vec.push(out, W.Store(W.I64Store, 32))
	-- The frame table, before anything allocates: a collection that cannot
	-- read it sees no frame's roots at all. Then the trace table, which a
	-- panic's report reads.
	runtime("turkey_frame_table_set", [frameTable, 0])
	runtime("turkey_trace_table_set", [traceTable, 0])
	if data.staticEnd > data.staticStart {
		runtime("turkey_static_register", [data.staticStart, data.staticEnd])
	}
	let switches = fun(name : String) -> Bool = Map.contains(cx.switching.switching, name)
	drive(cx, out, fun() = run(m.initial), switches(m.initial))
	-- `main` takes the closure environment every Turkey function takes, and
	-- has none.
	drive(
		cx,
		out,
		fun() {
			Vec.push(out, W.ConstI64(0))
			run(main)
		},
		switches(main),
	)
	-- A panic's trace counts this call as arm64's counts the frame record
	-- `main` returns to the entry through, which prints nothing.
	if let Some(name) = Map.get(cx.defined, "turkey_trace_push") {
		if let Some(push) = Map.get(cx.functions, name) {
			Vec.push(out, W.GlobalGet(cx.worker))
			Vec.push(out, W.Convert(W.I32WrapI64))
			Vec.push(out, W.Load(W.I32Load, 0))
			Vec.push(out, W.If(W.Empty))
			Vec.push(out, W.ConstI64(0))
			Vec.push(out, W.ConstI64(0))
			Vec.push(out, W.Call(push))
			Vec.push(out, W.Drop)
			Vec.push(out, W.End)
		}
	}
	Vec.push(out, W.End)
	runtime("turkey_entry_returned", [])
	Vec.toArray(out)
}

-- `bottom()`'s call, as the outermost function of the program's own stack,
-- and, if it may switch stacks, every switch made below it, until it returns.
--
-- A switch unwinds the stack it leaves to here (`Turkey.Wasm.Select`), with
-- the stack to resume as the worker's running one, and here the shadow stack
-- pointer and its limit become that stack's, and its outermost function is
-- called again: the program's own stack's is `bottom`'s, and a coroutine's is
-- `Turkey.Coroutine#start`. A stack that parked is rewound; a coroutine's that
-- never ran starts. Its outermost function returning without unwinding is the
-- end of the stack: the program's, which is the end of the loop, or a
-- coroutine's, whose body has returned or panicked, and which switches to the
-- stack that resumed it for the last time, as `turkey_stack_start` does on
-- arm64. That leaves the coroutine's stack running and not parked, so the
-- collector walks nothing of it, and nothing is on it.
fun drive(cx : S.Context, out : Vec W.Op, bottom : fun() -> Unit, switches : Bool) -> Unit {
	bottom()
	if !switches { return }
	let running = fun() {
		Vec.push(out, W.GlobalGet(cx.worker))
		Vec.push(out, W.Convert(W.I32WrapI64))
		Vec.push(out, W.Load(W.I64Load, Rt.workerRunningStack))
	}
	-- Word `offset` of the stack record in the entry's local.
	let word = fun(offset : Int) {
		Vec.push(out, W.LocalGet(0))
		Vec.push(out, W.Convert(W.I32WrapI64))
		Vec.push(out, W.Load(W.I64Load, offset))
	}
	let flags = fun() {
		Vec.push(out, W.GlobalGet(cx.worker))
		Vec.push(out, W.Convert(W.I32WrapI64))
	}
	Vec.push(out, W.Block(W.Empty))
	Vec.push(out, W.Loop(W.Empty))
	flags()
	Vec.push(out, W.Load(W.I32Load, 0))
	Vec.push(out, W.ConstI32(S.unwinding))
	Vec.push(out, W.IntBin(W.W32, W.And))
	Vec.push(out, W.If(W.Empty))
	flags()
	flags()
	Vec.push(out, W.Load(W.I32Load, 0))
	Vec.push(out, W.ConstI32(-1 - S.unwinding))
	Vec.push(out, W.IntBin(W.W32, W.And))
	Vec.push(out, W.Store(W.I32Store, 0))
	Vec.push(out, W.Else)
	running()
	Vec.push(out, W.LocalSet(0))
	word(Rt.stackLow)
	Vec.push(out, W.IntEqz(W.W64))
	Vec.push(out, W.BrIf(2))
	-- A coroutine whose body panicked: its trace ends with its own frames,
	-- as on arm64, though the panic goes on returning through the resumer's.
	if let Some(name) = Map.get(cx.defined, "turkey_trace_close") {
		if let Some(close) = Map.get(cx.functions, name) {
			flags()
			Vec.push(out, W.Load(W.I32Load, 0))
			Vec.push(out, W.ConstI32(1))
			Vec.push(out, W.IntBin(W.W32, W.And))
			Vec.push(out, W.If(W.Empty))
			Vec.push(out, W.ConstI64(0))
			Vec.push(out, W.Call(close))
			for _ in Map.getOr(cx.results, name, []) { Vec.push(out, W.Drop) }
			Vec.push(out, W.End)
		}
	}
	flags()
	word(Rt.stackResumedBy)
	Vec.push(out, W.Store(W.I64Store, Rt.workerRunningStack))
	Vec.push(out, W.End)
	running()
	Vec.push(out, W.LocalSet(0))
	word(Rt.stackHigh)
	Vec.push(out, W.GlobalSet(cx.stackPointer))
	-- The program's own stack has no mapping of its own, and its bottom is
	-- the bottom of the shadow stack.
	Vec.push(out, W.ConstI64(Rt.immediates))
	word(Rt.stackLow)
	word(Rt.stackLow)
	Vec.push(out, W.IntEqz(W.W64))
	Vec.push(out, W.Select)
	Vec.push(out, W.ConstI64(cx.stackReserve))
	Vec.push(out, W.IntBin(W.W64, W.Add))
	Vec.push(out, W.GlobalSet(cx.stackLimit))
	word(Rt.stackParked)
	Vec.push(out, W.IntEqz(W.W64))
	Vec.push(out, W.IntEqz(W.W32))
	Vec.push(out, W.GlobalSet(cx.rewinding))
	Vec.push(out, W.LocalGet(0))
	Vec.push(out, W.Convert(W.I32WrapI64))
	Vec.push(out, W.ConstI64(0))
	Vec.push(out, W.Store(W.I64Store, Rt.stackParked))
	word(Rt.stackLow)
	Vec.push(out, W.IntEqz(W.W64))
	Vec.push(out, W.If(W.Empty))
	bottom()
	Vec.push(out, W.Else)
	match Map.get(cx.functions, Rt.coroutineStart) {
		Some(start) -> {
			Vec.push(out, W.ConstI64(0))
			Vec.push(out, W.Call(start))
			for _ in Map.getOr(cx.results, Rt.coroutineStart, []) { Vec.push(out, W.Drop) }
		}
		None -> Vec.push(out, W.Unreachable)
	}
	Vec.push(out, W.End)
	Vec.push(out, W.Br(0))
	Vec.push(out, W.End)
	Vec.push(out, W.End)
}

-- The function index of the `foreign` definition of `symbol`, which every
-- program has: `Turkey.Runtime.referencedSymbols` keeps each one the entry
-- calls.
fun definition(cx : S.Context, symbol : String) -> Int {
	let found = match Map.get(cx.defined, symbol) {
		Some(name) -> Map.get(cx.functions, name)
		None       -> None
	}
	match found {
		Some(f) -> f
		None    -> error("internal error: the program does not define " + symbol)
	}
}
