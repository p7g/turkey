export (valType, storageType, closureCallType, functionType)

--- The wasm type each low IR value is held in, and the function types built
--- from them. Selection and the analysis of which functions may switch
--- stacks (`Turkey.Wasm.Resume`) both read these, and must agree: the
--- analysis matches a closure call to the table functions of its type.

import Turkey.LowIr as L
import Turkey.LowIr (Low)
import Turkey.Ssa as Ssa
import Turkey.Ssa (Rep(..), Func(..), Value)
import Turkey.Wasm as W

--- Returns the wasm type a value of `r` is held in. A narrow integer is an
--- `i32`, zero-extended from its width, and a unit is an `i32` holding 0.
fun valType(r : Rep) -> W.ValType = storageType(L.storageOf(r.class_))

--- Returns the wasm type a local of storage `s` has.
fun storageType(s : L.Storage) -> W.ValType = match s {
	L.Word             -> W.I64
	L.Double           -> W.F64
	L.Small | L.NoBits -> W.I32
}

--- Returns the type of the code of a closure that `f` calls with `args`,
--- for the result `d`: the environment, then the arguments, as
--- `Turkey.SsaLower.closureCall` passes them.
fun closureCallType(f : Func Low, args : Array Value, d : Value) -> W.FuncType {
	let params = [W.I64]
	for a in args { Vec.push(params, valType(Ssa.repOf(f, a))) }
	W.FuncType { params = Vec.toArray(params), results = [valType(Ssa.repOf(f, d))] }
}

--- Returns the type of `f` as a wasm function.
fun functionType(f : Func Low) -> W.FuncType = W.FuncType {
	params  = Vec.toArray(Vec.map(f.params, fun(p) = valType(Ssa.repOf(f, p))))
	results = Array.map(f.results, valType)
}
