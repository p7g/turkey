-- A fifth entry point in `src/`, beside `ImageCases.gob`: `__unwind_info`
-- built by `Turkey.UnwindInfo.unwindInfo` from synthetic entries, at the
-- counts around a page's 511, printed one table per line as its count and
-- its bytes.
--
-- `tests/test_unwind_info.py` runs it and parses each table.

import Turkey.UnwindInfo (unwindInfo)

fun main() {
    for n in [1, 511, 512, 1022, 1023] {
        -- Functions 4 bytes apart in two alternating frame-mode encodings,
        -- so none folds into the one before it.
        let entries = []
        for var k = 0; k < n; k = k + 1 {
            Vec.push(entries, (0x1000 + 4 * k, 0x04000000 | (k % 2)))
        }
        let bytes = unwindInfo(entries, 0x1000 + 4 * n)
        let shown = Vec.map(bytes, fun(b) = Int.toString(Byte.toInt(b)))
        print(Int.toString(n) + ": " + String.join(shown, ","))
    }
}
