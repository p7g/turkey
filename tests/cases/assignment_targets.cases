-- Assignments to a binder that cannot be assigned, one case per kind of
-- binder, each with its own diagnostic. What can be assigned is recorded in
-- `docs/ref/statements.md`.

-- case function.top_level --
--@ error
-- Main.gob --
fun step(n : Int) -> Int = n + 1

fun main() {
    step = fun(n) = n + 2
}
-- error --
cannot assign to 'step': it is a function
-- case function.imported --
--@ error
-- A.gob --
export (step)

fun step(n : Int) -> Int = n + 1
-- Main.gob --
import A (step)

fun main() {
    step = fun(n) = n + 2
}
-- error --
cannot assign to 'step': it is a function
-- case function.local --
--@ error
-- Main.gob --
fun main() {
    fun step(n : Int) -> Int = n + 1
    step = fun(n) = n + 2
}
-- error --
cannot assign to 'step': it is a function
-- case function.from_its_own_body --
--@ error
-- Main.gob --
fun main() {
    fun step(n : Int) -> Int {
        step = fun(m) = m
        n + 1
    }
    print(step(1))
}
-- error --
cannot assign to 'step': it is a function
-- case class_method --
--@ error
-- Main.gob --
fun main() {
    show = fun(n : Int) = "n"
}
-- error --
cannot assign to 'show': it is a class method
-- case let.top_level --
--@ error
-- Main.gob --
let limit = 10

fun main() {
    limit = 20
}
-- error --
cannot assign to 'limit': it was bound with 'let'; declare it with 'var' to make it reassignable
-- case let.imported --
--@ error
-- A.gob --
export (limit)

let limit = 10
-- Main.gob --
import A (limit)

fun main() {
    limit = 20
}
-- error --
cannot assign to 'limit': it was bound with 'let'; declare it with 'var' to make it reassignable
