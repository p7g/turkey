-- Condition lists in `if` and `while` heads: what is refused, and what the
-- diagnostics say.
--
-- What a condition list does is recorded in `tests/programs/if_let_chains.gob`.
-- This archive is the other half.

-- case two_tests_in_a_row.in_an_if --
--@ error
-- Main.gob --
fun main() {
    let a = True
    if a, a { print(1) }
}
-- error --
two tests in a row cannot be separated by ','; join them with '&&'
-- case two_tests_in_a_row.after_a_let --
--@ error
-- Main.gob --
fun main() {
    if let Some(x) = Some(1), x > 0, x < 5 { print(x) }
}
-- error --
two tests in a row cannot be separated by ','; join them with '&&'
-- case two_tests_in_a_row.in_a_while --
--@ error
-- Main.gob --
fun main() {
    var n = 3
    while n > 0, n < 10 { n = n - 1 }
}
-- error --
two tests in a row cannot be separated by ','; join them with '&&'
-- case a_trailing_comma --
--@ error
-- Main.gob --
fun main() {
    if let Some(x) = Some(1), { print(x) }
}
-- error --
expected a condition after ','
-- case a_question_mark_in_a_later_condition --
--@ error
-- Main.gob --
fun lookup(x : Int) -> Option (Option Int) = Some(Some(x))

fun f(o : Option Int) -> Option Int {
    if let Some(x) = o, let Some(y) = lookup(x)? { return Some(y) }
    None
}

fun main() { print(f(Some(1))) }
-- error --
Main.gob:4:39: unsupported: a '?' can be in the first condition of an 'if' or 'while' but not a later one; bind its value with 'let' before the 'if'
-- case alternatives_in_a_later_condition_bind_the_same_names --
--@ error
-- Main.gob --
type T = A(Int) | B(String)

fun main() {
    if let Some(t) = Some(A(1)), let A(x) | B(y) = t { print(1) }
}
-- error --
this alternative does not bind 'x' and the first does; every alternative must bind the same variables
-- case a_later_condition_cannot_open_an_existential --
--@ error
-- Main.gob --
type Shown = Shown[Show a](a)

fun main() {
    if let Some(c) = Some(Shown(1)), let Shown(v) = c { print(show(v)) }
}
-- error --
the existential constructor 'Shown' cannot be matched by a 'let', 'var' or 'for' pattern; match it in a 'match' arm or a function parameter
