-- Net.HTTP's values: what a literal panics with when the program wrote an
-- invalid one, and what the types refuse to compile.
--
-- The behavior of the values themselves is recorded in
-- `tests/programs/http_values.gob` and `tests/programs/url_parse.gob`.

-- case a_header_value_literal_with_crlf_panics --
--@ panic
-- Main.gob --
import Net.HTTP.HeaderValue as HeaderValue

fun main() {
    print(HeaderValue.literal("ok\r\nInjected: yes"))
}
-- panic --
invalid header value literal 'ok\x0D\x0AInjected: yes'
-- case a_header_value_literal_with_nul_panics --
--@ panic
-- Main.gob --
import Net.HTTP.HeaderValue as HeaderValue

fun main() {
    print(HeaderValue.literal("a\u{0}b"))
}
-- panic --
invalid header value literal 'a\x00b'
-- case a_header_value_literal_with_del_panics --
--@ panic
-- Main.gob --
import Net.HTTP.HeaderValue as HeaderValue

fun main() {
    print(HeaderValue.literal("a\u{7F}"))
}
-- panic --
invalid header value literal 'a\x7F'
-- case a_reserved_header_name_literal_panics --
--@ panic
-- Main.gob --
import Net.HTTP.HeaderName as HeaderName

fun main() {
    print(HeaderName.literal("Transfer-Encoding"))
}
-- panic --
invalid header name literal: the header 'transfer-encoding' is written by the HTTP library and cannot be set
-- case a_header_name_literal_with_a_space_panics --
--@ panic
-- Main.gob --
import Net.HTTP.HeaderName as HeaderName

fun main() {
    print(HeaderName.literal("Content Type"))
}
-- panic --
invalid header name literal: invalid header name 'Content Type'
-- case a_media_type_literal_panics --
--@ panic
-- Main.gob --
import Net.HTTP.MediaType as MediaType

fun main() {
    print(MediaType.literal("application/json; charset"))
}
-- panic --
invalid media type literal 'application/json; charset'
-- case an_http_url_literal_panics --
--@ panic
-- Main.gob --
import Net.HTTP.HTTPURL as HTTPURL

fun main() {
    print(HTTPURL.literal("ftp://example.com/"))
}
-- panic --
invalid HTTP URL literal 'ftp://example.com/': unsupported URL scheme 'ftp'
-- case a_url_literal_panics --
--@ panic
-- Main.gob --
import URL as URL

fun main() {
    print(URL.literal("http://example.com/a b"))
}
-- panic --
invalid URL literal 'http://example.com/a b': invalid URL path
-- case a_token_literal_panics --
--@ panic
-- Main.gob --
import Net.HTTP.Token as Token

fun main() {
    print(Token.literal("two words"))
}
-- panic --
invalid token literal 'two words'
-- case a_get_cannot_carry_a_body --
--@ error
-- Main.gob --
import Net.HTTP (..)

fun main() {
    let m : Method String = GET("body")
    print(m)
}
-- error --
expected 'Method a', found 'fun(String) -> a' in a function call
-- case the_constructor_for_an_unnamed_status_is_hidden --
--@ error
-- Main.gob --
import Net.HTTP.Status (Status(Unregistered))

fun main() {
    print(Unregistered(299))
}
-- error --
module 'Net.HTTP.Status' does not export constructor 'Unregistered' of type 'Status'
-- case a_request_target_must_be_a_target --
--@ error
-- Main.gob --
import Net.HTTP (..)

fun main() {
    print(request(GET, 42).url)
}
-- error --
no instance for 'Target Int'
-- case a_typed_header_takes_its_own_value_type --
--@ error
-- Main.gob --
import Net.HTTP (..)
import Net.HTTP.Headers as Headers

fun main() {
    print(Headers.add(Headers.empty, ContentType, "application/json"))
}
-- error --
expected 'MediaType', found 'String' in a function call
