-- String literals with holes: every error the lexer and parser give for a
-- hole, and the type error for a value with no `Show`.
--
-- What a literal with holes builds is recorded in
-- `tests/programs/interpolation.gob`.

-- case a_hole_must_close_on_its_line --
--% error
-- Main.gob --
fun main() {
    print("a ${1
    }")
}
-- error --
this string literal has a '${' with no closing '}' on its line
-- case a_hole_must_close_before_the_file_ends --
--% error
-- Main.gob --
fun main() { print("a ${1
-- error --
this string literal has a '${' with no closing '}' on its line
-- case a_comment_in_a_hole_must_close_on_its_line --
--% error
-- Main.gob --
fun main() {
    print("a ${1 {- x
    -} + 2} b")
}
-- error --
this string literal has a '${' with no closing '}' on its line
-- case a_literal_after_a_hole_must_close_on_its_line --
--% error
-- Main.gob --
fun main() {
    let n = 1
    print("x ${n} no close
}
-- error --
this string literal has no closing '"' on its line; write '\n' for a line break
-- case a_hole_holds_one_expression --
--% error
-- Main.gob --
fun main() {
    print("a ${1 2}")
}
-- error --
expected '}' to close this hole, found '2'
-- case a_hole_cannot_be_empty --
--% error
-- Main.gob --
fun main() {
    print("a ${}")
}
-- error --
this hole is empty; write an expression between '${' and '}'
-- case a_hole_takes_no_second_argument --
--% error
-- Main.gob --
fun main() {
    print("a ${1, 2}")
}
-- error --
expected '}' to close this hole, found ','
-- case a_hole_takes_no_format_spec --
--% error
-- Main.gob --
fun main() {
    let x = 5
    print("a ${x:>5}")
}
-- error --
expected a type, found '>'
-- case a_hole_needs_show --
--% error
-- Main.gob --
fun main() {
    print("${fun(x) = x}")
}
-- error --
no instance for 'Show (fun(_a) -> _a)'
-- case a_literal_with_a_hole_is_not_a_pattern --
--% error
-- Main.gob --
fun main() {
    let n = 2
    match "2" {
        "${n}" -> print("two")
        _      -> print("other")
    }
}
-- error --
a string literal with a hole cannot be a pattern; match a literal without one
