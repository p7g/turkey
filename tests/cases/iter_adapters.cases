-- What `Iter`'s adapters panic with when given a count or size they cannot
-- use. Their behavior otherwise is recorded in `tests/programs/iter_adapters.gob`.

-- case take_with_a_negative_count_panics --
--@ panic
-- Main.gob --
fun main() {
    print(Iter.collect(Iter.take([1], -1)))
}
-- panic --
Iter.take: count -1 is negative
-- case windowed_with_size_zero_panics --
--@ panic
-- Main.gob --
fun main() {
    print(Iter.collect(Iter.windowed([1], 0)))
}
-- panic --
Iter.windowed: size 0 must be at least 1
-- case chunked_with_size_zero_panics --
--@ panic
-- Main.gob --
fun main() {
    print(Iter.collect(Iter.chunked([1], 0)))
}
-- panic --
Iter.chunked: size 0 must be at least 1
-- case combinations_with_a_negative_size_panics --
--@ panic
-- Main.gob --
fun main() {
    print(Iter.collect(Iter.combinations([1], -2)))
}
-- panic --
Iter.combinations: size -2 is negative
-- case drop_with_a_negative_count_panics --
--@ panic
-- Main.gob --
fun main() {
    print(Iter.collect(Iter.drop([1], -1)))
}
-- panic --
Iter.drop: count -1 is negative
-- case permutations_with_a_negative_size_panics --
--@ panic
-- Main.gob --
fun main() {
    print(Iter.collect(Iter.permutations([1], -1)))
}
-- panic --
Iter.permutations: size -1 is negative
-- case cartesian_power_with_a_negative_size_panics --
--@ panic
-- Main.gob --
fun main() {
    print(Iter.collect(Iter.cartesianPower([1], -3)))
}
-- panic --
Iter.cartesianPower: size -3 is negative
-- case huge_sizes_beyond_the_input_yield_nothing --
-- Main.gob --
fun main() {
    let n = 1000000000000000
    let empty : Array Int = []
    print(Iter.collect(Iter.windowed([1, 2, 3], n)))
    print(Iter.collect(Iter.combinations([1, 2, 3], n)))
    print(Iter.collect(Iter.permutations([1, 2, 3], n)))
    print(Iter.collect(Iter.cartesianPower(empty, n)))
}
-- stdout --
[]
[]
[]
[]
