-- Placeholder functions: what `_` and `\` are rejected for, and what the
-- diagnostics say.
--
-- What a placeholder function does is recorded in
-- `tests/programs/placeholders.gob`. This archive is the other half: every
-- error the parser gives for `_` or `\`, and the type error that says what a
-- `_` was taken to mean.

-- shared Planets.gob --
export (Planet(..), pow)

fun pow(x, n) = x * n

type Planet = Planet { name : String, moons : Int }
-- case a_bare_placeholder_with_nothing_around_it.in_a_let --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    let f = _
}
-- error --
'_' on its own is not a function; write 'fun(x) = x'
-- case a_bare_placeholder_with_nothing_around_it.as_a_statement --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    _
}
-- error --
'_' on its own is not a function; write 'fun(x) = x'
-- case a_bare_placeholder_with_nothing_around_it.as_a_function_body --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    print(Array.map(xs, fun(y) = _))
}
-- error --
'_' on its own is not a function; write 'fun(x) = x'
-- case an_implicit_function_uses_its_parameter_once.twice --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    print(Array.map(xs, _ + _))
}
-- error --
'_' appears more than once in this function; start it with '\' to make every '_' the same parameter, or write 'fun(a, b) = ...'
-- case an_implicit_function_uses_its_parameter_once.with_an_operand_between --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    print(Array.map(xs, _ * n + _))
}
-- error --
'_' appears more than once in this function; start it with '\' to make every '_' the same parameter, or write 'fun(a, b) = ...'
-- case a_condition_refuses_a_placeholder.if --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    if _ > n { print(1) }
}
-- error --
'_' cannot be used in the condition of 'if'
-- case a_condition_refuses_a_placeholder.while --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    while _ { print(1) }
}
-- error --
'_' cannot be used in the condition of 'while'
-- case a_condition_refuses_a_placeholder.for_in --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    for x in _ { print(x) }
}
-- error --
'_' cannot be used in the sequence of 'for'
-- case a_condition_refuses_a_placeholder.for_loop --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    for var i = 0; _ < i; i = i + 1 { print(i) }
}
-- error --
'_' cannot be used in the condition of 'for'
-- case a_condition_refuses_a_placeholder.match --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    match _ { _ -> print(1) }
}
-- error --
'_' cannot be used in the value 'match' inspects
-- case a_condition_refuses_a_placeholder.match_on_a_field --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    match _.moons { _ -> print(1) }
}
-- error --
'_' cannot be used in the value 'match' inspects
-- case a_condition_refuses_a_placeholder.if_let --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    if let Some(x) = _ { print(x) }
}
-- error --
'_' cannot be used in the value a 'let' condition matches
-- case a_condition_refuses_a_placeholder.call_in_if --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    if Array.contains(_, 2) { print(1) }
}
-- error --
'_' cannot be used in the condition of 'if'
-- case a_condition_refuses_a_placeholder.call_in_for --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    for x in Array.map(xs, _) { print(x) }
}
-- error --
'_' cannot be used in the sequence of 'for'
-- case a_condition_refuses_a_placeholder.while_let --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    while let Some(x) = _ { print(x) }
}
-- error --
'_' cannot be used in the value a 'let' condition matches
-- case an_assignment_target_refuses_a_placeholder --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    var p = Planet { name = "x", moons = 0 }
    _.moons = 3
}
-- error --
'_' cannot be used in the target of an assignment
-- case a_nested_boundary_inside_a_condition_is_its_own --
-- The `_` belongs to the argument's function, not to the condition, so the
-- error is a type error about that function, not the refusal.
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    if Array.contains(xs, _ + 1) { print(1) }
}
-- error --
no instance for 'Eq (fun(_a) -> _a)'
-- case explicit_needs_a_placeholder --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    let g = \n + 1
}
-- error --
'\' has no '_' after it; remove the '\', or use '_' for the parameter
-- case a_nested_explicit_claims_every_placeholder_inside_it --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    print(Array.map(xs, \Array.map(xs, \_ * 10)))
}
-- error --
'\' has no '_' after it; remove the '\', or use '_' for the parameter
-- case a_non_final_placeholder_statement_is_a_discarded_function --
-- No rule of its own: a statement is a boundary, so `_ * n` is a
-- function, and a function is not a value a statement may drop.
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    _ * n
    print(1)
}
-- error --
this expression's value has type 'fun(Int) -> Int' and is discarded; use it, or write 'let _ = ...'
-- case a_mismatch_at_the_call_says_what_the_placeholder_meant.times --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    print(Array.map(xs, show(_ * 2)))
}
-- error --
expected 'fun(a) -> b', found 'String' in a function call, where '_' means 'fun($x) = $x * 2'
-- case a_mismatch_at_the_call_says_what_the_placeholder_meant.call --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    print(Array.map(xs, show(pow(_, 2))))
}
-- error --
expected 'fun(a) -> b', found 'String' in a function call, where '_' means 'fun($x) = pow($x, 2)'
-- case a_mismatch_at_the_call_says_what_the_placeholder_meant.field --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    print(Array.map([Planet { name = "a", moons = 1 }], show(_.name)))
}
-- error --
expected 'fun(a) -> b', found 'String' in a function call, where '_' means 'fun($x) = $x.name'
-- case a_mismatch_at_the_call_says_what_the_placeholder_meant.parenthesized --
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    print(Array.map(xs, show((_ + 1) * 2)))
}
-- error --
expected 'fun(a) -> b', found 'String' in a function call, where '_' means 'fun($x) = ($x + 1) * 2'
-- case a_mismatch_at_an_operator_says_what_the_placeholder_meant.left --
-- A bare `_` stops at its call, so the operator around the call is
-- where a function meets the value it was meant to make.
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    print(Array.map(xs, pow(_, 2) + "!"))
}
-- error --
expected 'fun(a) -> a', found 'String' in the operands of '+', where '_' means 'fun($x) = pow($x, 2)'
-- case a_mismatch_at_an_operator_says_what_the_placeholder_meant.right --
-- A bare `_` stops at its call, so the operator around the call is
-- where a function meets the value it was meant to make.
--@ error
-- Main.gob --
import Planets (..)

fun main() {
    let xs = [1, 2, 3]
    let n = 2
    print(Array.map(xs, "!" + pow(n, _)))
}
-- error --
expected 'String', found 'fun(a) -> a' in the operands of '+', where '_' means 'fun($x) = pow(n, $x)'
