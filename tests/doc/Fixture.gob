--- A module for `boot doc`'s golden: one of each kind of entity, and each
--- edge of the comment rule.
---
--- A bare `---` line continues a doc comment, as a paragraph break.

export (
    Point(..), Token, Pair, Measure(..), Box(..), (<+>),
    origin, counter, scale, twice, describe, undocumented,
    Shape(..), area,
)

-- An ordinary comment between the module comment and the imports.

import Shapes (Shape(..), area)

--- A point on the integer grid.
type Point : Eq = Point {
    --- Across.
    x : Int,
    var y : Int,
}

--- Opaque: its constructor is not exported.
type Token = Token(Int)

{- A block comment is never a doc comment, so `Pair` has none. -}
type Pair a = (a, a)

--- Something with a size.
class Measure m : Eq m {
    --- What a size is counted in.
    type Scale m

    --- How big a value is.
    fun size(m) -> Int

    -- An ordinary comment, so `bigger` has no doc comment.
    fun bigger(a : m, b : m) -> Bool = size(a) > size(b)
}

--- Points measure by their distance from the origin, in steps.
instance Measure Point {
    type Scale = Int
    fun size(p : Point) -> Int = p.x + p.y
}

--- A value in a box, with a doc comment on each constructor.
type Box a : Eq
    --- Nothing inside.
    = Empty
    --- Something inside.
    | Full(a)

instance Measure (Box a) : Eq a {
    type Scale = Int
    fun size(b : Box a) -> Int = match b {
        Empty -> 0
        Full(_) -> 1
    }
}

--- Adds two points.
infix Addition (<+>) = plus

fun plus(a : Point, b : Point) -> Point = Point { x = a.x + b.x, y = a.y + b.y }

--- Where the axes cross.
let origin = Point { x = 0, y = 0 }

--- A mutable counter.
var counter = 0

-- -- section headers and rules are ordinary comments -----------------------------
------------------------------------------------------------------------------------
fun scale(p : Point, k : Int) -> Point = Point { x = p.x * k, y = p.y * k }

--- Applies `f` twice. Its type is inferred.
fun twice(f, x) = f(f(x))

-- `describe` has only this ordinary comment.
fun describe[Show a](x : a) -> String = "<" + show(x) + ">"

fun undocumented() -> Int = 0
