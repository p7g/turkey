export (Tile(..), Paint(..), tiles)

--- A module `turkey doc` is not given, so `Fixture` and `Board`, which
--- import from it, show what they re-export of it in full.

import Shapes (Shape(..))

--- One square of a board.
type Tile
    --- Nothing on it.
    = Blank
    --- A wall of some height.
    | Wall(Int)
    --- A door, which may be locked.
    | Door {
        --- Whether it opens.
        locked : Bool,
    }

--- Something that can be drawn as text.
class Paint a {
    --- How it is drawn.
    fun paint(a) -> String
}

--- A tile is drawn as one character.
instance Paint Tile {
    fun paint(t : Tile) -> String = match t {
        Blank -> "."
        Wall(_) -> "#"
        Door { .. } -> "+"
    }
}

--- A shape is drawn as its first letter.
instance Paint Shape {
    fun paint(s : Shape) -> String = match s {
        Circle(_) -> "o"
        Square(_) -> "s"
    }
}

--- A number is drawn as its digits.
instance Paint Int {
    fun paint(n : Int) -> String = Int.toString(n)
}

--- A row of `n` blank tiles.
fun tiles(n : Int) -> Array Tile = Array.filled(n, Blank)
