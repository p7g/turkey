export (Shape(..), area, Sized(..), (<#>), Option(..))

--- Shapes, which `Fixture` re-exports.

--- A shape in the plane.
type Shape = Circle(Int) | Square(Int)

--- The area, rounded down, with pi taken as 3. An indented block is code:
---
---     area(Square(2)) == 4 && 1 < 2
fun area(s : Shape) -> Int = match s {
    Circle(r) -> 3 * r * r
    Square(side) -> side * side
}

--- Something with a size in whole units.
class Sized a {
    --- The size.
    fun sizeOf(a) -> Int

    fun isEmpty(x : a) -> Bool = sizeOf(x) == 0
}

instance Sized Shape {
    fun sizeOf(s : Shape) -> Int = area(s)
}

--- The larger of two areas. Its name needs encoding in a URL.
infix Addition (<#>) = larger

fun larger(a : Shape, b : Shape) -> Int = if area(a) > area(b) { area(a) } else { area(b) }
