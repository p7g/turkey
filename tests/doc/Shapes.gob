export (Shape(..), area, Sized(..), (<#>), Option(..))

--- # Shapes
---
--- Shapes, which `Fixture` re-exports. The index skips the heading above for
--- this summary.

--- A shape in the plane.
type Shape = Circle(Int) | Square(Int)

--- The area, rounded down, with pi taken as 3. An indented block is code:
---
---     area(Square(2)) == 4 && 1 < 2
fun area(s : Shape) -> Int = match s {
    Circle(r) -> 3 * r * r
    Square(side) -> side * side
}

--- Something with a size in whole units, *never* negative.
---
--- ```turkey
--- sizeOf(Circle(1)) == 3 -- "pi" is 3
--- ```
---
--- ```text
--- fun is not highlighted here
--- ```
---
--- An untagged fence is Turkey, and highlighting stops where lexing does:
---
--- ```
--- let s = "never closed
--- fun after(x) = x
--- ```
class Sized a {
    --- The size.
    fun sizeOf(a) -> Int

    fun isEmpty(x : a) -> Bool = sizeOf(x) == 0
}

instance Sized Shape {
    fun sizeOf(s : Shape) -> Int = area(s)
}

--- An instance on a built-in type.
instance Sized Int {
    fun sizeOf(n : Int) -> Int = n
}

--- An instance on a tuple, whose address needs encoding in a URL.
instance Sized (a, b) {
    fun sizeOf(p : (a, b)) -> Int = 2
}

--- The larger of two areas. Its name needs encoding in a URL.
infix Addition (<#>) = larger

fun larger(a : Shape, b : Shape) -> Int = if area(a) > area(b) { area(a) } else { area(b) }
