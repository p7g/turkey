class Shape a : Show a {
	fun area(a) -> Float
	fun perimeter(a) -> Float

	fun describe(shape : a) -> String = show(shape) + " with area " + Float.toString(area(shape))
}
instance Shape Circle {
	fun area(c) = 3.14 * c.r * c.r
	fun perimeter(c) = 2.0 * 3.14 * c.r
}
class Container f {
	type Elem f
	fun empty() -> f
}
