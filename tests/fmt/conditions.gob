fun pair(environment : Env, x : String, y : String) -> Option Int {
    if let Some(a) = lookup(environment, x) { return Some(a.depth) }
    if let Some(a) = lookupVariable(environment, x), let Some(b) = lookupVariable(environment, y), a.depth < b.depth {
        return Some(b.depth - a.depth)
    }
    None
}
fun drain(lexer : Lexer) {
    while let Some(t) = next(lexer), t.kind != Eof { push(t) }
    while let Some(token) = nextSignificantToken(lexer), let Word(text) = token.kind, text != terminator {
        push(token)
    }
}
fun first(xs : Array Int) -> Int {
    let Some(x) = Array.get(xs, 0) else { return 0 }
    let Some(y) = Array.get(xs, 1) else {
        return x
    }
    x + y
}
fun bump(o : Option Int) -> Int {
    if var Some(n) = o {
        n = n + 1
        n
    } else {
        0
    }
}
