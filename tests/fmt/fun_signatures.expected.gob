fun double(x : Int) -> Int = x * 2
fun lowerArm(
	context : Context,
	arm : MatchArm,
	scrutinee : Expr,
	fallthrough : Label,
	depth : Int,
) -> Core.Expr {
	lower(context, arm)
}
fun isIdentStart(character : Char) -> Bool =
	Char.isLetter(character) || character == '_' || character == '\''
fun isIdentContinue(character : Char) -> Bool =
	Char.isLetter(character)
		|| Char.isDigit(character)
		|| character == '_'
		|| character == '\''
		|| character == '!'
fun answer() {
	42
}
fun member[Eq a](xs : Array a, x : a) -> Bool = Iter.any(xs, _ == x)
fun usage(program : String) -> String =
	"usage: turkey fmt [--check] FILE... -- rewrites each FILE in place, or with --check names the files it would change"
