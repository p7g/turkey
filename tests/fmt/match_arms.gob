fun binaryMethod(op : String) -> Option String = match op {
    "+" -> Some("add")
    "-" -> Some("sub")
    "**" -> Some("pow")
    _ -> None
}

fun eval(e : Expr) -> Int = match e {
    Lit(n) -> n
    Var(name) -> lookup(name)
    Add(left, right) -> {
        let x = eval(left)
        x + eval(right)
    }
    Neg(a) -> -eval(a)

    -- the rest are binary
    Mul(a, b) -> eval(a) * eval(b)
    _ -> 0
}

fun startsDecl(token : Token) -> Bool = match token {
    Keyword("fun") | Keyword("let") | Keyword("var") | Keyword("type") | Keyword("class") | Keyword("instance") -> true
    _ -> false
}

fun declare(token : Token) = match token {
    Keyword("fun") | Keyword("let") | Keyword("var") | Keyword("type") | Keyword("class") | Keyword("instance") -> {
        startDecl(token)
    }
    _ -> {}
}
