type Token = Token {
    kind : Kind,
    text : String,
    start : Int,
}
fun make(name : String) -> Token {
    Token {
        kind = Ident,
        text = name,
        start = 0,
    }
}
fun long() -> Token {
    Token { kind = Ident, text = "a name long enough to push this literal past the width", start = 0 }
}
