type Color = Red|Green|Blue
type Direction
    = North
    | South
type Expr = Lit(Int) | Var(String) | Add(Expr, Expr) | Lambda { param : String, body : Expr } | Call(Expr, Array Expr)
type Decl = Fun(FunDecl) | Record {
    name : String
    fields : Array Field
}
type Shape:Eq, Show = Circle(Float) | Rect { w:Float, h:Float }
type Name = String
type Pair a b = Pair(a, b)
