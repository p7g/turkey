fun route(orders : Orders, req : Request Incoming) -> Either APIError ServerResponse = match (req.method, req.target.path) {
    (Get, "/orders") -> listOrders(orders)
    (Post, "/orders") -> createOrder(orders, req.body)
    _ -> Left(NotFound(req.target.path))
}

fun label(n : Int) -> String = match n {
    0 -> "none"
    _ -> "some"
}

fun describe(event : Event) -> String = match event {
    Moved(from, to) -> match (distanceBetween(from, to), directionFrom(from, to), elapsedSince(from)) {
        (0, _, _) -> "stayed"
        (d, dir, t) -> "moved " + show(d) + " " + show(dir) + " in " + show(t)
    }
    Stopped -> "stopped"
}

fun summarize(report : Report) -> String {
    let headline = match (report.title, report.author, report.publishedOn, report.revision) {
        (t, a, _, 0) -> t + " by " + a
        (t, a, _, r) -> t + " by " + a + ", revision " + show(r)
    }
    let response = match (requestMethodName, requestTargetPathAndQuery, requestBodyLength, requestId) {
        _ -> 1
    }
    let rest = match (report.sections, report.appendices, report.footnotes, report.references, report.figures) {
        _ -> ""
    }
    headline + rest + show(response)
}
