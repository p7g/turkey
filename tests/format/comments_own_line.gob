-- Helpers for the lexer.

import Data.Set


-- The widest line the printer fills.
let width = 100
    -- columns a tab counts for
let tab = 4
fun main() {
        -- say hello
    print("hello")
  {- a block comment
     whose interior stays put -}
    print(width)
    --no space here stays as written
    print(tab)
        -- a note at the end of the block
}
