fun sortOn[Ord k](xs : Array a, key : fun(a) -> k) -> Array a =
	Array.sortBy(xs, fun(x, y) = compare(key(x), key(y)))

fun serve[
	Listener l,
	Connection (Accepted l),
	HasConnectionInfo (Accepted l),
	Error (ReadError (Accepted l)),
	Error (WriteError (Accepted l)),
](listener : l, handler : Handler) -> Unit {
	run(listener, handler)
}

fun applyParams[
	Iterator p,
	Length p,
	Item p ~ CParam,
	Index c,
	Key c ~ Int,
	Value c ~ Core,
	Iterator c,
	Item c ~ Core,
](params : p, args : c) -> Core = build(params, args)
