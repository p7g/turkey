fun describe(n : Int) -> String {
    if n == 0 {
        "zero"
    }
    else if n == 1 { "one" }
    else {
        "many"
    }
}
fun sign(n : Int) -> Int = if n < 0 { -1 } else { 1 }
fun classify(n : Int) -> String {
    if n < 0 {
        "negative"
    }
    -- zero counts as small
    else if n < 10 {
        "small"
    } else {
        "large"
    }
}
