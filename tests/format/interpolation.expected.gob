fun main() {
	let year = 2026
	print("https://adventofcode.com/${year}/day/${year + 1}/input")
	print("${Array.map([1, 2, 3], fun(x) = x * 2)} and ${"in${year}ner"}")
	let veryLongName = "x"
	print("a literal that runs past the line width limit ${veryLongName + veryLongName + veryLongName} and on")
	print("a \${b} \$ $c")
	print("${ {- first -} year} and ${year {- last -} }")
}
