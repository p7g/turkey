-- A method call prints as written; its arguments break as a call's do.
fun main() -> Unit {
	let xs = [1, 2, 3]
	print(
		xs.map(fun(x) {
			x + 1
		}).filter(fun(x) = x > 2),
	)
	print(
		"a long receiver string that goes on".replaceAll(
			"long receiver string",
			"short one which is also quite long indeed",
		),
	)
	print((xs.len)(), xs.len())
}
