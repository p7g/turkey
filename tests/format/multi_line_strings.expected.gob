fun usage() -> String {
	let text = """
	    usage: turkey build FILE
	      -o OUT   write to OUT   
	    """
	text
		+ """
		  and more
		  """
}

fun main() { write(usage()) }

fun shallow() -> String {
	"""
  stays where it is, since its closing line is indented less than its first
  """
}

fun greet(name : String) -> String {
	let n = String.codePointCount(name)
	"""
	    hello, ${name}
	      ${n} letters, ${ {- a comment -} n * 2} in all
	    """
}
