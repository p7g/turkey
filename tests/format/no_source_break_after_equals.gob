fun fromInt(code : Int) -> Option Char = if Prim.charIsScalar(code) {
    Some(Prim.charFromInt(code))
} else {
    None
}

fun next(n : Int) -> Int = n + 1

fun sign(n : Int) -> String = match n {
    0 -> "zero"
    _ -> if n < 0 { "negative" } else { "positive" }
}

