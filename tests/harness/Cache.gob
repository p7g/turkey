export (Cache(..), Compiled(..), open, compile, evict, panicked)

-- Compiled programs, kept on disk under `ROOT/compile/KEY/` and shared by
-- every run, worktree and concurrent session on the machine.
--
-- **The key** is SHA-256 over what a compile depends on: the `boot` binary's
-- bytes; the library, by name and contents, since a library module the
-- compiler itself never uses is in no byte of `boot`, but a program that
-- imports it compiles differently when it changes; the toolchain's identity
-- (`Toolchain.identity`); the arguments `boot` is given; the case's own
-- environment, which `boot` runs under; and each of the case's sources by
-- name and contents. Running is not cached: it is what is
-- being tested.
--
-- **An entry is published whole.** It is filled in a fresh directory of its
-- own and renamed into place, under an advisory lock on `KEY.lock`, so a
-- concurrent compile of the same key waits and then finds the entry, and no
-- reader ever sees half of one. What is kept is a compile that answered: a
-- linked binary and `boot`'s warnings, an acceptance by `boot check` and its
-- warnings, or a refusal and its diagnostic. A crash or a timeout is not
-- kept, so it is tried again next run.
--
-- **Eviction runs when the harness starts.** A hit rewrites the entry's
-- `used` file, and an entry whose `used` is 7 days old is removed, as is a
-- directory of a case's files under `ROOT/reference/` or `ROOT/cases/`
-- (`Files.writeOut`). Of the builds `scripts/test.sh` keeps (`boot/`,
-- `stage1/`, `harness/`), all but the 8 most recently used are removed. Nothing used in the last hour is ever
-- removed, so a concurrent session never loses what it is using.

import Hash.SHA256 as SHA256
import Process (Output(..), Status(..))
import Process as Process
import System.File as File
import Time.Duration (Duration)
import Time.Duration as Duration
import Time.Instant as Instant
import Time.Sleep as Sleep
import Case (Case(..))
import Files as Files
import Toolchain (Toolchain(..))
import Toolchain as Toolchain
import Iter

type Cache = Cache { root : String, base : String }

-- What a compile came to: a binary and the warnings `boot` printed; for a
-- case that is only checked, `boot check` accepting it, with its warnings; a
-- refusal, with `boot`'s exit status and diagnostic; `boot` crashing, or the
-- link failing, with why and what it printed; or running out of time.
type Compiled = Built(String, String) | Accepted(String) | Refused(Int, String)
              | Crashed(String, String) | Overran(String)

-- The cache under `root`, with the part of every key that does not depend
-- on the case worked out once.
fun open(root : String, t : Toolchain) -> Either SomeError Cache {
    let h = SHA256.new()
    let boot = Files.readBytes(t.boot)?
    SHA256.update(h, boot, 0, len(boot))
    let library = Files.filesUnder(t.lib)?
    feed(h, t.lib, Array.filter(library, \String.endsWith(_, ".gob") && !String.contains(_, "Probe_")))?
    SHA256.updateText(h, t.identity)
    Right(Cache { root = root, base = SHA256.hex(SHA256.finish(h)) })
}

-- Each of `names`, a path relative to `directory`, by name and contents.
fun feed(h : SHA256.SHA256, directory : String, names : Array String) -> Either SomeError Unit {
    for name in names {
        let bytes = Files.readBytes(directory + "/" + name)?
        SHA256.updateText(h, name + "\u{0}" + Int.toString(len(bytes)) + "\u{0}")
        SHA256.update(h, bytes, 0, len(bytes))
    }
    Right(())
}

fun keyOf(cache : Cache, c : Case, argv : Array String) -> Either SomeError String {
    let h = SHA256.new()
    SHA256.updateText(h, cache.base + "\u{0}" + String.join(argv, " ") + "\u{0}")
    for (name, value) in c.environment { SHA256.updateText(h, name + "=" + value + "\u{0}") }
    feed(h, c.directory, c.sources)?
    Right(SHA256.hex(SHA256.finish(h)))
}

-- Whether `stderr` holds a panic: a line starting `panic: `.
fun panicked(stderr : String) -> Bool =
    Iter.any(String.lines(stderr), String.startsWith(_, "panic: "))

-- `c` compiled and linked, from the cache or now. `Left` is a harness error:
-- a source that cannot be read, or a cache that cannot be written.
fun compile(cache : Cache, t : Toolchain, c : Case) -> Either SomeError Compiled {
    let flags = if c.checkOnly { ["check"] }
                else if t.executables { ["build", "-f", "exe"] }
                else { ["build", "-f", "obj"] }
    let key = keyOf(cache, c, flags)?
    let entry = cache.root + "/compile/" + key
    if let Some(found) = load(entry, c.checkOnly) { return Right(found) }
    Files.writeText(entry + ".lock", "")?
    let lockFile = Error.promote(File.openReadWrite(entry + ".lock"))?
    -- `tryLock` and a sleep rather than `lock`. `lock` waits in `flock`, which
    -- takes its worker out of the pool until the lock comes free; a few cases
    -- waiting on one key can take every worker, and the case holding the lock
    -- in this process then has none to finish on. A sleep suspends only the
    -- task.
    loop {
        match File.tryLock(lockFile) {
            Right(True) -> break
            Right(False) -> Sleep.sleep(Duration.millis(50))
            Left(e) -> {
                let _ = File.close(lockFile)
                return Left(fail(e))
            }
        }
    }
    let result = match load(entry, c.checkOnly) {
        Some(found) -> Right(found)
        None -> build(t, c, flags, entry)
    }
    let _ = File.close(lockFile)
    result
}

-- The entry at `entry`, marked used, if there is one. `checked` is whether
-- it is a `boot check`, which keeps no binary.
fun load(entry : String, checked : Bool) -> Option Compiled {
    let status = Either.right(Files.readText(entry + "/status"))?
    let stderr = Either.unwrapOr(Files.readText(entry + "/stderr"), "")
    let _ = Files.writeText(entry + "/used", Int.toString(Instant.unixNanos(Instant.now())))
    match Int.parse(status) {
        Some(0) -> Some(if checked { Accepted(stderr) } else { Built(entry + "/bin", stderr) })
        Some(code) -> Some(Refused(code, stderr))
        None -> None
    }
}

fun build(t : Toolchain, c : Case, flags : Array String, entry : String)
    -> Either SomeError Compiled {
    let staging = Error.promote(File.temporaryDir("turkey-test-"))?
    let compiled = runBoot(t, c, flags, staging)
    let published = match compiled {
        Built(_, stderr) -> publish(staging, entry, 0, stderr)
        Accepted(stderr) -> publish(staging, entry, 0, stderr)
        Refused(code, stderr) -> publish(staging, entry, code, stderr)
        _ -> Right(())
    }
    let _ = File.removeTree(staging)
    published?
    Right(match compiled {
        Built(_, stderr) -> Built(entry + "/bin", stderr)
        other -> other
    })
}

-- `boot` on the case, writing its object and then the linked binary into
-- `staging`, or under `--exe` the binary alone; or, for a case that is only
-- checked, `boot check` alone.
fun runBoot(t : Toolchain, c : Case, flags : Array String, staging : String) -> Compiled {
    let object = staging + "/main.o"
    let output = if c.checkOnly { [] }
                 else if t.executables { ["-o", staging + "/bin"] }
                 else { ["-o", object] }
    let argv = t.run + [t.boot] + flags + output + [c.entry]
    let limit = Toolchain.limit(t, 300)
    let compiled = match Process.run(Toolchain.caseCommand(t, c, argv), Some(limit)) {
        Left(e) -> return Crashed("boot did not start: " + Error.message(e), "")
        Right(out) -> out
    }
    let stderr = Toolchain.text(compiled.stderr)
    match compiled.status {
        TimedOut -> return Overran(stderr)
        Signaled(n) -> return Crashed("boot died by signal " + Int.toString(n), stderr)
        Exited(code) -> {
            if panicked(stderr) { return Crashed("boot panicked", stderr) }
            if code != 0 { return Refused(code, stderr) }
        }
    }
    if c.checkOnly { return Accepted(stderr) }
    if t.executables { return Built(staging + "/bin", stderr) }
    let link = Toolchain.linkCommand(t, object, staging + "/bin", c.directory)
    match Process.run(link, Some(limit)) {
        Right(Output { status = Exited(0), .. }) -> Built(staging + "/bin", stderr)
        Right(Output { status = TimedOut, stderr = linkErr, .. }) -> Overran(Toolchain.text(linkErr))
        Right(Output { stderr = linkErr, .. }) -> Crashed("the link failed", Toolchain.text(linkErr))
        Left(e) -> Crashed("the C compiler did not start: " + Error.message(e), "")
    }
}

-- Write the entry's status and diagnostic beside what is in `staging`, and
-- rename it into place. A rename that finds the entry there already lost a
-- race nobody should be able to run, since the lock is held; the entry that
-- won is as good, and the staging directory is removed by the caller.
fun publish(staging : String, entry : String, code : Int, stderr : String) -> Either SomeError Unit {
    Files.writeText(staging + "/stderr", stderr)?
    Files.writeText(staging + "/used", "")?
    -- `status` last: an entry is whole once it has one.
    Files.writeText(staging + "/status", Int.toString(code))?
    match File.rename(staging, entry) {
        Right(_) -> Right(())
        Left(e) -> if Files.exists(entry + "/status") { Right(()) } else { Left(fail(e)) }
    }
}

-- -- eviction -------------------------------------------------------------------------

let week : Duration = Duration.hours(24 * 7)

let hour : Duration = Duration.hours(1)

let buildsKept : Int = 8

fun evict(root : String) -> Unit {
    let compiled = root + "/compile"
    for name in Files.listed(compiled) {
        let path = compiled + "/" + name
        if String.endsWith(name, ".lock") {
            -- A lock outlives its entry by a week, so whoever holds one is
            -- long gone.
            let entry = Option.unwrapOr(String.stripSuffix(path, ".lock"), path)
            if !Files.exists(entry) && olderThan(path, week) { let _ = File.removeFile(path) }
        } else if olderThan(path + "/used", week) {
            let _ = File.removeTree(path)
        }
    }
    for kind in ["reference", "cases"] {
        let written = root + "/" + kind
        for name in Files.listed(written) {
            let path = written + "/" + name
            if olderThan(path + "/used", week) { let _ = File.removeTree(path) }
        }
    }
    for kind in ["boot", "stage1", "harness"] {
        let directory = root + "/" + kind
        let names = Files.listed(directory)
        let newestFirst = Array.sortByKey(names, \ageOf(directory + "/" + _))
        for var i = buildsKept; i < len(newestFirst); i = i + 1 {
            let path = directory + "/" + newestFirst[i]
            if olderThan(path, hour) { let _ = File.removeTree(path) }
        }
    }
}

-- In nanoseconds, with what is gone counted as oldest.
fun ageOf(path : String) -> Int = match Files.age(path) {
    Some(d) -> Duration.toNanos(d)
    None -> Int.maxValue()
}

fun olderThan(path : String, d : Duration) -> Bool = match Files.age(path) {
    Some(a) -> a > d
    None -> False
}
