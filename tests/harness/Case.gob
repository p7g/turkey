export (
    Case(..), Expected(..), Golden(..), Quote(..), Archived(..), Section(..), Expectation(..),
    Requirement(..), Outcome(..), Result(..), Finish(..), Ending(..), Observed(..), Recorded(..),
    directives, requirementName, outcomeName, failsRun, passed, disagreement, printed,
    expectationName,
)

--- What a test is, whatever source it came from, and what can become of it.
---
--- Every source of cases is a function from a path to an `Array Case`, and the
--- runner sees nothing else. A case that cannot be run as written -- an
--- unknown directive, an entry that cannot be read -- is still a case,
--- carrying its `problem`, so that it is reported as a harness error in its
--- place rather than dropped.

--- How a case must end. Without a directive saying otherwise, a program
--- compiles, runs and exits 0.
type Expected = Exits(Int) | Panics | Rejected

--- What a case's output is compared with. `OnDisk` is the path of an
--- `.expected` golden, stdout then stderr, compared exactly; bless writes it.
--- `Quoted` is what a reference example's chapter says of it, which a person
--- writes and bless never does. `InArchive` is the expectation sections of a
--- case in a `.cases` archive, each compared exactly; bless rewrites them in
--- place.
type Golden = OnDisk(String) | Quoted(Quote) | InArchive(Archived)

--- What a reference example's chapter quotes: the program's stdout, compared
--- exactly; a part of its diagnostic or panic message, which the message
--- must contain; and its stderr, the panic and its trace, compared exactly.
type Quote = Quote { stdout : Option String, message : Option String, stderr : Option String }

--- Where an archive case's expectations are in its archive, and what they
--- say. Lines count from 0. Bless needs the lines to rewrite a section without
--- touching the rest of the file, and the case's expansions under a matrix
--- share them, as they share one place in the archive.
type Archived = Archived {
    --- The archive, as an absolute path.
    path : String,
    --- The line of the case's `-- case NAME --` header.
    origin : Int,
    --- The case's expectation sections, in archive order.
    sections : Array Section,
    --- The line after the case's last section, where bless inserts a section
    --- the case does not have yet.
    end : Int,
    --- The modules the case is made of, by module name: a dump section holds
    --- only their entries.
    modules : Array String,
}

--- One expectation section: which it is, and its body, which is lines `from`
--- up to but not including `to`, the header being the line before `from`.
type Section = Section { expectation : Expectation, from : Int, to : Int, text : String }

--- What an expectation section holds: the program's stdout or stderr; each
--- diagnostic's message, without its place and stage, one to a line; a
--- panic's message, without `panic: ` and the trace; or a dump, filtered to
--- the case's own declarations.
type Expectation = StdoutText | StderrText | ErrorText | PanicText | TypesDump | KindsDump | ClassesDump

--- Returns the name an expectation's section header gives it.
fun expectationName(e : Expectation) -> String = match e {
    StdoutText -> "stdout"
    StderrText -> "stderr"
    ErrorText -> "error"
    PanicText -> "panic"
    TypesDump -> "types"
    KindsDump -> "kinds"
    ClassesDump -> "classes"
}

--- What a case may need of the machine: a C compiler, an assembler, or one
--- system.
type Requirement = Cc | As | Darwin | Linux

fun requirementName(r : Requirement) -> String = match r {
    Cc -> "cc"
    As -> "as"
    Darwin -> "darwin"
    Linux -> "linux"
}

fun requirement(name : String) -> Option Requirement = match name {
    "cc" -> Some(Cc)
    "as" -> Some(As)
    "darwin" -> Some(Darwin)
    "linux" -> Some(Linux)
    _ -> None
}

type Case = Case {
    --- What the report and a selection call it: the path from the repository
    --- root to the case's file or directory.
    name : String,
    --- Where `boot` and the compiled program run, so that diagnostics name the
    --- bare file.
    directory : String,
    --- The entry module, relative to `directory`.
    entry : String,
    --- Every file the compile reads besides the library, relative to
    --- `directory`: the cache key is made of these.
    sources : Array String,
    golden : Golden,
    --- Dump goldens, as (stage, path): `boot check --dump STAGE` must print
    --- exactly that file and exit 0. For an archive case the path is the
    --- archive's, and the golden is its section.
    dumps : Array (String, String),
    expected : Expected,
    --- How long the compiled program may run, in seconds, before `--timeout-scale`.
    timeout : Option Int,
    --- The case is skipped unless each holds.
    requires : Array Requirement,
    --- The reason the case is expected to fail its comparison.
    xfail : Option String,
    problem : Option String,
    --- Whether `boot check` is run on the case in place of a build, so that
    --- nothing is linked or run.
    checkOnly : Bool,
    --- Set in the environment of every process the case runs, after the
    --- harness's own settings, so that it may override them.
    environment : Array (String, String),
}

--- Every outcome is reported distinctly. `CompilerCrash` is `boot` dying by a
--- signal or panicking, which is never a diagnostic a case can expect;
--- `ProgramCrash` is the compiled program dying by a signal. A panic is an
--- exit, not a crash: whether it was wanted is the directive's to say.
type Outcome = Pass | Fail | CompilerCrash | ProgramCrash | Timeout | Skip | XFail | XPass
             | HarnessError

-- No wildcard arm, so a new constructor without a rank fails to compile rather
-- than comparing equal to the wrong outcome.
fun rank(o : Outcome) -> Int = match o {
    Pass -> 0
    Fail -> 1
    CompilerCrash -> 2
    ProgramCrash -> 3
    Timeout -> 4
    Skip -> 5
    XFail -> 6
    XPass -> 7
    HarnessError -> 8
}

instance Eq Outcome { fun eq(a, b) = rank(a) == rank(b) }

--- What became of one case: `why` in a few words, `diff` the unified diff of
--- expected against actual (empty when there is none to show), and how long it
--- took.
type Result = Result { outcome : Outcome, why : String, diff : String, millis : Int }

fun outcomeName(o : Outcome) -> String = match o {
    Pass -> "pass"
    Fail -> "fail"
    CompilerCrash -> "compiler crash"
    ProgramCrash -> "program crash"
    Timeout -> "timeout"
    Skip -> "skip"
    XFail -> "xfail"
    XPass -> "xpass"
    HarnessError -> "harness error"
}

--- Whether the outcome makes the run fail. A skip and an expected failure do
--- not; an unexpected pass does, since the `xfail` it contradicts is stale.
fun failsRun(o : Outcome) -> Bool = match o {
    Pass | Skip | XFail -> False
    _ -> True
}

fun passed(o : Outcome) -> Bool = match o {
    Pass -> True
    _ -> False
}

-- -- what a run produced ------------------------------------------------------------

--- How one process ended: it exited with a status, printed a panic and exited
--- with a status, died by a signal, or was killed at its time limit.
type Finish = Returned(Int) | Panicked(Int) | Killed(Int) | Expired

--- How a case's compile and run ended. `CompileCrash` is `boot` dying by a
--- signal or panicking, or the link failing, with why; `CompileExpired` is
--- either of them running out of time; `Diagnosed` is `boot` refusing the
--- program, with its exit status; `Checked` is `boot check` accepting a case
--- that is only checked; `Ran` is how the compiled program ended.
type Ending = CompileCrash(String) | CompileExpired | Diagnosed(Int) | Checked | Ran(Finish)

--- What a run of a case produced. `stdout` is the program's; `stderr` is the
--- compile's warnings and then the program's stderr, or a failed compile's
--- diagnostic. `dumps` holds how each dump stage ended, its stdout and its
--- stderr, in the order of `Case.dumps`. It is empty when the compile crashed
--- or ran out of time, since no dump is run then.
type Observed = Observed {
    ending : Ending,
    stdout : String,
    stderr : String,
    dumps : Array (Finish, String, String),
}

--- Returns what an `.expected` golden is compared with: stdout, then stderr.
fun printed(o : Observed) -> String = o.stdout + o.stderr

--- A case's goldens as they are on disk: the `.expected` file, if there is
--- one, and each dump golden, in the order of `Case.dumps`.
type Recorded = Recorded { expected : Option String, dumps : Array String }

--- Returns why `ending` is not the end that the directive `expected` names,
--- or `None` if it is. Only a diagnostic, an exit and a panic are compared;
--- for a crash or a timeout this returns `None`, and the caller classifies
--- those first.
fun disagreement(expected : Expected, ending : Ending) -> Option String = match (expected, ending) {
    (_, CompileCrash(_)) | (_, CompileExpired) | (_, Ran(Killed(_))) | (_, Ran(Expired)) -> None
    (Rejected, Diagnosed(_)) -> None
    (Rejected, _) -> Some("compiled, but the case expects a compile error")
    (_, Diagnosed(_)) -> Some("did not compile")
    -- A case that is only checked is never run, so whether it compiled is
    -- all there is to compare.
    (_, Checked) -> None
    (Exits(n), Ran(Returned(code))) ->
        if code == n { None } else { Some("exited " + Int.toString(code) + ", not " + Int.toString(n)) }
    (Exits(_), Ran(Panicked(_))) -> Some("panicked")
    (Panics, Ran(Panicked(code))) -> if code != 0 { None } else { withoutPanic(code) }
    (Panics, Ran(Returned(code))) -> withoutPanic(code)
}

fun withoutPanic(code : Int) -> Option String =
    Some("exited " + Int.toString(code) + " without the panic the case expects")

-- -- directives -----------------------------------------------------------------------

--- What a case's `--@` lines say, applied to `base`. A directive is a line
--- that starts `--@`, then a name, then `: value` if it takes one; to Turkey
--- it is a comment. The set is closed: a name not listed here, a value that
--- does not parse, or two outcome directives make the case a harness error
--- rather than being ignored, since a misspelt directive that did nothing
--- would leave a case checking less than it says.
---
--- Directives are read wherever they are in the file, not only above the
--- first declaration.
fun directives(base : Case, text : String) -> Case {
    var expected = None
    var timeout = None
    let requires = []
    var xfail = None
    var problem = None
    for line in String.lines(text) {
        let rest = match String.stripPrefix(line, "--@") {
            Some(r) -> String.trim(r)
            None -> continue
        }
        let (name, value) = match String.splitOnce(rest, ":") {
            Some((n, v)) -> (String.trim(n), Some(String.trim(v)))
            None -> (rest, None)
        }
        match directive(name, value) {
            Left(why) -> { if Option.isNone(problem) { problem = Some(why) } }
            Right(Ends(e)) -> {
                if Option.isSome(expected) && Option.isNone(problem) {
                    problem = Some("more than one of 'exit', 'panic' and 'error'")
                }
                expected = Some(e)
            }
            Right(TimesOut(n)) -> { timeout = Some(n) }
            Right(Requires(r)) -> Vec.push(requires, r)
            Right(Fails(reason)) -> { xfail = Some(reason) }
        }
    }
    Case {
        name = base.name,
        directory = base.directory,
        entry = base.entry,
        sources = base.sources,
        golden = base.golden,
        dumps = base.dumps,
        expected = Option.unwrapOr(expected, Exits(0)),
        timeout = timeout,
        requires = Vec.toArray(requires),
        xfail = xfail,
        problem = Option.or(problem, base.problem),
        checkOnly = base.checkOnly,
        environment = base.environment,
    }
}

-- One `--@` line.
type Directive = Ends(Expected) | TimesOut(Int) | Requires(Requirement) | Fails(String)

fun directive(name : String, value : Option String) -> Either String Directive = match (name, value) {
    ("exit", Some(v)) -> match Int.parse(v) {
        Some(n) -> Right(Ends(Exits(n)))
        None -> Left("'exit' takes a number, not '" + v + "'")
    }
    ("panic", None) -> Right(Ends(Panics))
    ("error", None) -> Right(Ends(Rejected))
    ("timeout", Some(v)) -> {
        let n = Option.unwrapOr(Int.parse(v), 0)
        if n > 0 { Right(TimesOut(n)) }
        else { Left("'timeout' takes a whole number of seconds, not '" + v + "'") }
    }
    ("requires", Some(v)) -> match requirement(v) {
        Some(r) -> Right(Requires(r))
        None -> Left("'requires' takes cc, as, darwin or linux, not '" + v + "'")
    }
    ("xfail", Some("")) -> Left("'xfail' needs a reason")
    ("xfail", Some(v)) -> Right(Fails(v))
    ("exit", None) | ("timeout", None) | ("requires", None) | ("xfail", None) ->
        Left("'" + name + "' needs a value")
    ("panic", Some(_)) | ("error", Some(_)) -> Left("'" + name + "' takes no value")
    _ -> Left("unknown directive '" + name + "'")
}
