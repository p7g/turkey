module Diff (unified)

-- A unified diff of an expected text against an actual one, line by line,
-- with three lines of context, as `diff -u` prints it.
--
-- The edit script is a longest common subsequence over what is left once the
-- lines both texts start and end with are set aside. The table for that is
-- the product of the two remainders' lengths, so past `tableLimit` cells the
-- remainder is shown as all removed and all added instead: a correct diff,
-- only not a minimal one, and a golden that different is read whole from the
-- actual results anyway. Myers' algorithm would avoid the table, at several
-- times the code.

type Edit = Same(String) | Removed(String) | Added(String)

let context : Int = 3

let tableLimit : Int = 4000000

-- The diff, cut to `limit` lines; "" when the texts are equal.
fun unified(expected : String, actual : String, limit : Int) -> String {
    if expected == actual { return "" }
    let a = linesOf(expected)
    let b = linesOf(actual)
    let edits = script(a, b)
    let out = []
    Vec.push(out, "--- expected")
    Vec.push(out, "+++ actual")
    hunks(edits, out)
    if len(out) == 2 {
        Vec.push(out, "(they differ only in whether the last line ends in a newline)")
    }
    let shown = if len(out) <= limit { out }
                else { Vec.slice(out, 0, limit) + ["... " + Int.toString(len(out) - limit) + " more lines"] }
    String.unlines(shown)
}

-- The lines of `s`, without a last empty one after a final newline.
fun linesOf(s : String) -> Array String {
    let parts = String.split(s, "\n")
    if len(parts) > 0 && String.isEmpty(parts[len(parts) - 1]) { let _ = Vec.pop(parts) }
    Vec.toArray(parts)
}

fun script(a : Array String, b : Array String) -> Vec Edit {
    var front = 0
    while front < len(a) && front < len(b) && a[front] == b[front] { front = front + 1 }
    var back = 0
    while back < len(a) - front && back < len(b) - front
          && a[len(a) - 1 - back] == b[len(b) - 1 - back] {
        back = back + 1
    }
    let edits = []
    for line in Array.slice(a, 0, front) { Vec.push(edits, Same(line)) }
    middle(Array.slice(a, front, len(a) - back), Array.slice(b, front, len(b) - back), edits)
    for line in Array.slice(a, len(a) - back, len(a)) { Vec.push(edits, Same(line)) }
    edits
}

fun middle(a : Array String, b : Array String, edits : Vec Edit) -> Unit {
    let n = len(a)
    let m = len(b)
    if n * m > tableLimit {
        for line in a { Vec.push(edits, Removed(line)) }
        for line in b { Vec.push(edits, Added(line)) }
        return
    }
    -- `common[i * (m + 1) + j]` is the length of the longest common
    -- subsequence of `a` from `i` and `b` from `j`.
    let width = m + 1
    let common = Array.filled((n + 1) * width, 0)
    for var i = n - 1; i >= 0; i = i - 1 {
        for var j = m - 1; j >= 0; j = j - 1 {
            common[i * width + j] = if a[i] == b[j] { common[(i + 1) * width + j + 1] + 1 }
                else { max(common[(i + 1) * width + j], common[i * width + j + 1]) }
        }
    }
    var i = 0
    var j = 0
    while i < n || j < m {
        if i < n && j < m && a[i] == b[j] {
            Vec.push(edits, Same(a[i]))
            i = i + 1
            j = j + 1
        } else if j == m || (i < n && common[(i + 1) * width + j] >= common[i * width + j + 1]) {
            Vec.push(edits, Removed(a[i]))
            i = i + 1
        } else {
            Vec.push(edits, Added(b[j]))
            j = j + 1
        }
    }
}

fun changed(e : Edit) -> Bool = match e {
    Same(_) -> False
    _ -> True
}

-- Each run of changes with `context` lines either side, runs closer than
-- twice that merged, under an `@@ -a,n +b,m @@` header.
fun hunks(edits : Vec Edit, out : Vec String) -> Unit {
    -- The line of each text an edit is at, counting from 1.
    let atA = Array.filled(len(edits) + 1, 1)
    let atB = Array.filled(len(edits) + 1, 1)
    for var k = 0; k < len(edits); k = k + 1 {
        let (da, db) = match edits[k] {
            Same(_) -> (1, 1)
            Removed(_) -> (1, 0)
            Added(_) -> (0, 1)
        }
        atA[k + 1] = atA[k] + da
        atB[k + 1] = atB[k] + db
    }
    var k = 0
    while k < len(edits) {
        if !changed(edits[k]) {
            k = k + 1
            continue
        }
        let start = max(k - context, 0)
        -- The end of the hunk: past the last change that is within twice the
        -- context of the one before it.
        var last = k
        var probe = k + 1
        while probe < len(edits) && probe <= last + 2 * context {
            if changed(edits[probe]) { last = probe }
            probe = probe + 1
        }
        let stop = min(last + 1 + context, len(edits))
        Vec.push(out, "@@ -" + range(atA[start], atA[stop] - atA[start]) + " +"
                      + range(atB[start], atB[stop] - atB[start]) + " @@")
        for var e = start; e < stop; e = e + 1 {
            Vec.push(out, match edits[e] {
                Same(line) -> " " + line
                Removed(line) -> "-" + line
                Added(line) -> "+" + line
            })
        }
        k = stop
    }
}

-- `diff -u`'s spelling of a range: an empty one is numbered by the line
-- before it, and a one-line one has no count.
fun range(from : Int, count : Int) -> String =
    if count == 0 { Int.toString(from - 1) + ",0" }
    else if count == 1 { Int.toString(from) }
    else { Int.toString(from) + "," + Int.toString(count) }
