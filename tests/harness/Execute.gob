export (execute, diffLimit)

--- One case, compiled, run and compared: its outcome, and what `--bless`
--- would do with it.
---
--- A case is compiled by `boot` from its own directory, so a diagnostic names
--- the file by its bare name, then linked by the C compiler, then run in that
--- directory under `$TURKEY_RUN` (`Cache.compile`, `Toolchain.command`). What
--- it printed -- stdout, then the compile's warnings and the program's stderr
--- -- must equal the golden exactly, and how it ended must be what its
--- directive says. Then each dump golden is checked against `boot check
--- --dump STAGE`, which is not cached, since the dump is what is tested.
---
--- A reference example is judged on what its chapter quotes instead
--- (`Reference`): its stdout exactly, and a part of its message. An archive
--- case is judged on its expectation sections (`Archive`), each exactly.
---
--- Running a case and judging it are separate: `observe` runs the processes
--- and gathers what they produced, and `verdict` and `Bless.decide` are pure
--- functions of that, the case and its goldens. Every dump is run whenever the
--- compile answered, even when the output already failed, since bless needs
--- them all.
---
--- Every actual result is written under `ACTUAL/NAME/` for inspection, whether
--- the case passed or not: `output`, and one file per dump.

import Process (Output(..), Status(..))
import Process as Process
import System.IO (IOError)
import Time.Duration as Duration
import Time.Stopwatch as Stopwatch
import Bless (Blessing(..), Guard(..))
import Bless as Bless
import Archive (Comparison(..))
import Archive as Archive
import Case (Case(..), Expected(..), Golden(..), Quote(..), Archived(..), Section(..), Outcome(..), Result(..), Finish(..),
             Ending(..), Observed(..), Recorded(..))
import Case as Case
import Cache (Cache, Compiled(..))
import Cache as Cache
import Diff as Diff
import Files as Files
import Reference as Reference
import Toolchain (Toolchain(..))
import Toolchain as Toolchain

--- The longest diff shown for a case, in lines; the whole actual output is in
--- the actual results.
let diffLimit : Int = 200

-- How long a program may run without a `timeout` directive, and how long
-- `boot` and the link may take, in seconds, before `--timeout-scale`.
let defaultTimeout : Int = 300

-- What became of a case, before its time is added.
type Verdict = Verdict { outcome : Outcome, why : String, diff : String }

--- Returns the outcome of case `c` and what bless would do with it. Writes the
--- actual results under `ACTUAL/NAME/`, and never writes a golden.
fun execute(t : Toolchain, cache : Cache, actual : String, c : Case) -> (Result, Blessing) {
    let watch = Stopwatch.start()
    let (judged, blessing) = assess(t, cache, actual + "/" + c.name, c)
    let Verdict { outcome, why, diff } = expected(c, judged)
    let millis = Duration.toNanos(Stopwatch.elapsed(watch)) / 1000000
    (Result { outcome, why, diff, millis }, blessing)
}

-- An `xfail` case turns a wrong answer into the failure it expects and a
-- pass into an unexpected one. A crash or a timeout stays what it is: that is
-- not the failure the reason describes.
fun expected(c : Case, judged : Verdict) -> Verdict = match (c.xfail, judged.outcome) {
    (Some(reason), Pass) -> Verdict(XPass, reason, "")
    (Some(reason), Fail) -> Verdict(XFail, reason, "")
    _ -> judged
}

fun assess(t : Toolchain, cache : Cache, actual : String, c : Case) -> (Verdict, Blessing) {
    if let Some(problem) = c.problem { return unrunnable(problem) }
    for r in c.requires {
        if !Toolchain.satisfies(t, r) {
            let why = "requires " + Case.requirementName(r)
            return (Verdict(Skip, why, ""), Keep(why))
        }
    }
    let recorded = match goldens(c) {
        Right(recorded) -> recorded
        Left(e) -> return unrunnable(Error.describe(e))
    }
    let observed = match observe(t, cache, actual, c) {
        Right(observed) -> observed
        Left(why) -> return unrunnable(why)
    }
    (verdict(c, recorded, observed), Bless.decide(c, recorded, observed))
}

fun unrunnable(why : String) -> (Verdict, Blessing) = (Verdict(HarnessError, why, ""), Refuse(Unrunnable, why))

-- The case's goldens as they are on disk. A missing `.expected` is not an
-- error here: the verdict reports it, and bless creates it. A quoted golden
-- and an archive's sections are not files of their own, and are recorded as
-- nothing.
fun goldens(c : Case) -> Either SomeError Recorded {
    let expected = match c.golden {
        OnDisk(path) -> if Files.exists(path) { Some(Files.readText(path)?) } else { None }
        Quoted(_) | InArchive(_) -> return Right(Recorded { expected = None, dumps = [] })
    }
    let dumps = []
    for (_, path) in c.dumps { Vec.push(dumps, Files.readText(path)?) }
    Right(Recorded { expected, dumps = Vec.toArray(dumps) })
}

-- -- running ---------------------------------------------------------------------------

-- The case compiled, run, and dumped. `Left` is why it could not be: a
-- harness error, not a result.
fun observe(t : Toolchain, cache : Cache, actual : String, c : Case) -> Either String Observed {
    let compiled = match Cache.compile(cache, t, c) {
        Right(compiled) -> compiled
        Left(e) -> return Left(Error.describe(e))
    }
    let ran = match compiled {
        Crashed(why, stderr) -> (CompileCrash(why), "", stderr)
        Overran(stderr) -> (CompileExpired, "", stderr)
        Refused(code, stderr) -> (Diagnosed(code), "", stderr)
        Accepted(warnings) -> (Checked, "", warnings)
        Built(binary, warnings) -> match runProgram(t, c, binary, warnings) {
            Right(r) -> r
            Left(e) -> {
                record(actual, "output", "")
                return Left("the program did not start: " + Error.message(e))
            }
        }
    }
    let (ending, stdout, stderr) = ran
    record(actual, "output", stdout + stderr)
    let dumps = match ending {
        CompileCrash(_) | CompileExpired -> []
        Diagnosed(_) | Checked | Ran(_) -> runDumps(t, actual, c)?
    }
    Right(Observed { ending, stdout, stderr, dumps })
}

-- The compiled program run in the case's directory: how it ended, its
-- stdout, and the compile's warnings then its stderr.
fun runProgram(t : Toolchain, c : Case, binary : String, warnings : String)
    -> Either IOError (Ending, String, String) {
    let argv = t.run + [binary]
    let limit = Toolchain.limit(t, Option.unwrapOr(c.timeout, defaultTimeout))
    let Output { stdout, stderr, status } = Process.run(Toolchain.caseCommand(t, c, argv), Some(limit))?
    let err = Toolchain.text(stderr)
    Right((Ran(finish(status, err)), Toolchain.text(stdout), warnings + err))
}

-- Each of the case's dump stages, as `boot check --dump STAGE` ended, its
-- stdout and its stderr.
fun runDumps(t : Toolchain, actual : String, c : Case) -> Either String (Array (Finish, String, String)) {
    let out = []
    for (stage, _) in c.dumps {
        let argv = t.run + [t.boot, "check", "--dump", stage, c.entry]
        let limit = Toolchain.limit(t, defaultTimeout)
        let ran = match Process.run(Toolchain.caseCommand(t, c, argv), Some(limit)) {
            Right(ran) -> ran
            Left(e) -> return Left("boot did not start: " + Error.message(e))
        }
        let stdout = Toolchain.text(ran.stdout)
        let stderr = Toolchain.text(ran.stderr)
        record(actual, stage, stdout + stderr)
        Vec.push(out, (finish(ran.status, stderr), stdout, stderr))
    }
    Right(Vec.toArray(out))
}

-- How a process ended, given its stderr, where a panic is looked for.
fun finish(status : Status, stderr : String) -> Finish = match status {
    TimedOut -> Expired
    Signaled(n) -> Killed(n)
    Exited(code) -> if Cache.panicked(stderr) { Panicked(code) } else { Returned(code) }
}

-- Keep `text` as the actual result `name` of a case. Failing to is not a
-- reason to fail the case, which has been judged on what was compared.
fun record(directory : String, name : String, text : String) -> Unit {
    let _ = Files.writeText(directory + "/" + name, text)
}

-- -- judging ---------------------------------------------------------------------------

-- The outcome of a case whose goldens are `recorded` and whose run produced
-- `observed`. The output is judged first, then each dump in turn; the first
-- that is wrong decides.
fun verdict(c : Case, recorded : Recorded, observed : Observed) -> Verdict = match c.golden {
    OnDisk(path) -> goldenVerdict(c, path, recorded, observed)
    Quoted(q) -> quotedVerdict(c, q, observed)
    InArchive(a) -> archiveVerdict(c, a, observed)
}

fun goldenVerdict(c : Case, path : String, recorded : Recorded, observed : Observed) -> Verdict {
    let golden = match recorded.expected {
        Some(text) -> text
        None -> {
            let file = Option.fold(String.rsplitOnce(path, "/"), path, _.1)
            return Verdict(HarnessError, "no " + file + " beside " + c.entry, "")
        }
    }
    let diff = Diff.unified(golden, Case.printed(observed), diffLimit)
    if let Some(v) = ended(observed, diff) { return v }
    if let Some(why) = Case.disagreement(c.expected, observed.ending) { return Verdict(Fail, why, diff) }
    if diff != "" {
        let why = match observed.ending {
            Diagnosed(_) -> "the diagnostic differs"
            _ -> "the output differs"
        }
        return Verdict(Fail, why, diff)
    }
    for i in Int.range(0, len(c.dumps)) {
        let (finished, stdout, stderr) = observed.dumps[i]
        let stage = c.dumps[i].0
        if let Some(v) = dumpVerdict(stage, recorded.dumps[i], finished, stdout + stderr) { return v }
    }
    Verdict(Pass, "", "")
}

-- The outcome of an archive case whose expectations are `a`. Each
-- comparison is made in the order `Archive.comparisons` gives, and the first
-- that differs decides.
fun archiveVerdict(c : Case, a : Archived, observed : Observed) -> Verdict {
    let compared = Archive.comparisons(c, a, observed)
    let diffs = Array.map(compared, comparedDiff)
    let first = Option.unwrapOr(Iter.find(diffs, \!String.isEmpty(_)), "")
    if let Some(v) = ended(observed, diffs[0]) { return v }
    if let Some(why) = Case.disagreement(c.expected, observed.ending) { return Verdict(Fail, why, first) }
    for i in Int.range(0, len(compared)) {
        let e = compared[i].expectation
        let name = Case.expectationName(e)
        let dump = "the " + name + " dump"
        let ran = Archive.dumpOf(c, observed, e)
        if let Some((finished, stdout, stderr)) = ran {
            if let Some(v) = dumpCrashed(dump, finished, stdout + stderr, diffs[i]) { return v }
        }
        if !String.isEmpty(diffs[i]) {
            let what = if Option.isSome(ran) { dump } else { "the " + name }
            return Verdict(Fail, what + " differs", diffs[i])
        }
        if let Some((finished, _, _)) = ran {
            if let Some(v) = dumpExited(dump, finished) { return v }
        }
    }
    if let Some(v) = traceVerdict(c, observed) { return v }
    Verdict(Pass, "", "")
}

-- The outcome of a reference example whose chapter quotes `q`. A quoted
-- message only has to be contained in the message, since it is the part of
-- it the chapter is about.
fun quotedVerdict(c : Case, q : Quote, observed : Observed) -> Verdict {
    let diff = match q.stdout {
        Some(text) -> Diff.unified(text, observed.stdout, diffLimit)
        None -> ""
    }
    if let Some(v) = ended(observed, diff) { return v }
    if let Some(why) = Case.disagreement(c.expected, observed.ending) { return Verdict(Fail, why, diff) }
    if let Some(quoted) = q.message {
        let message = Reference.message(observed)
        if !String.contains(message, quoted) {
            let shown = "quoted:\n" + indented(quoted) + "message:\n" + indented(message)
            return Verdict(Fail, "the message does not contain the quoted text", shown)
        }
    }
    if diff != "" { return Verdict(Fail, "the output differs", diff) }
    if let Some(text) = q.stderr {
        let wrong = Diff.unified(text, observed.stderr, diffLimit)
        if wrong != "" { return Verdict(Fail, "the standard error differs", wrong) }
    }
    if let Some(v) = traceVerdict(c, observed) { return v }
    Verdict(Pass, "", "")
}

-- The outcome of a case that expects a panic and got one whose trace is
-- missing or malformed, showing the standard error. A case that quotes the
-- panic's message alone still has its trace checked this far.
fun traceVerdict(c : Case, observed : Observed) -> Option Verdict = match c.expected {
    Panics -> Option.map(Reference.traceProblem(observed.stderr), \Verdict(Fail, _, observed.stderr))
    Exits(_) | Rejected -> None
}

fun indented(text : String) -> String = String.unlines(Vec.map(String.lines(text), \"    " + _))

-- The outcome of a compile or a program that crashed or ran out of time, if
-- one did, showing `diff` for a program.
fun ended(observed : Observed, diff : String) -> Option Verdict {
    let output = Case.printed(observed)
    match observed.ending {
        CompileCrash(why) -> Some(Verdict(CompilerCrash, why, tail(output)))
        CompileExpired -> Some(Verdict(Timeout, "boot or the link took too long", tail(output)))
        Ran(Expired) -> Some(Verdict(Timeout, "the program ran out of time", diff))
        Ran(Killed(n)) -> Some(Verdict(ProgramCrash, "the program died by signal " + Int.toString(n), diff))
        Diagnosed(_) | Checked | Ran(Returned(_)) | Ran(Panicked(_)) -> None
    }
}

-- The diff of a comparison's section, or the empty string where the case
-- has none, against what the run produced.
fun comparedDiff(cmp : Comparison) -> String {
    let recorded = Option.fold(cmp.section, "", _.text)
    Diff.unified(recorded, cmp.actual, diffLimit)
}

-- What is wrong with the dump of `stage`, whose golden is `golden`, if
-- anything is.
fun dumpVerdict(stage : String, golden : String, finished : Finish, printed : String) -> Option Verdict {
    let dump = "the " + stage + " dump"
    let diff = Diff.unified(golden, printed, diffLimit)
    if let Some(v) = dumpCrashed(dump, finished, printed, diff) { return Some(v) }
    if diff != "" { return Some(Verdict(Fail, dump + " differs", diff)) }
    dumpExited(dump, finished)
}

-- The outcome of `dump` if it ran out of time or crashed, showing `diff` for
-- a timeout.
fun dumpCrashed(dump : String, finished : Finish, printed : String, diff : String) -> Option Verdict =
    match finished {
        Expired -> Some(Verdict(Timeout, dump + " took too long", diff))
        Killed(n) -> Some(Verdict(CompilerCrash, dump + " died by signal " + Int.toString(n), tail(printed)))
        Panicked(_) -> Some(Verdict(CompilerCrash, dump + " panicked", tail(printed)))
        Returned(_) -> None
    }

-- The outcome of `dump` if it exited non-zero.
fun dumpExited(dump : String, finished : Finish) -> Option Verdict = match finished {
    Returned(code) -> if code != 0 { Some(Verdict(Fail, dump + " exited " + Int.toString(code), "")) } else { None }
    Expired | Killed(_) | Panicked(_) -> None
}

-- A crash's last lines, which is where what went wrong usually is.
fun tail(text : String) -> String {
    let lines = String.lines(text)
    let from = max(len(lines) - diffLimit, 0)
    String.unlines(Vec.slice(lines, from, len(lines)))
}
