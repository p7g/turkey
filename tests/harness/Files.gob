export (readBytes, readText, writeText, writeOut, listed, filesUnder, isDirectory, exists, age, parentOf)

-- The file operations the harness needs. Every failure here ends up as a
-- harness error, so each carries the path it was about.

import Hash.SHA256 as SHA256
import System.File as File
import System.File (FileKind(..), Stat(..))
import System.IO as IO
import Time.Duration (Duration)
import Time.Instant as Instant

-- A file read as text that is not UTF-8. `InvalidUTF8` alone does not say
-- which file.
type NotText = NotText { path : String }

instance Error NotText { fun message(e) = e.path + " is not UTF-8" }

fun readBytes(path : String) -> Either SomeError (Array Byte) {
    let b = Error.promote(File.readAll(path))?
    Right(IO.bytes(b))
}

fun readText(path : String) -> Either SomeError String = match File.readText(path) {
    Right(s) -> Right(s)
    Left(Left(_)) -> Left(fail(NotText { path }))
    Left(Right(e)) -> Left(fail(e))
}

-- Replace `path`'s contents with `text`, making its directory if need be.
fun writeText(path : String, text : String) -> Either SomeError Unit {
    if let Some(parent) = parentOf(path) { Error.promote(File.createDirAll(parent))? }
    Error.promote(File.writeText(path, text))?
    Right(())
}

fun parentOf(path : String) -> Option String = match String.rsplitOnce(path, "/") {
    Some(("", _)) -> Some("/")
    Some((parent, _)) -> Some(parent)
    None -> None
}

fun isDirectory(path : String) -> Bool = match File.metadata(path) {
    Right(Stat { kind = Directory, .. }) -> True
    _ -> False
}

fun exists(path : String) -> Bool = Either.isRight(File.metadata(path))

-- How long ago `path`'s contents last changed, if it is there.
fun age(path : String) -> Option Duration = match File.metadata(path) {
    Right(Stat { modified, .. }) -> Some(Instant.elapsed(modified, Instant.now()))
    Left(_) -> None
}

-- The names in `directory`, sorted, or none if it cannot be listed.
fun listed(directory : String) -> Array String = Either.unwrapOr(File.listPath(directory), [])

-- Every file under `directory`, at any depth, as a path relative to it, in
-- the sorted order `File.list` gives each level in.
fun filesUnder(directory : String) -> Either SomeError (Array String) {
    let out = []
    collect(directory, "", out)?
    Right(Vec.toArray(out))
}

fun collect(directory : String, prefix : String, out : Vec String) -> Either SomeError Unit {
    let names = Error.promote(File.listPath(directory))?
    for name in names {
        let path = directory + "/" + name
        if isDirectory(path) {
            collect(path, prefix + name + "/", out)?
        } else {
            Vec.push(out, prefix + name)
        }
    }
    Right(())
}

-- Returns the directory under `work` that holds `files`, each (name, text),
-- writing it first if it is not there yet, and marks it used.
--
-- The directory is named by a hash of the files. It is filled in a fresh one
-- and renamed into place, so concurrent runs that share the cache share it
-- too, and none of them sees it half-written. A run rewrites the `used` file
-- of every directory it finds, and `Cache.evict` removes those unused for a
-- week.
fun writeOut(work : String, files : Array (String, String)) -> Either SomeError String {
    -- Each length comes before its text, so that no two sets of files hash
    -- the same by moving text from one file to the next.
    let parts = Array.map(files, \_.0 + "\u{0}" + Int.toString(String.byteLength(_.1)) + "\u{0}" + _.1)
    let directory = work + "/" + SHA256.ofText(String.join(parts, ""))
    if exists(directory) {
        writeText(directory + "/used", "")?
        return Right(directory)
    }
    Error.promote(File.createDirAll(work))?
    let staging = Error.promote(File.temporaryDir("turkey-case-"))?
    for (name, text) in files { writeText(staging + "/" + name, text)? }
    writeText(staging + "/used", "")?
    -- A rename that finds the directory there lost a race to a run writing
    -- the same files, and the directory that won is as good.
    let renamed = File.rename(staging, directory)
    let _ = File.removeTree(staging)
    if let Left(e) = renamed {
        if !exists(directory) { return Left(fail(e)) }
    }
    Right(directory)
}
