export (discover)

-- Cases from a directory of golden programs, `tests/programs/` and the
-- harness's own `selftest/`. A program is either
--
-- * a file `NAME.gob`, with `NAME.expected` beside it; or
-- * a directory `NAME/` holding `Main.gob`, its entry, and `Main.expected`,
--   compiled from inside that directory so that its imports resolve against
--   it.
--
-- The golden is the program's standard output then its standard error: the
-- compile's warnings or diagnostic, then what the program printed, then a
-- panic if it had one. A program may also have dump goldens beside its entry,
-- `NAME.types`, `.core`, `.opt` and `.mono`, each what `boot check --dump`
-- of that stage prints. Its directives are in its entry module.
--
-- A single-file program's sources are the file alone: it imports only the
-- library, which every key covers, and hashing the whole directory into each
-- program's key would make an edit to one a recompile of all of them. A
-- directory program's are every `.gob` under its directory.

import Case (Case(..), Expected(..))
import Case as Case
import Files as Files

let stages = ["types", "core", "opt", "mono"]

-- Every program in `directory` (an absolute path), named by `prefix`, the
-- path to it from the repository root, in sorted order.
fun discover(directory : String, prefix : String) -> Array Case {
    let names = Files.listed(directory)
    let out = []
    for name in names {
        let path = directory + "/" + name
        if Files.isDirectory(path) {
            if Files.exists(path + "/Main.gob") {
                Vec.push(out, bundle(path, prefix + "/" + name))
            }
        } else if let Some(stem) = String.stripSuffix(name, ".gob") {
            Vec.push(out, program(directory, name, stem, [name], prefix + "/" + name))
        }
    }
    Vec.toArray(out)
}

fun bundle(directory : String, name : String) -> Case {
    let sources = match Files.filesUnder(directory) {
        Right(files) -> Array.filter(files, String.endsWith(_, ".gob"))
        Left(_) -> ["Main.gob"]
    }
    program(directory, "Main.gob", "Main", sources, name)
}

fun program(directory : String, entry : String, stem : String, sources : Array String,
            name : String) -> Case {
    let golden = directory + "/" + stem + ".expected"
    let dumps = []
    for stage in stages {
        let path = directory + "/" + stem + "." + stage
        if Files.exists(path) { Vec.push(dumps, (stage, path)) }
    }
    let read = Files.readText(directory + "/" + entry)
    let base = Case {
        name = name,
        directory = directory,
        entry = entry,
        sources = sources,
        golden = golden,
        dumps = Vec.toArray(dumps),
        expected = Exits(0),
        timeout = None,
        requires = [],
        xfail = None,
        problem = Option.map(Either.left(read), Error.describe),
    }
    Case.directives(base, Either.unwrapOr(read, ""))
}
