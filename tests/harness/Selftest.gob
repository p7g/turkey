    ("harness_error_unknown_directive.md:3", Refused(Unrunnable)),
    ("harness_error_unmarked.md:3", Refused(Unrunnable)),
    ("pass.md:13", Kept),
    ("pass.md:26", Kept),
    ("pass.md:33", Kept),
    ("pass.md:42", Kept),
    ("pass.md:55", Kept),
    ("pass.md:71", Kept),
    ("fail.cases::diagnostic", Refused(Diagnostic)),
    ("fail.cases::header_line", Refused(Unholdable)),
    ("fail.cases::matrix_agrees[X=1]", Edited(["stdout"])),
    ("fail.cases::matrix_agrees[X=2]", Edited(["stdout"])),
    ("fail.cases::matrix_disagrees[X=1]", Refused(Divergent)),
