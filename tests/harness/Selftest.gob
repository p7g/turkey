export (cases, check)

-- The harness checked against cases whose outcome is known: at least one per
-- outcome, in `selftest/`, each named for the outcome it must be given
-- (`fail_*.gob` must be reported as a fail), and each listed with what
-- `--bless` must do with it. The chapters in `selftest/reference/` are
-- reference examples, named like any other (`pass.md:13`), and each way a
-- chapter can be malformed has one there, listed with the reason it must be
-- given. The archives in `selftest/cases/` hold archive cases, each named
-- for its outcome by its archive (`pass.cases::stdout`), and each way an
-- archive can be malformed has one there, listed likewise. A harness that
-- called a crash a wrong answer, let an unknown directive pass, or blessed a
-- crash would otherwise go unnoticed, since its reports on the real corpus
-- are all anyone reads.
--
-- Bless is checked by its decisions, which are pure, and by the edits it
-- makes to copies of two archives under the cache. Nothing here writes a
-- golden in the repository.

import Archive (Edit(..))
import Archive as Archive
import Bless (Blessing(..), Guard(..))
import Bless as Bless
import Case (Case(..), Expected(..), Golden(..), Outcome(..), Result(..), Finish(..), Ending(..),
             Observed(..), Recorded(..))
import Case as Case
import Diff as Diff
import Files as Files
import Programs as Programs
import Reference as Reference

-- The file-name prefix each outcome's case has.
let prefixes = [
    ("compiler_crash", CompilerCrash), ("program_crash", ProgramCrash),
    ("harness_error", HarnessError), ("timeout", Timeout), ("xfail", XFail),
    ("xpass", XPass), ("skip", Skip), ("fail", Fail), ("pass", Pass),
]

-- What bless must do with a case: leave it, write exactly these files (by
-- base name, in order), edit exactly these sections of its archive (in
-- order), keep it deliberately, or refuse it by this guard.
type Wanted = Same | Writes(Array String) | Edited(Array String) | Kept | Refused(Guard)

-- What bless must do with each case, by the case's base name. Every case is
-- listed, and every guard is reached by at least one, except those that no
-- real compile reaches, which `checkOwnError` and `checkDumpGuards` cover.
let blessings = [
    ("compiler_crash.gob", Refused(Crash)),
    ("fail_diagnostic.gob", Refused(Diagnostic)),
    ("fail_dump_differs.gob", Writes(["fail_dump_differs.types"])),
    ("fail_dump_exits.gob", Refused(WrongEnd)),
    ("fail_error_compiles.gob", Refused(WrongEnd)),
