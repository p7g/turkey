export (Toolchain(..), Target(..), detect, target, targetName, isHost, words, command, caseCommand, buildFlags,
        programCommand, comparable, limit, satisfies, text)

--- The programs a case is run with -- `turkey`, the C compiler a case may
--- require, and the prefix that runs what `turkey` wrote -- and how each is
--- started.
---
--- `$TURKEY_CC` is the C compiler, `cc` when unset; `$TURKEY_RUN` is a prefix
--- for running a program (`qemu-aarch64-static`), empty when unset.
--- `scripts/build.sh` reads the same two. Both are split into words at
--- spaces, with no quoting.
---
--- The target is what each case is compiled for: the host, or `wasm32-wasi`,
--- whose modules `wasmtime` runs. `$TURKEY_RUN` is not used for a module.

import Process (Command, Output(..), Status(..))
import Process as Process
import System.Env as Env
import Time.Duration (Duration)
import Time.Duration as Duration
import Case (Case(..), Requirement(..))

--- What a case is compiled for: the platform `turkey` runs on, or WASI
--- preview 1, as `turkey build --target wasm32-wasi` writes it.
type Target = Host | Wasm32Wasi

--- Returns the target `name` names, as `--target` takes it.
fun target(name : String) -> Option Target = match name {
    "host" -> Some(Host)
    "wasm32-wasi" -> Some(Wasm32Wasi)
    _ -> None
}

--- Returns whether `t` is the host.
fun isHost(t : Target) -> Bool = match t {
    Host -> True
    Wasm32Wasi -> False
}

--- Returns the name `--target` takes for `t`.
fun targetName(t : Target) -> String = match t {
    Host -> "host"
    Wasm32Wasi -> "wasm32-wasi"
}

type Toolchain = Toolchain {
    root : String,
    lib : String,
    boot : String,
    cc : Array String,
    run : Array String,
    --- `$TURKEY_CC -dumpmachine`, which names the platform `turkey` runs on.
    machine : String,
    --- The C compiler, its `--version`, and the run prefix: part of every
    --- cache key, since the cache is shared by every session on the machine,
    --- and a case that requires the C compiler may build with it.
    identity : String,
    hasCc : Bool,
    hasAs : Bool,
    timeoutScale : Float,
    target : Target,
    --- `wasmtime`'s path, where it answered `--version`.
    wasmtime : Option String,
}

fun words(s : String) -> Array String = Vec.toArray(String.words(s))

fun detect(root : String, boot : String, scale : Float, target : Target) -> Toolchain {
    let cc = words(Option.unwrapOr(Env.get("TURKEY_CC"), "cc"))
    let cc = if len(cc) == 0 { ["cc"] } else { cc }
    let run = words(Option.unwrapOr(Env.get("TURKEY_RUN"), ""))
    let machine = String.trim(Option.unwrapOr(answer(cc + ["-dumpmachine"]), ""))
    let version = answer(cc + ["--version"])
    Toolchain {
        root = root,
        lib = root + "/lib",
        boot = boot,
        cc = cc,
        run = run,
        machine = machine,
        identity = String.join(cc, " ") + "\n" + Option.unwrapOr(version, "") + "\n"
                   + String.join(run, " ") + "\n",
        hasCc = Option.isSome(version),
        hasAs = Option.isSome(answer(["as", "--version"])),
        timeoutScale = scale,
        target = target,
        wasmtime = match target {
            Host -> None
            Wasm32Wasi -> Option.map(answer(["wasmtime", "--version"]), fun(_) = "wasmtime")
        },
    }
}

-- What `argv` printed, if it ran and exited 0.
fun answer(argv : Array String) -> Option String =
    match Process.run(Process.command(argv), Some(Duration.seconds(60))) {
        Right(Output { stdout, status = Exited(0), .. }) -> String.fromBytes(stdout)
        _ -> None
    }

--- `argv` run in `directory` the way every process of a case is: with the
--- library found through `$TURKEY_LIB`, since `directory` is not the
--- repository root, and with one worker, since the harness already runs a
--- process per core and each starting a worker per core would be that squared.
---
--- `TURKEY_CHECK_BINDERS` has the compiler check its own name resolution on
--- every program the suite compiles, `TURKEY_CHECK_SPANS` the spans and
--- comments of every file it parses, and `TURKEY_CHECK_FIXES` that no two of
--- its checks' fixes overlap.
---
--- `TURKEY_TEST_INTERNAL_IMPORTS` names the implementation's modules that a
--- corpus program may import -- raw memory, a C call, a giblet -- which the
--- compiler refuses outside the library unless named there.
fun command(t : Toolchain, argv : Array String, directory : String) -> Command {
    var c = Process.inDirectory(Process.command(argv), directory)
    c = Process.withEnvironment(c, "TURKEY_LIB", t.lib)
    c = Process.withEnvironment(c, "TURKEY_WORKERS", "1")
    c = Process.withEnvironment(c, "TURKEY_CHECK_BINDERS", "1")
    c = Process.withEnvironment(c, "TURKEY_CHECK_SPANS", "1")
    c = Process.withEnvironment(c, "TURKEY_CHECK_FIXES", "1")
    Process.withEnvironment(c, "TURKEY_TEST_INTERNAL_IMPORTS", "Turkey.Libc,Turkey.Memory,Turkey.Ptr")
}

--- `argv` run for case `c`: as `command` runs it in the case's directory,
--- with the case's own environment set over the harness's.
fun caseCommand(t : Toolchain, c : Case, argv : Array String) -> Command {
    var command = command(t, argv, c.directory)
    for (name, value) in c.environment { command = Process.withEnvironment(command, name, value) }
    command
}

--- Returns what `turkey build` is given besides the output and the entry.
fun buildFlags(t : Toolchain) -> Array String = match t.target {
    Host -> []
    Wasm32Wasi -> ["--target", "wasm32-wasi"]
}

--- Returns the command that runs `binary`, case `c`'s compiled program: under
--- `$TURKEY_RUN` on the host; under `wasmtime run` for `wasm32-wasi`, with the
--- case's directory preopened as `.` and its environment passed to the
--- module.
fun programCommand(t : Toolchain, c : Case, binary : String) -> Array String = match t.target {
    Host -> t.run + [binary]
    Wasm32Wasi -> {
        -- On wasmtime's own engine stack, 512 KiB, which every golden fits in.
        let argv = [Option.unwrapOr(t.wasmtime, "wasmtime"), "run", "--dir", "."]
        for (name, value) in c.environment { Vec.push(argv, "--env"); Vec.push(argv, name + "=" + value) }
        Vec.push(argv, binary)
        Vec.toArray(argv)
    }
}

--- Returns `warnings`, what `turkey build` printed for case `c`, without
--- the warning that only the target gives and the reference says it gives.
--- For `wasm32-wasi` that is the count of functions built as traps, removed
--- only where it is the whole of its line and the count is the one every
--- program reaching the scheduler gets. The rest is left byte for byte, to be
--- compared with the host's golden.
fun comparable(t : Toolchain, c : Case, warnings : String) -> String = match t.target {
    Host -> warnings
    Wasm32Wasi -> {
        let line = c.entry + ": warning: " + trapCount + "\n"
        let kept = String.replace("\n" + warnings, "\n" + line, "\n")
        Option.unwrapOr(String.stripPrefix(kept, "\n"), kept)
    }
}

-- The two are `Turkey.Coroutine#resume` and `Turkey.Wait#settleIn`, each a
-- coroutine switch, which wasm32-wasi refuses. A third refused function
-- changes the count, so the warning stays in the output and the case fails.
let trapCount = ("2 functions use operations the wasm32 backend does not compile yet, "
                 + "and trap if they are called; '--dump select' lists them")

--- `seconds`, scaled by `--timeout-scale`.
fun limit(t : Toolchain, seconds : Int) -> Duration {
    let nanos = Float.fromInt(seconds) * t.timeoutScale * 1000000000.0
    Duration.nanos(Option.unwrapOr(Float.truncate(nanos), seconds * 1000000000))
}

--- Whether the requirement `r` holds here. A system is the one the program
--- runs on, which for `wasm32-wasi` is neither.
fun satisfies(t : Toolchain, r : Requirement) -> Bool = match (r, t.target) {
    (Cc, _) -> t.hasCc
    (As, _) -> t.hasAs
    (Darwin, Host) -> String.contains(t.machine, "darwin")
    (Linux, Host) -> String.contains(t.machine, "linux")
    (Darwin, Wasm32Wasi) | (Linux, Wasm32Wasi) -> False
}

--- Bytes as text, for comparing against a golden. Output that is not UTF-8
--- keeps its well-formed characters, and each malformed sequence in it becomes
--- one U+FFFD. No golden holds U+FFFD, so such output can only fail; the diff
--- is lossy, not the verdict.
fun text(bytes : Array Byte) -> String = String.fromBytesLossy(bytes)
