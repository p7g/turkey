-- Archive cases that must fail. Bless edits some of them, and the selftest
-- checks that a copy of this file, so edited, is `fail.blessed`.

-- case wrong_stdout --
-- Prints something other than its section.
-- Main.gob --
fun main() {
    print("hello")
}
-- stdout --
hello
-- case missing_streams --
-- Prints to both streams, and has a section for neither, so bless inserts
-- both after its last section.
-- Main.gob --
import System.IO as IO

fun main() {
    print("out")
    let _ = IO.writeText(IO.stderr(), "err\n")
}

-- stdout --
out
-- stderr --
err
-- case wrong_error --
--@ error
-- Main.gob --
fun main() {
    let n : Int = "one"
}
-- error --
expected 'String', found 'Int' in the annotation on 'n'
-- case wrong_panic --
--@ panic
-- Main.gob --
fun main() {
    error("no more")
}
-- panic --
no more
-- case wrong_dump --
-- Its types section is not what the dump says.
-- Main.gob --
fun twice(x : Int) -> Int = x * 2

fun main() {}
-- types --
twice : fun(Int) -> Int
main : fun() -> Unit
-- case newly_empty --
-- Prints nothing where its section has a line, which bless refuses.
-- Main.gob --
fun main() {}
-- stdout --
hello
-- case diagnostic --
-- Does not compile, and is not marked so, which bless refuses.
-- Main.gob --
fun main() {
    let n : Int = "one"
}
-- case header_line --
-- Prints a line that would start a section, which bless refuses.
-- Main.gob --
fun main() {
    print("-- case printed --")
}
-- case no_newline --
-- Ends its output without a newline, which bless refuses.
-- Main.gob --
fun main() {
    write("no newline")
}
-- case matrix_agrees --
-- Both expansions print the same, so bless edits the section once.
--@ matrix: X=1,2
-- Main.gob --
fun main() {
    print("same")
}
-- stdout --
same
-- case matrix_disagrees --
-- Each expansion prints its own value, so bless refuses both.
--@ matrix: X=1,2
-- Main.gob --
import System.Env as Env

fun main() {
    print(Option.unwrapOr(Env.get("X"), "unset"))
}
-- stdout --
0
