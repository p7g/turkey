-- Archive cases that must pass, one for each part of the format. Bless must
-- leave every one as it is.

-- shared Shapes.gob --
export (Shape(..), Sized(..), area)

type Shape = Circle(Int) | Square(Int)

class Sized a { fun size(a) -> Int }

instance Sized Shape { fun size(s) = area(s) }

fun area(s : Shape) -> Int = match s {
    Circle(r) -> 3 * r * r
    Square(n) -> n * n
}

-- case stdout --
-- Prints what its section says. The `--@` line and the comment in Main.gob
-- are source: a line is a directive only in a case's preamble, and a header
-- only with a closing dash pair.
-- Main.gob --
--@ exit: 3
-- not a header
fun main() {
    print("hello")
}
-- stdout --
hello
-- case stderr --
-- Prints to both streams, and each is compared with its own section.
-- Main.gob --
import System.IO as IO

fun main() {
    print("out")
    let _ = IO.writeText(IO.stderr(), "err\n")
}
-- stdout --
out
-- stderr --
err
-- case exit --
--@ exit: 3
-- Main.gob --
import System.Env as Env

fun main() {
    Env.exit(3)
}
-- case error --
-- The diagnostic is compared without its place and stage.
--@ error
-- Main.gob --
fun main() {
    let n : Int = "one"
}
-- error --
expected 'String', found 'Int' in the annotation on 'n'
-- case panic --
-- What it printed before the panic is compared, and the panic's message.
--@ panic
-- Main.gob --
fun main() {
    print("before")
    error("no more")
}
-- stdout --
before
-- panic --
no more
-- case check --
-- Only checked, so the panic it would reach is never run.
--@ check
-- Main.gob --
fun main() {
    error("never run")
}
-- case dumps --
-- A dump holds the declarations of Main and of the shared module, and none
-- of the library's.
-- Main.gob --
import Shapes (..)

type Box f a = Box(f a)

class Egal a { fun egal(a, a) -> Bool }

instance Egal Shape { fun egal(x, y) = area(x) == area(y) }

fun twice(x : Int) -> Int = x * 2

fun main() {
    print(Int.toString(twice(area(Square(2)))))
}
-- stdout --
8
-- types --
egal : [Egal a] fun(a, a) -> Bool
twice : fun(Int) -> Int
main : fun() -> Unit
-- kinds --
type Shapes#Shape :: *
  con Shapes#Circle/1 : fun(Int) -> Shape
  con Shapes#Square/1 : fun(Int) -> Shape
type Main#Box f a :: (* -> *) -> * -> *
  con Main#Box/1 : fun(a b) -> Box a b
-- classes --
class Shapes#Sized a :: *
  method Shapes#Sized.size : [Sized a] fun(a) -> Int
class Main#Egal a :: *
  method Main#Egal.egal : [Egal a] fun(a, a) -> Bool
instance Shapes#Sized Shape [Shapes]
instance Main#Egal Shape [Main]
-- case matrix --
-- Runs once for each pair of values, with both set in its environment.
--@ matrix: X=1,2
--@ matrix: Y=a,b
-- Main.gob --
import System.Env as Env

fun main() {
    let set = Option.isSome(Env.get("X")) && Option.isSome(Env.get("Y"))
    print(if set { "both set" } else { "not set" })
}
-- stdout --
both set
-- case modules --
-- A case's own modules are written beside its Main.gob.
-- Main.gob --
import Helper (greet)

fun main() {
    print(greet("world"))
}
-- Helper.gob --
export (greet)

fun greet(name : String) -> String = "hello, " + name
-- stdout --
hello, world
-- case silent --
-- Has no stdout section, so it must print nothing, and it does not.
-- Main.gob --
fun main() {}
