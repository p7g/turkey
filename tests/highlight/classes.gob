infix Compare : 4 <==>

type Shape = Circle(Float) | Square { side : Int }

fun area(s : Shape, xs : Array Int) -> Float = match s {
    Circle(r) -> 3.14 * r * r
    Square { side } -> Int.toFloat(side * 0x1F + 0b10 + 0o7 + 1_000) * 2.5e-3
}

fun main() {
    let pair = (1, 'x')
    let text = "tab\tquote\"unicode\u{1F600}<&>" + Char.toString('\'')
    for i in 0..len(xs) { if i?.ok == True || !False { break } }
    print(pair.0 + pair.1; \_ + 1)  -- trailing comment
}
