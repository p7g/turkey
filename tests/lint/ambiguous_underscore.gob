-- A `fun` whose parameter is `_` and whose body has a `_` that makes a
-- function of its own: the reader takes the second `_` for the first.

fun lookup(key : Int, table : Map Int String) -> String = Map.getOr(table, key, "?")

fun lookups(keys : Vec Int, table : Map Int String) -> Vec (fun(Int) -> String) =
    Vec.map(keys, fun(_) = lookup(_, table))

-- The same in a declaration, and through an annotation.
fun constantly(_ : Int) -> fun(Int) -> Int = _ + 1

-- With a `\`, the function is said outright: quiet.
fun explicit(keys : Vec Int) -> Vec (fun(Int) -> Int) = Vec.map(keys, fun(_) = \_ * 2)

-- A `_` inside a parameter's pattern is a part ignored, not a name: quiet.
fun firsts(pairs : Vec (Int, Int)) -> Vec (fun(Int) -> Int) =
    Vec.map(pairs, fun((k, _)) = _ + k)

-- A nested `fun` has a parameter of its own, which the `_` is not mistaken
-- for: quiet.
fun nested(keys : Vec Int) -> Vec (fun(Int) -> fun(Int) -> Int) =
    Vec.map(keys, fun(_) = fun(n) = _ + n)

fun main() {
    let table = Map.new()
    Map.put(table, 1, "one")
    for f in lookups([7], table) { print(f(1)) }
    print(constantly(0)(41))
    for f in explicit([1]) { print(f(21)) }
    for f in firsts([(1, 2)]) { print(f(1)) }
    for f in nested([1]) { print(f(1)(2)) }
}
