-- A dropped `Option` or `Either`, or a dropped value of the monad of the `?`
-- block it is a statement of: most often a `?` left out.

fun total(a : String, b : String) -> Option Int {
    -- Before the first `?` of the block, and after it.
    Int.parse(a)
    let x = Int.parse(a)?
    Int.parse(b)
    let y = Int.parse(b)?
    Some(x + y)
}

fun checked(n : Int) -> Either String Int = if n < 0 { Left("negative") } else { Right(n) }

fun both(a : Int, b : Int) -> Either String Int {
    checked(a)
    let y = checked(b)?
    Right(y)
}

-- Any monad: in an `Array` block, an `Array` dropped without its `?` does
-- not run the rest once per element.
fun pairs(xs : Array Int, ys : Array Int) -> Array (Int, Int) {
    let x = xs?
    ys
    [(x, 0)]
}

-- A block nested in a `?` block, such as an `if` body, a loop body or a
-- `match` arm, is in the same `?` block. A lambda is not: a `?` in a callback
-- belongs to the callback, so the `Array` it drops is any other value.
fun nestedPairs(xs : Array Int, ys : Array Int, c : Bool) -> Array (Int, Int) {
    let x = xs?
    if c {
        ys
        print("in")
    }
    for _ in [1] { ys }
    match x {
        0 -> {
            ys
            print("zero")
        }
        _ -> {}
    }
    let later = fun() {
        ys
        print("later")
    }
    later()
    [(x, 0)]
}

-- An `Array` outside a `?` block is any other value.
fun shifted(xs : Array Int) -> Array Int {
    Array.map(xs, _ + 1)
    xs
}

fun main() {
    let stack = [1, 2, 3]
    -- Outside a `?` block, an `Option` and an `Either` are still reported here.
    Vec.pop(stack)
    checked(1)
    print(total("1", "2"))
    print(both(1, 2))
    print(pairs([1], [2]))
    print(nestedPairs([1], [2], True))
    print(shifted([1]))
    -- Quiet: `let _ =` says the drop is meant.
    let _ = Vec.pop(stack)
    print(stack)
}
