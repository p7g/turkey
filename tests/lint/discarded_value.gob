-- A statement that computes a value and drops it, at each place a value is
-- dropped, and the statements that drop nothing.

fun twice(n : Int) -> Int = n * 2

fun get(n : Int) -> Option Int = Some(n)

-- An argument holding a `?` leaves the call a statement once the `?` is
-- bound, and the call's value is still dropped.
fun doubled(n : Int) -> Option Int {
    twice(get(n)?)
    Some(n)
}

fun main() {
    let line = "  padded"
    String.trim(line)
    twice(1) + twice(2)
    let n = 2
    _ * n
    -- The last statement of a loop body, and of an `if` with no `else`.
    for i in [1, 2] { twice(i) }
    while False { twice(3) }
    if n > 1 { twice(n) }
    -- Quiet: `let _ =` says the drop is meant, a `Unit` is no value, and the
    -- last statement of a block is its value.
    let _ = twice(4)
    print(line)
    let m = if n > 1 { twice(n) } else { 0 }
    print(m)
    let _ = doubled(5)
    -- Quiet: a call that never returns computes no value.
    if n > 5 { error("too big") }
}
