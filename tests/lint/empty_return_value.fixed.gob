-- `return {}` and `return ()` are a bare `return` with a token more, and so
-- are `break {}` and `break ()`. The fix deletes the value and the space
-- before it.

fun stop(done : Bool) -> Unit {
    if done { return }
    print("going on")
}

fun halt(done : Bool) -> Unit {
    if done { return }
    print("going on")
}

fun spin() -> Unit {
    var n = 0
    loop {
        n = n + 1
        if n > 2 { break }
    }
    loop {
        if n > 0 { break }
    }
    print(n)
}

-- Naming a value is not writing an empty one: quiet.
fun named(nothing : Unit) -> Unit {
    return nothing
}

-- A comment inside the value is text the fix would delete without the tree
-- saying so, so this is reported and not fixed.
fun commented() -> Unit {
    return {
        -- nothing to do
    }
}

-- Grouping parentheses go with the value.
fun grouped() -> Unit {
    return
}

-- Inside the condition forms: an `if let` body, a `while let` body and the
-- `else` of a `let ... else`.
fun conditions(o : Option Int, xs : Vec Int) -> Unit {
    if let Some(n) = o, n > 0 { return }
    while let Some(x) = Vec.pop(xs) {
        if x == 2 { break }
    }
    let Some(_) = o else { return }
    print("all there")
}

fun main() {
    conditions(Some(0), [1, 2, 3])
    conditions(None, [])
    stop(True)
    halt(False)
    spin()
    named(())
    commented()
    grouped()
}
