-- `return {}` and `return ()` are a bare `return` with a token more, and so
-- are `break {}` and `break ()`. The fix deletes the value and the space
-- before it.

fun stop(done : Bool) -> Unit {
    if done { return {} }
    print("going on")
}

fun halt(done : Bool) -> Unit {
    if done { return () }
    print("going on")
}

fun spin() -> Unit {
    var n = 0
    loop {
        n = n + 1
        if n > 2 { break {} }
    }
    loop {
        if n > 0 { break () }
    }
    print(n)
}

-- Naming a value is not writing an empty one: quiet.
fun named(nothing : Unit) -> Unit {
    return nothing
}

-- A comment inside the value, or grouping parentheses around it, is text
-- the fix would delete without the tree saying so, so these are reported
-- and not fixed.
fun commented() -> Unit {
    return {
        -- nothing to do
    }
}

fun grouped() -> Unit {
    return (())
}

fun main() {
    stop(True)
    halt(False)
    spin()
    named(())
    commented()
    grouped()
}
