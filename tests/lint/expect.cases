-- case unfulfilled.a_record_field_list --
-- Main.gob --
type Point = Point {
    x : Int,
    --@expect(unreachable-code)
    y : Int,
}

fun main() {
    print(Point { x = 1, y = 2 }.x)
    return
    print("never")
}
-- stdout --
1
-- stderr --
Main.gob:3:15: warning: 'unreachable-code' finds nothing in what this expect covers; remove it from the expect [unfulfilled-expect]
Main.gob:10:5: warning: this statement is unreachable, since the one before it cannot complete; remove it [unreachable-code]
2 warnings
-- case unfulfilled.call_arguments --
-- Main.gob --
fun add(a : Int, b : Int) -> Int = a + b

fun main() {
    print(add(
        1,
        --@expect(unreachable-code)
        2))
    return
    print("never")
}
-- stdout --
3
-- stderr --
Main.gob:6:19: warning: 'unreachable-code' finds nothing in what this expect covers; remove it from the expect [unfulfilled-expect]
Main.gob:9:5: warning: this statement is unreachable, since the one before it cannot complete; remove it [unreachable-code]
2 warnings
-- case malformed.a_space_after_the_sigil --
--% error
-- Main.gob --
--@ expect(unreachable-code)
fun main() {}
-- error --
a directive's name must follow '--@' directly; write '--@expect'
-- case malformed.a_space_before_the_parenthesis --
--% error
-- Main.gob --
--@expect (unreachable-code)
fun main() {}
-- error --
'--@expect' must be followed directly by '('; remove the space before it
-- case malformed.no_parenthesis --
--% error
-- Main.gob --
--@expect unreachable-code
fun main() {}
-- error --
'--@expect' must be followed directly by '(' and its arguments
-- case malformed.no_closing_parenthesis --
--% error
-- Main.gob --
--@expect(unreachable-code
fun main() {}
-- error --
this '(' has no closing ')'
-- case malformed.no_name --
--% error
-- Main.gob --
--@(unreachable-code)
fun main() {}
-- error --
a directive's name must follow '--@' directly; the only directive is 'expect'
-- case malformed.an_unknown_directive --
--% error
-- Main.gob --
--@expcet(unreachable-code)
fun main() {}
-- error --
unknown directive 'expcet'; the only directive is 'expect'
-- case malformed.no_arguments --
--% error
-- Main.gob --
--@expect()
fun main() {}
-- error --
'--@expect()' names no check; name the checks it expects
-- case malformed.an_empty_argument --
--% error
-- Main.gob --
--@expect(unreachable-code, , empty-return-value)
fun main() {}
-- error --
this list of checks has an empty entry; remove the extra ','
-- case malformed.an_unknown_check --
--% error
-- Main.gob --
--@expect(unreachable-cod)
fun main() {}
-- error --
unknown check 'unreachable-cod'; the checks are 'empty-return-value', 'ambiguous-underscore', 'unused-variable', 'unused-import', 'unused-private-function', 'var-never-reassigned', 'loop-variable-captured', 'unread-assignment', 'unreachable-code', 'repeated-condition', 'identical-operands', 'self-assignment', 'impossible-comparison', 'discarded-value', 'discarded-monadic-value', 'unit-spelling', 'detached-doc-comment', 'needless-equality', 'ord-inconsistent-with-eq'
-- case malformed.the_expectation_check --
--% error
-- Main.gob --
--@expect(unfulfilled-expect)
fun main() {}
-- error --
an expect cannot name 'unfulfilled-expect'; remove it
-- case malformed.a_check_named_twice --
--% error
-- Main.gob --
--@expect(unreachable-code, unreachable-code)
fun main() {}
-- error --
'unreachable-code' is named twice in this directive; remove one
-- case malformed.no_space_before_the_reason --
--% error
-- Main.gob --
--@expect(unreachable-code)because
fun main() {}
-- error --
a space must separate the reason from ')'
-- case malformed.inside_a_body --
-- A malformed directive is an error wherever it is, after code too.
--% error
-- Main.gob --
fun main() {
    print("x") --@expect unreachable-code
}
-- error --
'--@expect' must be followed directly by '(' and its arguments
-- case unused_import.above_an_import --
-- Main.gob --
--@expect(unused-import) kept to show the qualifier
import Data.Map as M

fun main() {
    print("quiet")
}
-- stdout --
quiet
