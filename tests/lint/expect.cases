-- `--@expect(NAME, ...)`: what each placement covers, the warning for an
-- expect that removes nothing, and the error for each malformed directive.

-- case empty_return_value.on_its_own_line --
-- Main.gob --
fun stop(done : Bool) -> Unit {
    --@expect(empty-return-value) the value is spelled out on purpose
    if done { return {} }
    print("going on")
}

fun main() {
    stop(False)
}
-- stdout --
going on
-- case empty_return_value.after_code --
-- Main.gob --
fun stop(done : Bool) -> Unit {
    if done { return {} } --@expect(empty-return-value)
    print("going on")
}

fun main() {
    stop(False)
}
-- stdout --
going on
-- case ambiguous_underscore.above_a_declaration --
-- Main.gob --
fun lookup(key : Int, table : Map Int String) -> String = Map.getOr(table, key, "?")

--@expect(ambiguous-underscore) a function of the key is what is meant
fun lookups(keys : Vec Int, table : Map Int String) -> Vec (fun(Int) -> String) =
    Vec.map(keys, fun(_) = lookup(_, table))

fun main() {
    let table = Map.new()
    Map.put(table, 1, "one")
    for f in lookups([7], table) { print(f(1)) }
}
-- stdout --
one
-- case unreachable_code.on_a_line_inside_the_statement --
-- The statement the directive covers spans several lines, and the finding is
-- on the last of them.
-- Main.gob --
fun main() {
    --@expect(unreachable-code)
    if True {
        print("once")
        return
        print("never")
    }
}
-- stdout --
once
-- case discarded_value.on_its_own_line --
-- Main.gob --
fun main() {
    let line = " padded"
    --@expect(discarded-value) only the call's effect is wanted here
    String.trim(line)
    print(line)
}
-- stdout --
 padded
-- case discarded_monadic_value.after_code --
-- Main.gob --
fun main() {
    let stack = [1, 2]
    Vec.pop(stack) --@expect(discarded-monadic-value)
    print(stack)
}
-- stdout --
[1]
-- case a_whole_function --
-- Above a declaration, the directive covers all of its body, and each name
-- is met by any number of findings.
-- Main.gob --
--@expect(empty-return-value, unreachable-code)
fun main() {
    if False { return {} }
    print("once")
    return ()
    print("never")
}
-- stdout --
once
-- case a_match_arm --
-- Main.gob --
fun describe(n : Int) -> String = match n {
    0 -> "none"
    --@expect(unreachable-code)
    _ -> {
        return "some"
        "never"
    }
}

fun main() {
    print(describe(1))
}
-- stdout --
some
-- case below_a_doc_comment --
-- Main.gob --
--- Prints once.
--@expect(unreachable-code)
fun once() -> Unit {
    print("once")
    return
    print("never")
}

fun main() {
    once()
}
-- stdout --
once
-- case unfulfilled.nothing_reports --
-- Main.gob --
--@expect(unreachable-code) there was a dead branch here once
fun main() {
    print("all reachable")
}
-- stdout --
all reachable
-- stderr --
Main.gob:1:11: warning: 'unreachable-code' finds nothing in what this expect covers; remove it from the expect [unfulfilled-expect]
1 warning
-- case unfulfilled.one_name_of_two --
-- Each name is met or not by itself.
-- Main.gob --
--@expect(empty-return-value, unreachable-code)
fun main() {
    print("once")
    return
    print("never")
}
-- stdout --
once
-- stderr --
Main.gob:1:11: warning: 'empty-return-value' finds nothing in what this expect covers; remove it from the expect [unfulfilled-expect]
1 warning
-- case unfulfilled.the_inner_of_two --
-- Of two expects that cover a finding and name its check, the inner removes
-- it, so the outer is not met.
-- Main.gob --
--@expect(unreachable-code)
fun main() {
    --@expect(unreachable-code)
    if True {
        print("once")
        return
        print("never")
    }
}
-- stdout --
once
-- stderr --
Main.gob:1:11: warning: 'unreachable-code' finds nothing in what this expect covers; remove it from the expect [unfulfilled-expect]
1 warning
-- case unfulfilled.after_code_covers_its_line --
-- After code, a directive covers only the findings that begin on its line,
-- even when the code there opens a block.
-- Main.gob --
fun main() { --@expect(unreachable-code)
    print("once")
    return
    print("never")
}
-- stdout --
once
-- stderr --
Main.gob:1:24: warning: 'unreachable-code' finds nothing in what this expect covers; remove it from the expect [unfulfilled-expect]
Main.gob:4:5: warning: this statement is unreachable, since the one before it cannot complete; remove it [unreachable-code]
2 warnings
-- case unfulfilled.the_next_statement_only --
-- On its own line, a directive covers the statement that begins next and
-- nothing after it.
-- Main.gob --
fun stop(done : Bool) -> Unit {
    --@expect(empty-return-value)
    print("going on")
    if done { return {} }
}

fun main() {
    stop(False)
}
-- stdout --
going on
-- stderr --
Main.gob:2:15: warning: 'empty-return-value' finds nothing in what this expect covers; remove it from the expect [unfulfilled-expect]
Main.gob:4:22: warning: a bare 'return' already means 'return ()'; remove '{}' [empty-return-value]
2 warnings
-- case unfulfilled.nothing_follows --
-- Main.gob --
fun main() {
    print("done")
}
--@expect(unreachable-code)
-- stdout --
done
-- stderr --
Main.gob:4:11: warning: 'unreachable-code' finds nothing in what this expect covers; remove it from the expect [unfulfilled-expect]
1 warning
-- case unfulfilled.the_end_of_a_body --
-- A directive covers only what begins inside the node it is in. At the end
-- of a body nothing does, so it covers nothing, and the finding in the next
-- declaration is reported.
-- Main.gob --
fun stop(done : Bool) -> Unit {
    print("going on")
    --@expect(empty-return-value)
}

fun main() {
    stop(False)
    if False { return {} }
}
-- stdout --
going on
-- stderr --
Main.gob:3:15: warning: 'empty-return-value' finds nothing in what this expect covers; remove it from the expect [unfulfilled-expect]
Main.gob:8:23: warning: a bare 'return' already means 'return ()'; remove '{}' [empty-return-value]
2 warnings
