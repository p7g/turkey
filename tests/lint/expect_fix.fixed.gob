-- `--fix` leaves a finding an expect removes as it is.

fun stop(done : Bool) -> Unit {
    if done { return {} } --@expect(empty-return-value) kept as written
    print("going on")
}

fun halt(done : Bool) -> Unit {
    if done { return }
    print("going on")
}

fun main() {
    stop(False)
    halt(False)
}
