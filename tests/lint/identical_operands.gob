-- A binary operator whose two operands are the same expression has a fixed
-- result or a redundant operand, and is usually a typo for another name.

type Point = Point { x : Int, y : Int }

type Segment = Segment { start : Point, end : Point }

-- A comparison, through a field path.
fun same(a : Point, b : Point) -> Bool = a.x == a.x && a.y == b.y

fun level(s : Segment) -> Bool = s.start.y != s.start.y

-- Arithmetic, with grouping parentheses that do not make the operands
-- different.
fun width(n : Int) -> Int = (n - n) * 2

fun ratio(n : Int) -> Int = (n) / n + n % (n)

fun mixed(n : Int) -> Int = Int.xor(n, 1) + (n ^ n)

-- Orderings and connectives.
fun ordered(n : Int, m : Int) -> Bool = n < n || m >= m

fun twice(flag : Bool) -> Bool = flag && flag

fun never(flag : Bool) -> Bool = !flag || !flag

-- A `Float` compared with itself is how a NaN test can be written: quiet.
fun isNumber(x : Float) -> Bool = x == x

fun notNumber(x : Float) -> Bool = x != x

-- Doubling and squaring are written with the same operand twice: quiet.
fun double(n : Int) -> Int = n + n

fun square(n : Int) -> Int = n * n

-- A call may answer differently each time, and indexing may panic: quiet.
fun next(xs : Vec Int) -> Bool = Vec.pop(xs) == Vec.pop(xs)

fun step(xs : Array Int) -> Int = xs[0] - xs[0]

-- Different operands: quiet.
fun close(a : Point, b : Point) -> Bool = a.x == b.x && a.y == b.y

fun main() {
    let p = Point { x = 1, y = 2 }
    print(same(p, p))
    print(level(Segment { start = p, end = p }))
    print(width(3))
    print(ratio(3))
    print(mixed(3))
    print(ordered(1, 2))
    print(twice(True))
    print(never(True))
    print(isNumber(1.0))
    print(notNumber(1.0))
    print(double(2))
    print(square(3))
    print(next([1, 2]))
    print(step([4]))
    print(close(p, p))
}
