-- A module may declare an operator of a fixed group again, as a function of
-- its own. That function may do anything, so its operands are not compared,
-- and nothing here is reported.

var calls = 0

fun counted(a : Int, b : Int) -> Bool {
    calls = calls + 1
    match Int.compare(a, b) {
        EQ -> calls > 1
        _  -> False
    }
}

fun minus(a : Int, b : Int) -> Int = a + -b + calls

infix Equality (==) = counted

infix Addition (-) = minus

fun main() {
    let n = 3
    print(n == n)
    print(n == n)
    print(n - n)
    if n == n {
        print("first")
    } else if n == n {
        print("second")
    }
}
