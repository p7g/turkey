-- Two comparisons of one value with constants that no value satisfies both
-- of, or that every value satisfies one of, are always `False` or always
-- `True`. The usual cause is a mistyped bound.

-- A character class with `'Z'` for `'z'`.
fun isLower(c : Char) -> Bool = c >= 'a' && c <= 'Z'

-- An integer range written backwards.
fun between(n : Int) -> Bool = n < 3 && n > 5

-- No integer is above 3 and below 4.
fun gap(n : Int) -> Bool = n > 3 && n < 4

-- The `||` dual, which every value satisfies.
fun outside(n : Int) -> Bool = n >= 3 || n < 5

-- The operand on the right of a comparison, and a negative bound.
fun cold(t : Int) -> Bool = 0 < t && t <= -10

fun distinct(n : Int) -> Bool = n != 1 || n != 2

-- Satisfiable ranges: quiet.
fun isDigit(c : Char) -> Bool = c >= '0' && c <= '9'

fun single(n : Int) -> Bool = n >= 3 && n <= 3

fun either(n : Int) -> Bool = n < 3 || n > 5

-- A bound that is not a literal: quiet.
fun within(n : Int, low : Int) -> Bool = n < low && n > 5

-- Two different operands: quiet.
fun both(n : Int, m : Int) -> Bool = n < 3 && m > 5

-- A `Float` can be NaN, for which every comparison is false: quiet.
fun real(x : Float) -> Bool = x >= 3 || x < 5

fun main() {
    print(isLower('q'))
    print(between(4))
    print(gap(3))
    print(outside(4))
    print(cold(5))
    print(distinct(1))
    print(isDigit('7'))
    print(single(3))
    print(either(4))
    print(within(4, 9))
    print(both(1, 9))
    print(real(4.0))
}
