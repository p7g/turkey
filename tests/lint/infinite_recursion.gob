-- A function whose body cannot return unless a call to itself returns first
-- never returns: the stack overflows.

type T = T(Int)

type Pair = Pair { left : Int, right : T }

-- The plain function.
fun forever(n : Int) -> Int = forever(n)

-- Every path reaches the call: the `if` has no branch that returns.
fun countdown(n : Int) -> Int {
    if n > 0 { print("positive") }
    countdown(n - 1)
}

-- Both branches call it.
fun both(n : Int) -> Int = if n > 0 { both(n - 1) } else { both(n + 1) }

-- A local function.
fun outer(n : Int) -> Int {
    fun go(k : Int) -> Int = go(k + 1)
    go(n)
}

-- The instance's `show` calls itself, at the same instance.
instance Show T {
    fun show(t) = show(t)
}

-- A default method calls itself through the class's own dictionary, which
-- is the dictionary of an instance that does not define the method.
class Size a {
    fun size(x : a) -> Int = size(x)
}

instance Size Int {}

-- Calling the class's method at a field's type calls another instance's
-- method: quiet.
instance Show Pair {
    fun show(p) = "Pair(" + show(p.left) + ")"
}

-- A self-call on some paths only: quiet.
fun factorial(n : Int) -> Int = if n <= 1 { 1 } else { n * factorial(n - 1) }

fun find(xs : Array Int, x : Int, i : Int) -> Int = match i < len(xs) {
    True  -> if xs[i] == x { i } else { find(xs, x, i + 1) }
    False -> -1
}

-- A short-circuit operand may be skipped: quiet.
fun anyPositive(xs : Vec Int) -> Bool = len(xs) > 0 && (Vec.pop(xs) == Some(1) || anyPositive(xs))

-- A `return` before the call, in a loop, or through a `?`: quiet.
fun early(n : Int) -> Int {
    if n == 0 { return 0 }
    early(n - 1)
}

fun looped(xs : Vec Int) -> Int {
    for x in xs {
        if x > 2 { return x }
    }
    looped([3])
}

fun unwrapped(o : Option Int) -> Option Int {
    let n = o?
    unwrapped(Some(n - 1))
}

-- A call inside a function value may never run: quiet.
fun later(n : Int) -> fun() -> Int = fun() = later(n)()

-- A name that shadows the function is not the function: quiet.
fun shadowed(n : Int) -> Int {
    let shadowed = fun(k : Int) = k + 1
    shadowed(n)
}

-- A body that cannot return whatever its calls do is stopped by something
-- other than recursion: quiet.
fun spin() -> Int {
    loop {}
}

fun main() {
    print(show(Pair { left = 1, right = T(2) }))
    print(factorial(5))
    print(find([4, 5, 6], 5, 0))
    print(anyPositive([1]))
    print(early(3))
    print(looped([1, 2]))
    print(unwrapped(None))
    print(shadowed(1))
}
