-- An `if let` whose conditions always hold never takes its `else`, and a
-- `while let` whose conditions always hold ends only by `break`.

type Point = Point { x : Int, y : Int }
type Shown = Shown[Show a](a)

fun main() {
    let p = (1, 2)
    if let (a, b) = p { print(a + b) } else { print(0) }

    let origin = Point { x = 0, y = 0 }
    if let Point { x, y } = origin { print(x + y) }

    let n = 3
    if let m = n { print(m) }

    -- Every condition of the list always holds.
    if let (a, _) = p, let b = a { print(b) }

    var i = 0
    while let j = i {
        i = j + 1
        if i > 2 { break }
    }

    -- A condition that can fail makes the head refutable: quiet.
    if let (a, _) = p, let Some(b) = Vec.at([a], 0) { print(b) }
    if let (a, _) = p, a > 0 { print(a) }
    if let Some(x) = Vec.at([5], 0) { print(x) }

    -- `let` cannot open an existential: quiet.
    if let Shown(v) = Shown(4) { print(show(v)) }
}
