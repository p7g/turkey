-- A `match` of one arm whose pattern always matches is a `let`, or a
-- parameter pattern when it takes apart a parameter as a function's whole
-- body.

type Point = Point { x : Int, y : Int }
type Meters = Meters(Int)
type Shown = Shown[Show a](a)
type Toggle = On | Off

fun sum(pair : (Int, Int)) {
    match pair {
        (a, b) -> print(a + b)
    }
}

fun norm(p : Point) -> Int = match p {
    Point { x, y } -> x * x + y * y
}

fun meters(m : Meters) -> Int {
    let n = match m {
        Meters(n) -> n
    }
    n * 100
}

-- Nested, and as a value.
fun nested(o : (Meters, (Int, Int))) -> Int {
    let total = match o {
        (Meters(m), (a, _)) -> m + a
    }
    total
}

-- Alternatives that together cover the type are left to the author: quiet.
fun flip(t : Toggle) -> String = match t {
    On | Off -> "toggled"
}

-- `let` cannot open an existential, so only a `match` can: quiet.
fun shown(s : Shown) -> String = match s {
    Shown(v) -> show(v)
}

fun main() {
    sum((1, 2))
    print(norm(Point { x = 3, y = 4 }))
    print(meters(Meters(2)))
    print(nested((Meters(1), (2, 3))))
    print(flip(On))
    print(shown(Shown(7)))
}
