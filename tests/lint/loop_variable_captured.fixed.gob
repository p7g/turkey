-- A function made in the body of a C-style `for` that captures the loop's
-- variable and outlives the iteration sees the variable's last value. The
-- fix copies it for each iteration.

import System.Task as Task

type Holder = Holder { run : fun() -> Int }

type Box = Box { var run : fun() -> Int }

fun pushed() -> Vec (fun() -> Int) {
    let fs = []
    for var i = 0; i < 3; i = i + 1 { let i = i; Vec.push(fs, fun() = i) }
    fs
}

fun put() -> Map Int (fun() -> Int) {
    let m = Map.new()
    for var i = 0; i < 3; i = i + 1 {
        let i = i
        Map.put(m, i, fun() = i * 10)
    }
    m
}

fun stored(box : Box, slots : Array (fun() -> Int)) -> Unit {
    for var i = 0; i < 1; i = i + 1 {
        let i = i
        slots[0] = fun() = i
        box.run = fun() = i + 1
    }
}

fun literals() -> Vec Holder {
    let out = []
    for var i = 0; i < 2; i = i + 1 {
        let i = i
        let both = [fun() = i]
        Vec.push(out, Holder { run = fun() = i })
        Vec.push(out, Holder { run = both[0] })
    }
    out
}

fun returned() -> fun() -> Int {
    for var i = 0; i < 5; i = i + 1 {
        let i = i
        if i == 2 { return fun() = i }
    }
    fun() = 0
}

fun broken() -> Vec (fun() -> Int) {
    let fs = []
    for var i = 0; i < 2; i = i + 1 {
        let i = i
        let g = loop { break fun() = i }
        fs[0] = g
    }
    fs
}

-- Bound by a `let`, then stored.
fun named() -> Vec (fun() -> Int) {
    let fs = []
    for var i = 0; i < 3; i = i + 1 {
        let i = i
        let f = fun() = i
        Vec.push(fs, f)
    }
    fs
}

fun spawned() -> Unit {
    for var i = 0; i < 1; i = i + 1 { let i = i; let _ = Task.spawn(fun() = i) }
}

-- The body assigns the variable, so a copy would not be the same program:
-- reported, with no fix.
fun assigned() -> Vec (fun() -> Int) {
    let fs = []
    for var i = 0; i < 6; i = i + 1 {
        Vec.push(fs, fun() = i)
        i = i + 1
    }
    fs
}

-- A callback runs during the iteration: quiet.
fun callback() -> Int {
    var total = 0
    for var i = 0; i < 3; i = i + 1 { total = total + len(Vec.map([1], fun(x) = x + i)) }
    total
}

-- A `for ... in` binds a fresh variable for each element: quiet.
fun fresh() -> Vec (fun() -> Int) {
    let fs = []
    for j in Int.range(0, 3) { Vec.push(fs, fun() = j) }
    fs
}

fun main() {
    for f in pushed() { print(f()) }
    for f in fresh() { print(f()) }
    if let Some(f) = Map.get(put(), 1) { print(f()) }
    print(callback())
}
