-- An equality in a context that only gives an applied type a second name.

-- Fires: `a` names `Item c` once, and the fix writes `Item c` there.
fun firstOr[Iterator c](xs : c, fallback : Item c) -> Item c = fallback

-- Fires: as an argument of an applied type, the rewrite is parenthesized.
fun collected[Iterator c, Length c](xs : c) -> Array (Item c) = Iter.collect(xs)

-- Fires: the only entry, so the brackets go too.
fun counted(xs : c, n : Int) -> Int = n

-- Quiet: two families related through `a` is a real constraint.
fun related[Index c, Iterator c, Item c ~ a, Value c ~ a](xs : c) -> Int = 0

-- Quiet: `a` is in another entry.
fun hashed[Iterator c, Item c ~ a, Hash a](xs : c) -> Int = 0

-- Quiet: written twice, the name is an abbreviation.
fun pick[Iterator c, Item c ~ a](xs : c, keep : fun(a) -> Bool, fallback : a) -> Item c =
    fallback

-- Quiet: the body names `a`.
fun annotated[Iterator c, Item c ~ a](xs : c) -> Int {
    let nothing : Option a = None
    0
}

fun main() {
    print(firstOr([1, 2], 3))
    print(collected([4, 5]))
    print(counted([1], 6))
    print(related([1]))
    print(hashed([7, 8]))
    print(pick([1], fun(_) = True, 9))
    print(annotated([1]))
}
