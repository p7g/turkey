-- An equality in a context that only gives an applied type a second name.

-- Fires: `a` names `Item c` once, and the fix writes `Item c` there.
fun firstOr[Iterator c, Item c ~ a](xs : c, fallback : a) -> Item c = fallback

-- Fires: as an argument of an applied type, the rewrite is parenthesized.
fun collected[Iterator c, Length c, Item c ~ a](xs : c) -> Array a = Iter.collect(xs)

-- Fires: the only entry, so the brackets go too.
fun counted[Item c ~ a](xs : c, n : Int) -> Int = n

-- Fires twice in one context: one finding carries the fix, and `--fix`
-- finds the other again in the text it leaves.
fun two[Item c ~ a, Key c ~ b, Iterator c](xs : c, k : b, j : a) -> Int = 0

-- Quiet: `a` is the enclosing function's, and scopes over the local signature.
fun outer[Iterator c](xs : c, y : a) -> Int {
    fun inner[Iterator d, Item d ~ a](ys : d) -> Int = 0
    inner([y])
}

-- Quiet: `s` is the class's.
class Sized s {
    fun sizeOf[Iterator c, Item c ~ s](s, c) -> Int
}

instance Sized Int {
    fun sizeOf(n, xs) = n
}

-- Quiet: two families related through `a` is a real constraint.
fun related[Index c, Iterator c, Item c ~ a, Value c ~ a](xs : c) -> Int = 0

-- Quiet: `a` is in another entry.
fun hashed[Iterator c, Item c ~ a, Hash a](xs : c) -> Int = 0

-- Quiet: written twice, the name is an abbreviation.
fun pick[Iterator c, Item c ~ a](xs : c, keep : fun(a) -> Bool, fallback : a) -> Item c =
    fallback

-- Quiet: the body names `a`.
fun annotated[Iterator c, Item c ~ a](xs : c) -> Int {
    let nothing : Option a = None
    0
}

fun main() {
    print(firstOr([1, 2], 3))
    print(collected([4, 5]))
    print(counted([1], 6))
    print(two([1], 2, 3))
    print(outer([1], 4))
    print(sizeOf(5, [6]))
    print(related([1]))
    print(hashed([7, 8]))
    print(pick([1], fun(_) = True, 9))
    print(annotated([1]))
}
