-- `ord-inconsistent-with-eq`: the converse, which the compiler refuses, and an
-- expected finding.

-- case the_converse_is_an_error --
--% error
-- Main.gob --
type Player : Ord = Player { name : String, rank : Int }

instance Eq Player {
    fun eq(a, b) = a.rank == b.rank
}

fun main() {}
-- error --
'Player' cannot derive 'Ord' while its 'Eq' is written by hand; write 'instance Ord Player' too, or remove 'instance Eq Player' and derive 'Eq'
-- case expected --
-- Main.gob --
type Version = Version { major : Int, minor : Int }

--@expect(ord-inconsistent-with-eq) compares every field, as the derived 'Eq' does
instance Ord Version {
    fun lt(a, b) = a.major < b.major || a.major == b.major && a.minor < b.minor
}

fun main() {
    print(Version { major = 1, minor = 2 } < Version { major = 1, minor = 3 })
}
-- stdout --
True
