-- A hand-written `Ord` beside a derived `Eq` usually orders by fewer fields
-- than it compares, and then `<=` holds in neither direction on a tie.

type Player = Player { name : String, rank : Int }

instance Ord Player {
    fun lt(a, b) = a.rank < b.rank
}

type Pair a = Pair(a, a)

instance Ord (Pair a) : Ord a {
    fun lt(Pair(a, _), Pair(b, _)) = a < b
}

-- Both written by hand, so they can be made to agree: quiet.
type Rank = Rank { name : String, rank : Int }

instance Eq Rank {
    fun eq(a, b) = a.rank == b.rank
}

instance Ord Rank {
    fun lt(a, b) = a.rank < b.rank
}

-- Both derived: quiet.
type Card : Ord = Card { rank : Int, suit : Int }

fun main() {
    let a = Player { name = "a", rank = 1 }
    let b = Player { name = "b", rank = 1 }
    print(a <= b)
    print(b <= a)
    print(Pair(1, 2) < Pair(2, 1))
    print(Rank { name = "a", rank = 1 } <= Rank { name = "b", rank = 1 })
    print(Card { rank = 1, suit = 2 } < Card { rank = 1, suit = 3 })
}
