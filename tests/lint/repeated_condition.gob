-- A test in an `if`/`else if` chain that repeats an earlier one can never be
-- the first to hold, so its branch never runs.

fun sign(n : Int) -> String =
    if n > 0 { "positive" } else if n > 0 { "big" } else { "other" }

-- Three branches down, and with the operands grouped differently.
fun grade(score : Int, late : Bool) -> String {
    if score >= 90 && !late {
        "A"
    } else if score >= 80 {
        "B"
    } else if late {
        "late"
    } else if (score >= 90) && (!late) {
        "A again"
    } else {
        "C"
    }
}

var calls = 0

fun ready() -> Bool {
    calls = calls + 1
    calls > 1
}

-- A condition with a call is not compared: the call may answer differently
-- the second time.
fun poll() -> String {
    if ready() {
        "first"
    } else if ready() {
        "second"
    } else {
        "never"
    }
}

-- Nor is a test after a call that ran between the two: the call may have
-- changed what the test reads.
fun after(n : Int) -> String {
    if calls > n {
        "already"
    } else if ready() {
        "now"
    } else if calls > n {
        "after"
    } else {
        "not yet"
    }
}

-- Different tests of one value are fine.
fun size(n : Int) -> String =
    if n > 100 { "large" } else if n > 10 { "medium" } else { "small" }

-- An `if let` in the chain may call too, and starts the comparison afresh.
fun first(xs : Vec Int, n : Int) -> String {
    if n > 0 {
        "positive"
    } else if let Some(x) = Vec.pop(xs) {
        Int.toString(x)
    } else if n > 0 {
        "positive"
    } else {
        "empty"
    }
}

fun main() {
    print(sign(1))
    print(grade(95, False))
    print(poll())
    print(after(5))
    print(size(50))
    print(first([3], 0))
}
