-- Assigning a variable or a field to itself changes nothing. The intended
-- value was almost always something else.

type Counter = Counter { var count : Int }

type Panel = Panel { counter : Counter }

-- A field, where the parameter of a similar name was meant.
fun reset(c : Counter, count : Int) {
    c.count = c.count
}

-- A nested field path, and grouping parentheses.
fun restore(p : Panel) {
    p.counter.count = (p.counter.count)
}

-- A parameter.
fun next(n : Int) -> Int {
    n = n
    n + 1
}

-- A top-level `var`.
var total = 0

fun bump() -> Int {
    total = total
    total + 1
}

-- An index assignment reads through `get`, which may panic, as for a missing
-- `Map` key: quiet.
fun touch(m : Map String Int, xs : Array Int) {
    xs[0] = xs[0]
    m["k"] = m["k"]
}

-- A record literal's punned field is not an assignment: quiet.
fun make(count : Int) -> Counter = Counter { count }

-- A different field or value: quiet.
fun copy(a : Counter, b : Counter) {
    a.count = b.count
}

fun main() {
    var x = 1
    x = x
    print(x)
    let c = make(2)
    reset(c, 0)
    restore(Panel { counter = c })
    print(bump())
    print(next(1))
    let m = Map.new()
    Map.put(m, "k", 1)
    touch(m, [1])
    copy(c, make(3))
    print(c.count)
}
