-- `Array.filled(n, v)` and `Vec.filled(n, v)` put the one value `v` in every
-- slot. When `v` is an object, a change through one slot shows through them
-- all. The fix makes one object per slot, and is not applied by `--fix`,
-- since a program may rely on the sharing.

import Grid as Grid

type Cell = Cell { var alive : Bool }

type Point = Point { x : Int, y : Int }

fun main() {
    -- An array of arrays.
    let grid = Array.filled(3, [0, 0])
    grid[0][1] = 9
    print(grid)

    -- A `Vec` of `Map`s.
    let tables : Vec (Map String Int) = Vec.filled(2, Map.new())
    Map.put(tables[0], "a", 1)
    print(Map.getOr(tables[1], "a", 0))

    -- A record with a `var` field.
    let cells = Array.filled(4, Cell { alive = False })
    cells[0].alive = True
    print(cells[3].alive)

    -- A frozen array of arrays: the frozen array cannot change, but the
    -- array in its slots can.
    let rows = FrozenArray.filled(2, [0])
    rows[0][0] = 5
    print(rows[1][0])

    -- Immutable elements: quiet.
    print(Array.filled(2, 0))
    print(Array.filled(2, "x"))
    print(Array.filled(2, Point { x = 1, y = 2 }))

    -- One slot shares with nothing: quiet.
    print(Array.filled(1, [0]))

    -- A `filled` of another module: quiet.
    print(Grid.filled(2, [0]))
}
