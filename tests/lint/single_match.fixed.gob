-- A `match` in which one arm does something and every other arm is `()` or
-- `{}` is an `if let`. The fix rewrites it to one.

type Light = Red | Amber | Green

fun counted(seen : Map String Int, key : String) {
    if let Some(n) = Map.get(seen, key) {
        print(n)
    }
}

-- One live arm among three constructors, and a block body.
fun go(light : Light) {
    if let Green = light {
        print("go")
        print("now")
    }
}

-- A comment that heads the arm moves into the block with it.
fun first(xs : Vec Int) {
    if let Some(x) = Vec.at(xs, 0) {
        -- The rest are not looked at.
        print(x)
    }
}

-- A comment anywhere else would be lost, so this is reported and not fixed.
fun last(xs : Vec Int) {
    match Vec.last(xs) {
        Some(x) -> print(x)
        -- empty
        None -> {}
    }
}

-- `Some(0)` would run the body once the body's arm is tried first: quiet.
fun nonzero(o : Option Int) {
    match o {
        Some(0) -> {}
        Some(n) -> print(n)
        None -> {}
    }
}

-- An earlier arm that no value of the live arm's pattern matches is fine.
fun positive(o : Option Int) {
    if let Some(n) = o {
        print(n)
    }
}

-- A catch-all live arm would need an `if let` that tests the other arms
-- failing: quiet.
fun notRed(light : Light) {
    match light {
        Red -> {}
        _ -> print("not red")
    }
}

-- A `match` whose arms are values: quiet.
fun valued(o : Option Int) -> Int = match o {
    Some(n) -> n
    None -> 0
}

-- A `match` that does nothing at all is not an `if let`: quiet.
fun idle(o : Option Int) {
    match o {
        Some(_) -> {}
        None -> ()
    }
}

fun main() {
    let seen = Map.new()
    Map.put(seen, "a", 1)
    counted(seen, "a")
    go(Green)
    first([2, 3])
    last([4])
    nonzero(Some(5))
    positive(Some(6))
    notRed(Amber)
    print(valued(None))
    idle(None)
}
