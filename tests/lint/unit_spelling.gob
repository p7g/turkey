-- `{}` is a body that does nothing and `()` is the unit value, and which one
-- is written follows from where it is written.

fun log(message : String, extra : Unit) -> Unit = print(message)

fun spill(n : Int) -> Unit = print(n)

type Op = Store(Int) | Load(Int)

-- Fires: an empty block whose value is used, to `()`.
fun used() -> Unit {
    let done = {}
    log("a", {})
    let pair = ({}, 1)
    print(pair.1)
    done
}

-- A statement `match`: `-> ()` fires, to `{}`, and `-> {}` is quiet.
--@expect(single-match) the arm that does nothing is what this tests
fun statement(op : Op) -> Unit {
    match op {
        Store(r) -> spill(r)
        _        -> ()
    }
    match op {
        Store(r) -> spill(r)
        _        -> {}
    }
    print("statement")
}

-- A `match` whose value is used: `-> {}` fires, to `()`, and `-> ()` is quiet.
--@expect(single-match) the arm that does nothing is what this tests
fun expression(op : Op) -> Unit {
    let r = match op {
        Store(r) -> spill(r)
        _        -> {}
    }
    let s = match op {
        Store(r) -> spill(r)
        _        -> ()
    }
    r
    s
}

-- A `match` as a function's last expression is a statement, and so is one
-- that is the whole of a body.
--@expect(single-match) the arm that does nothing is what this tests
fun last(op : Op) -> Unit {
    print("last")
    match op {
        Load(r) -> spill(r)
        _       -> ()
    }
}

--@expect(single-match) the arm that does nothing is what this tests
fun whole(op : Op) -> Unit = match op {
    Load(r) -> spill(r)
    _       -> ()
}

-- Quiet: where the grammar asks for a block, `{}` is a body.
fun nothing() {}

fun alsoNothing() = {}

fun unit() = ()

fun branches(c : Bool) -> Unit {
    if c {} else { nothing() }
    while c {}
    for _ in [1] {}
    let f = fun() {}
    f()
}

-- Quiet here: `empty-return-value` owns the value of a `return`.
fun early(c : Bool) -> Unit {
    if c { return {} }
    print("early")
}

-- Quiet: a block that holds a comment says why nothing happens.
--@expect(single-match) the arm that does nothing is what this tests
fun commented(op : Op) -> Unit {
    match op {
        Store(r) -> spill(r)
        _        -> {
            -- the other cases were spilled above
        }
    }
}

fun main() {
    used()
    statement(Store(1))
    expression(Load(2))
    last(Load(3))
    whole(Store(4))
    branches(False)
    early(False)
    commented(Load(5))
    alsoNothing()
    unit()
}
