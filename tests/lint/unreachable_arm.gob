-- An arm that the arms before it already take every value of, and an
-- alternative its earlier siblings already take, are never taken.

let limit = 10

fun first(o : Option Int) -> Int = match o {
    _ -> 0
    Some(x) -> x
}

fun named(n : Int) -> String = match n {
    1 -> "one"
    1 -> "uno"
    _ -> "many"
}

fun covered(o : Option Int) -> Int = match o {
    Some(x) -> x
    None -> 0
    _ -> 1
}

-- An alternative at the top of an arm, and one nested in a pattern.
fun small(o : Option Int) -> Bool = match o {
    Some(1 | 2 | 1) -> True
    Some(_) | None | Some(3) -> False
}

-- A variable named like one in scope binds a new one, and so matches
-- everything; the message says so.
fun classify(n : Int, limit : Int) -> String = match n {
    limit -> "at limit"
    _ -> "other"
}

fun atTop(n : Int) -> String = match n {
    limit -> "at the top-level limit"
    _ -> "other"
}

-- Every arm is reached: quiet.
fun sign(n : Int) -> String = match n {
    0 -> "zero"
    _ -> "other"
}

fun main() {
    print(first(Some(1)))
    print(named(1))
    print(covered(None))
    print(small(Some(2)))
    print(classify(3, 4))
    print(atTop(limit))
    print(sign(0))
}
