-- A value assigned to a local `var` that no path reads before the next
-- assignment or the end of the variable's scope.

fun f(xs : Array Int) -> Int {
    var total = 0
    for x in xs { total = total + x }
    total = 0
    total = len(xs)
    total
}

fun g(flag : Bool) -> Int {
    var n = 1
    if flag { n = 2 }
    n = 3
    n
}

-- An assignment just before a `return` that does not read it.
fun early(flag : Bool) -> Int {
    var result = 0
    if flag {
        result = 5
        return 1
    }
    result
}

-- The next round reads what this one assigned: quiet.
fun carried(xs : Array Int) -> Int {
    var previous = 0
    var steps = 0
    for x in xs {
        if x > previous { steps = steps + 1 }
        previous = x
    }
    steps
}

-- The same through `continue`, in a C-style `for`: quiet.
fun skipping(n : Int) -> Int {
    var last = -1
    for var i = 0; i < n; i = i + 1 {
        if i % 2 == 0 {
            last = i
            continue
        }
        last = last + 1
    }
    last
}

-- A function that captures the `var` may read it whenever it runs: quiet.
fun captured() -> Int {
    var seen = 0
    let read = fun() = seen
    seen = 4
    seen = 5
    read()
}

-- An initializer every path overwrites is often written so on purpose:
-- quiet.
fun initialized(flag : Bool) -> Int {
    var x = 0
    if flag { x = 1 } else { x = 2 }
    x
}

-- A `match` takes exactly one arm, so the store before it is dead.
fun arms(o : Option Int) -> Int {
    var v = 0
    v = 9
    match o {
        Some(k) -> { v = k }
        None    -> { v = -1 }
    }
    v
}

-- A call that cannot return ends the path.
fun dies(flag : Bool) -> Int {
    var code = 0
    if flag {
        code = 3
        error("stop")
    }
    code
}

-- `x = x` is another check's: quiet here.
fun again() -> Int {
    var same = 1
    same = 2
    same = same
    same = 3
    same
}

fun main() {
    print(f([1, 2]) + g(True) + early(False) + carried([1, 3, 2]) + skipping(5))
    print(captured() + initialized(True) + arms(None) + dies(False) + again())
}
