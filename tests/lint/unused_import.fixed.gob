-- An import, or an entry of its list, that brings nothing a reference reads.
-- The fix deletes the entry, or the whole import when nothing in it is used.

export (main, Ordering(..), byLength)

import Data.Set as Set
import Data.Option (isSome)
import Data.Num ((+))
import Data.Ordering (Ordering(..))
import Data.Vec (map as _, filter)
import Data.Int (gcd)

-- Hides the imported 'abs', which no reference can then mean.
fun abs(n : Int) -> Int = if n < 0 { -n } else { n }

-- Passed on by the export list: used, though nothing here reads it.
fun byLength(a : String, b : String) -> Int = String.codePointCount(a) - String.codePointCount(b)

fun main() {
    let s = Set.new()
    Set.add(s, 1)
    print(isSome(Some(abs(-3) + gcd(4, 6))))
    print(len(filter([1, 2, 3], fun(x) = x > 1)))
}
