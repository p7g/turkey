-- An import, or an entry of its list, that brings nothing a reference reads.
-- The fix deletes the entry, or the whole import when nothing in it is used.

export (main, Ordering(..), byLength)

import Data.Map as M
import Data.Set as Set
import Data.Option as Opt (unwrapOr, isSome)
import Data.Num (Add(..), (+), (*))
import Data.Either (Either(..))
import Data.Ordering (Ordering(..))
import Data.Vec (map as _, filter)
import Data.Int (abs, gcd)
-- An empty list of a module every program loads anyway.
import Data.Bool ()
-- A comment after the import would be left behind, so the fix is not
-- mechanical.
import Data.Tuple as Tuple -- for pairs

-- Each of these is used: quiet.
-- A type, named only in an annotation.
import Data.Map (Map)
-- A class named by an instance's head, whose method the instance defines.
import Text.Show (Show)
-- A list import still brings the module's own qualifier, which reaches
-- `Data.Set.new`.
import Data.Set (Set)
-- An empty list is for what loading the module does.
import System.IO ()

type Unit2 = Unit2

instance Show Unit2 {
    fun show(_) = "Unit2"
}

fun size(m : Map Int Int) -> Int = len(m)

-- Hides the imported 'abs', which no reference can then mean.
fun abs(n : Int) -> Int = if n < 0 { -n } else { n }

-- Passed on by the export list: used, though nothing here reads it.
fun byLength(a : String, b : String) -> Int = String.codePointCount(a) - String.codePointCount(b)

fun main() {
    let s = Set.new()
    Set.add(s, 1)
    print(isSome(Some(abs(-3) + gcd(4, 6))))
    print(len(filter([1, 2, 3], fun(x) = x > 1)))
    let t : Set Int = Data.Set.new()
    print(show(Unit2) + Int.toString(size(Map.new()) + len(t)))
}
