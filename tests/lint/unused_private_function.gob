-- A top-level binding of a module with an export list that the list does not
-- name and nothing reaches.

export (main, exported, Shape(..), (<+>))

type Shape = Circle | Square

fun helper(n : Int) -> Int = n + 1

let table = [1, 2, 3]

-- Its own recursion does not reach it.
fun countdown(n : Int) -> Int = if n == 0 { 0 } else { countdown(n - 1) }

-- Nor do two that call each other and nothing else.
fun isEven(n : Int) -> Bool = if n == 0 { True } else { isOdd(n - 1) }

fun isOdd(n : Int) -> Bool = if n == 0 { False } else { isEven(n - 1) }

-- Exported, reached from an export, reached from `main`, or from an
-- instance method: quiet.
fun exported() -> Int = viaExport()

fun viaExport() -> Int = 2

fun viaMain() -> Int = 3

fun viaInstance(s : Shape) -> String = match s {
    Circle -> "circle"
    Square -> "square"
}

instance Show Shape {
    fun show(s) = viaInstance(s)
}

-- What an operator means, though the module exports only the operator:
-- quiet.
infix Addition (<+>) = plus

fun plus(a : Int, b : Int) -> Int = a + b

-- An initializer that makes a call may be there for what the call does:
-- quiet.
let announced = {
    print("loaded")
    1
}

fun main() {
    print(exported() + viaMain())
    print(show(Circle))
}
