-- A local binding nothing reads. The fix renames a statement's binding
-- `_name` and writes `_` for a variable inside a pattern.

type Point = Point { x : Int, y : Int }

fun lets(a : Int) -> Int {
    let _unused = a * 2
    var _never = 4
    let (left, _) = (a, a + 1)
    left
}

fun arms(o : Option Int) -> Int = match o {
    Some(_) -> 0
    None    -> 1
}

fun loops(xs : Vec Int) -> Int {
    var count = 0
    for _ in xs { count = count + 1 }
    for (k, _) in [(1, 2)] { count = count + k }
    count
}

fun conditions(o : Option Int) -> Int {
    if let Some(_) = o { return 1 }
    while let Some(_) = o { return 2 }
    0
}

fun elses(o : Option Int) -> Int {
    let Some(_) = o else { return 0 }
    1
}

fun functions() -> Int {
    fun _helper(n : Int) -> Int = if n == 0 { 0 } else { _helper(n - 1) }
    1
}

-- Read only by its own assignments: unused, and the fix renames every
-- occurrence.
fun counts() -> Int {
    var _steps = 0
    _steps = _steps + 1
    2
}

-- A punned record field is written out in full.
fun record(p : Point) -> Int {
    let Point { x, y = _ } = p
    x
}

-- An or-pattern binds one variable in each alternative.
fun either(e : Either Int Int) -> Int = match e {
    Left(_) | Right(_) -> 0
}

-- A leading `_` says it is meant, and a parameter is never reported: quiet.
fun quiet(unusedParameter : Int) -> Int {
    let _meant = 1
    let f = fun(ignored : Int) = 3
    f(0)
}

-- Before desugaring, a later condition's reference means the `var`
-- condition's binder, so the first `x` is read: quiet. The second `x`, which
-- shadows it, is assigned and read in the body: quiet.
fun shadowed(o : Option Int) -> Int {
    if var x = o, let Some(y) = x, let x = y + 1 {
        x = x + 1
        return x
    }
    0
}

-- A `var` condition's binder that a later one shadows before anything reads
-- it is unused.
fun shadowedUnread(o : Option Int) -> Int {
    if var x = o, let x = 2 { return x }
    0
}

-- The same, where the body assigns the second `x`: it is assignable because
-- the first is a `var`, so renaming the first is no fix.
fun shadowedAssigned(o : Option Int) -> Int {
    if var x = o, let x = 2 {
        x = x + 1
        return x
    }
    0
}

-- Each of these is read: quiet.
fun reads(o : Option Int) -> Int {
    -- by a lambda that captures it,
    let captured = 1
    let f = fun() = captured
    -- by a local function,
    let nested = 2
    fun g() -> Int = nested
    -- by the initializer of the binding that shadows it,
    let x = 3
    let x = x + 1
    -- in a later round of the loop,
    var carried = 0
    var total = 0
    for i in Int.range(0, 3) {
        total = total + carried
        carried = i
    }
    -- and by a later condition alone.
    if let Some(n) = o, n > 0 { return f() }
    f() + g() + x + total
}

fun main() {
    print(lets(1) + arms(None) + loops([1]) + conditions(None))
    print(elses(None) + functions() + counts() + record(Point { x = 1, y = 2 }))
    print(reads(None))
    print(either(Left(1)) + quiet(0) + shadowed(Some(1)) + shadowedUnread(None) + shadowedAssigned(None))
}
