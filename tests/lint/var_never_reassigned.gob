-- A `var` that nothing assigns, which the fix makes a `let`.

fun plain() -> Int {
    var going = True
    var count = 0
    while going {
        count = count + 1
        if count > 2 { return count }
    }
    0
}

fun conditions(o : Option Int) -> Int {
    if var Some(n) = o { return n }
    while var Some(m) = o { return m }
    0
}

-- A lambda shares the variable's cell, so an assignment in one counts: quiet.
fun inLambda() -> Int {
    var seen = 0
    let bump = fun() { seen = seen + 1 }
    bump()
    seen
}

-- Only one of the pattern's variables is assigned, so the `var` must stay,
-- and the other is reported with no fix.
fun destructured() -> Int {
    var (low, high) = (1, 2)
    high = high + low
    high
}

-- Before desugaring, the later `let x` is assignable only because the first
-- condition is a `var`; the body's assignment to it keeps the `var`: quiet.
fun shadowed(o : Option Int) -> Int {
    if var Some(x) = o, let x = x + 1 {
        x = x * 2
        return x
    }
    0
}

-- A counter the step never assigns.
fun counter() -> Int {
    var total = 0
    for var limit = 3; total < limit; total = total + 1 {}
    total
}

-- A `let` generalizes a value, which can change its type: `n` is a `Float`
-- at both uses, where `let n = 1` would be an `Int` at the first and print
-- `1`. So the fix is not mechanical for a value, and is for a call.
fun generalized() {
    var n = 1
    print(n)
    print(n / 2.0)
    var size = len([1, 2])
    print(size)
}

fun main() {
    print(plain() + conditions(Some(1)) + inLambda() + destructured())
    print(shadowed(Some(1)) + counter())
    generalized()
}
