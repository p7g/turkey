-- A parameterized alias in a constructor's payload and in a record field.

type Fn a = fun(Int) -> a
type Pair a = (a, a)

type W a = W(Fn a)
type Box a = Box { both : Pair a, step : Fn a }

fun main() {
    let W(f) = W(fun(x) = x + 1)
    print(f(2))
    let b = Box { both = ("x", "y"), step = fun(n) = Int.toString(n) }
    print(b.both.1 + b.step(7))
}
