-- A name bound by every alternative of an arm is one variable, however many
-- alternatives bind it, and an alternative's variable shadows an outer one of
-- the same name. The suite compiles this with the resolution check on, which
-- fails if the alternatives' `x` are given different binders.

type Shape = Circle(Int) | Square(Int) | Rect(Int, Int) | Dot

fun size(s : Shape) -> Int {
    let x : Int = 100
    match s {
        Circle(x) | Square(x) -> x
        Rect(w, h) -> w * h
        Dot -> x
    }
}

fun label(s : Shape) -> String = match s {
    Circle(n) | Square(n) | Rect(n, _) -> match n {
        0 | 1 -> "small"
        n -> "size " + Int.toString(n)
    }
    Dot -> "dot"
}

fun main() {
    for s in [Circle(3), Square(4), Rect(2, 5), Dot, Square(1)] {
        print(Int.toString(size(s)) + " " + label(s))
    }
}
