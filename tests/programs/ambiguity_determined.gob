-- A variable the type determines, however indirectly, is not ambiguous: as a
-- class argument of a parameter's type, through an equality from a family
-- of a determined variable (`F a ~ b`, then `G b ~ c`), through equality
-- superclasses, and in a local signature.

class Cg a { type G a; fun mkG(a) -> G a }
class Cf a { type F a; fun mkF(a) -> F a }

instance Cf Int { type F = Bool; fun mkF(n) = n > 0 }
instance Cg Bool { type G = String; fun mkG(b) = if b { "yes" } else { "no" } }
instance Cg Int { type G = Bool; fun mkG(n) = n < 0 }

fun viaEquality[Cf a, F a ~ b, Show b](x : a) -> String = show(mkF(x))

fun chained[Cf a, Cg b, F a ~ b, G b ~ c, Show c](x : a) -> String = show(mkG(mkF(x)))

fun both[Cf a, Cg b, F a ~ G b](x : a, y : b) -> Int = 0

fun shown[Iterator s, Show (Item s)](xs : s) -> String {
    var out = ""
    for x in xs { out = out + show(x) }
    out
}

class Bytes s : Index s, Key s ~ Int, Value s ~ Byte {}

type Packet = Packet(Array Byte)

instance Index Packet {
    type Key = Int
    type Value = Byte
    fun get(Packet(bytes), i) = bytes[i]
}

instance Bytes Packet {}

fun firstByte[Bytes s, Show (Value s)](bytes : s) -> String = show(bytes[0])

fun outer(n : Int) -> String {
    fun inner[Cf a](x : a) -> F a = mkF(x)
    show(inner(n))
}

fun main() {
    print(both(3, -1))
    print(shown([1, 2, 3]))
    print(firstByte(Packet([Byte.truncate(7)])))
    print(outer(-2))
}
