-- System.Args: a command line read one argument at a time, with the value of
-- an option taken only when the caller asks for it.

import System.Args as Args
import System.Args (Arg(..))

-- Every argument, taking a value after the options in `valued`, which is
-- what a caller's `match` decides in a real program.
fun read(args : Array String, valued : Array String) {
    let p = Args.parser(args)
    loop {
        match Args.next(p) {
            Left(message) -> {
                print("  error: " + message)
                break
            }
            Right(None) -> break
            Right(Some(arg)) -> {
                let name = spelled(arg)
                if Array.contains(valued, name) {
                    match Args.value(p) {
                        Left(message) -> {
                            print("  error: " + message)
                            break
                        }
                        Right(v) -> print("  " + kind(arg) + " " + name + " = " + v)
                    }
                } else {
                    print("  " + kind(arg) + " " + name)
                }
            }
        }
    }
}

fun spelled(arg : Arg) -> String = match arg {
    Short(c) -> "-" + Char.toString(c)
    Long(n) -> "--" + n
    Value(v) -> v
}

fun kind(arg : Arg) -> String = match arg {
    Short(_) -> "short"
    Long(_) -> "long"
    Value(_) -> "value"
}

fun case(title : String, args : Array String, valued : Array String) {
    print(title)
    read(args, valued)
}

fun main() {
    case("values and options", ["build", "--verbose", "-q", "main.gob"], [])
    case("a cluster", ["-abc"], [])
    case("a value after its option", ["-o", "out.s", "--target", "arm64-linux"],
         ["-o", "--target"])
    case("a value attached", ["-oout.s", "-o=out.s", "--target=arm64-linux"],
         ["-o", "--target"])
    case("a value taken from the middle of a cluster", ["-vofile"], ["-o"])
    case("a value that looks like an option", ["-o", "-", "--dump", "--x"],
         ["-o", "--dump"])
    case("a lone dash is a value", ["-", "--x"], [])
    case("everything after -- is a value", ["--x", "--", "--y", "-z"], [])
    case("an empty value attached", ["--name="], ["--name"])
    case("a value nobody asked for", ["--verbose=no", "--quiet"], [])
    case("a value that is missing", ["--target"], ["--target"])
    print(Args.unexpected(Short('x')))
    print(Args.unexpected(Long("frob")))
    print(Args.unexpected(Value("extra.gob")))
}
