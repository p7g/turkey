-- Arrays compare element by element: equal lengths, equal elements.
fun main() {
    print([1, 2, 3] == [1, 2, 3])
    print([1, 2, 3] == [1, 2])
    print([1, 2, 3] != [1, 2, 4])
    print(([] : Array Int) == [])
    print([["a"], ["b", "c"]] == [["a"], ["b", "c"]])
    print([Some(1), None] == [Some(1), None])

    -- Two arrays built apart are equal while their elements are, and stop
    -- being equal when one is assigned to.
    let xs = Array.filled(3, 0)
    let ys = [0, 0, 0]
    print(xs == ys)
    xs[1] = 7
    print(xs == ys)
}
