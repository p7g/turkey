-- `Array.filled` at every element width: every length from 0 to 70, around
-- the words and pairs of words a new array is filled in, and lengths on either
-- side of the largest array the compiler allocates inline, which the runtime
-- fills instead.
--
-- Every array made is kept until the end and checked then, so a fill that
-- strayed past its own elements into a neighbour shows up as a wrong element
-- there. The fills are computed, and so held in a register with whatever the
-- bits above the element are, and also constant.

fun byte(n : Int) -> Byte = Byte.truncate(n * 37 + 1)

fun char(n : Int) -> Char = Option.unwrapOr(Char.fromInt(0x3B1 + n % 40), 'x')

-- Whether every element of `xs` passes `p`.
fun every(xs : Array a, p : fun(a) -> Bool) -> Bool = !Iterator.any(xs, fun(x) = !p(x))

-- The lengths tried: 0 to 70, and those around `limit` elements, the most
-- that fit inline at this width.
fun lengths(limit : Int) -> Array Int {
    let out = []
    for n in Int.range(0, 71) { Vec.push(out, n) }
    for n in Int.range(limit - 2, limit + 3) { Vec.push(out, n) }
    Vec.toArray(out)
}

-- One array per length, each filled with `make` of its index, all checked
-- once the last is made.
fun check[Eq a](label : String, limit : Int, make : fun(Int) -> a) -> Unit {
    let made = []
    let ns = lengths(limit)
    for k in Int.range(0, len(ns)) { Vec.push(made, Array.filled(ns[k], make(k))) }
    var agreed = 0
    for k in Int.range(0, len(ns)) {
        let xs = made[k]
        if len(xs) == ns[k] && every(xs, fun(x) = x == make(k)) { agreed = agreed + 1 }
    }
    print(label + ": " + Int.toString(agreed) + " of " + Int.toString(len(ns)))
}

-- The same with a constant fill, which the compiler widens itself.
fun constants() -> Unit {
    let bytes = []
    let chars = []
    let ints = []
    let floats = []
    for n in Int.range(0, 71) {
        Vec.push(bytes, Array.filled(n, Byte.truncate(0xA5)))
        Vec.push(chars, Array.filled(n, 'é'))
        Vec.push(ints, Array.filled(n, -1))
        Vec.push(floats, Array.filled(n, -0.5))
    }
    var agreed = 0
    for n in Int.range(0, 71) {
        if every(bytes[n], fun(x) = x == Byte.truncate(0xA5))
                && every(chars[n], fun(x) = x == 'é')
                && every(ints[n], fun(x) = x == -1)
                && every(floats[n], fun(x) = x == -0.5) {
            agreed = agreed + 1
        }
    }
    print("constant: " + Int.toString(agreed) + " of 71")
}

fun main() {
    -- The header is 16 bytes and the inline limit 32,760.
    check("Byte", 32744, byte)
    check("Char", 8186, char)
    check("Int", 4093, fun(k) = k * 1_000_003 - 7)
    check("Float", 4093, fun(k) = Float.fromInt(k) / 4.0)
    check("Bool", 4093, fun(k) = k % 3 == 0)
    check("String", 4093, fun(k) = Int.toString(k))
    constants()
}
