import Data.Set (Set)
import Data.Set as Set

-- Equal when the numbers are, whatever the tags: the tags show which of
-- several equal elements a fold returns.
type K = K { n : Int, tag : String }

instance Eq K { fun eq(a, b) = a.n == b.n }
instance Ord K { fun lt(a, b) = a.n < b.n }

fun tagOf(k : K) -> String = k.tag

-- Ordering of nested arrays, and the eager folds over anything iterable.
fun main() {
    print(Array.sort([[2], [1, 5], [], [1], [1, 2]]))
    print([1, 2] < [1, 2, 0])
    print([1, 3] < [1, 2, 9])
    print(([] : Array Int) < [])
    print(Vec.sort([[3], [1, 1], [1]]))

    let xs = [3, 1, 4, 1, 5]
    print(Iter.sum(xs))
    print(Iter.product(xs))
    print(Iter.sum(([] : Array Int)))
    print(Iter.product(([] : Array Int)))
    print(Iter.sum([1.5, 2.5]))
    print(Iter.minimum(xs))
    print(Iter.maximum(xs))
    print(Iter.minimum(([] : Array Int)))
    print(Iter.maximum(Vec.fromArray(xs)))
    print(Iter.sum(Int.range(1, 11)))
    print(Iter.product(Int.range(1, 6)))
    print(Iter.fold(xs, "", fun(acc, x) = acc + Int.toString(x)))
    print(Iter.fold(Int.range(0, 4), 0, fun(a, x) = a * 2 + x))

    let words = ["bb", "a", "cc", "d"]
    print(Iter.minBy(words, String.byteLength))
    print(Iter.maxBy(words, String.byteLength))
    print(Iter.minBy(words, fun(w) = 0))
    print(Iter.maxBy(words, fun(w) = 0))
    print(Iter.maxBy(([] : Array String), String.byteLength))

    let s : Set Int = Set.new()
    for x in xs { Set.add(s, x) }
    print(Iter.sum(s))
    print(Iter.maximum(s))

    let m : Map Int Int = Map.new()
    Map.put(m, 1, 10)
    Map.put(m, 2, 20)
    print(Iter.sum(Map.values(m)))
    print(Iter.maximum(m))

    -- Ties go to the first element.
    let ks = [K { n = 1, tag = "a" }, K { n = 0, tag = "b" }, K { n = 0, tag = "c" }, K { n = 1, tag = "d" }]
    print(Option.map(Iter.minimum(ks), tagOf))
    print(Option.map(Iter.maximum(ks), tagOf))
    print(Option.map(Iter.minBy(ks, fun(k) = k.n), tagOf))
    print(Option.map(Iter.maxBy(ks, fun(k) = k.n), tagOf))
    print(Iter.minimum([Float.nan(), 1.0, 2.0]))
    print(Iter.minimum([1.0, Float.nan(), 0.5]))
}
