import Base64 as Base64

fun check(condition : Bool, label : String) {
    if !condition { error("FAIL: " + label) }
    print("PASS: " + label)
}

fun main() {
    -- RFC 4648 §10.
    let vectors = [("", ""), ("f", "Zg=="), ("fo", "Zm8="), ("foo", "Zm9v"), ("foob", "Zm9vYg=="),
                   ("fooba", "Zm9vYmE="), ("foobar", "Zm9vYmFy")]
    for (plain, encoded) in vectors {
        check(Base64.encode(String.toBytes(plain)) == encoded, "encode " + show(plain))
        check(Option.map(Base64.decode(encoded), String.fromBytes) == Some(String.fromBytes(String.toBytes(plain))),
              "decode " + show(encoded))
    }

    -- Bytes that are not UTF-8, all 256 values, round-trip.
    let every = Array.init(256, Byte.truncate)
    let text = Base64.encode(every)
    print(text)
    let back = Option.expect(Base64.decode(text), "all 256 byte values decode")
    var same = len(back) == 256
    for var i = 0; i < len(back); i = i + 1 {
        if Byte.toInt(back[i]) != i { same = False }
    }
    check(same, "all 256 byte values round-trip")
    check(Base64.encode([Byte.truncate(0xFF), Byte.truncate(0xFE)]) == "//4=", "bytes that are not UTF-8 encode")
    check(show(Option.map(Base64.decode("//4="), fun(bs) = Array.map(bs, Byte.toInt))) == "Some([255, 254])",
          "and decode")

    -- Anything `encode` would not write is refused.
    for refused in ["Zg", "Zg=", "Zm8", "Z===", "Zg==Zg==", "Zm 9v", "Zm9v\n", "Zm9v====", "Zh==", "Zm9=",
                    "Zm-v", "Zm_v", "=Zm9", "Zm=v"] {
        check(Option.isNone(Base64.decode(refused)), "refused " + show(String.replace(refused, "\n", "\\n")))
    }
}
