newTape : fun() -> Tape
inc : [HasField "data" a b, HasField "pos" a (Index.IndexKey b), OneOf (Index.IndexItem b) {Int, Float}, Add (Index.IndexItem b), Index b, Rem (Index.IndexItem b)] fun(a, Index.IndexItem b) -> Unit
move : [HasField "pos" a Int, HasField "data" a (Array b), OneOf b {Int, Float}] fun(a, Int) -> Unit
get : [HasField "data" a b, HasField "pos" a (Index.IndexKey b), Index b] fun(a) -> Index.IndexItem b
parse : [Index.IndexKey a ~ Int, Index.IndexItem a ~ Char, Length a, Index a] fun(a, Int) -> (Array Op, Int)
run : [Iterator a, Iterator.Item a ~ Op] fun(Tape, a) -> Unit
hello : String
bench : String
main : fun() -> Unit
