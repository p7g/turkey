newTape : fun() -> Tape
inc : [HasField "data" a (Array b), HasField "pos" a Int, OneOf b {Int, Float}, Add b, Rem b] fun(a, b) -> Unit
move : [HasField "pos" a Int, HasField "data" a (Array b), OneOf b {Int, Float}] fun(a, Int) -> Unit
get : [HasField "data" a (Array b), HasField "pos" a Int] fun(a) -> b
parse : fun(Array Char, Int) -> (Array Op, Int)
run : [Iterator a, Item a ~ Op] fun(Tape, a) -> Unit
hello : String
bench : String
main : fun() -> Unit
