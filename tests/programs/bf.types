newTape : fun() -> Tape
inc : [HasField "data" a b, HasField "pos" a (Index.Key b), OneOf (Index.Value b) {Int, Float}, Add (Index.Value b), Index b, Rem (Index.Value b)] fun(a, Index.Value b) -> Unit
move : [HasField "pos" a Int, HasField "data" a (Array b), OneOf b {Int, Float}] fun(a, Int) -> Unit
get : [HasField "data" a b, HasField "pos" a (Index.Key b), Index b] fun(a) -> Index.Value b
parse : [Index.Key a ~ Int, Index.Value a ~ Char, Length a, Index a] fun(a, Int) -> (Array Op, Int)
run : [Iterator a, Iterator.Item a ~ Op] fun(Tape, a) -> Unit
hello : String
bench : String
collect : fun(String) -> Array Char
main : fun() -> Unit
