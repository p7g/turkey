-- `Bifunctor` and the functions over it (LIBRARY-DESIGN §6). `Either` is
-- right-biased, so `Functor (Either l)` reaches only the right half; `bimap`
-- is how the left is reached, and reaching it says nothing about errors.

-- The Prelude does not mention this module at all, so a program that wants it
-- asks for it -- unlike `Either.mapLeft`, which rides the Prelude's qualified
-- re-export of `Data.Either`. Two imports because they buy different things:
-- the alias for `Bifunctor.first`, and the bracket for the class name, which
-- an instance head needs bare. A selective import narrows the *qualified*
-- names too, so `as Bifunctor (Bifunctor(..))` alone would not define
-- `Bifunctor.first`.
import Data.Bifunctor as Bifunctor
import Data.Bifunctor (Bifunctor(..))

type Slot a b = Slot(a, b)

instance Bifunctor Slot {
    fun bimap(s, g, h) = match s {
        Slot(x, y) -> Slot(g(x), h(y))
    }
}

instance Show (Slot a b) : Show a, Show b {
    fun show(s) = match s {
        Slot(x, y) -> "Slot(" + show(x) + ", " + show(y) + ")"
    }
}

fun name(n : Int) -> String = "n" + Int.toString(n)

fun main() {
    let bad : Either Int String = Left(3)
    let good : Either Int String = Right("ok")

    -- Both halves at once, and each half on its own.
    print(bimap(bad, name, String.byteLength))
    print(bimap(good, name, String.byteLength))
    print(Bifunctor.first(bad, name))
    print(Bifunctor.second(bad, String.byteLength))
    print(Bifunctor.first(good, name))
    print(Bifunctor.second(good, String.byteLength))

    -- `Either.mapLeft` is `first` on the module that owns the type.
    print(Either.mapLeft(bad, name))
    print(Either.mapLeft(good, name))

    -- `second` agrees with `map`: the law nothing checks, checked here.
    print(Bifunctor.second(good, String.byteLength) == map(good, String.byteLength))
    print(Bifunctor.second(bad, String.byteLength) == map(bad, String.byteLength))

    -- A user type is an instance on the same terms as the library's.
    print(bimap(Slot(1, "x"), name, String.byteLength))
    print(Bifunctor.first(Slot(1, "x"), name))

    -- `bimap` with two identities is the identity.
    print(bimap(bad, fun(x) = x, fun(y) = y) == bad)
}
