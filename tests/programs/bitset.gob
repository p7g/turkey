-- A dense set of small integers: the word boundaries, a word's sign bit, and
-- the in-place union that says whether it grew.

import Data.BitSet as BitSet

fun main() {
    let s = BitSet.new(200)
    for n in [130, 0, 64, 63, 1, 199, 127] { BitSet.add(s, n) }
    print(show(BitSet.elements(s)))
    print(show(BitSet.contains(s, 63)) + " " + show(BitSet.contains(s, 62)))

    print(show(BitSet.remove(s, 63)) + " " + show(BitSet.remove(s, 63)))
    print(show(BitSet.elements(s)))

    let t = BitSet.new(200)
    BitSet.add(t, 63)
    BitSet.add(t, 64)
    print(show(BitSet.unionInto(s, t)))
    print(show(BitSet.unionInto(s, t)))
    print(show(BitSet.elements(s)))

    let u = BitSet.new(200)
    print(show(BitSet.isEmpty(u)) + " " + show(BitSet.isEmpty(s)))
    print(show(BitSet.equal(u, s)))
    BitSet.copyFrom(u, s)
    print(show(BitSet.equal(u, s)))
    BitSet.clear(u)
    print(show(BitSet.elements(u)) + " " + show(BitSet.isEmpty(u)))

    -- Every position in a word, which is every entry of the index table.
    let all = BitSet.new(64)
    for var n = 0; n < 64; n = n + 1 { BitSet.add(all, n) }
    var ok = True
    let xs = BitSet.elements(all)
    for var n = 0; n < 64; n = n + 1 { if xs[n] != n { ok = False } }
    print(show(len(xs)) + " " + show(ok))

    print(show(BitSet.elements(BitSet.new(0))))
}
