-- Two bit sets are equal when they hold the same elements, whatever
-- capacities they were made with.

import Data.BitSet as BitSet

fun main() {
    let small = BitSet.new(10)
    let large = BitSet.new(200)
    BitSet.add(small, 3)
    BitSet.add(large, 3)
    print(small == large)
    BitSet.add(large, 150)
    print(small == large)
    print(large == small)
}
