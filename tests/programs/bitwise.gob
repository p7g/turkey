-- The bitwise operators: their groups, `Int` and `Byte`, and a type with an
-- instance for one of them and no others.

type Flags = Flags(Int)

instance BitOr Flags {
    fun or(Flags(a), Flags(b)) = Flags(a | b)
}

fun bits(Flags(n)) -> Int = n

fun main() {
    -- BitAnd binds tighter than Equality and Comparison.
    let mask = 0b1000
    print(12 & mask == 0)
    print(1 << 4 > 15)
    -- BitShift binds tighter than BitOr, and BitAnd than BitXor.
    print(1 << 4 | 1)
    print(0xF0 ^ 0xFF & 0x0F)
    -- `>>` copies the sign bit.
    print(-16 >> 2)
    print(Byte.truncate(0x0F) | Byte.truncate(0xF0))
    print(Byte.truncate(0x81) << 1)
    print(bits(Flags(1) | Flags(4)))
}
