-- `Bool` and `()` hash, so they can be keys, alone or inside a tuple.
import Data.Set as Set

fun main() {
    let votes : Map Bool Int = Map.new()
    for ballot in [True, False, True, True] {
        Map.update(votes, ballot, 0, _ + 1)
    }
    print(votes[True])
    print(votes[False])

    let seen = Set.new()
    Set.add(seen, ((), True))
    Set.add(seen, ((), True))
    Set.add(seen, ((), False))
    print(len(seen))
    print(() == ())
    print(hash(()) == hash(()))
}
