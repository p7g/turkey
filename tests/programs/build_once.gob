-- A constructor application passed to a parameter its body reads twice.
--
-- `twin` and `labelled` are inlined into `grow` and `regrow`, and the
-- `.opt` golden shows each building the inner `Node` once, bound to a name
-- both fields read. In `labelled`, the inlined `label` leaves a `match` on the
-- parameter inside the constructor application, off the `let` chain: it still
-- gets the build itself, and selects its arm, so no test of the tag is left.

type Tree = Leaf | Node(Tree, Int, Tree)

fun size(t : Tree) -> Int = match t {
    Leaf -> 0
    Node(left, _, right) -> size(left) + 1 + size(right)
}

fun twin(t : Tree) -> Tree = Node(t, 0, t)

fun label(t : Tree) -> Int = match t {
    Node(_, n, _) -> n
    Leaf -> 0
}

fun labelled(t : Tree) -> Tree = Node(t, label(t), t)

fun grow(n : Int) -> Tree = twin(Node(Leaf, n, Leaf))

fun regrow(n : Int) -> Tree = labelled(Node(Leaf, n, Leaf))

fun main() {
    print(size(grow(1)))
    print(size(regrow(2)))
}
