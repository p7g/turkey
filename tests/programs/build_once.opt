-- bindings
Main#size : fun(Tree) -> Int =
  fun(t : Tree) {
    match t {
      Main#Leaf ->
        0
      Main#Node(left, _, right) ->
        let x%1 : Int =
          let x%2 : Int =
            Main#size(left)
          Prim.intAdd(x%2, 1)
        let y : Int =
          Main#size(right)
        Prim.intAdd(x%1, y)
    }
  }

Main#twin : fun(Tree) -> Tree =
  fun(t : Tree) {
    Main#Node(t, 0, t)
  }

Main#label : fun(Tree) -> Int =
  fun(t : Tree) {
    match t {
      Main#Node(_, n, _) ->
        n
      Main#Leaf ->
        0
    }
  }

Main#labelled : fun(Tree) -> Tree =
  fun(t : Tree) {
    Main#Node(
      t,
      match t {
        Main#Node(_, n, _) ->
          n
        Main#Leaf ->
          0
      },
      t
    )
  }

Main#grow : fun(Int) -> Tree =
  fun(n : Int) {
    let t : Tree =
      Main#Node(Main#Leaf, n, Main#Leaf)
    Main#Node(t, 0, t)
  }

Main#regrow : fun(Int) -> Tree =
  fun(n : Int) {
    let t : Tree =
      Main#Node(Main#Leaf, n, Main#Leaf)
    Main#Node(t, n, t)
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq : Unit =
      Turkey.Stdout#print@Int(
        Main#size(
          let t%1 : Tree =
            Main#Node(Main#Leaf, 1, Main#Leaf)
          Main#Node(t%1, 0, t%1)
        )
      )
    Turkey.Stdout#print@Int(
      Main#size(
        let t%2 : Tree =
          Main#Node(Main#Leaf, 2, Main#Leaf)
        Main#Node(t%2, 2, t%2)
      )
    )
  }
