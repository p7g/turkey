-- dictionaries
%inst.Main#Grow.Main#Tree : Grow Tree =
  %Dict.Main#Grow {
    grown =
      %inst.Main#Grow.Main#Tree#grown
  }

%inst.Main#Grow.Main#Tree#grown : fun(Tree) -> Tree =
  fun(t : Tree) {
    Main#Node(
      t,
      match t {
        Main#Node(_, n, _) ->
          n
        Main#Leaf ->
          0
      },
      t
    )
  }

-- bindings
Main#size : fun(Tree) -> Int =
  fun(t : Tree) {
    match t {
      Main#Leaf ->
        0
      Main#Node(left, _, right) ->
        let x%1 : Int =
          Main#size(left)
        let x%2 : Int =
          Prim.intAdd(x%1, 1)
        let y : Int =
          Main#size(right)
        Prim.intAdd(x%2, y)
    }
  }

Main#label : fun(Tree) -> Int =
  fun(t : Tree) {
    match t {
      Main#Node(_, n, _) ->
        n
      Main#Leaf ->
        0
    }
  }

Main#twin : fun(Tree) -> Tree =
  fun(t : Tree) {
    Main#Node(t, 0, t)
  }

Main#grow : fun(Int) -> Int =
  fun(n : Int) {
    Main#size(
      let t : Tree =
        Main#Node(Main#Leaf, n, Main#Leaf)
      Main#Node(t, 0, t)
    )
  }

Main#labelled : fun(Tree) -> Tree =
  fun(t : Tree) {
    Main#Node(
      t,
      match t {
        Main#Node(_, n, _) ->
          n
        Main#Leaf ->
          0
      },
      t
    )
  }

Main#regrow : fun(Int) -> Int =
  fun(n : Int) {
    Main#size(
      let t : Tree =
        Main#Node(Main#Leaf, n, Main#Leaf)
      Main#Node(t, n, t)
    )
  }

Main#later : fun(Tree) -> fun() -> Tree =
  fun(t : Tree) {
    fun() {
      Main#Node(t, 0, Main#Leaf)
    }
  }

Main#kept : fun(Int) -> Int =
  fun(n : Int) {
    let thunks : Array (fun() -> Tree) =
      Data.Array#Array(
        [let t : Tree =
  Main#Node(Main#Leaf, n, Main#Leaf)
fun() {
  Main#Node(t, 0, Main#Leaf)
}]
      )
    Main#size(
      let storage%1 : Prim.Array (fun() -> Tree) =
        match thunks {
          Data.Array#Array(storage%2) ->
            storage%2
        }
      let %seq : Unit =
        if
          let %eta : Int =
            Prim.arrayLength[fun() -> Tree](storage%1)
          Prim.not(Prim.intLt(0, %eta))
        {
          Turkey.Array#outOfBounds@[unit][a]("read at", 0, Prim.arrayLength[fun() -> Tree](storage%1))
        }
      Prim.arrayGet[fun() -> Tree](storage%1, 0)()
    )
  }

Main#repeat : fun(Tree, Int) -> Int =
  fun(t : Tree, times : Int) {
    let total : %Ref Int =
      ref(0)
    join %bind%1(%bv%1 : Unit) : Int = {
      !total
    }
    let %sq : Range =
      Data.Int#Range(0, times)
    let %cu : RangeCursor =
      Data.Int#RangeCursor(%sq.0)
    join rec %lp() : ! = {
      join %js%1(%jf : Int) : ! = {
        let %seq%1 : Unit =
          let %seq%2 : Unit =
            total :=
              let x%1 : Int =
                !total
              let y : Int =
                Main#size(t)
              Prim.intAdd(x%1, y)
          ()
        jump %lp()
      }
      join %js%2() : ! = {
        jump %bind%1(())
      }
      join %bind%2(%bv%2 : Unit) : ! = {
        let x%2 : Int =
          %cu.0
        let %seq%3 : Unit =
          %cu.0 := Prim.intAdd(x%2, 1)
        jump %js%1(x%2)
      }
      if
        let %eta%1 : Int =
          %cu.0
        let %eta%2 : Int =
          %sq.1
        Prim.not(Prim.intLt(%eta%1, %eta%2))
      {
        jump %js%2()
      } else {
        jump %bind%2(())
      }
    }
    jump %lp()
  }

Main#looped : fun(Int) -> Int =
  fun(n : Int) {
    let t : Tree =
      Main#Node(Main#Leaf, n, Main#Leaf)
    let total : %Ref Int =
      ref(0)
    join %bind%1(%bv%1 : Unit) : Int = {
      !total
    }
    let %sq : Range =
      Data.Int#Range(0, 3)
    let %cu : RangeCursor =
      Data.Int#RangeCursor(%sq.0)
    join rec %lp() : ! = {
      join %js%1(%jf : Int) : ! = {
        let %seq%1 : Unit =
          let %seq%2 : Unit =
            total :=
              let x%1 : Int =
                !total
              let y : Int =
                Main#size(t)
              Prim.intAdd(x%1, y)
          ()
        jump %lp()
      }
      join %js%2() : ! = {
        jump %bind%1(())
      }
      join %bind%2(%bv%2 : Unit) : ! = {
        let x%2 : Int =
          %cu.0
        let %seq%3 : Unit =
          %cu.0 := Prim.intAdd(x%2, 1)
        jump %js%1(x%2)
      }
      if
        let %eta%1 : Int =
          %cu.0
        let %eta%2 : Int =
          %sq.1
        Prim.not(Prim.intLt(%eta%1, %eta%2))
      {
        jump %js%2()
      } else {
        jump %bind%2(())
      }
    }
    jump %lp()
  }

Main#either : fun(Tree, Bool) -> Tree =
  fun(t : Tree, left : Bool) {
    if left {
      Main#Node(t, 1, Main#Leaf)
    } else {
      Main#Node(Main#Leaf, 2, t)
    }
  }

Main#branched : fun(Int) -> Int =
  fun(n : Int) {
    Main#size(
      let left : Bool =
        Prim.intLt(0, n)
      if left {
        Main#Node(Main#Node(Main#Leaf, n, Main#Leaf), 1, Main#Leaf)
      } else {
        Main#Node(Main#Leaf, 2, Main#Node(Main#Leaf, n, Main#Leaf))
      }
    )
  }

Main#both : fun(Option Tree) -> (Option Tree, Option Tree) =
  fun(o : Option Tree) {
    (o, o)
  }

Main#count : fun(Option Tree) -> Int =
  fun(o : Option Tree) {
    match o {
      Data.Option#Some(t) ->
        Main#size(t)
      Data.Option#None ->
        0
    }
  }

Main#nested : fun(Int) -> Int =
  fun(n : Int) {
    let %part : Tree =
      Main#Node(Main#Leaf, n, Main#Leaf)
    let x : Int =
      Main#size(%part)
    let y : Int =
      Main#size(%part)
    Prim.intAdd(x, y)
  }

Main#rootTwice : fun(Tree) -> Tree =
  fun(t : Tree) {
    match t {
      Main#Leaf ->
        Main#Leaf
      other ->
        Main#Node(other, Main#size(t), t)
    }
  }

Main#rooted : fun(Int) -> Int =
  fun(n : Int) {
    Main#size(
      let t : Tree =
        Main#Node(Main#Leaf, n, Main#Leaf)
      Main#Node(t, Main#size(t), t)
    )
  }

Main#growTwice@Tree : fun(Tree) -> Tree =
  fun(x : Tree) {
    let t : Tree =
      Main#Node(
        x,
        match x {
          Main#Node(_, n%1, _) ->
            n%1
          Main#Leaf ->
            0
        },
        x
      )
    Main#Node(
      t,
      match t {
        Main#Node(_, n%2, _) ->
          n%2
        Main#Leaf ->
          0
      },
      t
    )
  }

Main#classed : fun(Int) -> Int =
  fun(n : Int) {
    Main#size(
      let t%1 : Tree =
        Main#Node(Main#Leaf, n, Main#Leaf)
      let t%2 : Tree =
        Main#Node(t%1, n, t%1)
      Main#Node(t%2, n, t%2)
    )
  }

Main#kidAndWhole : fun(Tree) -> (Tree, Tree) =
  fun(t : Tree) {
    match t {
      Main#Node(kid, _, _) ->
        (kid, t)
      Main#Leaf ->
        (Main#Leaf, t)
    }
  }

Main#parted : fun(Int) -> Int =
  fun(n : Int) {
    let m : Int =
      Prim.intMul(n, 2)
    let %part : Tree =
      Main#Node(Main#Leaf, m, Main#Leaf)
    let t : Tree =
      Main#Node(%part, m, Main#Leaf)
    let x : Int =
      Main#size(%part)
    let y : Int =
      Main#size(t)
    Prim.intAdd(x, y)
  }

Main#weight : fun(Tree) -> Int =
  fun(t : Tree) {
    match t {
      Main#Leaf ->
        0
      whole ->
        let x : Int =
          Main#size(whole)
        Prim.intMul(x, 10)
    }
  }

Main#three : fun(Tree) -> (Tree, Tree, Int) =
  fun(t : Tree) {
    (t, t, match t {
  Main#Leaf ->
    0
  whole ->
    let x : Int =
      Main#size(whole)
    Prim.intMul(x, 10)
})
  }

Main#weighed : fun(Int) -> Int =
  fun(n : Int) {
    let t : Tree =
      Main#Node(Main#Leaf, n, Main#Leaf)
    let k : Int =
      let x%1 : Int =
        Main#size(t)
      Prim.intMul(x%1, 10)
    let x%2 : Int =
      Main#size(t)
    let y : Int =
      Main#size(t)
    let x%3 : Int =
      Prim.intAdd(x%2, y)
    Prim.intAdd(x%3, k)
  }

Main#shownLength : fun(Shown) -> Int =
  fun(%param : Shown) {
    match %param {
      Main#Shown[a@i64](%d.Text.Show#Show)(v) ->
        let s : String =
          %d.Text.Show#Show.show(v)
        let xs : Prim.Array Byte =
          match s {
            Data.String#String(b) ->
              b
          }
        Prim.arrayLength[Byte](xs)
    }
  }

Main#lengths : fun(Shown, Int) -> Int =
  fun(s%1 : Shown, times : Int) {
    let total : %Ref Int =
      ref(0)
    join %bind%1(%bv%1 : Unit) : Int = {
      !total
    }
    let %sq : Range =
      Data.Int#Range(0, times)
    let %cu : RangeCursor =
      Data.Int#RangeCursor(%sq.0)
    join rec %lp() : ! = {
      join %js%1(%jf : Int) : ! = {
        let %seq%1 : Unit =
          let %seq%2 : Unit =
            total :=
              let x%1 : Int =
                !total
              let y : Int =
                match s%1 {
                  Main#Shown[a@i64](%d.Text.Show#Show)(v) ->
                    let s%2 : String =
                      %d.Text.Show#Show.show(v)
                    let xs : Prim.Array Byte =
                      match s%2 {
                        Data.String#String(b) ->
                          b
                      }
                    Prim.arrayLength[Byte](xs)
                }
              Prim.intAdd(x%1, y)
          ()
        jump %lp()
      }
      join %js%2() : ! = {
        jump %bind%1(())
      }
      join %bind%2(%bv%2 : Unit) : ! = {
        let x%2 : Int =
          %cu.0
        let %seq%3 : Unit =
          %cu.0 := Prim.intAdd(x%2, 1)
        jump %js%1(x%2)
      }
      if
        let %eta%1 : Int =
          %cu.0
        let %eta%2 : Int =
          %sq.1
        Prim.not(Prim.intLt(%eta%1, %eta%2))
      {
        jump %js%2()
      } else {
        jump %bind%2(())
      }
    }
    jump %lp()
  }

Main#opened : fun(Int) -> Int =
  fun(n : Int) {
    let s%1 : Shown =
      Main#Shown(%inst.Text.Show#Show.Int, Prim.intMul(n, 100))
    let total : %Ref Int =
      ref(0)
    join %bind%1(%bv%1 : Unit) : Int = {
      !total
    }
    let %sq : Range =
      Data.Int#Range(0, 2)
    let %cu : RangeCursor =
      Data.Int#RangeCursor(%sq.0)
    join rec %lp() : ! = {
      join %js%1(%jf : Int) : ! = {
        let %seq%1 : Unit =
          let %seq%2 : Unit =
            total :=
              let x%1 : Int =
                !total
              let y : Int =
                match s%1 {
                  Main#Shown[a@i64](%d.Text.Show#Show)(v) ->
                    let s%2 : String =
                      %d.Text.Show#Show.show(v)
                    let xs : Prim.Array Byte =
                      match s%2 {
                        Data.String#String(b) ->
                          b
                      }
                    Prim.arrayLength[Byte](xs)
                }
              Prim.intAdd(x%1, y)
          ()
        jump %lp()
      }
      join %js%2() : ! = {
        jump %bind%1(())
      }
      join %bind%2(%bv%2 : Unit) : ! = {
        let x%2 : Int =
          %cu.0
        let %seq%3 : Unit =
          %cu.0 := Prim.intAdd(x%2, 1)
        jump %js%1(x%2)
      }
      if
        let %eta%1 : Int =
          %cu.0
        let %eta%2 : Int =
          %sq.1
        Prim.not(Prim.intLt(%eta%1, %eta%2))
      {
        jump %js%2()
      } else {
        jump %bind%2(())
      }
    }
    jump %lp()
  }

Main#cases : Array (fun(Int) -> Int) =
  Data.Array#Array([Main#grow, Main#regrow, Main#kept, Main#looped, Main#branched, Main#nested, Main#rooted, Main#classed, Main#parted, Main#weighed, Main#opened])

Main#main : fun() -> Unit =
  fun() {
    join %af(%av : Unit) : Unit = {
      %av
    }
    let %cu : ArrayCursor =
      Data.Array#ArrayCursor(0)
    join rec %lp() : ! = {
      join %js%1(%jf : fun(Int) -> Int) : ! = {
        let %seq%1 : Unit =
          Turkey.Stdout#print@Int(%jf(2))
        jump %lp()
      }
      join %js%2() : ! = {
        jump %af(())
      }
      let storage%1 : Prim.Array (fun(Int) -> Int) =
        match Main#cases {
          Data.Array#Array(storage%2) ->
            storage%2
        }
      join %bind(%bv : Unit) : ! = {
        let x%1 : fun(Int) -> Int =
          let i : Int =
            %cu.0
          Prim.arrayGet[fun(Int) -> Int](storage%1, i)
        let %seq%2 : Unit =
          %cu.0 :=
            let x%2 : Int =
              %cu.0
            Prim.intAdd(x%2, 1)
        jump %js%1(x%1)
      }
      if
        let %eta%1 : Int =
          %cu.0
        let %eta%2 : Int =
          Prim.arrayLength[fun(Int) -> Int](storage%1)
        Prim.not(Prim.intLt(%eta%1, %eta%2))
      {
        jump %js%2()
      } else {
        jump %bind(())
      }
    }
    jump %lp()
  }
