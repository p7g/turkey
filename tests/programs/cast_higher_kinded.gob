-- A checked cast between types that differ only in a higher-kinded argument.
-- `E Option` and `E Array` are different types, so their reps differ, and a
-- payload packed as one does not come back out as the other: `cast` converts
-- nothing unless the reps agree.

type E f = E(f Int)

-- The payload, generic over what it carries, so that the rep `cast` compares
-- is the one of `E Option` or of `E Array`.
type Packed a = Packed(a)

instance Error (Packed a) : Typed a { fun message(_) = "packed" }

fun asOption(e : SomeError) -> Option (Packed (E Option)) = Error.cast(e)
fun asArray(e : SomeError) -> Option (Packed (E Array)) = Error.cast(e)

fun report(e : SomeError) -> String = match asOption(e) {
    Some(Packed(E(Some(n)))) -> "option holding " + Int.toString(n)
    Some(Packed(E(None))) -> "empty option"
    None -> match asArray(e) {
        Some(Packed(E(xs))) -> "array of length " + Int.toString(len(xs))
        None -> "unrecognized: " + Error.messageOf(e)
    }
}

fun main() {
    let packed = fail(Packed(E(Some(1))))
    print(report(packed))
    print(report(fail(Packed(E([1, 2, 3])))))
    print(report(fail(Packed(E(None)))))
    print(Option.isSome(asOption(packed)))
    print(Option.isSome(asArray(packed)))
}
