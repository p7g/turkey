-- Checked downcasting (ERRORS.md step 5). A payload packed into `SomeError`
-- comes back out only as the type it actually is: `cast` compares the rep the
-- caller wants with the one the packed `Typed` dictionary answers, and converts
-- nothing unless they agree.

type ParseError = ParseError { field : String, line : Int }
type IoError = IoError(Int)
-- A single-field type, so the payload is held as a scalar rather than a
-- pointer: the conversion after a match is not always a relabel.
type Code = Code(Int)

instance Error ParseError {
    fun message(e) = match e {
        ParseError { field, line } -> "bad " + field + " line " + Int.toString(line)
    }
}
instance Error IoError { fun message(IoError(n)) = "io " + Int.toString(n) }
instance Error Code { fun message(Code(n)) = "code " + Int.toString(n) }

fun asParse(e : SomeError) -> Option ParseError = Error.cast(e)
fun asIo(e : SomeError) -> Option IoError = Error.cast(e)
fun asCode(e : SomeError) -> Option Code = Error.cast(e)

fun report(e : SomeError) -> String = match asParse(e) {
    Some(ParseError { field, line }) -> "parse " + field + ":" + Int.toString(line)
    None -> match asIo(e) {
        Some(IoError(n)) -> "io " + Int.toString(n)
        None -> match asCode(e) {
            Some(Code(n)) -> "code " + Int.toString(n)
            None -> "unrecognized: " + Error.messageOf(e)
        }
    }
}

type Other = Other(String)
instance Error Other { fun message(Other(s)) = "other " + s }

fun main() {
    print(report(fail(ParseError { field = "port", line = 3 })))
    print(report(fail(IoError(2))))
    print(report(fail(Code(42))))
    print(report(fail(Other("x"))))

    -- Context wraps rather than repacks, so a cast sees the *outer* payload.
    -- Searching the cause chain is deliberately not what this does.
    let wrapped = Error.context(fail(IoError(9)), Code(1))
    print(report(wrapped))
    match Error.causeOf(wrapped) {
        None -> print("no cause")
        Some(inner) -> print(report(inner))
    }
}
