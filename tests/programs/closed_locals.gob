-- A local binding is generalized when everything it uses is closed: defined
-- at the top level, imported, or a local that is itself generalized.

fun count(n) = if n <= 0 { 0 } else { 1 + count(n - 1) }

fun report(prefix : String) {
    -- A complete signature states the type, so it is polymorphic even though
    -- the body uses the parameter.
    fun line[Show a](v : a) -> String = prefix + show(v)
    print(line(1))
    print(line(True))

    -- Not closed, so it has one type, and every use agrees with it.
    let tag = fun(v) = prefix + v
    print(tag("a"))
    print(tag("b"))
}

fun main() {
    -- `show` is closed, so `x` is generalized.
    let x = show
    print(x(1))
    print(x(True))

    -- `pair` uses only `x`, which is closed in turn.
    let pair = fun(a, b) = x(a) + "/" + x(b)
    print(pair(1, True))
    print(pair("s", 2.5))

    -- A top-level function is closed, recursive or not.
    let counted = fun(v) = (v, count(3))
    print(show(counted(1)))
    print(show(counted("three")))

    report("> ")
}
