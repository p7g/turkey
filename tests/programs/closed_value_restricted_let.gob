-- `suffix` is not generalized, because its right-hand side is a call, but
-- its type has no type variables and it uses only closed variables, so it is
-- closed, and `tag`, which uses it, is generalized.
fun main() {
    let suffix = show(1) + "x"
    let tag = fun(v) = show(v) + suffix
    print(tag(1))
    print(tag(True))
}
