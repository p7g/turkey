-- A closure whose pattern binds the name of a `var` it does not capture. The
-- `var` lives in a frame slot, and the closure must not try to capture it:
-- inlining `some` into the placeholder lambda puts its `Some(n)` inside the
-- closure, in a function whose loop counter is also `n`.
fun some(r : Option Int, p : fun(Int) -> Bool) -> Bool = match r {
    Some(n) -> p(n)
    None -> False
}

-- Recursive, so it is not inlined and the closure passed to it survives.
fun anyIn(xs : Array (Option Int), i : Int, p : fun(Option Int) -> Bool) -> Bool =
    if i >= len(xs) { False } else { p(xs[i]) || anyIn(xs, i + 1, p) }

fun main() {
    let xs = [None, Some(3)]
    var n = 0
    while n < 2 {
        print(anyIn(xs, n, some(_, fun(v) = v == 3)))
        n = n + 1
    }
}
