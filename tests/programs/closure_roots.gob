-- Escaping closures keep mixed captures and recursive calls alive.
fun make(seed : Int, fraction : Float) -> Array (fun(Int) -> String) {
    let text = "seed=" + Int.toString(seed)
    let values = [seed, seed + 1]
    var calls = 0
    fun left(n : Int) -> String = if n == 0 {
        calls = calls + 1
        text + ":" + Int.toString(values[0]) + ":" + Float.toString(fraction)
            + ":" + Int.toString(calls)
    } else { left(n - 1) }
    fun right(n : Int) -> String = if n == 0 {
        text + ":right=" + Int.toString(values[1])
    } else { left(n - 1) }
    [left, right]
}
fun main() {
    let callbacks = make(7, 1.25)
    let other = make(20, 1.25)
    print(callbacks[0](2))
    print(callbacks[1](0))
    print(callbacks[1](1))
    print(other[0](0))
}
