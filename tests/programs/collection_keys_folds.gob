import Data.Set (Set)
import Data.Set as Set

-- Arrays and vectors as keys, and the eager folds over anything iterable.
fun main() {
    let grid : Map (Array Int) String = Map.new()
    Map.put(grid, [1, 2], "a")
    Map.put(grid, [2], "b")
    Map.put(grid, [], "c")
    print(Map.get(grid, [1, 2]))
    print(Map.get(grid, [2, 1]))
    print(Map.get(grid, []))
    print(len(grid))

    let seen : Set (Array (Array Int)) = Set.new()
    Set.add(seen, [[1], [2]])
    Set.add(seen, [[1, 2]])
    Set.add(seen, [[1], [2]])
    print(len(seen))
    print(Set.contains(seen, [[1, 2]]))

    let vkeys : Map (Vec Int) Int = Map.new()
    Map.put(vkeys, [1, 2], 5)
    print(Map.get(vkeys, [1, 2]))
    print(Map.get(vkeys, [1]))

    print(Array.sort([[2], [1, 5], [], [1], [1, 2]]))
    print([1, 2] < [1, 2, 0])
    print([1, 3] < [1, 2, 9])
    print(([] : Array Int) < [])
    print(Vec.sort([[3], [1, 1], [1]]))

    let xs = [3, 1, 4, 1, 5]
    print(Iter.sum(xs))
    print(Iter.product(xs))
    print(Iter.sum(([] : Array Int)))
    print(Iter.product(([] : Array Int)))
    print(Iter.sum([1.5, 2.5]))
    print(Iter.minimum(xs))
    print(Iter.maximum(xs))
    print(Iter.minimum(([] : Array Int)))
    print(Iter.maximum(Vec.fromArray(xs)))
    print(Iter.sum(Int.range(1, 11)))
    print(Iter.product(Int.range(1, 6)))
    print(Iter.fold(xs, "", fun(acc, x) = acc + Int.toString(x)))
    print(Iter.fold(Int.range(0, 4), 0, fun(a, x) = a * 2 + x))

    let words = ["bb", "a", "cc", "d"]
    print(Iter.minBy(words, String.byteLength))
    print(Iter.maxBy(words, String.byteLength))
    print(Iter.minBy(words, fun(w) = 0))
    print(Iter.maxBy(words, fun(w) = 0))
    print(Iter.maxBy(([] : Array String), String.byteLength))

    let s : Set Int = Set.new()
    for x in xs { Set.add(s, x) }
    print(Iter.sum(s))
    print(Iter.maximum(s))

    let m : Map Int Int = Map.new()
    Map.put(m, 1, 10)
    Map.put(m, 2, 20)
    print(Iter.sum(Iter.fold(m, [], fun(acc, kv) = Array.append(acc, [kv.1]))))
    print(Iter.maximum(m))
}
