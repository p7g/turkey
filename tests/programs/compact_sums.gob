-- Sums with nullary constructors and one single-field constructor: `Option`,
-- `Map`'s entries, and the ones below. Each is one word, and a payload that is
-- a heap object is not wrapped in another one -- which is only sound if every
-- nesting still comes apart: `Some(None)` is not `None`, `Some(Some(x))` is
-- not `Some(x)`, and a second nullary is not a payload.
--
-- `peel` and `blank` recurse at growing types with complete signatures, so the
-- specializer gives up on them and bodies shared by layout build `Some(x)` for
-- an `x` they know nothing about, and `None` for an `a` known only by layout. Run under GC stress, the arrays and globals of `None`s
-- here are traced slots holding something that is not a pointer.

type Box = Box { n : Int }

type Slot = Empty | Gone | Full(Box)

type Nat = Z | S(Nat)

fun slot(s : Slot) -> String = match s {
    Empty -> "empty"
    Gone -> "gone"
    Full(b) -> "full " + Int.toString(b.n)
}

fun maybeSlot(o : Option Slot) -> String = match o {
    None -> "none"
    Some(s) -> "some " + slot(s)
}

fun nested(o : Option (Option Box)) -> String = match o {
    None -> "none"
    Some(None) -> "some none"
    Some(Some(b)) -> "some some " + Int.toString(b.n)
}

fun count(n : Nat) -> Int = match n {
    Z -> 0
    S(m) -> 1 + count(m)
}

fun nat(k : Int) -> Nat = if k == 0 { Z } else { S(nat(k - 1)) }

-- How many `Some`s wrap the value, after adding `n` more at a type that grows
-- with each call.
fun peel(x : Option a, n : Int) -> Int {
    if n > 0 {
        return peel(Some(x), n - 1)
    }
    depth(x)
}

fun depth(x : Option a) -> Int = match x {
    None -> 0
    Some(_) -> 1
}

-- `None` at a type that grows with each call. `Option Int`'s `None` is an
-- object and `Option String`'s is a word, so even this body, which never sees
-- a payload, is compiled once per layout of `a`.
fun blank(x : a, n : Int) -> Option a {
    if n > 0 {
        let _ = blank((x, x), n - 1)
    }
    None
}

let nothing : Option Box = None

fun main() {
    print(maybeSlot(None))
    print(maybeSlot(Some(Empty)))
    print(maybeSlot(Some(Gone)))
    print(maybeSlot(Some(Full(Box { n = 1 }))))

    print(nested(None))
    print(nested(Some(None)))
    print(nested(Some(nothing)))
    print(nested(Some(Some(Box { n = 2 }))))

    let noInt : Option Int = None
    print(Some(Some(noInt)))
    print(Some(Some(Some(3))))
    print(Some(Some(noInt)) == Some(None))
    print(Some(noInt) == None)
    print(Some(Some(noInt)) == Some(Some(None)))

    print(count(nat(5)))

    print(peel(Some(1), 3))
    print(peel(nothing, 2))
    let none : Option String = None
    print(peel(none, 0))
    print(blank(1, 2))
    print(blank("s", 2))
    print(Option.isNone(blank(Box { n = 4 }, 3)))

    -- Traced slots holding nullaries, across many collections.
    let slots = []
    for var i = 0; i < 200; i = i + 1 {
        Vec.push(slots, if i % 3 == 0 { Some(Box { n = i }) }
                          else if i % 3 == 1 { None }
                          else { Some(Box { n = 0 - i }) })
    }
    var total = 0
    for s in slots {
        match s {
            Some(b) -> { total = total + b.n }
            None -> {}
        }
    }
    print(total)

    -- Entries, tombstones and growth.
    let m : Map String Box = Map.new()
    for var i = 0; i < 300; i = i + 1 { Map.put(m, Int.toString(i), Box { n = i }) }
    for var i = 0; i < 300; i = i + 1 {
        if i % 2 == 0 { let _ = Map.delete(m, Int.toString(i)) }
    }
    var sum = 0
    for (_, b) in m { sum = sum + b.n }
    print(sum)
    print(len(m))
    print(Option.map(Map.get(m, "7"), _.n))
    print(Option.map(Map.get(m, "8"), _.n))

    let later = fun() = nested(Some(nothing))
    print(later())
}
