-- Top-level bindings whose value is an atom -- a literal or a bare
-- constructor -- are replaced by that atom wherever they are read, so a
-- `match` on one is decided at compile time. The `.opt` golden is the claim:
-- `describe` has no `match`, and no function reads `limit`, `shade` or
-- `greeting`. `constant_globals_polyrec.gob` is the same for a generic one.
--
-- `origin` is a record and `total` a `var`: each is one object every reader
-- shares, so both stay reads of the global.

type Shade = Light | Dark

type Point = Point { x : Int, y : Int }

let limit = 10
let shade = Dark
let greeting = "hi"
let origin = Point { x = 0, y = 0 }
var total = 0

fun clamp(n : Int) -> Int = if n > limit { limit } else { n }

fun describe() -> String = match shade {
    Light -> "light"
    Dark -> "dark"
}

fun main() {
    print(clamp(12))
    print(describe())
    print(greeting)
    origin.x = 3
    total = total + origin.x
    print(total)
}
