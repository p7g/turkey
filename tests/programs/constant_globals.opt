-- bindings
Main#limit@Int : Int =
  10

Main#shade : Shade =
  Main#Dark

Main#greeting : String =
  "hi"

Main#origin : Point =
  Main#Point(0, 0)

Main#total : %Ref Int =
  ref(0)

Main#clamp : fun(Int) -> Int =
  fun(n : Int) {
    if Prim.intLt(10, n) {
      10
    } else {
      n
    }
  }

Main#describe : fun() -> String =
  fun() {
    "dark"
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      Turkey.Stdout#print@Int(
        if Prim.intLt(10, 12) {
          10
        } else {
          12
        }
      )
    let %seq2 : Unit =
      Turkey.Stdout#print@String("dark")
    let %seq3 : Unit =
      Turkey.Stdout#print@String("hi")
    let %seq4 : Unit =
      Main#origin.0 := 3
    let %seq5 : Unit =
      Main#total :=
        let x : Int =
          !Main#total
        let y : Int =
          Main#origin.0
        Prim.intAdd(x, y)
    Turkey.Stdout#print@Int(!Main#total)
  }
