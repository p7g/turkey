-- bindings
Main#limit@Int : Int =
  10

Main#shade : Shade =
  Main#Dark

Main#greeting : String =
  "hi"

Main#origin : Point =
  Main#Point {
    x =
      0
    y =
      0
  }

Main#total : %Ref Int =
  ref(0)

Main#clamp : fun(Int) -> Int =
  fun(n : Int) {
    if Prim.intLt(10, n) {
      10
    } else {
      n
    }
  }

Main#describe : fun() -> String =
  fun() {
    "dark"
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      let x : Int =
        if Prim.intLt(10, 12) {
          10
        } else {
          12
        }
      let %seq2 : Bool =
        System.IO#writeString(1, Data.Int#toString(x), Data.Bool.Type#True)
      ()
    let %seq3 : Unit =
      let %seq2 : Bool =
        System.IO#writeString(1, "dark", Data.Bool.Type#True)
      ()
    let %seq4 : Unit =
      let %seq2 : Bool =
        System.IO#writeString(1, "hi", Data.Bool.Type#True)
      ()
    let %seq5 : Unit =
      Main#origin.x := 3
    let %seq6 : Unit =
      Main#total :=
        let x : Int =
          !Main#total
        let y : Int =
          Main#origin.x
        Prim.intAdd(x, y)
    let x : Int =
      !Main#total
    let %seq2 : Bool =
      System.IO#writeString(1, Data.Int#toString(x), Data.Bool.Type#True)
    ()
  }
