-- bindings
Main#limit@Int : Int =
  10

Main#shade : Shade =
  Main#Dark

Main#greeting : String =
  "hi"

Main#origin : Point =
  Main#Point(0, 0)

Main#total : %Ref Int =
  ref(0)

Main#clamp : fun(Int) -> Int =
  fun(n : Int) {
    if Prim.intLt(10, n) {
      10
    } else {
      n
    }
  }

Main#describe : fun() -> String =
  fun() {
    "dark"
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      Turkey.Stdout#print@Int(
        if Prim.intLt(10, 12) {
          10
        } else {
          12
        }
      )
    let %seq2 : Unit =
      let x : String =
        "dark"
      let %seq3 : Bool =
        join %ret1(%rv1 : Bool) : Bool = {
          %rv1
        }
        join %bind1(%bv1 : Unit) : Bool = {
          jump %ret1(Data.Bool.Type#True)
        }
        let text : String =
          Data.String.Type#concat(x, "\n")
        let size : Int =
          Prim.arrayLength[Byte](
            match text {
              Data.String.Type#String(b) ->
                b
            }
          )
        let done : %Ref Int =
          ref(0)
        join rec %lp1() : ! = {
          if
            let x : Int =
              !done
            Prim.intLt(x, size)
          {
            join %bind2(%bv2 : Unit) : ! = {
              jump %lp1()
            }
            let n : Int =
              let from : Int =
                !done
              let storage : Prim.Array Byte =
                match text {
                  Data.String.Type#String(b) ->
                    b
                }
              let %seq4 : Unit =
                Turkey.IO#within(Prim.arrayLength[Byte](storage), from, size)
              let n : Int =
                Turkey.Workers#blockingWrite(1, Prim.ptrAdd(Prim.objectAddress[Prim.Array Byte](storage), Prim.intAdd(24, from)), Prim.intSub(size, from))
              let %seq5 : Unit =
                Prim.keepAlive[Prim.Array Byte](storage)
              n
            join %bind3(%bv3 : Unit) : Unit = {
              join %bind4(%bv4 : Unit) : Unit = {
                let %seq6 : Unit =
                  done :=
                    let x : Int =
                      !done
                    Prim.intAdd(x, n)
                jump %bind2(())
              }
              if
                let %b1 : Bool =
                  Prim.intLt(n, 0)
                if %b1 {
                  %b1
                } else {
                  Prim.intEq(n, 0)
                }
              {
                jump %ret1(Data.Bool.Type#False)
              } else {
                jump %bind4(())
              }
            }
            if
              let y : Int =
                Prim.intSub(0, 4)
              Prim.intEq(n, y)
            {
              jump %lp1()
            } else {
              jump %bind3(())
            }
          } else {
            jump %bind1(())
          }
        }
        jump %lp1()
      ()
    let %seq7 : Unit =
      let x : String =
        "hi"
      let %seq3 : Bool =
        join %ret1(%rv1 : Bool) : Bool = {
          %rv1
        }
        join %bind1(%bv1 : Unit) : Bool = {
          jump %ret1(Data.Bool.Type#True)
        }
        let text : String =
          Data.String.Type#concat(x, "\n")
        let size : Int =
          Prim.arrayLength[Byte](
            match text {
              Data.String.Type#String(b) ->
                b
            }
          )
        let done : %Ref Int =
          ref(0)
        join rec %lp1() : ! = {
          if
            let x : Int =
              !done
            Prim.intLt(x, size)
          {
            join %bind2(%bv2 : Unit) : ! = {
              jump %lp1()
            }
            let n : Int =
              let from : Int =
                !done
              let storage : Prim.Array Byte =
                match text {
                  Data.String.Type#String(b) ->
                    b
                }
              let %seq4 : Unit =
                Turkey.IO#within(Prim.arrayLength[Byte](storage), from, size)
              let n : Int =
                Turkey.Workers#blockingWrite(1, Prim.ptrAdd(Prim.objectAddress[Prim.Array Byte](storage), Prim.intAdd(24, from)), Prim.intSub(size, from))
              let %seq5 : Unit =
                Prim.keepAlive[Prim.Array Byte](storage)
              n
            join %bind3(%bv3 : Unit) : Unit = {
              join %bind4(%bv4 : Unit) : Unit = {
                let %seq6 : Unit =
                  done :=
                    let x : Int =
                      !done
                    Prim.intAdd(x, n)
                jump %bind2(())
              }
              if
                let %b1 : Bool =
                  Prim.intLt(n, 0)
                if %b1 {
                  %b1
                } else {
                  Prim.intEq(n, 0)
                }
              {
                jump %ret1(Data.Bool.Type#False)
              } else {
                jump %bind4(())
              }
            }
            if
              let y : Int =
                Prim.intSub(0, 4)
              Prim.intEq(n, y)
            {
              jump %lp1()
            } else {
              jump %bind3(())
            }
          } else {
            jump %bind1(())
          }
        }
        jump %lp1()
      ()
    let %seq8 : Unit =
      Main#origin.0 := 3
    let %seq9 : Unit =
      Main#total :=
        let x : Int =
          !Main#total
        let y : Int =
          Main#origin.0
        Prim.intAdd(x, y)
    Turkey.Stdout#print@Int(!Main#total)
  }
