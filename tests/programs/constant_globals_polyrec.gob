-- A generic atomic binding read inside a polymorphically recursive function.
--
-- `deepest` calls itself at `Pair a`, so specialization stops after a fixed
-- number of copies and the rest of the recursion goes through one generic
-- copy, which reads `none` at its own type variable. That mention is replaced
-- by `None` at `Option a` like any other: `tests/test_constant_globals.py`
-- checks that no function reads `none` after optimization.

type Pair a = Pair(a, a)

let none = None

fun deepest(x : a, n : Int) -> Option a {
    if n <= 0 {
        return none
    }
    match deepest(Pair(x, x), n - 1) {
        Some(Pair(y, _)) -> Some(y)
        None -> Some(x)
    }
}

fun main() {
    match deepest(7, 40) {
        Some(n) -> print(n)
        None -> print("none")
    }
    let empty : Option String = deepest("a", 0)
    print(Option.isNone(empty))
}
