-- A generator as a continuation monad: `bind` builds closures over the
-- continuation, and some of what they capture is a `Unit`.
type Step = Done | Yield(Int, fun() -> Step)
type Body r = Body(fun(fun(r) -> Step) -> Step)

fun run(Body(f), k) = f(k)

instance Functor Body {
    fun map(m, f) = Body(fun(k) = run(m, fun(x) = k(f(x))))
}
instance Applicative Body {
    fun pure(x) = Body(fun(k) = k(x))
}
instance Monad Body {
    fun bind(m, f) = Body(fun(k) = run(m, fun(x) = run(f(x), k)))
}

fun yield(x : Int) -> Body Unit = Body(fun(k) = Yield(x, fun() = k(())))

fun each(xs : Array Int) -> Body Unit {
    for x in xs { yield(x)? }
    pure(())
}

fun first(xs : Array Int) -> Body Unit {
    yield(xs[0])?
    pure(())
}

fun countdown(n : Int) -> Body Unit {
    var i = n
    while i > 0 {
        yield(i)?
        i = i - 1
    }
    pure(())
}

fun drain(body : Body Unit) {
    var step = run(body, fun(_) = Done)
    var going = True
    while going {
        match step {
            Yield(x, next) -> {
                print(x)
                step = next()
            }
            Done -> { going = False }
        }
    }
}

-- The smallest closure over a `Unit`.
fun later(k : fun(Unit) -> Int, x : Unit) -> fun() -> Int = fun() = k(x)

fun main() {
    drain(each([1, 2, 3]))
    drain(first([4, 5]))
    drain(countdown(2))
    print(later(fun(_) = 7, ())())
}
