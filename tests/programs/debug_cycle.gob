-- Only an object can come to contain itself. `debug` keeps the objects it is
-- in the middle of printing, and one met again inside itself prints
-- `<cycle>`. An object reached twice, and not inside itself, prints twice.

import Debug as Debug
import System.Task (runScope, spawn, join)

-- Doubly linked, through two `var` fields.
type Node = Node { value : Int, var next : Option Node, var prev : Option Node }

-- A tree whose children are an array, which an assignment can make hold
-- the tree itself.
type Tree = Leaf(Int) | Branch(Array Tree)

-- A hand-written instance in the middle of a cycle: it guards itself, and
-- the derived `Debug` of what it holds finds the same path.
type Group = Group { var members : Array Member, name : String }

type Member = Member { group : Group, id : Int }

instance Debug Group {
    fun debug(g) = Debug.guard(g, fun() = g.name + debug(g.members))
}

-- A task started while an object is being printed has a path of its own,
-- so it prints the object whole instead of `<cycle>`.
type Report = Report { var subject : Option Report, label : String }

type Flag = Flag { var on : Bool }

let started = Flag { on = False }

instance Debug Report {
    fun debug(r) = Debug.guard(r, fun() {
        if started.on { return r.label }
        started.on = True
        let elsewhere = runScope(spawn(fun() = debug(r)))
        r.label + " / in a task: " + join(elsewhere)
    })
}

fun main() {
    let a = Node { value = 1, next = None, prev = None }
    let b = Node { value = 2, next = None, prev = Some(a) }
    a.next = Some(b)
    print(debug(a))
    print(debug(b))

    let xs = [Leaf(1), Leaf(2)]
    xs[1] = Branch(xs)
    print(debug(xs))
    print(debug(Branch(xs)))

    let g = Group { members = [], name = "g" }
    g.members = [Member { group = g, id = 1 }, Member { group = g, id = 2 }]
    print(debug(g))

    let shared = [1]
    print(debug([shared, shared]))
    print(debug((shared, Some(shared))))

    let r = Report { subject = None, label = "r" }
    print(debug(r))
}
