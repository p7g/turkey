-- A type whose fields have `Debug` has it. A derived one prints a value as
-- Turkey syntax builds it, and what has no syntax as a placeholder.

import System.IO as IO
import System.Sync as Sync

type Point = Point { x : Int, y : Float }

type Pair a b = Pair(a, b)

type Suit = Hearts | Spades

type Wrapped = Wrapped(Int)

type Callback = Callback { name : String, run : fun(Int) -> Int, later : Option (fun() -> Unit) }

-- A secret: `!Debug` keeps the instance and reads no field.
type Token : !Debug = Token(String)

type Shown = Shown[Debug a] { tag : Int, value : a }

type Opaque = Opaque[a] { tag : Int, value : a }

-- A field built from a hidden type prints with what the constructor
-- carries, when that is enough for its `Debug`.
type Many = Many[Debug a] { items : Array a, tag : Int }

type Bare = Bare[a] { items : Array a }

-- What the field needs of the type's own parameter comes from the
-- instance's context, and the rest from what the constructor carries.
type Mixed b = Mixed[Debug a] { both : (a, b) }

type Two = One[Debug a](a) | Both[Debug a, Debug b](Option a, (a, b))

type Holder = Holder { var count : Int, label : String }

fun main() {
    print(debug(Point { x = -1, y = 2.5 }))
    print(debug(Pair("tab\there \"quoted\" back\\slash\n", '\'')))
    print(debug(['a', '"', '\\', '\u{7}']))
    print(debug("bell\u{7} del\u{7F} nul\0 next-line\u{85} \u{9F} \u{A0}"))
    print(debug([Hearts, Spades]))
    print(debug(Wrapped(3)))
    print(debug((1, "two", 3.0, ())))
    print(debug([0.1, 1.0, 1e21, -0.0, 100.0]))
    print(debug(Byte.truncate(200)))
    print(debug(Callback { name = "inc", run = fun(n) = n + 1, later = Some(fun() {}) }))
    print(debug(fun(a : Int, b : Int) = a + b))
    print(debug(Some(Token("hunter2"))))
    print(debug(Shown { tag = 1, value = [1, 2] }))
    print(debug(Opaque { tag = 2, value = "hidden" }))
    print(debug(Many { items = ["x", "y"], tag = 1 }))
    print(debug(Bare { items = [1] }))
    print(debug(Mixed { both = ('x', "y") }))
    print(debug([One(1), Both(Some("s"), ("t", 'u'))]))
    print(debug(Holder { count = 3, label = "h" }))
    print(debug(Sync.atomicInt(7)))
    -- Only the bytes a buffer holds, not those it consumed.
    let buffer = IO.bytesOf("hello")
    IO.consume(buffer, 2)
    print(debug(buffer))
    let v : Vec (Option Int) = []
    Vec.push(v, Some(1))
    Vec.push(v, None)
    print(debug(v))
    let m = Map.new()
    Map.put(m, "b", [1])
    Map.put(m, "a", [])
    print(debug(m))
    print(debug(Left(1) : Either Int String))
    print(dbg("to standard error") == "to standard error")
}
