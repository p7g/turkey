-- A `Deque` pushes and pops at both ends, wrapping around its storage and
-- growing when it is full, and reads the same from the front whatever
-- happened to its storage.
import Deque (Deque)
import Deque as Deque

fun main() {
    let d : Deque Int = Deque.new(2)
    print(Deque.popFront(d))
    print(Deque.front(d))
    print(Deque.isEmpty(d))

    -- Front pushes wrap from the start of the storage to its end; the
    -- third push grows it.
    Deque.pushBack(d, 2)
    Deque.pushFront(d, 1)
    Deque.pushBack(d, 3)
    Deque.pushFront(d, 0)
    print(d)
    print(len(d))
    print((Deque.front(d), Deque.back(d)))
    print((d[0], d[3], Deque.at(d, 4), Deque.at(d, -1)))

    d[1] = 10
    print(Deque.toArray(d))

    print(Deque.popBack(d))
    print(Deque.popFront(d))
    print(d)

    -- Many pushes at the front and pops at the back walk the front around
    -- the storage, a slot at a time, five times over.
    for var i = 4; i < 24; i = i + 1 {
        Deque.pushFront(d, i)
        let _ = Deque.popBack(d)
    }
    print(d)

    var total = 0
    for x in d { total = total + x }
    print(total)

    print(map(d, \(_ * 10)))
    print(d == Deque.fromArray([23, 22]))
    print(d == Deque.fromArray([22, 23]))
    print(d + Deque.fromArray([7]))
    print(Deque.append(Deque.fromArray([1]), d))
    print(foldMap(d, fun(x) = [x, x]) : Array Int)
    let none : Deque String = empty()
    print(none)

    -- A deque with no storage at all grows on its first push, at either end.
    Deque.pushFront(none, "b")
    Deque.pushFront(none, "a")
    Deque.pushBack(none, "c")
    print(none)
    let bare : Deque Int = Deque.new(0)
    Deque.pushBack(bare, 1)
    Deque.pushFront(bare, 0)
    print(bare)
    print((Deque.popBack(bare), Deque.popBack(bare), Deque.popBack(bare)))
    print(Deque.fromArray(["a", "b"]))

    Deque.clear(d)
    print((len(d), Deque.popBack(d)))
}
