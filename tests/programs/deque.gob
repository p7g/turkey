-- A `Deque` pushes and pops at both ends, wrapping around its storage and
-- growing when it is full, and reads the same from the front whatever
-- happened to its storage.
import Deque (Deque)
import Deque as Deque

fun main() {
    let d : Deque Int = Deque.new(2)
    print(Deque.popFront(d))
    print(Deque.front(d))
    print(Deque.isEmpty(d))

    -- Front pushes wrap from the start of the storage to its end; the
    -- third push grows it.
    Deque.pushBack(d, 2)
    Deque.pushFront(d, 1)
    Deque.pushBack(d, 3)
    Deque.pushFront(d, 0)
    print(d)
    print(len(d))
    print((Deque.front(d), Deque.back(d)))
    print((d[0], d[3], Deque.at(d, 4), Deque.at(d, -1)))

    d[1] = 10
    print(Deque.toArray(d))

    print(Deque.popBack(d))
    print(Deque.popFront(d))
    print(d)

    -- Many pushes at the front and pops at the back walk the front all the
    -- way around the storage.
    for i in [4, 5, 6, 7, 8, 9] {
        Deque.pushFront(d, i)
        let _ = Deque.popBack(d)
    }
    print(d)

    var total = 0
    for x in d { total = total + x }
    print(total)

    print(map(d, \(_ * 10)))
    print(d == Deque.fromArray([9, 8]))
    print(d == Deque.fromArray([8, 9]))
    print(d + Deque.fromArray([7]))
    print(foldMap(d, fun(x) = [x, x]) : Array Int)
    let none : Deque String = empty()
    print(none)
    print(Deque.fromArray(["a", "b"]))

    Deque.clear(d)
    print((len(d), Deque.popBack(d)))
}
