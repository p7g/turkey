-- Breadth-first search over a grid with a `Deque` as the queue: the fewest
-- steps from one cell to another, moving up, down, left or right and never
-- into `#`.
import Deque as Deque

let picture = [
    "S..#....",
    ".#.#.##.",
    ".#...#..",
    ".####.#.",
    "......#E",
]

fun parse(rows : Array String) -> Vec (Vec Char) {
    let grid = []
    for row in rows {
        let cells = []
        for c in String.codePoints(row) { Vec.push(cells, c) }
        Vec.push(grid, cells)
    }
    grid
}

let grid = parse(picture)

fun find(wanted : Char) -> (Int, Int) {
    for var row = 0; row < len(grid); row = row + 1 {
        for var column = 0; column < len(grid[row]); column = column + 1 {
            if grid[row][column] == wanted { return (row, column) }
        }
    }
    error("no such cell")
}

fun open((row, column) : (Int, Int)) -> Bool =
    row >= 0 && row < len(grid) && column >= 0 && column < len(grid[row])
        && grid[row][column] != '#'

fun shortest(start : (Int, Int), goal : (Int, Int)) -> Option Int {
    let steps = Map.new()
    Map.put(steps, start, 0)
    let queue = Deque.new(16)
    Deque.pushBack(queue, start)
    while let Some(here) = Deque.popFront(queue) {
        let taken = Map.getOr(steps, here, 0)
        if here == goal { return Some(taken) }
        let (row, column) = here
        for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
            let next = (row + dr, column + dc)
            if !open(next) || Map.contains(steps, next) { continue }
            Map.put(steps, next, taken + 1)
            Deque.pushBack(queue, next)
        }
    }
    None
}

fun main() {
    print(shortest(find('S'), find('E')))
    print(shortest(find('E'), find('S')))
    print(shortest(find('S'), (2, 2)))
    -- A wall is never entered, so never reached.
    print(shortest(find('S'), (1, 1)))
}
