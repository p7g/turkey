-- A derived instance requires what its fields' instances require, over the
-- type's parameters. `Map k v` has `Eq` when `k` has `Hash` and `v` has
-- `Eq`, so `Index k v` gets `Eq (Index k v) : Hash k, Eq v`.
import Data.Set as Set

type Index k v : Eq = Index { name : String, entries : Map k v }

type Tags a : Eq = Tags(Set.Set a)

-- Callable with any `v` that has `Eq`: nothing asks for more than the
-- instance's context.
fun sameEntries[Eq v](a : Index String v, b : Index String v) -> Bool = a == b

fun main() {
    let a : Index String Int = Index { name = "a", entries = Map.new() }
    let b : Index String Int = Index { name = "a", entries = Map.new() }
    Map.put(a.entries, "x", 1)
    Map.put(b.entries, "x", 1)
    print(sameEntries(a, b))
    Map.put(b.entries, "y", 2)
    print(sameEntries(a, b))

    let t = Set.new()
    Set.add(t, 3)
    Set.add(t, 4)
    let u = Set.new()
    Set.add(u, 4)
    Set.add(u, 3)
    print(Tags(t) == Tags(u))
}
