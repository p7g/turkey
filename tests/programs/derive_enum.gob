-- A derived `==` or `<` on an enumeration compares the two constructors'
-- indices, once, and folds when both sides are known constructors.
--
-- The `.opt` golden shows `same` and `before` as a single `Prim.intEq` and
-- `Prim.intLt` of two `Prim.constructorIndex`es, and `main`'s comparisons of
-- known suits folded to `True` and `False`. `main` reads the suits it passes
-- on from an array, so neither call is decided where it is made. An
-- enumeration of one constructor is equal to itself without comparing
-- anything.

type Suit : Ord = Hearts | Diamonds | Clubs | Spades

type Only : Ord = Only

fun same(a : Suit, b : Suit) -> Bool = a == b

fun before(a : Suit, b : Suit) -> Bool = a < b

fun alone(a : Only, b : Only) -> Bool = a == b && !(a < b)

fun main() {
    let suits = [Hearts, Diamonds, Clubs, Spades]
    print(same(suits[0], suits[2]))
    print(before(suits[0], suits[3]))
    print(Hearts == Hearts)
    print(Spades < Hearts)
    print(alone(Only, Only))
}
