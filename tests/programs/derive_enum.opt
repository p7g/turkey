-- bindings
Main#same : fun(Suit, Suit) -> Bool =
  fun(a : Suit, b : Suit) {
    Prim.intEq(Prim.constructorIndex(a), Prim.constructorIndex(b))
  }

Main#before : fun(Suit, Suit) -> Bool =
  fun(a : Suit, b : Suit) {
    Prim.intLt(Prim.constructorIndex(a), Prim.constructorIndex(b))
  }

Main#alone : fun(Only, Only) -> Bool =
  fun(a : Only, b : Only) {
    Data.Bool#True
  }

Main#main : fun() -> Unit =
  fun() {
    let suits : Array Suit =
      Data.Array#Array([Main#Hearts, Main#Diamonds, Main#Clubs, Main#Spades])
    let %seq%1 : Unit =
      Turkey.Stdout#print@Bool(
        let a%1 : Suit =
          let storage%1 : Prim.Array Suit =
            match suits {
              Data.Array#Array(storage%2) ->
                storage%2
            }
          let %seq%2 : Unit =
            if
              let %eta%1 : Int =
                Prim.arrayLength[Suit](storage%1)
              Prim.not(Prim.intLt(0, %eta%1))
            {
              Turkey.Array#outOfBounds@[unit][a]("read at", 0, Prim.arrayLength[Suit](storage%1))
            }
          Prim.arrayGet[Suit](storage%1, 0)
        let b%1 : Suit =
          let storage%3 : Prim.Array Suit =
            match suits {
              Data.Array#Array(storage%4) ->
                storage%4
            }
          let %seq%3 : Unit =
            if
              let %eta%2 : Int =
                Prim.arrayLength[Suit](storage%3)
              Prim.not(Prim.intLt(2, %eta%2))
            {
              Turkey.Array#outOfBounds@[unit][a]("read at", 2, Prim.arrayLength[Suit](storage%3))
            }
          Prim.arrayGet[Suit](storage%3, 2)
        Prim.intEq(Prim.constructorIndex(a%1), Prim.constructorIndex(b%1))
      )
    let %seq%4 : Unit =
      Turkey.Stdout#print@Bool(
        let a%2 : Suit =
          let storage%5 : Prim.Array Suit =
            match suits {
              Data.Array#Array(storage%6) ->
                storage%6
            }
          let %seq%5 : Unit =
            if
              let %eta%3 : Int =
                Prim.arrayLength[Suit](storage%5)
              Prim.not(Prim.intLt(0, %eta%3))
            {
              Turkey.Array#outOfBounds@[unit][a]("read at", 0, Prim.arrayLength[Suit](storage%5))
            }
          Prim.arrayGet[Suit](storage%5, 0)
        let b%2 : Suit =
          let storage%7 : Prim.Array Suit =
            match suits {
              Data.Array#Array(storage%8) ->
                storage%8
            }
          let %seq%6 : Unit =
            if
              let %eta%4 : Int =
                Prim.arrayLength[Suit](storage%7)
              Prim.not(Prim.intLt(3, %eta%4))
            {
              Turkey.Array#outOfBounds@[unit][a]("read at", 3, Prim.arrayLength[Suit](storage%7))
            }
          Prim.arrayGet[Suit](storage%7, 3)
        Prim.intLt(Prim.constructorIndex(a%2), Prim.constructorIndex(b%2))
      )
    let %seq%7 : Unit =
      Turkey.Stdout#print@Bool(Data.Bool#True)
    let %seq%8 : Unit =
      Turkey.Stdout#print@Bool(Data.Bool#False)
    Turkey.Stdout#print@Bool(Data.Bool#True)
  }
