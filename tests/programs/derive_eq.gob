-- `: Eq` derives structural equality: the same constructor, and each field
-- equal by its own type's `Eq`. `!=` is the class's default.

type Point : Eq = Point { x : Int, y : Int }

type Shape : Eq = Circle(Point, Float) | Square(Point, Float) | Dot

type Marker : Eq = Marker

type List a : Eq = Nil | Cons(a, List a)

fun main() {
    print(Point { x = 1, y = 2 } == Point { x = 1, y = 2 })
    print(Point { x = 1, y = 2 } == Point { x = 2, y = 1 })
    print(Circle(Point { x = 0, y = 0 }, 1.0) == Circle(Point { x = 0, y = 0 }, 1.0))
    print(Circle(Point { x = 0, y = 0 }, 1.0) == Square(Point { x = 0, y = 0 }, 1.0))
    print(Dot == Dot)
    print(Dot != Circle(Point { x = 0, y = 0 }, 1.0))
    print(Marker == Marker)
    print(Cons("a", Cons("b", Nil)) == Cons("a", Cons("b", Nil)))
    print(Cons("a", Cons("b", Nil)) == Cons("a", Nil))
    -- A `Float` field compares as `Float` does, so a NaN is not equal to
    -- itself, and neither is a value holding one.
    let nan = 0.0 / 0.0
    print(Circle(Point { x = 0, y = 0 }, nan) == Circle(Point { x = 0, y = 0 }, nan))
}
