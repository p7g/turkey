-- A derived instance's context is simplified by the type checker's own
-- solver, which reduces associated types. `K (Array Bool)`'s `Eq` needs
-- `Key (Array Bool) ~ Int`, which holds, and a field of type
-- `Key (Array Bool)` is an `Int`.

type K c = K(Int)

instance Eq (K c) : Key c ~ Int {
    fun eq(K(a), K(b)) = a == b
}

type Tagged : Eq = Tagged(K (Prim.Array Bool))

type Counted : Eq = Counted(Key (Prim.Array Bool))

fun main() {
    print(Tagged(K(1)) == Tagged(K(1)))
    print(Tagged(K(1)) == Tagged(K(2)))
}
