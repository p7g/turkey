-- A derivation reads a field's type with its associated types reduced, as
-- the solver does. `K (Array Bool)`'s instance needs `Key (Array Bool) ~ Int`,
-- which holds, and a field of type `Key (Array Bool)` is an `Int`.

type K c = K(Int)

instance Eq (K c) : Key c ~ Int {
    fun eq(x, y) = match (x, y) {
        (K(a), K(b)) -> a == b
    }
}

type Tagged : Eq = Tagged(K (Prim.Array Bool))

type Counted : Eq = Counted(Key (Prim.Array Bool))

fun sameCount(a : Counted, b : Counted) -> Bool = a == b

fun main() {
    let k : K (Prim.Array Bool) = K(1)
    print(Tagged(k) == Tagged(k))
    print(Tagged(k) == Tagged(K(2)))
}
