-- A field whose type is an associated type compares as the type it reduces
-- to: `Key (Array Bool)` is `Int`.

type Counted : Eq = Counted(Key (Prim.Array Bool))

fun main() {
    print(Counted(3) == Counted(3))
    print(Counted(3) == Counted(4))
}

--@ xfail: a value of a type with an associated type in a field cannot be built yet
