-- Types derived from each other find their contexts together. Neither
-- `Expr a` nor `Callee a` can say what it needs until it knows what the
-- other needs, and both come to `Eq a`. A non-regular type, whose field
-- holds it at a larger type, is derived the same way: `Eq (Nest (Array a))`
-- needs `Eq (Array a)`, which needs `Eq a`.

type Expr a : Eq = Literal(a) | Call(Callee a, Array (Expr a))

type Callee a : Eq = Named(String) | Computed(Expr a) | Table(Map String (Expr a))

type Nest a : Eq = Nil | Cons(a, Nest (Array a))

fun main() {
    let f = Call(Named("f"), [Literal(1), Literal(2)])
    print(f == Call(Named("f"), [Literal(1), Literal(2)]))
    print(f == Call(Computed(Literal(1)), [Literal(1), Literal(2)]))
    let table : Map String (Expr Int) = Map.new()
    Map.put(table, "k", f)
    print(Call(Table(table), []) == Call(Table(table), []))

    let n : Nest Int = Cons(1, Cons([2, 3], Nil))
    print(n == Cons(1, Cons([2, 3], Nil)))
    print(n == Cons(1, Cons([2], Nil)))
}
