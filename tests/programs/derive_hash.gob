-- `: Hash` derives `Hash` and the `Eq` it needs, so the type can key a `Map`
-- and fill a `Set`. Equal values hash alike.
import Data.Set as Set

type Color : Hash = Red | Green | Blue

type Pixel : Hash = Pixel { x : Int, y : Int, color : Color }

type Key a : Hash = Named(String) | Numbered(a)

fun main() {
    let counts : Map Color Int = Map.new()
    for c in [Red, Blue, Red, Red] {
        Map.update(counts, c, 0, _ + 1)
    }
    print(counts[Red])
    print(Map.getOr(counts, Green, 0))

    let seen = Set.new()
    Set.add(seen, Pixel { x = 1, y = 1, color = Red })
    Set.add(seen, Pixel { x = 1, y = 1, color = Red })
    Set.add(seen, Pixel { x = 1, y = 1, color = Blue })
    print(len(seen))

    let keys : Map (Key Int) String = Map.new()
    Map.put(keys, Named("a"), "named")
    Map.put(keys, Numbered(7), "numbered")
    print(keys[Numbered(7)])
    print(hash(Numbered(7)) == hash(Numbered(7)))
    let named : Key Int = Named("a")
    print(named == Named("a"))
}
