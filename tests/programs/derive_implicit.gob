-- Every type has `Eq` and `Hash` without asking, when its fields do, so a
-- record compares and keys a map with no derive list and no instance.

type Point = Point { x : Int, y : Int }

type Shape = Circle(Point, Int) | Rect(Point, Point)

type Labelled a = Labelled { label : String, value : a }

-- A `var` field keeps `Eq`, which compares what the fields hold now, but
-- gives up `Hash`.
type Counter = Counter { var count : Int }

-- A hand-written instance replaces the implicit one: an angle in degrees,
-- the same angle after any number of whole turns.
type Angle = Angle(Int)

instance Eq Angle {
    fun eq(Angle(a), Angle(b)) = Int.mod(a, 360) == Int.mod(b, 360)
}

instance Hash Angle {
    fun hashInto(Angle(a), h) = hashInto(Int.mod(a, 360), h)
}

fun main() {
    let origin = Point { x = 0, y = 0 }
    print(origin == Point { x = 0, y = 0 })
    print(Circle(origin, 1) == Rect(origin, origin))
    print(Labelled { label = "a", value = [1, 2] } == Labelled { label = "a", value = [1, 2] })

    let areas = Map.new()
    Map.put(areas, Circle(origin, 2), 12)
    print(Map.get(areas, Circle(Point { x = 0, y = 0 }, 2)))

    let c = Counter { count = 1 }
    let d = Counter { count = 1 }
    print(c == d)
    c.count = 2
    print(c == d)

    let headings = Map.new()
    Map.put(headings, Angle(90), "east")
    print(Map.get(headings, Angle(450)))
}
