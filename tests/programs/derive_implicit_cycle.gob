-- A type that can reach itself through a `var` field or an array element gets
-- no implicit `Eq`, but its declaration may still ask for one, and a type
-- that holds it then derives one from it.

type Tree : Eq = Tree { label : String, children : Array Tree }

type Forest = Forest(Array Tree)

fun leaf(label : String) -> Tree = Tree { label = label, children = [] }

fun main() {
    let t = Tree { label = "root", children = [leaf("a"), leaf("b")] }
    print(t == Tree { label = "root", children = [leaf("a"), leaf("b")] })
    print(Forest([t]) == Forest([leaf("root")]))
}
