import Shapes (Point(..), Labelled(..), origin)

fun main() -> Unit {
    print(origin == Point { x = 0, y = 0 })
    print(origin == Point { x = 1, y = 0 })
    let seen = Map.new()
    Map.put(seen, Labelled { label = "home", value = origin }, 1)
    print(Map.get(seen, Labelled { label = "home", value = Point { x = 0, y = 0 } }))
    print(Map.get(seen, Labelled { label = "work", value = origin }))
}
