-- `: Ord` orders by the order the constructors are declared in, then by the
-- fields, left to right. It derives `Eq` too, so `==` works on the same type.

type Suit : Ord = Hearts | Diamonds | Clubs | Spades

type Card : Ord = Card { rank : Int, suit : Suit }

type Priority : Ord = Low | Medium(Int) | High(Int, String)

fun main() {
    print(Hearts < Spades)
    print(Spades < Hearts)
    print(Clubs <= Clubs)
    print(Diamonds > Hearts)
    print(Clubs == Clubs)
    print(Card { rank = 3, suit = Hearts } < Card { rank = 3, suit = Spades })
    print(Card { rank = 4, suit = Hearts } < Card { rank = 3, suit = Spades })
    print(Card { rank = 3, suit = Clubs } == Card { rank = 3, suit = Clubs })
    print(Low < Medium(0))
    print(Medium(9) < High(0, "a"))
    print(High(1, "b") < High(1, "c"))
    print(High(2, "a") < High(1, "c"))
    print(High(1, "c") >= High(1, "c"))
    print(min(Medium(5), Medium(2)) == Medium(2))
}
