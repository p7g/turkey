-- A field whose type has a hand-written `Eq` is compared by that instance, so
-- a derived container agrees with it.

-- A set kept as an unsorted array: two hold the same members in any order.
type Members = Members(Array Int)

instance Eq Members {
    fun eq(a, b) {
        let Members(xs) = a
        let Members(ys) = b
        Array.sort(xs) == Array.sort(ys)
    }
}

type Team : Eq = Team { name : String, members : Members }

fun main() {
    print(Team { name = "a", members = Members([1, 2, 3]) }
          == Team { name = "a", members = Members([3, 1, 2]) })
    print(Team { name = "a", members = Members([1, 2]) }
          == Team { name = "b", members = Members([1, 2]) })
}
