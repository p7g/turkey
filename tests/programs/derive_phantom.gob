-- A derived instance asks for the class only over the parameters some field
-- mentions. `unit` is a phantom, so a `Measure` compares whatever it is.

type Measure unit : Ord = Measure(Float)

type Pair a b : Eq = Pair(a, b)

fun metres(x : Float) -> Measure (fun() -> Int) = Measure(x)

fun main() {
    print(metres(1.0) < metres(2.0))
    print(metres(2.0) == metres(2.0))
    print(Pair(1, "x") == Pair(1, "x"))
    print(Pair(1, "x") == Pair(1, "y"))
}
