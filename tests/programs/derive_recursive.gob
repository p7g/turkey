-- A derived instance may need itself, directly or through another type being
-- derived: `Tree` and `Forest` each compare by the other's `Eq`.

type Tree a : Eq = Node(a, Forest a)

type Forest a : Eq = Forest(Array (Tree a))

fun leaf(x : a) -> Tree a = Node(x, Forest([]))

fun main() {
    let t = Node(1, Forest([leaf(2), leaf(3)]))
    print(t == Node(1, Forest([leaf(2), leaf(3)])))
    print(t == Node(1, Forest([leaf(2)])))
    print(t != leaf(1))
}
