-- What a derived instance's fields need may follow from its context without
-- being in it. `W s`'s `Eq` needs `Bytes s`, and `K2 s`'s needs
-- `Value s ~ Byte`, an equality superclass of `Bytes s`. So `U` gets
-- `Eq (U s) : Bytes s`, which `ctxU` can use with no more than that.

class Bytes s : Index s, Value s ~ Byte {}

type W s = W(Int)

instance Eq (W s) : Bytes s {
    fun eq(W(a), W(b)) = a == b
}

type K2 s = K2(Int)

instance Eq (K2 s) : Value s ~ Byte {
    fun eq(K2(a), K2(b)) = a == b
}

type T s : Eq = T(W s)

type U s : Eq = U(W s, K2 s)

fun ctxT[Bytes s](x : T s, y : T s) -> Bool = x == y

fun ctxU[Bytes s](x : U s, y : U s) -> Bool = x == y

fun main() {}
