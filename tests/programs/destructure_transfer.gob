-- A destructuring `let` whose value can `return`, `break` or `continue`
-- binds its names from the value when the value is produced, as a `let` of
-- one name does.
type Span = Span { start : Int, stop : Int }

fun sum(e : Option (Int, Int)) -> Option Int {
    let (a, b) = match e {
        Some(p) -> p
        None -> return None
    }
    Some(a + b)
}

fun width(s : Option Span) -> Int {
    let Span { start, stop } = match s {
        Some(span) -> span
        None -> return -1
    }
    stop - start
}

-- Pairs up to the first negative number, skipping zeros.
fun pairs(xs : Array Int) -> Int {
    var total = 0
    for x in xs {
        let (lo, hi) = if x < 0 { break } else if x == 0 { continue } else { (x, x * 10) }
        total = total + lo + hi
    }
    total
}

fun widths(spans : Array (Option Span)) -> Int {
    var total = 0
    for s in spans {
        let Span { start, stop } = match s {
            Some(span) -> span
            None -> continue
        }
        if stop < start { break }
        total = total + stop - start
    }
    total
}

fun main() {
    print(sum(Some((1, 2))))
    print(sum(None))
    print(width(Some(Span { start = 3, stop = 10 })))
    print(width(None))
    print(pairs([1, 0, 2, -1, 5]))
    print(widths([Some(Span { start = 0, stop = 4 }), None,
                  Some(Span { start = 2, stop = 3 }),
                  Some(Span { start = 9, stop = 1 }),
                  Some(Span { start = 0, stop = 100 })]))
}
