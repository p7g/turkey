-- dictionaries
%default.Main#Monoid.Main#Monoid.repeat : forall a. fun(Monoid a) -> fun(a, Int) -> a =
  fun(%d1.Main#Monoid : Monoid a) {
    fun(x : a, n : Int) {
      join %ret1(%rv1 : a) : a = {
        %rv1
      }
      let acc : %Ref a =
        ref(%d1.Main#Monoid.empty())
      let i : %Ref Int =
        ref(0)
      join %bind1(%bv1 : Unit) : ! = {
        let %seq1 : Unit =
          %bv1
        jump %ret1(!acc)
      }
      join rec %lp1() : ! = {
        if %inst.Std.Classes#Ord.Int.lt(!i, n) {
          let %seq2 : Unit =
            let %seq3 : Unit =
              acc := %d1.Main#Monoid.%super.Main#Semigroup.combine(!acc, x)
            let %seq4 : Unit =
              i := %inst.Std.Classes#Add.Int.add(!i, 1)
            ()
          jump %lp1()
        } else {
          jump %bind1(())
        }
      }
      jump %lp1()
    }
  }

%default.Main#Foldable.Main#Foldable.fold : forall a. fun(Foldable a) -> fun(Monoid b) -> fun(a b) -> b =
  fun(%d1.Main#Foldable : Foldable a) {
    /\b.
      fun(%d1.Main#Monoid : Monoid b) {
        fun(xs : a b) {
          %d1.Main#Foldable.foldMap[b, b](%d1.Main#Monoid)(xs, Main#identity[b])
        }
      }
  }

%inst.Main#Semigroup.Int : Semigroup Int =
  %Dict.Main#Semigroup {
    combine =
      fun(x : Int, y : Int) {
        let %d1.Main#Semigroup : Semigroup Int =
          %inst.Main#Semigroup.Int
        %inst.Std.Classes#Add.Int.add(x, y)
      }
  }

%inst.Main#Semigroup.String : Semigroup String =
  %Dict.Main#Semigroup {
    combine =
      fun(x : String, y : String) {
        let %d1.Main#Semigroup : Semigroup String =
          %inst.Main#Semigroup.String
        %inst.Std.Classes#Add.String.add(x, y)
      }
  }

%inst.Main#Semigroup.Data.Array#Array : forall a. fun(Semigroup a) -> Semigroup (Array a) =
  fun(%d1.Main#Semigroup : Semigroup a) {
    %Dict.Main#Semigroup {
      combine =
        fun(xs : Array a, ys : Array a) {
          let %d2.Main#Semigroup : Semigroup (Array a) =
            %inst.Main#Semigroup.Data.Array#Array[a](%d1.Main#Semigroup)
          join %ret1(%rv1 : Array a) : Array a = {
            %rv1
          }
          let out : Array a =
            Data.Array#new[a](%inst.Std.Classes#Add.Int.add(%inst.Std.Classes#Length.Data.Array#Array[a].len(xs), %inst.Std.Classes#Length.Data.Array#Array[a].len(ys)))
          join %bind1(%bv1 : Unit) : ! = {
            let %seq1 : Unit =
              %bv1
            join %bind2(%bv2 : Unit) : ! = {
              let %seq2 : Unit =
                %bv2
              jump %ret1(out)
            }
            let %sq1 : Array a =
              ys
            let %cu1 : ArrayCursor =
              %inst.Std.Classes#Iterator.Data.Array#Array[a].iter(%sq1)
            join rec %lp1() : ! = {
              match %inst.Std.Classes#Iterator.Data.Array#Array[a].next(%sq1, %cu1) {
                Data.Option.Type#None ->
                  jump %bind2(())
                Data.Option.Type#Some(y) ->
                  let %seq3 : Unit =
                    Data.Array#push[a](out, y)
                  jump %lp1()
              }
            }
            jump %lp1()
          }
          let %sq2 : Array a =
            xs
          let %cu2 : ArrayCursor =
            %inst.Std.Classes#Iterator.Data.Array#Array[a].iter(%sq2)
          join rec %lp2() : ! = {
            match %inst.Std.Classes#Iterator.Data.Array#Array[a].next(%sq2, %cu2) {
              Data.Option.Type#None ->
                jump %bind1(())
              Data.Option.Type#Some(x) ->
                let %seq4 : Unit =
                  Data.Array#push[a](out, x)
                jump %lp2()
            }
          }
          jump %lp2()
        }
    }
  }

%inst.Main#Monoid.Int : Monoid Int =
  %Dict.Main#Monoid {
    %super.Main#Semigroup =
      %inst.Main#Semigroup.Int
    empty =
      fun() {
        let %d1.Main#Monoid : Monoid Int =
          %inst.Main#Monoid.Int
        0
      }
    repeat =
      fun(%eta1 : Int, %eta2 : Int) {
        %default.Main#Monoid.Main#Monoid.repeat[Int](%inst.Main#Monoid.Int)(%eta1, %eta2)
      }
  }

%inst.Main#Monoid.String : Monoid String =
  %Dict.Main#Monoid {
    %super.Main#Semigroup =
      %inst.Main#Semigroup.String
    empty =
      fun() {
        let %d1.Main#Monoid : Monoid String =
