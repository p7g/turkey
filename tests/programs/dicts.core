      }
  }

%inst.Main#Monoid.Data.Array#Array : forall a. fun(Semigroup a) -> Monoid (Array a) =
  fun(%d1.Main#Semigroup : Semigroup a) {
    %Dict.Main#Monoid {
      %super.Main#Semigroup =
        %inst.Main#Semigroup.Data.Array#Array[a](%d1.Main#Semigroup)
      empty =
        fun() {
          let %d1.Main#Monoid : Monoid (Array a) =
            %inst.Main#Monoid.Data.Array#Array[a](%d1.Main#Semigroup)
          Data.Array#Array {
            raw =
              []
          }
        }
      repeat =
        fun(%eta1 : Array a, %eta2 : Int) {
          %default.Main#Monoid.Main#Monoid.repeat[Array a](%inst.Main#Monoid.Data.Array#Array[a](%d1.Main#Semigroup))(%eta1, %eta2)
        }
    }
  }

%inst.Main#Foldable.Data.Array#Array : Foldable Array =
  %Dict.Main#Foldable {
    foldMap =
      /\a b.
        fun(%d1.Main#Monoid : Monoid b) {
          let %d1.Main#Foldable : Foldable Array =
            %inst.Main#Foldable.Data.Array#Array
          fun(xs : Array a, g : fun(a) -> b) {
            join %ret1(%rv1 : b) : b = {
              %rv1
            }
            let acc : %Ref b =
              ref(%d1.Main#Monoid.empty())
            join %bind1(%bv1 : Unit) : ! = {
              let %seq1 : Unit =
                %bv1
              jump %ret1(!acc)
            }
            let %sq1 : Array a =
              xs
            let %cu1 : ArrayCursor =
              %inst.Std.Classes#Iterator.Data.Array#Array[a].iter(%sq1)
            join rec %lp1() : ! = {
              match %inst.Std.Classes#Iterator.Data.Array#Array[a].next(%sq1, %cu1) {
                Data.Option.Type#None ->
                  jump %bind1(())
                Data.Option.Type#Some(x) ->
                  let %seq2 : Unit =
                    let %seq3 : Unit =
                      acc := %d1.Main#Monoid.%super.Main#Semigroup.combine(!acc, g(x))
                    ()
                  jump %lp1()
              }
            }
            jump %lp1()
          }
        }
    fold =
      fun(%eta1 : Monoid c) {
        %default.Main#Foldable.Main#Foldable.fold[Array](%inst.Main#Foldable.Data.Array#Array)(%eta1)
      }
  }

-- bindings
Main#identity : forall a. fun(a) -> a =
  fun(x : a) {
    x
  }

Main#squash : forall a. fun(Monoid a) -> fun(Array a) -> a =
  fun(%d1.Main#Monoid : Monoid a) {
    fun(xs : Array a) {
      join %ret1(%rv1 : a) : a = {
        %rv1
      }
      let acc : %Ref a =
        ref(%d1.Main#Monoid.empty())
      join %bind1(%bv1 : Unit) : ! = {
        let %seq1 : Unit =
          %bv1
        jump %ret1(!acc)
      }
      let %sq1 : Array a =
        xs
      let %cu1 : ArrayCursor =
        %inst.Std.Classes#Iterator.Data.Array#Array[a].iter(%sq1)
      join rec %lp1() : ! = {
        match %inst.Std.Classes#Iterator.Data.Array#Array[a].next(%sq1, %cu1) {
          Data.Option.Type#None ->
            jump %bind1(())
          Data.Option.Type#Some(x) ->
            let %seq2 : Unit =
              let %seq3 : Unit =
                acc := %d1.Main#Monoid.%super.Main#Semigroup.combine(!acc, x)
              ()
            jump %lp1()
        }
      }
      jump %lp1()
    }
  }

Main#triple : forall a. fun(Semigroup a) -> fun(a) -> a =
  fun(%d1.Main#Semigroup : Semigroup a) {
    fun(x : a) {
      %d1.Main#Semigroup.combine(x, %d1.Main#Semigroup.combine(x, x))
    }
  }

Main#render : fun(Array Int) -> String =
  fun(xs : Array Int) {
    join %ret1(%rv1 : String) : String = {
      %rv1
    }
    jump %ret1(
      %inst.Main#Foldable.Data.Array#Array.foldMap[Int, String](%inst.Main#Monoid.String)(
        xs,
        fun(n : Int) {
          %inst.Std.Classes#Add.String.add(Data.Int#toString(n), " ")
        }
      )
    )
  }

Main#main : fun() -> Unit =
  fun() {
    let plus : forall a. fun(Semigroup a) -> fun(a, a) -> a =
      fun(%d1.Main#Semigroup : Semigroup a) {
        %d1.Main#Semigroup.combine
      }
    let %seq1 : Unit =
      Std.Classes#print[String](%inst.Std.Classes#Show.String)(Data.Int#toString(plus[Int](%inst.Main#Semigroup.Int)(20, 22)))
    let %seq2 : Unit =
      Std.Classes#print[String](%inst.Std.Classes#Show.String)(
        Data.Int#toString(
          Main#squash[Int](%inst.Main#Monoid.Int)(
            Data.Array#Array {
              raw =
                [1, 2, 3, 4]
            }
          )
        )
      )
    let %seq3 : Unit =
      Std.Classes#print[String](%inst.Std.Classes#Show.String)(
        Main#squash[String](%inst.Main#Monoid.String)(
          Data.Array#Array {
            raw =
              ["a", "b", "c"]
          }
        )
      )
    let %seq4 : Unit =
      Std.Classes#print[String](%inst.Std.Classes#Show.String)(Main#triple[String](%inst.Main#Semigroup.String)("ha"))
    let %seq5 : Unit =
      Std.Classes#print[String](%inst.Std.Classes#Show.String)(Data.Int#toString(Main#triple[Int](%inst.Main#Semigroup.Int)(14)))
    let %seq6 : Unit =
      Std.Classes#print[String](%inst.Std.Classes#Show.String)(%inst.Main#Monoid.String.repeat("ab", 3))
    let %seq7 : Unit =
      Std.Classes#print[String](%inst.Std.Classes#Show.String)(
        Main#render(
          %inst.Main#Foldable.Data.Array#Array.fold[Array Int](%inst.Main#Monoid.Data.Array#Array[Int](%inst.Main#Semigroup.Int))(
            Data.Array#Array {
              raw =
                [Data.Array#Array {
  raw =
    [1, 2]
}, Data.Array#Array {
  raw =
    [3]
}, Data.Array#Array {
  raw =
    [4, 5, 6]
}]
            }
          )
        )
      )
    let %seq8 : Unit =
      Std.Classes#print[String](%inst.Std.Classes#Show.String)(
        Main#render(
          %inst.Std.Classes#Functor.Data.Array#Array.map[Int, Int](
            Data.Array#Array {
              raw =
                [1, 2, 3]
            },
            fun(n : Int) {
              %inst.Std.Classes#Mul.Int.mul(n, 10)
            }
          )
        )
      )
    match %inst.Std.Classes#Functor.Data.Option.Type#Option.map[Int, Int](
  Data.Option.Type#Some(41),
  fun(n : Int) {
    %inst.Std.Classes#Add.Int.add(n, 1)
  }
) {
      Data.Option.Type#Some(n) ->
        Std.Classes#print[String](%inst.Std.Classes#Show.String)(Data.Int#toString(n))
      Data.Option.Type#None ->
        Std.Classes#print[String](%inst.Std.Classes#Show.String)("none")
    }
  }
