-- dictionaries
%default.Monoid.repeat : forall a. fun(%Dict.Monoid a) -> fun(a, Int) -> a =
  fun(%d1.Monoid : %Dict.Monoid a) {
    fun(x : a, n : Int) {
      let acc : %Ref a =
        ref(%d1.Monoid.empty())
      let i : %Ref Int =
        ref(0)
      let %seq1 : Unit =
        while %inst.Ord.Int.lt(!i, n) {
          let %seq2 : Unit =
            acc := %d1.Monoid.%super.Semigroup.combine(!acc, x)
          let %seq3 : Unit =
            i := %inst.Add.Int.add(!i, 1)
          ()
        }
      return !acc
    }
  }

%default.Foldable.fold : forall a. fun(%Dict.Foldable a) -> fun(%Dict.Monoid b) -> fun(a b) -> b =
  fun(%d1.Foldable : %Dict.Foldable a) {
    /\b.
      fun(%d1.Monoid : %Dict.Monoid b) {
        fun(xs : a b) {
          %d1.Foldable.foldMap[b, b](%d1.Monoid)(xs, Main#identity[b])
        }
      }
  }

%inst.Semigroup.Int : %Dict.Semigroup Int =
  %Dict.Semigroup {
    combine =
      fun(x : Int, y : Int) {
        let %d1.Semigroup : %Dict.Semigroup Int =
          %inst.Semigroup.Int
        %inst.Add.Int.add(x, y)
      }
  }

%inst.Semigroup.String : %Dict.Semigroup String =
  %Dict.Semigroup {
    combine =
      fun(x : String, y : String) {
        let %d1.Semigroup : %Dict.Semigroup String =
          %inst.Semigroup.String
        %inst.Add.String.add(x, y)
      }
  }

%inst.Semigroup.Array : forall a. fun(%Dict.Semigroup a) -> %Dict.Semigroup (Array a) =
  fun(%d1.Semigroup : %Dict.Semigroup a) {
    %Dict.Semigroup {
      combine =
        fun(xs : Array a, ys : Array a) {
          let %d2.Semigroup : %Dict.Semigroup (Array a) =
            %inst.Semigroup.Array[a](%d1.Semigroup)
          let out : Array a =
            Data.Array#new[a](%inst.Add.Int.add(xs.length, ys.length))
          let %seq1 : Unit =
            for x in xs via %inst.Iterator.Array[a].iter, %inst.Iterator.Array[a].next {
              Data.Array#push[a](out, x)
            }
          let %seq2 : Unit =
            for y in ys via %inst.Iterator.Array[a].iter, %inst.Iterator.Array[a].next {
              Data.Array#push[a](out, y)
            }
          return out
        }
    }
  }

%inst.Monoid.Int : %Dict.Monoid Int =
  %Dict.Monoid {
    %super.Semigroup =
      %inst.Semigroup.Int
    empty =
      fun() {
        let %d1.Monoid : %Dict.Monoid Int =
          %inst.Monoid.Int
        0
      }
    repeat =
      fun(%eta1 : Int, %eta2 : Int) {
        %default.Monoid.repeat[Int](%inst.Monoid.Int)(%eta1, %eta2)
      }
  }

%inst.Monoid.String : %Dict.Monoid String =
  %Dict.Monoid {
    %super.Semigroup =
      %inst.Semigroup.String
    empty =
      fun() {
        let %d1.Monoid : %Dict.Monoid String =
          %inst.Monoid.String
        ""
      }
    repeat =
      fun(%eta1 : String, %eta2 : Int) {
        %default.Monoid.repeat[String](%inst.Monoid.String)(%eta1, %eta2)
      }
  }

%inst.Monoid.Array : forall a. fun(%Dict.Semigroup a) -> %Dict.Monoid (Array a) =
  fun(%d1.Semigroup : %Dict.Semigroup a) {
    %Dict.Monoid {
      %super.Semigroup =
        %inst.Semigroup.Array[a](%d1.Semigroup)
      empty =
        fun() {
          let %d1.Monoid : %Dict.Monoid (Array a) =
            %inst.Monoid.Array[a](%d1.Semigroup)
          []
        }
      repeat =
        fun(%eta1 : Array a, %eta2 : Int) {
          %default.Monoid.repeat[Array a](%inst.Monoid.Array[a](%d1.Semigroup))(%eta1, %eta2)
        }
    }
  }

%inst.Foldable.Array : %Dict.Foldable Array =
  %Dict.Foldable {
    foldMap =
      /\a b.
        fun(%d1.Monoid : %Dict.Monoid b) {
          let %d1.Foldable : %Dict.Foldable Array =
            %inst.Foldable.Array
          fun(xs : Array a, g : fun(a) -> b) {
            let acc : %Ref b =
              ref(%d1.Monoid.empty())
            let %seq1 : Unit =
              for x in xs via %inst.Iterator.Array[a].iter, %inst.Iterator.Array[a].next {
                let %seq2 : Unit =
                  acc := %d1.Monoid.%super.Semigroup.combine(!acc, g(x))
                ()
              }
            return !acc
          }
        }
    fold =
      fun(%eta1 : %Dict.Monoid c) {
        %default.Foldable.fold[Array](%inst.Foldable.Array)(%eta1)
      }
  }

-- bindings
Main#identity : forall a. fun(a) -> a =
  fun(x : a) {
    x
  }

Main#squash : forall a. fun(%Dict.Monoid a) -> fun(Array a) -> a =
  fun(%d1.Monoid : %Dict.Monoid a) {
    fun(xs : Array a) {
      let acc : %Ref a =
        ref(%d1.Monoid.empty())
      let %seq1 : Unit =
        for x in xs via %inst.Iterator.Array[a].iter, %inst.Iterator.Array[a].next {
          let %seq2 : Unit =
            acc := %d1.Monoid.%super.Semigroup.combine(!acc, x)
          ()
        }
      return !acc
    }
  }

Main#triple : forall a. fun(%Dict.Semigroup a) -> fun(a) -> a =
  fun(%d1.Semigroup : %Dict.Semigroup a) {
    fun(x : a) {
      %d1.Semigroup.combine(x, %d1.Semigroup.combine(x, x))
    }
  }

Main#render : fun(Array Int) -> String =
  fun(xs : Array Int) {
    return %inst.Foldable.Array.foldMap[Int, String](%inst.Monoid.String)(
  xs,
  fun(n : Int) {
    %inst.Add.String.add(Data.Int#toString(n), " ")
  }
)
  }

Main#main : fun() -> Unit =
  fun() {
    let plus : forall a. fun(%Dict.Semigroup a) -> fun(a, a) -> a =
      fun(%d1.Semigroup : %Dict.Semigroup a) {
        %d1.Semigroup.combine
      }
    let %seq1 : Unit =
      Prelude#print[String](%inst.Show.String)(Data.Int#toString(plus[Int](%inst.Semigroup.Int)(20, 22)))
    let %seq2 : Unit =
      Prelude#print[String](%inst.Show.String)(Data.Int#toString(Main#squash[Int](%inst.Monoid.Int)([1, 2, 3, 4])))
    let %seq3 : Unit =
      Prelude#print[String](%inst.Show.String)(Main#squash[String](%inst.Monoid.String)(["a", "b", "c"]))
    let %seq4 : Unit =
      Prelude#print[String](%inst.Show.String)(Main#triple[String](%inst.Semigroup.String)("ha"))
    let %seq5 : Unit =
      Prelude#print[String](%inst.Show.String)(Data.Int#toString(Main#triple[Int](%inst.Semigroup.Int)(14)))
    let %seq6 : Unit =
      Prelude#print[String](%inst.Show.String)(%inst.Monoid.String.repeat("ab", 3))
    let %seq7 : Unit =
      Prelude#print[String](%inst.Show.String)(Main#render(%inst.Foldable.Array.fold[Array Int](%inst.Monoid.Array[Int](%inst.Semigroup.Int))([[1, 2], [3], [4, 5, 6]])))
    let %seq8 : Unit =
      Prelude#print[String](%inst.Show.String)(
        Main#render(
          %inst.Functor.Array.map[Int, Int](
            [1, 2, 3],
            fun(n : Int) {
              %inst.Mul.Int.mul(n, 10)
            }
          )
        )
      )
    match %inst.Functor.Data.Option#Option.map[Int, Int](
  Data.Option#Some(41),
  fun(n : Int) {
    %inst.Add.Int.add(n, 1)
  }
) {
      Data.Option#Some(n) ->
        Prelude#print[String](%inst.Show.String)(Data.Int#toString(n))
      Data.Option#None ->
        Prelude#print[String](%inst.Show.String)("none")
    }
  }
