-- dictionaries
%default.Main#Monoid.Main#Monoid.repeat : forall a. fun(Monoid a) -> fun(a, Int) -> a =
  fun(%d1.Main#Monoid : Monoid a) {
    fun(x : a, n : Int) {
      join %ret1(%rv1 : a) : a = {
        %rv1
      }
      let acc : %Ref a =
        ref(%d1.Main#Monoid.empty())
      let i : %Ref Int =
        ref(0)
      join %bind1(%bv1 : Unit) : ! = {
        let %seq1 : Unit =
          %bv1
        jump %ret1(!acc)
      }
      join rec %lp1() : ! = {
        if %inst.Data.Ord#Ord.Int.lt(!i, n) {
          let %seq2 : Unit =
            let %seq3 : Unit =
              acc := %d1.Main#Monoid.%super.Main#Semigroup.combine(!acc, x)
            let %seq4 : Unit =
              i := %inst.Data.Num#Add.Int.add(!i, 1)
            ()
          jump %lp1()
        } else {
          jump %bind1(())
        }
      }
      jump %lp1()
    }
  }

%default.Main#Foldable.Main#Foldable.fold : forall a. fun(Foldable a) -> fun(Monoid b) -> fun(a b) -> b =
  fun(%d1.Main#Foldable : Foldable a) {
    /\b.
      fun(%d1.Main#Monoid : Monoid b) {
        fun(xs : a b) {
          %d1.Main#Foldable.foldMap[b, b](%d1.Main#Monoid)(xs, Main#identity[b])
        }
      }
  }

%inst.Main#Semigroup.Int : Semigroup Int =
  %Dict.Main#Semigroup {
    combine =
      fun(x : Int, y : Int) {
        let %d1.Main#Semigroup : Semigroup Int =
          %inst.Main#Semigroup.Int
        %inst.Data.Num#Add.Int.add(x, y)
      }
  }

%inst.Main#Semigroup.Data.String#String : Semigroup String =
  %Dict.Main#Semigroup {
    combine =
      fun(x : String, y : String) {
        let %d1.Main#Semigroup : Semigroup String =
          %inst.Main#Semigroup.Data.String#String
        %inst.Data.Num#Add.Data.String#String.add(x, y)
      }
  }

%inst.Main#Semigroup.Data.Array#Array : forall a. fun(Semigroup a) -> Semigroup (Array a) =
  fun(%d1.Main#Semigroup : Semigroup a) {
    %Dict.Main#Semigroup {
      combine =
        fun(xs : Array a, ys : Array a) {
          let %d2.Main#Semigroup : Semigroup (Array a) =
            %inst.Main#Semigroup.Data.Array#Array[a](%d1.Main#Semigroup)
          join %ret1(%rv1 : Array a) : Array a = {
            %rv1
          }
          let n : Int =
            %inst.Data.Index#Length.Data.Array#Array[a].len(xs)
          jump %ret1(
            Data.Array#init[a](
              %inst.Data.Num#Add.Int.add(n, %inst.Data.Index#Length.Data.Array#Array[a].len(ys)),
              fun(i : Int) {
                if %inst.Data.Ord#Ord.Int.lt(i, n) {
                  %inst.Data.Index#Index.Data.Array#Array[a].get(xs, i)
                } else {
                  %inst.Data.Index#Index.Data.Array#Array[a].get(ys, %inst.Data.Num#Sub.Int.sub(i, n))
                }
              }
            )
          )
        }
    }
  }

%inst.Main#Monoid.Int : Monoid Int =
  %Dict.Main#Monoid {
    %super.Main#Semigroup =
      %inst.Main#Semigroup.Int
    empty =
      fun() {
        let %d1.Main#Monoid : Monoid Int =
          %inst.Main#Monoid.Int
        0
      }
    repeat =
      fun(%eta1 : Int, %eta2 : Int) {
        %default.Main#Monoid.Main#Monoid.repeat[Int](%inst.Main#Monoid.Int)(%eta1, %eta2)
      }
  }

%inst.Main#Monoid.Data.String#String : Monoid String =
  %Dict.Main#Monoid {
    %super.Main#Semigroup =
      %inst.Main#Semigroup.Data.String#String
    empty =
      fun() {
        let %d1.Main#Monoid : Monoid String =
          %inst.Main#Monoid.Data.String#String
        ""
      }
    repeat =
      fun(%eta1 : String, %eta2 : Int) {
        %default.Main#Monoid.Main#Monoid.repeat[String](%inst.Main#Monoid.Data.String#String)(%eta1, %eta2)
      }
  }

%inst.Main#Monoid.Data.Array#Array : forall a. fun(Semigroup a) -> Monoid (Array a) =
  fun(%d1.Main#Semigroup : Semigroup a) {
    %Dict.Main#Monoid {
      %super.Main#Semigroup =
        %inst.Main#Semigroup.Data.Array#Array[a](%d1.Main#Semigroup)
      empty =
        fun() {
          let %d1.Main#Monoid : Monoid (Array a) =
            %inst.Main#Monoid.Data.Array#Array[a](%d1.Main#Semigroup)
          Data.Array#Array([])
        }
      repeat =
        fun(%eta1 : Array a, %eta2 : Int) {
          %default.Main#Monoid.Main#Monoid.repeat[Array a](%inst.Main#Monoid.Data.Array#Array[a](%d1.Main#Semigroup))(%eta1, %eta2)
        }
    }
  }

%inst.Main#Foldable.Data.Array#Array : Foldable Array =
  %Dict.Main#Foldable {
    fold =
      fun(%eta1 : Monoid a) {
        %default.Main#Foldable.Main#Foldable.fold[Array](%inst.Main#Foldable.Data.Array#Array)(%eta1)
      }
    foldMap =
      /\b c.
        fun(%d1.Main#Monoid : Monoid c) {
          let %d1.Main#Foldable : Foldable Array =
            %inst.Main#Foldable.Data.Array#Array
          fun(xs : Array b, g : fun(b) -> c) {
            join %ret1(%rv1 : c) : c = {
              %rv1
            }
            let acc : %Ref c =
              ref(%d1.Main#Monoid.empty())
            join %bind1(%bv1 : Unit) : ! = {
              let %seq1 : Unit =
                %bv1
              jump %ret1(!acc)
            }
            let %sq1 : Array b =
              xs
            let %cu1 : ArrayCursor =
              %inst.Control.Iterator#Iterator.Data.Array#Array[b].iter(%sq1)
            join rec %lp1() : ! = {
              match %inst.Control.Iterator#Iterator.Data.Array#Array[b].next(%sq1, %cu1) {
                Data.Option#None ->
                  jump %bind1(())
                Data.Option#Some(x) ->
                  let %seq2 : Unit =
                    let %seq3 : Unit =
                      acc := %d1.Main#Monoid.%super.Main#Semigroup.combine(!acc, g(x))
                    ()
                  jump %lp1()
              }
            }
            jump %lp1()
          }
        }
  }

-- bindings
Main#identity : forall a. fun(a) -> a =
  fun(x : a) {
    x
  }

Main#squash : forall a. fun(Monoid a) -> fun(Array a) -> a =
  fun(%d1.Main#Monoid : Monoid a) {
    fun(xs : Array a) {
      join %ret1(%rv1 : a) : a = {
        %rv1
      }
      let acc : %Ref a =
        ref(%d1.Main#Monoid.empty())
      join %bind1(%bv1 : Unit) : ! = {
        let %seq1 : Unit =
          %bv1
        jump %ret1(!acc)
      }
      let %sq1 : Array a =
        xs
      let %cu1 : ArrayCursor =
        %inst.Control.Iterator#Iterator.Data.Array#Array[a].iter(%sq1)
      join rec %lp1() : ! = {
        match %inst.Control.Iterator#Iterator.Data.Array#Array[a].next(%sq1, %cu1) {
          Data.Option#None ->
            jump %bind1(())
          Data.Option#Some(x) ->
            let %seq2 : Unit =
              let %seq3 : Unit =
                acc := %d1.Main#Monoid.%super.Main#Semigroup.combine(!acc, x)
              ()
            jump %lp1()
        }
      }
      jump %lp1()
    }
  }

Main#triple : forall a. fun(Semigroup a) -> fun(a) -> a =
  fun(%d1.Main#Semigroup : Semigroup a) {
    fun(x : a) {
      %d1.Main#Semigroup.combine(x, %d1.Main#Semigroup.combine(x, x))
    }
  }

Main#render : fun(Array Int) -> String =
  fun(xs : Array Int) {
    join %ret1(%rv1 : String) : String = {
      %rv1
    }
    jump %ret1(
      %inst.Main#Foldable.Data.Array#Array.foldMap[Int, String](%inst.Main#Monoid.Data.String#String)(
        xs,
        fun(n : Int) {
          %inst.Data.Num#Add.Data.String#String.add(Data.Int#toString(n), " ")
        }
      )
    )
  }

Main#main : fun() -> Unit =
  fun() {
    let plus : forall a. fun(Semigroup a) -> fun(a, a) -> a =
      fun(%d1.Main#Semigroup : Semigroup a) {
        %d1.Main#Semigroup.combine
      }
    let %seq1 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Data.String#String)(Data.Int#toString(plus[Int](%inst.Main#Semigroup.Int)(20, 22)))
    let %seq2 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Data.String#String)(Data.Int#toString(Main#squash[Int](%inst.Main#Monoid.Int)(Data.Array#Array([1, 2, 3, 4]))))
    let %seq3 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Data.String#String)(Main#squash[String](%inst.Main#Monoid.Data.String#String)(Data.Array#Array(["a", "b", "c"])))
    let %seq4 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Data.String#String)(Main#triple[String](%inst.Main#Semigroup.Data.String#String)("ha"))
    let %seq5 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Data.String#String)(Data.Int#toString(Main#triple[Int](%inst.Main#Semigroup.Int)(14)))
    let %seq6 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Data.String#String)(%inst.Main#Monoid.Data.String#String.repeat("ab", 3))
    let %seq7 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Data.String#String)(Main#render(%inst.Main#Foldable.Data.Array#Array.fold[Array Int](%inst.Main#Monoid.Data.Array#Array[Int](%inst.Main#Semigroup.Int))(Data.Array#Array([Data.Array#Array([1, 2]), Data.Array#Array([3]), Data.Array#Array([4, 5, 6])]))))
    let %seq8 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Data.String#String)(
        Main#render(
          %inst.Data.Functor#Functor.Data.Array#Array.map[Int, Int](
            Data.Array#Array([1, 2, 3]),
            fun(n : Int) {
              %inst.Data.Num#Mul.Int.mul(n, 10)
            }
          )
        )
      )
    match %inst.Data.Functor#Functor.Data.Option#Option.map[Int, Int](
  Data.Option#Some(41),
  fun(n : Int) {
    %inst.Data.Num#Add.Int.add(n, 1)
  }
) {
      Data.Option#Some(n) ->
        Turkey.Stdout#print[String](%inst.Text.Show#Show.Data.String#String)(Data.Int#toString(n))
      Data.Option#None ->
        Turkey.Stdout#print[String](%inst.Text.Show#Show.Data.String#String)("none")
    }
  }
