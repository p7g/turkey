-- dictionaries
%default.Main#Monoid.Main#Monoid.repeat : forall a. fun(Monoid a) -> fun(a, Int) -> a =
  fun(%d.Main#Monoid : Monoid a) {
    fun(x : a, n : Int) {
      join %ret(%rv : a) : a = {
        %rv
      }
      let acc : %Ref a =
        ref(%d.Main#Monoid.empty())
      let i : %Ref Int =
        ref(0)
      join %bind(%bv : Unit) : ! = {
        let %seq%1 : Unit =
          %bv
        jump %ret(!acc)
      }
      join rec %lp() : ! = {
        if %inst.Data.Ord#Ord.Int.lt(!i, n) {
          let %seq%2 : Unit =
            let %seq%3 : Unit =
              acc := %d.Main#Monoid.%super.Main#Semigroup.combine(!acc, x)
            let %seq%4 : Unit =
              i := %inst.Data.Num#Add.Int.add(!i, 1)
            ()
          jump %lp()
        } else {
          jump %bind(())
        }
      }
      jump %lp()
    }
  }

%default.Main#Foldable.Main#Foldable.fold : forall a. fun(Foldable a) -> fun(Monoid b) -> fun(a b) -> b =
  fun(%d.Main#Foldable : Foldable a) {
    /\b.
      fun(%d.Main#Monoid : Monoid b) {
        fun(xs : a b) {
          %d.Main#Foldable.foldMap[b, b](%d.Main#Monoid)(xs, Main#identity[b])
        }
      }
  }

%inst.Main#Semigroup.Int : Semigroup Int =
  %Dict.Main#Semigroup {
    combine =
      fun(x : Int, y : Int) {
        %inst.Data.Num#Add.Int.add(x, y)
      }
  }

%inst.Main#Semigroup.Turkey.String#String : Semigroup String =
  %Dict.Main#Semigroup {
    combine =
      fun(x : String, y : String) {
        %inst.Data.Num#Add.Turkey.String#String.add(x, y)
      }
  }

%inst.Main#Semigroup.Data.Array#Array : forall a. fun(Semigroup a) -> Semigroup (Array a) =
  fun(%d.Main#Semigroup : Semigroup a) {
    %Dict.Main#Semigroup {
      combine =
        fun(xs : Array a, ys : Array a) {
          join %ret(%rv : Array a) : Array a = {
            %rv
          }
          let n : Int =
            %inst.Data.Index#Length.Data.Array#Array[a].len(xs)
          jump %ret(
            Data.Array#init[a](
              %inst.Data.Num#Add.Int.add(n, %inst.Data.Index#Length.Data.Array#Array[a].len(ys)),
              fun(i : Int) {
                if %inst.Data.Ord#Ord.Int.lt(i, n) {
                  %inst.Data.Index#Index.Data.Array#Array[a].get(xs, i)
                } else {
                  %inst.Data.Index#Index.Data.Array#Array[a].get(ys, %inst.Data.Num#Sub.Int.sub(i, n))
                }
              }
            )
          )
        }
    }
  }

%inst.Main#Monoid.Int : Monoid Int =
  %Dict.Main#Monoid {
    %super.Main#Semigroup =
      %inst.Main#Semigroup.Int
    empty =
      fun() {
        0
      }
    repeat =
      fun(%eta%1 : Int, %eta%2 : Int) {
        %default.Main#Monoid.Main#Monoid.repeat[Int](%inst.Main#Monoid.Int)(%eta%1, %eta%2)
      }
  }

%inst.Main#Monoid.Turkey.String#String : Monoid String =
  %Dict.Main#Monoid {
    %super.Main#Semigroup =
      %inst.Main#Semigroup.Turkey.String#String
    empty =
      fun() {
        ""
      }
    repeat =
      fun(%eta%1 : String, %eta%2 : Int) {
        %default.Main#Monoid.Main#Monoid.repeat[String](%inst.Main#Monoid.Turkey.String#String)(%eta%1, %eta%2)
      }
  }

%inst.Main#Monoid.Data.Array#Array : forall a. fun(Semigroup a) -> Monoid (Array a) =
  fun(%d.Main#Semigroup : Semigroup a) {
    %Dict.Main#Monoid {
      %super.Main#Semigroup =
        %inst.Main#Semigroup.Data.Array#Array[a](%d.Main#Semigroup)
      empty =
        fun() {
          Data.Array#Array([])
        }
      repeat =
        fun(%eta%1 : Array a, %eta%2 : Int) {
          %default.Main#Monoid.Main#Monoid.repeat[Array a](%inst.Main#Monoid.Data.Array#Array[a](%d.Main#Semigroup))(%eta%1, %eta%2)
        }
    }
  }

%inst.Main#Foldable.Data.Array#Array : Foldable Array =
  %Dict.Main#Foldable {
    fold =
      fun(%eta : Monoid a) {
        %default.Main#Foldable.Main#Foldable.fold[Array](%inst.Main#Foldable.Data.Array#Array)(%eta)
      }
    foldMap =
      /\b c.
        fun(%d.Main#Monoid : Monoid c) {
          fun(xs : Array b, g : fun(b) -> c) {
            join %ret(%rv : c) : c = {
              %rv
            }
            let acc : %Ref c =
              ref(%d.Main#Monoid.empty())
            join %bind(%bv : Unit) : ! = {
              let %seq%1 : Unit =
                %bv
              jump %ret(!acc)
            }
            let %sq : Array b =
              xs
            let %cu : ArrayCursor =
              %inst.Control.Iterator#Iterator.Data.Array#Array[b].iter(%sq)
            join rec %lp() : ! = {
              match %inst.Control.Iterator#Iterator.Data.Array#Array[b].next(%sq, %cu) {
                Data.Option#None ->
                  jump %bind(())
                Data.Option#Some(x) ->
                  let %seq%2 : Unit =
                    let %seq%3 : Unit =
                      acc := %d.Main#Monoid.%super.Main#Semigroup.combine(!acc, g(x))
                    ()
                  jump %lp()
              }
            }
            jump %lp()
          }
        }
  }

-- bindings
Main#identity : forall a. fun(a) -> a =
  fun(x : a) {
    x
  }

Main#squash : forall a. fun(Monoid a) -> fun(Array a) -> a =
  fun(%d.Main#Monoid : Monoid a) {
    fun(xs : Array a) {
      join %ret(%rv : a) : a = {
        %rv
      }
      let acc : %Ref a =
        ref(%d.Main#Monoid.empty())
      join %bind(%bv : Unit) : ! = {
        let %seq%1 : Unit =
          %bv
        jump %ret(!acc)
      }
      let %sq : Array a =
        xs
      let %cu : ArrayCursor =
        %inst.Control.Iterator#Iterator.Data.Array#Array[a].iter(%sq)
      join rec %lp() : ! = {
        match %inst.Control.Iterator#Iterator.Data.Array#Array[a].next(%sq, %cu) {
          Data.Option#None ->
            jump %bind(())
          Data.Option#Some(x) ->
            let %seq%2 : Unit =
              let %seq%3 : Unit =
                acc := %d.Main#Monoid.%super.Main#Semigroup.combine(!acc, x)
              ()
            jump %lp()
        }
      }
      jump %lp()
    }
  }

Main#triple : forall a. fun(Semigroup a) -> fun(a) -> a =
  fun(%d.Main#Semigroup : Semigroup a) {
    fun(x : a) {
      %d.Main#Semigroup.combine(x, %d.Main#Semigroup.combine(x, x))
    }
  }

Main#render : fun(Array Int) -> String =
  fun(xs : Array Int) {
    join %ret(%rv : String) : String = {
      %rv
    }
    jump %ret(
      %inst.Main#Foldable.Data.Array#Array.foldMap[Int, String](%inst.Main#Monoid.Turkey.String#String)(
        xs,
        fun(n : Int) {
          %inst.Data.Num#Add.Turkey.String#String.add(Data.Int#toString(n), " ")
        }
      )
    )
  }

Main#main : fun() -> Unit =
  fun() {
    let plus : forall a. fun(Semigroup a) -> fun(a, a) -> a =
      fun(%d.Main#Semigroup : Semigroup a) {
        %d.Main#Semigroup.combine
      }
    let %seq%1 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Turkey.String#String)(Data.Int#toString(plus[Int](%inst.Main#Semigroup.Int)(20, 22)))
    let %seq%2 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Turkey.String#String)(Data.Int#toString(Main#squash[Int](%inst.Main#Monoid.Int)(Data.Array#Array([1, 2, 3, 4]))))
    let %seq%3 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Turkey.String#String)(Main#squash[String](%inst.Main#Monoid.Turkey.String#String)(Data.Array#Array(["a", "b", "c"])))
    let %seq%4 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Turkey.String#String)(Main#triple[String](%inst.Main#Semigroup.Turkey.String#String)("ha"))
    let %seq%5 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Turkey.String#String)(Data.Int#toString(Main#triple[Int](%inst.Main#Semigroup.Int)(14)))
    let %seq%6 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Turkey.String#String)(%inst.Main#Monoid.Turkey.String#String.repeat("ab", 3))
    let %seq%7 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Turkey.String#String)(Main#render(%inst.Main#Foldable.Data.Array#Array.fold[Array Int](%inst.Main#Monoid.Data.Array#Array[Int](%inst.Main#Semigroup.Int))(Data.Array#Array([Data.Array#Array([1, 2]), Data.Array#Array([3]), Data.Array#Array([4, 5, 6])]))))
    let %seq%8 : Unit =
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Turkey.String#String)(
        Main#render(
          %inst.Data.Functor#Functor.Data.Array#Array.map[Int, Int](
            Data.Array#Array([1, 2, 3]),
            fun(n%1 : Int) {
              %inst.Data.Num#Mul.Int.mul(n%1, 10)
            }
          )
        )
      )
    match %inst.Data.Functor#Functor.Data.Option#Option.map[Int, Int](
  Data.Option#Some(41),
  fun(n%2 : Int) {
    %inst.Data.Num#Add.Int.add(n%2, 1)
  }
) {
      Data.Option#Some(n%3) ->
        Turkey.Stdout#print[String](%inst.Text.Show#Show.Turkey.String#String)(Data.Int#toString(n%3))
      Data.Option#None ->
        Turkey.Stdout#print[String](%inst.Text.Show#Show.Turkey.String#String)("none")
    }
  }
