Main#main : fun() -> Unit =
  fun() {
    let plus : forall a. fun(Semigroup a) -> fun(a, a) -> a =
      fun(%d1.Main#Semigroup : Semigroup a) {
        %d1.Main#Semigroup.combine
      }
    let plus@Int : fun(Semigroup Int) -> fun(Int, Int) -> Int =
      fun(%d1.Main#Semigroup : Semigroup Int) {
        %d1.Main#Semigroup.combine
      }
    let %seq1 : Unit =
      Std.Classes#print@String(Data.Int#toString(plus@Int(%inst.Main#Semigroup.Int)(20, 22)))
    let %seq2 : Unit =
      Std.Classes#print@String(
        Data.Int#toString(
          Main#squash@Int(
            Data.Array#Array(
              Data.Array#ArrayStorage {
                storage =
                  [1, 2, 3, 4]
                length =
                  4
              }
            )
          )
        )
      )
    let %seq3 : Unit =
      Std.Classes#print@String(
        Main#squash@String(
          Data.Array#Array(
            Data.Array#ArrayStorage {
              storage =
                ["a", "b", "c"]
              length =
                3
            }
          )
        )
      )
    let %seq4 : Unit =
      Std.Classes#print@String(Main#triple@String("ha"))
    let %seq5 : Unit =
      Std.Classes#print@String(Data.Int#toString(Main#triple@Int(14)))
    let %seq6 : Unit =
      Std.Classes#print@String(%inst.Main#Monoid.String#repeat("ab", 3))
    let %seq7 : Unit =
      Std.Classes#print@String(
        Main#render(
          %inst.Main#Foldable.Data.Array#Array#fold@Array(Int)(
            Data.Array#Array(
              Data.Array#ArrayStorage {
                storage =
                  [Data.Array#Array(
  Data.Array#ArrayStorage {
    storage =
      [1, 2]
    length =
      2
  }
), Data.Array#Array(
  Data.Array#ArrayStorage {
    storage =
      [3]
    length =
      1
  }
), Data.Array#Array(
  Data.Array#ArrayStorage {
    storage =
      [4, 5, 6]
    length =
      3
  }
)]
                length =
                  3
              }
            )
          )
        )
      )
    let %seq8 : Unit =
      Std.Classes#print@String(
        Main#render(
          %inst.Std.Classes#Functor.Data.Array#Array#map@Int,Int(
            Data.Array#Array(
              Data.Array#ArrayStorage {
                storage =
                  [1, 2, 3]
                length =
                  3
              }
            ),
            fun(n : Int) {
              %inst.Std.Classes#Mul.Int#mul(n, 10)
            }
          )
        )
      )
    match %inst.Std.Classes#Functor.Data.Option.Type#Option#map@Int,Int(
  Data.Option.Type#Some(41),
  fun(n : Int) {
    %inst.Std.Classes#Add.Int#add(n, 1)
  }
) {
      Data.Option.Type#Some(n) ->
        Std.Classes#print@String(Data.Int#toString(n))
      Data.Option.Type#None ->
        Std.Classes#print@String("none")
    }
  }
