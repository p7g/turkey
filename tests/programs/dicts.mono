    repeat =
      fun(%eta1 : Array Int, %eta2 : Int) {
        %default.Monoid.repeat@Array(Int)(%eta1, %eta2)
      }
  }

%inst.Foldable.Array : %Dict.Foldable Array =
  %Dict.Foldable {
    foldMap =
      /\a b.
        fun(%d1.Monoid : %Dict.Monoid b) {
          let %d1.Foldable : %Dict.Foldable Array =
            %inst.Foldable.Array
          fun(xs : Array a, g : fun(a) -> b) {
            join %ret1(%rv1 : b) : b = {
              %rv1
            }
            let acc : %Ref b =
              ref(%d1.Monoid.empty())
            join %bind1(%bv1 : Unit) : ! = {
              let %seq1 : Unit =
                %bv1
              jump %ret1(!acc)
            }
            let %sq1 : Array a =
              xs
            let %cu1 : ArrayCursor =
              %inst.Iterator.Array[a].iter(%sq1)
            join rec %lp1() : ! = {
              match %inst.Iterator.Array[a].next(%sq1, %cu1) {
                Data.Option#None ->
                  jump %bind1(())
                Data.Option#Some(x) ->
                  let %seq2 : Unit =
                    let %seq3 : Unit =
                      acc := %d1.Monoid.%super.Semigroup.combine(!acc, g(x))
                    ()
                  jump %lp1()
              }
            }
            jump %lp1()
          }
        }
    fold =
      fun(%eta1 : %Dict.Monoid c) {
        %default.Foldable.fold@Array(%eta1)
      }
  }

%inst.Semigroup.Int#combine : fun(Int, Int) -> Int =
  fun(x : Int, y : Int) {
    let %d1.Semigroup : %Dict.Semigroup Int =
      %inst.Semigroup.Int
    %inst.Add.Int#add(x, y)
  }

%inst.Semigroup.String#combine : fun(String, String) -> String =
  fun(x : String, y : String) {
    let %d1.Semigroup : %Dict.Semigroup String =
      %inst.Semigroup.String
    %inst.Add.String#add(x, y)
  }

%inst.Semigroup.Array@Int#combine : fun(Array Int, Array Int) -> Array Int =
  fun(xs : Array Int, ys : Array Int) {
    let %d1.Semigroup : %Dict.Semigroup (Array Int) =
      %inst.Semigroup.Array@Int
    join %ret1(%rv1 : Array Int) : Array Int = {
      %rv1
    }
    let out : Array Int =
      Data.Array#new@Int(%inst.Add.Int#add(xs.length, ys.length))
    join %bind1(%bv1 : Unit) : ! = {
      let %seq1 : Unit =
        %bv1
      join %bind2(%bv2 : Unit) : ! = {
        let %seq2 : Unit =
          %bv2
        jump %ret1(out)
      }
      let %sq1 : Array Int =
        ys
      let %cu1 : ArrayCursor =
        %inst.Iterator.Array@Int#iter(%sq1)
      join rec %lp1() : ! = {
        match %inst.Iterator.Array@Int#next(%sq1, %cu1) {
          Data.Option#None ->
            jump %bind2(())
          Data.Option#Some(y) ->
            let %seq3 : Unit =
              Data.Array#push@Int(out, y)
            jump %lp1()
        }
      }
      jump %lp1()
    }
    let %sq2 : Array Int =
      xs
    let %cu2 : ArrayCursor =
      %inst.Iterator.Array@Int#iter(%sq2)
    join rec %lp2() : ! = {
      match %inst.Iterator.Array@Int#next(%sq2, %cu2) {
        Data.Option#None ->
          jump %bind1(())
        Data.Option#Some(x) ->
          let %seq4 : Unit =
            Data.Array#push@Int(out, x)
          jump %lp2()
      }
    }
    jump %lp2()
  }

%inst.Monoid.Int#empty : fun() -> Int =
  fun() {
    let %d1.Monoid : %Dict.Monoid Int =
      %inst.Monoid.Int
    0
  }

%inst.Monoid.String#empty : fun() -> String =
  fun() {
    let %d1.Monoid : %Dict.Monoid String =
      %inst.Monoid.String
    ""
  }

%inst.Monoid.String#repeat : fun(String, Int) -> String =
  fun(%eta1 : String, %eta2 : Int) {
    %default.Monoid.repeat@String(%eta1, %eta2)
  }

%inst.Monoid.Array@Int#empty : fun() -> Array Int =
  fun() {
    let %d1.Monoid : %Dict.Monoid (Array Int) =
      %inst.Monoid.Array@Int
    []
  }

%inst.Foldable.Array#foldMap@Int,String : fun(Array Int, fun(Int) -> String) -> String =
  let %d1.Foldable : %Dict.Foldable Array =
    %inst.Foldable.Array
  fun(xs : Array Int, g : fun(Int) -> String) {
    join %ret1(%rv1 : String) : String = {
      %rv1
    }
    let acc : %Ref String =
      ref(%inst.Monoid.String#empty())
    join %bind1(%bv1 : Unit) : ! = {
      let %seq1 : Unit =
        %bv1
      jump %ret1(!acc)
    }
    let %sq1 : Array Int =
      xs
    let %cu1 : ArrayCursor =
      %inst.Iterator.Array@Int#iter(%sq1)
    join rec %lp1() : ! = {
      match %inst.Iterator.Array@Int#next(%sq1, %cu1) {
        Data.Option#None ->
          jump %bind1(())
        Data.Option#Some(x) ->
          let %seq2 : Unit =
            let %seq3 : Unit =
              acc := %inst.Semigroup.String#combine(!acc, g(x))
            ()
          jump %lp1()
      }
    }
    jump %lp1()
  }

%inst.Foldable.Array#foldMap : forall a b. fun(%Dict.Monoid b) -> fun(Array a, fun(a) -> b) -> b =
  fun(%d1.Monoid : %Dict.Monoid b) {
    let %d1.Foldable : %Dict.Foldable Array =
      %inst.Foldable.Array
    fun(xs : Array a, g : fun(a) -> b) {
      join %ret1(%rv1 : b) : b = {
        %rv1
      }
      let acc : %Ref b =
        ref(%d1.Monoid.empty())
      join %bind1(%bv1 : Unit) : ! = {
        let %seq1 : Unit =
          %bv1
        jump %ret1(!acc)
      }
      let %sq1 : Array a =
        xs
      let %cu1 : ArrayCursor =
        %inst.Iterator.Array[a].iter(%sq1)
      join rec %lp1() : ! = {
        match %inst.Iterator.Array[a].next(%sq1, %cu1) {
          Data.Option#None ->
            jump %bind1(())
          Data.Option#Some(x) ->
            let %seq2 : Unit =
              let %seq3 : Unit =
                acc := %d1.Monoid.%super.Semigroup.combine(!acc, g(x))
              ()
            jump %lp1()
        }
      }
      jump %lp1()
    }
  }

%inst.Foldable.Array#fold@Array(Int) : fun(Array (Array Int)) -> Array Int =
  %default.Foldable.fold@Array(%inst.Monoid.Array@Int)

-- bindings
Main#identity : forall a. fun(a) -> a =
  fun(x : a) {
    x
  }

Main#squash@Int : fun(Array Int) -> Int =
  fun(xs : Array Int) {
    join %ret1(%rv1 : Int) : Int = {
      %rv1
    }
    let acc : %Ref Int =
      ref(%inst.Monoid.Int#empty())
    join %bind1(%bv1 : Unit) : ! = {
      let %seq1 : Unit =
        %bv1
      jump %ret1(!acc)
    }
    let %sq1 : Array Int =
      xs
    let %cu1 : ArrayCursor =
      %inst.Iterator.Array@Int#iter(%sq1)
    join rec %lp1() : ! = {
      match %inst.Iterator.Array@Int#next(%sq1, %cu1) {
        Data.Option#None ->
          jump %bind1(())
        Data.Option#Some(x) ->
          let %seq2 : Unit =
            let %seq3 : Unit =
              acc := %inst.Semigroup.Int#combine(!acc, x)
            ()
          jump %lp1()
      }
    }
    jump %lp1()
  }

Main#squash@String : fun(Array String) -> String =
  fun(xs : Array String) {
    join %ret1(%rv1 : String) : String = {
      %rv1
    }
    let acc : %Ref String =
      ref(%inst.Monoid.String#empty())
    join %bind1(%bv1 : Unit) : ! = {
      let %seq1 : Unit =
        %bv1
      jump %ret1(!acc)
    }
    let %sq1 : Array String =
      xs
    let %cu1 : ArrayCursor =
      %inst.Iterator.Array@String#iter(%sq1)
    join rec %lp1() : ! = {
      match %inst.Iterator.Array@String#next(%sq1, %cu1) {
        Data.Option#None ->
          jump %bind1(())
        Data.Option#Some(x) ->
          let %seq2 : Unit =
            let %seq3 : Unit =
              acc := %inst.Semigroup.String#combine(!acc, x)
            ()
          jump %lp1()
      }
    }
    jump %lp1()
  }

Main#triple@String : fun(String) -> String =
  fun(x : String) {
    %inst.Semigroup.String#combine(x, %inst.Semigroup.String#combine(x, x))
  }

Main#triple@Int : fun(Int) -> Int =
  fun(x : Int) {
    %inst.Semigroup.Int#combine(x, %inst.Semigroup.Int#combine(x, x))
  }

Main#render : fun(Array Int) -> String =
  fun(xs : Array Int) {
    join %ret1(%rv1 : String) : String = {
      %rv1
    }
    jump %ret1(
      %inst.Foldable.Array#foldMap@Int,String(
        xs,
        fun(n : Int) {
          %inst.Add.String#add(Data.Int#toString(n), " ")
        }
      )
    )
  }

Main#main : fun() -> Unit =
  fun() {
    let plus : forall a. fun(%Dict.Semigroup a) -> fun(a, a) -> a =
      fun(%d1.Semigroup : %Dict.Semigroup a) {
        %d1.Semigroup.combine
      }
    let plus@Int : fun(%Dict.Semigroup Int) -> fun(Int, Int) -> Int =
      fun(%d1.Semigroup : %Dict.Semigroup Int) {
        %d1.Semigroup.combine
      }
    let %seq1 : Unit =
      Prelude#print@String(Data.Int#toString(plus@Int(%inst.Semigroup.Int)(20, 22)))
    let %seq2 : Unit =
      Prelude#print@String(Data.Int#toString(Main#squash@Int([1, 2, 3, 4])))
    let %seq3 : Unit =
      Prelude#print@String(Main#squash@String(["a", "b", "c"]))
    let %seq4 : Unit =
      Prelude#print@String(Main#triple@String("ha"))
    let %seq5 : Unit =
      Prelude#print@String(Data.Int#toString(Main#triple@Int(14)))
    let %seq6 : Unit =
      Prelude#print@String(%inst.Monoid.String#repeat("ab", 3))
    let %seq7 : Unit =
      Prelude#print@String(Main#render(%inst.Foldable.Array#fold@Array(Int)([[1, 2], [3], [4, 5, 6]])))
    let %seq8 : Unit =
      Prelude#print@String(
        Main#render(
          %inst.Functor.Array#map@Int,Int(
            [1, 2, 3],
            fun(n : Int) {
              %inst.Mul.Int#mul(n, 10)
            }
          )
        )
      )
    match %inst.Functor.Data.Option#Option#map@Int,Int(
  Data.Option#Some(41),
  fun(n : Int) {
    %inst.Add.Int#add(n, 1)
  }
) {
      Data.Option#Some(n) ->
        Prelude#print@String(Data.Int#toString(n))
      Data.Option#None ->
        Prelude#print@String("none")
    }
  }
