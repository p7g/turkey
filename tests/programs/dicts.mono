          %bv1
        jump %ret1(!acc)
      }
      let %sq1 : Array a =
        xs
      let %cu1 : ArrayCursor =
        %inst.Control.Iterator#Iterator.Data.Array#Array#iter[a](%sq1)
      join rec %lp1() : ! = {
        match %inst.Control.Iterator#Iterator.Data.Array#Array#next[a](%sq1, %cu1) {
          Data.Option#None ->
            jump %bind1(())
          Data.Option#Some(x) ->
            let %seq2 : Unit =
              let %seq3 : Unit =
                acc := %d1.Main#Monoid.%super.Main#Semigroup.combine(!acc, g(x))
              ()
            jump %lp1()
        }
      }
      jump %lp1()
    }
  }

