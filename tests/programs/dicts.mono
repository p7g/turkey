-- dictionaries
%default.Main#Monoid.Main#Monoid.repeat@Int : fun(Int, Int) -> Int =
  fun(x : Int, n : Int) {
    join %ret1(%rv1 : Int) : Int = {
      %rv1
    }
    let acc : %Ref Int =
      ref(%inst.Main#Monoid.Int#empty())
    let i : %Ref Int =
      ref(0)
    join %bind1(%bv1 : Unit) : ! = {
      let %seq1 : Unit =
        %bv1
      jump %ret1(!acc)
    }
    join rec %lp1() : ! = {
      if %inst.Data.Ord#Ord.Int#lt(!i, n) {
        let %seq2 : Unit =
          let %seq3 : Unit =
            acc := %inst.Main#Semigroup.Int#combine(!acc, x)
          let %seq4 : Unit =
            i := %inst.Data.Num#Add.Int#add(!i, 1)
          ()
        jump %lp1()
      } else {
        jump %bind1(())
      }
    }
    jump %lp1()
  }

