%inst.Main#Foldable.Data.Array#Array#foldMap@Int,String : fun(Array Int, fun(Int) -> String) -> String =
  let %d1.Main#Foldable : Foldable Array =
    %inst.Main#Foldable.Data.Array#Array
  fun(xs : Array Int, g : fun(Int) -> String) {
    join %ret1(%rv1 : String) : String = {
      %rv1
    }
    let acc : %Ref String =
      ref(%inst.Main#Monoid.Data.String#String#empty())
    join %bind1(%bv1 : Unit) : ! = {
      let %seq1 : Unit =
        %bv1
      jump %ret1(!acc)
    }
    let %sq1 : Array Int =
      xs
    let %cu1 : ArrayCursor =
      %inst.Control.Iterator#Iterator.Data.Array#Array#iter@Int(%sq1)
    join rec %lp1() : ! = {
      match %inst.Control.Iterator#Iterator.Data.Array#Array#next@Int(%sq1, %cu1) {
        Data.Option#None ->
          jump %bind1(())
        Data.Option#Some(x) ->
          let %seq2 : Unit =
            let %seq3 : Unit =
              acc := %inst.Main#Semigroup.Data.String#String#combine(!acc, g(x))
            ()
          jump %lp1()
      }
    }
    jump %lp1()
  }

%inst.Main#Foldable.Data.Array#Array#foldMap@Array(Int),Array(Int) : fun(Monoid (Array Int)) -> fun(Array (Array Int), fun(Array Int) -> Array Int) -> Array Int =
  fun(%d1.Main#Monoid : Monoid (Array Int)) {
    let %d1.Main#Foldable : Foldable Array =
      %inst.Main#Foldable.Data.Array#Array
    fun(xs : Array (Array Int), g : fun(Array Int) -> Array Int) {
      join %ret1(%rv1 : Array Int) : Array Int = {
        %rv1
      }
      let acc : %Ref (Array Int) =
        ref(%d1.Main#Monoid.empty())
      join %bind1(%bv1 : Unit) : ! = {
        let %seq1 : Unit =
          %bv1
        jump %ret1(!acc)
      }
      let %sq1 : Array (Array Int) =
        xs
      let %cu1 : ArrayCursor =
        %inst.Control.Iterator#Iterator.Data.Array#Array#iter@Array(Int)(%sq1)
      join rec %lp1() : ! = {
        match %inst.Control.Iterator#Iterator.Data.Array#Array#next@Array(Int)(%sq1, %cu1) {
          Data.Option#None ->
            jump %bind1(())
          Data.Option#Some(x) ->
            let %seq2 : Unit =
              let %seq3 : Unit =
                acc := %d1.Main#Monoid.%super.Main#Semigroup.combine(!acc, g(x))
              ()
            jump %lp1()
        }
      }
      jump %lp1()
    }
  }

%inst.Main#Foldable.Data.Array#Array#foldMap : forall a b. fun(Monoid b) -> fun(Array a, fun(a) -> b) -> b =
  fun(%d1.Main#Monoid : Monoid b) {
    let %d1.Main#Foldable : Foldable Array =
      %inst.Main#Foldable.Data.Array#Array
    fun(xs : Array a, g : fun(a) -> b) {
      join %ret1(%rv1 : b) : b = {
