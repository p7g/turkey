-- dictionaries
%default.Main#Monoid.Main#Monoid.repeat@String : fun(String, Int) -> String =
  fun(x : String, n : Int) {
    join %ret(%rv : String) : String = {
      %rv
    }
    let acc : %Ref String =
      ref(%inst.Main#Monoid.Data.String#String#empty())
    let i : %Ref Int =
      ref(0)
    join %bind(%bv : Unit) : ! = {
      let %seq%1 : Unit =
        %bv
      jump %ret(!acc)
    }
    join rec %lp() : ! = {
      if %inst.Data.Ord#Ord.Int#lt(!i, n) {
        let %seq%2 : Unit =
          let %seq%3 : Unit =
            acc := %inst.Main#Semigroup.Data.String#String#combine(!acc, x)
          let %seq%4 : Unit =
            i := %inst.Data.Num#Add.Int#add(!i, 1)
          ()
        jump %lp()
      } else {
        jump %bind(())
      }
    }
    jump %lp()
  }

%default.Main#Monoid.Main#Monoid.repeat@Array(Int) : fun(Array Int, Int) -> Array Int =
  fun(x : Array Int, n : Int) {
    join %ret(%rv : Array Int) : Array Int = {
      %rv
    }
    let acc : %Ref (Array Int) =
      ref(%inst.Main#Monoid.Data.Array#Array@Int#empty())
    let i : %Ref Int =
      ref(0)
    join %bind(%bv : Unit) : ! = {
      let %seq%1 : Unit =
        %bv
      jump %ret(!acc)
    }
    join rec %lp() : ! = {
      if %inst.Data.Ord#Ord.Int#lt(!i, n) {
        let %seq%2 : Unit =
          let %seq%3 : Unit =
            acc := %inst.Main#Semigroup.Data.Array#Array@Int#combine(!acc, x)
          let %seq%4 : Unit =
            i := %inst.Data.Num#Add.Int#add(!i, 1)
          ()
        jump %lp()
      } else {
        jump %bind(())
      }
    }
    jump %lp()
  }

%default.Main#Foldable.Main#Foldable.fold@Array@Array(Int)~dicts : fun(Monoid (Array Int)) -> fun(Array (Array Int)) -> Array Int =
  fun(%d.Main#Monoid : Monoid (Array Int)) {
    fun(xs : Array (Array Int)) {
      %inst.Main#Foldable.Data.Array#Array#foldMap@Array(Int),Array(Int)~dicts(%d.Main#Monoid)(xs, Main#identity@Array(Int))
    }
  }

%inst.Main#Semigroup.Int : Semigroup Int =
  %Dict.Main#Semigroup {
    combine =
      %inst.Main#Semigroup.Int#combine
  }

%inst.Main#Semigroup.Data.Array#Array@Int : Semigroup (Array Int) =
  %Dict.Main#Semigroup {
    combine =
      %inst.Main#Semigroup.Data.Array#Array@Int#combine
  }

%inst.Main#Monoid.Data.Array#Array@Int : Monoid (Array Int) =
  %Dict.Main#Monoid {
    %super.Main#Semigroup =
      %inst.Main#Semigroup.Data.Array#Array@Int
    empty =
      %inst.Main#Monoid.Data.Array#Array@Int#empty
    repeat =
      %inst.Main#Monoid.Data.Array#Array@Int#repeat
  }

%inst.Main#Semigroup.Int#combine : fun(Int, Int) -> Int =
  fun(x : Int, y : Int) {
    %inst.Data.Num#Add.Int#add(x, y)
  }

%inst.Main#Semigroup.Data.String#String#combine : fun(String, String) -> String =
  fun(x : String, y : String) {
    %inst.Data.Num#Add.Data.String#String#add(x, y)
  }

%inst.Main#Semigroup.Data.Array#Array@Int#combine : fun(Array Int, Array Int) -> Array Int =
  fun(xs : Array Int, ys : Array Int) {
    join %ret(%rv : Array Int) : Array Int = {
      %rv
    }
    let n : Int =
      %inst.Data.Index#Length.Data.Array#Array@Int#len(xs)
    jump %ret(
      Data.Array#init@Int(
        %inst.Data.Num#Add.Int#add(n, %inst.Data.Index#Length.Data.Array#Array@Int#len(ys)),
        fun(i : Int) {
          if %inst.Data.Ord#Ord.Int#lt(i, n) {
            %inst.Data.Index#Index.Data.Array#Array@Int#get(xs, i)
          } else {
            %inst.Data.Index#Index.Data.Array#Array@Int#get(ys, %inst.Data.Num#Sub.Int#sub(i, n))
          }
        }
      )
    )
  }

%inst.Main#Monoid.Int#empty : fun() -> Int =
  fun() {
    0
  }

%inst.Main#Monoid.Data.String#String#empty : fun() -> String =
  fun() {
    ""
  }

%inst.Main#Monoid.Data.String#String#repeat : fun(String, Int) -> String =
  fun(%eta%1 : String, %eta%2 : Int) {
    %default.Main#Monoid.Main#Monoid.repeat@String(%eta%1, %eta%2)
  }

%inst.Main#Monoid.Data.Array#Array@Int#empty : fun() -> Array Int =
  fun() {
    Data.Array#Array([])
  }

%inst.Main#Monoid.Data.Array#Array@Int#repeat : fun(Array Int, Int) -> Array Int =
  fun(%eta%1 : Array Int, %eta%2 : Int) {
    %default.Main#Monoid.Main#Monoid.repeat@Array(Int)(%eta%1, %eta%2)
  }

%inst.Main#Foldable.Data.Array#Array#fold@Array(Int) : fun(Array (Array Int)) -> Array Int =
  /\a.
  %default.Main#Foldable.Main#Foldable.fold@Array@Array(Int)~dicts(%inst.Main#Monoid.Data.Array#Array@Int)

%inst.Main#Foldable.Data.Array#Array#foldMap@Int,String : fun(Array Int, fun(Int) -> String) -> String =
  fun(xs : Array Int, g : fun(Int) -> String) {
    join %ret(%rv : String) : String = {
      %rv
    }
    let acc : %Ref String =
      ref(%inst.Main#Monoid.Data.String#String#empty())
    join %bind(%bv : Unit) : ! = {
      let %seq%1 : Unit =
        %bv
      jump %ret(!acc)
    }
    let %sq : Array Int =
      xs
    let %cu : ArrayCursor =
      %inst.Control.Iterator#Iterator.Data.Array#Array#iter@Int(%sq)
    join rec %lp() : ! = {
      match %inst.Control.Iterator#Iterator.Data.Array#Array#next@Int(%sq, %cu) {
        Data.Option#None ->
          jump %bind(())
        Data.Option#Some(x) ->
          let %seq%2 : Unit =
            let %seq%3 : Unit =
              acc := %inst.Main#Semigroup.Data.String#String#combine(!acc, g(x))
            ()
          jump %lp()
      }
    }
    jump %lp()
  }

%inst.Main#Foldable.Data.Array#Array#foldMap@Array(Int),Array(Int)~dicts : fun(Monoid (Array Int)) -> fun(Array (Array Int), fun(Array Int) -> Array Int) -> Array Int =
  fun(%d.Main#Monoid : Monoid (Array Int)) {
    fun(xs : Array (Array Int), g : fun(Array Int) -> Array Int) {
      join %ret(%rv : Array Int) : Array Int = {
        %rv
      }
      let acc : %Ref (Array Int) =
        ref(%d.Main#Monoid.empty())
      join %bind(%bv : Unit) : ! = {
        let %seq%1 : Unit =
          %bv
        jump %ret(!acc)
      }
      let %sq : Array (Array Int) =
        xs
      let %cu : ArrayCursor =
        %inst.Control.Iterator#Iterator.Data.Array#Array#iter@Array(Int)(%sq)
      join rec %lp() : ! = {
        match %inst.Control.Iterator#Iterator.Data.Array#Array#next@Array(Int)(%sq, %cu) {
          Data.Option#None ->
            jump %bind(())
          Data.Option#Some(x) ->
            let %seq%2 : Unit =
              let %seq%3 : Unit =
                acc := %d.Main#Monoid.%super.Main#Semigroup.combine(!acc, g(x))
              ()
            jump %lp()
        }
      }
      jump %lp()
    }
  }

-- bindings
Main#identity@Array(Int) : fun(Array Int) -> Array Int =
  fun(x : Array Int) {
    x
  }

Main#squash@Int : fun(Array Int) -> Int =
  fun(xs : Array Int) {
    join %ret(%rv : Int) : Int = {
      %rv
    }
    let acc : %Ref Int =
      ref(%inst.Main#Monoid.Int#empty())
    join %bind(%bv : Unit) : ! = {
      let %seq%1 : Unit =
        %bv
      jump %ret(!acc)
    }
    let %sq : Array Int =
      xs
    let %cu : ArrayCursor =
      %inst.Control.Iterator#Iterator.Data.Array#Array@Int#iter(%sq)
    join rec %lp() : ! = {
      match %inst.Control.Iterator#Iterator.Data.Array#Array@Int#next(%sq, %cu) {
        Data.Option#None ->
          jump %bind(())
        Data.Option#Some(x) ->
          let %seq%2 : Unit =
            let %seq%3 : Unit =
              acc := %inst.Main#Semigroup.Int#combine(!acc, x)
            ()
          jump %lp()
      }
    }
    jump %lp()
  }

Main#squash@String : fun(Array String) -> String =
  fun(xs : Array String) {
    join %ret(%rv : String) : String = {
      %rv
    }
    let acc : %Ref String =
      ref(%inst.Main#Monoid.Data.String#String#empty())
    join %bind(%bv : Unit) : ! = {
      let %seq%1 : Unit =
        %bv
      jump %ret(!acc)
    }
    let %sq : Array String =
      xs
    let %cu : ArrayCursor =
      %inst.Control.Iterator#Iterator.Data.Array#Array@String#iter(%sq)
    join rec %lp() : ! = {
      match %inst.Control.Iterator#Iterator.Data.Array#Array@String#next(%sq, %cu) {
        Data.Option#None ->
          jump %bind(())
        Data.Option#Some(x) ->
          let %seq%2 : Unit =
            let %seq%3 : Unit =
              acc := %inst.Main#Semigroup.Data.String#String#combine(!acc, x)
            ()
          jump %lp()
      }
    }
    jump %lp()
  }

Main#triple@String : fun(String) -> String =
  fun(x : String) {
    %inst.Main#Semigroup.Data.String#String#combine(x, %inst.Main#Semigroup.Data.String#String#combine(x, x))
  }

Main#triple@Int : fun(Int) -> Int =
  fun(x : Int) {
    %inst.Main#Semigroup.Int#combine(x, %inst.Main#Semigroup.Int#combine(x, x))
  }

Main#render : fun(Array Int) -> String =
  fun(xs : Array Int) {
    join %ret(%rv : String) : String = {
      %rv
    }
    jump %ret(
      %inst.Main#Foldable.Data.Array#Array#foldMap@Int,String(
        xs,
        fun(n : Int) {
          %inst.Data.Num#Add.Data.String#String#add(Data.Int#toString(n), " ")
        }
      )
    )
  }

Main#main : fun() -> Unit =
  fun() {
    let plus : forall a. fun(Semigroup a) -> fun(a, a) -> a =
      fun(%d.Main#Semigroup%1 : Semigroup a) {
        %d.Main#Semigroup%1.combine
      }
    let plus@Int : fun(Semigroup Int) -> fun(Int, Int) -> Int =
      fun(%d.Main#Semigroup%2 : Semigroup Int) {
        %d.Main#Semigroup%2.combine
      }
    let %seq%1 : Unit =
      Turkey.Stdout#print@String(Data.Int#toString(plus@Int(%inst.Main#Semigroup.Int)(20, 22)))
    let %seq%2 : Unit =
      Turkey.Stdout#print@String(Data.Int#toString(Main#squash@Int(Data.Array#Array([1, 2, 3, 4]))))
    let %seq%3 : Unit =
      Turkey.Stdout#print@String(Main#squash@String(Data.Array#Array(["a", "b", "c"])))
    let %seq%4 : Unit =
      Turkey.Stdout#print@String(Main#triple@String("ha"))
    let %seq%5 : Unit =
      Turkey.Stdout#print@String(Data.Int#toString(Main#triple@Int(14)))
    let %seq%6 : Unit =
      Turkey.Stdout#print@String(%inst.Main#Monoid.Data.String#String#repeat("ab", 3))
    let %seq%7 : Unit =
      Turkey.Stdout#print@String(Main#render(%inst.Main#Foldable.Data.Array#Array#fold@Array(Int)(Data.Array#Array([Data.Array#Array([1, 2]), Data.Array#Array([3]), Data.Array#Array([4, 5, 6])]))))
    let %seq%8 : Unit =
      Turkey.Stdout#print@String(
        Main#render(
          %inst.Data.Functor#Functor.Data.Array#Array#map@Int,Int(
            Data.Array#Array([1, 2, 3]),
            fun(n%1 : Int) {
              %inst.Data.Num#Mul.Int#mul(n%1, 10)
            }
          )
        )
      )
    match %inst.Data.Functor#Functor.Data.Option#Option#map@Int,Int(
  Data.Option#Some(41),
  fun(n%2 : Int) {
    %inst.Data.Num#Add.Int#add(n%2, 1)
  }
) {
      Data.Option#Some(n%3) ->
        Turkey.Stdout#print@String(Data.Int#toString(n%3))
      Data.Option#None ->
        Turkey.Stdout#print@String("none")
    }
  }
