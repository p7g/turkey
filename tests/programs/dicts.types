identity : fun(a) -> a
combine : [Semigroup a] fun(a, a) -> a
empty : [Monoid a] fun() -> a
repeat : [Monoid a] fun(a, Int) -> a
foldMap : [Foldable a, Monoid c] fun(a b, fun(b) -> c) -> c
fold : [Foldable a, Monoid b] fun(a b) -> b
squash : [Monoid a] fun(Array a) -> a
triple : [Semigroup a] fun(a) -> a
render : fun(Array Int) -> String
main : fun() -> Unit
