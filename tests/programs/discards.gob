-- What a statement may throw away (SPEC-DELTAS 66): Unit, and anything that
-- cannot produce a value -- bottom, or a call whose result type its parameters
-- do not mention, which by parametricity cannot return.
-- Never returns, and its type says so: nothing it is given is an `a`.
fun fail(message : String) -> a {
    print(message)
    loop {}
}

fun check(ok : Bool) {
    if !ok { fail("not ok") }
    if ok { print("ok") } else { fail("unreachable") }
}

fun first(xs : Array Int) -> Int {
    var i = 0
    while i < len(xs) {
        if xs[i] > 0 { return xs[i] }
        i = i + 1
    }
    -- A branch every way through which diverges has no value either.
    if len(xs) == 0 { fail("empty") } else { fail("no positive element") }
    0
}

fun main() {
    check(True)
    let _ = first([0, 3])
    print(Int.toString(first([0, 3])))
    var xs = [1, 2]
    while let Some(x) = Array.pop(xs) { print(Int.toString(x)) }
}
