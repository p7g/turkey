-- An equality superclass: a 'Bytes s' is an 'Index s' whose keys are 'Int'
-- and whose values are 'Byte'. A function over any 'Bytes s' reads elements
-- as bytes, and so do a default method, an instance whose context is a
-- 'Bytes s', a function over a subclass, and an arm that opens a 'Bytes s'
-- packed in an existential, which calls 'wordAt' through a dictionary it
-- cannot see.

class Bytes s : Index s, Length s, Key s ~ Int, Value s ~ Byte {
    -- The little-endian 16-bit word at 'i'.
    fun wordAt(bytes : s, i : Int) -> Int = Byte.toInt(bytes[i]) + 256 * Byte.toInt(bytes[i + 1])
}

class Frame s : Bytes s {}

type Packet = Packet(Array Byte)

instance Index Packet {
    type Key = Int
    type Value = Byte
    fun get(Packet(bytes), i) = bytes[i]
}

instance Length Packet { fun len(Packet(bytes)) = len(bytes) }

instance Bytes Packet {}

instance Frame Packet {}

-- A window onto a byte sequence, from an offset. Its keys and values are its
-- sequence's, so 'Bytes (View s)' holds because 'Bytes s' does.
type View s = View { of : s, from : Int }

instance Index (View s) : Bytes s {
    type Key = Key s
    type Value = Value s
    fun get(View { of, from }, i) = of[from + i]
}

instance Length (View s) : Bytes s { fun len(View { of, from }) = len(of) - from }

instance Bytes (View s) : Bytes s {}

fun checksum[Bytes s](bytes : s) -> Int {
    var sum = 0
    for i in Int.range(0, len(bytes)) {
        let b : Byte = bytes[i]
        sum = sum + Byte.toInt(b)
    }
    sum
}

fun lastByte[Frame s](frame : s) -> Byte = frame[len(frame) - 1]

type AnyBytes = AnyBytes[Bytes s](s)

fun score(AnyBytes(b)) -> Int = wordAt(b, 0) + checksum(b) + Byte.toInt(b[0])

fun main() {
    let packet = Packet(Array.map([1, 2, 3, 4], Byte.truncate))
    print(checksum(packet))
    print(wordAt(packet, 0))
    print(Byte.toInt(lastByte(packet)))
    let view = View { of = packet, from = 1 }
    print(checksum(view))
    print(wordAt(view, 1))
    print(checksum(View { of = view, from = 1 }))
    for packed in [AnyBytes(packet), AnyBytes(View { of = packet, from = 2 })] {
        print(score(packed))
    }
}
