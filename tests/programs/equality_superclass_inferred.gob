-- A binding's retained wanteds are solved again under the equalities its
-- retained class predicates grant. 'Bytes a' implies 'Value a ~ Byte' and
-- 'Key a ~ Int', so neither is in the inferred types, and the literal in
-- 'x[1]' is an 'Int' because 'Key a' is.

class Bytes s : Index s, Value s ~ Byte, Key s ~ Int {
    fun firstByte(x : s) -> Byte = x[0]
}

type Packet = Packet(Array Byte)

instance Index Packet {
    type Key = Int
    type Value = Byte
    fun get(Packet(bytes), i) = bytes[i]
}

instance Bytes Packet {}

fun sum(x) = Byte.toInt(firstByte(x)) + Byte.toInt(x[1])

-- A partial annotation: its context needs to list nothing 'Bytes a' implies.
fun sumAt[Bytes a](x : a) = Byte.toInt(firstByte(x)) + Byte.toInt(x[1])

fun same(x) = x[1] == firstByte(x)

fun main() {
    let packet = Packet(Array.map([3, 4], Byte.truncate))
    print(sum(packet))
    print(sumAt(packet))
    print(same(packet))
}
