-- 'Wide (W a)' has the context 'Bytes a', which grants 'Value a ~ Byte'.
-- 'asInt' requires 'Value (W a) ~ Int', which is 'Value a ~ Int', so it can
-- never be called at 'W a', and its override is never lowered.

class Bytes s : Index s, Value s ~ Byte {}

class Wide s : Index s {
    fun asInt[Value s ~ Int, Key s ~ Int](x : s) -> Int = x[0]
}

type Packet = Packet(Array Byte)

instance Index Packet {
    type Key = Int
    type Value = Byte
    fun get(Packet(bytes), i) = bytes[i]
}

instance Bytes Packet {}

type W a = W(a)

instance Index (W a) : Index a {
    type Key = Key a
    type Value = Value a
    fun get(W(x), i) = x[i]
}

instance Wide (W a) : Bytes a, Index a {
    fun asInt(x) = x[0] + 1
}

fun main() {
    let w = W(Packet(Array.map([5], Byte.truncate)))
    print(Byte.toInt(w[0]))
}
