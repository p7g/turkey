-- An inferred type is held to the same rule as a written one. `amb` is
-- generalized over the `c` that `anything` returns, which only `Cg.G c`
-- mentions, so no use of `amb` could decide it.

class Cg a { type G a; fun mkG(a) -> G a }
class Cf a { type F a; fun mkF(a) -> F a }

instance Cf Int { type F = Bool; fun mkF(n) = n > 0 }
instance Cg Int { type G = Bool; fun mkG(n) = n < 0 }

fun anything(u : Unit) -> a = anything(u)

fun amb(x) {
    let y = mkF(x)
    let z = mkG(anything(()))
    let w = if True { y } else { z }
    0
}

fun main() { print(0) }

--@ error
