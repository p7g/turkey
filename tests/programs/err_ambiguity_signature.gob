-- A signature whose type cannot decide one of its variables is refused where
-- it is written. `b` is mentioned only under `G`, and two instances define
-- `G` as `Bool`, so knowing `G b` does not tell a use which `b` it is. No
-- call of `amb2` could ever satisfy `Cg b`.

class Cg a { type G a; fun mkG(a) -> G a }
class Cf a { type F a; fun mkF(a) -> F a }

instance Cf Int { type F = Bool; fun mkF(n) = n > 0 }
instance Cg Int { type G = Bool; fun mkG(n) = n < 0 }
instance Cg Char { type G = Bool; fun mkG(c) = False }

fun amb2[Cf a, Cg b, F a ~ G b](x : a) -> Int = 0

fun main() { print(amb2(1)) }

--@ error
