-- A body annotation's name belongs to the function, at the function's rank.
-- The `let` of `z` cannot generalize it, so the lambda's `j` is `z`'s `Int`.
fun outer(n : Int) -> String {
    let z : j = 3
    let f = fun(y : j) = y
    show(f("s")) + show(z)
}

fun main() {
    print(outer(1))
}

--@ error
