-- Every type, class and instance declaration that cannot be registered is
-- reported, and then nothing is checked against the gaps they leave.

type Shape = Circle(Float) | Square(Nope)

type Shape = Dot

type Pair a = Pair(a, b)

class Pretty a {
    fun pretty(a) -> String
}

class Pretty b {
    fun other(b) -> String
}

instance Pretty Int {
    fun pretty(n) = "int"
    fun extra(n) = "x"
}

instance Missing Bool {
    fun m(b) = "b"
}

fun main() {
    print(pretty(1))
}

--@ error
