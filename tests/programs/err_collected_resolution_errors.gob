-- Resolution reports an error in each top-level declaration it is in. In
-- `a`, the undeclared '<+>' is reported once, and not again as a precedence
-- error against '<<', whose group is unrelated to the one '<+>' is given.

import Data.Int as I

fun a(x : Int) -> Int = x <+> 1 << 2

fun b() -> Int = I.nope(3)

fun c(x : Int) -> Int = x +++ 2

fun main() {
    print(a(1) + b() + c(1))
}

--@ error
