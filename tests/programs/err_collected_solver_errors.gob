-- A missing instance, a missing field and a literal of the wrong type, each
-- in a declaration of its own, are all reported.

type Point = Point { x : Int, y : Int }

fun half(n) = n / "2"

fun norm(p : Point) -> Int = p.z

let label = 1 + "one"

fun main() {
    print(half(4))
    print(norm(Point { x = 1, y = 2 }))
}

