-- 'Bytes a' grants 'Val a ~ Int' and 'Bools a' grants 'Val a ~ Bool', which
-- can never hold together. The second is refused where 'Bools a' is written,
-- naming the constraint that grants it.
class Ix s { type Val s; fun at(s) -> Val s }
class Bytes s : Ix s, Val s ~ Int {}
class Bools s : Ix s, Val s ~ Bool {}
class Wide s { fun wide(s) -> Int }

type W a = W(a)

instance Wide (W a) : Bytes a, Bools a { fun wide(x) = 0 }

fun main() { }

--@ error
