-- The same through an equation deferred on a field: `[cell[0].f, Some(y)]`
-- ties `y` to the field of `cell`'s element, which `main` decides, so `g`
-- cannot be generalized over `y`.

type R t = R { f : t }
let cell = Vec.new(4)
fun f() -> Unit {
    let g = fun(y) = {
        if False { let _ = [cell[0].f, Some(y)] }
        y
    }
    print(g("s"))
}
fun main() {
    f()
    Vec.push(cell, R { f = Some(2) })
    match cell[0].f {
        Some(v) -> print(Int.toString(v + 1))
        None -> {}
    }
}

--@ error
