-- A requirement that grows without end each time it is reduced is reported,
-- not followed for ever: `W`'s written instance needs `Eq` at a larger `W`
-- than it provides it at.

type W a = W(a)

instance Eq (W a) : Eq (W (Array a)) {
    fun eq(_, _) = True
}

type Wrapped : Eq = Wrapped(W Int)

fun main() {}

--@ error
