-- A written instance whose context needs the class at a bigger type is refused
-- at its context, so a derivation through it never starts: `W`'s instance
-- would need `Eq` at a larger `W` than it provides it at.

type W a = W(a)

instance Eq (W a) : Eq (W (Array a)) {
    fun eq(_, _) = True
}

type Wrapped : Eq = Wrapped(W Int)

fun main() {}

--@ error
