-- `K c`'s instance needs `Key c ~ Int`, which holds for some `c` and not
-- others, and a derived context can only constrain the type's parameters
-- with classes.

type K c = K(Int)

instance Eq (K c) : Key c ~ Int {
    fun eq(K(a), K(b)) = a == b
}

type Tagged c : Eq = Tagged(K c)

fun main() {}

--@ error
