-- `K2 (Array c)`'s instance needs `Value (Array c) ~ Bool`, which is
-- `c ~ Bool`: it holds for one `c` and not for others, and a derived context
-- can only constrain the type's parameters with classes.

type K2 c = K2(Int)

instance Eq (K2 c) : Value c ~ Bool {
    fun eq(K2(a), K2(b)) = a == b
}

type Tagged c : Eq = Tagged(K2 (Prim.Array c))

fun main() {}

--@ error
