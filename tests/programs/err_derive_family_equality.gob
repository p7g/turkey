-- `K (Map String Int)`'s instance needs `Key (Map String Int) ~ Int`, which
-- does not hold: the key of a `Map String Int` is a `String`.

type K c = K(Int)

instance Eq (K c) : Key c ~ Int {
    fun eq(K(a), K(b)) = a == b
}

type Tagged : Eq = Tagged(K (Map String Int))

fun main() {}

--@ error
