-- `K (Array Bool)`'s instance needs `Key (Array Bool) ~ Int`, which holds
-- only once the associated type is reduced, so a derivation refuses it.

type K c = K(Int)

instance Eq (K c) : Key c ~ Int {
    fun eq(x, y) = match (x, y) {
        (K(a), K(b)) -> a == b
    }
}

type Tagged : Eq = Tagged(K (Array Bool))

fun main() {}

--@ error
