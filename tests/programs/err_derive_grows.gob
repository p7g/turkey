-- A written instance whose context doubles its argument at every step is
-- refused as diverging, and quickly: each step's type is twice the last as a
-- tree, though its nodes are shared.

type W a = W(a)

instance Eq (W a) : Eq (W (a, a)) {
    fun eq(_, _) = True
}

type Wrapped : Eq = Wrapped(W Int)

fun main() {}

