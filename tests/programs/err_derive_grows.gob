-- A written instance whose context doubles its argument at every step is
-- refused at its context, and quickly, so the derivation that would need it
-- never starts. Each step's type would be twice the last as a tree, though
-- its nodes are shared.

type W a = W(a)

instance Eq (W a) : Eq (W (a, a)) {
    fun eq(_, _) = True
}

type Wrapped : Eq = Wrapped(W Int)

fun main() {}

