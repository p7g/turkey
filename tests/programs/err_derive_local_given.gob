-- A derived instance holds everywhere, so its context is inferred under no
-- assumption a use makes: `same` grants `Key c ~ Int`, but `T`'s implicit
-- `Eq` would need it of every `c`.

type K c = K(Int)

instance Eq (K c) : Key c ~ Int {
    fun eq(K(a), K(b)) = a == b
}

type T c = T(K c)

fun same[Index c, Key c ~ Int](x : T c, y : T c) -> Bool = x == y

fun main() {}

--@ error
