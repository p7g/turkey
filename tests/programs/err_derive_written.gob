-- An instance written by hand is the type's instance, so the derive list may
-- neither derive another nor refuse it.

type Celsius : Eq = Celsius(Float)

instance Eq Celsius {
    fun eq(a, b) {
        let Celsius(x) = a
        let Celsius(y) = b
        x == y
    }
}

type Token : !Eq = Token(Int)

instance Eq Token {
    fun eq(_, _) = False
}

fun main() {}

--@ error
