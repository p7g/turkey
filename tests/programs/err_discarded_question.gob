-- A discarded value is an error when an argument holds a `?` too: the
-- statement is still there to be checked once the `?` is bound.
fun get(n : Int) -> Option Int = Some(n)

fun twice(n : Int) -> Int = n * 2

fun f() -> Option Int {
    twice(get(1)?)
    Some(0)
}

fun main() {
    let _ = f()
}

--@ error
