-- 'Bytes' requires every instance's values to be bytes, and a 'Words'
-- holds strings, so 'Bytes Words' is refused where it is declared.
class Bytes s : Index s, Value s ~ Byte {}

type Words = Words(Array String)

instance Index Words {
    type Key = Int
    type Value = String
    fun get(Words(ws), i) = ws[i]
}

instance Bytes Words {}

fun main() {}

--@ error
