-- 'Bytes (W a)' must prove its equality superclass 'Value (W a) ~ Byte',
-- which is 'a ~ Byte'. The context's 'Bytes (W a)' would grant it, but it is
-- the dictionary being built. The context constraint is refused for being no
-- smaller than the head, which rules this out.
class Bytes s : Index s, Value s ~ Byte {}

type W a = W(a)

instance Index (W a) {
    type Key = Int
    type Value = a
    fun get(W(x), _) = x
}

instance Bytes (W a) : Bytes (W a) {}

fun main() { }

--@ error
