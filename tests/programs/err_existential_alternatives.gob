-- Each alternative of an arm would hide a different type, so an arm with
-- alternatives may not open an existential (SPEC-DELTAS 68).

type Held = Some[Show a](a) | Other[Show a](a)

fun describe(v : Held) -> String = match v {
    Some(x) | Other(x) -> show(x)
}

fun main() {
    print(describe(Some(1)))
}
