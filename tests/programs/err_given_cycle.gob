-- Two equalities that each rewrite into the other state one fact, so checking
-- the context ends. What the body asks is a third: that the two families are
-- `Int`, which neither says.

class C a {
    type F a
    type G a
    fun f(a) -> F a
}

fun h[C a, F a ~ G a, G a ~ F a](x : a) -> Int = f(x)

fun main() { }

--@ error
