-- A value whose type is a cycle breaker, matched against two patterns: the
-- breaker stands for `F a`, which nothing decides, so each arm is stuck. The
-- checker reports it once, where the first arm needs it, and stops.

class C a {
    type F a
    fun get(a) -> F a
}

instance C (Option b) {
    type F = b
    fun get(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

class W w {
    type E w
}

instance W (Option a) {
    type E = a
}

fun h[C a, E (Option a) ~ Option (F a)](y : F a) -> Int = match y {
    Some(n) -> n
    None -> 0
}

fun main() { }

--@ error
