-- A class whose superclasses include an equality makes a type from outside
-- undecidable inside a 'match' arm that opens it, as an equality in a
-- context would. The arm says `f` returns a `Bool`, and nothing outside it
-- does.

class Bag b {
    type Elem b
}

class Counted s : Bag s, Elem s ~ Int {}

type IntBox = IntBox(Int)

instance Bag IntBox {
    type Elem = Int
}

instance Counted IntBox {}

type Some = Some[Counted s](s)

fun f(t) = match t {
    Some(_) -> True
}

fun main() { print(f(Some(IntBox(1)))) }

--@ error
