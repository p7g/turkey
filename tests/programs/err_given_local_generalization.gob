-- A local function generalized under an equality given may not be
-- generalized over a variable an outer equation will decide. `g` pushes
-- `Some(y)` into `log`, whose element is decided outside `f`, so `y` has one
-- type for the whole program. `g("s")` makes it `String`, and the push then
-- disagrees with `main`'s `Int`.

class Box b {
    type Elem b
}
instance Box (Option a) {
    type Elem = a
}
let log = Vec.new(4)
fun f[Box b, Elem b ~ Int](x : b) -> Unit {
    let g = fun(y) = {
        Vec.push(log, Some(y))
        y
    }
    print(g("s"))
}
fun main() {
    f(Some(1))
    match log[0] {
        Some(v) -> print(Int.toString(v + 1))
        None -> {}
    }
}

--@ error
