-- A given that reduces to an equality between two different types can never
-- hold, and is refused where it was written.

class Bag b {
    type Elem b
}

type Counted a = Counted(a)

instance Bag (Counted a) {
    type Elem = Int
}

fun f[Elem (Counted a) ~ Bool](x : a) -> Int = 0

fun main() { }

