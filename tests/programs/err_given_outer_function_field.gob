-- Under an equality given, a call to a function from outside the signature
-- cannot decide that function's type. `f(n).age` needs `f` to take an `Int`,
-- but only `inner`'s body says so, under `Item s ~ Int`, and `outer` is
-- generalized over `f`'s type. GHC refuses the same program: "Could not
-- deduce 'p ~ (Int -> P)'". Annotating `f`, as `given_outer_function_show`
-- does, makes it check.

type P = P { age : Int }
fun outer(f) -> Int {
    fun inner[Iterator s, Item s ~ Int](xs : s) -> Int {
        var t = 0
        for n in xs { t = t + f(n).age }
        t
    }
    inner([1, 2])
}
fun main() { print(Int.toString(outer(fun(n) = P { age = n }))) }

--@ error
