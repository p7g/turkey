-- A given that might match a wanted keeps the instance from being chosen,
-- and here nothing decides `y`'s type, so the wanted is ambiguous. The
-- unknown type is not called `a`, which is the signature's own variable.
class Q x { fun q(x) -> Int }
type Box a = Box(a)
instance Q (Box x) { fun q(b) = 7 }
fun anything(u : Unit) -> a = error("never")
fun g[Q (Box a)](x : a) -> Int {
    let y = anything(())
    q(Box(y))
}
fun main() { print(g(1)) }

--@ error
