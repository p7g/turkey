-- Under an equality in a signature's context, a variable from outside the
-- function cannot be decided inside it. `inner` returns `x`, so `x` must be
-- an `Int`, but only `inner`'s body says so, under `Elem b ~ Int`, and
-- nothing outside `inner` decides `x`. `outer` is generalized over `x`'s
-- type, and that type cannot then be `Int`. GHC refuses the same program:
-- "Could not deduce 'p ~ Int' from the context: (Bag b, Elem b ~ Int)".

class Bag b {
    type Elem b
}

fun outer(x) {
    fun inner[Bag b, Elem b ~ Int](y : b) -> Int = x
    0
}

fun main() { print(outer(1)) }

--@ error
