-- A type from outside cannot be decided under an equality in the context of
-- any function around the use, however deep. `inner`'s own context has no
-- equality, but `mid`'s does, and `x` is from outside `mid`.

class Bag b {
    type Elem b
}

instance Bag (Option a) {
    type Elem = a
}

fun outer(x) {
    fun mid[Bag c, Elem c ~ Int](z : c) -> Int {
        fun inner[Show b](y : b) -> Int = x
        inner(1)
    }
    mid(Some(1))
}

fun main() { print(outer(1)) }

--@ error
