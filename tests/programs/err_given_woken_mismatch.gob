-- An equation left undecided under an equality given is reported, once the
-- type it waited on is decided, in the order it was written. `inner`'s body
-- must be an `Int`, and `x` turns out to be a `String`.

class Bag b {
    type Elem b
}

fun outer(x) -> Int {
    fun inner[Bag b, Elem b ~ Int](y : b) -> Int = x
    let s : String = x
    0
}

fun main() { print(outer("a")) }

--@ error
