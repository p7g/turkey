-- `f` uses its group's code at a type its own type does not decide: `g`'s
-- `n`, which only `F n ~ Bool` constrains. An associated type does not
-- determine its argument, so nothing decides `n`. It is reported at `f`,
-- which needs it, though `g` comes first.

class Cf a {
    type F a
    fun mkF(a) -> F a
}

instance Cf Int {
    type F = Bool
    fun mkF(n) = n > 0
}

fun anything(u : Unit) -> a = anything(u)

fun g(n, stop) = if stop { if mkF(n) { "t" } else { "f" } } else { f(True) }

fun f(x) = show(x) + g(anything(()), True)

fun main() { print(f(True)) }

--@ error
