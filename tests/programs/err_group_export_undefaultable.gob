-- `f` uses the group's code at a type its own type does not decide, and
-- only `Named` constrains it, which no default satisfies.

class Named a {
    fun label(a) -> String
}

instance Named Bool {
    fun label(b) = if b { "yes" } else { "no" }
}

fun anything(u : Unit) -> a = anything(u)

fun f(x) = show(x) + g(anything(()), False)

fun g(n, stop) = if stop { label(n) } else { f(True) }

fun main() { print(g(True, True)) }

--@ error
