-- A `Hasher` a program writes is handed each string's bytes as a `ByteView`,
-- which has no `SetIndex`, so it cannot write to the string.

import Data.Hashable (Hasher(..), Hash(..))

type Evil = Evil(Int)

instance Hasher Evil {
    fun startHash(seed) = Evil(seed)
    fun hashInt(h, _) = h
    fun hashBytes(h, bytes) {
        bytes[0] = Byte.truncate(122)
        h
    }
    fun finishHash(Evil(n)) = n
}

fun greeting() -> String = "abc"

fun main() {
    let _ = finishHash(hashInto(greeting(), Evil(0)))
    print(greeting())
}

--@ error
