-- Each `Tk` reaches itself through `next`, and each `Ak` and `Bk` holds the
-- next `T`. A use reports the first link of the chain, and finding why it
-- fails costs one attempt, not one per path down the chain.

type A1 = A1(T2)
type B1 = B1(T2)
type T2 = T2 { var next : Option T2, a : A2, b : B2 }
