-- `Any` hides a type, which may be an array of `T`, so `T` is taken to reach
-- itself through it and gets no implicit `Eq`. Otherwise this `==` would
-- follow the cycle closed by `arr[0] = t` for ever.
type Any = Any[Eq a](a)

instance Eq Any {
    fun eq(Any(x), _) = x == x
}

type T = T(Int, Any)

fun main() {
    let arr = [T(0, Any(0))]
    let t = T(1, Any(arr))
    arr[0] = t
    print(t == t)
}

--@ error
