-- `f` may be `Array`, so `App f a` is taken to hold `a` assignably, and `T`
-- reaches itself through `App Array T`.
type App f a = App(f a)

instance Eq (App f a) : Eq (f a) {
    fun eq(App(x), App(y)) = x == y
}

type T = T(Int, App Array T)

fun main() {
    let arr = [T(0, App([]))]
    let t = T(1, App(arr))
    arr[0] = t
    print(t == t)
}

--@ error
