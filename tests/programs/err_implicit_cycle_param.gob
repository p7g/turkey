-- Reaching itself is decided after type arguments are substituted: `Link`
-- reaches itself through `Cell`'s `var` field, though `Cell` alone does not.

type Cell a = Cell { var held : a }

type Link = Link { next : Cell (Option Link) }

type Chain = Chain { first : Link }

fun cells() -> Bool = Cell { held = 1 } == Cell { held = 1 }

fun links(link : Link) -> Bool = link == link

fun chains(chain : Chain) -> Bool = chain == chain

fun main() {
    print(cells())
}

--@ error
