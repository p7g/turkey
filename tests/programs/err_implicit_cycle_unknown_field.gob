-- `Rose` is taken to reach itself through `f (Rose f a)`, since `f` may be
-- `Array`, but its fields have no `Eq` anyway: what `f` holds is not known.
-- So the use reports the field, and offers no derive list, which could not
-- help.
type Rose f a = Rose(a, f (Rose f a))

fun main() {
    let r : Rose Array Int = Rose(1, [])
    print(r == r)
}

--@ error
