-- A doubly linked node reaches itself through its `var` fields, so a derived
-- `==` would not end on two linked nodes, and it has no implicit `Eq`.

type Node = Node { value : Int, var next : Option Node, var prev : Option Node }

fun main() {
    let a = Node { value = 1, next = None, prev = None }
    print(a == a)
}

--@ error
