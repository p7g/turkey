-- A type whose fields lack `Eq` has none, silently, until something compares
-- it; then the reason follows the fields down.

type Callback = Callback { name : String, run : fun() -> Int }

type Job = Job { id : Int, callback : Callback }

fun main() {
    let j = Job { id = 1, callback = Callback { name = "a", run = fun() = 1 } }
    print(j == j)
}

--@ error
