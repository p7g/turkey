-- A type with a `var` field has no implicit `Hash`: a key that changed after
-- it went into a map would be lost there. Nor does a type that holds one.

type Counter = Counter { var count : Int }

type Tally = Tally { counter : Counter }

fun byCounter() {
    let m = Map.new()
    Map.put(m, Counter { count = 0 }, "zero")
}

fun byTally() {
    let m = Map.new()
    Map.put(m, Tally { counter = Counter { count = 0 } }, "zero")
}

fun main() {
    byCounter()
    byTally()
}

--@ error
