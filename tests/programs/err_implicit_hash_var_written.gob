-- `Counter` has a `var` field and a written `Eq`. Only the written `Eq` is
-- reported, because ': Hash' in its declaration would not help.
type Counter = Counter { var count : Int }

instance Eq Counter {
    fun eq(a, b) = a.count == b.count
}

fun main() {
    let seen = Map.new()
    Map.put(seen, Counter { count = 0 }, True)
}

--@ error
