-- Two declarations with nothing to do with each other are each wrong, so both
-- are reported. `twice` uses `half`, whose error is reported once and not
-- again at each use.

fun half(n : Int) -> Int = n / 2.0

fun twice(n : Int) -> Int = half(n) + half(n)

fun greeting() -> String {
    let count : Int = "three"
    let other : Int = "four"
    "hello"
}

fun main() {
    print(twice(4))
    print(greeting())
}

--@ error
