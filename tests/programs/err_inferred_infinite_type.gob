-- An equation whose variable occurs in its other side under an associated
-- type waits while the associated type might still reduce. Once nothing can
-- decide it, it is the infinite type it looks like, and is reported as one:
-- no context could state it.

class Box b {
    type Elem b
    fun open(b) -> Elem b
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

let c = Vec.new(1)

fun put() { Vec.push(c, Some(open(c[0]))) }

fun main() { }

--@ error
