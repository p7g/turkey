class Source s {
    type Failure s
    fun pull(s) -> Either (Failure s) Int
}

class Sink s {
    type Trouble s
    fun push(s, Int) -> Either (Trouble s) Unit
}

type Layer s = Layer { inner : s }

-- The instance's context is missing `Trouble s ~ Failure s`, and the hint
-- names it as the context writes it.
instance Source (Layer s) : Source s, Sink s {
    type Failure = Failure s
    fun pull(Layer { inner }) {
        push(inner, 1)?
        pull(inner)
    }
}

fun main() { }

--@ error
