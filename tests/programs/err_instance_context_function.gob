-- The first associated type in a function type, read left to right, is the
-- one named: `Elem a` in the parameter, not `Item b` in the result.

class Bag b { type Elem b }
class Sack b { type Item b }
class C a { fun c(a) -> Int }

type T a b c d e = T(a, b, c, d, e)

instance C (T a b c d e) : Bag a, Sack b, C (fun(Elem a) -> Item b) { fun c(_) = 0 }

fun main() { }

--@ error
