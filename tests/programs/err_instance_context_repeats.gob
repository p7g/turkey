-- A context constraint smaller than the head can still grow: `a` occurs twice
-- in `Eq (a, a)` and once in the head, so `a` standing for a big type makes
-- the constraint bigger than the head.

type T a b c = T(a, b, c)

instance Eq (T a b c) : Eq (a, a) {
    fun eq(_, _) = True
}

fun main() { }

--@ error
