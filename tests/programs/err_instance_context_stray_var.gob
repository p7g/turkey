-- An instance context that mentions a variable its head does not bind is
-- refused at the variable.

class Source s {
    type Failure s
    fun pull(s) -> Either (Failure s) Int
}

class Sink s {
    type Trouble s
    fun push(s, Int) -> Either (Trouble s) Unit
}

type Layer s = Layer { inner : s }

instance Source (Layer s) : Source s, Sink s, Failure s ~ Trouble t {
    type Failure = Failure s
    fun pull(Layer { inner }) {
        push(inner, 1)?
        pull(inner)
    }
}
fun main() {}

--@ error
