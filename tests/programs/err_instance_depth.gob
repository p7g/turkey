-- A finite chain of instances longer than the checker follows: `Eq` at `W`
-- nested 202 deep needs `Eq (W a) : Eq a` 202 times, and the checker gives
-- up at 200. Every step is smaller than the last, so solving it would end;
-- the message says only that the checker stopped.

type W a = W(a)
type W2 a = W (W a)
type W8 a = W2 (W2 (W2 (W2 a)))
type W64 a = W8 (W8 (W8 (W8 (W8 (W8 (W8 (W8 a)))))))
type W128 a = W64 (W64 a)

fun same(x : W128 (W64 (W8 (W2 Int)))) -> Bool = x == x

fun main() { }

--@ error
