-- A context that doubles its argument is refused at the constraint, before
-- the use in `main` is solved. Solving that use would ask for
-- `Eq (W (Int, Int))`, then `Eq (W ((Int, Int), (Int, Int)))`, each type twice
-- the last, and would not reach the depth bound in any reasonable time.

type W a = W(a)

instance Eq (W a) : Eq (W (a, a)) {
    fun eq(_, _) = True
}

fun main() { print(W(1) == W(1)) }

--@ error
--@ timeout: 10
