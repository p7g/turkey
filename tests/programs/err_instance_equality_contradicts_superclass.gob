-- 'Bytes a' grants 'Value a ~ Byte', so the context's own 'Value a ~ Int'
-- can never hold beside it, and is refused where it is written.
class Bytes s : Index s, Value s ~ Byte {}

class Wide s : Index s {}

type W a = W(a)

instance Index (W a) : Index a {
    type Key = Key a
    type Value = Value a
    fun get(W(x), i) = x[i]
}

instance Wide (W a) : Bytes a, Value a ~ Int {}

fun main() { }

--@ error
