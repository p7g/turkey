-- An instance whose context says `Failure s ~ Trouble s`, used at a `Pipe`
-- whose two families differ. The use is refused where it is.

class Source s {
    type Failure s
    fun pull(s) -> Either (Failure s) Int
}

class Sink s {
    type Trouble s
    fun push(s, Int) -> Either (Trouble s) Unit
}

type Layer s = Layer { inner : s }

instance Source (Layer s) : Source s, Sink s, Failure s ~ Trouble s {
    type Failure = Failure s
    fun pull(Layer { inner }) {
        push(inner, 1)?
        pull(inner)
    }
}
type Pipe = Pipe(Int)
instance Source Pipe {
    type Failure = String
    fun pull(Pipe(n)) = Right(n)
}
instance Sink Pipe {
    type Trouble = Int
    fun push(Pipe(n), x) = Right(())
}
fun main() {
    let r = pull(Layer { inner = Pipe(3) })
}

--@ error
