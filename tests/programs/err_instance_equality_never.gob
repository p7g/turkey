-- An instance equality that can never hold, reported where the context
-- writes it.

class Base a {
    type K a
    fun k(a) -> K a
}
type W a = W(a)
instance Base Int {
    type K = Int
    fun k(x) = x
}
instance Base (W a) : Base a, K Int ~ Bool {
    type K = Int
    fun k(W(x)) = 0
}
fun main() {}

--@ error
