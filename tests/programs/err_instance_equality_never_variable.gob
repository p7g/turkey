-- An instance equality over the head's variable that can never hold: `K (W a)`
-- is `Int`, never `Option a`. The message names the variable as the
-- declaration does.

class Base a {
    type K a
    fun k(a) -> K a
}

type W a = W(a)

instance Base (W a) : K (W a) ~ Option a {
    type K = Int
    fun k(W(x)) = 0
}

fun main() {}

--@ error
