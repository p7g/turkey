-- An instance whose context demands a bigger constraint than its head solves
-- never finishes: `C (Box a)` needs `C (Box (Box a))`, which needs more. The
-- checker gives up at a fixed depth and reports the constraint it started
-- from, where it arose.
class C a { fun c(a) -> Int }
type Box a = Box(a)
instance C (Box a) : C (Box (Box a)) { fun c(x) = 0 }
fun main() { print(c(Box(1))) }

--@ error
