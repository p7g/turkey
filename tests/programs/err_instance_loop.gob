-- An instance whose context demands a bigger constraint than its head is
-- refused at that constraint: `C (Box a)` would need `C (Box (Box a))`, which
-- would need more, without end.
class C a { fun c(a) -> Int }
type Box a = Box(a)
instance C (Box a) : C (Box (Box a)) { fun c(x) = 0 }
fun main() { print(c(Box(1))) }

--@ error
