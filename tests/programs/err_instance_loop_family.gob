-- The same loop through an associated type in the context: `Elem (Box a)` is
-- `Box (Box a)`. An associated type may stand for a type of any size, so a
-- context constraint cannot apply one.
class Bag b { type Elem b }
class C a { fun c(a) -> Int }
type Box a = Box(a)
instance Bag (Box a) { type Elem = Box (Box a) }
instance C (Box a) : C (Elem (Box a)) { fun c(x) = 0 }
fun main() { print(c(Box(1))) }

--@ error
