-- The same loop through an associated type in the instance's context:
-- `Elem (Box a)` is `Box (Box a)`.
class Bag b { type Elem b }
class C a { fun c(a) -> Int }
type Box a = Box(a)
instance Bag (Box a) { type Elem = Box (Box a) }
instance C (Box a) : C (Elem (Box a)) { fun c(x) = 0 }
fun main() { print(c(Box(1))) }

--@ error
