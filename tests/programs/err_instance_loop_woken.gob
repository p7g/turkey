-- The same loop reached by a wanted that waited: `c(x)` needs `C a` for an
-- unknown `a`, and only the assignment to `x` starts the instances off.
class Bag b { type Elem b }
class C a { fun c(a) -> Int }
type Box a = Box(a)
instance Bag (Box a) { type Elem = Box (Box a) }
instance C (Box a) : C (Elem (Box a)) { fun c(x) = 0 }
fun anything(u : Unit) -> a = error("never")
fun f() -> Int {
    var x = anything(())
    let n = c(x)
    x = Box(1)
    n
}
fun main() { }

--@ error
