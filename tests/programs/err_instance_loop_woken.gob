-- The same instance with a use that a unification starts: `c(x)` needs `C a`
-- for an unknown `a`, and only the assignment to `x` would select the
-- instance. The instance is refused at its context before any use is solved.
class Bag b { type Elem b }
class C a { fun c(a) -> Int }
type Box a = Box(a)
instance Bag (Box a) { type Elem = Box (Box a) }
instance C (Box a) : C (Elem (Box a)) { fun c(x) = 0 }
fun anything(u : Unit) -> a = error("never")
fun f() -> Int {
    var x = anything(())
    let n = c(x)
    x = Box(1)
    n
}
fun main() { }

--@ error
