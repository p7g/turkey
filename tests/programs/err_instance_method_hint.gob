-- Inside an instance method, a missing equality is reported with a hint that
-- spells the families the way an instance context writes them.

class Source s {
    type Failure s
    fun pull(s) -> Either (Failure s) Int
}

class Sink s {
    type Trouble s
    fun push(s, Int) -> Either (Trouble s) Unit
}

type Layer s = Layer { inner : s }

instance Source (Layer s) : Source s, Sink s {
    type Failure = Failure s
    fun pull(Layer { inner }) {
        push(inner, 1)?
        pull(inner)
    }
}
fun main() {}

--@ error
