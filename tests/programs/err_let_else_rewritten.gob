-- An `else` block that falls through is reported as such even where a `?`
-- earlier in the function and a `return` later make desugaring rewrite the
-- block into a value.
fun f(a : String, b : Option Int, c : Bool) -> Option Int {
    let x = Int.parse(a)?
    let Some(y) = b else { if c { return Some(0) } }
    if y < 0 { return None }
    Some(x + y)
}

fun main() {
    print(f("1", Some(2), True))
}

--@ error
