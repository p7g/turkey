-- A `let` annotation's new name is the function's, so it cannot stand for a
-- type that only one arm can see. Only the arm's pattern can name it.
type Shown = Shown[Show a](a)

fun describe(s : Shown) -> String {
    match s {
        Shown(v) -> {
            let copy : a = v
            show(copy)
        }
    }
}

fun main() {
    print(describe(Shown(True)))
}

--@ error
