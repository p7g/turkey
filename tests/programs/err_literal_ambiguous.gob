-- Two containers could be taken, each leaving a need on the element that
-- nothing will default: the literal is ambiguous.
class Never a { fun never(a) -> Int }
class Choose a { fun choose(a) -> String }
instance Choose (Array a) : Never a { fun choose(_) = "array" }
instance Choose (Vec a) : Hash a { fun choose(_) = "vec" }

fun g(x) = choose([x])

fun main() { print(g(1)) }

--@ error
