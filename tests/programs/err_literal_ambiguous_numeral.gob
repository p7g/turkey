-- The element is a numeral the function's type keeps general, so nothing
-- decides it, and two containers could each be taken.
class Never a { fun never(a) -> Int }
class Pick a { fun pick(a) -> String }
instance Pick (Vec a) : Never a { fun pick(_) = "vec" }
instance Pick (FrozenArray a) : Hash a { fun pick(_) = "frozen" }

fun w(n) {
    let _ = pick([n])
    n + 1
}

fun main() { print(w(1)) }

--@ error
