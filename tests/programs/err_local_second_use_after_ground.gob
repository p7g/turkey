-- `pick` uses the parameter `n`, so it has one type. Its first use fixes that
-- type completely, and the second use is refused where it is written.
fun go(n : Int) {
    let pick = fun(x, y) = if n > 0 { x } else { y }
    print(pick(True, False))
    print(pick("a", "b"))
}

fun main() {
    go(1)
}

