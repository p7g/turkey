-- The second use of `f` is at `q`, whose type is decided only after `f`'s
-- scope ends, by `k(True)`. The refusal is still reported at that use.
fun go(n : Int) {
    let k = fun(q) {
        let f = fun(z) = (n, z)
        let _ = f("s")
        let _ = f(q)
    }
    k(True)
}

fun main() {
    go(1)
}

--@ error
