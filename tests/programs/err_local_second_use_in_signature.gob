-- The second use of `same` is inside a local function with a signature,
-- which is checked one rank deeper; it is still refused at that use.
fun go(n : Int) {
    let same = fun(x) = if n > 0 { x } else { x }
    let _ = same(1)
    fun inner(b : Bool) -> Bool = same(b)
    print(inner(True))
}

fun main() {
    go(1)
}

--@ error
