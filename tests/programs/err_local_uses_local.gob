-- `wrap` uses `line`, which is not generalized because it uses a parameter,
-- so `wrap` is not generalized either. Its first use fixes its one type
-- completely, and the second use is refused where it is written.
fun report(prefix : String) {
    let line = fun(v) = prefix + show(v)
    let wrap = fun(v) = "[" + line(v) + "]"
    print(wrap("a"))
    print(wrap(True))
}

fun main() {
    report("> ")
}

--@ error
