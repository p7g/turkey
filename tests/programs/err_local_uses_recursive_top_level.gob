-- Inside its own definition, `walk` has no signature and its type is still
-- being inferred, so it is not closed, and neither is `pair`. The fix is a
-- signature on `walk`.
fun walk(n) {
    let pair = fun(v) = (v, walk)
    let _ = pair(1)
    let _ = pair("s")
    n
}

fun main() {
    print(walk(3))
}

--@ error
