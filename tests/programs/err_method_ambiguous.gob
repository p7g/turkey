-- A record field and a function of its module with one name: `b.ready()`
-- could mean either, so it is an error, whichever would type-check. Read as
-- the function, this one would call itself forever.

type Body = Body { ready : fun() -> Bool }

fun ready(b : Body) -> Bool = b.ready()

fun main() -> Unit = print(ready(Body { ready = fun() = True }))

--% error
