-- `tag` is checked with `trim` and `label` only because the method calls in
-- them may call each other, which makes `tag` monomorphic among them.

type Box = Box { text : String }

fun tag(x) {
	let word = " q "
	print(word.trim())
	x
}

fun trim(b) {
	print(b.label())
	b
}

fun label(b : Box) {
	print(tag(1) + 1)
	tag("s") + b.text
}

fun main() -> Unit = print(Box { text = "!" }.trim().text)

--% error
