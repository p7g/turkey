-- This module's `show` hides the class method from method calls on any
-- receiver: a tuple's and a type variable's too, which have no module of
-- their own to call a `show` of.

fun show(s : String) -> String = "<" + s + ">"

fun pair() -> String = (1, 2).show()

fun anything[Show a](x : a) -> String = x.show()

fun main() -> Unit {
	print(pair())
	print(anything(3))
}

