-- Instance methods checked against the type their class declares. Each method
-- is its own unit of diagnostics, so every mistake below is reported.
class Describe a {
    fun describe(a) -> String
}

-- The body's result is not the declared result.
instance Describe Int {
    fun describe(n) = n + 1
}

-- A parameter annotation contradicts the class.
instance Describe Bool {
    fun describe(b : String) = b
}

-- One parameter too many.
instance Describe Char {
    fun describe(c, extra) = "c"
}

type Shown = Shown[Show a](a)

class Leak r {
    fun leak(r) -> Int
    fun leakSome(r, Bool) -> Option Int
}

-- The hidden type cannot become the declared result, whether the body or a
-- `return` hands it back.
instance Leak Shown {
    fun leak(Shown(v)) = v
    fun leakSome(Shown(v), early) {
        if early { return Some(v) }
        None
    }
}

-- The same through a plain signature.
fun leakDeclared(Shown(v) : Shown) -> Int = v

fun main() {}

--@ error
