export (Shape(..), area, describe)

type Shape = Circle(Float) | Square(Float)

fun area(s : Shape) -> Float = match s {
	Circle(r)    -> 3.0 * r * r
	Square(side) -> side * side
}

-- Not exported: reachable by its own module only.
fun kind(s : Shape) -> String = match s {
	Circle(_) -> "circle"
	Square(_) -> "square"
}

fun describe(s : Shape) -> String = "${s.kind()} of area ${s.area()}"
