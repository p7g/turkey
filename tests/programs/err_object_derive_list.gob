-- A derive list cannot ask for `Object`, which every type whose values are
-- objects has already, nor refuse it for a type whose values are not. A
-- wrapper over a value is a value; one over a parameter may be an object,
-- so `Box` may refuse it.

type Asked : Object = Asked { var value : Int }

type Point : !Object = Point { x : Int, y : Int }

type Name : !Object = Name(String)

type Box a : !Object = Box(a)

fun main() {}

--@ error
