-- `!Object` refuses the instance a record with a `var` field would have, and
-- a wrapper over the record has none either.

type Refused : !Object = Refused { var value : Int }

type Wrapped = Wrapped(Refused)

fun refused(r : Refused) -> Bool = identical(r, r)

fun wrapped(w : Wrapped) -> Bool = identical(w, w)

fun main() {}

--@ error
