-- A value has no identity to ask about, so `identical` on one is an error
-- that says why the type is a value.

type Point = Point { x : Int, y : Int }

type Meters = Meters(Float)

type Name = Name(String)

type Suit = Hearts | Spades

fun points(p : Point) -> Bool = identical(p, p)

fun meters(m : Meters) -> Bool = identical(m, m)

fun names(n : Name) -> Bool = identical(n, n)

fun suits(s : Suit) -> Bool = identical(s, s)

fun strings(s : String) -> Bool = identical(s, s)

fun pairs(p : (Point, Point)) -> Bool = identical(p, p)

fun main() {}

--@ error
