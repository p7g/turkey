-- Each alternative would hide a different type, so alternatives nested in a
-- pattern may not open an existential.

type Held = Some[Show a](a) | Other[Show a](a)

fun describe(v : (Held, Int)) -> String = match v {
    (Some(x) | Other(x), _) -> show(x)
}

fun main() {
    print(describe((Some(1), 2)))
}

--@ error
