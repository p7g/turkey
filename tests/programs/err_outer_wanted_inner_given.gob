-- An outer wanted that no instance proves is an error even when a local
-- signature's givens would prove it: `show(r)` needs `Show Foo`, and
-- `inner`'s `Show (Elem b)` under `Elem b ~ Foo` is no evidence outside
-- `inner`.

class Box b {
    type Elem b
    fun open(b) -> Elem b
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

type Foo = Foo

fun outer(n : Foo) -> String {
    var r = None
    let s = show(r)
    r = Some(n)
    fun inner[Box b, Elem b ~ Foo, Show (Elem b)](y : b) -> String = show(open(y))
    s
}

fun main() { print(outer(Foo)) }

--@ error
