-- A partial annotation's `a` may not be tied to a type from outside the `fun`
-- (SPEC-DELTAS 67): `cell` would record an equation between a real type and
-- one that has no values yet. Delta 40's example, one annotation short.
fun main() {
    let cell = []
    fun keep(x : a, tag) {
        let _ = tag
        Array.push(cell, x)
    }
    keep(3, "t")
    print(Int.toString(len(cell)))
}
