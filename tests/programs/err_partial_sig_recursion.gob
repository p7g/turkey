-- A partial annotation's variable is not rewritten by the body (SPEC-DELTAS
-- 67): here the recursive call made `a` a `String`, which the header said it
-- was not. Before this delta the annotation was silently narrowed instead.
fun count(xs : a, n) -> Int {
    if n > 0 { count("again", n - 1) } else { 0 }
}

fun main() {
    print(Int.toString(count(1, 2)))
}
