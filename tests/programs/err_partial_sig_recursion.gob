-- A partial annotation's variable is not rewritten by the body: here the
-- recursive call makes `a` a `String`, which the header said it was not. The
-- annotation is a claim, so it is reported rather than silently narrowed.
fun count(xs : a, n) -> Int {
    if n > 0 { count("again", n - 1) } else { 0 }
}

fun main() {
    print(Int.toString(count(1, 2)))
}
