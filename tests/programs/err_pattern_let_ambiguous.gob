-- A name of a pattern `let` is held to the same ambiguity rule as any other
-- inferred type. `amb` is generalized over the `c` that `anything` returns,
-- which only `Cg.G c` mentions, so no use of `amb` could decide it.

class Cg a { type G a; fun mkG(a) -> G a }
class Cf a { type F a; fun mkF(a) -> F a }

instance Cf Int { type F = Bool; fun mkF(n) = n > 0 }
instance Cg Int { type G = Bool; fun mkG(n) = n < 0 }

fun anything(u : Unit) -> a = anything(u)

let (amb, label) = (fun(x) {
    let y = mkF(x)
    let z = mkG(anything(()))
    let w = if True { y } else { z }
    0
}, "amb")

fun main() { print(label) }

--@ error
