-- A pattern `let` that generalizes gives each of its names every class
-- constraint the whole `let` has, so `inc` is constrained by `Eq b`, which
-- its own type does not mention, and no use of it can decide `b`.

let (inc, isZero) = (fun(x) = x + 1, fun(n) = n == 0)

fun main() { print(inc(1)) }

--@ error
