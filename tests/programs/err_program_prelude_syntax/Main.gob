--% error
-- A program's Prelude that passes on only some of the standard one's names
-- leaves out what syntax is written in: `for` and negation call class
-- methods, which have to be in scope bare.
fun total(xs : Vec Int) -> Int {
    var sum = 0
    for x in xs { sum = sum + x }
    sum
}

fun negated(n : Int) -> Int = -n

fun main() {
    print(total(Vec.new()))
}
