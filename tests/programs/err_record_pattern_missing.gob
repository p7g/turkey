-- A record pattern names every field or ends in `..` (SPEC-DELTAS 65), so a
-- field added to the declaration is an error at a site that did not opt out.
type Node = Node { name : String, children : Array Node, weight : Int }

fun size(n : Node) -> Int = match n {
    Node { name, children } -> 1 + len(children)
}

fun main() {
    print(Int.toString(size(Node { name = "root", children = [], weight = 1 })))
}
