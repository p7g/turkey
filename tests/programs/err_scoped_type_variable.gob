-- A local signature that reuses the enclosing function's type variable means
-- that variable, which the caller chooses, so the local cannot be applied at
-- another type.
fun label(x : a) -> String {
    fun twice(y : a) -> Array a = [y, y]
    show(len(twice(x))) + show(len(twice(True)))
}

fun main() {
    print(label(1))
}

