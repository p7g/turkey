-- Reading by key and writing by key are two classes, so a type can be read
-- with `u[i]` and still refuse `u[i] = v`.
type Upto = Upto(Int)

instance Index Upto {
    type Key = Int
    type Value = Int
    fun get(Upto(_), i) = i
}

fun main() {
    let u = Upto(3)
    print(u[1])
    u[1] = 4
}
