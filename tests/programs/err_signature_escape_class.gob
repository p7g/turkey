-- A class constraint over a signature's type variable and a type from outside
-- the function cannot be decided inside it. `boxed` has the shape of `boxes`'s
-- elements, which only `main` decides, so `show(boxed)` needs `Show` of that
-- shape applied to `a`, and `describe`'s context can say nothing about it.

let boxes = Vec.new(4)

fun sameShape(a : f b, c : f d) -> Unit = {}

fun describe[Show a](x : a) -> String {
    let boxed = pure(x)
    sameShape(boxed, boxes[0])
    show(boxed)
}

fun main() {
    print(describe(1))
    Vec.push(boxes, Some("s"))
}

--@ error
