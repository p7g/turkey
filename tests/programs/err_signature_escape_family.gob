-- The same escape as through a record field, through an associated type.
-- `cell`'s element is `Elem w` for a `w` that only `main` decides, so `leak`
-- cannot tell what it is, and its own `a` may not stand in for it.

class Box b {
    type Elem b
}

instance Box (Option a) {
    type Elem = a
}

let wit = Vec.new(4)

fun cellFor[Box w](w : Vec w) -> Vec (Elem w) = Vec.new(4)

let cell = cellFor(wit)

fun leak(x : a) -> Unit {
    Vec.push(cell, x)
}

fun main() {
    leak(1)
    leak("s")
    Vec.push(wit, None)
}

--@ error
