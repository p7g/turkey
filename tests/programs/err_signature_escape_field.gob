-- A signature's type variable may not leave its function through an equation
-- the function cannot decide. `cell` is a top-level value whose element type
-- is not known yet when `leak` is checked, so `cell[0].f` is "the field 'f' of
-- some record from outside". Equating it with `a` would make that outside type
-- depend on whichever `a` each caller picks.

type R t = R { f : t }

fun mk() -> R b = error("never")

let cell = Vec.new(4)

fun leak[Show a](x : a) -> String {
    let y : a = cell[0].f
    show(y)
}

fun main() {
    print(leak(1))
    print(leak("s"))
    if False { Vec.push(cell, mk()) }
}

--@ error
