-- An `Index` belongs to the string it came from. One carried to another string
-- that has a continuation byte there is caught by the decoder, which panics
-- rather than invent a replacement character (TIX-66).

import Data.String as S

fun main() {
    let other = "ab"
    let i = match S.step(other, S.start(other)) {
        Some(p) -> p.1
        None -> S.start(other)
    }
    print(S.decode("é", i))
}
