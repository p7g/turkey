-- 'A s' implies 'Elem s ~ Int' and 'B s' implies 'Elem s ~ Bool', so no type
-- has both, and a function that needs both is refused.

class Bag b { type Elem b; fun el(b) -> Elem b }

class A s : Bag s, Elem s ~ Int { fun aa(s) -> Int }

class B s : Bag s, Elem s ~ Bool { fun bb(s) -> Int }

fun f(x) = aa(x) + bb(x)

fun main() { }

--@ error
