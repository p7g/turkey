-- 'Mon (W a)' needs its superclass 'Sem (W a)', and the context's
-- 'Mon (W a)' has one. But that is the dictionary being built, so the
-- superclass would be the dictionary's own. The context constraint is
-- refused for being no smaller than the head, which rules this out.
class Sem a { fun op(a, a) -> a }
class Mon a : Sem a { fun unit() -> a }

type W a = W(a)

instance Mon (W a) : Mon (W a) { fun unit() = unit() }

fun main() { }

--@ error
