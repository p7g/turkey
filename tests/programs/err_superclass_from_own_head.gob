-- 'Mon (W a)' needs its superclass 'Sem (W a)'. The context's 'Mon (W a)' has
-- one, but it is the dictionary being built: taking the superclass from it
-- would make the superclass the dictionary's own, which no use could ever
-- complete. So a superclass may not come from the superclasses of a context
-- predicate about the head itself.
class Sem a { fun op(a, a) -> a }
class Mon a : Sem a { fun unit() -> a }

type W a = W(a)

instance Mon (W a) : Mon (W a) { fun unit() = unit() }

fun main() { }

--@ error
