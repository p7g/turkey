-- 'A s' implies 'Elem s ~ Int', and the annotation on 'b' says 'Elem s' is
-- 'Bool'. The error is at the annotation, not at the call that needs 'A'.

class Bag b { type Elem b; fun el(b) -> Elem b }

class A s : Bag s, Elem s ~ Int { fun aa(s) -> Int }

fun f(x) = {
    let b : Bool = el(x)
    aa(x)
}

fun main() { }

--@ error
