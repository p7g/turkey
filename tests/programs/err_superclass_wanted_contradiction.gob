-- 'bad' needs 'Bytes a', whose superclass makes 'Key a' an 'Int', and indexes
-- with a 'Float'. The contradiction is reported where 'Bytes a' was needed.

class Bytes s : Index s, Value s ~ Byte, Key s ~ Int {
    fun firstByte(x : s) -> Byte = x[0]
}

fun bad(x, k : Float) = Byte.toInt(firstByte(x)) + Byte.toInt(x[k])

fun main() { }

--@ error
