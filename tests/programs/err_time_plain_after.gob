-- A plain date-time is not on the timeline, so it does not move by elapsed
-- time: across a change to daylight saving time, "three hours later" on the
-- wall clock is two or four hours of real time, depending on the zone. It has
-- no `Timeline` instance, and the mistake is a type error.
import Time (..)
import Time.Date as Date
import Time.Duration (hours)
import Time.Month (Month(..))
import Time.PlainDateTime as PlainDateTime
import Time.TimeOfDay as TimeOfDay

fun main() {
    let d = Option.expect(Date.new(2026, Mar, 8), "date")
    let start = PlainDateTime.new(d, TimeOfDay.midnight)
    print(after(start, hours(3)))
}

--@ error
