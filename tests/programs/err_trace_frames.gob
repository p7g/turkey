-- A panic's trace: a line for each call that is active, a recursive one once
-- per level, and one for a call the optimizer inlined, `hop`'s.

fun check(depth : Int) -> Int {
    if depth == 0 { return error("reached the bottom") }
    check(depth - 1) + 1
}

fun twice(f : fun(Int) -> Int, n : Int) -> Int = f(f(n))

fun hop(n : Int) -> Int = check(n)

fun main() {
    print(twice(fun(n) = hop(n + 1) * 2, 1))
}

--@ panic
