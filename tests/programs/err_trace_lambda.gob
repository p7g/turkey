-- A lambda written in a function that is inlined: its line is named after
-- the function it is written in, and the calls around it are listed once.
-- `applyAll` recurses, so it is not inlined, and the lambda it is given stays
-- a closure with a frame of its own.

fun applyAll(xs : Array Int, i : Int, f : fun(Int) -> Int) -> Int =
	if i == len(xs) { 0 } else { f(xs[i]) + applyAll(xs, i + 1, f) }

fun scale(xs : Array Int) -> Int =
	applyAll(xs, 0, fun(x) = 100 / x)

fun main() {
	print(scale([5, 0, 2]))
}

