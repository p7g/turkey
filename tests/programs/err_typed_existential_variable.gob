-- The type an existential packs is rigid once the pattern opens it: nothing
-- here knows what it is, so its rep could come only from a `Typed` the
-- constructor packed, and `Any` packs none.

import Data.Typed (Proxy(..), TypeRep, typeRep, describe)

type Any = Any[a](a)

fun proxyFor(x : a) -> Proxy a = Proxy

fun repOf(Any(v)) -> TypeRep = typeRep(proxyFor(v))

fun main() {
    print(describe(repOf(Any(1))))
}

--@ error
