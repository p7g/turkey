-- A signature's own type variable is rigid: it stands for a type the
-- function does not know, so its rep has to come from the context, and a
-- signature without `Typed a` cannot ask for it.

import Data.Typed (Proxy(..), TypeRep, typeRep, describe)

type Box a = Box(a)

fun proxyFor(x : a) -> Proxy a = Proxy

fun repOf(x : Box a) -> TypeRep = typeRep(proxyFor(x))

fun main() {
    print(describe(repOf(Box(1))))
}

--@ error
