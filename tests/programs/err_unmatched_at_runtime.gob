-- A non-exhaustive match is a compile error, so reaching an unhandled arm at
-- run time is not possible from source. This program pins the stronger form
-- of that guarantee: a `match` missing a constructor does not compile, and so
-- there is no panic for an unmatched value for any program to reach. The name
-- says what the check exists to prevent.
type Color = Red | Green | Blue

fun describe(c : Color) -> String = match c {
    Red -> "red"
    Green -> "green"
}

fun main() { print(describe(Blue)) }
