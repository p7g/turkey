-- A `!` on a `Left` panics with the error's message, at the `!`.

type Missing = Missing(String)

instance Error Missing {
    fun message(m) = match m { Missing(key) -> "no entry for '" + key + "'" }
}

fun lookup(key : String) -> Either Missing Int =
    if key == "a" { Right(1) } else { Left(Missing(key)) }

fun main() {
    print(lookup("a")!)
    let total = lookup("a")!
        + lookup("b")!
    print(total)
}

--% panic
