-- A `!` on an `Either SomeError a` panics with the whole chain, at the `!`.

type Missing = Missing { key : String }
type Loading = Loading { file : String }

instance Error Missing { fun message(e) = "no entry for '" + e.key + "'" }
instance Error Loading { fun message(e) = "while loading " + e.file }

fun setting(key : String) -> Either SomeError Int =
    Left(Error.context(fail(Missing { key }), Loading { file = "settings" }))

fun main() {
    print("starting")
    print(setting("width")!)
}

--% panic
