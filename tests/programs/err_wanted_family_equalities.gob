-- Two wanted equalities about one family application interact: `b`'s
-- annotation makes `G a` be `Bool`, so `F (G a)` is `F Bool`, which is
-- `Char`, and `i` cannot be an `Int`.
class Cg a { type G a; fun mkG(a) -> G a }
class Cf a { type F a; fun mkF(a) -> F a }
instance Cf Bool { type F = Char; fun mkF(b) = 'c' }

fun weird(x) {
    let g = mkG(x)
    let b : Bool = g
    let i : Int = mkF(g)
    i
}

fun main() { }

--@ error
