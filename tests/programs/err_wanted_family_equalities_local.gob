-- Wanted equalities interact inside an implication too: here inside
-- `host`'s signature, in a local function that is generalized there.
class Cg a { type G a; fun mkG(a) -> G a }
class Cf a { type F a; fun mkF(a) -> F a }
instance Cf Bool { type F = Char; fun mkF(b) = 'c' }

fun host[Show a](x : a) -> String {
    let h = fun(y) {
        let g = mkG(y)
        let b : Bool = g
        let i : Int = mkF(g)
        i
    }
    show(x)
}

fun main() { print(host(1)) }

--@ error
