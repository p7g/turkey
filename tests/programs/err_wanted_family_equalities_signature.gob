-- Wanted equalities interact under a signature's givens: `G a` over the
-- skolem `a` is stuck, and `b`'s annotation still decides it for `i`.
class Cg a { type G a; fun mkG(a) -> G a }
class Cf a { type F a; fun mkF(a) -> F a }
instance Cf Bool { type F = Char; fun mkF(b) = 'c' }

fun weird[Cg a](x : a) -> Int {
    let g = mkG(x)
    let b : Bool = g
    let i : Int = mkF(g)
    i
}

fun main() { }

--@ error
