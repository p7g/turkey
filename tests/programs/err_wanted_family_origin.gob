-- A contradiction between wanted equalities is reported where the equation
-- that cannot hold arose. `h = g` makes `F a` be `a`, and `i`'s annotation
-- then makes `a` be `Int`, so the assignment needs `F Int`, which is
-- `Bool`, to be `Int`.
class Cf a { type F a; fun mkF(a) -> F a }
instance Cf Int { type F = Bool; fun mkF(n) = True }
fun anything(u : Unit) -> a = error("never")
fun r() -> Int {
    let g = anything(())
    var h = mkF(g)
    h = g
    let i : Int = mkF(g)
    i
}
fun main() { }

--@ error
