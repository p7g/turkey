-- A function's result is checked where its body is: `weird`'s result is
-- `F (G a)`, its context makes `G a` be `Bool`, and `F Bool` is `Char`, so
-- `use`'s body is a `Char` where an `Int` was declared.
class Cg a { type G a; fun mkG(a) -> G a }
class Cf a { type F a; fun mkF(a) -> F a }
instance Cf Bool { type F = Char; fun mkF(b) = 'c' }
fun weird(x) {
    let g = mkG(x)
    let h = mkF(g)
    let b : Bool = g
    h
}
fun use() -> Int = weird(1)
fun main() { }

--@ error
