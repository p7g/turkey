-- `fail` returns a `SomeError` it is given unchanged, and `context` with a
-- `SomeError` as its value appends to that chain, so no payload is ever a
-- `SomeError` and `cast` still finds what was packed.

type Missing = Missing { key : String }
type Loading = Loading { file : String }
type Startup = Startup

instance Error Missing { fun message(e) = "no entry for '" + e.key + "'" }
instance Error Loading { fun message(e) = "while loading " + e.file }
instance Error Startup { fun message(e) = "at startup" }

fun keyOf(err : SomeError) -> String = match Error.cast(err) {
    Some(Missing { key }) -> key
    None -> "not a Missing"
}

fun main() {
    let once = fail(Missing { key = "width" })
    let twice = fail(once)
    print(keyOf(twice))
    print(Error.describe(twice) == Error.describe(once))
    print(Error.describe(twice))

    -- `promote` of a result already in the channel is the same result.
    let result : Either SomeError Int = Left(once)
    match Error.promote(result) {
        Left(err) -> print(keyOf(err))
        Right(_) -> print("unreachable")
    }

    -- A chain used as context goes above the inner one, whole.
    let loading = Error.context(once, Loading { file = "settings" })
    let outer = Error.context(fail(Startup), loading)
    print(Error.describe(outer))
    print(keyOf(outer))
    print(keyOf(Option.expect(Error.causeOf(outer), "a cause")))
}
