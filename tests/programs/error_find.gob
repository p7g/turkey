-- `Error.find` looks along the cause chain, outermost first, for the first
-- payload of the type asked for: `cast` answers for the outermost error only.

type Missing = Missing { path : String }
type Loading = Loading { what : String }

instance Error Missing { fun message(e) = "missing " + e.path }
instance Error Loading { fun message(e) = "loading " + e.what }

fun open(path : String) -> Either SomeError String =
	if path == "" { throw(Missing { path = "<empty>" }) } else { Right(path) }

fun load(what : String, path : String) -> Either SomeError String =
	match open(path) {
		Right(text) -> Right(text)
		Left(e)     -> Left(Error.context(e, Loading { what }))
	}

fun report(e : SomeError) {
	match Error.cast(e) : Option Missing {
		Some(_) -> print("outermost is Missing")
		None    -> print("outermost is not Missing")
	}
	match Error.find(e) : Option Missing {
		Some(Missing { path }) -> print("found Missing " + path)
		None                   -> print("no Missing")
	}
}

fun main() {
	-- The payload asked for is the outermost error.
	let Left(bare) = open("") else { return }
	report(bare)

	-- It is one cause down, under the context.
	let Left(wrapped) = load("config", "") else { return }
	print(wrapped)
	-- Inside another value, an error shows its whole chain as a string.
	print(debug(wrapped))
	print(load("config", ""))
	report(wrapped)

	-- Nothing in the chain has the type, so the whole chain is looked at.
	let outer = Error.context(fail(Loading { what = "a" }), Loading { what = "b" })
	report(outer)

	-- The outermost of two matching payloads wins.
	match Error.find(outer) : Option Loading {
		Some(Loading { what }) -> print(what)
		None                   -> print("no Loading")
	}
}
