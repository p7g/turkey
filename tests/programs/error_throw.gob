-- `throw(e)` is `Left(fail(e))`. It fails a result of any success type, so
-- one source can throw from a function returning `Int` and another from one
-- returning `String`, and `?` carries both without converting.

type Empty = Empty
type TooLong = TooLong { limit : Int }

instance Error Empty { fun message(_) = "empty" }
instance Error TooLong {
	fun message(e) = "longer than " + Int.toString(e.limit)
}

fun name(text : String) -> Either SomeError String =
	if text == "" { throw(Empty) } else { Right(text) }

fun width(text : String) -> Either SomeError Int {
	let n = String.byteLength(name(text)?)
	if n > 5 { return throw(TooLong { limit = 5 }) }
	Right(n)
}

fun main() {
	for text in ["turkey", "", "hen"] {
		match width(text) {
			Right(n) -> print(n)
			Left(e)  -> print(e)
		}
	}

	-- The thrown value is packed exactly as `fail` packs it.
	match width("vulture") {
		Right(_) -> print("unreachable")
		Left(e) -> {
			match Error.cast(e) {
				Some(TooLong { limit }) -> print(limit)
				None                    -> print("not TooLong")
			}
			print(Option.isNone(Error.causeOf(e)))
		}
	}
}
