-- A class with equality superclasses, three class superclasses and four
-- defaults, two instances that each override a different default, behind one
-- existential.

class Named s { fun name(s) -> String }
class Bytes s : Index s, Key s ~ Int, Length s, Value s ~ Byte, Named s {
    fun a(x : s) -> Int = Byte.toInt(x[0])
    fun b(x : s) -> Int = len(x)
    fun each(x : s, f : fun(Byte) -> r) -> Array r {
        let out = Vec.new(len(x))
        for i in Int.range(0, len(x)) { Vec.push(out, f(x[i])) }
        Vec.toArray(out)
    }
    fun z(x : s) -> String = name(x) + "!"
}

type Packet = Packet(Array Byte)
instance Index Packet { type Key = Int; type Value = Byte; fun get(Packet(b), i) = b[i] }
instance Length Packet { fun len(Packet(b)) = len(b) }
instance Named Packet { fun name(_) = "packet" }
instance Bytes Packet { fun b(x) = 100 + len(x) }

type Two = Two(Byte, Byte)
instance Index Two { type Key = Int; type Value = Byte; fun get(Two(p, q), i) = if i == 0 { p } else { q } }
instance Length Two { fun len(_) = 2 }
instance Named Two { fun name(_) = "two" }
instance Bytes Two { fun z(_) = "zz" }

type Any = Any[Bytes s](s)

fun show(Any(x)) -> String {
    let parts = each(x, fun(v) = Int.toString(Byte.toInt(v)))
    let flags = each(x, fun(v) = Byte.toInt(v) > 1)
    name(x) + " " + Int.toString(a(x)) + " " + Int.toString(b(x)) + " " + z(x)
        + " " + String.join(parts, ",") + " " + Int.toString(len(flags)) + " " + Int.toString(x[1] |> Byte.toInt)
}

fun main() {
    let xs = [Any(Packet(Array.map([3, 4, 5], Byte.truncate))), Any(Two(Byte.truncate(1), Byte.truncate(2)))]
    for x in xs { print(show(x)) }
}
