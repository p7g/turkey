-- Two inlined copies of one arm that opens an existential, one pushed inside
-- the other by case-of-case: the outer `match` on `pick(x, b)`'s result moves
-- into the arm `pick` opens, and its alternatives hold the second call's copy
-- of that same arm. Each copy must open a constant and bind a dictionary of
-- its own, or the inner arm's `String` would be read as the outer's `Int`.

type Shown = Shown[Show a](a)

fun pick(s : Shown, b : Bool) -> Option String = match s {
    Shown(w) -> if b { Some(show(w)) } else { None }
}

fun f(x : Shown, y : Shown, b : Bool) -> String = match pick(x, b) {
    Some(t) -> match pick(y, b) {
        Some(u) -> t + u
        None -> t
    }
    None -> "none"
}

fun main() {
    print(f(Shown(42), Shown("x"), True))
    print(f(Shown(42), Shown("x"), False))
}
