-- Two inlined copies of one arm that opens an existential, one pushed inside
-- the other by case-of-case: the outer `match` on `pick(x, b)`'s result moves
-- into the arm `pick` opens, and its alternatives hold the second call's copy
-- of that same arm. `t` is a closure that shows the outer arm's value with
-- the outer arm's `Show` dictionary, and it is called inside the inner arm,
-- which binds a dictionary of the same class. Each copy must open a constant
-- and bind a dictionary of its own, or `t` would show an `Int` as a `String`.

type Shown = Shown[Show a](a)

fun pick(s : Shown, b : Bool) -> Option (fun() -> String) = match s {
    Shown(w) -> if b { Some(fun() = show(w)) } else { None }
}

fun f(x : Shown, y : Shown, b : Bool) -> String = match pick(x, b) {
    Some(t) -> match pick(y, b) {
        Some(u) -> u() + t()
        None -> t()
    }
    None -> "none"
}

fun main() {
    print(f(Shown(42), Shown("x"), True))
    print(f(Shown(42), Shown("x"), False))
}
