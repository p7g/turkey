-- A default method over a higher-kinded variable applied to the class
-- variable, `m s`, called through an existential at two type constructors.
-- `m Packet` takes its layout from the call's key like any other atom.

type Two a = Two(a, a, Int)

class Wrap s {
    fun one(s) -> Int
    fun keep(x : s, c : m s) -> Array (m s) {
        let out = []
        Vec.push(out, c)
        Vec.push(out, c)
        Vec.toArray(out)
    }
}

type Packet = Packet(Int)
instance Wrap Packet { fun one(Packet(n)) = n }

type Any = Any[Wrap s](s)

fun go(Any(x)) {
    for Two(p, q, k) in keep(x, Two(x, x, 7)) { print(one(p) + one(q) + k * 1000) }
    for o in keep(x, Some(x)) { if let Some(p) = o { print(one(p) * 10) } }
}

fun main() {
    go(Any(Packet(2)))
    for Two(p, q, k) in keep(Packet(2), Two(Packet(1), Packet(3), 7)) { print(one(p) + one(q) + k * 1000) }
}
