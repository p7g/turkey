-- A polymorphic default method of a class with equality superclasses, after a
-- class superclass and before one, called through an existential.

class Bytes s : Index s, Key s ~ Int, Value s ~ Byte {
    fun each(x : s, f : fun(Byte) -> r) -> Array r {
        let out = []
        Vec.push(out, f(x[0]))
        Vec.toArray(out)
    }
}

class Leading s : Key s ~ Int, Value s ~ Byte, Index s {
    fun first(x : s, f : fun(Byte) -> r) -> Array r {
        let out = []
        Vec.push(out, f(x[0]))
        Vec.toArray(out)
    }
}

type Packet = Packet(Array Byte)
instance Index Packet { type Key = Int; type Value = Byte; fun get(Packet(b), i) = b[i] }
instance Bytes Packet {}
instance Leading Packet {}

type Any = Any[Bytes s](s)
type Led = Led[Leading s](s)

fun viaBytes(Any(x)) -> (Array Int, Array String) =
    (each(x, Byte.toInt), each(x, fun(v) = Int.toString(Byte.toInt(v))))

fun viaLeading(Led(x)) -> (Array Int, Array String) =
    (first(x, Byte.toInt), first(x, fun(v) = Int.toString(Byte.toInt(v))))

fun main() {
    let bytes = Packet([Byte.truncate(3)])
    print(viaBytes(Any(bytes)))
    print(viaLeading(Led(bytes)))
}
