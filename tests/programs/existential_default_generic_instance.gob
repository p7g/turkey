-- A default method polymorphic in its own variable, in the dictionary of an
-- instance with a type parameter of its own, called through an existential at
-- three result layouts.

class Wrap s {
    fun one(s) -> Int
    fun each(x : s, f : fun(Int) -> r) -> Array r {
        let out = []
        Vec.push(out, f(one(x)))
        Vec.push(out, f(one(x) + 1))
        Vec.toArray(out)
    }
}

type Packet t = Packet(Int, t)
instance Wrap (Packet t) { fun one(Packet(n, _)) = n }

type Any = Any[Wrap s](s)

fun texts(Any(x)) -> Array String = each(x, Int.toString)
fun doubled(Any(x)) -> Array Int = each(x, fun(n) = n * 2)
fun halves(Any(x)) -> Array Float = each(x, fun(n) = Float.fromInt(n) / 2.0)

fun main() {
    let x = Any(Packet(3, "t"))
    print(texts(x))
    print(doubled(x))
    print(halves(x))
}
