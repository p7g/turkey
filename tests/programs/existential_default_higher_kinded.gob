-- A default method whose only own variable is higher-kinded, called through an
-- existential at two functors. Each application of the variable, `m Int` and
-- `m String`, has a layout of its own, so the slot is compiled once per pair.

class Wrap s {
    fun one(s) -> Int
    fun lifted[Functor m](x : s, c : m Int) -> m String =
        map(c, fun(n) = Int.toString(n + one(x)))
}

type Packet = Packet(Int)
instance Wrap Packet { fun one(Packet(n)) = n }

type Any = Any[Wrap s](s)

fun go(Any(x)) {
    print(lifted(x, Some(5)))
    print(lifted(x, [1, 2]))
}

fun main() { go(Any(Packet(2))) }
