-- A default method over a higher-kinded variable with no context, which
-- stores its applications in a `Vec`, called through an existential at two
-- type constructors.

class Wrap s {
    fun one(s) -> Int
    fun boxed(x : s, wrap : fun(Int) -> m Int) -> Array (m Int) {
        let out = []
        Vec.push(out, wrap(one(x)))
        Vec.toArray(out)
    }
}

type Packet = Packet(Int)
instance Wrap Packet { fun one(Packet(n)) = n }

type Any = Any[Wrap s](s)

fun go(Any(x)) {
    print(boxed(x, Some))
    print(boxed(x, fun(n) = [n, n]))
}

fun main() { go(Any(Packet(2))) }
