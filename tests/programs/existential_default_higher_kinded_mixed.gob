-- A default method with a higher-kinded own variable and one of kind `*`,
-- called through an existential at two functors and two element types.

class Wrap s {
    fun one(s) -> Int
    fun lifted[Functor m](x : s, c : m r, f : fun(r) -> Int) -> m Int =
        map(c, fun(v) = f(v) + one(x))
}

type Packet = Packet(Int)
instance Wrap Packet { fun one(Packet(n)) = n }

type Any = Any[Wrap s](s)

fun go(Any(x)) {
    print(lifted(x, Some("abc"), String.byteLength))
    print(lifted(x, [1.5, 2.5], fun(f) = Option.unwrapOr(Float.truncate(f), 0)))
}

fun main() { go(Any(Packet(2))) }
