-- A default method polymorphic in its own variable, called through the
-- dictionary an existential carries, at three result layouts.
--
-- The call cannot see which instance it reaches, so it reads the slot compiled
-- for its layout: a pointer, a word and a float. The body stores each result in
-- a `Vec`, which is where a copy compiled at the wrong layout goes wrong.

class Wrap s {
    fun one(s) -> Int
    fun each(x : s, f : fun(Int) -> r) -> Array r {
        let out = []
        Vec.push(out, f(one(x)))
        Vec.push(out, f(one(x) + 1))
        Vec.toArray(out)
    }
}

type Packet = Packet(Int)
instance Wrap Packet { fun one(Packet(n)) = n }

type Any = Any[Wrap s](s)

fun texts(Any(x)) -> Array String = each(x, Int.toString)
fun doubled(Any(x)) -> Array Int = each(x, fun(n) = n * 2)
fun halves(Any(x)) -> Array Float = each(x, fun(n) = Float.fromInt(n) / 2.0)

fun main() {
    let x = Any(Packet(3))
    print(texts(x))
    print(doubled(x))
    print(halves(x))
}
