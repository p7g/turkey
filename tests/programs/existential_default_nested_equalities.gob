-- A polymorphic default method of a class whose equalities come from its
-- superclass's superclasses, called through an existential.

class Inner s : Index s, Key s ~ Int, Value s ~ Byte {}
class Outer s : Inner s {
    fun each(x : s, f : fun(Byte) -> r) -> Array r {
        let out = []
        Vec.push(out, f(x[0]))
        Vec.toArray(out)
    }
}

type Packet = Packet(Array Byte)
instance Index Packet { type Key = Int; type Value = Byte; fun get(Packet(b), i) = b[i] }
instance Inner Packet {}
instance Outer Packet {}

type Any = Any[Outer s](s)

fun use(Any(x)) -> (Array Int, Array String) =
    (each(x, Byte.toInt), each(x, fun(v) = Int.toString(Byte.toInt(v))))

fun main() {
    print(use(Any(Packet([Byte.truncate(3)]))))
}
