-- Two instances behind two existentials, one keeping a polymorphic default
-- and one overriding it. Each call reads the slot for its own result layout,
-- whichever instance's dictionary it reaches.

class Wrap s {
    fun one(s) -> Int
    fun each(x : s, f : fun(Int) -> r) -> Array r {
        let out = []
        Vec.push(out, f(one(x)))
        Vec.toArray(out)
    }
}

type Packet = Packet(Int)
instance Wrap Packet { fun one(Packet(n)) = n }

type Pair = Pair(Int, Int)
instance Wrap Pair {
    fun one(Pair(a, b)) = a + b
    fun each(x, f) = [f(one(x)), f(0)]
}

type Any = Any[Wrap s](s)
type Also = Also[Wrap s](s)

fun texts(Any(x)) -> Array String = each(x, Int.toString)
fun floats(Also(x)) -> Array Float = each(x, Float.fromInt)

fun main() {
    for v in [Any(Packet(3)), Any(Pair(1, 2))] { print(texts(v)) }
    for v in [Also(Packet(3)), Also(Pair(1, 2))] { print(floats(v)) }
}
