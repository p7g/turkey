-- A default method with a context of its own, called through an existential
-- at two types for its own variable.

class Wrap s {
    fun one(s) -> Int
    fun both[Show r](x : s, f : fun(Int) -> r) -> (r, String) {
        let y = f(one(x))
        (y, show(y))
    }
}

type Packet = Packet(Int)
instance Wrap Packet { fun one(Packet(n)) = n }

type Any = Any[Wrap s](s)

fun describe(Any(x)) -> String {
    let (n, shown) = both(x, fun(i) = i + 1)
    let (text, again) = both(x, Int.toString)
    Int.toString(n) + " " + shown + " " + text + " " + again
}

fun main() {
    print(describe(Any(Packet(3))))
}
