-- Packed values whose hidden type is held in several slots: a tuple, an
-- `Option`. Each packing records which slots it stored, and an opening has a
-- copy for each combination the program packs.
--
-- `paired` packs inside an opening, at a type twice as wide as the one it
-- opened, so each copy of its arm packs at a wider type than the copy was made
-- for. The widening stops when the type no longer fits in a few slots and is
-- held behind a pointer, which is one slot again.

type Shown = Shown[Debug a](a)

fun describe(Shown(x)) -> String = debug(x)

fun paired(s : Shown) -> Shown = match s {
    Shown(x) -> Shown((x, x))
}

fun main() {
    let items = [Shown((1, 2)), Shown(Some(3)), Shown((1.5, 'c', True)), Shown(7)]
    for item in items {
        print(describe(item))
    }
    var s = Shown(4)
    for _ in Int.range(0, 4) {
        s = paired(s)
        print(describe(s))
    }
}
