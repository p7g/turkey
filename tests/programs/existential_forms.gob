-- The record form of an existential constructor, openings nested inside a
-- larger pattern, and a constructor used as a function value (SPEC-DELTAS 68).

type Counter = Counter[s] { state : s, step : fun(s) -> s, read : fun(s) -> Int }

type Some = Some[Show a](a)

fun run(c : Counter) -> Int = match c {
    Counter { state, step, read } -> read(step(step(state)))
}

fun both(pair : (Some, Some)) -> String = match pair {
    -- Two openings in one arm, each hiding its own type.
    (Some(x), Some(y)) -> show(x) + " " + show(y)
}

fun say(Some(x)) -> String = show(x)

fun main() {
    print(Int.toString(run(Counter {
        state = 0,
        step = fun(n : Int) -> Int = n + 1,
        read = fun(n : Int) -> Int = n,
    })))
    print(Int.toString(run(Counter {
        read = String.byteLength,
        state = "a",
        step = fun(s : String) -> String = s + "b",
    })))
    print(both((Some(1), Some("two"))))
    -- Named rather than applied: the constructor is a function, and every value
    -- it builds carries the dictionary this use was elaborated with.
    for s in Array.map([1, 2], Some) {
        print(say(s))
    }
}
