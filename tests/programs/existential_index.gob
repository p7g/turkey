-- One existential packed at payloads with no traced slot, one, and two. An
-- opening reads which key a value was packed at before it knows the key, so
-- the word it reads must be at the same place in every packing: a value of
-- one key read as another would show an `Int` as a `String`, or follow the
-- `None` in `cause` as a pointer.

type Code = Code { n : Int }
type Named = Named { s : String }

type Any = Any[Show a] { payload : a, cause : Option Any }

instance Show Code { fun show(c) = "Code " + Int.toString(c.n) }
instance Show Named { fun show(c) = "Named " + c.s }

fun pack[Show a](x : a) -> Any = Any { payload = x, cause = None }

fun look(v : Any) -> String = match v {
    Any { payload, cause = _ } -> show(payload)
}

fun main() {
    let xs = [pack(3), pack("str"), pack(2.5), pack(Code { n = 4 }), pack(Named { s = "x" }),
              pack((1, "a")), pack(True), Any { payload = 0, cause = Some(pack("inner")) }]
    for x in xs { print(look(x)) }
}
