-- An arm that opens an existential, inlined inside a copy of itself: the
-- continuation `k` holds a second call of `describe`, so once both calls are
-- inlined and `k` is applied, one copy of the arm sits inside the other. Each
-- copy opens its own rigid constant and binds its own `Show` dictionary, and
-- the outer arm's `show(v)` after the call must still show an `Int`.

type Shown = Shown[Show a](a)

fun describe(s : Shown, k : fun(String) -> Option String) -> Option String = match s {
    Shown(v) -> match k(show(v)) {
        Some(t) -> Some(t + "/" + show(v))
        None -> None
    }
}

fun main() {
    print(describe(Shown(42), fun(a) = describe(Shown("x"), fun(b) = Some(a + b))))
}
