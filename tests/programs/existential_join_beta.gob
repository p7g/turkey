-- Two inlined copies of one arm that opens an existential, one moved inside
-- the other when a join with one jump is beta-reduced: the loop's early
-- `return` in `first` leaves a join, its one jump sits in the arm the first
-- call opens, and the join's body holds the second call's copy of that arm.
-- Every reference that ends up under the inner copy is to the inner copy's
-- own dictionary; `existential_case_of_case` and `existential_question_nested`
-- carry the outer one there.

type Shown = Shown[Show a](a)

fun first(xs : Array String, s : Shown) -> Option String = match s {
    Shown(v) -> {
        for x in xs {
            if x == show(v) { return Some(x + "=" + show(v)) }
        }
        None
    }
}

fun g(s : Shown, t : Shown, xs : Array String) -> String = match first(xs, s) {
    Some(a) -> match first(xs, t) {
        Some(b) -> a + "," + b
        None -> a
    }
    None -> "none"
}

fun main() {
    print(g(Shown(42), Shown("x"), ["x", "42"]))
    print(g(Shown(42), Shown("y"), ["x", "42"]))
    print(g(Shown(7), Shown("x"), ["x", "42"]))
}
