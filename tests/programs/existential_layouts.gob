-- One opening, every payload layout (SPEC-DELTAS 68).
--
-- `Byte` is one byte wide and `Char` is four, so an arm compiled at the wrong
-- layout reads the wrong *number* of bytes rather than the right word under the
-- wrong name -- which is what made a missing dispatch visible at all
-- (FINDINGS 87).

type Packed = Packed[a](Array a, fun(a) -> String)

fun visit(Packed(xs, f)) -> Unit {
    print(f(xs[0]))
    print(Int.toString(len(xs)))
    let first = xs[0]
    xs[0] = xs[1]
    xs[1] = first
    print(f(xs[0]))
}

fun intText(n : Int) -> String = Int.toString(n)

fun boolText(b : Bool) -> String = if b { "true" } else { "false" }

fun floatText(x : Float) -> String = Float.toString(x)

fun byteText(b : Byte) -> String = Int.toString(Byte.toInt(b))

fun charText(c : Char) -> String = Char.toString(c)

fun main() {
    visit(Packed([1, 2, 3], intText))
    visit(Packed([True, False], boolText))
    visit(Packed([1.5, 2.5], floatText))
    visit(Packed(["x", "y"], fun(s : String) -> String = s))
    visit(Packed([Byte.truncate(7), Byte.truncate(200)], byteText))
    visit(Packed(['p', 'q'], charText))
}
