-- A loop whose `?` steps through a callee that opens an existential: the
-- loop's result is matched at its exits, which sit inside the arms each
-- inlined copy of `pickQ` opens, and the code after the loop opens a copy of
-- the same arm again.

type Shown = Shown[Show a](a)

fun pickQ(s : Shown) -> Option String = match s {
    Shown(w) -> if show(w) == "" { None } else { Some(show(w)) }
}

fun joined(xs : Array Shown, last : Shown) -> Option String {
    var acc = ""
    for var i = 0; i < len(xs); i = i + 1 {
        acc = acc + pickQ(xs[i])?
    }
    Some(acc + pickQ(last)?)
}

fun main() {
    print(joined([Shown(1), Shown("a")], Shown(2.5)))
    print(joined([Shown(1), Shown("")], Shown(2.5)))
    print(joined([Shown(1)], Shown("")))
}
