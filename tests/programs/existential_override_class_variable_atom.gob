-- An overriding method over a higher-kinded variable applied to the class
-- variable, `m s`, called through an existential.

type Two a = Two(a, a, Int)

class Wrap s {
    fun one(s) -> Int
    fun keep(s, m s) -> Array (m s)
}

type Packet = Packet(Int)
instance Wrap Packet {
    fun one(Packet(n)) = n
    fun keep(_, c) {
        let out = []
        Vec.push(out, c)
        Vec.push(out, c)
        Vec.toArray(out)
    }
}

type Any = Any[Wrap s](s)

fun go(Any(x)) {
    for Two(p, q, k) in keep(x, Two(x, x, 7)) { print(one(p) + one(q) + k * 1000) }
}

fun main() { go(Any(Packet(2))) }
