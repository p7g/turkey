-- An overriding method whose only own variable is higher-kinded, called
-- through an existential at two functors.

class Wrap s {
    fun one(s) -> Int
    fun lifted[Functor m](s, m Int) -> m String
}

type Packet = Packet(Int)
instance Wrap Packet {
    fun one(Packet(n)) = n
    fun lifted(x, c) = map(c, fun(n) = Int.toString(n + one(x)))
}

type Any = Any[Wrap s](s)

fun go(Any(x)) {
    print(lifted(x, Some(5)))
    print(lifted(x, [1, 2]))
}

fun main() { go(Any(Packet(2))) }
