-- Two inlined copies of one arm that opens an existential, nested through the
-- continuation of a `?`: `k` holds a second call of `step`, so the inner copy
-- of the arm lands where the outer arm's `?` continues, and the outer arm's
-- `show(v)` after the `?` must still use the outer arm's `Show` dictionary.

type Shown = Shown[Show a](a)

fun step(s : Shown, k : fun(String) -> Option String) -> Option String = match s {
    Shown(v) -> {
        let t = k(show(v))?
        Some(t + "/" + show(v))
    }
}

fun main() {
    print(step(Shown(42), fun(a) = step(Shown("x"), fun(b) = Some(a + b))))
    print(step(Shown(42), fun(a) = step(Shown("x"), fun(b) = None)))
}
