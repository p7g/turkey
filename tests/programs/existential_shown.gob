-- Existential constructors (SPEC-DELTAS 68): a value that hides its payload's
-- type and carries the instance that makes it printable.
--
-- The three packings hide three different types, and one `describe` takes all
-- of them apart. What it calls is the `Show` the *packing* chose, at the layout
-- the packing stored -- `i64`, `ptr` and `i1` here -- which is the whole of the
-- representation contract in ERRORS.md.

type Shown = Shown[Show a](Array a)

fun describe(Shown(xs)) -> String = show(xs[0]) + " of " + Int.toString(len(xs))

fun main() {
    let items = [Shown([1, 2, 3]), Shown(["x", "y"]), Shown([True])]
    for item in items {
        print(describe(item))
    }
    -- Opened twice, and the second opening sees the first one's write: nothing
    -- is converted at the boundary, so the array is the array that was packed.
    let shared = [10, 20]
    let packed = Shown(shared)
    -- A literal cannot be written into it: the element type is whatever was
    -- packed, and nothing outside knows what that is. Moving what is already
    -- there is what parametricity leaves.
    match packed {
        Shown(xs) -> {
            let first = xs[0]
            xs[0] = xs[1]
            xs[1] = first
        }
    }
    print(describe(packed))
    print(Int.toString(shared[0]))
}
