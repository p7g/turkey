-- `existential_inlined_nested`, with an existential that carries no
-- dictionary: what keeps the two nested copies of the arm apart is only that
-- each opens a rigid constant of its own, which the backend gives the layout
-- of the value packed there, `Int` outside and `String` inside.

type Packed = Packed[a](a, fun(a) -> String)

fun open(p : Packed, k : fun(String) -> Option String) -> Option String = match p {
    Packed(v, f) -> match k(f(v)) {
        Some(t) -> Some(t + "/" + f(v))
        None -> None
    }
}

fun main() {
    print(open(Packed(42, Int.toString), fun(a) = open(Packed("x", fun(s) = s + "!"),
                                                       fun(b) = Some(a + b))))
}
