-- The same through an index and a local function: `ws[0].inner` is
-- `Field.inner (Index.Value (Array (Wrapped r)))`, which the declarations
-- reduce to `r` at every depth before `Err` of it is compared.

class Source r {
    type Err r
    fun pull(r) -> Either (Err r) Int
}

type Wrapped r = Wrapped { inner : r }

instance Source Int {
    type Err = String
    fun pull(n) = Right(n)
}

fun viaInner[Source r](w : Wrapped r) -> Either (Err r) Int {
    let ws = [w]
    pull(ws[0].inner)
}

fun viaLambda[Source r](w : Wrapped r) -> Either (Err r) Int {
    let get = fun(v) = pull(v.inner)
    get(w)
}

fun main() {
    print(viaInner(Wrapped { inner = 4 }))
    print(viaLambda(Wrapped { inner = 5 }))
}
