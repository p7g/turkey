-- A field read through a local function's parameter has the type
-- `Field.inner (Wrapped r)` once the function is applied, and that is `r` by
-- the declaration, before `Err` of it is compared with `Err r`.

class Source r {
    type Err r
    fun pull(r) -> Either (Err r) Int
}

type Wrapped r = Wrapped { inner : r }

instance Source (Wrapped r) : Source r {
    type Err = Err r
    fun pull(w) {
        let get = fun(v) = pull(v.inner)
        get(w)
    }
}

instance Source Int {
    type Err = String
    fun pull(n) = Right(n)
}

fun main() { print(pull(Wrapped { inner = 4 })) }
