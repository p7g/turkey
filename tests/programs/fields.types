get : [HasField "n" a] fun(a) -> Field.n a
bump : [OneOf (Field.n a) {Int, Float}, HasField "n" a, Add (Field.n a)] fun(a) -> Unit
before : [Index.Value a ~ Int, OneOf (Index.Key a) {Int, Float}, Length a, Index a] fun(a) -> Int
after : [Index.Value a ~ Int, OneOf (Index.Key a) {Int, Float}, Index a, Length a] fun(a) -> Int
main : fun() -> Unit
