-- A `match` whose scrutinee is a `let`, where the arms bind a name spelled
-- like the `let`'s own: as a pattern variable in `same`, and as a `let` in
-- `armLet`. Moving the `let` out from around the scrutinee puts the
-- constructor in front of the `match`, which then selects its arm, and that
-- is the same rewrite whatever the arms' binders are spelled. The `.opt`
-- golden shows `same` and `armLet` reduced as far as `differ`, with no `P`
-- built.

type P = P(Int, Int)

fun g(a : Int) -> Int = a * a + 1

fun differ(a : Int) -> Int = match { let t = g(a); P(t, a) } { P(x, y) -> x + y }

fun same(a : Int) -> Int = match { let x = g(a); P(x, a) } { P(x, y) -> x + y }

fun armLet(a : Int) -> Int = match { let value = g(a); P(value, a) } {
    P(x, y) -> {
        let value = x * 2
        value + y
    }
}

fun main() {
    print(differ(3))
    print(same(3))
    print(armLet(3))
}
