-- bindings
Main#g : fun(Int) -> Int =
  fun(a : Int) {
    let x : Int =
      Prim.intMul(a, a)
    Prim.intAdd(x, 1)
  }

Main#differ : fun(Int) -> Int =
  fun(a : Int) {
    let t : Int =
      let x : Int =
        Prim.intMul(a, a)
      Prim.intAdd(x, 1)
    Prim.intAdd(t, a)
  }

Main#same : fun(Int) -> Int =
  fun(a : Int) {
    let x%1 : Int =
      let x%2 : Int =
        Prim.intMul(a, a)
      Prim.intAdd(x%2, 1)
    Prim.intAdd(x%1, a)
  }

Main#armLet : fun(Int) -> Int =
  fun(a : Int) {
    let value%1 : Int =
      let x : Int =
        Prim.intMul(a, a)
      Prim.intAdd(x, 1)
    let value%2 : Int =
      Prim.intMul(value%1, 2)
    Prim.intAdd(value%2, a)
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq%1 : Unit =
      Turkey.Stdout#print@Int(
        let t : Int =
          let x%1 : Int =
            Prim.intMul(3, 3)
          Prim.intAdd(x%1, 1)
        Prim.intAdd(t, 3)
      )
    let %seq%2 : Unit =
      Turkey.Stdout#print@Int(
        let x%2 : Int =
          let x%3 : Int =
            Prim.intMul(3, 3)
          Prim.intAdd(x%3, 1)
        Prim.intAdd(x%2, 3)
      )
    Turkey.Stdout#print@Int(
      let value%1 : Int =
        let x%4 : Int =
          Prim.intMul(3, 3)
        Prim.intAdd(x%4, 1)
      let value%2 : Int =
        Prim.intMul(value%1, 2)
      Prim.intAdd(value%2, 3)
    )
  }
