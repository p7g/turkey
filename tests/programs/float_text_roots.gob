-- Values live across `Float.toString` survive a collection inside it.
--
-- Formatting is the runtime's and the string is Turkey's, so the call reaches
-- the allocator through code of both kinds. Under `TURKEY_GC_STRESS` every
-- allocation collects, and `before` is live across each conversion: if the
-- collector's walk of the stack lost this frame, the array would be freed
-- while still in use.
import Data.Float as Float

fun main() {
    var words = ["start"]
    for var i = 0; i < 200; i = i + 1 {
        let before = words
        let text = Float.toString(Float.fromInt(i) + 0.5)
        words = before + [text]
    }
    print(words[0] + " " + words[1] + " " + words[200])
    print(Int.toString(len(words)))
}
