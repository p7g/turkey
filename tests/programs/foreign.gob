-- An FFI to C: symbols declared with `foreign` in the library, called.
--
-- A foreign call is the one place a program's behaviour depends on code this
-- compiler did not produce, so it is checked end to end rather than by a unit
-- test: the declaration's signature, the arguments laid out by register bank
-- at the C ABI, the result read back, and a string copied across the boundary
-- in each direction. `getenv`, `strlen` and `write` are libc's (libSystem's),
-- declared in `Turkey.Libc`, which a test program in the library's own tree
-- may import where an ordinary program may not. The strings contain non-ASCII
-- text so that a byte count and a character count would differ.
--
-- Nothing here prints an environment value. A value is the machine's, and a
-- golden is this repository's; what is checked is the shape of the answer,
-- which is the same on any machine that has a `PATH`.

import System.Env as Env
import Turkey.Libc as Libc
import Turkey.Ptr as Ptr

fun main() {
    -- A safe wrapper over a declaration in `Turkey.Libc`.
    print(Bool.toString(Option.isSome(Env.get("PATH"))))
    print(Bool.toString(Option.isSome(Env.get("TURKEY_NO_SUCH_VARIABLE"))))

    -- A string across the boundary and back. The copy is deliberate; see
    -- `Turkey.Ptr.toCString`.
    let p = Ptr.toCString("héllo, wörld")
    match Ptr.fromCString(p) {
        Some(s) -> {
            print(s)
            print(Int.toString(String.byteLength(s)))
        }
        None -> print("not well-formed")
    }
    Ptr.free(p)

    -- The empty string is a block holding one NUL, not a null pointer.
    let empty = Ptr.toCString("")
    print(Bool.toString(Ptr.isNull(empty)))
    match Ptr.fromCString(empty) {
        Some(s) -> print("[" + s + "]")
        None -> print("not well-formed")
    }
    Ptr.free(empty)

    -- `fromCString` of null is `None` rather than a panic: a C function that
    -- failed answers null, and a caller should not have to test twice.
    print(Bool.toString(Option.isSome(Ptr.fromCString(Ptr.null()))))

    -- A three-argument call, which is where an argument-order mistake would
    -- live: the two integers travel in x0 and x2 with a pointer between them,
    -- so a backend that laid them out by position rather than by register file
    -- would put the count where the buffer goes.
    let line = Ptr.toCString("written through write(2)\n")
    let n = Libc.strlen(Ptr.raw(line))
    let sent = Libc.write(1, Ptr.raw(line), n)
    print(Int.toString(n) + " " + Int.toString(sent))
    Ptr.free(line)
}
