-- A `FrozenArray` is an array nobody can write, so it can be a `Set`
-- element or a `Map` key. The literal builds one wherever the use asks for
-- it, and everything else copies.
import Deque as Deque

fun main() {
    -- The literal builds a frozen array when the annotation asks for one.
    let xs : FrozenArray Int = [3, 1, 2]
    print(xs)
    print((len(xs), xs[0], FrozenArray.at(xs, 5)))

    -- Updates return a new array and leave the old one as it was.
    let ys = FrozenArray.with(xs, 0, 9)
    print((xs, ys))
    print((FrozenArray.slice(ys, 1, 3), FrozenArray.append(xs, ys), xs + ys))
    print((FrozenArray.sort(xs), FrozenArray.reverse(xs), FrozenArray.map(xs, \(_ * 10))))
    print((FrozenArray.filter(ys, \(_ > 1)), FrozenArray.fold(xs, 0, fun(acc, x) = acc + x)))
    print((FrozenArray.indexOf(xs, 2), FrozenArray.contains(xs, 7), FrozenArray.last(xs)))

    -- `freeze` copies, so writing to the source afterwards does not show.
    let source = [5, 6, 7]
    let frozen = FrozenArray.freeze(source)
    source[0] = 0
    print((source, frozen))

    -- `freeze` takes anything iterable with a length; `toArray` and `toVec`
    -- copy back out into something writable.
    let v : Vec Int = [1, 2]
    Vec.push(v, 3)
    print((FrozenArray.freeze(v), FrozenArray.freeze(Deque.fromArray([4, 5]))))
    let back = FrozenArray.toArray(frozen)
    back[0] = 1
    let grown = FrozenArray.toVec(frozen)
    Vec.push(grown, 8)
    print((back, grown, frozen))

    -- Equality is by elements, whatever each was built from. Order is
    -- lexicographic, and a proper prefix is less.
    let a : FrozenArray Int = [1, 2]
    print((a == FrozenArray.freeze([1, 2]), a == FrozenArray.freeze(v)))
    let shorter : FrozenArray Int = [1]
    let bigger : FrozenArray Int = [1, 3]
    print((shorter < a, a < bigger, bigger < a, a < a))

    -- Equal arrays hash alike.
    print(hash(a) == hash(FrozenArray.freeze(Vec.fromArray([1, 2]))))

    -- The classes `Array` has, except the one that writes.
    let empty : FrozenArray Int = empty()
    print((len(empty), FrozenArray.filled(3, 'x'), FrozenArray.init(4, \(_ * _))))
    var total = 0
    for x in xs { total = total + x }
    print((total, fmap(Int.toString, xs), foldMap(xs, \(Int.toString(_)))))

    -- `pure` and `bind`, and a sort by key.
    let pairs : FrozenArray Int = pure(4)
    print((pairs, bind(xs, \(FrozenArray.filled(_, _))), FrozenArray.sortByKey(xs, \(-_))))
}
