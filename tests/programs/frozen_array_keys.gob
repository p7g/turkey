-- Frozen arrays as keys, in the shapes puzzle code needs them: a seen-set of
-- search states, a memo keyed by a list of ints, a grid's rows as a key for
-- cycle detection, and frozen arrays inside frozen arrays.
import Data.Set as Set

-- Every state reachable from `start` by adding 1 to one element mod 3, by
-- breadth-first search with the states as `Set` elements.
fun reachable(start : FrozenArray Int) -> Int {
    let seen : Set.Set (FrozenArray Int) = Set.new()
    let queue : Vec (FrozenArray Int) = [start]
    Set.add(seen, start)
    var head = 0
    while head < len(queue) {
        let state = queue[head]
        head = head + 1
        for var i = 0; i < len(state); i = i + 1 {
            let next = FrozenArray.with(state, i, (state[i] + 1) % 3)
            if !Set.contains(seen, next) {
                Set.add(seen, next)
                Vec.push(queue, next)
            }
        }
    }
    len(seen)
}

-- The ways to split `n` into parts no larger than the largest of `parts`,
-- memoized on the remaining parts as a key.
fun ways(memo : Map (FrozenArray Int) Int, n : Int, parts : FrozenArray Int) -> Int {
    if n == 0 { return 1 }
    if n < 0 || len(parts) == 0 { return 0 }
    let key = FrozenArray.append([n], parts)
    if let Some(known) = Map.get(memo, key) { return known }
    let rest = FrozenArray.slice(parts, 1, len(parts))
    let total = ways(memo, n - parts[0], parts) + ways(memo, n, rest)
    memo[key] = total
    total
}

-- Moves the top row of the grid to the bottom until a grid repeats, and
-- returns the steps at which it was first and next seen.
fun firstRepeat(rows : Array String) -> (Int, Int) {
    let history : Map (FrozenArray String) Int = Map.new()
    var grid = FrozenArray.freeze(rows)
    var step = 0
    loop {
        if let Some(earlier) = Map.get(history, grid) { return (earlier, step) }
        history[grid] = step
        grid = FrozenArray.append(FrozenArray.slice(grid, 1, len(grid)),
                                  FrozenArray.slice(grid, 0, 1))
        step = step + 1
    }
}

fun main() {
    print(reachable([0, 0, 0, 0]))
    print(ways(Map.new(), 10, [5, 2, 1]))
    print(firstRepeat(["#..", ".#.", "#.."]))

    -- A literal key, decided by the map's annotated type.
    let byName : Map (FrozenArray Int) String = Map.new()
    byName[[1, 2, 3]] = "one two three"
    print((byName[[1, 2, 3]], Map.get(byName, [3, 2, 1])))

    -- Nested: the inner literals are frozen because the outer one's
    -- element type is.
    let groups : Set.Set (FrozenArray (FrozenArray Int)) = Set.new()
    Set.add(groups, [[1], [2, 3]])
    print((Set.contains(groups, [[1], [2, 3]]), Set.contains(groups, [[1, 2], [3]])))

    -- An array of frozen arrays: the outer literal is an `Array`.
    let moves : Array (FrozenArray Int) = [[0, 1], [1, 0]]
    moves[0] = [0, -1]
    print(moves)
}
