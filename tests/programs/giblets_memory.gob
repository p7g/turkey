-- The first giblet module, `Turkey.Memory` (TIX-63), called from ordinary code.
--
-- Both compilers hold `Turkey.Memory` to the giblets rule at every build, so a
-- program that merely imports it is a check that the rule accepts code written
-- the way the collector will be written. What this adds is that the code also
-- does what it says, on both hosts.

import Turkey.Memory as Memory
import Unsafe.Ptr as Ptr

fun main() {
    let p = Ptr.alloc(16)
    Memory.fill(Ptr.raw(p), 16, 0)
    Memory.fill(Ptr.raw(p), 5, 321)
    let q = Ptr.alloc(16)
    Memory.copy(Ptr.raw(q), Ptr.raw(p), 16)
    let bytes = Array.map([0, 4, 5, 15], fun(i) = Byte.toInt(Ptr.load(Ptr.add(q, i), 0)))
    print(String.join(Array.map(bytes, Int.toString), " "))
    Ptr.free(p)
    Ptr.free(q)

    for x in [0, 1, 8, 96, -9223372036854775807 - 1] {
        print(Int.toString(Memory.trailingZeros(x)))
    }
}
