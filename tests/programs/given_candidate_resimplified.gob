-- A constraint a function body leaves for the function around it is
-- simplified again there. Inside `inner`, `cc(Box(x))` needs `C (Box a)`,
-- which `inner`'s own `C (Box b)` might yet provide, so it waits. Outside
-- `inner` no such context is in scope, and the instance reduces it to
-- `Show a`, which is what `outer`'s type asks for.

class C a {
    fun cc(a) -> Int
}

type Box a = Box(a)

instance C (Box a) : Show a {
    fun cc(Box(v)) = String.byteLength(show(v))
}

fun outer(x) {
    fun inner[C (Box b)](y : b) -> Int = cc(Box(x)) + cc(Box(y))
    inner(1)
}

fun main() { print(outer(100)) }
