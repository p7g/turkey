-- A chain of 45 givens, each relating one wrapper's element to the next, and
-- written so that each one rewrites all those before it. The checker's budget
-- for a context grows with the context, so a long chain is not given up on.
-- No instance decides `Elem (V a)`, so nothing can call `h`; checking it is
-- the point.

class Box b {
    type Elem b
    fun open(b) -> Elem b
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

type V a = V(a)

fun h[Box a,
       Elem (a) ~ Elem (V (a)),
       Elem (V (a)) ~ Elem (V (V (a))),
       Elem (V (V (a))) ~ Elem (V (V (V (a)))),
       Elem (V (V (V (a)))) ~ Elem (V (V (V (V (a))))),
       Elem (V (V (V (V (a))))) ~ Elem (V (V (V (V (V (a)))))),
       Elem (V (V (V (V (V (a)))))) ~ Elem (V (V (V (V (V (V (a))))))),
