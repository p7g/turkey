-- A chain of givens, `Key b ~ Elem b` and `Elem b ~ Option Int`, in copies
-- that polymorphic recursion keeps generic: `y : Key b` is an `Option Int`
-- only through both.

class Box b {
    type Elem b
    type Key b
}

instance Box Int {
    type Elem = Option Int
    type Key = Option Int
}

instance Box (Option a) {
    type Elem = Elem a
    type Key = Key a
}

fun deep[Key b ~ Elem b, Elem b ~ Option Int](n : Int, y : Key b, o : b) -> Int {
    let k = if let Some(v) = y { v } else { 100 }
    if n == 0 { k } else { deep(n - 1, Some(k * 2 + 1), Some(o)) }
}

fun main() {
    print(deep(3, Some(1), 0))
}
