-- Two sets of equalities that each terminate as rewrite rules but loop when
-- combined (Schrijvers et al., "Type checking with open type functions",
-- ICFP 2008, Example 1), with `a` for `Bool` and `b` for `Int`. Rewriting
-- `F a` to `F (G b)` and `G b` to `a` would go round for ever. Adding the
-- second equality rewrites the first to `F a ~ F a`, which is dropped.

class K a {
    type F a
    type G a
}

instance K Int {
    type F = String
    type G = Bool
}

instance K Bool {
    type F = String
    type G = Int
}

fun h[K a, K b, F a ~ F (G b), G b ~ a](x : F a, y : b) -> F (G b) = x

fun main() { print(h("same", 1)) }
