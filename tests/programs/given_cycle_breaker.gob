-- A given whose left side occurs in its right side under a family:
-- `E (Option a)` is `a`, so the given says `a ~ Option (F a)`. That is no
-- infinite type, but as a rule from `a` it would rewrite for ever, so `F a`
-- stands aside as a variable of its own while `h` is checked.

class C a {
    type F a
    fun get(a) -> F a
}

instance C (Option b) {
    type F = b
    fun get(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

class W w {
    type E w
}

instance W (Option a) {
    type E = a
}

fun h[C a, E (Option a) ~ Option (F a)](x : a) -> F a = get(x)

fun main() { print(h(Some(Some(1)))) }
