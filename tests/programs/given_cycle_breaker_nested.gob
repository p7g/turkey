-- A signature with no equalities, nested in one whose given needs a cycle
-- breaker. Only the scope that made a breaker may close it: closing the outer
-- set when the inner scope ends would leave it rewriting `F a` through `a`
-- for ever while the outer body is still being checked.

class C a {
    type F a
    fun get(a) -> F a
}

instance C (Option b) {
    type F = b
    fun get(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

class W w {
    type E w
}

instance W (Option a) {
    type E = a
}

fun h[C a, E (Option a) ~ Option (F a)](x : a) -> F a {
    fun inner(v : Int) -> Int = v
    get(x)
}

fun main() { print(h(Some(Some(1)))) }
