-- A given whose two sides an instance makes the same: `G (W a)` is `F a` by
-- the instance, so `F a ~ G (W a)` says nothing, and reducing by it cannot
-- loop through the instance.

class C a {
    type F a
    type G a
    fun f(a) -> F a
}

type W a = W(a)

instance C (W a) : C a {
    type F = F a
    type G = F a
    fun f(W(x)) = f(x)
}

instance C Int {
    type F = String
    type G = String
    fun f(n) = Int.toString(n)
}

fun h[C a, F a ~ G (W a)](x : a) -> G (W a) = f(x)

fun main() { print(h(41)) }
