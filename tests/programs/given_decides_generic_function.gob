-- As in `given_decides_generic_layout`, with an equality that makes a family
-- application a function, which the generic copies then call.

class Box b {
    type Elem b
}

instance Box Int {
    type Elem = fun(Int) -> Int
}

instance Box (Option a) {
    type Elem = Elem a
}

fun deep[Elem b ~ (fun(Int) -> Int)](n : Int, y : Elem b, o : b) -> Int {
    let k = y(n)
    if n == 0 { k } else { deep(n - 1, fun(x) = x + k, Some(o)) }
}

fun main() {
    print(deep(3, fun(x) = x * 10, 0))
}
