-- An equality that only a coercion decides, in a binding no specialization
-- reaches: `deep` recurses at `Option b`, so its copies stay generic, and
-- inside them `y : Elem b` is an `Array Int` only because the context says so.
-- Indexing it has to see the array.

class Box b {
    type Elem b
}

instance Box Int {
    type Elem = Array Int
}

instance Box (Option a) {
    type Elem = Elem a
}

fun deep[Elem b ~ Array Int](n : Int, y : Elem b, o : b) -> Int {
    let k = y[0]
    if n == 0 { k } else { deep(n - 1, [k + n], Some(o)) }
}

fun main() {
    print(deep(3, [10], 0))
}
