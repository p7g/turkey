-- As in `given_decides_generic_layout`, with a dictionary beside the
-- equality, so the generic copies are called through their workers, which
-- take the dictionary, the coercion and the parameters in one list. The
-- array the equality decides is read, and its length taken, in each copy.

class Box b {
    type Elem b
    fun tag(b) -> Int
}

instance Box Int {
    type Elem = Array Int
    fun tag(x) = x
}

instance Box (Option a) : Box a {
    type Elem = Elem a
    fun tag(o) = match o {
        Some(x) -> tag(x) + 1
        None -> 0
    }
}

fun deep[Box b, Elem b ~ Array Int](n : Int, y : Elem b, o : b) -> Int {
    let k = y[0] + len(y)
    if n == 0 { k + tag(o) } else { deep(n - 1, [k + n, 0], Some(o)) }
}

fun main() {
    print(deep(3, [10], 0))
}
