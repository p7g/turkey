-- An equation that an equality given leaves undecided, over a type that no
-- binding generalizes, is decided once the whole program has been checked,
-- before any numeric literal takes its default type.
--
-- `log`'s element is pushed only inside `record`, under `Elem b ~ Int`, so
-- `log` is a `Vec Int`. `n` is decided by `half`'s body, under the same kind
-- of context, so it is a `Float` and not the `Int` a literal would default
-- to.

class Bag b {
    type Elem b
    fun pick(b) -> Elem b
}

instance Bag (Option a) {
    type Elem = a
    fun pick(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

let log = Vec.new(4)

fun record[Bag b, Elem b ~ Int](y : b) -> Int {
    Vec.push(log, pick(y))
    0
}

fun half() -> Float {
    var n = 1
    fun inner[Bag b, Elem b ~ Int](y : b) -> Float = n / 2.0
    inner(Some(1))
}

fun main() {
    print(record(Some(7)))
    print(len(log))
    print(half())
}
