-- A given that only says what a signature's own variable is does not keep a
-- type from outside the function undecided. `Elem (Option a) ~ Int` reduces
-- to `a ~ Int`, which says what `a` is, as a `let` would, and nothing more.
-- So `x + y` inside `inner` decides that `x` is an `Int`, and `outer` takes
-- an `Int`.

class Bag b {
    type Elem b
}

instance Bag (Option a) {
    type Elem = a
}

fun outer(x) {
    fun inner[Elem (Option a) ~ Int](y : a) -> Int = x + y
    inner(2)
}

fun main() { print(outer(1)) }
