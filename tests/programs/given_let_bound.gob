-- A given that only names a signature's own variable does not make outer
-- variables untouchable. `Elem (Option a) ~ Int` reduces to `a ~ Int`, which
-- says what `a` is, as a `let` would, and nothing more. So `x ~ Int` inside
-- `inner` decides `x` at once, and `outer` takes an `Int`. GHC's Note
-- [Let-bound skolems] makes the same exception.

class Bag b {
    type Elem b
}

instance Bag (Option a) {
    type Elem = a
}

fun outer(x) {
    fun inner[Elem (Option a) ~ Int](y : a) -> Int = x + y
    inner(2)
}

fun main() { print(outer(1)) }
