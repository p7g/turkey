-- A local function generalized under an equality given: `g` is generalized
-- over its parameter, with `Box y` and `Add (Elem y)` in its context, and the
-- call `g(x)` needs `Add (Elem a)`, which the given `Elem a ~ Int` makes the
-- `Add Int` instance.

class Box b {
    type Elem b
    fun open(b) -> Elem b
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

fun f[Box a, Elem a ~ Int](x : a) -> Int {
    let g = fun(y) = open(y) + 1
    g(x)
}

fun main() { print(f(Some(41))) }
