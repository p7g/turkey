-- A given rewrites a family application below the head too. `wrap(x)` is an
-- `Option (Elem b)`, which under `Elem b ~ Int` is `Option Int`: it mentions
-- nothing of `f`'s, so it may go into `log`, whose element `main` decides.

class Box b {
    type Elem b
    fun open(b) -> Elem b
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

fun wrap[Box b](x : b) -> Option (Elem b) = Some(open(x))

let log = Vec.new(4)

fun f[Box b, Elem b ~ Int](x : b) -> Unit { Vec.push(log, wrap(x)) }

fun main() {
    f(Some(3))
    match log[0] {
        Some(n) -> print(n + 1)
        None -> {}
    }
}
