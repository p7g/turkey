-- Under an equality given, a call to a function from outside the signature is
-- decided outside it, and what the body reads from the result is decided with
-- it: `f(n).age` is a field of whatever `f` returns.

type P = P { age : Int }
fun outer(f) -> Int {
    fun inner[Iterator s, Item s ~ Int](xs : s) -> Int {
        var t = 0
        for n in xs { t = t + f(n).age }
        t
    }
    inner([1, 2])
}
fun main() { print(Int.toString(outer(fun(n) = P { age = n }))) }
