-- Under an equality given, a function from outside the signature whose type
-- is known outside it can be called inside: `show(f(n))` needs `Show` of
-- what `f` returns, which is `Option Int`.

fun outer(f : fun(Int) -> Option Int) -> String {
    fun inner[Iterator s, Item s ~ Int](xs : s) -> String {
        var t = ""
        for n in xs { t = t + show(f(n)) }
        t
    }
    inner([1, 2])
}
fun main() { print(outer(fun(n) = Some(n))) }
