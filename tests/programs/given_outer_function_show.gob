-- As with a field, `show(f(n))` under an equality given needs `Show` of what a
-- function from outside the signature returns, and is decided outside it.

fun outer(f) -> String {
    fun inner[Iterator s, Item s ~ Int](xs : s) -> String {
        var t = ""
        for n in xs { t = t + show(f(n)) }
        t
    }
    inner([1, 2])
}
fun main() { print(outer(fun(n) = Some(n))) }
