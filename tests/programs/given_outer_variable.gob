-- Under an equality in a signature's context, a variable from outside the
-- function is not decided inside it. `log`'s element type is open when `bump`
-- is checked, and `bump` pushes an `Elem b` that its context says is `Int`.
-- The function leaves `log`'s element to be decided outside, where the
-- equation still says `Int`, and nothing about `b` reaches `log`.

class Box b {
    type Elem b
    fun open(b) -> Elem b
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

let log = Vec.new(4)

fun bump[Box b, Elem b ~ Int](x : b) -> Int {
    Vec.push(log, open(x))
    open(x) + 1
}

fun main() {
    print(Int.toString(bump(Some(41))))
    print(Int.toString(log[0] * 2))
}
