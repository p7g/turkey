-- The same as a method's equality, on a plain signature: the given
-- `Elem (Wrap a) ~ Int` is reduced through the instance when it is added, to
-- `Elem a ~ Int`, which is what `open(x)` has.

class Box a {
    type Elem a
    fun open(a) -> Elem a
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

type Wrap a = Wrap(a)

instance Box (Wrap a) : Box a {
    type Elem = Elem a
    fun open(Wrap(x)) = open(x)
}

fun f[Box a, Elem (Wrap a) ~ Int](x : a) -> Int = open(x)

fun main() { print(f(Some(3))) }
