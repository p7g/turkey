-- A given that reduces to an equality on the signature's own type variable:
-- `Elem (Option a) ~ Int` is `a ~ Int`, so inside `f` an `a` is an `Int`.

class Bag b {
    type Elem b
}

instance Bag (Option a) {
    type Elem = a
}

fun f[Elem (Option a) ~ Int](x : a) -> Int = x + 1

fun main() { print(f(41)) }
