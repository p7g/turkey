-- A local function generalized under a given that refines the signature's
-- variable: inside `f`, `a` is `Int`, so `q.v + 1` adds `Int`s. The lowering
-- still types the addition's dictionary without the given.

class Bag b {
    type Elem b
}

instance Bag (Option a) {
    type Elem = a
}

type R a = R { v : a, w : Option a }

fun f[Elem (Option a) ~ Int](r : R a) -> Int {
    let g = fun(q) = q.v + 1
    g(r)
}

fun main() { print(f(R { v = 1, w = Some(2) })) }

--@ xfail: TIX-559, the lowering re-derives evidence the solver found under a given
