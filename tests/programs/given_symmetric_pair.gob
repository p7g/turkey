-- `F a ~ G a` and `G a ~ F a` are one equality written twice. The second
-- rewrites to `G a ~ G a` under the first and is dropped, so the givens
-- cannot rewrite each other for ever.

class C a {
    type F a
    type G a
    fun f(a) -> F a
}

instance C Bool {
    type F = Int
    type G = Int
    fun f(b) = if b { 1 } else { 0 }
}

fun h[C a, F a ~ G a, G a ~ F a](x : a) -> G a = f(x)

fun main() { print(h(True) + 1) }
