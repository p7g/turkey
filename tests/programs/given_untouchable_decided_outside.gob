-- Under an equality in a signature's context, a variable from outside the
-- function is not decided inside it, but it may be decided outside, and then
-- the equation inside is solved where it is.
--
-- In `annotated`, the annotation on `n` decides `x` after `inner` is checked.
-- `local` is not generalized over `x`'s type, which only `inner`'s body
-- constrains, so its use `local(41)` decides it.

class Bag b {
    type Elem b
}

instance Bag (Option a) {
    type Elem = a
}

fun annotated(x) -> Int {
    fun inner[Bag b, Elem b ~ Int](y : b) -> Int = x
    let n : Int = x
    n + inner(Some(1))
}

fun main() {
    fun local(x) {
        fun inner[Bag b, Elem b ~ Int](y : b) -> Int = x
        inner(Some(1))
    }
    print(annotated(1))
    print(local(41) + 1)
}
