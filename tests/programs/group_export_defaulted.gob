-- Each member of a recursive group gets the part of the group's context
-- its own type reaches. `f`'s type is `fun(Bool) -> String`, though the
-- group's bodies need `Eq a` for `g`'s parameter: `f` uses the group's code
-- at a type defaulting decides, `Int`, and `g` keeps `[Eq a]`.

fun f(x) = show(x) + g(0)

fun g(n) = if n == 0 { "" } else { f(True) }

fun main() {
    print(g(1))
    print(g(1.5))
}
