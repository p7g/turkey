-- `render` is the entry point and `go` carries the indentation. Only `go`'s
-- type mentions the indentation's type, so only `go` is generalized over
-- it, and a call of `render` needs no annotation.

type Doc = Text(String) | Nest(Array Doc)

fun render(doc) = go(doc, 0)

fun go(doc, indent) = match doc {
    Text(s) -> show(indent) + ":" + s
    Nest(ds) -> {
        var out = ""
        for d in ds { out = out + render(d) + go(d, indent + 1) }
        out
    }
}

fun main() {
    print(render(Nest([Text("a"), Text("b")])))
    print(go(Text("c"), 2.5))
}
