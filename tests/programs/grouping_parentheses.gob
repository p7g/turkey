-- Grouping parentheses decide how operators group and do nothing else: they
-- are transparent to the `_` shorthand, to assignment and to `let ... else`.

fun twice(f : fun(Int) -> Int, x : Int) -> Int = f(f(x))

fun orMinusOne(o : Option Int) -> Int {
    let Some(x) = (o) else { return (-1) }
    x
}

fun main() {
    let scaled = (_ + 1) * 2
    print(scaled(3))
    print(twice(((_ * 3)), 2))
    print(Array.map([1, 2], Int.toString((_))))
    var n = 1
    (n) = ((n) + (2 * 3))
    print(n)
    print(orMinusOne(None))
    print(orMinusOne(Some(7)))
    print(((1 + 2)) * (3))
}
