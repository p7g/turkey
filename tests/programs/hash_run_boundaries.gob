-- Every hasher in the library marks where each run of bytes ends, so keys
-- that feed the same bytes in runs that end in different places hash apart,
-- however long the runs are. A length kept modulo 256 would join the pairs
-- of 256 and 512 bytes below.

import Data.Hashable (Hasher(..), Hash(..))
import Hash.SipHash (SipHash)
import Hash.FoldHash (FoldHash)
import Hash.FxHash (FxHash)
import Algorithm.Hash (FNV1a)

fun nuls(n : Int) -> String = String.repeat("\u{0}", n)

let pairs = [
    (("ab", "c"), ("a", "bc")),
    (("", "x"), ("x", "")),
    ((nuls(256), ""), ("", nuls(256))),
    ((nuls(512), ""), (nuls(256), nuls(256))),
]

fun apart[Hasher h, Hash k](a : k, b : k, start : h) -> Bool =
    finishHash(hashInto(a, start)) != finishHash(hashInto(b, start))

fun main() {
    for (a, b) in pairs {
        let sip : SipHash = startHash(12345)
        let fold : FoldHash = startHash(777)
        let fx : FxHash = startHash(0)
        let fnv : FNV1a = startHash(0)
        print([apart(a, b, sip), apart(a, b, fold), apart(a, b, fx), apart(a, b, fnv)])
    }
}
