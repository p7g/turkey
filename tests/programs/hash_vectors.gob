-- The hash functions in `Hash`, against values computed independently of
-- them: the rustc-hash crate's own test vectors for `FxHash`, and for the rest
-- straight transliterations of the reference sources (rapidhash.h,
-- foldhash's Rust, and SipHash checked against its published 2-4 vector).
-- A port that drifts from its algorithm changes a line here.

import Data.Hashable (Hasher(..), Hash(..))
import Hash.RapidHash (RapidHash)
import Hash.SipHash (SipHash)
import Hash.FoldHash (FoldHash)
import Hash.FxHash (FxHash)

fun strings() -> Array String {
    var xs = ""
    for _ in Int.range(0, 300) { xs = xs + "x" }
    ["", "a", "ab", "abc", "abcd", "hello, world", "0123456789abcdef", "0123456789abcdefg",
     "The quick brown fox jumps over the lazy dog!!",
     "The quick brown fox jumps over the lazy dog, and then some more text to pass 48.",
     "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam",
     xs]
}

let ints = [0, 1, -1, 0x0123456789abcdef]
let words = [1, -2, 0x0123456789abcdef]

fun main() {
    for t in strings() {
        let d : RapidHash = seeded(777)
        hashInto(t, d)
        print("rapid " + Int.toString(digest(d)))
    }
    for x in ints {
        let d : RapidHash = seeded(777)
        hashInto(x, d)
        print("rapidint " + Int.toString(digest(d)))
    }
    for n in Int.range(0, 4) {
        let d : SipHash = seeded(12345)
        for i in Int.range(0, n) { hashInto(words[i], d) }
        print("sip " + Int.toString(digest(d)))
    }
    for t in strings() {
        let d : FoldHash = seeded(777)
        hashInto(t, d)
        print("fold " + Int.toString(digest(d)))
    }
    for n in Int.range(1, 4) {
        let d : FoldHash = seeded(777)
        for i in Int.range(0, n) { hashInto(words[i], d) }
        print("foldint " + Int.toString(digest(d)))
    }

    for x in [1, 100, -1, Int.minValue()] {
        let d : FxHash = seeded(0)
        hashInto(x, d)
        print("fx " + Int.toString(digest(d)))
    }
    for t in ["", "uwu", "These are some bytes for testing rustc_hash."] {
        let d : FxHash = seeded(0)
        hashInto(t, d)
        print("fx " + Int.toString(digest(d)))
    }
}
