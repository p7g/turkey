export (fuzzHeads, fuzzBodies, corpus, chunkedCorpus, mutate)

-- Random mutations of heads and chunked bodies: one to three bytes replaced,
-- inserted or deleted, from a set of bytes the grammar gives a meaning to.
-- For every mutation:
--
-- * nothing panics;
-- * the outcome is the same whether the bytes arrive whole, a byte at a
--   time, or in random pieces;
-- * a head the codec accepts, the prototype's strict reading (`Strict.gob`)
--   accepts too, with the same framing;
-- * a head the codec accepts reads back the same after the serializer
--   writes it;
-- * a chunked body decodes to what a separate reading of the same rules,
--   over the whole input at once, says.
--
-- `Bench.gob` runs the same fuzz at a larger count.

import Net.HTTP (..)
import Net.HTTP.H1.Classes (tchar, fieldChar, ows, hexDigit, hexValue, quotedChar, cr, lf, lowerText)
import Net.HTTP.H1.Head (RequestHead(..), Framing(..), Persistence(..))
import Net.HTTP.H1.Input as Input
import Net.HTTP.H1.Output as Output
import Net.HTTP.H1.Output (OutgoingRequest(..))
import Net.HTTP.HTTPURL as HTTPURL
import Net.HTTP.Limits as Limits
import Net.HTTP.Method as Method
import Bodies (decode)
import Run (..)
import Strict as Strict
import System.IO as IO
import Wire (Rng, rng, next, sized, oneByte, source, Tape, tape, written)

-- Heads to mutate: what browsers, tools and the rule cases send.
let corpus = [
    "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n",
    "GET /wp-content/uploads/2010/03/hello-kitty-darth-vader-pink.jpg HTTP/1.1\r\nHost: www.kittyhell.com\r\nUser-Agent: Mozilla/5.0 (Macintosh; U; Intel Mac OS X 10.6; ja-JP-mac; rv:1.9.2.3) Gecko/20100401 Firefox/3.6.3 Pathtraq/0.9\r\nAccept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\r\nAccept-Language: ja,en-us;q=0.7,en;q=0.3\r\nAccept-Encoding: gzip,deflate\r\nKeep-Alive: 115\r\nConnection: keep-alive\r\nCookie: wp_ozh_wsa_visits=2; wp_ozh_wsa_visit_lasttime=xxxxxxxxxx; __utma=xxxxxxxxx.xxxxxxxxxx.x\r\n\r\n",
    "POST /orders?id=7 HTTP/1.1\r\nHost: shop.example:8080\r\nContent-Type: application/json\r\nContent-Length: 13\r\nExpect: 100-continue\r\n\r\n",
    "PUT /upload HTTP/1.1\r\nHost: files.example\r\nTransfer-Encoding: gzip, chunked\r\nX-Trace: a b\tc\r\n\r\n",
    "PATCH /a HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n",
    "GET http://example.com:80/a?b HTTP/1.1\r\nHost: example.com\r\nAccept: */*\r\n\r\n",
    "OPTIONS * HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\n\r\n",
    "CONNECT example.com:443 HTTP/1.1\r\nHost: example.com:443\r\nProxy-Connection: keep-alive\r\n\r\n",
    "GET / HTTP/1.0\r\nUser-Agent: curl/8.0\r\n\r\n",
    "DELETE /items/1 HTTP/1.1\r\nHost: [::1]:8080\r\nAuthorization: Bearer abc.def\r\nUpgrade: h2c\r\n\r\n",
]

-- Chunked bodies to mutate.
let chunkedCorpus = [
    "5\r\nhello\r\n6;ext=1\r\n world\r\n0\r\nX-T: v\r\n\r\nGET",
    "1A\r\nabcdefghijklmnopqrstuvwxyz\r\n0;a=\"b;c\"\r\n\r\n",
    "3;x;y=z\r\nabc\r\n03\r\ndef\r\n0\r\nA: 1\r\nB:  2 \r\n\r\n",
    "0\r\n\r\n",
]

-- Bytes a mutation puts in: the ones the grammar treats specially, and a
-- few ordinary ones.
let interesting = [13, 10, 32, 9, 58, 44, 59, 0, 127, 128, 255, 48, 57, 43, 45, 47, 42, 91, 93,
                   34, 64, 35, 97, 65, 61, 92, 70, 120]

-- Returns `s` with one to three bytes replaced, inserted or deleted.
fun mutate(s : Array Byte, r : Rng) -> Array Byte {
    var out = s
    for _ in Int.range(0, 1 + next(r, 3)) {
        let at = next(r, len(out) + 1)
        let b = Byte.truncate(interesting[next(r, len(interesting))])
        let edited = []
        let kind = next(r, 3)
        for var i = 0; i <= len(out); i = i + 1 {
            if i == at {
                match kind {
                    0 -> if i < len(out) { Vec.push(edited, b) }
                    1 -> Vec.push(edited, b)
                    _ -> {}
                }
                if kind == 1 && i < len(out) { Vec.push(edited, out[i]) }
            } else if i < len(out) {
                Vec.push(edited, out[i])
            }
        }
        out = Vec.toArray(edited)
    }
    out
}

-- Returns the pieces a seeded source hands `s` out in.
fun pieces(r : Rng) -> Array Int {
    let out = []
    for _ in Int.range(0, 1 + next(r, 5)) { Vec.push(out, 1 + next(r, 9)) }
    Vec.toArray(out)
}

fun reading(s : Array Byte, src : Wire.Source) -> (String, Option RequestHead) {
    let input = Input.input(src, Limits.defaults)
    let result = readRequest(input, Limits.defaults)
    match result {
        Right(Some(h)) -> (describeRequest(h), Some(h))
        _ -> (requestOutcome(result), None)
    }
}

-- Returns `h` written by the serializer and read back, compared on what the
-- writer writes, or `None` if its target is not one an `HTTPURL` holds.
fun roundTrip(h : RequestHead) -> Option (String, String) {
    let authority = h.target.authority?
    let query = match h.target.query {
        Some(q) -> "?" + q
        None -> ""
    }
    if h.target.path == "" || h.target.path == "*" { return None }
    let url = Either.right(HTTPURL.parse("http://" + authority + h.target.path + query))?
    let head = Either.right(Output.requestHead(OutgoingRequest {
        method = h.method, url, headers = h.headers, framing = h.framing,
        persistence = h.persistence, expectContinue = h.expectContinue,
    }))?
    let out = tape()
    let w = Output.bodyWriter(out, head, NoBody)
    let _ = Output.finish(w)
    let bytes = String.toBytes(written(out))
    let (_, back) = reading(bytes, oneByte(bytes))
    let comparable = fun(x : RequestHead) = Method.name(x.method) + " " + show(x.target.path) + " "
        + show(x.target.query) + " [" + show(x.headers) + "] " + show(x.framing) + " " + show(x.expectContinue)
    match back {
        Some(b) -> Some((comparable(h), comparable(b)))
        None -> Some((comparable(h), "refused: " + visible(written(out))))
    }
}

-- Runs `count` mutations of the corpus's heads from `seed`, printing each
-- failure and a summary.
fun fuzzHeads(count : Int, seed : Int) {
    let r = rng(seed)
    var refused = 0
    var failures = 0
    var trips = 0
    for _ in Int.range(0, count) {
        let original = String.toBytes(corpus[next(r, len(corpus))])
        let s = mutate(original, r)
        let (whole, head) = reading(s, sized(s, [len(s) + 1]))
        let (drip, _) = reading(s, oneByte(s))
        let (random, _) = reading(s, sized(s, pieces(r)))
        var problem = ""
        if drip != whole || random != whole { problem = "readings disagree: " + whole + " / " + drip + " / " + random }
        match head {
            None -> { refused = refused + 1 }
            Some(h) -> {
                match Strict.parse(s, 0) {
                    Left(status) -> { problem = problem + " accepted where the prototype says " + show(status) }
                    Right(p) -> {
                        let agrees = match (p.framing, h.framing) {
                            (Strict.NoBody, NoBody) | (Strict.Chunked, Chunked) -> True
                            (Strict.Length(a), ContentLength(b)) -> a == b
                            _ -> False
                        }
                        if !agrees { problem = problem + " framing differs from the prototype's" }
                    }
                }
                if let Some((before, after)) = roundTrip(h) {
                    trips = trips + 1
                    if before != after { problem = problem + " round trip: " + before + " => " + after }
                }
            }
        }
        if problem != "" {
            failures = failures + 1
            print("FUZZ " + visible(String.fromBytesLossy(s)) + ": " + problem)
        }
    }
    print("head fuzz: " + show(count) + " mutations, " + show(refused) + " refused, " + show(trips)
          + " written and read back, " + show(failures) + " failures")
}

fun fuzzBodies(count : Int, seed : Int) {
    let r = rng(seed)
    var refused = 0
    var failures = 0
    for _ in Int.range(0, count) {
        let s = mutate(String.toBytes(chunkedCorpus[next(r, len(chunkedCorpus))]), r)
        let whole = decode(sized(s, [len(s) + 1]), Chunked, Limits.defaults, 4096)
        let drip = decode(oneByte(s), Chunked, Limits.defaults, 1)
        let random = decode(sized(s, pieces(r)), Chunked, Limits.defaults, 1 + next(r, 7))
        let expected = reference(s)
        if String.startsWith(whole, "error") { refused = refused + 1 }
        if whole != expected || drip != expected || random != expected {
            failures = failures + 1
            print("FUZZ " + visible(String.fromBytesLossy(s)) + ": expected " + expected + ", got " + whole
                  + " / " + drip + " / " + random)
        }
    }
    print("body fuzz: " + show(count) + " mutations, " + show(refused) + " refused, " + show(failures)
          + " failures")
}

-- -- the reference reading of a chunked body -------------------------------------------

-- Returns what decoding the chunked body `s` gives, in `decode`'s words,
-- reading the whole input at once: an index walk over RFC 9112 §7.1's
-- grammar, with the default limits.
fun reference(s : Array Byte) -> String {
    let n = len(s)
    let data = []
    var p = 0
    loop {
        -- chunk-size [ chunk-ext ] CRLF, at most 1024 bytes with its CRLF
        let lfAt = indexOf(s, lf, p, n)
        if lfAt < 0 || lfAt - p + 1 > 1024 {
            return if lfAt < 0 && n - p < 1024 { "error truncated" } else { "error 400" }
        }
        if lfAt == p || Byte.toInt(s[lfAt - 1]) != cr { return "error 400" }
        let size = sizeOf(s, p, lfAt - 1)
        if size < 0 { return "error 400" }
        p = lfAt + 1
        if size == 0 { break }
        if n - p < size { return "error truncated" }
        for var i = p; i < p + size; i = i + 1 { Vec.push(data, s[i]) }
        p = p + size
        -- CRLF after the data: two bytes, or the input ends first.
        if n - p < 2 {
            return if n - p == 1 && Byte.toInt(s[p]) == lf { "error 400" } else { "error truncated" }
        }
        if Byte.toInt(s[p]) != cr || Byte.toInt(s[p + 1]) != lf { return "error 400" }
        p = p + 2
    }
    -- trailer-section CRLF, at most 4096 bytes of fields
    let trailers = []
    var budget = 4096
    loop {
        let lfAt = indexOf(s, lf, p, n)
        if lfAt < 0 || lfAt - p + 1 > budget + 2 {
            return if lfAt < 0 && n - p < budget + 2 { "error truncated" } else { "error 431" }
        }
        if lfAt == p + 1 && Byte.toInt(s[p]) == cr {
            p = p + 2
            break
        }
        if lfAt - p + 1 > budget { return "error 431" }
        match trailerLine(s, p, lfAt) {
            Some(text) -> Vec.push(trailers, text)
            None -> return "error 400"
        }
        budget = budget - (lfAt - p + 1)
        p = lfAt + 1
    }
    let rest = Array.slice(s, p, n)
    let shown = String.join(Vec.toArray(trailers), "\n")
    "\"" + visible(String.fromBytesLossy(Vec.toArray(data))) + "\""
        + (if shown == "" { "" } else { ", trailers " + visible(shown) })
        + (if len(rest) == 0 { "" } else { ", then \"" + visible(String.fromBytesLossy(rest)) + "\"" })
}

fun indexOf(s : Array Byte, b : Int, from : Int, to : Int) -> Int {
    for var i = from; i < to; i = i + 1 {
        if Byte.toInt(s[i]) == b { return i }
    }
    -1
}

-- 1 to 16 hex digits, then any number of `;name` or `;name=value`, each with
-- optional SP or HTAB around its `;` and `=`. Returns -1 if `s[from..to)` is
-- not that.
fun sizeOf(s : Array Byte, from : Int, to : Int) -> Int {
    var i = from
    var size = 0
    while i < to && hexDigit[Byte.toInt(s[i])] {
        if i - from == 16 { return -1 }
        let d = hexValue(Byte.toInt(s[i]))
        if size > (Int.maxValue() - d) / 16 { return -1 }
        size = size * 16 + d
        i = i + 1
    }
    if i == from { return -1 }
    while i < to {
        i = skipWhite(s, i, to)
        if i >= to || Byte.toInt(s[i]) != 59 { return -1 }
        i = skipWhite(s, i + 1, to)
        let name = i
        while i < to && tchar[Byte.toInt(s[i])] { i = i + 1 }
        if i == name { return -1 }
        let afterName = skipWhite(s, i, to)
        if afterName < to && Byte.toInt(s[afterName]) == 61 {
            i = skipWhite(s, afterName + 1, to)
            if i < to && Byte.toInt(s[i]) == 34 {
                i = i + 1
                var closed = False
                while i < to && !closed {
                    let c = Byte.toInt(s[i])
                    if c == 34 {
                        closed = True
                    } else if c == 92 {
                        if i + 1 >= to || !fieldChar[Byte.toInt(s[i + 1])] { return -1 }
                        i = i + 1
                    } else if !quotedChar[c] {
                        return -1
                    }
                    i = i + 1
                }
                if !closed { return -1 }
            } else {
                let value = i
                while i < to && tchar[Byte.toInt(s[i])] { i = i + 1 }
                if i == value { return -1 }
            }
        }
    }
    size
}

fun skipWhite(s : Array Byte, from : Int, to : Int) -> Int {
    var i = from
    while i < to && ows[Byte.toInt(s[i])] { i = i + 1 }
    i
}

let reservedNames = ["content-length", "transfer-encoding", "host", "connection", "expect", "upgrade",
                     "keep-alive", "te", "trailer", "proxy-connection"]

-- `name ":" OWS value OWS` up to the CRLF ending at `lfAt`, as `name: value`
-- with the name lowercase, or `None` if it is not one or names a reserved
-- field.
fun trailerLine(s : Array Byte, from : Int, lfAt : Int) -> Option String {
    let crAt = lfAt - 1
    if crAt < from || Byte.toInt(s[crAt]) != cr { return None }
    var i = from
    while i < crAt && tchar[Byte.toInt(s[i])] { i = i + 1 }
    if i == from || i >= crAt || Byte.toInt(s[i]) != 58 { return None }
    let name = lowerText(s, from, i)
    if Array.contains(reservedNames, name) { return None }
    var start = skipWhite(s, i + 1, crAt)
    var end = crAt
    for var k = start; k < crAt; k = k + 1 {
        if !fieldChar[Byte.toInt(s[k])] { return None }
    }
    while end > start && ows[Byte.toInt(s[end - 1])] { end = end - 1 }
    Some(name + ": " + String.fromBytesLossy(Array.slice(s, start, end)))
}
