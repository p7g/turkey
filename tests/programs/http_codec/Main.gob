-- The HTTP/1 codec, with no sockets: the head parser on the rules HTTP's CVEs
-- taught servers to enforce, the body layers driven from sources that hand
-- out bytes in adversarial pieces, `Incoming`'s limits, the drain decision,
-- the serializer, and a mutation fuzz over heads and bodies.
--
-- `Bench.gob` beside this times the head parser and runs the fuzz longer;
-- `scripts/bench-http-codec.sh` runs it.

import Bodies (..)
import Fuzz (fuzzHeads, fuzzBodies)
import Heads (..)
import Writing (..)

fun main() {
    requests()
    responses()
    stageOne()
    bodies()
    incoming()
    draining()
    writing()
    print("-- fuzz")
    fuzzHeads(3000, 1)
    fuzzBodies(3000, 2)
}
