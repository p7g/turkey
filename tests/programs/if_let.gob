-- `if let`, `if var` and `while let` (SPEC-DELTAS 63). Each is a `match` with a
-- wildcard arm, written by the parser; this program pins what they mean.
type Shape = Circle(Int) | Square(Int) | Dot

fun area(s : Shape) -> Int {
    if let Circle(r) = s { return 3 * r * r }
    else if let Square(w) = s { return w * w }
    0
}

-- Without an `else` the other arm is `()`, so the then-block is a statement.
fun announce(o : Option String) {
    if let Some(name) = o { print("hello, " + name) }
}

-- `var` makes the binders reassignable, and the reassignment stays local.
fun countdown(o : Option Int) -> Int {
    if var Some(n) = o {
        while n > 0 { n = n - 1 }
        n
    } else {
        -1
    }
}

-- The canonical drain: one line, and `continue` evaluates the condition again.
fun drainOdd(xs : Array Int) -> Array Int {
    let out = [] : Array Int
    while let Some(x) = Array.pop(xs) {
        if x % 2 == 0 { continue }
        Array.push(out, x)
    }
    out
}

fun main() {
    print(Int.toString(area(Circle(2))))
    print(Int.toString(area(Square(3))))
    print(Int.toString(area(Dot)))
    announce(Some("world"))
    announce(None)
    print(Int.toString(countdown(Some(5))))
    print(Int.toString(countdown(None)))
    for x in drainOdd([1, 2, 3, 4, 5]) { print(Int.toString(x)) }
    -- An irrefutable pattern is accepted; there is no warning to give.
    if let (a, b) = (1, 2) { print(Int.toString(a + b)) }
}
