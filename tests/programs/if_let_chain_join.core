-- bindings
Main#report : fun(Option Int, Vec Int) -> Unit =
  fun(o : Option Int, table : Vec Int) {
    join %next1() : Unit = {
      Turkey.Stdout#print[String](%inst.Text.Show#Show.Data.String#String)("none")
    }
    match o {
      Data.Option#Some(i) ->
        if %inst.Data.Ord#Ord.Int.gte(i, 0) {
          match Data.Vec#at[Int](table, i) {
            Data.Option#Some(v) ->
              Turkey.Stdout#print[Int](%inst.Text.Show#Show.Int)(v)
            _ ->
              jump %next1()
          }
        } else {
          jump %next1()
        }
      _ ->
        jump %next1()
    }
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      Main#report(Data.Option#Some(1), Data.Vec#Vec(Data.Vec#VecStorage([10, 20], 2)))
    let %seq2 : Unit =
      Main#report(Data.Option#Some(%inst.Data.Num#Neg.Int.neg(1)), Data.Vec#Vec(Data.Vec#VecStorage([10, 20], 2)))
    let %seq3 : Unit =
      Main#report(Data.Option#Some(5), Data.Vec#Vec(Data.Vec#VecStorage([10, 20], 2)))
    Main#report(Data.Option#None, Data.Vec#Vec(Data.Vec#VecStorage([10, 20], 2)))
  }
