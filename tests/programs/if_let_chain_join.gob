-- A three-condition head fails in three places, and all three reach one
-- `else`: the Core below holds `print("none")` once, as a join every failure
-- jumps to.
fun report(o : Option Int, table : Vec Int) {
    if let Some(i) = o, i >= 0, let Some(v) = Vec.at(table, i) {
        print(v)
    } else {
        print("none")
    }
}

fun main() {
    report(Some(1), [10, 20])
    report(Some(-1), [10, 20])
    report(Some(5), [10, 20])
    report(None, [10, 20])
}
