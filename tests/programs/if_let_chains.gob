-- Condition lists in `if` and `while` heads. Each is a `match` with one
-- guarded arm and a wildcard arm, written by the parser; this program pins
-- what they mean.
type Shape = Circle(Int) | Square(Int) | Dot

-- A test after a binding sees it, and failing it takes the `else`.
fun describe(o : Option Int) -> String {
    if let Some(x) = o, x > 2 { "big " + show(x) } else { "other" }
}

-- A second `let` matches a value computed from the first's binding.
fun halfOfEven(s : String) -> Option Int {
    if let Some(n) = Int.parse(s), n % 2 == 0, let Some(h) = halve(n) {
        return Some(h)
    }
    None
}

fun halve(n : Int) -> Option Int = if n == 0 { None } else { Some(n / 2) }

-- A head may start with a test, and a `let` may have alternatives.
fun side(s : Shape, enabled : Bool) -> Int {
    if enabled, let Circle(r) | Square(r) = s, r > 0 { r } else { -1 }
}

-- A condition's binding is not visible in the `else`: the outer `x` is.
fun shadow(o : Option Int, x : Int) -> Int {
    if let Some(x) = o, x > 0 { x } else { x }
}

-- `return` and `break` in the `else` act on the function and the loop.
fun firstLarge(xs : Vec (Option Int)) -> Int {
    for o in xs {
        if let Some(n) = o, n > 10 { return n } else { continue }
    }
    0
}

fun stopAtNone(xs : Vec (Option Int)) -> Int {
    var total = 0
    for o in xs {
        if let Some(n) = o, n >= 0 { total = total + n } else { break }
    }
    total
}

-- `else if` chains take condition lists too.
fun classify(a : Option Int, b : Option Int) -> String {
    if let Some(x) = a, x > 0 { "a" }
    else if let Some(y) = b, y > 0 { "b" }
    else { "neither" }
}

-- `var` binders are assignable in the block, and only there.
fun bumped(o : Option Int) -> Int {
    if var Some(n) = o, n < 10 {
        n = n + 1
        n
    } else {
        0
    }
}

-- The first condition may open an existential, and the rest see what it opened.
type Shown = Shown[Show a](a)

fun shownLong(c : Shown) -> String {
    if let Shown(v) = c, String.byteLength(show(v)) > 2 { show(v) } else { "short" }
}

-- A later `let` may have alternatives too.
fun depth(o : Option Shape) -> Int {
    if let Some(s) = o, let Circle(n) | Square(n) = s { n } else { 0 }
}

-- `while` stops at the first condition that fails, and `continue` evaluates
-- every condition again.
fun drainSmall(xs : Vec Int) -> Vec Int {
    let out = [] : Vec Int
    while let Some(x) = Vec.pop(xs), x < 10 {
        if x % 2 == 0 { continue }
        Vec.push(out, x)
    }
    out
}

fun main() {
    print(describe(Some(5)))
    print(describe(Some(1)))
    print(describe(None))
    print(halfOfEven("8"))
    print(halfOfEven("7"))
    print(halfOfEven("0"))
    print(halfOfEven("x"))
    print(side(Circle(3), True))
    print(side(Square(4), True))
    print(side(Square(4), False))
    print(side(Circle(0), True))
    print(side(Dot, True))
    print(shadow(Some(7), 100))
    print(shadow(Some(-7), 100))
    print(shadow(None, 100))
    print(firstLarge([Some(1), None, Some(12), Some(30)]))
    print(firstLarge([Some(1)]))
    print(stopAtNone([Some(1), Some(2), None, Some(4)]))
    print(stopAtNone([Some(1), Some(-2), Some(4)]))
    print(classify(Some(1), Some(1)))
    print(classify(Some(0), Some(1)))
    print(classify(None, Some(0)))
    print(bumped(Some(3)))
    print(bumped(Some(30)))
    print(drainSmall([20, 1, 2, 3, 4, 5]))
    print(shownLong(Shown(12345)))
    print(shownLong(Shown(7)))
    print(depth(Some(Square(6))))
    print(depth(Some(Dot)))
    print(depth(None))
}
