module Forest (Forest(..), names)
import Tree (Tree(..), Size(..))

type Forest = Forest(Array Tree)

-- The class is Tree's and the type is this module's, so the instance lives
-- here with its type.
instance Size Forest {
    fun size(f) = match f {
        Forest(trees) -> {
            var total = 0
            for t in trees { total = total + size(t) }
            total
        }
    }
}

fun names(f : Forest) -> Array String = match f {
    Forest(trees) -> {
        let out = []
        for t in trees {
            match t {
                Node(name, kids) -> {
                    Vec.push(out, name)
                    for n in names(kids) { Vec.push(out, n) }
                }
            }
        }
        Vec.toArray(out)
    }
}
