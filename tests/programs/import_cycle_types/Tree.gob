module Tree (Tree(..), Size(..), leaf)
import Forest (Forest(..))

-- A tree's children are a forest, and a forest is a list of trees: two types
-- that need each other, in two modules that import each other.
type Tree = Node(String, Forest)

class Size a {
    fun size(a) -> Int
}

instance Size Tree {
    fun size(t) = match t {
        Node(_, kids) -> 1 + size(kids)
    }
}

fun leaf(name : String) -> Tree = Node(name, Forest([]))
