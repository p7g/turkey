-- The import forms side by side: what each brings bare, and that the
-- qualifier reaches every export whatever the list says.

-- A rename: `area` comes in bare as `size`, and `Shapes.area` stays.
import Shapes (area as size)
-- An alias with a list: bare `name`, and every export as `S.`.
import Shapes as S (name)
-- Every bare name but the type and its constructors, which stay qualified.
import Shapes as Sh (Shape(..) as _, ..)

fun main() {
    let c = Shapes.Circle(2)
    print(size(c))
    print(Shapes.area(c))
    print(name(S.Square(3)))
    print(S.area(S.Square(3)))
    print(area(Sh.Square(4)))
    match c {
        Sh.Circle(r) -> print(r)
        Sh.Square(_) -> print(0)
    }
}
