-- A small callee whose parameter and local are spelled like its caller's
-- `var`s. Inlining binds them as `let`s beside those `var`s, and each name
-- must go on meaning its own binding: the callee's `i` is not the loop's.

fun at(text : String, i : Int) -> Int {
    let code = Byte.toInt(String.toBytes(text)[i])
    code
}

fun leadingSpaces(text : String) -> Int {
    var i = 0
    var code = 0
    while i < String.byteLength(text) && at(text, i) == 32 {
        code = code + at(text, i)
        i = i + 1
    }
    i * 1000 + code
}

fun main() {
    print(leadingSpaces("   indented"))
    print(leadingSpaces("flush"))
    var total = 0
    for word in ["one", "three", "five"] {
        let counted = fun() = total + String.byteLength(word)
        total = counted()
    }
    print(total)
}
