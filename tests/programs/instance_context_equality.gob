-- An equality in an instance's context: reading from a `Layer s` may also
-- write to the `s` underneath, so its failure has to be the stream's read
-- failure and its write failure at once.

class Source s {
    type Failure s
    fun pull(s) -> Either (Failure s) Int
}

class Sink s {
    type Trouble s
    fun push(s, Int) -> Either (Trouble s) Unit
}

type Pipe = Pipe { var left : Int }

instance Source Pipe {
    type Failure = String
    fun pull(p) {
        if p.left == 0 { return Left("drained") }
        p.left = p.left - 1
        Right(p.left)
    }
}

instance Sink Pipe {
    type Trouble = String
    fun push(p, n) {
        p.left = p.left + n
        Right(())
    }
}

type Layer s = Layer { inner : s }

instance Source (Layer s) : Source s, Sink s, Failure s ~ Trouble s {
    type Failure = Failure s
    fun pull(Layer { inner }) {
        push(inner, 1)?
        pull(inner)
    }
}

fun main() {
    let pipe = Pipe { left = 0 }
    print(pull(pipe))
    print(pull(Layer { inner = pipe }))
    print(pull(Layer { inner = pipe }))
}
