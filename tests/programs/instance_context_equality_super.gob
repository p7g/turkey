-- An instance with an equality in its context is a superclass instance like
-- any other: `Sub (W a)` finds `Base (W a)` under the same equality.

class Base a {
    type K a
    fun k(a) -> K a
}

class Sub a : Base a {
    fun twice(x : a) -> K a = k(x)
}

type W a = W(a)

instance Base Int {
    type K = Int
    fun k(x) = x
}

instance Base (W a) : Base a, K a ~ Int {
    type K = Int
    fun k(W(x)) = k(x) + 1
}

instance Sub (W a) : Base a, K a ~ Int {}

fun main() {
    print(k(W(1)))
    print(k(W(W(1))))
    print(twice(W(5)))
}
