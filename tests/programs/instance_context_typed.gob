-- A 'Typed' constraint in an instance's context need not be smaller than the
-- head: only the compiler's own instances solve one, and they terminate.

type W a = W(a)

class Named a { fun name(a) -> String }

instance Named (W a) : Typed (W (W a)) { fun name(_) = "w" }

fun main() { print(name(W(1))) }
