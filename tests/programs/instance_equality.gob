-- An equality in an instance's context. `Layer s` pulls from `s` after
-- pushing to it, so its failure is both of `s`'s; the context says they are
-- one type. `main` uses the instance at `Pipe`, where Mono specializes it, and
-- `go` uses it at a variable, where the signature's equality proves the
-- instance's.

class Source s {
    type Failure s
    fun pull(s) -> Either (Failure s) Int
}

class Sink s {
    type Trouble s
    fun push(s, Int) -> Either (Trouble s) Unit
}

type Layer s = Layer { inner : s }

instance Source (Layer s) : Source s, Sink s, Failure s ~ Trouble s {
    type Failure = Failure s
    fun pull(Layer { inner }) {
        push(inner, 1)?
        pull(inner)
    }
}

type Pipe = Pipe(Int)

instance Source Pipe {
    type Failure = String
    fun pull(Pipe(n)) = if n < 0 { Left("closed") } else { Right(n) }
}

instance Sink Pipe {
    type Trouble = String
    fun push(Pipe(n), x) = if n == 0 { Left("full") } else { Right(()) }
}

fun report[Source s, Show (Failure s)](s : s) -> String = match pull(s) {
    Left(e) -> "failed: " + show(e)
    Right(n) -> "pulled " + show(n)
}

fun go[Source s, Sink s, Failure s ~ Trouble s, Show (Failure s)](x : s) -> String =
    report(Layer { inner = x })
fun main() {
    print(go(Pipe(5)))
    print(report(Layer { inner = Pipe(3) }))
    print(report(Layer { inner = Pipe(0) }))
    print(report(Layer { inner = Pipe(-1) }))
}
