-- At `Wrap a`, `code`'s own `Elem (Wrap a) ~ Bool` reduces to `Elem a ~ Bool`,
-- which the instance's `Elem a ~ Int` contradicts. The override can never be
-- called, so it is not checked and its slot is a stub. `Tag (Wrap a)` has an
-- equality and no class in its context.

class Box a {
    type Elem a
    fun open(a) -> Elem a
    fun code[Elem a ~ Bool](a) -> Int
}
type Wrap a = Wrap(a)
type Flag = Flag(Bool)
instance Box Int {
    type Elem = Int
    fun open(x) = x
    fun code(x) = 0
}
instance Box Flag {
    type Elem = Bool
    fun open(Flag(b)) = b
    fun code(f) = if open(f) { 1 } else { 2 }
}
instance Box (Wrap a) : Box a, Elem a ~ Int {
    type Elem = Elem a
    fun open(Wrap(x)) = open(x) + 1
    fun code(w) = if open(w) { 1 } else { 2 }
}
class Tag a {
    fun tag(a) -> String
}
instance Tag (Wrap a) : Elem a ~ Int {
    fun tag(_) = "wrapped"
}
fun twice[Box a, Elem a ~ Int](x : a) -> Int = open(Wrap(x)) * 2
fun main() {
    print(open(Wrap(3)))
    print(open(Wrap(Wrap(3))))
    print(twice(4))
    print(code(Flag(True)))
    print(tag(Wrap(1)))
}
