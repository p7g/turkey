-- 'Wide (W a)' has the context 'Bytes a, Key a ~ Int': a class predicate
-- that grants 'Value a ~ Byte' through its equality superclass, and an
-- equality written beside it. The overrides are checked under both, and so
-- is the decision to stub one. 'byteSum' requires 'Value s ~ Byte', which
-- agrees with them, so it is called. 'asInt' requires 'Value s ~ Int', which
-- contradicts 'Value a ~ Byte', so at 'W a' it can never be called, and its
-- slot is a stub.

class Bytes s : Index s, Value s ~ Byte {}

class Wide s : Index s {
    fun byteSum[Value s ~ Byte](s) -> Int
    fun asInt[Value s ~ Int](s) -> Int
}

type Packet = Packet(Array Byte)

instance Index Packet {
    type Key = Int
    type Value = Byte
    fun get(Packet(bytes), i) = bytes[i]
}

instance Bytes Packet {}

type W a = W(a)

instance Index (W a) : Index a {
    type Key = Key a
    type Value = Value a
    fun get(W(x), i) = x[i]
}

instance Bytes (W a) : Bytes a {}

instance Wide (W a) : Bytes a, Key a ~ Int {
    -- 'x[0]' needs the written 'Key a ~ Int'; 'Byte.toInt' needs the granted
    -- 'Value a ~ Byte'.
    fun byteSum(x) = Byte.toInt(x[0]) + Byte.toInt(x[1])
    fun asInt(x) = x[0] + 1
}

fun main() {
    let w = W(Packet(Array.map([20, 22], Byte.truncate)))
    print(byteSum(w))
    print(byteSum(W(w)))
}
