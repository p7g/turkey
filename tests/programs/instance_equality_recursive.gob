-- An instance with an equality in its context, used by its own methods and
-- under polymorphic recursion: `deep` builds `W (W (W Int))` one layer per
-- call, so its dictionary is built from the instance at each depth rather
-- than specialized once.

class Base a {
    type K a
    fun k(a) -> K a
    fun twice(a) -> K a
}
type W a = W(a)
instance Base Int {
    type K = Int
    fun k(x) = x
    fun twice(x) = x * 2
}
instance Base (W a) : Base a, K a ~ Int {
    type K = Int
    fun k(W(x)) = k(x) + 1
    fun twice(w) = k(w) * 2
}
fun deep[Base a, K a ~ Int](x : a, n : Int) -> Int =
    if n == 0 { k(x) } else { deep(W(x), n - 1) }
fun main() {
    print(twice(W(W(1))))
    print(deep(5, 3))
}
