-- A superclass check that needs an equality in the superclass instance's
-- context: `Sub (W a)` needs `Base (W a)`, whose context asks for
-- `K a ~ Int`, and `Sub (W a)`'s own context grants it.

class Base a {
    type K a
    fun k(a) -> K a
}
class Sub a : Base a {}
type W a = W(a)
instance Base Int {
    type K = Int
    fun k(x) = x
}
instance Base (W a) : Base a, K a ~ Int {
    type K = Int
    fun k(W(x)) = k(x) + 1
}
instance Sub (W a) : Base a, K a ~ Int {}
fun main() { print(k(W(1))) }
