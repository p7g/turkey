-- dictionaries
%inst.Main#Q.Main#Box : forall a. fun(P a) -> Q (Box a) =
  fun(%d.Main#P : P a) {
    %Dict.Main#Q {
      q =
        fun(%param : Box a) {
          match %param {
            Main#Box(v) ->
              %inst.Data.Num#Add.Int.add(%d.Main#P.p(v), 1)
          }
        }
    }
  }

%inst.Main#P.Int : P Int =
  %Dict.Main#P {
    p =
      fun(n : Int) {
        %inst.Data.Num#Mul.Int.mul(n, 10)
      }
  }

-- bindings
Main#anything : forall a. fun(Unit) -> a =
  fun(u : Unit) {
    Control.Panic#error[a]("never")
  }

Main#viaGiven : forall a. fun(Q (Box a)) -> fun(a) -> Int =
  fun(%d.Main#Q : Q (Box a)) {
    fun(x : a) {
      let y : %Ref a =
        ref(Main#anything[a](()))
      let n : Int =
        %d.Main#Q.q(Main#Box(!y))
      let idf : forall b. fun(b) -> b =
        fun(z : b) {
          z
        }
      let %seq : Unit =
        y := x
      idf[Int](n)
    }
  }

Main#viaInstance : forall a. fun(Q (Box a)) -> fun(a) -> Int =
  fun(%d.Main#Q : Q (Box a)) {
    fun(x : a) {
      %inst.Main#Q.Main#Box[Int](%inst.Main#P.Int).q(Main#Box(1))
    }
  }

Main#main : fun() -> Unit =
  fun() {
    Turkey.Stdout#print[Int](%inst.Text.Show#Show.Int)(Main#viaInstance[Int](%inst.Main#Q.Main#Box[Int](%inst.Main#P.Int))(7))
  }
