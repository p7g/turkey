-- A wanted that a given might still match waits for the given rather than
-- taking an instance. In `viaGiven`, `q(Box(y))` needs `Q (Box b)` while
-- `y`'s type `b` is unknown, and the signature grants `Q (Box a)`. The
-- instance would leave `P b`, which nothing grants; the given matches once
-- `y = x` makes `b` the signature's `a`. The local `idf` solves its own
-- definition in between, which must not decide the question early.
class P x { fun p(x) -> Int }
class Q x { fun q(x) -> Int }

type Box a = Box(a)

instance Q (Box x) : P x { fun q(Box(v)) = p(v) + 1 }
instance P Int { fun p(n) = n * 10 }

-- Never called: only its checking is the point.
fun anything(u : Unit) -> a = error("never")

fun viaGiven[Q (Box a)](x : a) -> Int {
    var y = anything(())
    let n = q(Box(y))
    let idf = fun(z) = z
    y = x
    idf(n)
}

-- Here the given never matches: the literal's type is decided by
-- defaulting, as `Int`, and then the instance is taken.
fun viaInstance[Q (Box a)](x : a) -> Int = q(Box(1))

fun main() {
    print(viaInstance(7))
}
