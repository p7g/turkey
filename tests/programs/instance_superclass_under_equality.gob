-- 'Less (Box a)' needs its superclass 'Same (Box a)', whose instance needs
-- 'Same (Elem a)'. The context's 'Elem a ~ Int' makes that 'Same Int', which
-- has an instance, so the superclass is proved under the context's equality.
class Bag b { type Elem b }
class Same a { fun same(a, a) -> Bool }
class Less a : Same a { fun less(a, a) -> Bool }

instance Same Int { fun same(x, y) = x == y }

type Box a = Box(a)
type Ints = Ints(Array Int)

instance Bag Ints { type Elem = Int }

instance Same (Box a) : Bag a, Same (Elem a) { fun same(x, y) = True }
instance Less (Box a) : Bag a, Elem a ~ Int { fun less(x, y) = False }

-- 'same' here is the superclass of the 'Less' dictionary.
fun compare[Less a](x : a, y : a) -> String =
    if same(x, y) { if less(x, y) { "less" } else { "same" } } else { "other" }

fun main() { print(compare(Box(Ints([1])), Box(Ints([2])))) }
