-- An instance with no methods still holds its superclasses: 'Named (Box a)'
-- defines nothing, and 'describe' reaches 'Show (Box a)' through it.
class Named a : Show a {}

type Box a = Box(a)

instance Show (Box a) : Show a { fun show(Box(x)) = "Box(" + show(x) + ")" }
instance Named (Box a) : Show a {}

fun describe[Named a](x : a) -> String = "named " + show(x)

fun main() { print(describe(Box(3))) }
