-- The integer helpers an Advent of Code solution leans on: floored division
-- with negative operands, gcd/lcm, powers, integer square root, bit counts
-- and radix conversion.

fun row(label : String, n : Int) -> Unit = print(label + " " + Int.toString(n))

fun main() {
    -- Floored division pairs with `Int.mod`; `/` and `%` truncate.
    for (a, b) in [(7, 2), (-7, 2), (7, -2), (-7, -2), (6, 3), (-6, 3), (0, -5)] {
        let (q, r) = Int.divMod(a, b)
        print(Int.toString(a) + " " + Int.toString(b) + " -> " + Int.toString(q) + " " + Int.toString(r)
            + " (" + Int.toString(a / b) + " " + Int.toString(a % b) + ")")
    }

    row("sign", Int.sign(-40))
    row("sign", Int.sign(0))
    row("sign", Int.sign(99))

    row("gcd", Int.gcd(12, 18))
    row("gcd", Int.gcd(-12, 18))
    row("gcd", Int.gcd(12, -18))
    row("gcd", Int.gcd(0, 5))
    row("gcd", Int.gcd(5, 0))
    row("gcd", Int.gcd(0, 0))
    row("gcd", Int.gcd(17, 5))
    row("gcd", Int.gcd(Int.minValue(), 6))
    row("gcd", Int.gcd(6, Int.minValue()))
    row("gcd", Int.gcd(Int.minValue(), -1))
    row("gcd", Int.gcd(Int.minValue(), Int.maxValue()))
    row("gcd", Int.gcd(Int.minValue(), 4611686018427387904))
    row("lcm", Int.lcm(4, 6))
    row("lcm", Int.lcm(-4, 6))
    row("lcm", Int.lcm(0, 6))
    row("lcm", Int.lcm(21, 6))

    row("pow", Int.pow(2, 10))
    row("pow", Int.pow(-3, 3))
    row("pow", Int.pow(-2, 62))
    row("pow", Int.pow(0, 0))
    row("pow", Int.pow(7, 0))
    row("pow", Int.pow(1, 1000000))
    row("pow", Int.pow(2, 62))
    row("pow", Int.pow(3, 39))
    row("pow", Int.pow(-2, 63))

    row("powMod", Int.powMod(2, 10, 1000))
    row("powMod", Int.powMod(3, 0, 7))
    row("powMod", Int.powMod(3, 0, 1))
    row("powMod", Int.powMod(-2, 3, 7))
    row("powMod", Int.powMod(7, 1000000006, 1000000007))
    -- A modulus whose products overflow `Int`.
    row("powMod", Int.powMod(123456789012345, 987654321, 9223372036854775807))
    row("powMod", Int.powMod(2, 62, 4611686018427387903))

    row("isqrt", Int.isqrt(0))
    row("isqrt", Int.isqrt(1))
    row("isqrt", Int.isqrt(15))
    row("isqrt", Int.isqrt(16))
    row("isqrt", Int.isqrt(17))
    row("isqrt", Int.isqrt(1000000))
    row("isqrt", Int.isqrt(Int.maxValue()))

    for n in [0, 1, 2, 255, 256, -1, Int.minValue(), Int.maxValue(), 0x0F0F_0000] {
        print(Int.toString(n) + ": ones " + Int.toString(Int.countOnes(n))
            + " lead " + Int.toString(Int.leadingZeros(n))
            + " trail " + Int.toString(Int.trailingZeros(n)))
    }

    -- Radix formatting and parsing.
    for (n, radix) in [(255, 16), (255, 2), (-255, 16), (0, 2), (35, 36), (10, 10), (-1, 36)] {
        let s = Int.toStringRadix(n, radix)
        print(s + " " + show(Int.parseRadix(s, radix)))
    }
    print(Int.toStringRadix(Int.minValue(), 2))
    print(Int.toStringRadix(Int.minValue(), 16))
    print(Int.toStringRadix(Int.maxValue(), 36))
    print(show(Int.parseRadix("-8000000000000000", 16)))
    print(show(Int.parseRadix("8000000000000000", 16)))
    print(show(Int.parseRadix("7fffffffffffffff", 16)))
    print(show(Int.parseRadix("7FFFFFFFFFFFFFFF", 16)))
    print(show(Int.parseRadix("+ff", 16)))
    print(show(Int.parseRadix("Zz", 36)))
    print(show(Int.parseRadix("102", 2)))
    print(show(Int.parseRadix("8", 8)))
    print(show(Int.parseRadix("g", 16)))
    print(show(Int.parseRadix("", 16)))
    print(show(Int.parseRadix("-", 16)))
    print(show(Int.parseRadix("0xff", 16)))
    print(show(Int.parseRadix(" ff", 16)))
    print(show(Int.parseRadix("1_0", 10)))
    print(show(Int.parse("12")))
    print(show(Int.parse("-9223372036854775808")))
    print(show(Int.parse("9223372036854775808")))
}
