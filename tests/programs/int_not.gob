-- `Int.not` flips every bit: in two's complement that is `-n - 1`, so it
-- takes the extremes to each other and is its own inverse.
--
-- The operands come out of an array, so `opt` cannot fold the primitive away
-- and the backend has to lower it.

fun main() {
    for n in [0, 5, -1, -6, 0xFF, Int.maxValue(), Int.minValue()] {
        let flipped = Int.not(n)
        print(show(n) + " " + show(flipped) + " " + show(Int.not(flipped) == n))
    }
    print(show(Int.and(0xF0F0, Int.not(0xFF))))
}
