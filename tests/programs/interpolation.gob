-- String literals with holes: what each hole may hold, how holes nest, and
-- which characters stay literal.

type Point = Point { x : Int, y : Int }

fun counted(log : Vec String, label : String) -> String {
	Vec.push(log, label)
	label
}

fun main() {
	let year = 2026
	let day = 3
	print("https://adventofcode.com/${year}/day/${day}/input")
	let name = "world"
	print("hello, ${name}!")
	print("${name}")
	print("${1 + 2} and ${[1, 2, 3]}")
	print("tuple ${(1, "a")} option ${Some(3)}")

	-- A string inside a hole, with a hole of its own.
	print("nested: ${"inner ${day * 2}"}")

	-- Braces inside a hole nest, so a record or a block can stand in one.
	let p = Point { x = 1, y = 2 }
	print("record: ${p.x + p.y} ${Point { x = 3, y = 4 }.x}")
	print("${if day > 2 { "big" } else { "small" }}")

	-- A `$` before anything but `{` is literal, and `\$` is a `$` anywhere.
	print("price: $5, literal \${x}, lone $")

	-- Each hole is evaluated once, left to right.
	let log = []
	print("${counted(log, "a")}${counted(log, "b")}${counted(log, "c")}")
	print(log)

	-- A hole is a boundary of a placeholder function.
	print(Array.map([1, 2], "#${_}"))

	-- Empty pieces push nothing, and a lone hole is its value's text.
	print("${""}")
	print("${day}")

	-- `debug` writes a string as a literal that reads back as it, so a `$`
	-- before a `{` is escaped and any other `$` is not.
	print(["\${", "$", "a$", "$$\${x}"])
	print(debug("cost: $5, written \${total}"))
}
