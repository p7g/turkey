-- The lazy adapters of `Iter`, each on an ordinary input and on the edges:
-- an empty input, an input shorter than the adapter needs, and an endless
-- source that only a `break`, a `return` or another adapter ends. Each line
-- of output is labelled with the expression it shows.

fun check[Show a](label : String, value : a) {
    print(label + " = " + show(value))
}

fun firstSquareOver(limit : Int) -> Int {
    for x in Iter.countFrom(1) {
        if x * x > limit { return x }
    }
    -1
}

fun main() {
    let xs = [3, 1, 4, 1, 5]
    let empty : Array Int = []

    check("enumerate([\"a\", \"b\", \"c\"])", Iter.collect(Iter.enumerate(["a", "b", "c"])))
    check("enumerate(empty)", Iter.collect(Iter.enumerate(empty)))

    check("zip(xs, [\"x\", \"y\"])", Iter.collect(Iter.zip(xs, ["x", "y"])))
    check("zip(countFrom(10), xs)", Iter.collect(Iter.zip(Iter.countFrom(10), xs)))
    check("zip(empty, xs)", Iter.collect(Iter.zip(empty, xs)))

    check("map(xs, \\_ * 10)", Iter.collect(Iter.map(xs, \_ * 10)))
    check("filter(xs, \\_ > 1)", Iter.collect(Iter.filter(xs, \_ > 1)))
    check("filter(xs, \\_ > 9)", Iter.collect(Iter.filter(xs, \_ > 9)))

    check("takeWhile(map(countFrom(1), \\_ * _), \\_ < 50)", Iter.collect(Iter.takeWhile(Iter.map(Iter.countFrom(1), \_ * _), \_ < 50)))
    check("dropWhile(xs, \\_ != 4)", Iter.collect(Iter.dropWhile(xs, \_ != 4)))
    check("dropWhile(xs, \\_ > 0)", Iter.collect(Iter.dropWhile(xs, \_ > 0)))
    check("take(countFrom(7), 3)", Iter.collect(Iter.take(Iter.countFrom(7), 3)))
    check("take(xs, 0)", Iter.collect(Iter.take(xs, 0)))
    check("take(xs, 99)", Iter.collect(Iter.take(xs, 99)))
    check("drop(xs, 2)", Iter.collect(Iter.drop(xs, 2)))
    check("drop(xs, 99)", Iter.collect(Iter.drop(xs, 99)))

    check("pairwise(xs)", Iter.collect(Iter.pairwise(xs)))
    check("pairwise([1])", Iter.collect(Iter.pairwise([1])))
    check("pairwise(empty)", Iter.collect(Iter.pairwise(empty)))
    check("windowed(xs, 3)", Iter.collect(Iter.windowed(xs, 3)))
    check("windowed(xs, 6)", Iter.collect(Iter.windowed(xs, 6)))
    check("windowed(xs, 1)", Iter.collect(Iter.windowed(xs, 1)))
    check("chunked(xs, 2)", Iter.collect(Iter.chunked(xs, 2)))
    check("chunked(empty, 2)", Iter.collect(Iter.chunked(empty, 2)))

    check("take(cycle([\"x\", \"y\"]), 5)", Iter.collect(Iter.take(Iter.cycle(["x", "y"]), 5)))
    check("cycle(empty)", Iter.collect(Iter.cycle(empty)))
    check("chain(xs, [9, 2])", Iter.collect(Iter.chain(xs, [9, 2])))
    check("chain(empty, empty)", Iter.collect(Iter.chain(empty, empty)))

    check("combinations([1, 2, 3, 4], 2)", Iter.collect(Iter.combinations([1, 2, 3, 4], 2)))
    check("combinations([1, 2], 0)", Iter.collect(Iter.combinations([1, 2], 0)))
    check("combinations([1, 2], 3)", Iter.collect(Iter.combinations([1, 2], 3)))
    check("count(combinations(Array.init(40, \\_), 3), fun(_) = True)", Iter.count(Iter.combinations(Array.init(40, \_), 3), fun(_) = True))
    check("permutations([1, 2, 3], 2)", Iter.collect(Iter.permutations([1, 2, 3], 2)))
    check("permutations([1, 2, 3], 3)", Iter.collect(Iter.permutations([1, 2, 3], 3)))
    check("permutations([1, 2], 0)", Iter.collect(Iter.permutations([1, 2], 0)))
    check("permutations([1, 2], 3)", Iter.collect(Iter.permutations([1, 2], 3)))
    check("count(permutations(Array.init(6, \\_), 4), fun(_) = True)", Iter.count(Iter.permutations(Array.init(6, \_), 4), fun(_) = True))
    check("cartesian([1, 2], [\"a\", \"b\"])", Iter.collect(Iter.cartesian([1, 2], ["a", "b"])))
    check("cartesian(empty, xs)", Iter.collect(Iter.cartesian(empty, xs)))
    check("cartesian(xs, empty)", Iter.collect(Iter.cartesian(xs, empty)))
    check("cartesianPower([0, 1], 2)", Iter.collect(Iter.cartesianPower([0, 1], 2)))
    check("cartesianPower([0, 1], 0)", Iter.collect(Iter.cartesianPower([0, 1], 0)))
    check("cartesianPower(empty, 2)", Iter.collect(Iter.cartesianPower(empty, 2)))
    check("count(cartesianPower([1, 2, 3], 4), fun(_) = True)", Iter.count(Iter.cartesianPower([1, 2, 3], 4), fun(_) = True))

    -- Endless sources, ended by the consumer.
    check("firstSquareOver(50)", firstSquareOver(50))
    check("any(countFrom(0), \\_ * _ > 50)", Iter.any(Iter.countFrom(0), \_ * _ > 50))
    check("find(map(countFrom(0), \\_ * 3), \\_ > 50)", Iter.find(Iter.map(Iter.countFrom(0), \_ * 3), \_ > 50))
    check("take(cartesian(countFrom(0), empty), 1)",
          Iter.collect(Iter.take(Iter.cartesian(Iter.countFrom(0), empty), 1)))
    var ticks = 0
    for (i, word) in Iter.enumerate(Iter.cycle(["tick", "tock"])) {
        if i == 3 { break }
        check("cycle word " + show(i), word)
        ticks = ticks + 1
    }
    check("ticks before break", ticks)

    -- An adapter describes a walk; iterating it again starts over.
    let pairs = Iter.pairwise(xs)
    check("collect(pairs) == collect(pairs)", Iter.collect(pairs) == Iter.collect(pairs))

    -- Lazy: building an adapter calls nothing, and a pull calls `f` once.
    var calls = 0
    let doubled = Iter.map(xs, fun(x) {
        calls = calls + 1
        x * 2
    })
    check("calls after building", calls)
    check("first of doubled", Iter.find(doubled, \_ > 0))
    check("calls after one pull", calls)
    check("calls after take 3", {
        calls = 0
        let _ = Iter.collect(Iter.take(doubled, 3))
        calls
    })

    -- Each window is a fresh array: changing one leaves the next alone.
    let windows = Iter.collect(Iter.windowed([1, 2, 3, 4], 2))
    windows[0][1] = 99
    check("windows after changing the first", windows)
    let chunks = Iter.collect(Iter.chunked([1, 2, 3], 2))
    chunks[0][0] = 99
    check("chunks after changing the first", chunks)

    -- Stacked adapters.
    var total = 0
    for ((i, a), b) in Iter.zip(Iter.enumerate(xs), Iter.drop(xs, 1)) {
        total = total + i * a * b
    }
    check("sum of i * a * b over zip(enumerate(xs), drop(xs, 1))", total)

    -- Folds over adapters.
    check("sum(map(xs, square))", Iter.sum(Iter.map(xs, \_ * _)))
    check("maximum(zip(xs, [2, 7, 1]))", Iter.maximum(Iter.zip(xs, [2, 7, 1])))
    check("fold(enumerate(xs), 0, i * x)",
        Iter.fold(Iter.enumerate(xs), 0, fun(acc, (i, x)) = acc + i * x))
    check("minBy(windowed(xs, 2), sum)", Iter.minBy(Iter.windowed(xs, 2), Iter.sum))
}
