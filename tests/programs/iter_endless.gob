-- An iterator whose `next` never answers `None`: the only way out of a loop
-- over it is `return` or `break`. Once `next` is inlined the loop's `None` exit
-- is dead, and the function's return join is jumped to from inside the loop
-- alone, so the optimizer must not move that join's result into the loop.

type Naturals = Naturals { start : Int }
type NaturalsCursor = NaturalsCursor { var at : Int }

instance Iterator Naturals {
    type Item = Int
    type Cursor = NaturalsCursor
    fun iter(n) = NaturalsCursor { at = n.start }
    fun next(n, cur) {
        let k = cur.at
        cur.at = k + 1
        Some(k)
    }
}

fun naturalsFrom(start : Int) -> Naturals = Naturals { start }

fun anyOf(xs : Naturals, p : fun(Int) -> Bool) -> Bool {
    for x in xs {
        if p(x) { return True }
    }
    False
}

fun firstSquareOver(limit : Int) -> Int {
    for x in naturalsFrom(0) {
        if x * x > limit { return x }
    }
    -1
}

fun main() {
    let naturals = naturalsFrom(0)
    print(anyOf(naturals, \_ * _ > 50))
    print(Iterator.any(naturals, \_ > 9))
    print(Iterator.all(naturals, \_ < 10))
    print(Iterator.find(naturals, \_ % 7 == 6))
    print(firstSquareOver(50))
}
