-- An iterator whose `next` never answers `Done`: the only way out of a loop
-- over it is `return` or `break`. Once `next` is inlined the loop's `Done` exit
-- is dead, and the function's return join is jumped to from inside the loop
-- alone, so the optimizer must not move that join's result into the loop.
-- `early` is the same with no iterator: its one `return` comes before an
-- endless loop, under the join that loop's code leaves by.

type Naturals = Naturals { start : Int }

instance Iterator Naturals {
	type Item = Int
	type Cursor = Int
	fun iter(n) = n.start
	fun next(_, k) = Iter.Yield(k, k + 1)
}

fun naturalsFrom(start : Int) -> Naturals = Naturals { start }

fun anyOf(xs : Naturals, p : fun(Int) -> Bool) -> Bool {
	for x in xs {
		if p(x) { return True }
	}
	False
}

fun firstSquareOver(limit : Int) -> Int {
	for x in naturalsFrom(0) {
		if x * x > limit { return x }
	}
	-1
}

fun early(c : Bool) -> Option Int {
	if c { return Some(4) }
	loop {}
}

fun main() {
	let naturals = naturalsFrom(0)
	print(anyOf(naturals, \_ * _ > 50))
	print(Iter.any(naturals, \_ > 9))
	print(Iter.all(naturals, \_ < 10))
	print(Iter.find(naturals, \_ % 7 == 6))
	print(firstSquareOver(50))
	print(early(True))
}
