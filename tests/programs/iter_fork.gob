-- Each branch of a multi-shot `?` inside a `for` resumes from its own cursor,
-- so every branch sees exactly the elements the walk yields from there, even
-- through the adapters whose elements are arrays. A branch that resumed from a
-- shared, changed cursor would print windows or choices that never existed.

fun windows() {
	for w in Iter.windowed([1, 2, 3], 2) {
		let k = ["a", "b"]?
		print(k + show(w))
	}
	[()]
}

fun choices() {
	for c in Iter.combinations([1, 2, 3], 2) {
		let k = ["a", "b"]?
		print(k + show(c))
	}
	[()]
}

fun orderings() {
	for p in Iter.permutations([1, 2], 2) {
		let k = ["a", "b"]?
		print(k + show(p))
	}
	[()]
}

fun readings() {
	for r in Iter.cartesianPower([0, 1], 1) {
		let k = ["a", "b"]?
		print(k + show(r))
	}
	[()]
}

-- A cursor kept aside and stepped again gives the same element again.
fun twice[Iterator c, Show (Item c)](xs : c) {
	let Iter.Yield(_, second) = next(xs, iter(xs)) else { return }
	let Iter.Yield(x, _) = next(xs, second) else { return }
	let Iter.Yield(y, _) = next(xs, second) else { return }
	print(show(x) + " " + show(y))
}

-- A caller writing into a window it was given changes no later window.
fun written() {
	for w in Iter.windowed([1, 2, 3, 4], 2) {
		print(w)
		w[1] = 99
	}
}

fun main() {
	print(len(windows()))
	print(len(choices()))
	print(len(orderings()))
	print(len(readings()))
	twice(Iter.windowed([1, 2, 3, 4], 2))
	twice(Iter.combinations([1, 2, 3], 2))
	twice(Iter.permutations([1, 2, 3], 2))
	twice(Iter.cartesianPower([0, 1], 2))
	written()
}
