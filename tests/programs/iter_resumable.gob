-- `Iter.resumable`: loops over one value continue where the last one stopped.

fun check[Show a](label : String, value : a) {
    print(label + " = " + show(value))
}

-- Splits input shaped like Advent of Code's: a header up to the first blank
-- line, then a body.
fun splitAtBlank(lines : Array String) -> (Array String, Array String) {
    let rest = Iter.resumable(lines)
    var head : Array String = []
    var body : Array String = []
    for line in rest {
        if line == "" { break }
        head = head + [line]
    }
    for line in rest { body = body + [line] }
    (head, body)
}

fun main() {
    -- A `break` consumes the element it broke on; the next loop continues.
    let xs = [1, 2, 3, 4, 5]
    let r = Iter.resumable(xs)
    for x in r {
        if x == 2 { break }
    }
    check("after break at 2", Iter.collect(r))

    -- A loop that ran to the end leaves nothing for the next.
    var runs = 0
    for _ in r { runs = runs + 1 }
    check("runs after exhaustion", runs)

    -- A fresh `resumable` starts over, and the wrapped array is unchanged.
    check("fresh", Iter.collect(Iter.resumable(xs)))
    check("xs", xs)

    -- Three loops in turn, each stopping early.
    let s = Iter.resumable(Int.range(0, 10))
    for x in s { if x == 3 { break } }
    for x in s { if x == 6 { break } }
    check("third loop", Iter.collect(s))

    -- Over an adapter.
    let m = Iter.resumable(Iter.map([1, 2, 3, 4], \_ * 10))
    for x in m { if x == 20 { break } }
    check("map rest", Iter.collect(m))

    -- Over an empty source.
    let e = Iter.resumable(([] : Array Int))
    check("empty", Iter.collect(e))

    check("split", splitAtBlank(["a", "b", "", "c", "d"]))
    check("no blank", splitAtBlank(["a", "b"]))

    -- The branches of a multi-shot `?` share one position instead of each
    -- starting over: the first branch takes 1, the second takes 2.
    let shared = Iter.resumable([1, 2, 3])
    let taken = do {
        let _ = [0, 0]?
        let x = Iter.collect(Iter.take(shared, 1))
        x
    }
    check("shared across branches", taken)
}
