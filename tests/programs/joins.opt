-- bindings
Main#converge : fun(Int) -> Int =
  fun(n : Int) {
    join tag(x%1 : Int) : Int = {
      let x%2 : Int =
        Prim.intMul(x%1, 10)
      Prim.intAdd(x%2, 1)
    }
    if Prim.intLt(0, n) {
      jump tag(n)
    } else {
      jump tag(Prim.intSub(0, n))
    }
  }

Main#countdown : fun(Int) -> Int =
  fun(n : Int) {
    join rec go(i : Int, acc : Int) : Int = {
      if
        let %b : Bool =
          Prim.intLt(i, 0)
        if %b {
          %b
        } else {
          Prim.intEq(i, 0)
        }
      {
        acc
      } else {
        jump go(Prim.intSub(i, 1), Prim.intAdd(acc, i))
      }
    }
    jump go(n, 0)
  }

Main#twice : fun(fun(Int) -> Int, Int) -> Int =
  fun(f : fun(Int) -> Int, x : Int) {
    f(f(x))
  }

Main#escapes : fun(Int) -> Int =
  fun(n : Int) {
    let step : fun(Int) -> Int =
      fun(x : Int) {
        Prim.intAdd(x, 3)
      }
    step(step(n))
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq%1 : Unit =
      Turkey.Stdout#print@Int(
        join tag(x%1 : Int) : Int = {
          let x%2 : Int =
            Prim.intMul(x%1, 10)
          Prim.intAdd(x%2, 1)
        }
        jump tag(4)
      )
    let %seq%2 : Unit =
      Turkey.Stdout#print@Int(
        join tag(x%1 : Int) : Int = {
          let x%2 : Int =
            Prim.intMul(x%1, 10)
          Prim.intAdd(x%2, 1)
        }
        jump tag(4)
      )
    let %seq%3 : Unit =
      Turkey.Stdout#print@Int(
        join rec go(i : Int, acc : Int) : Int = {
          if
            let %b : Bool =
              Prim.intLt(i, 0)
            if %b {
              %b
            } else {
              Prim.intEq(i, 0)
            }
          {
            acc
          } else {
            jump go(Prim.intSub(i, 1), Prim.intAdd(acc, i))
          }
        }
        jump go(4, 0)
      )
    Turkey.Stdout#print@Int(
      let step : fun(Int) -> Int =
        fun(x%3 : Int) {
          Prim.intAdd(x%3, 3)
        }
      step(step(1))
    )
  }
