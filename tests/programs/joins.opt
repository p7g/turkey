-- bindings
Main#converge : fun(Int) -> Int =
  fun(n : Int) {
    join tag(x : Int) : Int = {
      let x : Int =
        Prim.intMul(x, 10)
      Prim.intAdd(x, 1)
    }
    if %default.Ord.gt@Int(n, 0) {
      jump tag(n)
    } else {
      jump tag(Prim.intSub(0, n))
    }
  }

Main#countdown : fun(Int) -> Int =
  fun(n : Int) {
    join rec go(i : Int, acc : Int) : Int = {
      if
        let %b1 : Bool =
          Prim.intLt(i, 0)
        if %b1 {
          %b1
        } else {
          Prim.intEq(i, 0)
        }
      {
        acc
      } else {
        jump go(Prim.intSub(i, 1), Prim.intAdd(acc, i))
      }
    }
    jump go(n, 0)
  }

Main#twice : fun(fun(Int) -> Int, Int) -> Int =
  fun(f : fun(Int) -> Int, x : Int) {
    f(f(x))
  }

Main#escapes : fun(Int) -> Int =
  fun(n : Int) {
    let step : fun(Int) -> Int =
      fun(x : Int) {
        Prim.intAdd(x, 3)
      }
    step(step(n))
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      let x : Int =
        join tag(x : Int) : Int = {
          let x : Int =
            Prim.intMul(x, 10)
          Prim.intAdd(x, 1)
        }
        if %default.Ord.gt@Int(4, 0) {
          jump tag(4)
        } else {
          jump tag(Prim.intSub(0, 4))
        }
      Prim.print(Prim.intToString(x))
    let %seq2 : Unit =
      let x : Int =
        let n : Int =
          Prim.intSub(0, 4)
        join tag(x : Int) : Int = {
          let x : Int =
            Prim.intMul(x, 10)
          Prim.intAdd(x, 1)
        }
        if %default.Ord.gt@Int(n, 0) {
          jump tag(n)
        } else {
          jump tag(Prim.intSub(0, n))
        }
      Prim.print(Prim.intToString(x))
    let %seq3 : Unit =
      let x : Int =
        join rec go(i : Int, acc : Int) : Int = {
          if
            let %b1 : Bool =
              Prim.intLt(i, 0)
            if %b1 {
              %b1
            } else {
              Prim.intEq(i, 0)
            }
          {
            acc
          } else {
            jump go(Prim.intSub(i, 1), Prim.intAdd(acc, i))
          }
        }
        jump go(4, 0)
      Prim.print(Prim.intToString(x))
    let x : Int =
      let step : fun(Int) -> Int =
        fun(x : Int) {
          Prim.intAdd(x, 3)
        }
      step(step(1))
    Prim.print(Prim.intToString(x))
  }
