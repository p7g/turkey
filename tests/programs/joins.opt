-- bindings
Main#converge : fun(Int) -> Int =
  fun(n : Int) {
    join tag(x : Int) : Int = {
      %inst.Add.Int#add(%inst.Mul.Int#mul(x, 10), 1)
    }
    if %inst.Ord.Int#gt(n, 0) {
      jump tag(n)
    } else {
      jump tag(%inst.Sub.Int#sub(0, n))
    }
  }

Main#countdown : fun(Int) -> Int =
  fun(n : Int) {
    join rec go(i : Int, acc : Int) : Int = {
      if %inst.Ord.Int#lte(i, 0) {
        acc
      } else {
        jump go(%inst.Sub.Int#sub(i, 1), %inst.Add.Int#add(acc, i))
      }
    }
    jump go(n, 0)
  }

Main#twice : fun(fun(Int) -> Int, Int) -> Int =
  fun(f : fun(Int) -> Int, x : Int) {
    f(f(x))
  }

Main#escapes : fun(Int) -> Int =
  fun(n : Int) {
    let step : fun(Int) -> Int =
      fun(x : Int) {
        %inst.Add.Int#add(x, 3)
      }
    Main#twice(step, n)
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      Prelude#print@Int(Main#converge(4))
    let %seq2 : Unit =
      Prelude#print@Int(Main#converge(%inst.Sub.Int#sub(0, 4)))
    let %seq3 : Unit =
      Prelude#print@Int(Main#countdown(4))
    Prelude#print@Int(Main#escapes(1))
  }
