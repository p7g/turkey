-- A `match` on a constructor built right there, with patterns nested inside it.
--
-- `known_patterns.opt` is what each function becomes: none of them still
-- builds the value it takes apart, and none of them still tests it. A part of
-- the pattern either cannot fail -- a variable, a tuple, a type's only
-- constructor -- or faces a part of the scrutinee whose shape answers it.

import Data.Map as Map

type Point = Point { var x : Int, y : Int }

-- An inlined `Map` cursor hands the loop `Some((key, value))`, and the loop
-- takes it apart with `(k, v)`: neither the `Some` nor the pair is built.
fun weighted(m : Map Int Int) -> Int {
    var total = 0
    for (k, v) in m { total = total + k * v }
    total
}

-- Two values matched at once.
fun sum(a : Int, b : Int) -> Int = match (a, b) {
    (x, y) -> x + y
}

-- A refutable pattern inside another, against a value that decides both.
fun depth(n : Int) -> Int = match Some(Some(n)) {
    Some(None) -> 0
    Some(Some(x)) -> x
    None -> -1
}

-- A one-constructor record is a pattern that cannot fail, even when the value
-- inside is not known.
fun across(p : Point) -> Int = match Some(p) {
    Some(Point { x, .. }) -> x
    None -> 0
}

fun command(word : String) -> Int = match word {
    "stop" -> 0
    "go" -> 1
    _ -> 2
}

fun go() -> Int = command("go")

fun note(label : String, n : Int) -> Int {
    print(label)
    n
}

-- Every part is still evaluated, in order, including the one the pattern
-- ignores.
fun ordered() -> Int = match Some((note("first", 1), note("second", 2))) {
    Some((_, b)) -> b
    None -> 0
}

-- A constructor that reaches its `match` through a `let`: the `match` reads
-- the arguments, and nothing is built.
fun named(n : Int) -> Int {
    let found = Some(n * 2)
    let other = n + 1
    match found {
        None -> other
        Some(x) -> x + other
    }
}

-- Through two of them: the pair inside is taken apart where the `Some` was.
fun through(n : Int) -> Int {
    let pair = (n, n * 3)
    let wrapped = Some(pair)
    match wrapped {
        Some((a, b)) -> a + b
        None -> 0
    }
}

-- A record's field can be assigned between its `let` and the `match`, so the
-- `match` reads the record rather than what it was built from.
fun reassigned(n : Int) -> Int {
    let p = Point { x = n, y = 0 }
    p.x = n + 1
    match p {
        Point { x, .. } -> x
    }
}

fun main() {
    let m = Map.new()
    for var i = 1; i <= 4; i = i + 1 { Map.put(m, i, i + 1) }
    print(weighted(m))
    print(sum(3, 4))
    print(depth(7))
    print(across(Point { x = 5, y = 6 }))
    print(go())
    print(ordered())
    print(named(3))
    print(through(2))
    print(reassigned(9))
}
