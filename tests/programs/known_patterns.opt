-- bindings
Main#weighted : fun(Map Int Int) -> Int =
  fun(m : Map Int Int) {
    let total : %Ref Int =
      ref(0)
    join %bind1(%bv1 : Unit) : Int = {
      !total
    }
    let %cu1 : MapCursor Int Int =
      Data.Map#MapCursor(m.head)
    join rec %lp1() : ! = {
      match %cu1.bucket {
        Data.Option.Type#None ->
          jump %bind1(())
        Data.Option.Type#Some(b) ->
          let %seq1 : Unit =
            %cu1.bucket := b.next
          let k : Int =
            b.key
          let v : Int =
            b.value
          let %seq2 : Unit =
            let %seq3 : Unit =
              total :=
                let x : Int =
                  !total
                let y : Int =
                  Prim.intMul(k, v)
                Prim.intAdd(x, y)
            ()
          jump %lp1()
      }
    }
    jump %lp1()
  }

Main#sum : fun(Int, Int) -> Int =
  fun(a : Int, b : Int) {
    Prim.intAdd(a, b)
  }

Main#depth : fun(Int) -> Int =
  fun(n : Int) {
    n
  }

Main#across : fun(Point) -> Int =
  fun(p : Point) {
    match p {
      Main#Point { x = x, .. } ->
        x
    }
  }

Main#command : fun(String) -> Int =
  fun(word : String) {
    match word {
      "stop" ->
        0
      "go" ->
        1
      _ ->
        2
    }
  }

Main#go : fun() -> Int =
  fun() {
    1
  }

Main#note : fun(String, Int) -> Int =
  fun(label : String, n : Int) {
    let %seq1 : Unit =
      let %seq2 : Bool =
        System.IO#writeString(1, label, Data.Bool.Type#True)
      ()
    n
  }

Main#ordered : fun() -> Int =
  fun() {
    let %seq1.529 : Int =
      let %seq1 : Unit =
        let %seq2 : Bool =
          System.IO#writeString(1, "first", Data.Bool.Type#True)
        ()
      1
    let b : Int =
      let %seq1 : Unit =
        let %seq2 : Bool =
          System.IO#writeString(1, "second", Data.Bool.Type#True)
        ()
      2
    b
  }

Main#named : fun(Int) -> Int =
  fun(n : Int) {
    let %arg1.530 : Int =
      Prim.intMul(n, 2)
    let other : Int =
      Prim.intAdd(n, 1)
    Prim.intAdd(%arg1.530, other)
  }

Main#through : fun(Int) -> Int =
  fun(n : Int) {
    let b : Int =
      Prim.intMul(n, 3)
    Prim.intAdd(n, b)
  }

Main#reassigned : fun(Int) -> Int =
  fun(n : Int) {
    let p : Point =
      Main#Point {
        x =
          n
        y =
          0
      }
    let %seq1 : Unit =
      p.x := Prim.intAdd(n, 1)
    match p {
      Main#Point { x = x, .. } ->
        x
    }
  }

Main#main : fun() -> Unit =
  fun() {
    let m : Map Int Int =
      let table : Prim.Array (Entry Int Int) =
        Prim.arrayNew[Entry Int Int](16, Data.Map#Empty)
      Data.Map#Map {
        table =
          table
        cap =
          16
        size =
          0
        tombstoneCount =
          0
        head =
          Data.Option.Type#None
        tail =
          Data.Option.Type#None
      }
    join %bind1(%bv1 : Unit) : Unit = {
      let %seq1 : Unit =
        let x : Int =
          let total : %Ref Int =
            ref(0)
          join %bind2(%bv2 : Unit) : Int = {
            !total
          }
          let %cu1 : MapCursor Int Int =
            Data.Map#MapCursor(m.head)
          join rec %lp1() : ! = {
            match %cu1.bucket {
              Data.Option.Type#None ->
                jump %bind2(())
              Data.Option.Type#Some(b) ->
                let %seq2 : Unit =
                  %cu1.bucket := b.next
                let k : Int =
                  b.key
                let v : Int =
                  b.value
                let %seq3 : Unit =
                  let %seq4 : Unit =
                    total :=
                      let x : Int =
                        !total
                      let y : Int =
                        Prim.intMul(k, v)
                      Prim.intAdd(x, y)
                  ()
                jump %lp1()
            }
          }
          jump %lp1()
        let %seq5 : Bool =
          System.IO#writeString(1, Data.Int#toString(x), Data.Bool.Type#True)
        ()
      let %seq6 : Unit =
        let x : Int =
          Prim.intAdd(3, 4)
        let %seq5 : Bool =
          System.IO#writeString(1, Data.Int#toString(x), Data.Bool.Type#True)
        ()
      let %seq7 : Unit =
        let %seq5 : Bool =
          System.IO#writeString(1, Data.Int#toString(7), Data.Bool.Type#True)
        ()
      let %seq8 : Unit =
        let x : Int =
          match Main#Point {
  x =
    5
  y =
    6
} {
            Main#Point { x = x, .. } ->
              x
          }
        let %seq5 : Bool =
          System.IO#writeString(1, Data.Int#toString(x), Data.Bool.Type#True)
        ()
      let %seq9 : Unit =
        let %seq5 : Bool =
          System.IO#writeString(1, Data.Int#toString(1), Data.Bool.Type#True)
        ()
      let %seq10 : Unit =
        let x : Int =
          let %seq1.529 : Int =
            let %seq11 : Unit =
              let %seq5 : Bool =
                System.IO#writeString(1, "first", Data.Bool.Type#True)
              ()
            1
          let b : Int =
            let %seq11 : Unit =
              let %seq5 : Bool =
                System.IO#writeString(1, "second", Data.Bool.Type#True)
              ()
            2
          b
        let %seq5 : Bool =
          System.IO#writeString(1, Data.Int#toString(x), Data.Bool.Type#True)
        ()
      let %seq12 : Unit =
        let x : Int =
          let %arg1.530 : Int =
            Prim.intMul(3, 2)
          let other : Int =
            Prim.intAdd(3, 1)
          Prim.intAdd(%arg1.530, other)
        let %seq5 : Bool =
          System.IO#writeString(1, Data.Int#toString(x), Data.Bool.Type#True)
        ()
      let %seq13 : Unit =
        let x : Int =
          let b : Int =
            Prim.intMul(2, 3)
          Prim.intAdd(2, b)
        let %seq5 : Bool =
          System.IO#writeString(1, Data.Int#toString(x), Data.Bool.Type#True)
        ()
      let x : Int =
        let p : Point =
          Main#Point {
            x =
              9
            y =
              0
          }
        let %seq14 : Unit =
          p.x := Prim.intAdd(9, 1)
        match p {
          Main#Point { x = x, .. } ->
            x
        }
      let %seq5 : Bool =
        System.IO#writeString(1, Data.Int#toString(x), Data.Bool.Type#True)
      ()
    }
    let i : %Ref Int =
      ref(1)
    join rec %lp2() : ! = {
      join %st1() : ! = {
        let %seq15 : Unit =
          i :=
            let x : Int =
              !i
            Prim.intAdd(x, 1)
        jump %lp2()
      }
      if
        let %eta1 : Int =
          !i
        let %b1 : Bool =
          Prim.intLt(%eta1, 4)
        if %b1 {
          %b1
        } else {
          Prim.intEq(%eta1, 4)
        }
      {
        let %seq16 : Unit =
          Data.Map#put@Int,Int(
            m,
            !i,
            let x : Int =
              !i
            Prim.intAdd(x, 1)
          )
        jump %st1()
      } else {
        jump %bind1(())
      }
    }
    jump %lp2()
  }
