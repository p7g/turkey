-- bindings
Main#weighted : fun(BaseMap FoldHash Int Int) -> Int =
  fun(m : BaseMap FoldHash Int Int) {
    let total : %Ref Int =
      ref(0)
    join %bind(%bv : Unit) : Int = {
      !total
    }
    let %cu : MapCursor Int Int =
      Data.Map#MapCursor(m.4)
    join rec %lp() : ! = {
      match %cu.0 {
        Data.Option#None ->
          jump %bind(())
        Data.Option#Some(b) ->
          let %seq%1 : Unit =
            %cu.0 := b.3
          let k : Int =
            b.0
          let v : Int =
            b.1
          let %seq%2 : Unit =
            let %seq%3 : Unit =
              total :=
                let x : Int =
                  !total
                let y : Int =
                  Prim.intMul(k, v)
                Prim.intAdd(x, y)
            ()
          jump %lp()
      }
    }
    jump %lp()
  }

Main#sum : fun(Int, Int) -> Int =
  fun(a : Int, b : Int) {
    Prim.intAdd(a, b)
  }

Main#depth : fun(Int) -> Int =
  fun(n : Int) {
    n
  }

Main#across : fun(Point) -> Int =
  fun(p : Point) {
    match p {
      Main#Point(x, _) ->
        x
    }
  }

Main#command : fun(String) -> Int =
  fun(word : String) {
    match word {
      "stop" ->
        0
      "go" ->
        1
      _ ->
        2
    }
  }

Main#go : fun() -> Int =
  fun() {
    1
  }

Main#note : fun(String, Int) -> Int =
  fun(label : String, n : Int) {
    let %seq : Unit =
      Turkey.Stdout#print@String(label)
    n
  }

Main#ordered : fun() -> Int =
  fun() {
    let %seq%1 : Unit =
      Turkey.Stdout#print@String("first")
    let %seq%2 : Unit =
      Turkey.Stdout#print@String("second")
    2
  }

Main#named : fun(Int) -> Int =
  fun(n : Int) {
    let %arg : Int =
      Prim.intMul(n, 2)
    let other : Int =
      Prim.intAdd(n, 1)
    Prim.intAdd(%arg, other)
  }

Main#through : fun(Int) -> Int =
  fun(n : Int) {
    let b : Int =
      Prim.intMul(n, 3)
    Prim.intAdd(n, b)
  }

Main#reassigned : fun(Int) -> Int =
  fun(n : Int) {
    let p : Point =
      Main#Point(n, 0)
    let %seq : Unit =
      p.0 := Prim.intAdd(n, 1)
    match p {
      Main#Point(x, _) ->
        x
    }
  }

Main#main : fun() -> Unit =
  fun() {
    let m : BaseMap FoldHash Int Int =
      let table : Prim.Array (Entry Int Int) =
        Prim.arrayNew[Entry Int Int](16, Data.Map#Empty)
      Data.Map#BaseMap(table, 16, 0, 0, Data.Option#None, Data.Option#None, 0)
    join %bind%1(%bv%1 : Unit) : Unit = {
      let %seq%1 : Unit =
        Turkey.Stdout#print@Int(
          let total : %Ref Int =
            ref(0)
          join %bind%2(%bv%2 : Unit) : Int = {
            !total
          }
          let %cu : MapCursor Int Int =
            Data.Map#MapCursor(m.4)
          join rec %lp%1() : ! = {
            match %cu.0 {
              Data.Option#None ->
                jump %bind%2(())
              Data.Option#Some(b) ->
                let %seq%2 : Unit =
                  %cu.0 := b.3
                let k : Int =
                  b.0
                let v : Int =
                  b.1
                let %seq%3 : Unit =
                  let %seq%4 : Unit =
                    total :=
                      let x%1 : Int =
                        !total
                      let y : Int =
                        Prim.intMul(k, v)
                      Prim.intAdd(x%1, y)
                  ()
                jump %lp%1()
            }
          }
          jump %lp%1()
        )
      let %seq%5 : Unit =
        Turkey.Stdout#print@Int(7)
      let %seq%6 : Unit =
        Turkey.Stdout#print@Int(7)
      let %seq%7 : Unit =
        Turkey.Stdout#print@Int(
          match Main#Point(5, 6) {
            Main#Point(x%2, _) ->
              x%2
          }
        )
      let %seq%8 : Unit =
        Turkey.Stdout#print@Int(1)
      let %seq%9 : Unit =
        Turkey.Stdout#print@Int(
          let %seq%10 : Unit =
            Turkey.Stdout#print@String("first")
          let %seq%11 : Unit =
            Turkey.Stdout#print@String("second")
          2
        )
      let %seq%12 : Unit =
        Turkey.Stdout#print@Int(10)
      let %seq%13 : Unit =
        Turkey.Stdout#print@Int(8)
      Turkey.Stdout#print@Int(
        let p : Point =
          Main#Point(9, 0)
        let %seq%14 : Unit =
          p.0 := 10
        match p {
          Main#Point(x%3, _) ->
            x%3
        }
      )
    }
    let i : %Ref Int =
      ref(1)
    join rec %lp%2() : ! = {
      join %st() : ! = {
        let %seq%15 : Unit =
          i :=
            let x%4 : Int =
              !i
            Prim.intAdd(x%4, 1)
        jump %lp%2()
      }
      if
        let %eta : Int =
          !i
        let %b : Bool =
          Prim.intLt(%eta, 4)
        if %b {
          %b
        } else {
          Prim.intEq(%eta, 4)
        }
      {
        let %seq%16 : Unit =
          Data.Map#put@FoldHash,Int,Int(
            m,
            !i,
            let x%5 : Int =
              !i
            Prim.intAdd(x%5, 1)
          )
        jump %st()
      } else {
        jump %bind%1(())
      }
    }
    jump %lp%2()
  }
