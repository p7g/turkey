      ref(0)
    join %bind1(%bv1 : Unit) : Int = {
      !total
    }
    let %cu1 : MapCursor Int Int =
      Data.Map#MapCursor(m.4)
    join rec %lp1() : ! = {
      match %cu1.0 {
        Data.Option.Type#None ->
          jump %bind1(())
        Data.Option.Type#Some(b) ->
          let %seq1 : Unit =
            %cu1.0 := b.3
          let k : Int =
            b.0
          let v : Int =
            b.1
          let %seq2 : Unit =
            let %seq3 : Unit =
              total :=
                let x : Int =
                  !total
                let y : Int =
                  Prim.intMul(k, v)
                Prim.intAdd(x, y)
            ()
          jump %lp1()
      }
    }
    jump %lp1()
  }

