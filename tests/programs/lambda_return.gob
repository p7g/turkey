-- `return` inside a lambda leaves the lambda (TIX-77).
--
-- A lambda whose result is a literal generalizes, so its result is a type
-- variable and the join `return` jumps to takes a boxed parameter -- and the
-- value jumped is an `i64`. The Python backend jumped it unconverted and failed
-- its own check; `boot` converted it. Both do now.

fun main() {
    let f = fun() { return 3 }
    print(Int.toString(f()))

    let early = fun(x : Int) {
        if x > 1 { return 3 }
        4
    }
    print(Int.toString(early(0)) + " " + Int.toString(early(5)))

    let named = fun(s : String) -> String {
        if String.byteLength(s) == 0 { return "empty" }
        s + "!"
    }
    print(named("") + " " + named("hi"))
}
