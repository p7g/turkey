-- `let ... else` and `var ... else`. The parser writes each as a `let` of the
-- names the pattern binds, from a `match` whose other arm is the `else` block;
-- this program pins what that means.
type Shape = Circle(Int) | Square(Int) | Dot

-- `return` leaves the function, and the bound name is in scope after it.
fun radius(s : Shape) -> Int {
    let Circle(r) = s else { return -1 }
    r
}

-- Several names come out of one pattern.
fun sum(pair : Option (Int, Int)) -> Int {
    let Some((a, b)) = pair else { return 0 }
    a + b
}

-- No names at all: the pattern is only a test.
fun isDot(s : Shape) -> Bool {
    let Dot = s else { return False }
    True
}

-- `continue` and `break` leave a loop iteration or the loop.
fun total(words : Array String) -> Int {
    var n = 0
    for w in words {
        if w == "stop" { break }
        let Some(k) = Int.parse(w) else { continue }
        n = n + k
    }
    n
}

-- `var` makes the names assignable.
fun countdown(o : Option Int) -> Int {
    var Some(n) = o else { return -1 }
    while n > 0 { n = n - 1 }
    n
}

-- A call that never returns ends the block, as does an `if` or `match` every
-- way through which leaves, and a `loop` with no `break`.
fun mustParse(text : String) -> Int {
    let Some(n) = Int.parse(text) else { error("not a number: " + text) }
    n
}

fun classify(s : Shape) -> String {
    let Square(w) = s else {
        if let Circle(_) = s { return "round" } else { return "nothing" }
    }
    "square of " + show(w)
}

fun firstSquare(shapes : Vec Shape) -> Int {
    var i = 0
    let Square(w) = shapes[0] else {
        loop {
            i = i + 1
            if i == len(shapes) { return 0 }
            if let Square(v) = shapes[i] { return v }
        }
    }
    w
}

-- A `?` after a `let ... else` is lowered as it would be after any `let`.
fun addParsed(a : String, b : Option String) -> Option Int {
    let Some(text) = b else { return Some(-1) }
    let x = Int.parse(a)?
    let y = Int.parse(text)?
    Some(x + y)
}

-- A parenthesized value may end in a block.
fun pick(c : Bool, x : Option Int) -> Int {
    let Some(v) = (if c { x } else { None }) else { return 0 }
    v
}

fun main() {
    print(radius(Circle(3)))
    print(radius(Dot))
    print(sum(Some((2, 5))))
    print(sum(None))
    print(isDot(Dot))
    print(isDot(Square(1)))
    print(total(["1", "x", "20", "stop", "300"]))
    print(countdown(Some(4)))
    print(countdown(None))
    print(mustParse("42"))
    print(classify(Square(2)))
    print(classify(Circle(1)))
    print(classify(Dot))
    print(firstSquare([Dot, Circle(1), Square(7)]))
    print(firstSquare([Dot]))
    print(addParsed("1", Some("2")))
    print(addParsed("1", None))
    print(addParsed("x", Some("2")))
    print(pick(True, Some(9)))
    print(pick(False, Some(9)))
}
