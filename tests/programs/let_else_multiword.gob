-- A `let ... else` whose block ends in a call that never returns, binding a
-- value of more than one word: a record, and a tuple through a generic
-- function that is specialized at it.
type Zone = Zone { id : String, offset : Int }

fun zoneOf(e : Either String Zone) -> Zone {
    let Right(z) = e else { error("no zone") }
    z
}

fun expectRight(e : Either String r) -> r {
    let Right(v) = e else { error("expected Right") }
    v
}

fun main() {
    let z = zoneOf(Right(Zone { id = "UTC", offset = 0 }))
    print(z.id)
    let (name, n) = expectRight(Right(("pair", 2)))
    print(name + " " + show(n))
    let Zone { id, offset } = expectRight(Right(Zone { id = "+05:30", offset = 330 }))
    print(id + " " + show(offset))
}
