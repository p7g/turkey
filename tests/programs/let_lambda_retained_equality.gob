-- A top-level `let` generalized with a retained equality: `g`'s scheme
-- carries `Elem a ~ Int`, and `open(y) + n` takes the `Add Int` instance
-- under it.

class Box b {
    type Elem b
    fun open(b) -> Elem b
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

let g = fun(y) { let n : Int = open(y); open(y) + n }

fun main() { print(g(Some(1))) }
