-- An array literal that nothing decides takes the first of `Array`, `Vec`
-- and `FrozenArray` that has every class its uses need, as the Haskell
-- Report's defaulting does with its default list.
import Data.Set as Set

class Tag a { fun tag(a) -> String }
instance Tag (Vec a) { fun tag(_) = "vec" }

-- A class whose `Vec` instance needs `Show` of the elements: a literal of
-- functions, which have none, passes over `Vec`.
class Label a { fun label(a) -> String }
instance Label (Vec a) : Show a { fun label(_) = "vec" }
instance Label (FrozenArray a) { fun label(_) = "frozen" }

-- Generic functions: the literal's `Hash` is a constraint the function's
-- own generalization meets.
fun addTwice(seen, p) { Set.add(seen, [p, p]) }

fun distinct(x) {
    let seen = Set.new()
    Set.add(seen, [x])
    Set.add(seen, [x])
    len(seen)
}

fun even(seen, n : Int) -> Bool = if n == 0 { True } else {
    Set.add(seen, [n])
    odd(seen, n - 1)
}

fun odd(seen, n : Int) -> Bool = if n == 0 { False } else {
    Set.add(seen, [n])
    even(seen, n - 1)
}

-- A literal in each arm of a `match`.
fun arms(b : Bool) -> Int {
    let seen = Set.new()
    match b {
        True -> Set.add(seen, [1])
        False -> Set.add(seen, [2, 3])
    }
    len(seen)
}

-- The set's element type is decided by the literals added to it, and `Hash`
-- leaves only `FrozenArray`.
fun visited() -> Int {
    let seen = Set.new()
    Set.add(seen, [0, 0])
    Set.add(seen, [0, 1])
    Set.add(seen, [0, 0])
    len(seen)
}

-- A memo indexed with a literal key: `Hash` again, through `Map`'s `Index`.
fun memo() -> Int {
    let m = Map.new()
    m[[1, 2]] = 3
    m[[1, 2]] + 1
}

fun main() {
    print(visited())
    print(memo())
    -- `Ord` leaves only `FrozenArray`.
    print([1, 2] < [1, 3])
    -- A class of the program's own, with an instance for `Vec` only.
    print(tag([1]))
    print((label([fun(x : Int) = x]), label([1])))
    let pairs = Set.new()
    addTwice(pairs, 3)
    addTwice(pairs, 3)
    print((len(pairs), distinct("a"), arms(True)))
    let parity = Set.new()
    print((even(parity, 4), len(parity)))
    -- A lambda's literal is decided by its own body, so the key it builds is
    -- frozen by its declared result.
    let keyOf = fun(a : Int, b : Int) -> FrozenArray Int = [a, b]
    let costs = Map.new()
    costs[keyOf(1, 2)] = 7
    print(costs[keyOf(1, 2)])
    -- Nothing but `Show`, which every container has: still an `Array`.
    let xs = [3, 1, 2]
    xs[0] = 9
    print(xs)
}
