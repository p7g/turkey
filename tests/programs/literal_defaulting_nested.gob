-- A container whose needs are met outright is taken before one that passes
-- its needs down to the literal inside, and one that passes down a class no
-- container of the inner literal has is passed over. The order of the uses
-- does not change the result.
class Pref a { fun pref(a) -> String }
instance Pref (Array a) : Hash a { fun pref(_) = "array" }
instance Pref (Vec a) { fun pref(_) = "vec" }

class Never a { fun never(a) -> Int }
class Choose a { fun choose(a) -> String }
instance Choose (Array a) : Never a { fun choose(_) = "array" }
instance Choose (Vec a) : Hash a { fun choose(_) = "vec" }

-- `Vec` needs nothing; `Array` would pass `Hash` down to `c`, which `c`'s
-- write rules out.
fun writtenFirst() -> String {
    let c = [101]
    c[0] = 7
    pref([c])
}

fun writtenAfter() -> String {
    let c = [101]
    let r = pref([c])
    c[0] = 7
    r
}

-- `Array` would pass `Never` down, which no container has; `Vec` passes
-- `Hash`, which makes the inner literal a `FrozenArray`.
fun chosenFirst() -> String {
    let c = [[101]]
    let r = choose(c)
    r + " " + show(c[0])
}

fun chosenAfter() -> String {
    let c = [[101]]
    let inner = show(c[0])
    choose(c) + " " + inner
}

fun main() {
    print((writtenFirst(), writtenAfter()))
    print((chosenFirst(), chosenAfter()))
    print(pref([[1]]))
}
