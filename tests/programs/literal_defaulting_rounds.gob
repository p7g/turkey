-- Every literal of a round is judged against the same state, and a literal
-- inside another is decided after it, so the order in which a program uses
-- them does not change what they become.
import Data.Set as Set

class Tag a { fun tag(a) -> String }
instance Tag (FrozenArray a) { fun tag(_) = "frozen" }

class Never a { fun never(a) -> Int }
class Choose a { fun choose(a) -> String }
instance Choose (Array a) : Never a { fun choose(_) = "array" }
instance Choose (Vec a) : Hash a { fun choose(_) = "vec" }

class Pick a { fun pick(a) -> String }
instance Pick (Vec a) : Never a { fun pick(_) = "vec" }
instance Pick (FrozenArray a) : Hash a { fun pick(_) = "frozen" }

-- The inner literal is printed first, then put inside a key.
fun printedThenNested() -> Int {
    let s = Set.new()
    let c = [1, 2]
    print(c)
    Set.add(s, [c])
    len(s)
}

-- The same, written the other way round.
fun nestedThenPrinted() -> Int {
    let s = Set.new()
    let a = [[1, 2]]
    print(a[0])
    Set.add(s, a)
    len(s)
}

fun taggedThenNested() -> String {
    let c = [1]
    let a = [c, [2]]
    let _ = len(a)
    tag(c)
}

fun nestedThenTagged() -> String {
    let a = [[2], [1]]
    tag(a[1])
}

-- `Array` needs `Never a`, which nothing has, but `Vec` needs only the
-- `Hash a` the signature gives.
fun given[Hash a](x : a) -> String = choose([x])

-- At the top level as in a function: the numeral is decided first, so `Vec`
-- needs `Never Int` and is passed over.
let atTop = pick([1])

fun inBody() -> String = pick([1])

fun main() {
    print((printedThenNested(), nestedThenPrinted()))
    print((taggedThenNested(), nestedThenTagged()))
    print(given(1))
    print((atTop, inBody()))
}
