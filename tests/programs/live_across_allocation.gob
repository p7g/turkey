-- Values held in registers across allocations, read after them.
--
-- `build` makes no call except its allocations, so every value live across
-- one may sit in a register the runtime's allocator clobbers. Enough cells
-- are built that the size class's cursor empties many times and the slow path
-- runs, collections included; each value must come back from it intact.
type Cell = Cell { value : Int, weight : Float, next : Option Cell }

type Built = Built { head : Cell, sum : Int, total : Float, last : Int }

fun build(n : Int, scale : Float) -> Built {
    var head = Cell { value = 0, weight = 0.0, next = None }
    var sum = 0
    var total = 0.0
    var sign = 1
    var i = 1
    while i <= n {
        head = Cell { value = i, weight = total, next = Some(head) }
        sum = sum + sign * i
        total = total + scale
        sign = 0 - sign
        i = i + 1
    }
    Built { head = head, sum = sum, total = total, last = i }
}

-- The number of cells whose value and weight are not what `build` stored.
fun wrong(head : Cell, scale : Float) -> Int {
    var bad = 0
    var at = Some(head)
    var expect = head.value
    while expect >= 0 {
        match at {
            Some(c) -> {
                let weight = if c.value == 0 { 0.0 } else { Float.fromInt(c.value - 1) * scale }
                if c.value != expect || c.weight != weight { bad = bad + 1 }
                at = c.next
            }
            None -> { bad = bad + 1 }
        }
        expect = expect - 1
    }
    bad
}

fun main() {
    let n = 20000
    let built = build(n, 0.5)
    print("sum " + Int.toString(built.sum))
    print("total " + Float.toString(built.total))
    print("last " + Int.toString(built.last))
    print("head " + Int.toString(built.head.value))
    print("wrong " + Int.toString(wrong(built.head, 0.5)))
}
