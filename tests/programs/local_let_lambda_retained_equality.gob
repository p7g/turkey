-- As in `let_lambda_retained_equality`, with `g` local to `main`.

class Box b {
    type Elem b
    fun open(b) -> Elem b
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

fun main() {
    let g = fun(y) { let n : Int = open(y); open(y) + n }
    print(g(Some(1)))
}
