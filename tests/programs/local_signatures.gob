-- Local `fun`s that state their own type, with type variables of their own.
-- Each is polymorphic in those variables and used at more than one type, so
-- every use applies types to it, and the binding has to say what it binds.

fun describe(x : k) -> String {
    fun twice(y : c) -> Array c = [y, y]
    -- A context of its own.
    fun label[Show c](y : c) -> String = "<" + show(y) + ">"
    -- Recursive, so its own use inside it is an instantiation too.
    fun count(n : Int, acc : Array c) -> Array c =
        if n == 0 { acc } else { count(n - 1, acc) }
    fun pair(y : c) -> (Int, c) = (1, y)
    let (_, b) = pair(3)
    label(len(twice(x))) + label(twice("s")[1]) + label(b)
        + label(len(count(2, twice(1.5))))
}

-- Inside a body the specializer gives up on, which is compiled per layout: the
-- local is too, at the outer variable's layout and at `Int`'s.
fun deep(x : a, n : Int, junk : b) -> Int {
    if n > 0 { return deep(x, n - 1, (junk, junk)) }
    fun both(y : c) -> Array c = [y, y]
    len(both(x)) + both(100000)[1]
}

fun main() {
    fun twice(y : c) -> Array c = [y, y]
    print(twice(1)[0])
    print(twice("a")[0])
    print(describe(7))
    print(describe("x"))
    print(deep(1, 3, 0))
}
