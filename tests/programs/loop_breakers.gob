-- One strongly connected component with three cycles.
--
-- `cell` is the lexicographically first name, so it is the first loop breaker
-- chosen -- and removing it leaves `head` calling itself and
-- `expr -> inside -> head -> expr`. Every function is small enough to inline,
-- so nothing but a breaker stops the inliner, and one breaker per component
-- would let it recurse until it ran out of stack. The optimizer picks breakers
-- until no cycle is left; this program is the shape that needs more than one.

fun cell(n : Int) -> Int = if n <= 0 { 0 } else { expr(n - 1) }
fun expr(n : Int) -> Int = if n <= 0 { 1 } else { inside(n - 1) }
fun head(n : Int) -> Int = if n <= 0 { 2 } else if n == 7 { head(n - 1) } else { expr(n - 1) }
fun inside(n : Int) -> Int = if n <= 0 { 3 } else if n == 5 { cell(n - 1) } else { head(n - 1) }

fun main() {
    for n in [0, 1, 2, 3, 20, 21] {
        print(Int.toString(cell(n)))
    }
}
