-- Loop-carried values: each loop updates its variables and goes round again,
-- and a variable's new value can be computed straight into the register the
-- loop header keeps it in.
--
-- `escape` is the Mandelbrot iteration, four doubles carried round a loop
-- with a poll on its back edge. `interpret` is a small interpreter whose arms
-- each end by jumping to one block, the one holding the poll, which passes
-- the six values it is given on to the header. `rotate` passes its doubles
-- round in a cycle, which no choice of registers can make free, so its back
-- edge breaks the cycle through a spare vector register.

fun escape(cr : Float, ci : Float) -> Int {
    var zr = 0.0
    var zi = 0.0
    var tr = 0.0
    var ti = 0.0
    var i = 0
    while i < 50 && tr + ti <= 4.0 {
        zi = 2.0 * zr * zi + ci
        zr = tr - ti + cr
        tr = zr * zr
        ti = zi * zi
        i = i + 1
    }
    i
}

fun rotate(n : Int) -> Float {
    var a = 1.0
    var b = 2.0
    var c = 3.0
    for var i = 0; i < n; i = i + 1 {
        let t = a
        a = b
        b = c
        c = t
    }
    100.0 * a + 10.0 * b + c
}

type Op = Add(Int) | Scale(Int) | Note(Int) | Back

fun interpret(code : Array Op, steps : Int, out : Vec Int) -> Int {
    var pc = 0
    var acc = 0
    var count = 0
    var scale = 1
    var notes = 0
    var n = 0
    while n < steps {
        if pc == len(code) { pc = 0 }
        match code[pc] {
            Add(k) -> { acc = acc + k * scale; count = count + 1; pc = pc + 1 }
            Scale(k) -> { scale = scale + k; pc = pc + 1 }
            Note(t) -> { Vec.push(out, t + acc); notes = notes + 1; pc = pc + 1 }
            Back -> { pc = 0; count = count + 1 }
        }
        n = n + 1
    }
    acc + count + scale + notes
}

fun main() -> Unit {
    var inside = 0
    for var y = 0; y < 20; y = y + 1 {
        for var x = 0; x < 40; x = x + 1 {
            let cr = 3.0 * Float.fromInt(x) / 40.0 - 2.0
            let ci = 2.0 * Float.fromInt(y) / 20.0 - 1.0
            if escape(cr, ci) == 50 { inside = inside + 1 }
        }
    }
    print(inside)
    let out = []
    print(interpret([Add(2), Scale(1), Note(7), Add(3), Back], 23, out))
    print(len(out))
    print(rotate(7))
}
