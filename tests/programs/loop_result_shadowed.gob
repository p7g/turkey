-- A loop with an early `return`, after a `?`, whose code after the loop uses a
-- name that something inside the loop binds again: here by shadowing it, and
-- by inlining a callee whose parameter is spelled the same. The loop's result
-- is matched where the loop ends; the match must not be moved into the loop's
-- body, around its jump back to the start.
--
-- `inlinedRenamed` is `inlined` with the callee's parameter spelled `m`.
-- How a binder is spelled must not change what the optimizer does, so the two
-- optimize to the same Core but for their names, which
-- `tests/test_inline.py` checks against the `.opt` golden.

fun sum(n : Int) -> Int {
    var s = 0
    for var i = 0; i < n; i = i + 1 { s = s + i }
    s
}

fun wrap(n : Int) -> Int = sum(n)

fun sumRenamed(m : Int) -> Int {
    var s = 0
    for var i = 0; i < m; i = i + 1 { s = s + i }
    s
}

fun wrapRenamed(m : Int) -> Int = sumRenamed(m)

fun first(xs : Array Int) -> Option Int {
    if len(xs) == 0 { return None }
    Some(xs[0])
}

fun shadowed(xs : Array Int) -> Option Int {
    let n = first(xs)?
    for var i = 0; i < n; i = i + 1 {
        let n = i * 2
        if n > 100 { return None }
    }
    Some(n)
}

fun inlined(xs : Array Int) -> Option Int {
    let n = first(xs)?
    var total = 0
    for var i = 0; i < n; i = i + 1 {
        let x = wrap(i)
        if x > 100 { return None }
        total = total + x
    }
    Some(total)
}

fun inlinedRenamed(xs : Array Int) -> Option Int {
    let n = first(xs)?
    var total = 0
    for var i = 0; i < n; i = i + 1 {
        let x = wrapRenamed(i)
        if x > 100 { return None }
        total = total + x
    }
    Some(total)
}

fun main() {
    for xs in [[], [3], [51], [60]] { print(shadowed(xs)) }
    for xs in [[], [3], [14], [15], [20]] { print(inlined(xs)) }
    for xs in [[], [3], [14], [15], [20]] { print(inlinedRenamed(xs)) }
}
