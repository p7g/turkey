-- bindings
Main#total : fun(Int) -> Int =
  fun(n : Int) {
    let t : %Ref Int =
      ref(0)
    let i : %Ref Int =
      ref(0)
    let %seq1 : Unit =
      while %inst.Ord.Int#lt(!i, n) {
        let %seq2 : Unit =
          t := %inst.Add.Int#add(!t, !i)
        let %seq3 : Unit =
          i := %inst.Add.Int#add(!i, 1)
        ()
      }
    !t
  }

Main#firstSquareOver : fun(Int) -> Int =
  fun(limit : Int) {
    let i : %Ref Int =
      ref(0)
    loop {
      let %seq1 : Unit =
        i := %inst.Add.Int#add(!i, 1)
      if %inst.Ord.Int#gt(%inst.Mul.Int#mul(!i, !i), limit) {
        break %inst.Mul.Int#mul(!i, !i)
      }
    }
  }

Main#oddsBelow : fun(Int) -> Int =
  fun(n : Int) {
    let seen : %Ref Int =
      ref(0)
    let %seq1 : Unit =
      for let i : %Ref Int =
  ref(0)
i; %inst.Ord.Int#lt(!i, n); i := %inst.Add.Int#add(!i, 1) {
        let %seq2 : Unit =
          if %inst.Eq.Int#eq(%inst.Rem.Int#rem(!i, 2), 0) {
            continue
          }
        let %seq3 : Unit =
          seen := %inst.Add.Int#add(!seen, 1)
        ()
      }
    !seen
  }

Main#firstEven : fun(Array Int) -> Option Int =
  fun(xs : Array Int) {
    let %seq1 : Unit =
      for x in xs via %inst.Iterator.Array@Int#iter, %inst.Iterator.Array@Int#next {
        if %inst.Eq.Int#eq(%inst.Rem.Int#rem(x, 2), 0) {
          return Data.Option#Some(x)
        }
      }
    Data.Option#None
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      Prelude#print@Int(Main#total(5))
    let %seq2 : Unit =
      Prelude#print@Int(Main#firstSquareOver(20))
    let %seq3 : Unit =
      Prelude#print@Int(Main#oddsBelow(7))
    let %seq4 : Unit =
      Prelude#print@Option(Int)(Main#firstEven([1, 3, 4, 7]))
    Prelude#print@Option(Int)(Main#firstEven([1, 3, 5]))
  }
