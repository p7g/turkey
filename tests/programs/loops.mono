-- bindings
Main#total : fun(Int) -> Int =
  fun(n : Int) {
    let t : %Ref Int =
      ref(0)
    let i : %Ref Int =
      ref(0)
    join %bind(%bv : Unit) : Int = {
      let %seq%1 : Unit =
        %bv
      !t
    }
    join rec %lp() : ! = {
      if %inst.Data.Ord#Ord.Int#lt(!i, n) {
        let %seq%2 : Unit =
          let %seq%3 : Unit =
            t := %inst.Data.Num#Add.Int#add(!t, !i)
          let %seq%4 : Unit =
            i := %inst.Data.Num#Add.Int#add(!i, 1)
          ()
        jump %lp()
      } else {
        jump %bind(())
      }
    }
    jump %lp()
  }

Main#firstSquareOver : fun(Int) -> Int =
  fun(limit : Int) {
    let i : %Ref Int =
      ref(0)
    join %af(%av : Int) : Int = {
      %av
    }
    join rec %lp() : ! = {
      join %bind(%bv : Unit) : ! = {
        jump %lp()
      }
      let %seq : Unit =
        i := %inst.Data.Num#Add.Int#add(!i, 1)
      if %inst.Data.Ord#Ord.Int#gt(%inst.Data.Num#Mul.Int#mul(!i, !i), limit) {
        jump %af(%inst.Data.Num#Mul.Int#mul(!i, !i))
      } else {
        jump %bind(())
      }
    }
    jump %lp()
  }

Main#oddsBelow : fun(Int) -> Int =
  fun(n : Int) {
    let seen : %Ref Int =
      ref(0)
    join %bind%1(%bv%1 : Unit) : Int = {
      let %seq%1 : Unit =
        %bv%1
      !seen
    }
    let i : %Ref Int =
      ref(0)
    join rec %lp() : ! = {
      join %st() : ! = {
        let %seq%2 : Unit =
          i := %inst.Data.Num#Add.Int#add(!i, 1)
        jump %lp()
      }
      if %inst.Data.Ord#Ord.Int#lt(!i, n) {
        join %bind%2(%bv%2 : Unit) : ! = {
          jump %st()
        }
        join %bind%3(%bv%3 : Unit) : Unit = {
          let %seq%3 : Unit =
            %bv%3
          let %seq%4 : Unit =
            seen := %inst.Data.Num#Add.Int#add(!seen, 1)
          jump %bind%2(())
        }
        if %inst.Data.Eq#Eq.Int#eq(%inst.Data.Num#Rem.Int#rem(!i, 2), 0) {
          jump %st()
        } else {
          jump %bind%3(())
        }
      } else {
        jump %bind%1(())
      }
    }
    jump %lp()
  }

Main#firstEven : fun(Array Int) -> Option Int =
  fun(xs : Array Int) {
    join %ret(%rv : Option Int) : Option Int = {
      %rv
    }
    join %bind%1(%bv%1 : Unit) : Option Int = {
      let %seq : Unit =
        %bv%1
      jump %ret(Data.Option#None)
    }
    let %sq : Array Int =
      xs
    let %cu : ArrayCursor =
      %inst.Iter#Iterator.Data.Array#Array@Int#iter(%sq)
    join rec %lp() : ! = {
      match %inst.Iter#Iterator.Data.Array#Array@Int#next(%sq, %cu) {
        Data.Option#None ->
          jump %bind%1(())
        Data.Option#Some(x) ->
          join %bind%2(%bv%2 : Unit) : ! = {
            jump %lp()
          }
          if %inst.Data.Eq#Eq.Int#eq(%inst.Data.Num#Rem.Int#rem(x, 2), 0) {
            jump %ret(Data.Option#Some(x))
          } else {
            jump %bind%2(())
          }
      }
    }
    jump %lp()
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq%1 : Unit =
      Turkey.Stdout#print@Int(Main#total(5))
    let %seq%2 : Unit =
      Turkey.Stdout#print@Int(Main#firstSquareOver(20))
    let %seq%3 : Unit =
      Turkey.Stdout#print@Int(Main#oddsBelow(7))
    let %seq%4 : Unit =
      Turkey.Stdout#print@Option(Int)(Main#firstEven(Data.Array#Array([1, 3, 4, 7])))
    Turkey.Stdout#print@Option(Int)(Main#firstEven(Data.Array#Array([1, 3, 5])))
  }
