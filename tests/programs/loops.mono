-- bindings
Main#total : fun(Int) -> Int =
  fun(n : Int) {
    let t : %Ref Int =
      ref(0)
    let i : %Ref Int =
      ref(0)
    join %bind1(%bv1 : Unit) : Int = {
      let %seq1 : Unit =
        %bv1
      !t
    }
    join rec %lp1() : ! = {
      if %inst.Std.Classes#Ord.Int#lt(!i, n) {
        let %seq2 : Unit =
          let %seq3 : Unit =
            t := %inst.Std.Classes#Add.Int#add(!t, !i)
          let %seq4 : Unit =
            i := %inst.Std.Classes#Add.Int#add(!i, 1)
          ()
        jump %lp1()
      } else {
        jump %bind1(())
      }
    }
    jump %lp1()
  }

Main#firstSquareOver : fun(Int) -> Int =
  fun(limit : Int) {
    let i : %Ref Int =
      ref(0)
    join %af1(%av1 : Int) : Int = {
      %av1
    }
    join rec %lp1() : ! = {
      join %bind1(%bv1 : Unit) : ! = {
        jump %lp1()
      }
      let %seq1 : Unit =
        i := %inst.Std.Classes#Add.Int#add(!i, 1)
      if %inst.Std.Classes#Ord.Int#gt(%inst.Std.Classes#Mul.Int#mul(!i, !i), limit) {
        jump %af1(%inst.Std.Classes#Mul.Int#mul(!i, !i))
      } else {
        jump %bind1(())
      }
    }
    jump %lp1()
  }

Main#oddsBelow : fun(Int) -> Int =
  fun(n : Int) {
    let seen : %Ref Int =
      ref(0)
    join %bind1(%bv1 : Unit) : Int = {
      let %seq1 : Unit =
        %bv1
      !seen
    }
    let i : %Ref Int =
      ref(0)
    join rec %lp1() : ! = {
      join %st1() : ! = {
        let %seq2 : Unit =
          i := %inst.Std.Classes#Add.Int#add(!i, 1)
        jump %lp1()
      }
      if %inst.Std.Classes#Ord.Int#lt(!i, n) {
        join %bind2(%bv2 : Unit) : ! = {
          jump %st1()
        }
        join %bind3(%bv3 : Unit) : Unit = {
          let %seq3 : Unit =
            %bv3
          let %seq4 : Unit =
            seen := %inst.Std.Classes#Add.Int#add(!seen, 1)
          jump %bind2(())
        }
        if %inst.Std.Classes#Eq.Int#eq(%inst.Std.Classes#Rem.Int#rem(!i, 2), 0) {
          jump %st1()
        } else {
          jump %bind3(())
        }
      } else {
        jump %bind1(())
      }
    }
    jump %lp1()
  }

Main#firstEven : fun(Array Int) -> Option Int =
  fun(xs : Array Int) {
    join %ret1(%rv1 : Option Int) : Option Int = {
      %rv1
    }
    join %bind1(%bv1 : Unit) : Option Int = {
      let %seq1 : Unit =
        %bv1
      jump %ret1(Data.Option.Type#None)
    }
    let %sq1 : Array Int =
      xs
    let %cu1 : ArrayCursor =
      %inst.Std.Classes#Iterator.Data.Array#Array@Int#iter(%sq1)
    join rec %lp1() : ! = {
      match %inst.Std.Classes#Iterator.Data.Array#Array@Int#next(%sq1, %cu1) {
        Data.Option.Type#None ->
          jump %bind1(())
        Data.Option.Type#Some(x) ->
          join %bind2(%bv2 : Unit) : ! = {
            jump %lp1()
          }
          if %inst.Std.Classes#Eq.Int#eq(%inst.Std.Classes#Rem.Int#rem(x, 2), 0) {
            jump %ret1(Data.Option.Type#Some(x))
          } else {
            jump %bind2(())
          }
      }
    }
    jump %lp1()
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      Std.Classes#print@Int(Main#total(5))
    let %seq2 : Unit =
      Std.Classes#print@Int(Main#firstSquareOver(20))
    let %seq3 : Unit =
      Std.Classes#print@Int(Main#oddsBelow(7))
    let %seq4 : Unit =
      Std.Classes#print@Option(Int)(Main#firstEven(Data.Array#Array([1, 3, 4, 7])))
    Std.Classes#print@Option(Int)(Main#firstEven(Data.Array#Array([1, 3, 5])))
  }
