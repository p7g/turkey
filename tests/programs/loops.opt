-- bindings
Main#total : fun(Int) -> Int =
  fun(n : Int) {
    let t : %Ref Int =
      ref(0)
    join %bind(%bv : Unit) : Int = {
      !t
    }
    let i : %Ref Int =
      ref(0)
    join rec %lp() : ! = {
      if
        let x%1 : Int =
          !i
        Prim.intLt(x%1, n)
      {
        let %seq%1 : Unit =
          let %seq%2 : Unit =
            t :=
              let x%2 : Int =
                !t
              let y : Int =
                !i
              Prim.intAdd(x%2, y)
          let %seq%3 : Unit =
            i :=
              let x%3 : Int =
                !i
              Prim.intAdd(x%3, 1)
          ()
        jump %lp()
      } else {
        jump %bind(())
      }
    }
    jump %lp()
  }

Main#firstSquareOver : fun(Int) -> Int =
  fun(limit : Int) {
    join %af(%av : Int) : Int = {
      %av
    }
    let i : %Ref Int =
      ref(0)
    join rec %lp() : ! = {
      join %bind(%bv : Unit) : ! = {
        jump %lp()
      }
      let %seq : Unit =
        i :=
          let x%1 : Int =
            !i
          Prim.intAdd(x%1, 1)
      if
        let x%2 : Int =
          !i
        let y%1 : Int =
          !i
        let %eta : Int =
          Prim.intMul(x%2, y%1)
        Prim.intLt(limit, %eta)
      {
        jump %af(
          let x%3 : Int =
            !i
          let y%2 : Int =
            !i
          Prim.intMul(x%3, y%2)
        )
      } else {
        jump %bind(())
      }
    }
    jump %lp()
  }

Main#oddsBelow : fun(Int) -> Int =
  fun(n : Int) {
    let seen : %Ref Int =
      ref(0)
    join %bind%1(%bv%1 : Unit) : Int = {
      !seen
    }
    let i : %Ref Int =
      ref(0)
    join rec %lp() : ! = {
      join %st() : ! = {
        let %seq%1 : Unit =
          i :=
            let x%1 : Int =
              !i
            Prim.intAdd(x%1, 1)
        jump %lp()
      }
      if
        let x%2 : Int =
          !i
        Prim.intLt(x%2, n)
      {
        join %bind%2(%bv%2 : Unit) : ! = {
          jump %st()
        }
        join %bind%3(%bv%3 : Unit) : Unit = {
          let %seq%2 : Unit =
            seen :=
              let x%3 : Int =
                !seen
              Prim.intAdd(x%3, 1)
          jump %bind%2(())
        }
        if
          let x%4 : Int =
            !i
          let x%5 : Int =
            Prim.intMod(x%4, 2)
          Prim.intEq(x%5, 0)
        {
          jump %st()
        } else {
          jump %bind%3(())
        }
      } else {
        jump %bind%1(())
      }
    }
    jump %lp()
  }

Main#firstEven : fun(Array Int) -> Option Int =
  fun(xs : Array Int) {
    join %ret(%rv : Option Int) : Option Int = {
      %rv
    }
    join %bind%1(%bv%1 : Unit) : Option Int = {
      jump %ret(Data.Option#None)
    }
    join rec %lp(%cu : Int) : ! = {
      let storage%1 : Prim.Array Int =
        match xs {
          Data.Array#Array(storage%2) ->
            storage%2
        }
      if
        let %eta : Int =
          Prim.arrayLength[Int](storage%1)
        Prim.not(Prim.intLt(%cu, %eta))
      {
        jump %bind%1(())
      } else {
        let x%1 : Int =
          Prim.arrayGet[Int](storage%1, %cu)
        let %cn : Int =
          Prim.intAdd(%cu, 1)
        join %nx() : ! = {
          jump %lp(%cn)
        }
        join %bind%2(%bv%2 : Unit) : ! = {
          jump %nx()
        }
        if
          let x%2 : Int =
            Prim.intMod(x%1, 2)
          Prim.intEq(x%2, 0)
        {
          jump %ret(Data.Option#Some(x%1))
        } else {
          jump %bind%2(())
        }
      }
    }
    jump %lp(0)
  }

