-- bindings
Main#total : fun(Int) -> Int =
  fun(n : Int) {
    let t : %Ref Int =
      ref(0)
    join %bind1(%bv1 : Unit) : Int = {
      !t
    }
    let i : %Ref Int =
      ref(0)
    join rec %lp1() : ! = {
      if
        let x : Int =
          !i
        Prim.intLt(x, n)
      {
        let %seq1 : Unit =
          let %seq2 : Unit =
            t :=
              let x : Int =
                !t
              let y : Int =
                !i
              Prim.intAdd(x, y)
          let %seq3 : Unit =
            i :=
              let x : Int =
                !i
              Prim.intAdd(x, 1)
          ()
        jump %lp1()
      } else {
        jump %bind1(())
      }
    }
    jump %lp1()
  }

Main#firstSquareOver : fun(Int) -> Int =
  fun(limit : Int) {
    join %af1(%av1 : Int) : Int = {
      %av1
    }
    let i : %Ref Int =
      ref(0)
    join rec %lp1() : ! = {
      join %bind1(%bv1 : Unit) : ! = {
        jump %lp1()
      }
      let %seq1 : Unit =
        i :=
          let x : Int =
            !i
          Prim.intAdd(x, 1)
      if
        let %eta1 : Int =
          let x : Int =
            !i
          let y : Int =
            !i
          Prim.intMul(x, y)
        Prim.intLt(limit, %eta1)
      {
        jump %af1(
          let x : Int =
            !i
          let y : Int =
            !i
          Prim.intMul(x, y)
        )
      } else {
        jump %bind1(())
      }
    }
    jump %lp1()
  }

Main#oddsBelow : fun(Int) -> Int =
  fun(n : Int) {
    let seen : %Ref Int =
      ref(0)
    join %bind1(%bv1 : Unit) : Int = {
      !seen
    }
    let i : %Ref Int =
      ref(0)
    join rec %lp1() : ! = {
      join %st1() : ! = {
        let %seq1 : Unit =
          i :=
            let x : Int =
              !i
            Prim.intAdd(x, 1)
        jump %lp1()
      }
      if
        let x : Int =
          !i
        Prim.intLt(x, n)
      {
        join %bind2(%bv2 : Unit) : ! = {
          jump %st1()
        }
        join %bind3(%bv3 : Unit) : Unit = {
          let %seq2 : Unit =
            seen :=
              let x : Int =
                !seen
              Prim.intAdd(x, 1)
          jump %bind2(())
        }
        if
          let x : Int =
            let x : Int =
              !i
            Prim.intRem(x, 2)
          Prim.intEq(x, 0)
        {
          jump %st1()
        } else {
          jump %bind3(())
        }
      } else {
        jump %bind1(())
      }
    }
    jump %lp1()
  }

Main#firstEven : fun(Array Int) -> Option Int =
  fun(xs : Array Int) {
    join %ret1(%rv1 : Option Int) : Option Int = {
      %rv1
    }
    join %bind1(%bv1 : Unit) : Option Int = {
      jump %ret1(Data.Option.Type#None)
    }
    let %cu1 : ArrayCursor =
      Data.Array#ArrayCursor {
        at =
          0
      }
    join rec %lp1() : ! = {
      match %inst.Std.Classes#Iterator.Data.Array#Array@Int#next(xs, %cu1) {
        Data.Option.Type#None ->
          jump %bind1(())
        Data.Option.Type#Some(x) ->
          join %bind2(%bv2 : Unit) : ! = {
            jump %lp1()
          }
          if
            let x : Int =
              Prim.intRem(x, 2)
            Prim.intEq(x, 0)
          {
            jump %ret1(Data.Option.Type#Some(x))
          } else {
            jump %bind2(())
          }
      }
    }
    jump %lp1()
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      let x : Int =
        Main#total(5)
      Prim.print(Prim.intToString(x))
    let %seq2 : Unit =
      let x : Int =
        Main#firstSquareOver(20)
      Prim.print(Prim.intToString(x))
    let %seq3 : Unit =
      let x : Int =
        Main#oddsBelow(7)
      Prim.print(Prim.intToString(x))
    let %seq4 : Unit =
      let x : Option Int =
        join %ret1(%rv1 : Option Int) : Option Int = {
          %rv1
        }
        join %bind1(%bv1 : Unit) : Option Int = {
          jump %ret1(Data.Option.Type#None)
        }
        let xs : Array Int =
          Data.Array#Array(
            Data.Array#ArrayStorage {
              storage =
                [1, 3, 4, 7]
              length =
                4
            }
          )
        let %cu1 : ArrayCursor =
          Data.Array#ArrayCursor {
            at =
              0
          }
        join rec %lp1() : ! = {
          match %inst.Std.Classes#Iterator.Data.Array#Array@Int#next(xs, %cu1) {
            Data.Option.Type#None ->
              jump %bind1(())
            Data.Option.Type#Some(x) ->
              join %bind2(%bv2 : Unit) : ! = {
                jump %lp1()
              }
              if
                let x : Int =
                  Prim.intRem(x, 2)
                Prim.intEq(x, 0)
              {
                jump %ret1(Data.Option.Type#Some(x))
              } else {
                jump %bind2(())
              }
          }
        }
        jump %lp1()
      Prim.print(
        match x {
          Data.Option.Type#None ->
            "None"
          Data.Option.Type#Some(x) ->
            Prim.stringConcat(Prim.stringConcat("Some(", Prim.intToString(x)), ")")
        }
      )
    let x : Option Int =
      join %ret1(%rv1 : Option Int) : Option Int = {
        %rv1
      }
      join %bind1(%bv1 : Unit) : Option Int = {
        jump %ret1(Data.Option.Type#None)
      }
      let xs : Array Int =
        Data.Array#Array(
          Data.Array#ArrayStorage {
            storage =
              [1, 3, 5]
            length =
              3
          }
        )
      let %cu1 : ArrayCursor =
        Data.Array#ArrayCursor {
          at =
            0
        }
      join rec %lp1() : ! = {
        match %inst.Std.Classes#Iterator.Data.Array#Array@Int#next(xs, %cu1) {
          Data.Option.Type#None ->
            jump %bind1(())
          Data.Option.Type#Some(x) ->
            join %bind2(%bv2 : Unit) : ! = {
              jump %lp1()
            }
            if
              let x : Int =
                Prim.intRem(x, 2)
              Prim.intEq(x, 0)
            {
              jump %ret1(Data.Option.Type#Some(x))
            } else {
              jump %bind2(())
            }
        }
      }
      jump %lp1()
    Prim.print(
      match x {
        Data.Option.Type#None ->
          "None"
        Data.Option.Type#Some(x) ->
          Prim.stringConcat(Prim.stringConcat("Some(", Prim.intToString(x)), ")")
      }
    )
  }
