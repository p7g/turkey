-- bindings
Main#total : fun(Int) -> Int =
  fun(n : Int) {
    let t : %Ref Int =
      ref(0)
    join %bind1(%bv1 : Unit) : Int = {
      !t
    }
    let i : %Ref Int =
      ref(0)
    join rec %lp1() : ! = {
      if
        let x : Int =
          !i
        Prim.intLt(x, n)
      {
        let %seq1 : Unit =
          let %seq2 : Unit =
            t :=
              let x : Int =
                !t
              let y : Int =
                !i
              Prim.intAdd(x, y)
          let %seq3 : Unit =
            i :=
              let x : Int =
                !i
              Prim.intAdd(x, 1)
          ()
        jump %lp1()
      } else {
        jump %bind1(())
      }
    }
    jump %lp1()
  }

Main#firstSquareOver : fun(Int) -> Int =
  fun(limit : Int) {
    join %af1(%av1 : Int) : Int = {
      %av1
    }
    let i : %Ref Int =
      ref(0)
    join rec %lp1() : ! = {
      join %bind1(%bv1 : Unit) : ! = {
        jump %lp1()
      }
      let %seq1 : Unit =
        i :=
          let x : Int =
            !i
          Prim.intAdd(x, 1)
      if
        let %eta1 : Int =
          let x : Int =
            !i
          let y : Int =
            !i
          Prim.intMul(x, y)
        Prim.intLt(limit, %eta1)
      {
        jump %af1(
          let x : Int =
            !i
          let y : Int =
            !i
          Prim.intMul(x, y)
        )
      } else {
        jump %bind1(())
      }
    }
    jump %lp1()
  }

Main#oddsBelow : fun(Int) -> Int =
  fun(n : Int) {
    let seen : %Ref Int =
      ref(0)
    join %bind1(%bv1 : Unit) : Int = {
      !seen
    }
    let i : %Ref Int =
      ref(0)
    join rec %lp1() : ! = {
      join %st1() : ! = {
        let %seq1 : Unit =
          i :=
            let x : Int =
              !i
            Prim.intAdd(x, 1)
        jump %lp1()
      }
      if
        let x : Int =
          !i
        Prim.intLt(x, n)
      {
        join %bind2(%bv2 : Unit) : ! = {
          jump %st1()
        }
        join %bind3(%bv3 : Unit) : Unit = {
          let %seq2 : Unit =
            seen :=
              let x : Int =
                !seen
              Prim.intAdd(x, 1)
          jump %bind2(())
        }
        if
          let x : Int =
            let x : Int =
              !i
            Prim.intRem(x, 2)
          Prim.intEq(x, 0)
        {
          jump %st1()
        } else {
          jump %bind3(())
        }
      } else {
        jump %bind1(())
      }
    }
    jump %lp1()
  }

Main#firstEven : fun(Array Int) -> Option Int =
  fun(xs : Array Int) {
    join %ret1(%rv1 : Option Int) : Option Int = {
      %rv1
    }
    join %bind1(%bv1 : Unit) : Option Int = {
      jump %ret1(Data.Option.Type#None)
    }
    let %cu1 : ArrayCursor =
      Data.Array#ArrayCursor {
        at =
          0
      }
    join rec %lp1() : ! = {
      join %js1(%jf1 : Int) : ! = {
        join %bind2(%bv2 : Unit) : ! = {
          jump %lp1()
        }
        let x : Int =
          %jf1
        if
          let x : Int =
            Prim.intRem(x, 2)
          Prim.intEq(x, 0)
        {
          jump %ret1(Data.Option.Type#Some(x))
        } else {
          jump %bind2(())
        }
      }
      join %js2() : ! = {
        jump %bind1(())
      }
      join %bind3(%bv3 : Unit) : ! = {
        let x : Int =
          let i : Int =
            %cu1.at
          let %seq1 : Unit =
            let length : Int =
              match xs {
  Data.Array#Array(value) ->
    value
}.length
            if
              let %b1 : Bool =
                Prim.intLt(i, 0)
              if %b1 {
                %b1
              } else {
                #Prim.not(Prim.intLt(i, length))
              }
            {
              Data.Array#outOfBounds[a]("read at", i, length)
            }
          Prim.arrayGet[Int](
            match xs {
  Data.Array#Array(value) ->
    value
}.storage,
            i
          )
        let %seq2 : Unit =
          %cu1.at :=
            let x : Int =
              %cu1.at
            Prim.intAdd(x, 1)
        jump %js1(x)
      }
      if
        let %eta1 : Int =
          %cu1.at
        let %eta2 : Int =
          match xs {
  Data.Array#Array(value) ->
    value
}.length
        #Prim.not(Prim.intLt(%eta1, %eta2))
      {
        jump %js2()
      } else {
        jump %bind3(())
      }
    }
    jump %lp1()
  }

