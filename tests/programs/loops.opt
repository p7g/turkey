        join %bind3(%bv3 : Unit) : Int = {
          !seen
        }
        let i : %Ref Int =
          ref(0)
        join rec %lp3() : ! = {
          join %st1() : ! = {
            let %seq9 : Unit =
              i :=
                let x : Int =
                  !i
                Prim.intAdd(x, 1)
            jump %lp3()
          }
          if
