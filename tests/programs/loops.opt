-- bindings
Main#total : fun(Int) -> Int =
  fun(n : Int) {
    let t : %Ref Int =
      ref(0)
    let i : %Ref Int =
      ref(0)
    join %bind1(%bv1 : Unit) : Int = {
      !t
    }
    join rec %lp1() : ! = {
      if
        let x : Int =
          !i
        Prim.intLt(x, n)
      {
        let %seq1 : Unit =
          let %seq2 : Unit =
            t :=
              let x : Int =
                !t
              let y : Int =
                !i
              Prim.intAdd(x, y)
          let %seq3 : Unit =
            i :=
              let x : Int =
                !i
              Prim.intAdd(x, 1)
          ()
        jump %lp1()
      } else {
        jump %bind1(())
      }
    }
    jump %lp1()
  }

Main#firstSquareOver : fun(Int) -> Int =
  fun(limit : Int) {
    let i : %Ref Int =
      ref(0)
    join %af1(%av1 : Int) : Int = {
      %av1
    }
    join rec %lp1() : ! = {
      join %bind1(%bv1 : Unit) : ! = {
        jump %lp1()
      }
      let %seq1 : Unit =
        i :=
          let x : Int =
            !i
          Prim.intAdd(x, 1)
      if
        let %eta1 : Int =
          let x : Int =
            !i
          let y : Int =
            !i
          Prim.intMul(x, y)
        %default.Ord.gt@Int(%eta1, limit)
      {
        jump %af1(
          let x : Int =
            !i
          let y : Int =
            !i
          Prim.intMul(x, y)
        )
      } else {
        jump %bind1(())
      }
    }
    jump %lp1()
  }

Main#oddsBelow : fun(Int) -> Int =
  fun(n : Int) {
    let seen : %Ref Int =
      ref(0)
    join %bind1(%bv1 : Unit) : Int = {
      !seen
    }
    let i : %Ref Int =
      ref(0)
    join rec %lp1() : ! = {
      join %st1() : ! = {
        let %seq1 : Unit =
          i :=
            let x : Int =
              !i
            Prim.intAdd(x, 1)
        jump %lp1()
      }
      if
        let x : Int =
          !i
        Prim.intLt(x, n)
      {
        join %bind2(%bv2 : Unit) : ! = {
          jump %st1()
        }
        join %bind3(%bv3 : Unit) : Unit = {
          let %seq2 : Unit =
            seen :=
              let x : Int =
                !seen
              Prim.intAdd(x, 1)
          jump %bind2(())
        }
        if
          let x : Int =
            let x : Int =
              !i
            Prim.intRem(x, 2)
          Prim.intEq(x, 0)
        {
          jump %st1()
        } else {
          jump %bind3(())
        }
      } else {
        jump %bind1(())
      }
    }
    jump %lp1()
  }

Main#firstEven : fun(Array Int) -> Option Int =
  fun(xs : Array Int) {
    join %ret1(%rv1 : Option Int) : Option Int = {
      %rv1
    }
    join %bind1(%bv1 : Unit) : Option Int = {
      jump %ret1(Data.Option#None)
    }
    let %cu1 : ArrayCursor =
      Prelude#ArrayCursor {
        at =
          0
      }
    join rec %lp1() : ! = {
      match join %ret2(%rv2 : Option Int) : Option Int = {
  %rv2
}
join %bind2(%bv2 : Unit) : Option Int = {
  let x : Int =
    xs[%cu1.at]
  let %seq1 : Unit =
    %cu1.at :=
      let x : Int =
        %cu1.at
      Prim.intAdd(x, 1)
  jump %ret2(Data.Option#Some(x))
}
if
  let %eta1 : Int =
    %cu1.at
  let %eta2 : Int =
    xs.length
  #Prim.not(Prim.intLt(%eta1, %eta2))
{
  jump %ret2(Data.Option#None)
} else {
  jump %bind2(())
} {
        Data.Option#None ->
          jump %bind1(())
        Data.Option#Some(x) ->
          join %bind3(%bv3 : Unit) : ! = {
            jump %lp1()
          }
          if
            let x : Int =
              Prim.intRem(x, 2)
            Prim.intEq(x, 0)
          {
            jump %ret1(Data.Option#Some(x))
          } else {
            jump %bind3(())
          }
      }
    }
    jump %lp1()
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      let x : Int =
        Main#total(5)
      Prim.print(Prim.intToString(x))
    let %seq2 : Unit =
      let x : Int =
        Main#firstSquareOver(20)
      Prim.print(Prim.intToString(x))
    let %seq3 : Unit =
      let x : Int =
        Main#oddsBelow(7)
      Prim.print(Prim.intToString(x))
    let %seq4 : Unit =
      let x : Option Int =
        Main#firstEven([1, 3, 4, 7])
      Prim.print(
        let o : Option Int =
          x
        match o {
          Data.Option#None ->
            "None"
          Data.Option#Some(x) ->
            let x : String =
              %inst.Add.String#add("Some(", Prim.intToString(x))
            Prim.stringConcat(x, ")")
        }
      )
    let x : Option Int =
      Main#firstEven([1, 3, 5])
    Prim.print(
      let o : Option Int =
        x
      match o {
        Data.Option#None ->
          "None"
        Data.Option#Some(x) ->
          let x : String =
            %inst.Add.String#add("Some(", Prim.intToString(x))
          Prim.stringConcat(x, ")")
      }
    )
  }
