-- A map under delete/put churn: an insert reuses a slot a delete left, and must
-- still find a key that sits past that slot on the same probe path rather than
-- store it twice.

import Data.Map as Map

fun main() {
    -- Steady size under churn: fifty live keys, a hundred thousand inserted.
    let window = Map.new()
    for var i = 0; i < 100000; i = i + 1 {
        Map.put(window, i, i * 2)
        if i >= 50 {
            let _ = Map.delete(window, i - 50)
        }
    }
    let live = Map.keys(window)
    print("live: " + show(len(live)))
    print("first: " + show(live[0]) + ", last: " + show(live[len(live) - 1]))
    print("99999 -> " + show(Map.get(window, 99999)))
    print("49 -> " + show(Map.get(window, 49)))

    -- Delete every other key, then put all of them again. The keys that were
    -- never deleted are updated in place, not inserted a second time into a
    -- tombstone ahead of them.
    let m = Map.new()
    for var i = 0; i < 12; i = i + 1 {
        Map.put(m, i, "a")
    }
    for var i = 0; i < 12; i = i + 2 {
        let _ = Map.delete(m, i)
    }
    for var i = 0; i < 12; i = i + 1 {
        Map.put(m, i, "b")
    }
    print(show(Map.entries(m)))

    -- Emptied and refilled many times over, it answers the same.
    let e = Map.new()
    for var round = 0; round < 1000; round = round + 1 {
        for var i = 0; i < 8; i = i + 1 {
            Map.put(e, i, round)
        }
        for var i = 0; i < 8; i = i + 1 {
            let _ = Map.delete(e, i)
        }
    }
    print("emptied: " + show(len(Map.keys(e))) + ", 3 -> " + show(Map.get(e, 3)))
}
