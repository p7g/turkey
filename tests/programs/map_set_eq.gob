-- Maps and sets compare by contents, whatever order the entries went in.
import Data.Set as Set

fun main() {
    let a = Map.new()
    Map.put(a, "x", 1)
    Map.put(a, "y", 2)
    let b = Map.new()
    Map.put(b, "y", 2)
    Map.put(b, "x", 1)
    print(a == b)

    Map.put(b, "x", 3)
    print(a == b)

    -- `b` grows its table and is left with deleted entries in it; neither
    -- shows in a comparison.
    Map.put(b, "x", 1)
    for i in Int.range(0, 100) { Map.put(b, Int.toString(i), i) }
    for i in Int.range(0, 100) { let _ = Map.delete(b, Int.toString(i)) }
    print(a == b)

    let s = Set.new()
    for x in [3, 1, 2] { Set.add(s, x) }
    let t = Set.new()
    for x in [1, 2, 3, 2] { Set.add(t, x) }
    print(s == t)
    let _ = Set.remove(t, 2)
    print(s != t)
}
