-- `x.f(args)` calls the `f` of the module that declares the type of `x`, with
-- `x` first: no import names it.

type Counter = Counter { var count : Int, step : fun(Int) -> Int }

-- A field holding a function is called as a method is, when the module has
-- no function of its name.
fun advance(c : Counter) -> Unit { c.count = c.step(c.count) }

-- Called as a method before it is declared.
fun total(c : Counter) -> Int = c.doubled() + 1

fun doubled(c : Counter) -> Int = c.count * 2

fun firstNumber(line : String) -> Option Int {
	let (word, _) = line.trim().splitOnce(" ")?
	Some(Int.parse(word)?.abs())
}

fun main() -> Unit {
	let line = "  hello, world  "
	print(line.trim().split(", "))
	print([1, 2, 3].map(fun(x) = x * 10))
	print(["a ", " bc"].map(_.trim().byteLength()))
	print(Some(4).map(_ + 1).unwrapOr(0))
	print(firstNumber("-12 apples"))
	print(firstNumber("none"))
	print("a,b".splitOnce(",")!.0.byteLength())
	print(" k=v ".trim().splitOnce("=").map(fun((key, _)) = key)!)
	print("${line.trim().byteLength()} bytes")

	let c = Counter { count = 3, step = fun(n) = n + 4 }
	c.advance()
	print(c.count)
	print(c.total())

	-- An empty literal's container is the one whose module has the method.
	let out = []
	out.push(1)
	out.push(2)
	print(out)

	-- So is a numeral's type: only 'Data.Float' defines 'isFinite'.
	print(16.isFinite())
	let n = 42
	print(n.toString().byteLength())
}
