-- When neither the receiver's type nor its module has an `f`, `x.f(args)`
-- calls a class method `f` in scope whose first parameter has the class's
-- type at its head.

-- A type variable from a signature names no type, so only the class applies.
fun twice[Show a](x : a) -> String = x.show() + ", " + x.show()

fun main() -> Unit {
	print(5.show())
	print([1, 2, 3].len())
	print((1, "a").show())
	print(twice(7))
}
