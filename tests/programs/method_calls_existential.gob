-- A method call decided after the `match` arm that opened an existential:
-- `w`'s type is fixed only after the `match`, so the call waits, and is then
-- solved where it was written, inside the arm.

type Box = Box { label : String }

type Shown = Shown[Show a](a)

fun render[Show a](b : Box, x : a) -> String = b.label + show(x)

fun describe(s : Shown, w) -> String {
	let out = match s {
		Shown(v) -> w.render(v)
	}
	let _ : Box = w
	out
}

fun main() -> Unit = print(describe(Shown(42), Box { label = "n=" }))
