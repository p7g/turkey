-- A class in scope does not change what a literal is: a literal is narrowed
-- only by the functions of its candidate types' modules. `16.isFinite()` is
-- 'Data.Float.isFinite' though a class with an 'isFinite' exists, and `[]` with
-- `.push` is a 'Vec' though a class with a 'push' exists. `5.show()`, which no
-- module of 'Int' or 'Float' has, is defaulted and then finds 'Show'.

class Finite a { fun isFinite(a) -> Bool }

instance Finite Bool { fun isFinite(b) = b }

class Pushy a { fun push(a, Int) -> Unit }

fun main() -> Unit {
	print(16.isFinite())
	let yes = True
	print(yes.isFinite())
	let out = []
	out.push(1)
	print(out)
	print(5.show())
}
