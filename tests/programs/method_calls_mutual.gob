-- Functions with complete signatures may call each other through method calls
-- and by name, in any mix.

type A = A(Int)

fun even(a : A) -> Bool = match a {
	A(0) -> True
	A(n) -> A(n - 1).odd()
}

fun odd(a : A) -> Bool = match a {
	A(0) -> False
	A(n) -> even(A(n - 1))
}

fun main() -> Unit {
	print(A(4).even())
	print(A(3).even())
}
