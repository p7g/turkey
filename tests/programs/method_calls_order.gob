-- A value is initialized after what it reads, through a method call too, and
-- a method call on another type orders nothing: `trim` below has a complete
-- signature, so `fallback` does not depend on it.

type Box = Box { text : String }

type P = P { x : Int }

-- Calls 'Data.String.trim', not this module's 'trim', which reads it.
let fallback = " none ".trim()

fun trim(b : Box) -> Box = if b.text == "" { Box { text = fallback } } else { b }

-- Calls 'norm', declared after it.
let origin = P { x = 3 }.norm()

fun norm(p : P) -> Int = p.x * p.x

fun main() -> Unit {
	print(Box { text = "" }.trim().text)
	print(origin)
}
