-- A method call depends on no function of its name with a complete
-- signature: `tag` calls 'Data.String.trim', and stays polymorphic though
-- this module's `trim`, which has one, calls it at two types.

type Box = Box { text : String }

fun tag(x) {
	print(" q ".trim())
	x
}

fun trim(b : Box) -> Box {
	print(tag(1) + 1)
	print(tag("s"))
	b
}

-- The same through two method calls and a call by name: `tag2` calls
-- 'Data.String.trim', `trim2` calls `label` as a method, and `label` calls
-- `tag2` at two types. `trim2` and `label` have signatures.
type Card = Card { text : String }

fun tag2(x) {
	print(" r ".trim())
	x
}

fun trim2(c : Card) -> Card {
	print(c.label())
	c
}

fun label(c : Card) -> String {
	print(tag2(1) + 1)
	tag2("s") + c.text
}

-- A method may call itself.
type Tree = Node(Tree, Tree) | Leaf

fun size(t : Tree) -> Int = match t {
	Node(l, r) -> l.size() + r.size()
	Leaf       -> 1
}

fun main() -> Unit {
	print(Box { text = "a" }.trim().text)
	print(Node(Leaf, Node(Leaf, Leaf)).size())
	print(trim2(Card { text = "!" }).text)
}
