-- A method call depends only on the same-named functions that have no complete
-- signature, as in Haskell 2010. `trim` and `label` have one, so `tag`
-- calls 'Data.String.trim' through a variable and stays polymorphic, whatever
-- order the three are declared in. (Order trim, tag, label.)

type Box = Box { text : String }

let suffix = " q "

fun trim(b : Box) -> Box {
	print(b.label())
	b
}

fun tag(x) {
	let word = suffix
	print(word.trim())
	x
}

fun label(b : Box) -> String {
	print(tag(1) + 1)
	tag("s") + b.text
}

fun main() -> Unit = print(Box { text = "!" }.trim().text)
