-- A method's own equality relating two family applications, one over the
-- method's own variable: at `W x`, `code`'s context is `F x ~ F c`, which no
-- layout is needed for, since the evidence for it is erased.

class Fam t {
    type F t
}

instance Fam Int {
    type F = Int
}

class Box a {
    type Elem a
    fun code[Elem a ~ F c](a, c) -> Int
}

type W x = W(x)

instance Box (W x) {
    type Elem = F x
    fun code(w, y) = 7
}

fun main() { print(code(W(1), 1)) }
