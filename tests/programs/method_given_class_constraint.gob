-- A method's own equality discharging a class constraint in an override: in
-- `Option`'s `code`, `Elem (Option a) ~ Int` is `a ~ Int`, so `open(o) + 100`
-- adds `Int`s, with the `Add Int` instance's dictionary.

class Box a {
    type Elem a
    fun open(a) -> Elem a
    fun code[Elem a ~ Int](x : a) -> Int = open(x)
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
    fun code(o) = open(o) + 100
}

fun main() { print(code(Some(3))) }
