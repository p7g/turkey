-- An instance method's own equality decides a class predicate. Under
-- `Elem (Option a) ~ Int`, `open(o)` is an `Int`, so `+` takes the `Add Int`
-- instance, although the instance alone reduces `Elem (Option a)` to `a`.
class Box a {
    type Elem a
    fun open(a) -> Elem a
    fun code[Elem a ~ Int](x : a) -> Int = open(x)
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
    fun code(o) = open(o) + 100
}

fun main() { print(code(Some(3))) }
