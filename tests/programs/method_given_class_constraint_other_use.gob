-- The instance of `method_given_class_constraint`, also used at a type where
-- the override's equality is false. At `String` the override's `open(o) + 100`
-- would add `String`s, but it can never be called there.

class Box a {
    type Elem a
    fun open(a) -> Elem a
    fun code[Elem a ~ Int](x : a) -> Int = open(x)
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
    fun code(o) = open(o) + 100
}

fun main() {
    print(code(Some(3)))
    print(open(Some("s")))
}
