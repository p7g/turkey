-- A method's own equality that is false at an instance: `Elem Flag` is
-- `Bool`, so `code`'s `Elem a ~ Int` can never hold for `Flag`, and its
-- override can never be called. The override is accepted unchecked, and the
-- rest of the instance works.

class Box a {
    type Elem a
    fun open(a) -> Elem a
    fun code[Elem a ~ Int](x : a) -> Int = open(x)
}

type Flag = Flag(Bool)

instance Box Flag {
    type Elem = Bool
    fun open(Flag(b)) = b
    fun code(f) = 0
}

fun main() { print(open(Flag(True))) }
