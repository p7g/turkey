-- An instance whose override relies on its method's own equality, used both
-- where the equality holds and where it does not. `Elem (Option String)` is
-- `String`, so `code` can never be called at `String`, but `open` can, and the
-- instance's dictionary is built there.

class Box a {
    type Elem a
    fun open(a) -> Elem a
    fun code[Elem a ~ Int](x : a) -> Int = open(x)
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
    fun code(o) = open(o)
}

fun main() {
    print(code(Some(3)))
    print(open(Some("s")))
}
