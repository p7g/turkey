-- A method's own equality whose family the instance defines as another
-- family: in `Wrap`'s `code`, the given `Elem (Wrap a) ~ Int` is
-- `Elem a ~ Int` once the instance reduces it, which is what the inner call
-- needs.

class Box a {
    type Elem a
    fun open(a) -> Elem a
    fun code[Elem a ~ Int](x : a) -> Int = open(x)
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

type Wrap a = Wrap(a)

instance Box (Wrap a) : Box a {
    type Elem = Elem a
    fun open(Wrap(x)) = open(x)
    fun code(Wrap(x)) = code(x)
}

fun main() { print(code(Wrap(Some(3)))) }
