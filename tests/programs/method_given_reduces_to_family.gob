-- An instance method overrides a method with its own equality, and the
-- instance's associated type is another family application: a wrapper that
-- delegates to what it wraps. In `Wrap`'s `code` the given is
-- `Elem (Wrap a) ~ Int`, and the inner call asks for `Elem a ~ Int`, which is
-- the same equality once the instance reduces the given's family side.
class Box a {
    type Elem a
    fun open(a) -> Elem a
    fun code[Elem a ~ Int](x : a) -> Int = open(x)
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

type Wrap a = Wrap(a)

instance Box (Wrap a) : Box a {
    type Elem = Elem a
    fun open(Wrap(x)) = open(x)
    fun code(Wrap(x)) = code(x)
}

fun main() { print(code(Wrap(Some(3)))) }
