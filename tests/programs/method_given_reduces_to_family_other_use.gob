-- The instances of `method_given_reduces_to_family`, also used at a type where
-- the override's equality is false: `Elem (Wrap (Option Bool))` is `Bool`.
-- The override is never called there, but its dictionary is specialized
-- there all the same.

class Box a {
    type Elem a
    fun open(a) -> Elem a
    fun code[Elem a ~ Int](x : a) -> Int = open(x)
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

type Wrap a = Wrap(a)

instance Box (Wrap a) : Box a {
    type Elem = Elem a
    fun open(Wrap(x)) = open(x)
    fun code(Wrap(x)) = code(x)
}

fun main() {
    print(code(Wrap(Some(3))))
    print(open(Wrap(Some(True))))
}

--@ xfail: TIX-551, a method's equality is attached to its whole dictionary
