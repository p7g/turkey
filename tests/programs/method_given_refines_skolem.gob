-- A method's own equality that the instance reduces to one of its type
-- variables: in `Pair`'s `total`, `Elem (Pair a) ~ Int` is `a ~ Int`, so `x`
-- and `y` are `Int`s inside the method.

class Bag b {
    type Elem b
    fun items(b) -> Array (Elem b)
    fun total[Elem b ~ Int](bag : b) -> Int = 0
}

type Pair a = Pair(a, a)

instance Bag (Pair a) {
    type Elem = a
    fun items(Pair(x, y)) = [x, y]
    fun total(Pair(x, y)) = x + y
}

fun main() { print(total(Pair(1, 2))) }
