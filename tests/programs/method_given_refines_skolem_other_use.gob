-- The instance of `method_given_refines_skolem`, used at a type where its
-- override's equality is false. The override is never called, but its
-- dictionary is specialized at `String` all the same, where the refinement
-- `a ~ Int` it was checked under does not hold.

class Bag b {
    type Elem b
    fun items(b) -> Array (Elem b)
    fun total[Elem b ~ Int](bag : b) -> Int = 0
}

type Pair a = Pair(a, a)

instance Bag (Pair a) {
    type Elem = a
    fun items(Pair(x, y)) = [x, y]
    fun total(Pair(x, y)) = x + y
}

fun main() { print(len(items(Pair("a", "b")))) }

--@ xfail: TIX-551, a method's equality is attached to its whole dictionary
