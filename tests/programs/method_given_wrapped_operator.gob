-- Both of the above at once: a class operator over a family that only the
-- reduced given decides, `open(x) : Elem a` under `Elem (Wrap a) ~ Int`, and
-- an override nested two wrappers deep.
class Box a {
    type Elem a
    fun open(a) -> Elem a
    fun code[Elem a ~ Int](x : a) -> Int = open(x)
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
    fun code(o) = open(o) + 100
}

type Wrap a = Wrap(a)

instance Box (Wrap a) : Box a {
    type Elem = Elem a
    fun open(Wrap(x)) = open(x)
    fun code(Wrap(x)) = code(x) + open(x) * 10
}

fun main() {
    print(code(Wrap(Some(3))))
    print(code(Wrap(Wrap(Some(4)))))
}
