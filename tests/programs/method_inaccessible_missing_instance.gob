-- An override checked under a method equality that can never hold at its
-- instance, `Elem Flag ~ Int` with `Elem Flag = Bool`, is inaccessible, and
-- what it reports is muted. Its `open(f) + open(f)` has no `Add Bool`, and
-- the override can never be called.

class Box a {
    type Elem a
    fun open(a) -> Elem a
    fun code[Elem a ~ Int](x : a) -> Int = open(x)
}

type Flag = Flag(Bool)

instance Box Flag {
    type Elem = Bool
    fun open(Flag(b)) = b
    fun code(f) = show(open(f) + open(f)) == "x"
}

fun main() { print(open(Flag(True))) }

--@ xfail: TIX-562, an inaccessible override is lowered with no evidence for its body
