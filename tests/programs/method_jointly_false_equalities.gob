-- A method with two equalities that each could hold at an instance but never
-- both: at `Option x`, `Elem` and `Key` are both `x`, so `x ~ Int` and
-- `x ~ Bool` together are false. The override can never be called, and what
-- it reports is muted: it has no `Show x`.

class Box a {
    type Elem a
    type Key a
    fun open(a) -> Elem a
    fun code[Elem a ~ Int, Key a ~ Bool](x : a) -> Int = 0
}

instance Box (Option x) {
    type Elem = x
    type Key = x
    fun open(o) = match o {
        Some(v) -> v
        None -> error("empty")
    }
    fun code(o) = if show(open(o)) == "1" { 1 } else { 2 }
}

fun main() { print(open(Some("s"))) }
