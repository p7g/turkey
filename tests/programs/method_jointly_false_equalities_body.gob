-- As in `method_jointly_false_equalities`, with an override that returns the
-- `x` its context says is an `Int`.

class Box a {
    type Elem a
    type Key a
    fun open(a) -> Elem a
    fun code[Elem a ~ Int, Key a ~ Bool](x : a) -> Int = 0
}

instance Box (Option x) {
    type Elem = x
    type Key = x
    fun open(o) = match o {
        Some(v) -> v
        None -> error("empty")
    }
    fun code(o) = open(o)
}

fun main() { print(open(Some("s"))) }
