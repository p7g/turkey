-- An instance method whose unannotated parameter `s` takes its type from the
-- class. A closure inside a loop reads a field of `s`, and leaves through
-- `return` and `?`, so the field's type is needed while the closure's own
-- result is still being solved. That needs `s : Span` before the body is
-- checked, not after.
type Box = Box { var n : Int }

type Span = Span { from : Int, to : Int }

class Put w {
    fun put(w, Span) -> Either String Int
}

fun step(f : fun(Int) -> Either String Int) -> Either String Int = f(1)

instance Put Box {
    fun put(b, s) {
        var at = s.from
        while at < s.to {
            let start = at
            let moved = step(fun(x) {
                if start + x > s.from + 2 { return Left("no room at " + Int.toString(start)) }
                Right(x)
            })?
            at = at + moved
            b.n = b.n + 1
        }
        Right(b.n)
    }
}

fun main() {
    let b = Box { n = 0 }
    print(put(b, Span { from = 0, to = 2 }))
    print(put(b, Span { from = 0, to = 5 }))
}
