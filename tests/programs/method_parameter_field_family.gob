-- An instance method that projects a field of an unannotated parameter whose
-- type is the instance head. `w.inner` is `r` by the record's declaration, and
-- the parameter has to be `Wrapped r` before the body is checked for that to
-- reduce ahead of the associated type `Err` it meets.
class Source r {
    type Err r
    fun pull(r) -> Either (Err r) Int
}

type Wrapped r = Wrapped { inner : r }

type Counter = Counter { var left : Int }

instance Source Counter {
    type Err = String
    fun pull(c) {
        if c.left == 0 { return Left("empty") }
        c.left = c.left - 1
        Right(c.left)
    }
}

instance Source (Wrapped r) : Source r {
    type Err = Err r
    fun pull(w) = pull(w.inner)
}

fun main() {
    let w = Wrapped { inner = Counter { left = 1 } }
    print(pull(w))
    print(pull(w))
}
