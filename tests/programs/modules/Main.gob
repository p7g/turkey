import Stack (empty, push, pop)
import Geometry as G

-- A bare `add`, which every version before M11a rejected outright.
fun add(x : String, y : String) -> String = x + y

fun main() {
    let s = empty()
    push(s, 1)
    push(s, 2)
    print(pop(s))
    print(pop(s))
    print(pop(s))

    print(add("mod", "ules"))
    print(1 + 2)                -- still Add.add, not the local `add`

    -- A constructor is scoped like everything else (delta 43), so under a
    -- qualified import it is written `G.Point`.
    print(G.describe(G.translate(G.Point(1, 2), 3, 4)))

    -- And matched the same way, in an arm and in a `let` (TIX-78): under this
    -- import the bare `Point` is not in scope, so without the qualified
    -- pattern the constructor could not be taken apart at all.
    match G.translate(G.Point(1, 2), 1, 1) {
        G.Point(x, y) -> print(x * y)
    }
    let G.Point(a, b) = G.Point(5, 7)
    print(a + b)
}
