module Stack (Stack, empty, push, pop)

-- `push` and `pop` are the point of this module: `Array.push` is the library's,
-- reached qualified, so a program is free to define its own bare `push`.
type Stack a = Stack { items : Array a }

fun empty() -> Stack a = Stack { items = [] }

fun push(s : Stack a, x : a) -> Unit { Array.push(s.items, x) }

fun pop(s : Stack a) -> Option a = Array.pop(s.items)
