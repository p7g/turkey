-- bindings
Main#half : fun(Int) -> Option Int =
  fun(n : Int) {
    if %inst.Std.Classes#Eq.Int.eq(%inst.Std.Classes#Rem.Int.rem(n, 2), 0) {
      Data.Option.Type#Some(%inst.Std.Classes#Div.Int.div(n, 2))
    } else {
      Data.Option.Type#None
    }
  }

Main#quarter : fun(Int) -> Option Int =
  fun(n : Int) {
    %inst.Std.Classes#Monad.Data.Option.Type#Option.bind[Int, Int](Main#half(n), Main#half)
  }

Main#checked : fun(Int) -> Either String Int =
  fun(n : Int) {
    if %inst.Std.Classes#Eq.Int.eq(n, 0) {
      Data.Either#Left("zero")
    } else {
      Data.Either#Right(%inst.Std.Classes#Div.Int.div(100, n))
    }
  }

Main#twoSteps : fun(Int) -> Either String Int =
  fun(n : Int) {
    %inst.Std.Classes#Monad.Data.Either#Either[String].bind[Int, Int](
      Main#checked(n),
      fun(x : Int) {
        %inst.Std.Classes#Monad.Data.Either#Either[String].bind[Int, Int](
          Main#checked(x),
          fun(y : Int) {
            Data.Either#Right(%inst.Std.Classes#Add.Int.add(x, y))
          }
        )
      }
    )
  }

Main#pairs : fun(Array Int, Array Int) -> Array Int =
  fun(xs : Array Int, ys : Array Int) {
    %inst.Std.Classes#Monad.Data.Array#Array.bind[Int, Int](
      xs,
      fun(x : Int) {
        %inst.Std.Classes#Monad.Data.Array#Array.bind[Int, Int](
          ys,
          fun(y : Int) {
            %inst.Std.Classes#Applicative.Data.Array#Array.pure[Int](%inst.Std.Classes#Mul.Int.mul(x, y))
          }
        )
      }
    )
  }

Main#thrice : forall a b. fun(Monad a) -> fun(a b, fun(b) -> a b) -> a b =
  fun(%d1.Std.Classes#Monad : Monad a) {
    fun(x : a b, g : fun(b) -> a b) {
      %d1.Std.Classes#Monad.bind[b, b](
        x,
        fun(u : b) {
          %d1.Std.Classes#Monad.bind[b, b](
            g(u),
            fun(v : b) {
              g(v)
            }
          )
        }
      )
    }
  }

Main#bump : forall a. fun(Monad a) -> fun(a Int) -> a Int =
  fun(%d1.Std.Classes#Monad : Monad a) {
    fun(x : a Int) {
      %d1.Std.Classes#Monad.%super.Std.Classes#Applicative.%super.Std.Classes#Functor.map[Int, Int](
        x,
        fun(n : Int) {
          %inst.Std.Classes#Add.Int.add(n, 1)
        }
      )
    }
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      Std.Classes#print[Option Int](%inst.Std.Classes#Show.Data.Option.Type#Option[Int](%inst.Std.Classes#Show.Int))(Main#quarter(20))
    let %seq2 : Unit =
      Std.Classes#print[Option Int](%inst.Std.Classes#Show.Data.Option.Type#Option[Int](%inst.Std.Classes#Show.Int))(Main#quarter(6))
    let %seq3 : Unit =
      Std.Classes#print[Either String Int](%inst.Std.Classes#Show.Data.Either#Either[String, Int](%inst.Std.Classes#Show.String, %inst.Std.Classes#Show.Int))(Main#twoSteps(4))
    let %seq4 : Unit =
      Std.Classes#print[Either String Int](%inst.Std.Classes#Show.Data.Either#Either[String, Int](%inst.Std.Classes#Show.String, %inst.Std.Classes#Show.Int))(Main#twoSteps(0))
    let %seq5 : Unit =
      Std.Classes#print[Array Int](%inst.Std.Classes#Show.Data.Array#Array[Int](%inst.Std.Classes#Show.Int))(Main#pairs(Data.Array#Array([1, 2, 3]), Data.Array#Array([10, 20])))
    let %seq6 : Unit =
      Std.Classes#print[Array Int](%inst.Std.Classes#Show.Data.Array#Array[Int](%inst.Std.Classes#Show.Int))(Main#pairs(Data.Array#Array([]), Data.Array#Array([10, 20])))
    let %seq7 : Unit =
      Std.Classes#print[Option Int](%inst.Std.Classes#Show.Data.Option.Type#Option[Int](%inst.Std.Classes#Show.Int))(Main#thrice[Option, Int](%inst.Std.Classes#Monad.Data.Option.Type#Option)(Data.Option.Type#Some(80), Main#half))
    let %seq8 : Unit =
      Std.Classes#print[Option Int](%inst.Std.Classes#Show.Data.Option.Type#Option[Int](%inst.Std.Classes#Show.Int))(Main#thrice[Option, Int](%inst.Std.Classes#Monad.Data.Option.Type#Option)(Data.Option.Type#Some(81), Main#half))
    let %seq9 : Unit =
      Std.Classes#print[Array Int](%inst.Std.Classes#Show.Data.Array#Array[Int](%inst.Std.Classes#Show.Int))(
        Main#thrice[Array, Int](%inst.Std.Classes#Monad.Data.Array#Array)(
          Data.Array#Array([1, 2]),
          fun(n : Int) {
            Data.Array#Array([n, %inst.Std.Classes#Mul.Int.mul(n, 10)])
          }
        )
      )
    let %seq10 : Unit =
      Std.Classes#print[Option Int](%inst.Std.Classes#Show.Data.Option.Type#Option[Int](%inst.Std.Classes#Show.Int))(Main#bump[Option](%inst.Std.Classes#Monad.Data.Option.Type#Option)(Data.Option.Type#Some(41)))
    let %seq11 : Unit =
      Std.Classes#print[Array Int](%inst.Std.Classes#Show.Data.Array#Array[Int](%inst.Std.Classes#Show.Int))(Main#bump[Array](%inst.Std.Classes#Monad.Data.Array#Array)(Data.Array#Array([1, 2, 3])))
    let %seq12 : Unit =
      Std.Classes#print[Option Int](%inst.Std.Classes#Show.Data.Option.Type#Option[Int](%inst.Std.Classes#Show.Int))(
        %inst.Std.Classes#Functor.Data.Option.Type#Option.map[Int, Int](
          Data.Option.Type#Some(20),
          fun(n : Int) {
            %inst.Std.Classes#Mul.Int.mul(n, 2)
          }
        )
      )
    let %seq13 : Unit =
      Std.Classes#print[Array Int](%inst.Std.Classes#Show.Data.Array#Array[Int](%inst.Std.Classes#Show.Int))(
        %inst.Std.Classes#Functor.Data.Array#Array.map[Int, Int](
          Data.Array#Array([1, 2, 3]),
          fun(n : Int) {
            %inst.Std.Classes#Mul.Int.mul(n, n)
          }
        )
      )
    let lifted : Option Int =
      %inst.Std.Classes#Applicative.Data.Option.Type#Option.pure[Int](7)
    let %seq14 : Unit =
      Std.Classes#print[Option Int](%inst.Std.Classes#Show.Data.Option.Type#Option[Int](%inst.Std.Classes#Show.Int))(lifted)
    let %seq15 : Unit =
      Std.Classes#print[Bool](%inst.Std.Classes#Show.Data.Bool.Type#Bool)(Data.Either#isRight[String, Int](Main#checked(5)))
    Std.Classes#print[Int](%inst.Std.Classes#Show.Int)(Data.Either#unwrapOr[String, Int](Main#checked(0), %inst.Std.Classes#Neg.Int.neg(1)))
  }
