-- bindings
Main#half : fun(Int) -> Option Int =
  fun(n : Int) {
    if %inst.Eq.Int.eq(%inst.Rem.Int.rem(n, 2), 0) {
      Data.Option#Some(%inst.Div.Int.div(n, 2))
    } else {
      Data.Option#None
    }
  }

Main#quarter : fun(Int) -> Option Int =
  fun(n : Int) {
    %inst.Monad.Data.Option#Option.bind[Int, Int](Main#half(n), Main#half)
  }

Main#checked : fun(Int) -> Either String Int =
  fun(n : Int) {
    if %inst.Eq.Int.eq(n, 0) {
      Data.Either#Left("zero")
    } else {
      Data.Either#Right(%inst.Div.Int.div(100, n))
    }
  }

Main#twoSteps : fun(Int) -> Either String Int =
  fun(n : Int) {
    %inst.Monad.Data.Either#Either[String].bind[Int, Int](
      Main#checked(n),
      fun(x : Int) {
        %inst.Monad.Data.Either#Either[String].bind[Int, Int](
          Main#checked(x),
          fun(y : Int) {
            Data.Either#Right(%inst.Add.Int.add(x, y))
          }
        )
      }
    )
  }

Main#pairs : fun(Array Int, Array Int) -> Array Int =
  fun(xs : Array Int, ys : Array Int) {
    %inst.Monad.Array.bind[Int, Int](
      xs,
      fun(x : Int) {
        %inst.Monad.Array.bind[Int, Int](
          ys,
          fun(y : Int) {
            %inst.Applicative.Array.pure[Int](%inst.Mul.Int.mul(x, y))
          }
        )
      }
    )
  }

Main#thrice : forall a b. fun(%Dict.Monad a) -> fun(a b, fun(b) -> a b) -> a b =
  fun(%d1.Monad : %Dict.Monad a) {
    fun(x : a b, g : fun(b) -> a b) {
      %d1.Monad.bind[b, b](
        x,
        fun(u : b) {
          %d1.Monad.bind[b, b](
            g(u),
            fun(v : b) {
              g(v)
            }
          )
        }
      )
    }
  }

Main#bump : forall a. fun(%Dict.Monad a) -> fun(a Int) -> a Int =
  fun(%d1.Monad : %Dict.Monad a) {
    fun(x : a Int) {
      %d1.Monad.%super.Applicative.%super.Functor.map[Int, Int](
        x,
        fun(n : Int) {
          %inst.Add.Int.add(n, 1)
        }
      )
    }
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      Prelude#print[Option Int](%inst.Show.Data.Option#Option[Int](%inst.Show.Int))(Main#quarter(20))
    let %seq2 : Unit =
      Prelude#print[Option Int](%inst.Show.Data.Option#Option[Int](%inst.Show.Int))(Main#quarter(6))
    let %seq3 : Unit =
      Prelude#print[Either String Int](%inst.Show.Data.Either#Either[String, Int](%inst.Show.String, %inst.Show.Int))(Main#twoSteps(4))
    let %seq4 : Unit =
      Prelude#print[Either String Int](%inst.Show.Data.Either#Either[String, Int](%inst.Show.String, %inst.Show.Int))(Main#twoSteps(0))
    let %seq5 : Unit =
      Prelude#print[Array Int](%inst.Show.Array[Int](%inst.Show.Int))(Main#pairs([1, 2, 3], [10, 20]))
    let %seq6 : Unit =
      Prelude#print[Array Int](%inst.Show.Array[Int](%inst.Show.Int))(Main#pairs([], [10, 20]))
    let %seq7 : Unit =
      Prelude#print[Option Int](%inst.Show.Data.Option#Option[Int](%inst.Show.Int))(Main#thrice[Option, Int](%inst.Monad.Data.Option#Option)(Data.Option#Some(80), Main#half))
    let %seq8 : Unit =
      Prelude#print[Option Int](%inst.Show.Data.Option#Option[Int](%inst.Show.Int))(Main#thrice[Option, Int](%inst.Monad.Data.Option#Option)(Data.Option#Some(81), Main#half))
    let %seq9 : Unit =
      Prelude#print[Array Int](%inst.Show.Array[Int](%inst.Show.Int))(
        Main#thrice[Array, Int](%inst.Monad.Array)(
          [1, 2],
          fun(n : Int) {
            [n, %inst.Mul.Int.mul(n, 10)]
          }
        )
      )
    let %seq10 : Unit =
      Prelude#print[Option Int](%inst.Show.Data.Option#Option[Int](%inst.Show.Int))(Main#bump[Option](%inst.Monad.Data.Option#Option)(Data.Option#Some(41)))
    let %seq11 : Unit =
      Prelude#print[Array Int](%inst.Show.Array[Int](%inst.Show.Int))(Main#bump[Array](%inst.Monad.Array)([1, 2, 3]))
    let %seq12 : Unit =
      Prelude#print[Option Int](%inst.Show.Data.Option#Option[Int](%inst.Show.Int))(
        %inst.Functor.Data.Option#Option.map[Int, Int](
          Data.Option#Some(20),
          fun(n : Int) {
            %inst.Mul.Int.mul(n, 2)
          }
        )
      )
    let %seq13 : Unit =
      Prelude#print[Array Int](%inst.Show.Array[Int](%inst.Show.Int))(
        %inst.Functor.Array.map[Int, Int](
          [1, 2, 3],
          fun(n : Int) {
            %inst.Mul.Int.mul(n, n)
          }
        )
      )
    let lifted : Option Int =
      %inst.Applicative.Data.Option#Option.pure[Int](7)
    let %seq14 : Unit =
      Prelude#print[Option Int](%inst.Show.Data.Option#Option[Int](%inst.Show.Int))(lifted)
    let %seq15 : Unit =
      Prelude#print[Bool](%inst.Show.Data.Bool#Bool)(Data.Either#isRight[String, Int](Main#checked(5)))
    Prelude#print[Int](%inst.Show.Int)(Data.Either#unwrapOr[String, Int](Main#checked(0), %inst.Neg.Int.neg(1)))
  }
