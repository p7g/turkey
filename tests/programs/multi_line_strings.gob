-- Multi-line strings: the closing `"""` sets the indentation every line
-- loses, the lines are joined by line feeds, and a `\` at the end of a line
-- joins it to the next. Holes work as in a one-line string.

fun usage() -> String {
    """
    usage: turkey build FILE
      -o OUT   write to OUT
    """
}

-- `s` in quotes, with each line feed written `\n` so the lines it ends show.
fun quoted(s : String) -> String = "\"" + String.replace(s, "\n", "\\n") + "\""

fun main() {
    print(usage())
    print(quoted(usage()))

    -- Indentation past the closing line's is kept.
    print(quoted("""
            deeper
        level
        """))

    -- A line of only spaces and tabs may be indented less, and is empty.
    print(quoted("""
        a

        b
        """))

    -- No lines at all is the empty string, and so is one empty line.
    print(quoted("""
        """))
    print(quoted("""

        """))

    -- An empty last line, or a `\n` escape, ends the text in a line feed.
    print(quoted("""
        one

        """))
    print(quoted("""
        one\n
        """))

    -- Escapes, and quotes that do not close the string.
    print(quoted("""
        tab:\t| "one" ""two"" \""" | \u{1F600} | $5 \${x}
        """))

    -- A trailing `\` leaves out the line break. On the last line it changes
    -- nothing, since that line break is left out anyway.
    print(quoted("""
        one \
        line
        """))
    print(quoted("""
        one \
        line\
        """))

    -- Holes, on any line and anywhere in it, and with strings that have holes
    -- of their own. A line of text may start with a hole, and the indentation
    -- is stripped from the text only.
    let name = "world"
    print(quoted("""
        ${name}

          hello, ${name}! ${String.codePointCount(name)}${"${len([1, 2])} ${ {- a comment -} name}"}
        ${name} \
        joined ${"end"}
        """))
    print(quoted("""
        ${name}
        """))

    -- The closing line may carry more code after the `"""`.
    let xs = ["""
        first
        """, "second"]
    print(quoted(xs[0]) + " " + quoted(xs[1]))
}
