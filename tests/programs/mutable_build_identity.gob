-- A build of a type with a `var` field makes an object, however it is
-- written: `Counter(0)` as much as `Counter { n = 0 }`. Copying the build into
-- each place its value is used would make one object per use, and the
-- assignments would land on different objects.

type Counter = Counter { var n : Int }

fun twice(c : Counter) -> Int {
    c.n = c.n + 1
    c.n = c.n + 1
    c.n
}

fun main() {
    print(twice(Counter(0)))
    print(twice(Counter { n = 0 }))
    let c = Counter(1)
    c.n = 5
    let Counter(n) = c
    print(n)
}
