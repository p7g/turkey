-- Fields narrower than a word, beside pointers and wider scalars, through every
-- way an object is built and read: a record with `var` fields, a tuple, a
-- generic box at a narrow type, a closure's captures, an existential, an
-- object that stays in the frame, and enough garbage between the reads that a
-- collection runs while the objects are live.

type Flags = Flags {
    var on : Bool,
    name : String,
    letter : Char,
    small : Byte,
    var count : Int,
    off : Bool,
    ratio : Float,
}

type Box a = Box(a)

fun box(x : a) -> Box a = Box(x)

fun unbox(b : Box a) -> a = match b {
    Box(x) -> x
}

type Shown = Shown[a](a, fun(a) -> String, Bool)

fun reveal(Shown(x, f, keep)) -> Unit = print(f(x) + " " + show(keep))

fun garbage(n : Int) -> Int {
    var total = 0
    for var i = 0; i < n; i = i + 1 {
        let s = Int.toString(i) + "."
        total = total + String.byteLength(s)
    }
    total
}

fun describe(f : Flags) -> String =
    f.name + " " + show(f.on) + " " + Char.toString(f.letter) + " "
    + Int.toString(Byte.toInt(f.small)) + " " + Int.toString(f.count) + " "
    + show(f.off) + " " + show(f.ratio)

fun local(b : Bool, c : Char, n : Int) -> String {
    -- Read in this frame only, so it need not reach the heap.
    let pair = (b, c, n)
    let (x, y, z) = pair
    show(x) + Char.toString(y) + Int.toString(z)
}

fun main() {
    let kept = []
    for var i = 0; i < 200; i = i + 1 {
        Vec.push(kept, Flags {
            on = i % 2 == 0, name = "f" + Int.toString(i), letter = 'a',
            small = Byte.truncate(i % 256), count = i, off = i % 3 == 0, ratio = 0.5,
        })
    }
    let _ = garbage(20000)
    kept[3].on = True
    kept[3].count = 33
    print(describe(kept[3]))
    print(describe(kept[199]))

    let t = (True, 'q', "tuple", Byte.truncate(200), False)
    let _ = garbage(20000)
    let (a, b, c, d, e) = t
    print(show(a) + " " + Char.toString(b) + " " + c + " "
          + Int.toString(Byte.toInt(d)) + " " + show(e))

    let boxes = [box(True), box(False)]
    let chars = [box('x'), box('y')]
    let _ = garbage(20000)
    print(show(unbox(boxes[0])) + " " + show(unbox(boxes[1])) + " "
          + Char.toString(unbox(chars[1])))

    let flag = kept[10].off
    let letter = kept[10].letter
    let name = kept[10].name
    let closure = fun(n : Int) = name + ":" + show(flag) + Char.toString(letter) + Int.toString(n)
    let _ = garbage(20000)
    print(closure(5))

    let shown = [Shown(42, Int.toString, True), Shown('z', Char.toString, False)]
    let _ = garbage(20000)
    for s in shown { reveal(s) }

    print(local(True, 'k', 7))
}
