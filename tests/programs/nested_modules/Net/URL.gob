module (URL, parse, show)

type URL = URL { host : String, path : String }

fun parse(text : String) -> Option URL {
    let rest = String.stripPrefix(text, "http://")?
    match String.splitOnce(rest, "/") {
        Some((host, path)) -> Some(URL { host, path = "/" + path })
        None -> Some(URL { host = rest, path = "/" })
    }
}

fun show(url : URL) -> String = url.host + url.path
