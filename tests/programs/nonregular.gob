-- A non-regular type holds itself at a larger type, so its values have
-- fields at ever larger types. `-g` describes the outer ones in full and
-- the deeper ones by their layout, and so finishes.

type Nest a = Nil | Cons(a, Nest (Array a))

fun depth(n : Nest a) -> Int = match n {
    Nil -> 0
    Cons(_, rest) -> 1 + depth(rest)
}

fun main() {
    print(depth(Cons(1, Cons([2], Cons([[3]], Nil)))))
}
