-- `identical` tells objects apart where `==` cannot: arrays, records with a
-- `var` field, and the wrappers over them, which are the objects they wrap.

type Counter = Counter { var count : Int }

type Box a = Box(a)

-- Whether `xs` holds `x` itself, where `==` would accept any equal element.
fun holds[Object a](xs : Array a, x : a) -> Bool = Iterator.any(xs, identical(_, x))

fun main() {
    let a = Counter { count = 0 }
    let b = Counter { count = 0 }
    let alias = a
    print(a == b)
    print(identical(a, b))
    print(identical(a, alias))
    alias.count = 1
    print(a.count)

    let xs = [1, 2]
    let ys = [1, 2]
    print(xs == ys)
    print(identical(xs, ys))
    print(identical(xs, xs))

    let v : Vec Int = Vec.new(1)
    let w : Vec Int = Vec.new(1)
    print(v == w)
    print(identical(v, v))
    print(identical(v, w))

    let m : Map String Int = Map.new()
    print(identical(m, m))
    print(identical(m, Map.new()))

    print(identical(Box(a), Box(alias)))
    print(identical(Box(a), Box(b)))

    print(holds([a, b], b))
    print(holds([a, b], Counter { count = 0 }))
}
