-- A record with one field and no `var` is its field at run time, as a
-- one-field positional constructor is. One whose field is `var` keeps its box:
-- two names for it must see one assignment.

type Meters = Meters { value : Float }
type Name = Name { text : String }
type Cell = Cell { var n : Int }

fun total(ms : Array Meters) -> Float {
    var sum = 0.0
    for Meters { value } in ms { sum = sum + value }
    sum
}

-- Polymorphic in the receiver, so the field is read through its evidence.
fun valueOf(r) = r.value

fun bump(c : Cell) { c.n = c.n + 1 }

fun main() {
    let ms = [Meters { value = 1.5 }, Meters { value = 2.25 }]
    print(total(ms))
    print(valueOf(ms[1]))
    let n = Name { text = "turkey" }
    let Name(t) = n
    print(t + " " + n.text)
    let c = Cell { n = 1 }
    let alias = c
    bump(alias)
    bump(c)
    print(c.n)
}
