-- Alternatives nested inside a pattern: in a tuple, a constructor's
-- arguments and a record's fields, binding variables or not, one inside
-- another, and in `let`, parameter and `for` patterns. The suite compiles
-- this with the resolution check on, which fails if two alternatives' `n`
-- are given different binders.

type Method = GET | HEAD | POST | DELETE

type Shape = Circle(Int) | Square(Int) | Rect(Int, Int) | Dot

type Point = Point { x : Int, y : Int }

-- In a tuple, beside a literal.
fun route(method : Method, path : String) -> String = match (method, path) {
    (GET | HEAD, "/health") -> "ok"
    (POST | DELETE, "/health") -> "method not allowed"
    _ -> "not found"
}

-- In a constructor's argument, and alternatives of literals.
fun small(o : Option Int) -> Bool = match o {
    Some(0 | 1 | 2) -> True
    _ -> False
}

-- In a record's field.
fun onAxis(p : Point) -> String = match p {
    Point { x = 0, y = 0 } -> "origin"
    Point { x = 0, .. } | Point { y = 0, .. } -> "on an axis"
    _ -> "off the axes"
}

-- Alternatives that bind, with the rest of the tuple after them.
fun side(pair : (Shape, Int)) -> Int = match pair {
    (Circle(n) | Square(n), k) -> n * k
    (Rect(w, h), _) -> w * h
    (Dot, k) -> k
}

-- Nested alternatives commit to the first that matches: when the condition
-- after them fails, the other alternative is not tried. Alternatives at the
-- top of the pattern list are each tried in turn.
fun wide(s : Shape) -> String {
    let nested = if let (Rect(w, _) | Rect(_, w)) = s, w > 100 { "wide" } else { "narrow" }
    let listed = if let Rect(w, _) | Rect(_, w) = s, w > 100 { "wide" } else { "narrow" }
    nested + " " + listed
}

-- Alternatives inside an alternative.
fun innermost(o : Option (Either (Either Int Int) Int)) -> Int = match o {
    Some(Left(Left(n) | Right(n)) | Right(n)) -> n
    None -> -1
}

-- In a parameter and a `let`, where the alternatives together match
-- everything.
fun either((Left(n) | Right(n)) : Either Int Int) -> Int = n

fun firstOf(e : Either (Int, String) (String, Int)) -> String {
    let (Left((_, s)) | Right((s, _))) = e
    s
}

fun main() {
    print(route(GET, "/health"))
    print(route(HEAD, "/health"))
    print(route(DELETE, "/health"))
    print(route(GET, "/"))
    print(small(Some(2)))
    print(small(Some(3)))
    print(small(None))
    for p in [Point { x = 0, y = 0 }, Point { x = 0, y = 4 }, Point { x = 5, y = 0 },
              Point { x = 1, y = 1 }] {
        print(onAxis(p))
    }
    print(side((Circle(3), 2)))
    print(side((Square(4), 2)))
    print(side((Rect(2, 3), 1)))
    print(side((Dot, 7)))
    print(wide(Rect(200, 3)))
    print(wide(Rect(2, 300)))
    print(innermost(Some(Left(Left(4)))))
    print(innermost(Some(Left(Right(5)))))
    print(innermost(Some(Right(9))))
    print(innermost(None))
    print(either(Left(1)) + either(Right(2)))
    print(firstOf(Left((1, "left"))) + " " + firstOf(Right(("right", 2))))
    for (Left(n) | Right(n)) in [Left(10), Right(20)] {
        print(n)
    }
}
