-- A `match` with no catch-all, exhaustive only because of the alternatives
-- nested in its patterns, and a `let` that is irrefutable only because of
-- them.

type Light = Red | Amber | Green

fun action(pair : (Light, Bool)) -> String = match pair {
    (Red | Amber, _) -> "stop"
    (Green, True | False) -> "go"
}

fun count(e : Either Int (Int, Int)) -> Int {
    let (Left(n) | Right((n, _))) = e
    n
}

fun main() {
    for light in [Red, Amber, Green] {
        print(action((light, True)))
    }
    print(count(Left(1)) + count(Right((2, 3))))
}
