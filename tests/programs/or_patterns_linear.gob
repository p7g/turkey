-- Alternatives nested in a pattern are compiled where they stand, not
-- multiplied out. `or_patterns_linear.opt` is what `bits` becomes: one test
-- per alternative and one join per group of them, where one arm per
-- combination would be sixteen arms.

fun bits(t : (Int, Int, Int, Int)) -> Bool = match t {
    (0 | 1, 0 | 1, 0 | 1, 0 | 1) -> True
    _ -> False
}

fun main() {
    print(bits((1, 0, 1, 1)))
    print(bits((1, 0, 2, 1)))
}
