-- bindings
Main#bits : fun((Int, Int, Int, Int)) -> Bool =
  fun(t : (Int, Int, Int, Int)) {
    join %next() : Bool = {
      Data.Bool#False
    }
    match t {
      (%field%1, %field%2, %field%3, %field%4) ->
        join %matched%1() : Bool = {
          join %matched%2() : Bool = {
            join %matched%3() : Bool = {
              join %matched%4() : Bool = {
                Data.Bool#True
              }
              match %field%4 {
                0 ->
                  jump %matched%4()
                1 ->
                  jump %matched%4()
                _ ->
                  jump %next()
              }
            }
            match %field%3 {
              0 ->
                jump %matched%3()
              1 ->
                jump %matched%3()
              _ ->
                jump %next()
            }
          }
          match %field%2 {
            0 ->
              jump %matched%2()
            1 ->
              jump %matched%2()
            _ ->
              jump %next()
          }
        }
        match %field%1 {
          0 ->
            jump %matched%1()
          1 ->
            jump %matched%1()
          _ ->
            jump %next()
        }
    }
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq : Unit =
      Turkey.Stdout#print@Bool(
        join %matched%1() : Bool = {
          join %matched%2() : Bool = {
            join %matched%3() : Bool = {
              join %matched%4() : Bool = {
                Data.Bool#True
              }
              jump %matched%4()
            }
            jump %matched%3()
          }
          jump %matched%2()
        }
        jump %matched%1()
      )
    Turkey.Stdout#print@Bool(
      join %next() : Bool = {
        Data.Bool#False
      }
      join %matched%5() : Bool = {
        join %matched%6() : Bool = {
          jump %next()
        }
        jump %matched%6()
      }
      jump %matched%5()
    )
  }
