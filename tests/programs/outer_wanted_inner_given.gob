-- A wanted of an outer function is solved only by the givens around it, not by
-- those of a local signature that are in force when the solver retries it.
-- `show(r)` needs `Show (Option t)`, and `t` is decided by `r = Some(n)`
-- only after `inner`'s `Show (Elem b)` has been granted; its dictionary is
-- `Show (Option Int)`'s instance, not `inner`'s parameter.

class Box b {
    type Elem b
    fun open(b) -> Elem b
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

fun outer(n : Int) -> String {
    var r = None
    let s = show(r)
    r = Some(n)
    fun inner[Box b, Elem b ~ Int, Show (Elem b)](y : b) -> String = show(open(y))
    s + inner(Some(2))
}

fun main() { print(outer(1)) }
