-- As in `outer_wanted_inner_given`, through a local function: `s`'s
-- `Show (Array t)` waits for `Vec.push(v, n)` to decide `t`.

class Box b {
    type Elem b
    fun open(b) -> Elem b
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

fun outer(n : Int) -> String {
    let v = Vec.new(1)
    let s = fun() = show(Vec.toArray(v))
    Vec.push(v, n)
    fun inner[Box b, Elem b ~ Int, Show (Elem b)](y : b) -> String = show(open(y))
    s() + inner(Some(2))
}

fun main() { print(outer(1)) }
