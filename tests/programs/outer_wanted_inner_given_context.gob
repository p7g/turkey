-- As in `outer_wanted_inner_given`, with a class given of the outer function's
-- own beside the local signature's.

class Box b {
    type Elem b
    fun open(b) -> Elem b
}

instance Box (Option a) {
    type Elem = a
    fun open(o) = match o {
        Some(x) -> x
        None -> error("empty")
    }
}

fun outer[Show c](z : c, n : Int) -> String {
    var r = None
    let s = show(r)
    r = Some(n)
    fun inner[Box b, Elem b ~ Int, Show (Elem b)](y : b) -> String = show(open(y))
    s + inner(Some(2)) + show(z)
}

fun main() { print(outer("z", 1)) }
