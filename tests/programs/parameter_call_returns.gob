-- A call to a function passed as a parameter can return, even when its
-- result type is a variable that its parameter types do not mention. The
-- caller chooses that type and passes a function that returns a value of it,
-- so the statements after the call run and draw no warning.
fun both(part1, part2) {
    print(part1("input"))
    print(part2("input"))
}

fun apply(f) {
    let _ = f(1)
    print("after f")
}

-- A function whose own type quantifies its result never returns: that is
-- `error`'s type.
fun stop(message : String) -> a = error(message)

fun main() {
    both(fun(s) = s + "!", fun(s) = s == "input")
    apply(fun(n) { print(n) })
    let Some(n) = Int.parse("12") else {
        stop("not a number")
        print("unreachable")
    }
    print(n)
}
