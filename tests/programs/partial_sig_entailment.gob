-- A partial annotation's context covers whatever it implies, not only what
-- it spells. The body of 'describe' needs 'Show (Key c)', which the context
-- does not write; it writes 'Show (Elem c)' and 'Elem c ~ Key c', and the
-- two together are 'Show (Key c)'.

class Container c {
    type Elem c
    type Key c
    fun firstKey(c) -> Key c
}

type Tags = Tags(Array String)

instance Container Tags {
    type Elem = String
    type Key = String
    fun firstKey(Tags(ts)) = ts[0]
}

fun describe[Container c, Show (Elem c), Elem c ~ Key c](x : c, label) = label + show(firstKey(x))

fun main() {
    print(describe(Tags(["a", "b"]), "first: "))
}
