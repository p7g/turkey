-- A partial annotation is an assertion too (SPEC-DELTAS 67). What it writes is
-- held to; what it leaves out is inferred.
fun label[Show a](x : a, count) -> String = show(x) + " x" + Int.toString(count)

-- `b` is inferred from the unannotated parameter, and is quantified as well.
fun firstOf(x : a, y) -> a {
    let _ = y
    x
}

-- A local `fun` with a partial annotation, whose `a` belongs to it alone.
fun pairUp(n : Int) -> String {
    fun both(x : a, f) -> (a, a) = (x, f(x))
    let (p, q) = both(n, fun(k) = k + 1)
    Int.toString(p) + "," + Int.toString(q)
}

fun main() {
    print(label(True, 3))
    print(firstOf("kept", 1.5))
    print(Int.toString(firstOf(4, "dropped")))
    print(pairUp(7))
}
