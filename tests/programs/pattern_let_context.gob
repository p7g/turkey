-- Each name of a generalized pattern `let` takes only the class constraints
-- its own type reaches: `inc` is `[OneOf a {Int, Float}, Add a] fun(a) -> a`
-- and `isZero` is `[OneOf b {Int, Float}, Eq b] fun(b) -> Bool`. `inc` uses
-- the `let`'s value with `b` at its default, `Int`.

let (inc, isZero) = (fun(x) = x + 1, fun(n) = n == 0)

fun main() {
    print(inc(1))
    print(inc(1.5))
    print(isZero(0))
    print(isZero(2.5))
}
