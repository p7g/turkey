-- A pattern `let` of open numeric literals generalizes, and each name gets
-- a scheme of its own: `a` and `b` are each `[OneOf a {Int, Float}] a`.
-- Each name is lowered as its own binding, which selects it from an
-- instance of the whole value.

fun repro() {
    let (a, b) = (1, 2)
    print(a)
}

fun mixed() {
    let (a, b) = (1, "x")
    print(a)
}

fun throughVariable() {
    let p = (1, 2)
    let (a, b) = p
    print(a)
}

fun twoTypes() {
    let (a, b) = (1, 2)
    let half : Float = a
    print(half / 2.0)
    print(a + b)
}

fun main() {
    repro()
    mixed()
    throughVariable()
    twoTypes()
}
