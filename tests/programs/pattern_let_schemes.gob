-- Each name a generalized pattern `let` binds has its own scheme, which
-- quantifies only the variables its own type mentions and takes only the
-- constraints its type reaches. A constraint on another name's variable is
-- decided where the `let` is, by its default. A tuple or a single
-- constructor of names is matched once per name; any other pattern is
-- matched once, into a tuple of its names.

type Pair a b = Pair(a, b)
type Side a = L(a) | R(a)
type Box a = Box(a)

let (twice, zero) = (fun(x) = x + x + 0, 0)

fun main() {
    print(twice(1.5))
    print(twice(2))
    print(zero)

    let (f, g) = (fun(x) = x, fun(y) = y)
    print((f(1), f(True), g("x")))

    let Pair(id, n) = Pair(fun(x) = x, 7)
    print((id("seven"), id(n) + 1))

    let ((u, v), w) = ((1, "two"), 3.0)
    print(u)
    print(v)
    print(w)

    let L(same) | R(same) = L(fun(x) = x)
    print((same(1), same("one")))

    let Box((inc, isZero)) = Box((fun(x) = x + 1, fun(n) = n == 0))
    print((inc(1), inc(1.5), isZero(0)))
}
