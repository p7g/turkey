-- Placeholder functions: how far a function made by `_` reaches, and `\`.

type Planet = Planet { name : String, moons : Int }

fun pow(x, n) {
    var result = 1
    for var i = 0; i < n; i = i + 1 { result = result * x }
    result
}

fun label(name) = "<" + name + ">"

-- A function body is a boundary, so this answers a function.
fun scale(factor) = _ * factor

-- So is a block's last statement.
fun offset(by) {
    let doubled = by * 2
    _ + doubled
}

fun early(n) {
    if n < 0 { return _ - n }
    _ + n
}

-- A `\` may begin a line, and here it is the block's value.
fun describer(prefix) {
    let sep = ": "
    \prefix + sep + _.name
}

fun main() {
    let xs = [1, 2, 3]
    let planets = [Planet { name = "Mars", moons = 2 },
                   Planet { name = "Venus", moons = 0 }]

    -- operators, calls, fields
    print(Array.map(xs, _ * 2))
    print(Array.map(xs, _ * 2 + 1))
    print(Array.map(xs, pow(_, 2)))
    print(Array.map(xs, pow(2, _)))
    print(Array.map(planets, _.name))
    print(Array.map(Array.filter(planets, _.moons > 0), _.name))
    print(Array.map(xs, -_))

    -- grouping parentheses are not a boundary; a tuple is
    print(Array.map(xs, (_ + 1) * 2))
    print(Array.map(xs, (_, False)))
    print(Array.map(xs, [_, 0]))

    -- an index is a boundary, like an argument
    print(Array.map([2, 0], xs[_]))

    -- a nested boundary closes its own `_`
    print(Array.map(xs, fun(n) = Array.map(xs, _ * n)))

    -- functions answered by a body, a block, and `return`
    print(scale(3)(5))
    print(offset(1)(10))
    print(early(-1)(10))
    print(early(2)(10))

    -- `\`: an explicit start, one parameter, used as often as needed
    print(Array.map(planets, \label(_.name)))
    print(Array.map(planets, \_.name + " has " + show(_.moons)))
    print(Array.map(xs, \_ * _))
    print(Array.map(xs, \Array.map([_, _ * 10], \_ + 1)))
    print(Array.map(planets, describer("planet")))
    let square = \{
        let n = _
        n * n
    }
    print(square(7))

    -- the rest of the expression runs on every call
    var calls = 0
    let counted = Array.map(xs, _ + { calls = calls + 1; 0 })
    print(counted)
    print(calls)
}
