-- Iterators and for loops
fun main() {
	let words = ["apple", "fig", "banana", "kiwi"]
	for (i, word) in Iter.enumerate(words) {
		print("${i + 1}. ${word}")
	}
	let lengths = Array.map(words, String.byteLength)
	print("total length ${Iter.sum(lengths)}")
	for n in Int.range(1, 20) {
		if n % 7 == 0 {
			print("first multiple of 7: ${n}")
			break
		}
	}
}
