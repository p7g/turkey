-- Polymorphic recursion at a type twice the size of its own: `count` at `a`
-- calls itself at `(a, a)`, so the types it is used at do not end and its
-- copies are keyed by layout. A layout is at most four slots, so at `Int` the
-- copies are 1, 2 and 4 `i64` slots, then `(a, a)` is boxed, a pointer, and
-- from there 2 and 4 pointer slots and a pointer again, which is a copy
-- already made. The program terminates, and each copy is compiled at the
-- representation it is called with.

fun count(x : a, n : Int, size : fun(a) -> Int) -> Int =
    if n == 0 { size(x) } else {
        count((x, x), n - 1, fun(p) = size(p.0) + size(p.1))
    }

-- The same shape, read by a pattern rather than by projection.
fun leaves(x : a, n : Int, each : fun(a) -> String) -> String =
    if n == 0 { each(x) } else {
        leaves((x, n), n - 1, fun(p) {
            let (inner, k) = p
            each(inner) + Int.toString(k)
        })
    }

fun main() {
    print(count(1, 6, fun(x) = x))
    print(count(2.5, 3, fun(x) = Option.unwrapOr(Float.truncate(x), 0)))
    print(count("ab", 7, String.byteLength))
    print(count((1, 2.0), 4, fun(p) = p.0))
    print(leaves("x", 5, fun(s) = s))
}
