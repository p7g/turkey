-- A module's own `infix` declaration shadows the Prelude's operator, group
-- and all. Here `|>` is in `Combine`, which binds tighter than `==`, so the
-- comparison is `(1 |> show) == "1"`. The Prelude's `|>`, in `Sequence`,
-- would have read it as `1 |> (show == "1")`.

infix Combine (|>) = into

fun into(x, f) = f(x)

fun main() {
    print(1 |> show == "1")
    -- The Prelude's other operators are still in scope.
    print("a" <> "b")
}
