-- The operators the Prelude provides, used with no declaration, and `<|>`,
-- which comes from `Regex`.

import Regex ((<|>))

fun half(n : Int) -> Option Int = if n % 2 == 0 { Some(n / 2) } else { None }

fun tenfold(n : Int) -> Int = n * 10

fun positive(n : Int) -> Either String Int = if n > 0 { Right(n) } else { Left("not positive") }

fun main() {
    -- `<>` is `combine`, right-associative, and binds tighter than `==`.
    print("Hello" <> ", " <> "world")
    print("ab" <> "c" == "abc")
    print([1, 2] <> [3])
    print(Vec.fromArray([1]) <> Vec.fromArray([2, 3]))

    -- `|>` is `pipe`, the loosest group, so it applies to the whole `<>`.
    print("ab" <> "c" |> String.codePointCount)
    print([3, 1, 2] |> Vec.fromArray |> Vec.sort |> show)

    -- `|>>` is `bind`.
    print(Some(12) |>> half |>> half)
    print(Some(12) |>> half |>> half |>> half)
    print(Right(3) |>> positive)
    print(Right(0) |>> positive)

    -- `<&>` is `map`, container first, so a chain reads left to right. An
    -- operand of an operator is not a placeholder boundary, so `_ * 10` here
    -- would take in the whole chain; the function is named instead.
    print(Some(2) <&> tenfold <&> show)
    print([1, 2, 3] <&> tenfold)

    -- `<$>` is `fmap`: `map` with the function first.
    print(tenfold <$> [1, 2])
    print(fmap(_ * 2, Some(21)))

    -- All four share `Sequence` and associate to the left.
    print(Some(8) |>> half <&> tenfold |> show)

    -- `<|>` is `Regex.orElse`, and chains.
    let ab = Regex.compile(Regex.literal("a") <|> Regex.literal("b") <|> Regex.literal("c"))
    print(Regex.fullMatch(ab, "c"))
    print(Regex.fullMatch(ab, "d"))
}
