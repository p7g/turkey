-- Register pressure: more values live at once than the allocator has
-- registers for, so that every one of its spilling paths is taken.
--
-- Four shapes, each past a budget `Turkey.Regalloc` states: more than 28
-- untraced integers live at once; more than ten values live across one call,
-- which is what the callee-saved registers hold; more than eight doubles live
-- across a call; and strings live across calls, which are rooted and so
-- spill into their root slots. Every input is computed at run
-- time -- with constants `opt` folds most of this away.

fun seed(n : Int) -> Int {
    var acc = n
    var i = 0
    while i < 3 {
        acc = Int.xor(acc * 31, i)
        i = i + 1
    }
    acc
}

fun touch(n : Int) -> Int = if n <= 0 { 1 } else { touch(n - 1) + 1 }

fun half(x : Float) -> Float = x / 2.0

-- Thirty-two integers, all defined before any is used, and all used after a
-- call.
fun wide(n : Int) -> Int {
    let a0 = seed(n + 0)
    let a1 = seed(n + 1)
    let a2 = seed(n + 2)
    let a3 = seed(n + 3)
    let a4 = seed(n + 4)
    let a5 = seed(n + 5)
    let a6 = seed(n + 6)
    let a7 = seed(n + 7)
    let a8 = seed(n + 8)
    let a9 = seed(n + 9)
    let a10 = seed(n + 10)
    let a11 = seed(n + 11)
    let a12 = seed(n + 12)
    let a13 = seed(n + 13)
    let a14 = seed(n + 14)
    let a15 = seed(n + 15)
    let a16 = seed(n + 16)
    let a17 = seed(n + 17)
    let a18 = seed(n + 18)
    let a19 = seed(n + 19)
    let a20 = seed(n + 20)
    let a21 = seed(n + 21)
    let a22 = seed(n + 22)
    let a23 = seed(n + 23)
    let a24 = seed(n + 24)
    let a25 = seed(n + 25)
    let a26 = seed(n + 26)
    let a27 = seed(n + 27)
    let a28 = seed(n + 28)
    let a29 = seed(n + 29)
    let a30 = seed(n + 30)
    let a31 = seed(n + 31)
    let t = touch(3)
    Int.xor(a0, a1) + Int.xor(a2, a3) + Int.xor(a4, a5) + Int.xor(a6, a7) +
        Int.xor(a8, a9) + Int.xor(a10, a11) + Int.xor(a12, a13) +
        Int.xor(a14, a15) + Int.xor(a16, a17) + Int.xor(a18, a19) +
        Int.xor(a20, a21) + Int.xor(a22, a23) + Int.xor(a24, a25) +
        Int.xor(a26, a27) + Int.xor(a28, a29) + Int.xor(a30, a31) + t
}

-- Twelve doubles live across a call, against eight callee-saved `d`s.
fun doubles(x : Float) -> Float {
    let d0 = half(x + 1.0)
    let d1 = half(x + 2.0)
    let d2 = half(x + 3.0)
    let d3 = half(x + 4.0)
    let d4 = half(x + 5.0)
    let d5 = half(x + 6.0)
    let d6 = half(x + 7.0)
    let d7 = half(x + 8.0)
    let d8 = half(x + 9.0)
    let d9 = half(x + 10.0)
    let d10 = half(x + 11.0)
    let d11 = half(x + 12.0)
    let t = Float.fromInt(touch(2))
    d0 + d1 * 2.0 + d2 * 3.0 + d3 * 4.0 + d4 * 5.0 + d5 * 6.0 + d6 * 7.0 +
        d7 * 8.0 + d8 * 9.0 + d9 * 10.0 + d10 * 11.0 + d11 * 12.0 + t
}

-- Twelve strings live across calls: traced values, each made by a runtime
-- call while the ones before it are live, so they outnumber the callee-saved
-- registers and spill into the root slots rooting already writes.
fun strings(n : Int) -> String {
    let s0 = Int.toString(seed(n + 0))
    let s1 = Int.toString(seed(n + 1))
    let s2 = Int.toString(seed(n + 2))
    let s3 = Int.toString(seed(n + 3))
    let s4 = Int.toString(seed(n + 4))
    let s5 = Int.toString(seed(n + 5))
    let s6 = Int.toString(seed(n + 6))
    let s7 = Int.toString(seed(n + 7))
    let s8 = Int.toString(seed(n + 8))
    let s9 = Int.toString(seed(n + 9))
    let s10 = Int.toString(seed(n + 10))
    let s11 = Int.toString(seed(n + 11))
    var total = 0
    var i = 0
    while i < 20 {
        total = total + touch(i % 5)
        i = i + 1
    }
    s0 + s1 + s2 + s3 + s4 + s5 +
        s6 + s7 + s8 + s9 + s10 + s11 +
        Int.toString(total)
}

fun main() -> Unit {
    print(Int.toString(wide(touch(4))))
    print(Float.toString(doubles(Float.fromInt(touch(5)))))
    print(strings(touch(6)))
}
