-- A `PriorityQueue` pops its least element first, by `Ord` or by the order
-- it was given, and builds from an array without sorting it.
import PriorityQueue (PriorityQueue)
import PriorityQueue as PriorityQueue

fun main() {
    let q : PriorityQueue Int = PriorityQueue.new()
    print((PriorityQueue.pop(q), PriorityQueue.peek(q), PriorityQueue.isEmpty(q)))

    for x in [5, 3, 8, 1, 9, 2, 7, 3] { PriorityQueue.push(q, x) }
    print((len(q), PriorityQueue.peek(q)))
    print(PriorityQueue.pop(q))
    print(PriorityQueue.pop(q))
    PriorityQueue.push(q, 0)
    print(PriorityQueue.drain(q))
    print((len(q), PriorityQueue.pop(q)))

    -- Built in place, then drained least first; the array is left alone.
    let xs = [10, 4, 6, 4, 1, 12, 0, 3, 8, 5, 11]
    let built = PriorityQueue.fromArray(xs)
    print(PriorityQueue.drain(built))
    print(xs)

    -- Greatest first, by the order passed in.
    let most = PriorityQueue.newBy(fun(x, y) = Vec.threeWay(y, x))
    for word in ["pear", "apple", "quince", "fig"] { PriorityQueue.push(most, word) }
    print(PriorityQueue.drain(most))

    -- Tuples order by their first element, then their second.
    let tasks = PriorityQueue.fromArray([(2, "write"), (1, "plan"), (2, "test"), (3, "ship")])
    while let Some((priority, task)) = PriorityQueue.pop(tasks) {
        print((priority, task))
    }

    let a = PriorityQueue.fromArray([5, 1])
    let b = PriorityQueue.fromArray([4, 2, 3])
    print(PriorityQueue.drain(a <> b))
    let none : PriorityQueue Int = empty()
    print(none)
    print(PriorityQueue.fromArray(["only"]))

    PriorityQueue.push(none, 1)
    PriorityQueue.clear(none)
    print(PriorityQueue.isEmpty(none))
}
