-- Dijkstra's shortest paths with a `PriorityQueue` of `(distance, node)`.
-- A node is pushed again whenever a shorter way to it is found, and the
-- stale, longer entries are skipped when they pop.
import PriorityQueue as PriorityQueue

-- Directed edges: from, to, weight.
let edges = [
    ("A", "B", 7), ("A", "C", 9), ("A", "F", 14),
    ("B", "C", 10), ("B", "D", 15),
    ("C", "D", 11), ("C", "F", 2),
    ("D", "E", 6),
    ("E", "F", 9),
    ("F", "E", 9),
    ("G", "A", 1),
]

fun neighbours(node : String) -> Vec (String, Int) {
    let out = []
    for (from, to, weight) in edges {
        if from == node { Vec.push(out, (to, weight)) }
    }
    out
}

fun distances(start : String) -> Map String Int {
    let best = Map.new()
    Map.put(best, start, 0)
    let frontier = PriorityQueue.new()
    PriorityQueue.push(frontier, (0, start))
    while let Some((d, here)) = PriorityQueue.pop(frontier) {
        if d > Map.getOr(best, here, d) { continue }
        for (next, weight) in neighbours(here) {
            let through = d + weight
            if let Some(known) = Map.get(best, next) {
                if known <= through { continue }
            }
            Map.put(best, next, through)
            PriorityQueue.push(frontier, (through, next))
        }
    }
    best
}

fun main() {
    let best = distances("A")
    for node in ["A", "B", "C", "D", "E", "F", "G"] {
        print((node, Map.get(best, node)))
    }
}
