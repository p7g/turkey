-- A program's module may be written as a library module is. The program's
-- modules get the program's, and the library's modules keep the library's:
-- `Data.Int` here is the program's file, while the `Int` qualifier, and
-- every library module that imports `Data.Int` or the Prelude, means the
-- library's.
import Data.Int
import Set

fun main() {
    hello()
    print(Set.describe(Set.Full))
    print(Data.Int.shout("quiet"))
    print(Int.toString(Int.abs(0 - 7)))
}
