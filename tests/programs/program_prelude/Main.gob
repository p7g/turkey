-- A program's own `Prelude.gob` is the implicit Prelude of its modules. This
-- one passes on everything the standard one does, by `module Turkey (..)`,
-- and adds a helper and the qualifier `Set`.
import Day

fun main() {
    let seen = Set.new()
    for line in lines("b\na\nb") {
        Set.add(seen, line)
    }
    print(String.join(Array.sort(Set.elements(seen)), ","))
    print(Day.total([1, 2, 3]))
    print(Prelude.Set.contains(seen, "a"))
}
