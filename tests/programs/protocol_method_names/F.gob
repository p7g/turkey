export (Flipper(..), Walker(..), Chain(..))

-- Classes whose methods are spelled like the ones `-x`, `for` and `?` call.

class Flipper a { fun neg(a) -> a }

instance Flipper Bool { fun neg(b) = !b }

class Walker w {
    fun iter(w) -> Int
    fun next(w, Int) -> Int
}

class Chain c {
    fun bind(c, Int) -> c
    fun pure(Int) -> c
}
