import F (Flipper(..), Walker(..), Chain(..))

-- Classes of this module's own whose methods are spelled like the ones
-- `xs[i]` and `xs[i] = v` call.
class Wrapper w { fun get(w, Int) -> String }
class Setter w { fun set(w, Int, Int) -> Unit }

fun half(n : Int) -> Option Int = if n % 2 == 0 { Some(n / 2) } else { None }

fun quarter(n : Int) -> Option Int {
    let h = half(n)?
    half(h)
}

-- A `?` inside a loop makes the block return through `pure` as well.
fun halves(xs : Array Int) -> Option Int = do {
    var total = 0
    for x in xs { total = total + half(x)? }
    Some(total)
}

fun main() {
    let xs = [1, 2]
    print(xs[1])
    xs[0] = 5
    let y = 1
    print(-y)
    print(neg(True))
    for x in xs { print(x) }
    print(quarter(8))
    print(quarter(6))
    print(halves([2, 4]))
    print(halves([2, 3]))
}
