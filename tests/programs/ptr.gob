-- Raw memory (TIX-61): every primitive the feature added, at least once.
--
-- "At least once" is the point and not a flourish. `src/Turkey/PrimTypes.gob`
-- transcribes `builtins._PRIM`'s schemes by hand and nothing checks the two
-- against each other, so `test_boot`'s `types` stage over a program that
-- actually mentions each name is what catches a mistranscribed one.
--
-- No address is printed. An address is deterministic on both hosts and
-- *unspecified* between them, so `toInt` is checked by round-tripping and
-- `diff` only within one block.

import Unsafe.Ptr as Ptr
import Unsafe.Ptr (Load, Store)

fun roundTrip(p : Ptr.Ptr) -> Unit {
    Ptr.store(p, 0, 1234567890123)
    Ptr.store(p, 8, -1)
    Ptr.store(p, 16, 'λ')
    Ptr.store(p, 20, Byte.truncate(200))
    Ptr.store(p, 21, True)
    Ptr.store(p, 22, False)
    Ptr.store(p, 24, 0.5)
    Ptr.store(p, 32, -0.0)

    let a : Int = Ptr.load(p, 0)
    let b : Int = Ptr.load(p, 8)
    let c : Char = Ptr.load(p, 16)
    let d : Byte = Ptr.load(p, 20)
    let e : Bool = Ptr.load(p, 21)
    let f : Bool = Ptr.load(p, 22)
    let g : Float = Ptr.load(p, 24)
    let h : Float = Ptr.load(p, 32)

    print(Int.toString(a))
    print(Int.toString(b))
    print(Char.toString(c))
    print(Int.toString(Byte.toInt(d)))
    print(Bool.toString(e))
    print(Bool.toString(f))
    print(Float.toString(g))
    print(Float.toString(h))
}

fun main() -> Unit {
    let p = Ptr.alloc(64)
    print(Bool.toString(Ptr.isNull(p)))
    roundTrip(p)

    -- A pointer stored into raw memory reads back as itself.
    let q = Ptr.add(p, 40)
    Ptr.store(q, 0, p)
    let back : Ptr.Ptr = Ptr.load(q, 0)
    print(Bool.toString(back == p))

    -- Arithmetic. Within one block a difference is meaningful; the integer an
    -- address maps to is not, so it is only round-tripped.
    print(Int.toString(Ptr.diff(q, p)))
    print(Int.toString(Ptr.diff(p, q)))
    print(Bool.toString(Ptr.fromInt(Ptr.toInt(q)) == q))
    print(Bool.toString(Ptr.add(p, 0) == p))

    -- Null.
    let n = Ptr.null()
    print(Bool.toString(Ptr.isNull(n)))
    print(Bool.toString(n == Ptr.fromInt(0)))
    Ptr.free(n)

    Ptr.free(p)
    print("freed")
}
