-- An alias whose right-hand side is a qualified name: a constructor is never
-- written qualified where it is declared, so this can only be an alias.
import Geometry as Geometry

type Spot = Geometry.Point

fun describe(s : Spot) -> String = Int.toString(s.x) + "," + Int.toString(s.y)

fun main() {
    print(describe(Geometry.origin))
}
