-- `AOC.Set` is the module `Data.Set`, through the qualifier `AOC` exports,
-- and the module file `AOC/Set.gob`, through its own import. A name only one
-- of them exports is that one's.
import AOC
import AOC.Set

fun main() {
    print(AOC.Set.only())
    let seen : AOC.Set.Set Int = AOC.Set.fromIterator([1, 2])
    print(AOC.Set.contains(seen, 2))
}
