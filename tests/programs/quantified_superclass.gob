-- An inferred context lists only the constraints the others do not imply.
-- 'between' needs 'Eq a' and 'Ord a', and 'Ord a' implies 'Eq a', so its
-- context is 'Ord a' alone, and its '==' takes the 'Eq' inside the 'Ord'.
fun between(lo, x, hi) = x == lo || x == hi || lo < x && x < hi

-- The same across a recursive group: 'evens' needs 'Eq b' and 'odds' needs
-- 'Ord b', and the group shares 'Ord b'. Each call from one member to the
-- other passes it on.
fun evens(n, x) = if n == 0 { x == x } else { odds(n - 1, x) }
fun odds(n, x) = if n == 0 { x < x } else { evens(n - 1, x) }

fun main() {
    print(between(1, 2, 3))
    print(between("a", "z", "m"))
    print(evens(3, 'c'))
    print(evens(4, 'c'))
}
