-- A `let` whose value is a block ending in an `if` that holds a `?`. The rest
-- of the function runs after either branch, and binds `y` and `z` once.

fun pick(c : Bool, a : Option Int, b : Option Int) -> Option Int {
    let y = { if c { a? } else { b? } }
    let z = y + 1
    Some(z)
}

fun shape(n : Int, a : Option Int) -> Option String {
    let label = {
        match n {
            0 -> "none"
            1 -> "one of " + Int.toString(a?)
            _ -> "many"
        }
    }
    let shown = "<" + label + ">"
    Some(shown)
}

fun main() {
    print(pick(True, Some(1), Some(2)))
    print(pick(False, Some(1), None))
    print(shape(1, Some(5)))
    print(shape(1, None))
    print(shape(2, None))
}
