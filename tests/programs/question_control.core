Main#half : fun(Int) -> Option Int =
  fun(n : Int) {
    if %inst.Data.Eq#Eq.Int.eq(%inst.Data.Num#Rem.Int.rem(n, 2), 0) {
      Data.Option#Some(%inst.Data.Num#Div.Int.div(n, 2))
    } else {
      Data.Option#None
    }
  }

Main#clamp : fun(Option Int) -> Option Int =
  fun(o : Option Int) {
    %inst.Control.Monad#Monad.Data.Option#Option.bind[Flow (Option Int) Unit (Option Int), Int](
      %inst.Control.Monad#Monad.Data.Option#Option.bind[Int, Flow (Option Int) Unit (Option Int)](
        o,
        fun(%k%1 : Int) {
          let x : Int =
            %k%1
          %inst.Control.Monad#Monad.Data.Option#Option.bind[Flow Unit Unit (Option Int), Flow (Option Int) Unit (Option Int)](
            if %inst.Data.Ord#Ord.Int.gt(x, 3) {
              %inst.Control.Applicative#Applicative.Data.Option#Option.pure[Flow Unit Unit (Option Int)](Prelude#Ret(Data.Option#None))
            } else {
              %inst.Control.Applicative#Applicative.Data.Option#Option.pure[Flow Unit Unit (Option Int)](Prelude#Fall(()))
            },
            fun(%k%2 : Flow Unit Unit (Option Int)) {
              match %k%2 {
                Prelude#Fall(%fell) ->
                  %inst.Control.Applicative#Applicative.Data.Option#Option.pure[Flow (Option Int) Unit (Option Int)](Prelude#Fall(Data.Option#Some(%inst.Data.Num#Mul.Int.mul(x, 2))))
                Prelude#Brk(%b) ->
                  %inst.Control.Applicative#Applicative.Data.Option#Option.pure[Flow (Option Int) Unit (Option Int)](Prelude#Brk(%b))
                Prelude#Cont ->
                  %inst.Control.Applicative#Applicative.Data.Option#Option.pure[Flow (Option Int) Unit (Option Int)](Prelude#Cont)
                Prelude#Ret(%r%1) ->
                  %inst.Control.Applicative#Applicative.Data.Option#Option.pure[Flow (Option Int) Unit (Option Int)](Prelude#Ret(%r%1))
              }
            }
          )
        }
      ),
      fun(%k%3 : Flow (Option Int) Unit (Option Int)) {
        match %k%3 {
          Prelude#Fall(%v) ->
            %v
          Prelude#Ret(%r%2) ->
            %r%2
          Prelude#Brk(_) ->
            Control.Panic#error[Option Int]("internal error: a loop transfer escaped its loop")
          Prelude#Cont ->
            Control.Panic#error[Option Int]("internal error: a loop transfer escaped its loop")
        }
      }
