Main#pickByHand : fun(Array Int) -> Array Int =
  fun(xs : Array Int) {
    %inst.Control.Monad#Monad.Data.Array#Array.bind[Int, Int](
      xs,
      fun(x : Int) {
        if %inst.Data.Eq#Eq.Int.eq(x, 2) {
          Data.Array#Array([999])
        } else {
          %inst.Control.Applicative#Applicative.Data.Array#Array.pure[Int](%inst.Data.Num#Mul.Int.mul(x, 10))
        }
      }
    )
  }

Main#spreadByHand : fun(Array Int) -> Array Int =
  fun(xs : Array Int) {
    let t : %Ref Int =
      ref(0)
    let seq : Array Int =
      Data.Array#Array([1, 2])
    let cur : ArrayCursor =
      %inst.Iter#Iterator.Data.Array#Array[Int].iter(seq)
    letrec
      go : fun() -> Array Unit =
        fun() {
          match %inst.Iter#Iterator.Data.Array#Array[Int].next(seq, cur) {
            Data.Option#None ->
              %inst.Control.Applicative#Applicative.Data.Array#Array.pure[Unit](())
            Data.Option#Some(x) ->
              %inst.Control.Monad#Monad.Data.Array#Array.bind[Int, Unit](
                xs,
                fun(n : Int) {
                  let %seq : Unit =
                    t := %inst.Data.Num#Add.Int.add(!t, %inst.Data.Num#Mul.Int.mul(x, n))
                  go()
                }
              )
          }
        }
    %inst.Control.Monad#Monad.Data.Array#Array.bind[Unit, Int](
      go(),
      fun(%wild : Unit) {
        %inst.Control.Applicative#Applicative.Data.Array#Array.pure[Int](!t)
      }
    )
  }

