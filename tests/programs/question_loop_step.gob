-- A C-style `for` holding a `?`, whose step binds a name. The loop goes round
-- again after its body falls through and after a `continue`, and runs the step
-- both times.

fun step(i : Int, f : fun(Int) -> Int) -> Int = f(i)

fun total(xs : Array (Option Int)) -> Option Int {
    var s = 0
    for var i = 0; i < len(xs); i = step(i, fun(k) = k + 1) {
        if i == 1 { continue }
        s = s + xs[i]?
    }
    Some(s)
}

fun main() {
    print(total([Some(1), Some(10), Some(2)]))
    print(total([Some(1), None, Some(2)]))
    print(total([Some(1), Some(10), None]))
}
