-- bindings
Main#half : fun(Int) -> Option Int =
  fun(n : Int) {
    if %inst.Data.Eq#Eq.Int#eq(%inst.Data.Num#Rem.Int#rem(n, 2), 0) {
      Data.Option#Some(%inst.Data.Num#Div.Int#div(n, 2))
    } else {
      Data.Option#None
    }
  }

Main#quarter : fun(Int) -> Option Int =
  fun(n : Int) {
    %inst.Control.Monad#Monad.Data.Option#Option#bind@Int,Int(
      Main#half(n),
      fun(%k%1 : Int) {
        let a : Int =
          %k%1
        %inst.Control.Monad#Monad.Data.Option#Option#bind@Int,Int(
          Main#half(a),
          fun(%k%2 : Int) {
            let b : Int =
              %k%2
            Data.Option#Some(b)
          }
        )
      }
    )
  }

Main#both : fun(Int) -> Option Int =
  fun(n : Int) {
    %inst.Control.Monad#Monad.Data.Option#Option#bind@Int,Int(
      Main#half(n),
      fun(%k%1 : Int) {
        let a : Int =
          %k%1
        %inst.Control.Monad#Monad.Data.Option#Option#bind@Int,Int(
          Main#half(a),
          fun(%k%2 : Int) {
            let b : Int =
              %k%2
            Data.Option#Some(%inst.Data.Num#Add.Int#add(a, b))
          }
        )
      }
    )
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq%1 : Unit =
      Turkey.Stdout#print@Option(Int)(Main#quarter(8))
    let %seq%2 : Unit =
      Turkey.Stdout#print@Option(Int)(Main#quarter(6))
    let %seq%3 : Unit =
      Turkey.Stdout#print@Option(Int)(Main#quarter(3))
    Turkey.Stdout#print@Option(Int)(Main#both(8))
  }
