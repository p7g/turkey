-- bindings
Main#half : fun(Int) -> Option Int =
  fun(n : Int) {
    if %inst.Std.Classes#Eq.Int#eq(%inst.Std.Classes#Rem.Int#rem(n, 2), 0) {
      Data.Option.Type#Some(%inst.Std.Classes#Div.Int#div(n, 2))
    } else {
      Data.Option.Type#None
    }
  }

Main#quarter : fun(Int) -> Option Int =
  fun(n : Int) {
    %inst.Std.Classes#Monad.Data.Option.Type#Option#bind@Int,Int(
      Main#half(n),
      fun(%k1 : Int) {
        let a : Int =
          %k1
        %inst.Std.Classes#Monad.Data.Option.Type#Option#bind@Int,Int(
          Main#half(a),
          fun(%k2 : Int) {
            let b : Int =
              %k2
            Data.Option.Type#Some(b)
          }
        )
      }
    )
  }

Main#both : fun(Int) -> Option Int =
  fun(n : Int) {
    %inst.Std.Classes#Monad.Data.Option.Type#Option#bind@Int,Int(
      Main#half(n),
      fun(%k1 : Int) {
        let a : Int =
          %k1
        %inst.Std.Classes#Monad.Data.Option.Type#Option#bind@Int,Int(
          Main#half(a),
          fun(%k2 : Int) {
            let b : Int =
              %k2
            Data.Option.Type#Some(%inst.Std.Classes#Add.Int#add(a, b))
          }
        )
      }
    )
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      Std.Classes#print@Option(Int)(Main#quarter(8))
    let %seq2 : Unit =
      Std.Classes#print@Option(Int)(Main#quarter(6))
    let %seq3 : Unit =
      Std.Classes#print@Option(Int)(Main#quarter(3))
    Std.Classes#print@Option(Int)(Main#both(8))
  }
