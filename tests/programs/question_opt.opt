-- bindings
Main#half : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x, 0)
    {
      Data.Option.Type#Some(Prim.intDiv(n, 2))
    } else {
      Data.Option.Type#None
    }
  }

Main#quarter : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x, 0)
    {
      let x : Int =
        Prim.intDiv(n, 2)
      let %k1 : Int =
        x
      if
        let x : Int =
          Prim.intRem(%k1, 2)
        Prim.intEq(x, 0)
      {
        let x : Int =
          Prim.intDiv(%k1, 2)
        Data.Option.Type#Some(x)
      } else {
        Data.Option.Type#None
      }
    } else {
      Data.Option.Type#None
    }
  }

Main#both : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x, 0)
    {
      let x : Int =
        Prim.intDiv(n, 2)
      let %k1 : Int =
        x
      if
        let x : Int =
          Prim.intRem(%k1, 2)
        Prim.intEq(x, 0)
      {
        let x : Int =
          Prim.intDiv(%k1, 2)
        Data.Option.Type#Some(Prim.intAdd(%k1, x))
      } else {
        Data.Option.Type#None
      }
    } else {
      Data.Option.Type#None
    }
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq1 : Unit =
      let x : Option Int =
        if
          let x : Int =
            Prim.intRem(8, 2)
          Prim.intEq(x, 0)
        {
          let x : Int =
            Prim.intDiv(8, 2)
          let %k1 : Int =
            x
          if
            let x : Int =
              Prim.intRem(%k1, 2)
            Prim.intEq(x, 0)
          {
            let x : Int =
              Prim.intDiv(%k1, 2)
            Data.Option.Type#Some(x)
          } else {
            Data.Option.Type#None
          }
        } else {
          Data.Option.Type#None
        }
      Prim.print(
        match x {
          Data.Option.Type#None ->
            "None"
          Data.Option.Type#Some(x) ->
            Prim.stringConcat(Prim.stringConcat("Some(", Prim.intToString(x)), ")")
        }
      )
    let %seq2 : Unit =
      let x : Option Int =
        if
          let x : Int =
            Prim.intRem(6, 2)
          Prim.intEq(x, 0)
        {
          let x : Int =
            Prim.intDiv(6, 2)
          let %k1 : Int =
            x
          if
            let x : Int =
              Prim.intRem(%k1, 2)
            Prim.intEq(x, 0)
          {
            let x : Int =
              Prim.intDiv(%k1, 2)
            Data.Option.Type#Some(x)
          } else {
            Data.Option.Type#None
          }
        } else {
          Data.Option.Type#None
        }
      Prim.print(
        match x {
          Data.Option.Type#None ->
            "None"
          Data.Option.Type#Some(x) ->
            Prim.stringConcat(Prim.stringConcat("Some(", Prim.intToString(x)), ")")
        }
      )
    let %seq3 : Unit =
      let x : Option Int =
        if
          let x : Int =
            Prim.intRem(3, 2)
          Prim.intEq(x, 0)
        {
          let x : Int =
            Prim.intDiv(3, 2)
          let %k1 : Int =
            x
          if
            let x : Int =
              Prim.intRem(%k1, 2)
            Prim.intEq(x, 0)
          {
            let x : Int =
              Prim.intDiv(%k1, 2)
            Data.Option.Type#Some(x)
          } else {
            Data.Option.Type#None
          }
        } else {
          Data.Option.Type#None
        }
      Prim.print(
        match x {
          Data.Option.Type#None ->
            "None"
          Data.Option.Type#Some(x) ->
            Prim.stringConcat(Prim.stringConcat("Some(", Prim.intToString(x)), ")")
        }
      )
    let x : Option Int =
      if
        let x : Int =
          Prim.intRem(8, 2)
        Prim.intEq(x, 0)
      {
        let x : Int =
          Prim.intDiv(8, 2)
        let %k2 : Int =
          x
        if
          let x : Int =
            Prim.intRem(%k2, 2)
          Prim.intEq(x, 0)
        {
          let x : Int =
            Prim.intDiv(%k2, 2)
          Data.Option.Type#Some(Prim.intAdd(%k2, x))
        } else {
          Data.Option.Type#None
        }
      } else {
        Data.Option.Type#None
      }
    Prim.print(
      match x {
        Data.Option.Type#None ->
          "None"
        Data.Option.Type#Some(x) ->
          Prim.stringConcat(Prim.stringConcat("Some(", Prim.intToString(x)), ")")
      }
    )
  }
