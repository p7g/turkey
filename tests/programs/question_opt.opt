-- bindings
Main#half : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x, 0)
    {
      Data.Option#Some(Prim.intDiv(n, 2))
    } else {
      Data.Option#None
    }
  }

Main#quarter : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x%1 : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x%1, 0)
    {
      let x%2 : Int =
        Prim.intDiv(n, 2)
      let %k : Int =
        x%2
      if
        let x%1 : Int =
          Prim.intRem(%k, 2)
        Prim.intEq(x%1, 0)
      {
        let x%2 : Int =
          Prim.intDiv(%k, 2)
        Data.Option#Some(x%2)
      } else {
        Data.Option#None
      }
    } else {
      Data.Option#None
    }
  }

Main#both : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x%1 : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x%1, 0)
    {
      let x%2 : Int =
        Prim.intDiv(n, 2)
      let %k : Int =
        x%2
      if
        let x%1 : Int =
          Prim.intRem(%k, 2)
        Prim.intEq(x%1, 0)
      {
        let x%2 : Int =
          Prim.intDiv(%k, 2)
        Data.Option#Some(Prim.intAdd(%k, x%2))
      } else {
        Data.Option#None
      }
    } else {
      Data.Option#None
    }
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq%1 : Unit =
      Turkey.Stdout#print@Option(Int)(
        let x%1 : Int =
          4
        let %k%1 : Int =
          x%1
        if
          let x%2 : Int =
            Prim.intRem(%k%1, 2)
          Prim.intEq(x%2, 0)
        {
          let x%1 : Int =
            Prim.intDiv(%k%1, 2)
          Data.Option#Some(x%1)
        } else {
          Data.Option#None
        }
      )
    let %seq%2 : Unit =
      Turkey.Stdout#print@Option(Int)(
        let x%1 : Int =
          3
        let %k%1 : Int =
          x%1
        if
          let x%2 : Int =
            Prim.intRem(%k%1, 2)
          Prim.intEq(x%2, 0)
        {
          let x%1 : Int =
            Prim.intDiv(%k%1, 2)
          Data.Option#Some(x%1)
        } else {
          Data.Option#None
        }
      )
    let %seq%3 : Unit =
      Turkey.Stdout#print@Option(Int)(Data.Option#None)
    Turkey.Stdout#print@Option(Int)(
      let x%1 : Int =
        4
      let %k%2 : Int =
        x%1
      if
        let x%2 : Int =
          Prim.intRem(%k%2, 2)
        Prim.intEq(x%2, 0)
      {
        let x%1 : Int =
          Prim.intDiv(%k%2, 2)
        Data.Option#Some(Prim.intAdd(%k%2, x%1))
      } else {
        Data.Option#None
      }
    )
  }
