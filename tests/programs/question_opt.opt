-- bindings
Main#half : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x, 0)
    {
      Data.Option#Some(Prim.intDiv(n, 2))
    } else {
      Data.Option#None
    }
  }

Main#quarter : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x%1 : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x%1, 0)
    {
      let x%2 : Int =
        Prim.intDiv(n, 2)
      let %k : Int =
        x%2
      if
        let x%1 : Int =
          Prim.intRem(%k, 2)
        Prim.intEq(x%1, 0)
      {
        let x%2 : Int =
          Prim.intDiv(%k, 2)
        Data.Option#Some(x%2)
      } else {
        Data.Option#None
      }
    } else {
      Data.Option#None
    }
  }

Main#both : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x%1 : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x%1, 0)
    {
      let x%2 : Int =
        Prim.intDiv(n, 2)
      let %k : Int =
        x%2
      if
        let x%1 : Int =
          Prim.intRem(%k, 2)
        Prim.intEq(x%1, 0)
      {
        let x%2 : Int =
          Prim.intDiv(%k, 2)
        Data.Option#Some(Prim.intAdd(%k, x%2))
      } else {
        Data.Option#None
      }
    } else {
      Data.Option#None
    }
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq%1 : Unit =
      Turkey.Stdout#print@Option(Int)(
        if
          let x%1 : Int =
            Prim.intRem(8, 2)
          Prim.intEq(x%1, 0)
        {
          let x%2 : Int =
            Prim.intDiv(8, 2)
          let %k%1 : Int =
            x%2
          if
            let x%1 : Int =
              Prim.intRem(%k%1, 2)
            Prim.intEq(x%1, 0)
          {
            let x%2 : Int =
              Prim.intDiv(%k%1, 2)
            Data.Option#Some(x%2)
          } else {
            Data.Option#None
          }
        } else {
          Data.Option#None
        }
      )
    let %seq%2 : Unit =
      Turkey.Stdout#print@Option(Int)(
        if
          let x%1 : Int =
            Prim.intRem(6, 2)
          Prim.intEq(x%1, 0)
        {
          let x%2 : Int =
            Prim.intDiv(6, 2)
          let %k%1 : Int =
            x%2
          if
            let x%1 : Int =
              Prim.intRem(%k%1, 2)
            Prim.intEq(x%1, 0)
          {
            let x%2 : Int =
              Prim.intDiv(%k%1, 2)
            Data.Option#Some(x%2)
          } else {
            Data.Option#None
          }
        } else {
          Data.Option#None
        }
      )
    let %seq%3 : Unit =
      Turkey.Stdout#print@Option(Int)(
        if
          let x%1 : Int =
            Prim.intRem(3, 2)
          Prim.intEq(x%1, 0)
        {
          let x%2 : Int =
            Prim.intDiv(3, 2)
          let %k%1 : Int =
            x%2
          if
            let x%1 : Int =
              Prim.intRem(%k%1, 2)
            Prim.intEq(x%1, 0)
          {
            let x%2 : Int =
              Prim.intDiv(%k%1, 2)
            Data.Option#Some(x%2)
          } else {
            Data.Option#None
          }
        } else {
          Data.Option#None
        }
      )
    Turkey.Stdout#print@Option(Int)(
      if
        let x%1 : Int =
          Prim.intRem(8, 2)
        Prim.intEq(x%1, 0)
      {
        let x%2 : Int =
          Prim.intDiv(8, 2)
        let %k%2 : Int =
          x%2
        if
          let x%1 : Int =
            Prim.intRem(%k%2, 2)
          Prim.intEq(x%1, 0)
        {
          let x%2 : Int =
            Prim.intDiv(%k%2, 2)
          Data.Option#Some(Prim.intAdd(%k%2, x%2))
        } else {
          Data.Option#None
        }
      } else {
        Data.Option#None
      }
    )
  }
