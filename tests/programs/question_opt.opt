-- bindings
Main#half : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x, 0)
    {
      Data.Option#Some(Prim.intDiv(n, 2))
    } else {
      Data.Option#None
    }
  }

Main#quarter : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x%1 : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x%1, 0)
    {
      let x%2 : Int =
        Prim.intDiv(n, 2)
      if
        let x%3 : Int =
          Prim.intRem(x%2, 2)
        Prim.intEq(x%3, 0)
      {
        let x%4 : Int =
          Prim.intDiv(x%2, 2)
        Data.Option#Some(x%4)
      } else {
        Data.Option#None
      }
    } else {
      Data.Option#None
    }
  }

Main#both : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x%1 : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x%1, 0)
    {
      let x%2 : Int =
        Prim.intDiv(n, 2)
      if
        let x%3 : Int =
          Prim.intRem(x%2, 2)
        Prim.intEq(x%3, 0)
      {
        let x%4 : Int =
          Prim.intDiv(x%2, 2)
        Data.Option#Some(Prim.intAdd(x%2, x%4))
      } else {
        Data.Option#None
      }
    } else {
      Data.Option#None
    }
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq%1 : Unit =
      Turkey.Stdout#print@Option(Int)(
        if
          let x%1 : Int =
            Prim.intRem(8, 2)
          Prim.intEq(x%1, 0)
        {
          let x%2 : Int =
            Prim.intDiv(8, 2)
          if
            let x%3 : Int =
              Prim.intRem(x%2, 2)
            Prim.intEq(x%3, 0)
          {
            let x%4 : Int =
              Prim.intDiv(x%2, 2)
            Data.Option#Some(x%4)
          } else {
            Data.Option#None
          }
        } else {
          Data.Option#None
        }
      )
    let %seq%2 : Unit =
      Turkey.Stdout#print@Option(Int)(
        if
          let x%5 : Int =
            Prim.intRem(6, 2)
          Prim.intEq(x%5, 0)
        {
          let x%6 : Int =
            Prim.intDiv(6, 2)
          if
            let x%7 : Int =
              Prim.intRem(x%6, 2)
            Prim.intEq(x%7, 0)
          {
            let x%8 : Int =
              Prim.intDiv(x%6, 2)
            Data.Option#Some(x%8)
          } else {
            Data.Option#None
          }
        } else {
          Data.Option#None
        }
      )
    let %seq%3 : Unit =
      Turkey.Stdout#print@Option(Int)(
        if
          let x%9 : Int =
            Prim.intRem(3, 2)
          Prim.intEq(x%9, 0)
        {
          let x%10 : Int =
            Prim.intDiv(3, 2)
          if
            let x%11 : Int =
              Prim.intRem(x%10, 2)
            Prim.intEq(x%11, 0)
          {
            let x%12 : Int =
              Prim.intDiv(x%10, 2)
            Data.Option#Some(x%12)
          } else {
            Data.Option#None
          }
        } else {
          Data.Option#None
        }
      )
    Turkey.Stdout#print@Option(Int)(
      if
        let x%13 : Int =
          Prim.intRem(8, 2)
        Prim.intEq(x%13, 0)
      {
        let x%14 : Int =
          Prim.intDiv(8, 2)
        if
          let x%15 : Int =
            Prim.intRem(x%14, 2)
          Prim.intEq(x%15, 0)
        {
          let x%16 : Int =
            Prim.intDiv(x%14, 2)
          Data.Option#Some(Prim.intAdd(x%14, x%16))
        } else {
          Data.Option#None
        }
      } else {
        Data.Option#None
      }
    )
  }
