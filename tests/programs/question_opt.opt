-- bindings
Main#half : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x, 0)
    {
      Data.Option#Some(Prim.intDiv(n, 2))
    } else {
      Data.Option#None
    }
  }

Main#quarter : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x%1 : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x%1, 0)
    {
      let x%2 : Int =
        Prim.intDiv(n, 2)
      if
        let x%3 : Int =
          Prim.intRem(x%2, 2)
        Prim.intEq(x%3, 0)
      {
        let x%4 : Int =
          Prim.intDiv(x%2, 2)
        Data.Option#Some(x%4)
      } else {
        Data.Option#None
      }
    } else {
      Data.Option#None
    }
  }

Main#both : fun(Int) -> Option Int =
  fun(n : Int) {
    if
      let x%1 : Int =
        Prim.intRem(n, 2)
      Prim.intEq(x%1, 0)
    {
      let x%2 : Int =
        Prim.intDiv(n, 2)
      if
        let x%3 : Int =
          Prim.intRem(x%2, 2)
        Prim.intEq(x%3, 0)
      {
        let x%4 : Int =
          Prim.intDiv(x%2, 2)
        Data.Option#Some(Prim.intAdd(x%2, x%4))
      } else {
        Data.Option#None
      }
    } else {
      Data.Option#None
    }
  }

Main#main : fun() -> Unit =
  fun() {
    let %seq%1 : Unit =
      Turkey.Stdout#print@Option(Int)(Data.Option#Some(2))
    let %seq%2 : Unit =
      Turkey.Stdout#print@Option(Int)(Data.Option#None)
    let %seq%3 : Unit =
      Turkey.Stdout#print@Option(Int)(Data.Option#None)
    Turkey.Stdout#print@Option(Int)(Data.Option#Some(6))
  }
