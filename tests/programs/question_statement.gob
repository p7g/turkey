-- A statement whose value is discarded still runs when an argument holds a
-- `?`: the call is rebuilt around the bound value and kept as a statement.

import System.Task as Task

fun get(n : Int) -> Either String Int = Right(n)

fun fail(why : String) -> Either String Int = Left(why)

fun say(s : String) -> Unit = print(s)

fun direct() -> Either String Int {
    print(show(get(1)?))
    Right(0)
}

fun throughUnit() -> Either String Int {
    say(show(get(2)?))
    Right(0)
}

fun bound() -> Either String Int {
    let s = show(get(3)?)
    print(s)
    Right(0)
}

fun boundToHole() -> Either String Int {
    let _ = say(show(get(4)?))
    Right(0)
}

fun inIf(flag : Bool) -> Either String Int {
    if flag {
        say("if " + show(get(5)?))
        say("after if")
    }
    Right(0)
}

fun inMatch(o : Option Int) -> Either String Int {
    match o {
        Some(n) -> {
            say("match " + show(get(n)?))
            say("after match")
        }
        None -> {}
    }
    Right(0)
}

fun inLoop() -> Either String Int {
    for n in [7, 8] {
        say("loop " + show(get(n)?))
    }
    Right(0)
}

-- A `return` after the `?` puts the whole body in flow mode.
fun beforeReturn(n : Int) -> Either String Int {
    say("flow " + show(get(n)?))
    if n > 0 { return Right(n) }
    say("not reached")
    Right(0)
}

-- The `Left` stops the body before the call it is an argument of.
fun shortCircuit() -> Either String Int {
    say("never " + show(fail("stopped")?))
    say("never either")
    Right(0)
}

fun inOption() -> Option Int {
    say("option " + show(Some(10)?))
    Some(0)
}

fun inTask() -> Task.Spawn Int = do {
    say("task " + show(pure(11)?))
    pure(0)
}

fun main() {
    let _ = direct()
    let _ = throughUnit()
    let _ = bound()
    let _ = boundToHole()
    let _ = inIf(True)
    let _ = inMatch(Some(6))
    let _ = inLoop()
    let _ = beforeReturn(9)
    print(shortCircuit())
    let _ = inOption()
    let _ = Task.runScope(inTask())
}
