-- A record literal's fields are evaluated in the order they are written,
-- whatever order the type declares them in. The record built here outlives the
-- literal, so it is a real object and not a set of locals.

type Point = Point { x : Int, y : Int }

fun traced(label : String, value : Int) -> Int {
    print(label)
    value
}

fun main() {
    let points = [Point { y = traced("y", 2), x = traced("x", 1) }]
    let p = points[0]
    print(p.x * 10 + p.y)
}
