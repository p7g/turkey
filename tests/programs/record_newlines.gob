-- A significant newline separates fields in braces, with or without a comma,
-- in a declaration, a construction and a pattern alike (SPEC-DELTAS 64).
type Point = Point {
    x : Int
    y : Int,
    label : String
}

fun describe(p : Point) -> String = match p {
    Point {
        x
        y = 0
        label
    } -> label + " on the x axis at " + Int.toString(x)
    Point { x, y, label } -> label + " at " + Int.toString(x) + ", " + Int.toString(y)
}

fun main() {
    let origin = Point {
        x = 0
        y = 0
        label = "origin"
    }
    let p = Point {
        x = 1 +
            2
        y = 4,
        label = "p"
    }
    print(describe(origin))
    print(describe(p))
}
