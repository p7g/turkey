-- An instance method that calls itself, through its own instance.

class Sized t { fun size(t) -> Int }

instance Sized Int {
    fun size(n) = if n == 0 { 0 } else { size(n - 1) }
}

class Depth t { fun depth(t) -> Int }

instance Depth Int {
    fun depth(n) = if n <= 0 { 0 } else { 1 + depth(n - 1) }
}

fun main() {
    print(size(3))
    print(depth(5))
}
