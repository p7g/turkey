-- Instance methods over data types that call themselves on a value they
-- build, rather than on a part of their argument.

type Thing = Thing(Int)

class Sized t { fun size(t) -> Int }

instance Sized Thing {
    fun size(t) {
        let Thing(n) = t
        if n == 0 { 0 } else { size(Thing(n - 1)) }
    }
}

type L = Nil | Cons(Int, L)

instance Sized L {
    fun size(l) = match l {
        Nil -> 0
        Cons(0, rest) -> 1 + size(rest)
        Cons(n, rest) -> size(Cons(n - 1, rest))
    }
}

instance Sized (Option a) {
    fun size(o) = match o {
        Some(_) -> 1
        None -> size(o)
    }
}

fun main() {
    print(size(Thing(4)))
    print(size(Cons(2, Cons(0, Cons(1, Nil)))))
    print(size(Some("x")))
}
