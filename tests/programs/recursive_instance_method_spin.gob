-- An instance method that is nothing but a call to itself compiles. It
-- would never return, so it runs only when the program is given an argument.

import System.Env as Env

class Spin t { fun spin(t) -> t }

instance Spin Int {
    fun spin(n) = spin(n)
}

fun main() {
    if len(Env.args()) > 1 { print(spin(1)) }
    print("compiled")
}
