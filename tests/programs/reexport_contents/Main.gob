-- `..` exports what the module declares, `module Set` a qualifier,
-- `module Shapes (..)` everything `Shapes` exports, and
-- `module Data.Int (gcd)` one name, all but the qualifier unqualified. `Kit`
-- imports none of the names it passes on bare.
import Kit (..)

fun main() {
    print(len(words("a b c")))
    let seen : Set.Set Int = Set.new()
    Set.add(seen, gcd(12, 18))
    print(Set.contains(seen, 6))
    print(area(Circle(2)))
    print(name(Square(1)))
    print(Kit.gcd(4, 6))
}
