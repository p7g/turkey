-- A list passes on the names it lists, a type with the constructors asked
-- for. `module Relay (..)` passes on the qualifier `Relay` exports along
-- with its names, as `import Relay (..)` would bring it.
import Kit (..)

fun main() {
    print(area(Circle(1)))
    print(double(2))
    print(Shapes.name(Shapes.Square(1)))
}
