-- Class methods passed on with a module's contents serve the references the
-- compiler writes: operators, `for`, indexing, negation and `?` all work in
-- a module whose only source of them is the passing module.
import Prelude ()
import Kit (..)

fun firstPositive(xs : Array Int) -> Option Int {
    for x in xs {
        if x > 0 { return Some(x) }
    }
    None
}

fun doubled(xs : Array Int) -> Option Int {
    let x = firstPositive(xs)?
    Some(x + x)
}

fun main() {
    let xs = [-3, 0, 4]
    print(xs[2] - -xs[0])
    print(doubled(xs))
    print(doubled([0]))
}
