-- An entry of a `module Q (...)` list renames what it passes on, as an
-- import's entry does: a value, a type, a constructor or a class. A renamed
-- type's constructors and a renamed class's methods keep their names.
import Kit (..)

fun twice[Measured a](x : a) -> Int = measure(x) * 2

fun describe(f : Form) -> String = match f {
    Round(r) -> "round " + Int.toString(r)
    Square(side) -> "square " + Int.toString(side)
}

fun main() {
    print(size(Round(1)))
    print(size(Circle(2)))
    print(describe(Square(3)))
    print(twice(21))
}
