-- A module hands its importer the qualifiers it exports: `(..)` brings `Set.`
-- and `Deque.` unprefixed.
import AOC (..)

fun main() {
    let seen : Set.Set Int = Set.new()
    Set.add(seen, 3)
    let q = Deque.new(4)
    Deque.pushBack(q, 7)
    print(len(lines("a\nb")))
    print(Set.contains(seen, 3))
    print(Set.contains(seen, 4))
    print(Deque.toArray(q))
}
