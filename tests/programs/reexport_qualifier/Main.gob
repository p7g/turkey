-- A module hands its importer the qualifiers it exports: `(..)` brings `Set.`
-- and `Deque.` unprefixed, and the module's own qualifier reaches them too.
import AOC (..)

fun main() {
    let seen : Set.Set Int = Set.new()
    Set.add(seen, 3)
    let q = Deque.new(4)
    Deque.pushBack(q, 7)
    print(len(lines("a\nb")))
    print(Set.contains(seen, 3))
    print(AOC.Set.contains(seen, 4))
    print(AOC.Deque.toArray(q))
}
