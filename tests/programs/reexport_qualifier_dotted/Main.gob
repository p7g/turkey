-- A qualifier with dots is exported under the same spelling: an importer
-- gets `Net.Wire.` from the list, and reaches it through the module's own
-- qualifier as `Relay.Net.Wire.`.
import Plain
import Renamed
import Relay (..)

fun main() {
    print(Plain.run())
    print(Renamed.run())
    print(Net.Wire.send(3))
}
