-- An import list picks an exported qualifier, renames it, or withholds it;
-- none of these changes what the import's own qualifier reaches.
import Picked
import Renamed
import Relay (module Shapes as _, ..)

fun main() {
    print(Picked.run())
    print(Renamed.run())
    print(double(Relay.Shapes.area(Relay.Shapes.Square(2))))
}
