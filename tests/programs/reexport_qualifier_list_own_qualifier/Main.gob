-- An import with a list still gives the module's own qualifier, which
-- reaches the qualifiers the module exports whatever the list brings,
-- renames or withholds.
import Dots
import Renamed
import Relay (module Shapes as _, ..)

fun main() {
    print(Dots.run())
    print(Renamed.run())
    print(double(Relay.Shapes.area(Relay.Shapes.Square(1))))
}
