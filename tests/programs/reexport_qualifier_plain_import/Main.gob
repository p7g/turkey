-- With no list, an import's own qualifier still reaches the qualifiers the
-- module exports, under the import's alias if it has one. Types, constructors
-- and patterns step through them as values do.
import Relay
import Relay as R

fun describe(s : Relay.Shapes.Shape) -> String = match s {
    Relay.Shapes.Circle(r) -> "circle of " + Int.toString(r)
    R.Shapes.Square(side) -> "square of " + Int.toString(side)
}

fun main() {
    print(Relay.double(4))
    print(Relay.Shapes.area(Relay.Shapes.Circle(2)))
    print(R.Shapes.name(R.Shapes.Square(1)))
    print(describe(R.Shapes.Circle(5)))
}
