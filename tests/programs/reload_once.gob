-- Values in memory across calls: thirteen integers live across the call in a
-- loop, more than the callee-saved registers hold, so some are kept in stack
-- slots. Each is read several times between one call and the next, and a
-- value in a slot is loaded once for all of those reads.

fun touch(n : Int) -> Int = if n <= 0 { 1 } else { touch(n - 1) + 1 }

fun mixed(n : Int) -> Int {
    var a0 = n
    var a1 = n + 1
    var a2 = n + 2
    var a3 = n + 3
    var a4 = n + 4
    var a5 = n + 5
    var a6 = n + 6
    var a7 = n + 7
    var a8 = n + 8
    var a9 = n + 9
    var a10 = n + 10
    var a11 = n + 11
    for var i = 0; i < 10; i = i + 1 {
        let k = touch(i % 3)
        let s = Int.xor(Int.xor(Int.xor(a0, a1), Int.xor(a2, a3)),
                        Int.xor(Int.xor(Int.xor(a4, a5), Int.xor(a6, a7)),
                                Int.xor(Int.xor(a8, a9), Int.xor(a10, a11))))
        a0 = Int.xor(Int.and(a0, k), Int.xor(s, Int.shr(a1, 1)))
        a1 = Int.xor(Int.and(a1, k), Int.xor(s, Int.shr(a2, 1)))
        a2 = Int.xor(Int.and(a2, k), Int.xor(s, Int.shr(a3, 1)))
        a3 = Int.xor(Int.and(a3, k), Int.xor(s, Int.shr(a4, 1)))
        a4 = Int.xor(Int.and(a4, k), Int.xor(s, Int.shr(a5, 1)))
        a5 = Int.xor(Int.and(a5, k), Int.xor(s, Int.shr(a6, 1)))
        a6 = Int.xor(Int.and(a6, k), Int.xor(s, Int.shr(a7, 1)))
        a7 = Int.xor(Int.and(a7, k), Int.xor(s, Int.shr(a8, 1)))
        a8 = Int.xor(Int.and(a8, k), Int.xor(s, Int.shr(a9, 1)))
        a9 = Int.xor(Int.and(a9, k), Int.xor(s, Int.shr(a10, 1)))
        a10 = Int.xor(Int.and(a10, k), Int.xor(s, Int.shr(a11, 1)))
        a11 = Int.xor(Int.and(a11, k), Int.xor(s, Int.shr(a0, 1)))
    }
    a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11
}

fun main() -> Unit {
    print(mixed(touch(2)))
}
