-- Constants across calls. `label` passes `String.concat` a null closure
-- environment, materialized before the nested calls in its argument list and
-- read only after them; `pick` passes a zero into a join whose parameter is
-- live across a call. Neither zero needs a register kept across a call or a
-- stack slot: it is one instruction to compute again where it is read.

fun touch(n : Int) -> Int = if n <= 0 { 1 } else { touch(n - 1) + 1 }

fun label(n : Int) -> String = String.concat("n=", Int.toString(touch(n)))

fun pick(n : Int) -> Int {
    let k = if n > 2 { touch(n) } else { 0 }
    k + touch(k)
}

fun main() -> Unit {
    print(label(3))
    print(pick(1))
    print(pick(3))
}
