-- Constants across calls. `label` passes `String.concat` a null closure
-- environment, materialized before the nested calls in its argument list and
-- read only after them, while nine other values are live across those calls
-- and fill the callee-saved registers. `pick` passes a zero into a join whose
-- parameter is live across a call. Neither zero needs a stack slot: it is one
-- instruction to compute again where it is read.

fun touch(n : Int) -> Int = if n <= 0 { 1 } else { touch(n - 1) + 1 }

fun label(n : Int) -> String {
    let a0 = touch(n)
    let a1 = touch(n + 1)
    let a2 = touch(n + 2)
    let a3 = touch(n + 3)
    let a4 = touch(n + 4)
    let a5 = touch(n + 5)
    let a6 = touch(n + 6)
    let a7 = touch(n + 7)
    let a8 = touch(n + 8)
    let s = String.concat("n=", Int.toString(touch(n)))
    s + " " + Int.toString(a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8)
}

fun pick(n : Int) -> Int {
    let k = if n > 2 { touch(n) } else { 0 }
    k + touch(k)
}

fun main() -> Unit {
    print(label(3))
    print(pick(1))
    print(pick(3))
}
