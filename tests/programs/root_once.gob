-- Pointers that do not change in a loop, live across the loop's calls: an
-- array, a string, a vector and a closure. Each is written to its root slot
-- once, before the loop, and not before every call in it.

fun scan(code : Array Int, text : String, out : Vec Int, keep : fun(Int) -> Bool) -> Int {
    var total = 0
    for var i = 0; i < 1000; i = i + 1 {
        let c = code[i % len(code)]
        if keep(c) { Vec.push(out, c) }
        total = total + String.byteLength(text) + c
    }
    total
}

fun main() {
    let out = []
    print(scan([1, 2, 3, 4], "hello", out, fun(c) = c % 2 == 0))
    print(len(out))
}
