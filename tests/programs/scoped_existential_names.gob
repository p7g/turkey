-- A name new to a `match` arm's pattern stands for whatever type is in its
-- place, an existential's hidden type included, and only in that arm. A name
-- new to a pattern inside a parameter is the same for the whole body.
type Shown = Shown[Show a](a)
type Many = Many[Show a](Array a)

-- The arm uses the name, and after the arm it is free again.
fun outer(s : Shown) -> String {
    let r = match s {
        Shown(v : a) -> {
            let w : a = v
            show(w)
        }
    }
    fun g(y : a) -> a = y
    r + show(g(3))
}

-- Two arms, each with its own hidden `a`, one inside a type.
fun both(s : Shown, m : Many) -> String {
    let first = match s { Shown(v : a) -> show(v) }
    let second = match m { Many(xs : Array a) -> show(len(xs)) + show(xs[0]) }
    first + second
}

-- Opened by a parameter: in scope for the whole body, nested signatures too.
fun param(Shown(v : a)) -> String {
    fun again(y : a) -> String = show(y) + show(v)
    again(v)
}

-- A nested signature inside the arm sees the hidden type.
fun inner(s : Shown) -> String {
    match s {
        Shown(v : a) -> {
            fun keep(y : a) -> a = y
            show(keep(v))
        }
    }
}

-- The hidden type was opened by an enclosing arm, or by a parameter, and the
-- inner arm's pattern names it.
fun enclosing(s : Shown) -> String {
    match s { Shown(v) -> match v { (x : a) -> show(x) } }
}

fun fromParam(Shown(v)) -> String = match v { (x : a) -> show(x) }

fun main() {
    print(outer(Shown(True)))
    print(both(Shown(1), Many(["x"])))
    print(param(Shown(2.5)))
    print(inner(Shown('c')))
    print(enclosing(Shown(True)))
    print(fromParam(Shown(1)))
}
