-- A partial annotation's header variable stays a type of its own, so a
-- nested context's given on it can never be `Show Int`, and `show(m)` uses
-- the `Int` instance rather than waiting on the given.
fun outer[Show k](x : k, n) {
    fun g[Show k](m : Int) -> String = show(x) + show(m)
    g(n)
}

fun main() {
    print(outer(True, 2))
}
