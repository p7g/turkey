-- A nested signature's type variable that the enclosing function names is
-- that function's variable, and only the names new to the nested signature
-- are its own.

-- The local captures `x : k`, so its type is about `describe`'s `k`. Its own
-- `c` is still polymorphic: `pair` is used at two types.
fun describe(x : k) -> String {
    fun pair(y : c) -> (k, c) = (x, y)
    let (_, b) = pair(3)
    let (_, s) = pair("s")
    show(b) + s
}

-- The enclosing context holds inside the nested function, and the nested
-- context may constrain the outer variable alone.
fun shown[Show k](x : k) -> String {
    fun tag[Show c](y : c) -> String = show(x) + "#" + show(y)
    fun again[Show k](n : Int) -> String = show(x) + "*" + show(n)
    tag(1) + " " + tag("two") + " " + again(3)
}

-- Three levels: the innermost signature names both enclosing variables.
fun nest(x : a) -> Int {
    fun middle(y : b) -> Int {
        fun inner(z : c) -> (a, b, c) = (x, y, z)
        let (_, _, n) = inner(1)
        n
    }
    middle("m") + middle(True)
}

-- An enclosing function whose type is inferred: its `k` is not yet known
-- here, and the nested signature mentions it all the same.
fun firstOf(xs : Array k, n) {
    fun get(i : Int) -> k = xs[i]
    get(n)
}

-- A partial annotation and a lambda read the enclosing scope too.
fun keep(x : k) -> k {
    fun same(y) -> k = y
    let id = fun(y : k) = y
    id(same(x))
}

-- Inside instance methods. The lowering maps each rigid constant back to its
-- variable, the instance's and the nested signature's at once. In `pairs`,
-- the `a` the method's own annotation writes is in scope for `with`.
type Box a = Box(a)

class Measure t {
    fun measure(t) -> String
}

instance Measure (Box a) : Show a {
    fun measure(Box(x)) {
        fun twice(y : e) -> Array e = [y, y]
        show(len(twice(1))) + show(x)
    }
}

class Pairs t {
    fun pairs(t, Int) -> String
}

instance Pairs (Box a) : Show a {
    fun pairs(Box(x) : Box a, n : Int) -> String {
        fun with(y : c) -> (a, c) = (x, y)
        let (p, q) = with(n)
        show(p) + show(q)
    }
}

fun main() {
    print(describe(1.5))
    print(shown(True))
    print(nest(0))
    print(firstOf(["a", "b"], 1))
    print(keep(9))
    print(measure(Box("s")))
    print(pairs(Box(True), 4))
}
