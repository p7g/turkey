-- Set algebra through its functions, its operators and `Monoid`.
import Data.Set as Set
import Data.Set (Set)

fun main() {
    let a = Set.fromIterator([1, 2, 3, 4])
    let b = Set.fromIterator(Int.range(3, 7))

    print(Set.union(a, b))
    print(Set.intersection(a, b))
    print(Set.difference(a, b))
    print(Set.symmetricDifference(a, b))

    print(a | b)
    print(a & b)
    print(a - b)
    print(a ^ b)
    print(a <> b)

    -- Neither argument is changed.
    print(a)
    print(b)

    let none = empty() : Set Int
    print(none)
    print(Set.isEmpty(none))
    print(Set.isEmpty(a))
    print((none | a) == a)

    print(Set.isSubset(a & b, a))
    print(Set.isSubset(a, b))
    print(Set.isSubset(none, a))
    print(Set.isDisjoint(a, b))
    print(Set.isDisjoint(a - b, b - a))

    -- Duplicates collapse, in the order they first appear.
    print(Set.fromIterator([3, 1, 3, 2, 1]))

    -- `unionInto` grows a set in place, and returns whether it grew.
    let seen = empty() : Set Int
    for step in [[1, 2], [2, 3], [5], [3]] { print(Set.unionInto(seen, Set.fromIterator(step))) }
    print(seen)

    -- A union keeps `a`'s order, then adds what only `b` has.
    print(Set.fromIterator([9, 1]) | Set.fromIterator([5, 1, 7]))
    -- An intersection keeps the smaller set's order.
    print(Set.fromIterator([1, 2, 3, 4, 5]) & Set.fromIterator([4, 2]))

    -- Both operands the same set.
    print(a | a)
    print(a & a)
    print(a - a)
    print(a ^ a)
    print(Set.isSubset(a, a))
    print(Set.isSubset(a, Set.fromIterator([4, 3, 2, 1])))
}
