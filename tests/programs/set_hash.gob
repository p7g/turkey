-- A set hashes by its contents, so it can key a map or be an element of a set.
import Data.Set as Set
import Data.Set (Set)
import Hash.FxHash (FxHash)
import Data.Hashable (Hasher(..))

fun main() {
    let a = Set.fromIterator([1, 2, 3])
    let b = Set.fromIterator([3, 2, 1])
    print(hash(a) == hash(b))

    let names = Map.new()
    Map.put(names, a, "small")
    print(Map.get(names, b))
    print(Map.get(names, Set.fromIterator([1, 2])))

    let family = Set.new()
    Set.add(family, a)
    Set.add(family, b)
    Set.add(family, Set.fromIterator([4]))
    print(len(family))
    print(Set.contains(family, Set.fromIterator([2, 1, 3])))

    -- Under a hasher as weak as `FxHash`, sets with the same sum still hash
    -- apart: every two-element subset of 0 .. 59 hashes differently.
    print(fxHash(Set.fromIterator([1, 4])) == fxHash(Set.fromIterator([2, 3])))
    let hashes = Set.new()
    for i in Int.range(0, 60) {
        for j in Int.range(i + 1, 60) { Set.add(hashes, fxHash(Set.fromIterator([i, j]))) }
    }
    print(len(hashes))
}

fun fxHash(s : Set Int) -> Int {
    let fresh : FxHash = startHash(0)
    finishHash(hashInto(s, fresh))
}
