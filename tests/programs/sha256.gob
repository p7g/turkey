-- SHA-256 on the FIPS 180-4 vectors, and on the same message fed in pieces of
-- every size that straddles a block boundary.

import Hash.SHA256 as SHA

-- Feed `msg` to a fresh hash `size` bytes at a time, the last piece short.
fun inPieces(msg : Array Byte, size : Int) -> Array Byte {
    let h = SHA.new()
    var at = 0
    while at < len(msg) {
        var to = at + size
        if to > len(msg) { to = len(msg) }
        SHA.update(h, msg, at, to)
        at = to
    }
    SHA.finish(h)
}

fun main() {
    print(SHA.ofText(""))
    print(SHA.ofText("abc"))
    print(SHA.ofText("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))

    let million = Array.filled(1000000, Byte.truncate(97))
    print(SHA.ofBytes(million))

    -- The same 1000 bytes, once and in pieces. A piece that ends mid-block
    -- must carry its bytes into the next update.
    let msg = Array.init(1000, fun(i) = Byte.truncate(i * 7 + i / 3))
    let h = SHA.new()
    SHA.update(h, msg, 0, len(msg))
    let expected = SHA.hex(SHA.finish(h))
    print(expected)
    for size in [1, 63, 64, 65] {
        print(SHA.hex(inPieces(msg, size)) == expected)
    }

    -- `finish` leaves the state alone: more input after it extends the
    -- message, as if it had not been asked for.
    let g = SHA.new()
    SHA.updateText(g, "abc")
    print(SHA.hex(SHA.finish(g)) == SHA.ofText("abc"))
    SHA.updateText(g, "dbcdecdef")
    print(SHA.ofText("abcdbcdecdef") == SHA.hex(SHA.finish(g)))
}
