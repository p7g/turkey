-- Every binder hides a `var` of the same name: inside its scope the name is the
-- new binding, and once that scope ends the `var` is back, unchanged.

fun matchArm() {
    var n = 0
    n = n + 1
    match Some(9) {
        Some(n) -> print(n)
        None -> {}
    }
    print(n)
}

fun blockLet() {
    var n = 0
    n = n + 1
    {
        let n = n * 4
        print(n)
    }
    print(n)
}

fun letPattern() {
    var n = 0
    n = n + 1
    {
        let (n, m) = (n + 4, n + 5)
        print(n + m)
    }
    {
        var (n, m) = (2, 3)
        n = n * 10
        m = m + 1
        print(n + m)
    }
    print(n)
}

fun forPattern() {
    var n = 0
    n = n + 1
    for (n, _) in [(7, "a"), (8, "b")] { print(n) }
    for n in [10, 20] { print(n) }
    print(n)
}

fun ifLet() {
    var n = 0
    n = n + 1
    if let Some(n) = Some(12) { print(n) }
    var k = 3
    while let Some(n) = if k > 0 { Some(k * 100) } else { None } {
        print(n)
        k = k - 1
    }
    print(n)
}

fun lambdas() {
    var n = 0
    n = n + 1
    let double = fun(r) {
        let n = r * 2
        n
    }
    let isThree = fun(r) = match r {
        Some(n) -> n == 3
        None -> False
    }
    print(double(21))
    print(isThree(Some(3)))
    print(n)
}

fun localFun() {
    var n = 0
    n = n + 1
    {
        fun n(x : Int) -> Int = x + 100
        print(n(5))
    }
    print(n)
}

fun cFor() {
    var i = 50
    i = i + 1
    for var i = 0; i < 2; i = i + 1 { print(i) }
    print(i)
}

fun earlyLet(stop) -> Int {
    var n = 0
    n = n + 1
    {
        let n = if stop { return -1 } else { 30 }
        print(n)
    }
    n
}

-- A pattern binder also hides a polymorphic local of its name.
fun polymorphic() {
    let pick = fun(x) = x
    print(pick(1))
    match Some(70) {
        Some(pick) -> print(pick)
        None -> {}
    }
    print(pick("back"))
}

fun main() {
    matchArm()
    blockLet()
    letPattern()
    forPattern()
    ifLet()
    lambdas()
    localFun()
    cFor()
    print(earlyLet(False))
    print(earlyLet(True))
    polymorphic()
}
