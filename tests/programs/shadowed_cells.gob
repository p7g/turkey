-- A binder shadows an outer one of the same name whatever form binds it, and
-- the outer one's being a `var`, or a generalized `let`, does not reach the
-- inner one: a mention of the inner one reads its value, not the outer cell,
-- and is not applied to the outer binding's types.

fun matchArm() {
    var n = 0
    n = n + 1
    match Some(9) {
        Some(n) -> print(n)
        None -> {}
    }
    print(n)
}

fun blockLet() {
    var n = 0
    n = n + 1
    {
        let n = 4
        print(n)
    }
    print(n)
}

fun lambdaLet() {
    var n = 0
    n = n + 1
    let double = fun(r) {
        let n = r * 2
        n
    }
    print(double(5))
    let isThree = fun(r) = match r {
        Some(n) -> n == 3
        None -> False
    }
    print(isThree(Some(3)))
    print(n)
}

fun forPattern() {
    var x = 1
    x = 2
    for x in ["a", "b"] { print(x) }
    print(x)
}

fun destructuring() {
    var x = 1
    x = x + 1
    let (x, y) = ("hello", "3")
    print(x + " " + y)
}

fun localFun() {
    var g = 1
    g = g + 1
    print(g)
    fun g(k : Int) -> Int = k * 10
    print(g(4))
}

-- `let y = 4` is generalized over its numeric type, so a mention of it is a
-- type application; a mention of the arm's `y` must not be.
fun generalizedLet() {
    let y = 4
    match Some(5) {
        Some(y) -> print(Int.toString(y))
        None -> {}
    }
    print(y)
    let (y, z) : (Int, Int) = (7, 8)
    print(y + z)
    let inner = fun(k) {
        let y = k
        y
    }
    print(inner(6))
}

-- Assigning a parameter that shadows a `var` writes the parameter's own cell,
-- not the outer one.
fun assignedParameter() {
    var n = 1
    n = n + 1
    let bump = fun(n) {
        n = n + 5
        n
    }
    print(bump(10))
    print(n)
}

fun main() {
    matchArm()
    blockLet()
    lambdaLet()
    forPattern()
    destructuring()
    localFun()
    generalizedLet()
    assignedParameter()
}
