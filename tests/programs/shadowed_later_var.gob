-- A `let` inside a lambda inside a loop, spelled like a `var` the function
-- declares after the loop. The `var` is not in scope at the `let`, so the
-- lambda's `made` is a plain value and not the `var`'s cell.

fun viaFor(xs : Array Int) -> String {
    for x in xs {
        let g = fun() {
            let made = Int.toString(x)
            made
        }
        print(g())
    }
    var made = "z"
    made = made + "y"
    made
}

fun viaCounter(n : Int) -> String {
    for var i = 0; i < n; i = i + 1 {
        let g = fun() {
            let made = Int.toString(i * 10)
            made
        }
        print(g())
    }
    var made = "w"
    made = made + "v"
    made
}

fun viaMap(xs : Array Int) -> String {
    for x in xs {
        let shown = Array.map([x, x + 1], fun(k) {
            let made = Int.toString(k)
            made
        })
        print(String.join(shown, " "))
    }
    var made = "u"
    made = made + "t"
    made
}

fun main() {
    print(viaFor([1, 2]))
    print(viaCounter(2))
    print(viaMap([3, 5]))
}
