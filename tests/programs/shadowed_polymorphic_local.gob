-- A polymorphic local shadowed by another of the same name, whose right-hand
-- side reads the outer one. Both are used at the same types, so their copies
-- at those types are spelled alike and only their binders tell them apart.

-- The program the shadowing was first reported with.
fun nested(n : Int) -> Int {
    let id = fun(x) = x
    let r = { let id = fun(x) = id(x); id(n) + id(1) }
    r + id(2)
}

-- The two copies at `Int` behave differently, so a reference that reached the
-- wrong one would show in the output.
fun tagged(n : Int) -> String {
    let tag = fun(x) = "<" + show(x) + ">"
    let inner = { let tag = fun(x) = "[" + tag(x) + "]"; tag(n) + tag(n + 1) }
    inner + " " + tag(n)
}

fun wrapped(n : Int) -> String {
    let wrap = fun(x) = [x]
    let inner = {
        let wrap = fun(x) = wrap(wrap(x))
        len(wrap(n)[0]) + len(wrap([n, n])[0][0])
    }
    show(inner) + " " + show(wrap(n))
}

fun main() {
    print(nested(5))
    print(tagged(5))
    print(wrapped(5))
}
