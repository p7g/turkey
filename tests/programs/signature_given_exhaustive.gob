-- A match under a signature's own equality. The scrutinee's element type is
-- `Elem (Iter s)`, which only the given `Elem (Iter s) ~ Option Int` decides,
-- and the exhaustiveness check has to read that given to see the nested
-- `Option` patterns cover it.
class Iterable c {
    type Iter c
    fun iterate(c) -> Iter c
}
class Stream i {
    type Elem i
    fun advance(i) -> Option (Elem i)
}
type ArrayIt a = ArrayIt { xs : Array a, var at : Int }
instance Stream (ArrayIt a) {
    type Elem = a
    fun advance(it) {
        if it.at >= len(it.xs) { return None }
        let x = it.xs[it.at]
        it.at = it.at + 1
        Some(x)
    }
}
instance Iterable (Array a) {
    type Iter = ArrayIt a
    fun iterate(xs) = ArrayIt { xs = xs, at = 0 }
}
fun firstOf[Iterable s, Stream (Iter s), Elem (Iter s) ~ Option Int](s : s) -> Int {
    let it = iterate(s)
    match advance(it) {
        None -> 0
        Some(None) -> 1
        Some(Some(x)) -> x
    }
}
fun main() {
    print(firstOf([Some(7)]))
    print(firstOf([None]))
}
