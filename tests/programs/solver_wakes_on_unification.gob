-- A wanted that is stuck on a variable is solved again once the variable is
-- bound, however the binding comes about. Here `show(b)` needs `Show b`
-- before anything says what `b` is, and the assignment to `x` decides it
-- only through the context of the instance that `cls(x)` then selects: its
-- equality `Elem (Option a) ~ Int` binds `b` to `Int`.
class Bag b { type Elem b }
instance Bag (Option a) { type Elem = a }

class Cls a { fun cls(a) -> String }
class Plain a { fun plain(a) -> String }

type Box a = Box(a)

instance Cls (Box a) : Show a, Eq a, Elem (Option a) ~ Int {
    fun cls(Box(x)) = if x == x { show(x) } else { "" }
}

-- The same without `Eq a`: one wanted fewer from the instance's context.
instance Plain (Box a) : Show a, Elem (Option a) ~ Int {
    fun plain(Box(x)) = show(x)
}

-- Never called: only its checking is the point.
fun anything(u : Unit) -> a = error("never")

fun withEq() -> String {
    var b = anything(())
    let s = show(b)
    var x = anything(())
    let n = cls(x)
    x = Box(b)
    n + s
}

fun withoutEq() -> String {
    var b = anything(())
    let s = show(b)
    var x = anything(())
    let n = plain(x)
    x = Box(b)
    n + s
}

fun main() {
    print(cls(Box(3)))
    print(plain(Box(4)))
}
