type Stack a = Stack {
    data : Vec a,
    var top  : Int
}

fun newStack(capacity : Int) -> Stack a {
    Stack { data = Vec.new(capacity), top = 0 }
}

fun push(s : Stack a, x : a) -> Unit {
    Vec.push(s.data, x)
    s.top = s.top + 1
}

fun pop(s : Stack a) -> a {
    if s.top == 0 { return error("empty stack") }
    s.top = s.top - 1
    match Vec.pop(s.data) {
        Some(x) -> x
        None -> error("the stack's top ran ahead of its array")
    }
}

fun drain(s : Stack a) -> Vec a {
    let out = [] : Vec a
    loop {
        if s.top == 0 { break out }
        Vec.push(out, pop(s))
    }
}

fun main() {
    let s = newStack(4)
    push(s, 10)
    push(s, 20)
    push(s, 30)
    let d = drain(s)
    for x in d { print(Int.toString(x)) }
    print(Int.toString(len(d)))
}
