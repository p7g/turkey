-- `String` as a byte array written in Turkey (TIX-66): every operation that was
-- C until then, at its edges, run by both hosts and by both native emitters.

import Data.String as S

fun bytesOf(xs : Array Int) -> Array Byte {
    let out = []
    for x in xs {
        match Byte.fromInt(x) {
            Some(b) -> Array.push(out, b)
            None -> {}
        }
    }
    out
}

fun accepts(label : String, xs : Array Int) -> Unit {
    let verdict = match S.fromBytes(bytesOf(xs)) {
        Some(s) -> "ok " + s
        None -> "rejected"
    }
    print(label + ": " + verdict)
}

fun kind(word : String) -> String = match word {
    "" -> "empty"
    "let" -> "keyword"
    "lettuce" -> "longer"
    "é" -> "accented"
    _ -> "other"
}

fun main() {
    -- Building.
    print("héllo" + ", " + "wörld" + "")
    print(S.join(["a", "", "日本", "z"], "|"))
    print(S.repeat("ab", 3) + S.repeat("x", 0) + ".")
    print(Char.toString('a') + Char.toString('é') + Char.toString('日')
          + Char.toString('😀'))
    print(Int.toString(0) + " " + Int.toString(-7) + " " + Int.toString(Int.maxValue())
          + " " + Int.toString(Int.minValue()))

    -- Comparing: byte order, prefixes, and the empty string.
    print(Bool.toString("abc" < "abd") + " " + Bool.toString("ab" < "abc")
          + " " + Bool.toString("abc" < "ab") + " " + Bool.toString("" < "a")
          + " " + Bool.toString("" == "") + " " + Bool.toString("é" < "z"))

    -- Searching, including the empty needle.
    print(Bool.toString(S.contains("banana", "nan")) + " "
          + Bool.toString(S.contains("banana", "")) + " "
          + Bool.toString(S.startsWith("banana", "")) + " "
          + Bool.toString(S.endsWith("banana", "")) + " "
          + Bool.toString(S.endsWith("banana", "nab")) + " "
          + Bool.toString(S.startsWith("", "a")))
    print(S.rsplitOnce("M#C.eq#x", "#"))
    print(S.split("日本語", ""))
    print(S.replace("a.b.c", ".", "::"))
    print(S.lines("one\r\ntwo\n\nthree"))
    print(S.words("  spaced   out  "))
    print("[" + S.trim("  é  ") + "]")
    print(S.codePointCount("héllo 日本") )

    -- The door in: well-formed, overlong, surrogate, past 10FFFF, truncated.
    accepts("plain", [104, 105])
    accepts("three", [230, 151, 165])
    accepts("overlong", [192, 175])
    accepts("surrogate", [237, 160, 128])
    accepts("too big", [244, 144, 128, 128])
    accepts("truncated", [226, 130])
    accepts("empty", [])

    -- Literal patterns compare inline, by length and then byte by byte.
    print(kind("") + " " + kind("let") + " " + kind("lettuce") + " "
          + kind("le") + " " + kind("é") + " " + kind("e"))

    -- Enough allocation that stress collects in the middle of a concatenation
    -- with the parts live.
    var acc = ""
    for var i = 0; i < 200; i = i + 1 { acc = acc + Int.toString(i % 10) }
    print(S.byteLength(acc))
    print(S.stripPrefix(acc, "0123"))
}
