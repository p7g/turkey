-- Equality, order and search on strings, at the edges a byte comparison can
-- get wrong: bytes at and above 0x80, which order as unsigned; a proper
-- prefix, which orders first; the empty string and the empty needle; and a
-- search that starts at or past the end.

import Data.String as S

fun order(a : String, b : String) -> String =
    if a < b { "<" } else if b < a { ">" } else { "=" }

fun at(found : Option S.Index, s : String) -> String = match found {
    Some(i) -> show(len(S.toBytes(S.slice(s, S.start(s), i))))
    None -> "none"
}

fun main() {
    print(order("", ""))
    print(order("", "a"))
    print(order("abc", "abd"))
    print(order("abc", "ab"))
    print(order("z", "é"))
    print(order("é", "ê"))
    print(order("é", "é"))
    print(order(S.repeat("x", 100) + "a", S.repeat("x", 100) + "b"))

    print("é" == "é")
    print("é" == "e")
    print("abc" == "abcd")
    print("" == "")
    print(S.repeat("ab", 50) == S.repeat("ab", 49) + "ab")

    print(S.startsWith("éa", "é"))
    print(S.startsWith("é", "a"))
    print(S.startsWith("ab", "abc"))
    print(S.startsWith("abc", ""))
    print(S.endsWith("aé", "é"))
    print(S.endsWith("a", "ba"))
    print(S.endsWith("abc", ""))

    let s = "one, two, three, two"
    print(at(S.find(s, "two", S.start(s)), s))
    print(at(S.find(s, "four", S.start(s)), s))
    print(at(S.find(s, "", S.end(s)), s))
    print(at(S.find(s, "two", S.end(s)), s))
    print(S.contains(s, "e, t"))
    print(S.contains("", ""))
    print(S.contains("", "a"))
    print(S.rsplitOnce(s, "two"))
    print(S.rsplitOnce(s, "one"))
    print(S.rsplitOnce(s, "six"))
    print(S.split("a--b----c", "--"))
}
