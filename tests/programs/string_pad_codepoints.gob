-- Padding to a width counts code points, not bytes; `toCodePoints` and
-- `fromCodePoints` convert a line to a grid row and back; `Char.digitValue`
-- reads a digit.

fun main() {
    print("[" + String.padStart("42", 5, '0') + "]")
    print("[" + String.padEnd("42", 5, '.') + "]")
    print("[" + String.padStart("12345", 3, '0') + "]")
    print("[" + String.padEnd("12345", 5, '0') + "]")
    print("[" + String.padStart("", 3, '-') + "]")
    print("[" + String.padStart("-7", 4, '0') + "]")
    -- Two bytes each, one code point each.
    print("[" + String.padStart("é", 3, 'é') + "]")
    print("[" + String.padEnd("日本", 4, '*') + "]")
    print("[" + String.padStart("x", 3, '日') + "]")
    print("[" + String.padStart("x", 0, ' ') + "]")
    print("[" + String.padStart("x", -4, ' ') + "]")

    let grid = [String.toCodePoints("#.#"), String.toCodePoints(""), String.toCodePoints("aé日😀")]
    for row in grid { print(Int.toString(len(row))) }
    grid[0][1] = '@'
    print(String.fromCodePoints(grid[0]))
    print(show(grid[2]))
    print(String.fromCodePoints(grid[2]))

    for c in ['0', '7', '9', 'a', 'f', 'z', 'A', 'Z', '/', ':', 'é', '٣'] {
        print(show(c) + " " + show(Char.digitValue(c)) + " " + show(Char.digitValueRadix(c, 16))
            + " " + show(Char.digitValueRadix(c, 2)) + " " + show(Char.digitValueRadix(c, 36)))
    }
}
