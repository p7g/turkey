-- 'K a' implies 'Key a ~ Int', and the index makes 'Key a' be 'Elem a'.
-- The solver rewrites the first with the second into 'Elem a ~ Int', which
-- 'K a' and 'Key a ~ Elem a' together imply, so the context leaves it out.

class Bag b { type Elem b; fun el(b) -> Elem b }

class K s : Index s, Key s ~ Int { fun nop(s) -> Int }

fun f(x) = {
    let _ = x[el(x)]
    nop(x)
}

fun main() { }
