-- The floor a program needs to be a compiler: its arguments, and a file it did
-- not have compiled into it.
--
-- Run with no arguments by the golden runner, from `tests/programs`, so the
-- file it reads is its own source under its bare name. `System.File` and
-- `System.Env` under argument passing and a chosen exit status are
-- `tests/test_system.py`, which can hand a program an argv and a temporary
-- directory; a golden file can do neither.

import System.Env as Env
import System.File as File
import System.IO as IO
import Data.String as S

fun main() {
    print("args " + Int.toString(len(Env.args())))

    -- Reading text can fail two ways: the file cannot be read, or it is not
    -- well-formed UTF-8, which a `String` is.
    match File.readText("system.gob") {
        Right(text) -> {
            let ls = S.lines(text)
            print("first " + ls[0])
            print("nonempty " + Bool.toString(len(ls) > 10))
        }
        Left(e) -> print(message(e))
    }

    match File.readText("no/such/file.gob") {
        Right(_) -> print("read a file that is not there")
        Left(e) -> print(message(e))
    }

    let _ = IO.writeText(IO.stderr(), "a line on stderr\n")
}
