-- A loop holding a `?` in a task's own monad, `Task.Spawn`, runs in constant
-- stack: its next iteration is the closure `bind` calls last. It runs in a
-- task, whose stack is a megabyte, which a hundred thousand calls of at least
-- 16 bytes a frame would overflow.

import System.Task as Task

let deep = 100000

fun count(n : Int) -> Task.Spawn Int = do {
    var i = 0
    loop {
        if i == n { break }
        let _ = pure(i)?
        i = i + 1
    }
    pure(i)
}

fun main() {
    print(Task.join(Task.runScope(Task.spawn(fun() = Task.runScope(count(deep))))))
}

