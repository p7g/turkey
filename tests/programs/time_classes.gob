-- One function for every type that supports it: the component accessors and
-- `shift` through their classes, on dates and plain date-times alike, and a
-- user's own generic function over them.

import Time

fun nextWorkday[Shift a, HasDate a](x : a) -> a {
    var d = shift(x, days(1))
    while weekday(d) == Sat || weekday(d) == Sun {
        d = shift(d, days(1))
    }
    d
}

fun describe[HasDate a, HasTime a](x : a) -> String =
    show(weekday(x)) + " " + show(day(x)) + " " + show(month(x)) + " " + show(year(x))
        + " at " + show(hour(x)) + ":" + show(minute(x)) + ":" + show(second(x))
        + " +" + show(nanosecond(x)) + "ns"

fun main() {
    let friday = Option.expect(Date.new(2026, Oct, 23), "date")
    let t = Option.expect(TimeOfDay.withNanosecond(
        Option.expect(TimeOfDay.new(17, 45, 30), "time"), 250), "nanos")
    let deadline = PlainDateTime.new(friday, t)

    print(nextWorkday(friday))
    print(nextWorkday(deadline))
    print(describe(deadline))
    print(hour(t))
    print(date(deadline) == friday)
    print(timeOfDay(deadline) == t)
    print(shift(deadline, months(1) + days(-23)))

    -- Ordering and equality of plain date-times: by date, then time.
    let earlier = PlainDateTime.new(friday, TimeOfDay.midnight)
    print(earlier < deadline)
    print(shift(earlier, days(1)) > deadline)
    print(PlainDateTime.new(friday, t) == deadline)
}
