-- Dates and calendar periods: which dates exist, the day number round trip
-- across the range, weekdays, month-end clamping, mixed-sign periods, and
-- `periodBetween` undoing `shift`.

import Time

fun date(y, m, d) = Option.expect(Date.new(y, m, d), "no such date")

fun main() {
    -- Which dates exist.
    print(Date.new(2024, Feb, 29))
    print(Date.new(2023, Feb, 29))
    print(Date.new(1900, Feb, 29))
    print(Date.new(2000, Feb, 29))
    print(Date.new(2026, Apr, 31))
    print(Date.new(2026, Jan, 0))
    print(Date.new(-9999, Jan, 1))
    print(Date.new(9999, Dec, 31))
    print(Date.new(10000, Jan, 1))
    print(Date.new(-10000, Dec, 31))

    -- Days survive the trip through their fields, and consecutive day numbers
    -- are consecutive dates: every day of 1999 to 2001, which hold a common
    -- year, a leap year and a century that is one, and every 4999th day of the
    -- whole range. Few enough that the corpus still runs under GC stress.
    let first = Date.epochDays(date(-9999, Jan, 1))
    let last = Date.epochDays(date(9999, Dec, 31))
    var checked = 0
    var bad = 0
    let roundTrips = fun(n) {
        let d = Option.expect(Date.fromEpochDays(n), "in range")
        let again = Option.expect(Date.new(year(d), month(d), day(d)), "fields")
        let next = Option.expect(Date.fromEpochDays(n + 1), "in range")
        Date.epochDays(again) == n && Date.daysBetween(d, next) == 1
            && (day(next) == 1 || day(next) == day(d) + 1)
    }
    let from = Date.epochDays(date(1999, Jan, 1))
    for var n = from; n <= Date.epochDays(date(2001, Dec, 31)); n = n + 1 {
        checked = checked + 1
        if !roundTrips(n) { bad = bad + 1 }
    }
    for var n = first; n < last; n = n + 4999 {
        checked = checked + 1
        if !roundTrips(n) { bad = bad + 1 }
    }
    print(show(checked) + " days, " + show(bad) + " wrong")
    print(Date.fromEpochDays(first - 1))
    print(Date.fromEpochDays(last + 1))

    -- Day numbers, weekdays and days of the year.
    print(Date.epochDays(date(1970, Jan, 1)))
    print(Date.epochDays(date(1969, Dec, 31)))
    print(Date.epochDays(date(2000, Mar, 1)))
    print(weekday(date(1970, Jan, 1)))
    print(weekday(date(2026, Oct, 18)))
    print(weekday(date(1, Jan, 1)))
    print(weekday(date(0, Dec, 31)))
    print(dayOfYear(date(2024, Dec, 31)))
    print(dayOfYear(date(2023, Mar, 1)))
    print(Date.isLeapYear(0))
    print(Date.daysInMonth(2024, Feb))

    -- Shifting: months first, clamped to the end of a short month, then days.
    let jan31 = date(2024, Jan, 31)
    print(shift(jan31, months(1)))
    print(shift(jan31, months(1) + months(1)))
    print(shift(shift(jan31, months(1)), months(1)))
    print(shift(jan31, months(-2)))
    print(shift(jan31, months(1) + days(-1)))
    print(shift(date(2024, Feb, 29), years(1)))
    print(shift(date(2024, Feb, 29), years(4)))
    print(shift(date(2024, Dec, 31), days(1)))
    print(shift(date(2025, Mar, 1), days(-1)))
    print(shift(date(2026, Oct, 18), weeks(-2)))
    print(shift(date(1, Jan, 1), days(-1)))

    -- periodBetween: whole months, then days; shifting by it gets back.
    print(Date.periodBetween(date(2024, Jan, 31), date(2024, Feb, 29)))
    print(Date.periodBetween(date(2024, Jan, 31), date(2024, Mar, 1)))
    print(Date.periodBetween(date(2024, Mar, 1), date(2024, Jan, 31)))
    print(Date.periodBetween(date(1990, Jun, 15), date(2026, Oct, 18)))
    print(Date.periodBetween(date(2026, Oct, 18), date(2026, Oct, 18)))
    print(Date.daysBetween(date(2026, Oct, 18), date(2026, Dec, 25)))
    var seed = 7
    var wrong = 0
    for var i = 0; i < 300; i = i + 1 {
        seed = Int.mod(seed * 1103515245 + 12345, 2147483648)
        let a = Option.expect(Date.fromEpochDays(Int.mod(seed, 200000) - 100000), "a")
        seed = Int.mod(seed * 1103515245 + 12345, 2147483648)
        let b = Option.expect(Date.fromEpochDays(Int.mod(seed, 200000) - 100000), "b")
        if shift(a, Date.periodBetween(a, b)) != b { wrong = wrong + 1 }
    }
    print(show(wrong) + " of 300 sampled periods fail to shift back")

    -- Periods: years and weeks are months and days; fields keep their signs.
    print(years(1) == months(12))
    print(weeks(2) == days(14))
    print(months(1) == days(30))
    print(years(1) + months(3) - days(2))
    print(-(months(14) + days(3)))
    print(months(1) + days(-3))
    let p = years(2) + days(5)
    print(show(p.months) + " months, " + show(p.days) + " days")
}
