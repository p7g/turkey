-- Elapsed time and the global timeline: duration arithmetic and its ISO text,
-- instants in RFC 3339 with offsets, the range an instant has, and `after`,
-- `before` and `elapsed` through the `Timeline` class, and the monotonic clock's
-- stopwatch and deadline.

import Time

fun parsed(s) = Option.expect(Instant.parse(s), "not an instant")

fun main() {
    -- Durations: exact units, arithmetic, scaling, text.
    print(hours(1) + minutes(30))
    print(minutes(90) == hours(1) + minutes(30))
    print(seconds(1) - millis(1))
    print(-minutes(5))
    print(Duration.times(minutes(20), 3))
    print(Duration.divide(seconds(1), 3))
    print(Duration.zero)
    print(nanos(1))
    print(micros(1500))
    print(hours(25))
    print(Duration.toSeconds(millis(-2500)))
    print(Duration.toNanos(micros(3)))
    print(hours(2) > minutes(119))
    print(Duration.nanos(Int.minValue()))
    for s in ["PT1H30M", "PT90M", "PT1.5S", "-PT5M", "+PT0S", "PT36H", "PT0.000000001S",
              "PT1H0.5S"] {
        print(s + " -> " + show(Duration.parse(s)))
    }
    for s in ["P1D", "PT", "P", "PT1.5H", "PT1S1M", "PT1M1M", "PT99999999999999H", "1H",
              "PT-1H", ""] {
        print("'" + s + "' -> " + show(Duration.parse(s)))
    }

    -- Instants: an offset or Z is required, and is applied.
    for s in ["2026-10-18T18:03:07.52Z", "2026-10-18T14:03:07.52-04:00",
              "2026-10-19T03:33:07.52+09:30", "1970-01-01T00:00:00Z",
              "1969-12-31T23:59:59.999999999Z", "2026-10-18T18:03z"] {
        print(s + " -> " + show(Instant.parse(s)))
    }
    for s in ["2026-10-18T18:03:07", "2026-10-18T18:03:07+24:00", "2026-10-18T18:03:07+0400",
              "2026-10-18 18:03:07Z", "2026-10-18T18:03:07Z[UTC]", "1600-01-01T00:00:00Z",
              "2262-04-11T23:47:16.854775807Z", "2262-04-11T23:47:16.854775808Z",
              "1677-09-21T00:12:43.145224192Z", "1677-09-21T00:12:43.145224191Z"] {
        print("'" + s + "' -> " + show(Instant.parse(s)))
    }
    print(Instant.unixNanos(parsed("1970-01-01T00:00:01Z")))
    print(Instant.fromUnixNanos(-1))
    print(Instant.fromUnixNanos(Int.minValue()))

    -- The timeline: moving and measuring, through the class functions.
    let launch = parsed("2026-10-18T18:00:00Z")
    print(after(launch, minutes(90)))
    print(before(launch, hours(48)))
    print(elapsed(launch, parsed("2026-10-19T00:00:00+02:00")))
    print(elapsed(parsed("2026-10-19T00:00:00+02:00"), launch))
    print(parsed("2026-10-18T14:00:00-04:00") == launch)
    print(instant(launch) == launch)

    -- The system clock: later than when this test was written, and two
    -- readings in order (or equal, with a coarse clock).
    let first = Instant.now()
    let second = Instant.now()
    print(first > parsed("2026-10-18T00:00:00Z"))
    print(elapsed(first, second) >= Duration.zero)

    -- The monotonic clock: a stopwatch only counts up.
    let clock = Stopwatch.start()
    while Stopwatch.elapsed(clock) < millis(2) {}
    let lap = Stopwatch.elapsed(clock)
    print(lap >= millis(2) && Stopwatch.elapsed(clock) >= lap)

    -- A deadline counts down, and stops at zero once it has passed.
    let soon = Deadline.after(millis(2))
    let later = Deadline.after(hours(1))
    print(!Deadline.passed(later) && Deadline.remaining(later) <= hours(1))
    print(soon < later)
    while !Deadline.passed(soon) {}
    print(Deadline.remaining(soon) == Duration.zero)
    print(Deadline.passed(Deadline.after(-seconds(1))))
}
