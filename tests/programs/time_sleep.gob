import Time
import System.Task as Task

-- Three tasks sleep for different times and print in the order they wake, not
-- the order they were spawned in. The scope ends only when all three have
-- finished.
fun main() {
    Task.runScope(do {
        let _ = Task.spawn(fun() {
            sleep(millis(60))
            print(60)
        })?
        let _ = Task.spawn(fun() {
            sleep(millis(20))
            print(20)
        })?
        let _ = Task.spawn(fun() {
            sleep(millis(40))
            print(40)
        })?
        pure({})
    })

    -- A zero or negative sleep returns at once.
    sleep(seconds(0))
    sleep(millis(-5))
    print("zero and negative returned")

    -- A sleep from main's own stack lasts at least as long as asked.
    let sw = Stopwatch.start()
    sleep(millis(30))
    print(Stopwatch.elapsed(sw) >= millis(30))

    -- A sleep until a deadline returns once it has passed.
    sleepUntil(Deadline.after(millis(10)))
    print("deadline returned")
}
