-- ISO 8601 text for the civil types: what `show` writes, that `parse` reads it
-- back, and the inputs `parse` refuses.

import Time

fun main() {
    -- Dates, including the expanded form outside years 0 to 9999.
    for s in ["2026-10-18", "0000-01-01", "-000044-03-15", "+009999-12-31", "-009999-01-01"] {
        print(s + " -> " + show(Date.parse(s)))
    }
    for s in ["2026-02-30", "2026-13-01", "2026-1-01", "20261018", "2026-10-18T00:00", "",
              "-2026-10-18", "+010000-01-01", " 2026-10-18"] {
        print("'" + s + "' -> " + show(Date.parse(s)))
    }

    -- Times: fractions as short as they can be, and the forms parse accepts.
    for s in ["09:30", "09:30:15", "23:59:59.999999999", "00:00:00.5", "12:00:00,25",
              "23:59:60", "00:00:00.000000000"] {
        print(s + " -> " + show(TimeOfDay.parse(s)))
    }
    for s in ["24:00", "12:60", "9:30", "12:00:00.", "12:00:00.0000000001", "12:00Z",
              "12:00:00+01:00", "12"] {
        print("'" + s + "' -> " + show(TimeOfDay.parse(s)))
    }
    let t = Option.expect(TimeOfDay.new(7, 5, 3), "time")
    print(TimeOfDay.withNanosecond(t, 120000000))
    print(TimeOfDay.withNanosecond(t, 1000000000))
    print(TimeOfDay.new(24, 0, 0))
    print(TimeOfDay.midnight)

    -- Plain date-times: no offset or zone is accepted.
    for s in ["2026-10-18T09:30", "2026-10-18T09:30:00.1", "-000001-12-31T23:59:59"] {
        print(s + " -> " + show(PlainDateTime.parse(s)))
    }
    for s in ["2026-10-18 09:30", "2026-10-18T09:30Z", "2026-10-18T09:30-04:00",
              "2026-10-18T09:30[America/Toronto]", "2026-10-18"] {
        print("'" + s + "' -> " + show(PlainDateTime.parse(s)))
    }

    -- Periods: weeks become days, signs per field or for the whole.
    for s in ["P1Y2M10D", "P3W", "P1Y1W", "-P1M2D", "P-1Y+2M", "P0D", "P14M", "P400D"] {
        print(s + " -> " + show(Period.parse(s)))
    }
    for s in ["P", "1Y", "P1D2M", "P1Y1Y", "P1.5D", "P1DT2H", "PT1H", "P-D", ""] {
        print("'" + s + "' -> " + show(Period.parse(s)))
    }
}
