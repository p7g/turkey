-- Top-level bindings the value restriction keeps monomorphic, each decided by
-- a use later in the same module: the literal in `seed` becomes a Float, the
-- `Show` in `render` is Bool's, and `table` maps String to Int.

fun ident(x) = x

let seed = ident(3)
let render = ident(show)
let table = Map.new()

fun half() = seed / 2.0

fun remember(k : String, v : Int) = Map.put(table, k, v)

fun main() {
    print(seed)
    print(half())
    print(render(True))
    remember("a", 1)
    print(Map.get(table, "a"))
}
