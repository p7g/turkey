-- `Typed` for a type with a higher-kinded parameter. `T Option` is a type of
-- kind `*`, so it has a rep, and the rep of its argument `Option`, a
-- constructor of kind `* -> *`, is the constructor's name with no arguments.

import Data.Typed (Proxy(..), TypeRep, typeRep, name, describe)

type T f = T(f Int)
type Pair f g = Pair(f Int, g String)

-- Generic over the type, so the instance is specialized at `T Option` from a
-- caller that only passes the dictionary along.
fun repOf[Typed a](p : Proxy a) -> TypeRep = typeRep(p)

fun main() {
    let p : Proxy (T Option) = Proxy
    print(name(typeRep(p)))
    print(describe(typeRep(p)))
    print(describe(repOf(p)))

    let q : Proxy (Pair Option Array) = Proxy
    print(describe(repOf(q)))

    -- Same constructor, different higher-kinded argument: not the same type.
    let r : Proxy (T Array) = Proxy
    print(describe(repOf(r)))
    print(repOf(p) == repOf(p))
    print(repOf(p) == repOf(r))

    -- `Option` the argument and `Option Int` the type are different instances.
    let o : Proxy (Option Int) = Proxy
    print(describe(repOf(o)))
}
