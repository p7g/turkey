-- `Typed` at a partially applied constructor. `Either String` is the argument
-- of `T (Either String)`, a type of kind `* -> *`, and its rep is `Either`
-- applied to `String` alone: a rep is built the way the type is, by
-- application.

import Data.Typed (Proxy(..), TypeRep, typeRep, arity, argument, describe)

type T f = T(f Int)

fun repOf[Typed a](p : Proxy a) -> TypeRep = typeRep(p)

fun main() {
    let p : Proxy (T (Either String)) = Proxy
    print(describe(repOf(p)))
    let partial = argument(repOf(p), 0)
    print(arity(partial))

    -- The partial application and the full one have different instances, and
    -- different reps.
    let full : Proxy (Either String Int) = Proxy
    print(describe(repOf(full)))
    print(partial == repOf(full))

    let q : Proxy (T (Either Int)) = Proxy
    print(repOf(p) == repOf(q))
}
