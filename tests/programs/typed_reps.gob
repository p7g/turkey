-- Solver-derived `Typed` instances (ERRORS.md step 5). A type is a value here:
-- `typeRep` answers the constructor's qualified name and the reps of its
-- arguments, built from the dictionaries the instance was handed.
--
-- No instance is written anywhere in this file, and none can be: the compiler
-- derives them, because an instance that lied about a type is exactly what
-- would make a checked cast unsound.

import Data.Typed (TypeRep(..), Proxy(..), describe)

type Box a = Box(a)
type Pair a b = Pair(a, b)

fun shown[Typed a](p : Proxy a) -> String = describe(typeRep(p))
fun repOf[Typed a](p : Proxy a) -> TypeRep = typeRep(p)

fun intP() -> Proxy Int = Proxy
fun strP() -> Proxy String = Proxy
fun boxIntP() -> Proxy (Box Int) = Proxy
fun boxStrP() -> Proxy (Box String) = Proxy
fun pairP() -> Proxy (Pair (Box Int) String) = Proxy
fun tupleP() -> Proxy (Int, String) = Proxy
fun arrayP() -> Proxy (Array (Option Int)) = Proxy

fun main() {
    print(shown(intP()))
    print(shown(boxIntP()))
    -- Nested arguments are parenthesized: `Pair Box Int String` and
    -- `Pair (Box Int) String` are different types.
    print(shown(pairP()))
    print(shown(tupleP()))
    print(shown(arrayP()))

    -- Identity is structural, which is what a cast will compare.
    print(repOf(intP()) == repOf(intP()))
    print(repOf(intP()) == repOf(strP()))
    -- Same constructor, different argument: not the same type.
    print(repOf(boxIntP()) == repOf(boxStrP()))
}
