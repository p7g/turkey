-- `()` is the unit type as well as the unit value, wherever a type is written.
type Callback = fun(String) -> ()

fun twice(f : Callback, message : String) -> () {
    f(message)
    f(message)
}

fun shout(message : String) -> Unit = print(message + "!")

fun main() {
    let results : Array () = [twice(shout, "hello"), ()]
    print(len(results))
}
