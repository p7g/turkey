-- Code after a statement that cannot complete is unreachable: the block has
-- no value of its own, so it fits wherever a value of any type is wanted, and
-- nothing after the statement runs.
import System.Env as Env

fun die(message : String) -> a = error(message)

fun orSeven(o : Option Int) -> Int {
    let n = match o {
        Some(n) -> n
        None -> {
            return 7
            print("unreachable")
        }
    }
    n
}

-- The `break` cannot be reached, so the loop never produces a value either.
fun double(n : Int) -> Int {
    let r = loop {
        if n > 0 { return n * 2 } else { return 0 }
        break 5
    }
    r
}

-- An `else` block may hold code after the statement that leaves it.
fun first(xs : Vec Int) -> Int {
    let Some(x) = Vec.pop(xs) else {
        return -1
        print("unreachable")
    }
    x
}

fun main() {
    print(orSeven(None))
    print(orSeven(Some(1)))
    print(double(4))
    print(first([3]))
    print(first([]))
    -- `Env.exit` never returns, so the `print` after it is never lowered.
    let Some(code) = Int.parse("none") else {
        Env.exit(0)
        print("unreachable")
    }
    print(code)
}
