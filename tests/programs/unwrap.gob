-- `e!` on every kind of value the library gives an instance, and on a
-- program's own, combined with the operators and suffixes around it.

type Odd = Odd(Int)

instance Error Odd {
    fun message(o) = match o { Odd(n) -> Int.toString(n) + " is odd" }
}

fun half(n : Int) -> Either Odd Int =
    if n % 2 == 0 { Right(n / 2) } else { Left(Odd(n)) }

-- A library boundary's error, which is packed.
fun halfPacked(n : Int) -> Either SomeError Int = Error.promote(half(n))

-- A program's own type, which holds a value only once it is checked.
type Checked a = Checked(Bool, a)

instance Unwrap Checked {
    fun tryUnwrap(c) = match c {
        Checked(True, x)  -> Right(x)
        Checked(False, _) -> Left("not checked")
    }
}

-- `?` and `!` chain as suffixes, left to right.
fun inner(o : Option (Option Int)) -> Option Int = Some(o?! + 1)

fun main() {
    print(Int.parse("2026")! + 1)
    print(half(8)!)
    print(halfPacked(12)!)
    print(Checked(True, "checked")!)
    print(inner(Some(Some(4)))!)

    -- `!=` is one token, and a prefix `!` applies to what the suffix gives.
    let flag = Some(False)
    print(flag!=Some(True))
    print(!flag!)

    -- A line may end in `!`.
    let width = Int.parse("80")!
    print(width)

    -- A hole of a string literal holds a `!` like any other expression.
    let parsed = Int.parse("7")
    print("parsed ${parsed!}, doubled ${parsed! * 2}, next ${Int.parse("8")!}")

    -- The method is an ordinary class method too.
    print(tryUnwrap(Checked(False, 0)))
    print(tryUnwrap(half(3)))
}
