-- What `!` costs after the optimizations. `Option`'s `tryUnwrap` is inlined,
-- case-of-known-constructor removes the `Either` it returns, and what is left
-- is one `match` on the `Option`, with the panic in its `None` arm.

fun parsed(s : String) -> Int = Int.parse(s)!

fun main() {
    print(parsed("41") + 1)
}
