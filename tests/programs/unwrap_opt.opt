-- bindings
Main#parsed : fun(String) -> Int =
  fun(s : String) {
    match Data.Int#parseRadix(s, 10) {
      Data.Option#Some(x) ->
        x
      Data.Option#None ->
        Prim.error[Int]("unwrapped None")
    }
  }

Main#main : fun() -> Unit =
  fun() {
    Turkey.Stdout#print@Int(
      let x%1 : Int =
        match Data.Int#parseRadix("41", 10) {
          Data.Option#Some(x%2) ->
            x%2
          Data.Option#None ->
            Prim.error[Int]("unwrapped None")
        }
      Prim.intAdd(x%1, 1)
    )
  }
