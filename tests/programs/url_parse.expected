-- parse
"https://Example.COM:8443/a/b%20c?x=1&y=%2F#frag" -> https://example.com:8443/a/b%20c?x=1&y=%2F#frag scheme=https path=/a/b%20c query=Some("x=1&y=%2F") fragment=Some("frag") segments=Some(["a", "b c"])
"mailto:someone@example.com" -> mailto:someone@example.com scheme=mailto path=someone@example.com query=None fragment=None segments=Some(["someone@example.com"])
"urn:isbn:0451450523" -> urn:isbn:0451450523 scheme=urn path=isbn:0451450523 query=None fragment=None segments=Some(["isbn:0451450523"])
"http://[::1]:80/" -> http://[::1]:80/ scheme=http path=/ query=None fragment=None segments=Some([""])
"http://[2001:DB8::1]/" -> http://[2001:db8::1]/ scheme=http path=/ query=None fragment=None segments=Some([""])
"file:///etc/hosts" -> file:///etc/hosts scheme=file path=/etc/hosts query=None fragment=None segments=Some(["etc", "hosts"])
"http://user:pw@host/p" -> http://user:pw@host/p scheme=http path=/p query=None fragment=None segments=Some(["p"])
"HTTP://host" -> http://host scheme=http path= query=None fragment=None segments=Some([])
"http://h:/" -> invalid port in URL
"http://h:99999/" -> invalid port in URL
"http://h:-1/" -> invalid port in URL
"http://a b/" -> invalid host in URL
"http://h/a b" -> invalid URL path
"http://h/\r\nX: y" -> invalid URL path
"http://h/%zz" -> invalid URL path
"http://h/%4" -> invalid URL path
"http://h/?q="x"" -> invalid URL query
"http://h/é" -> invalid URL path
"http://h/#a#b" -> invalid URL fragment
"http://[fe80::1%25en0]/" -> invalid host in URL
"http://[1.2.3.4]/" -> invalid host in URL
"http://[::1/" -> invalid host in URL
"relative/path" -> not an absolute URL: it has no scheme
"1a:b" -> invalid URL scheme
"" -> not an absolute URL: it has no scheme
-- references
"/orders/42" -> Right(Reference(Parts { scheme = None, authority = None, path = "/orders/42", query = None, fragment = None }))
"../x?y" -> Right(Reference(Parts { scheme = None, authority = None, path = "../x", query = Some("y"), fragment = None }))
"?page=2" -> Right(Reference(Parts { scheme = None, authority = None, path = "", query = Some("page=2"), fragment = None }))
"#top" -> Right(Reference(Parts { scheme = None, authority = None, path = "", query = None, fragment = Some("top") }))
"//cdn.example.com/a.js" -> Right(Reference(Parts { scheme = None, authority = Some(Authority { userinfo = None, host = "cdn.example.com", port = None }), path = "/a.js", query = None, fragment = None }))
"a:b" -> Right(Reference(Parts { scheme = Some("a"), authority = None, path = "b", query = None, fragment = None }))
"./a:b" -> Right(Reference(Parts { scheme = None, authority = None, path = "./a:b", query = None, fragment = None }))
"x y" -> Left(BadPath)
-- resolve
"g:h" -> g:h
"g" -> http://a/b/c/g
"./g" -> http://a/b/c/g
"g/" -> http://a/b/c/g/
"/g" -> http://a/g
"//g" -> http://g
"?y" -> http://a/b/c/d;p?y
"g?y" -> http://a/b/c/g?y
"#s" -> http://a/b/c/d;p?q#s
"g#s" -> http://a/b/c/g#s
"g?y#s" -> http://a/b/c/g?y#s
";x" -> http://a/b/c/;x
"g;x" -> http://a/b/c/g;x
"g;x?y#s" -> http://a/b/c/g;x?y#s
"" -> http://a/b/c/d;p?q
"." -> http://a/b/c/
"./" -> http://a/b/c/
".." -> http://a/b/
"../" -> http://a/b/
"../g" -> http://a/b/g
"../.." -> http://a/
"../../" -> http://a/
"../../g" -> http://a/g
"../../../g" -> http://a/g
"../../../../g" -> http://a/g
"/./g" -> http://a/g
"/../g" -> http://a/g
"g." -> http://a/b/c/g.
".g" -> http://a/b/c/.g
"g.." -> http://a/b/c/g..
"..g" -> http://a/b/c/..g
"./../g" -> http://a/b/g
"./g/." -> http://a/b/c/g/
"g/./h" -> http://a/b/c/g/h
"g/../h" -> http://a/b/c/h
"g;x=1/./y" -> http://a/b/c/g;x=1/y
"g;x=1/../y" -> http://a/b/c/y
"g?y/./x" -> http://a/b/c/g?y/./x
"g?y/../x" -> http://a/b/c/g?y/../x
"g#s/./x" -> http://a/b/c/g#s/./x
"g#s/../x" -> http://a/b/c/g#s/../x
"http:g" -> http:g
-- HTTP URLs
"https://api.example.com/users/1?x=y#ignored" -> https://api.example.com/users/1?x=y host=api.example.com port=443 authority=api.example.com target=/users/1?x=y https=True
"http://example.com" -> http://example.com/ host=example.com port=80 authority=example.com target=/ https=False
"http://example.com:8080" -> http://example.com:8080/ host=example.com port=8080 authority=example.com:8080 target=/ https=False
"http://example.com." -> http://example.com./ host=example.com. port=80 authority=example.com. target=/ https=False
"http://[::1]:8443/a" -> http://[::1]:8443/a host=[::1] port=8443 authority=[::1]:8443 target=/a https=False
"ftp://example.com/" -> unsupported URL scheme 'ftp'
"mailto:a@b" -> unsupported URL scheme 'mailto'
"https://user@example.com/" -> URL has user information, which is not allowed here
"https://%65xample.com/" -> invalid host in URL
"http:///path" -> URL has no host
"http:path" -> URL has no host
