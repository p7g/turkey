import URL as URL (URL)
import Net.HTTP.HTTPURL as HTTPURL

-- Returns `s` quoted, with CR and LF spelled as escapes, so a refused URL
-- prints on one line.
fun visible(s : String) -> String = "\"" + String.replace(String.replace(s, "\r", "\\r"), "\n", "\\n") + "\""

fun main() {
    print("-- parse")
    let texts = [
        "https://Example.COM:8443/a/b%20c?x=1&y=%2F#frag",
        "mailto:someone@example.com",
        "urn:isbn:0451450523",
        "http://[::1]:80/",
        "http://[2001:DB8::1]/",
        "file:///etc/hosts",
        "http://user:pw@host/p",
        "HTTP://host",
        -- Refused.
        "http://h:/",
        "http://h:99999/",
        "http://h:-1/",
        "http://a b/",
        "http://h/a b",
        "http://h/\r\nX: y",
        "http://h/%zz",
        "http://h/%4",
        "http://h/?q=\"x\"",
        "http://h/é",
        "http://h/#a#b",
        "http://[fe80::1%25en0]/",
        "http://[1.2.3.4]/",
        "http://[::1/",
        "relative/path",
        "1a:b",
        "",
    ]
    for t in texts {
        match URL.parse(t) {
            Right(u) -> print(visible(t) + " -> " + show(u) + " scheme=" + URL.scheme(u) + " path="
                              + URL.path(u) + " query=" + show(URL.query(u)) + " fragment="
                              + show(URL.fragment(u)) + " segments=" + show(URL.segments(u)))
            Left(e) -> print(visible(t) + " -> " + show(e))
        }
    }

    print("-- references")
    for t in ["/orders/42", "../x?y", "?page=2", "#top", "//cdn.example.com/a.js", "a:b", "./a:b", "x y"] {
        print(visible(t) + " -> " + show(URL.parseReference(t)))
    }

    -- RFC 3986 §5.4.1, every normal example, and §5.4.2's abnormal ones.
    print("-- resolve")
    let base = URL.literal("http://a/b/c/d;p?q")
    let references = [
        "g:h", "g", "./g", "g/", "/g", "//g", "?y", "g?y", "#s", "g#s", "g?y#s", ";x", "g;x",
        "g;x?y#s", "", ".", "./", "..", "../", "../g", "../..", "../../", "../../g",
        "../../../g", "../../../../g", "/./g", "/../g", "g.", ".g", "g..", "..g", "./../g",
        "./g/.", "g/./h", "g/../h", "g;x=1/./y", "g;x=1/../y", "g?y/./x", "g?y/../x",
        "g#s/./x", "g#s/../x", "http:g",
    ]
    for r in references {
        print(visible(r) + " -> " + show(URL.resolve(base, URL.referenceLiteral(r))))
    }

    print("-- HTTP URLs")
    let httpTexts = [
        "https://api.example.com/users/1?x=y#ignored",
        "http://example.com",
        "http://example.com:8080",
        "http://example.com.",
        "http://[::1]:8443/a",
        "ftp://example.com/",
        "mailto:a@b",
        "https://user@example.com/",
        "https://%65xample.com/",
        "http:///path",
        "http:path",
    ]
    for t in httpTexts {
        match HTTPURL.parse(t) {
            Right(u) -> print(visible(t) + " -> " + show(u) + " host=" + HTTPURL.host(u) + " port="
                              + show(HTTPURL.port(u)) + " authority=" + HTTPURL.authority(u)
                              + " target=" + HTTPURL.target(u) + " https=" + show(HTTPURL.isHTTPS(u)))
            Left(e) -> print(visible(t) + " -> " + show(e))
        }
    }
}
