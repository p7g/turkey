-- Declared operators: each aliases a function and takes its group's
-- precedence and associativity.

infix Combine (<>) = combine
infix Combine (<+>) = nest
infix Sequence (|>) = pipe
infix Sequence (|>>) = bind
infix Equality (===) = sameLength
infix BitAnd (&) = both
infix Choice (<|>) = orElse

-- Not associative, so the grouping shows in the result.
fun nest(a : String, b : String) -> String = "(" + a + " " + b + ")"

fun pipe(x, f) = f(x)

fun sameLength(a : String, b : String) -> Bool = String.byteLength(a) == String.byteLength(b)

fun both(a : Int, b : Int) -> Int = if a == b { a } else { 0 }

fun orElse(a : Option b, fallback : Option b) -> Option b = match a {
    Some(_) -> a
    None -> fallback
}

fun half(n : Int) -> Option Int = if n % 2 == 0 { Some(n / 2) } else { None }

fun traced(label : String, value : Option Int) -> Option Int {
    print(label)
    value
}

fun main() {
    -- Combine binds tighter than Equality.
    print("ab" <> "c" == "abc")
    -- Combine is right-associative.
    print("a" <+> "b" <+> "c")
    -- Addition and Combine are unrelated, so parentheses decide.
    print(("x" + "y") <+> "z")
    -- Sequence is below Disjunction, and left-associative.
    print(False || True |> show |> String.codePointCount)
    print(Some(12) |>> half |>> half |>> half)
    -- An operator that begins with `=` may end in one.
    print("abc" === "xyz")
    -- BitAnd binds tighter than Comparison.
    print(6 & 6 == 6)
    -- Choice is between Disjunction and Sequence; a declared operator is an
    -- ordinary call, so both operands are evaluated.
    print(traced("left", None) <|> traced("right", Some(1)))
    -- A leading operator continues the line before it.
    let greeting = "Hello"
        <> ", "
        <> "world"
    print(greeting)
    -- The named function is still there.
    print(nest("p", "q"))
}
