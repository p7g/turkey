-- A `var` that destructures makes every name it binds assignable, as a `var`
-- of one name does, including when its value can `return` or `break`.
fun shifted(p : (Int, Int)) -> Int {
    var (a, b) = p
    a = a + 10
    b = b * 2
    a - b
}

fun firstPair(xs : Array Int) -> Int {
    var sum = 0
    for x in xs {
        var (lo, hi) = if x > 0 { (x, x + 1) } else { break }
        lo = lo * 100
        sum = sum + lo + hi
    }
    sum
}

-- The value may come through `?`.
fun parsedPair(a : String, b : String) -> Option Int {
    var (x, y) = (Int.parse(a)?, Int.parse(b)?)
    x = x * 10
    y = y + 1
    Some(x + y)
}

fun main() {
    print(shifted((1, 2)))
    print(firstPair([1, 2, -1, 5]))
    print(parsedPair("4", "2"))
    print(parsedPair("4", "x"))
}
