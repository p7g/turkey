-- A `Vec` compares its elements, not its capacity: only the first `len(v)`
-- slots count.
fun main() {
    let roomy = Vec.new(64)
    Vec.push(roomy, "a")
    Vec.push(roomy, "b")
    let tight : Vec String = ["a", "b"]
    print(roomy == tight)

    -- A popped element is gone, even though its slot still holds it.
    Vec.push(roomy, "c")
    print(roomy == tight)
    let _ = Vec.pop(roomy)
    print(roomy == tight)

    Vec.push(tight, "z")
    print(roomy != tight)
    print(Vec.new(8) == (Vec.new(0) : Vec Int))
}
