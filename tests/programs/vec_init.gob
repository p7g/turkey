-- `Vec.init` calls its function once per index, in order, and gives each
-- element its own value.

fun main() {
    let squares = Vec.init(4, fun(i) = i * i)
    print(squares)
    let rows : Vec (Vec Int) = Vec.init(3, fun(_) = [])
    Vec.push(rows[0], 7)
    print(rows)
    Vec.push(squares, 16)
    print(len(squares))
    print(Vec.init(0, fun(i) = i))
}
