-- A chain of wanted equalities, each family decided as a pair of the next.
-- The inferred context lists each equation as the body states it. Rewriting
-- every right side by the later equations would list a tree with 2^8 leaves
-- under `F1 a`.
type Pair a b = Pair(a, b)
class C1 a { type F1 a; fun mk1(a) -> F1 a }
class C2 a { type F2 a; fun mk2(a) -> F2 a }
class C3 a { type F3 a; fun mk3(a) -> F3 a }
class C4 a { type F4 a; fun mk4(a) -> F4 a }
class C5 a { type F5 a; fun mk5(a) -> F5 a }
class C6 a { type F6 a; fun mk6(a) -> F6 a }
class C7 a { type F7 a; fun mk7(a) -> F7 a }
class C8 a { type F8 a; fun mk8(a) -> F8 a }
class C9 a { type F9 a; fun mk9(a) -> F9 a }
fun chain(x) {
    var v1 = mk1(x)
    v1 = Pair(mk2(x), mk2(x))
    var v2 = mk2(x)
    v2 = Pair(mk3(x), mk3(x))
    var v3 = mk3(x)
    v3 = Pair(mk4(x), mk4(x))
    var v4 = mk4(x)
    v4 = Pair(mk5(x), mk5(x))
    var v5 = mk5(x)
    v5 = Pair(mk6(x), mk6(x))
    var v6 = mk6(x)
    v6 = Pair(mk7(x), mk7(x))
    var v7 = mk7(x)
    v7 = Pair(mk8(x), mk8(x))
    var v8 = mk8(x)
    v8 = Pair(mk9(x), mk9(x))
    0
}
fun main() { }
