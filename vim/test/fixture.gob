-- A line comment: True, 123, TODO markers, and "not a string".
--- A doc comment, which documents the module here.
---- A rule.
{- A block comment
with a {- nested -} part
and code-looking text: fun f() { "{" }. -}

export (main, area, Shape(..), (<+>))

import Data.Set as Set (insert as add, ..)
import Data.Option (isSome as _)

infix Addition (<+>) = combine

foreign "printf" fun printf(format : Prim.Ptr, ...
                            args : Int) -> Int

type Shape =
    -- The round case.
    Circle(Float)
    | Rectangle { var width : Float, height : Float }
    -- The empty case.
    | Null
    | Shown[a, Show a](a)

type Box a = Box {
    value : a,
    count : Int,
}

class Container c {
    type Elem c
    fun empty() -> c
}

instance Container (Array a) {
    type Elem = a
    fun empty() = []
}

fun combine[a ~ Int](x : a, y : a) -> a = x + y

fun inc(x : Int) -> Int = x + 1

fun area(s) = match s {
    Circle(r) -> 3.14 * r * r
    Rectangle { width, height } -> width * height
    Null | Shown(_) -> 0.0
}

fun start(argv : Array String,
          directory : Option String)
        -> Either Int (Set.Set String) {
    let Some(first) = Array.get(argv, 0) else {
        return Left(1)
    }
    let mask = 0xFFFF_FFFF & 0b1010 | 0o17 ^ 1_000 << 2
    if len(first) > 0xFFFF || mask == 0
       || Option.isNone(directory) {
        return Left(2)
    } else if let Some(d) = directory, d != "" {
        print(d)
    } else if len(argv) > 1
              || len(first) == 0 {
        print("many")
    } else {
        print("none")
    }
    Right(Set.new())
}

fun main() {
    var total = 0
    let pi' = 3.14
    let e = 1.5e-3
    let big = 1e3 + 2.5E-2 + 1_000.000_1
    let t = (1, 2).0.1
    let hiding = 3
    let infix = hiding + 1
    let ch = 'a'
    let nl = '\n'
    let uni = '\u{1F600}'
    let s = "escapes \" \n \u{1F600} and }{ braces"
    let tricky = "= -- not a comment"
    let twice = Array.map([1, 2, 3], \_ * 2)
    for x in [1, 2, 3] {
        total = total + x
    }
    for var i = 0; i < 3; i = i + 1 {
        total = total + i
    }
    if total < 0 {
        print("neg\n")
    } else {
        print("pos")
    }
    while True {
        break
    }
    loop {
        return
    }
    match Option.map(Some(1), inc) {
        None -> print("empty")
        Some(x) -> print(x)
    }
    match (Box { value = 1, count = 2 }) {
        Box { value, .. } -> print(value)
    }
    let long = String.join([
        "alpha", "beta",
        "gamma",
    ], ", ")
    let sum = 1 +-- the rest is on the next line
        2
    let r = do {
        let y = Some(41)?
        Some(y + 1)
    }
    print(r)
}

fun apply(f, x) = f(
    x)

fun optional(body) =
    Some(fun(x) {
        body(x)
    })

let trailing = 1 --- after code, an ordinary comment
